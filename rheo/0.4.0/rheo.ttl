rheo:1000049 a owl:ObjectProperty ;
    rdfs:label "under perspective"@en ;
    obo:IAO_0000115 "Relates a cost record, a costing process, a decision problem or an economic model to the perspective specification it follows."@en ;
    obo:IAO_0000116 "Authoritative for perspective (0.3.0). The text property has perspective label is a label only."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000072 .

rheo:1000050 a owl:ObjectProperty ;
    rdfs:label "includes resource type"@en ;
    obo:IAO_0000115 "Relates a perspective specification to a costed item type specification (a kind of resource or care process) that it counts."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000072 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000121 .

rheo:1000051 a owl:ObjectProperty ;
    rdfs:label "counts flow from"@en ;
    obo:IAO_0000115 "Relates a flow measurement or a projected count to the member group, resource stock, workforce, care setting or organization that the counted entities left."@en ;
    obo:IAO_0000116 "For counts only. The movement of a person from one care setting to another is recorded on the patient movement itself, with RO has start location (RO_0002231) and has end location (RO_0002232). An organization is admitted as the outside source or destination of a flow, such as a supplier of vaccine doses."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( rheo:0000080 rheo:0000112 ) ] ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( rheo:0000118 rheo:0000043 rheo:0000097 rheo:0000042 obo:OBI_0000245 ) ] .

rheo:1000052 a owl:ObjectProperty ;
    rdfs:label "counts flow to"@en ;
    obo:IAO_0000115 "Relates a flow measurement or a projected count to the member group, resource stock, workforce, care setting or organization that the counted entities entered."@en ;
    obo:IAO_0000116 "For counts only. The movement of a person from one care setting to another is recorded on the patient movement itself, with RO has start location (RO_0002231) and has end location (RO_0002232). An organization is admitted as the outside source or destination of a flow, such as a supplier of vaccine doses."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( rheo:0000080 rheo:0000112 ) ] ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( rheo:0000118 rheo:0000043 rheo:0000097 rheo:0000042 obo:OBI_0000245 ) ] .

rheo:1000053 a owl:ObjectProperty ;
    rdfs:label "records payer"@en ;
    obo:IAO_0000115 "Relates a payment record to the organization, household or person that made the recorded payment."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000077 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subPropertyOf rheo:1000040 .

rheo:1000054 a owl:ObjectProperty ;
    rdfs:label "records payee"@en ;
    obo:IAO_0000115 "Relates a payment record to the organization, household or person that received the recorded payment."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000077 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subPropertyOf rheo:1000040 .

rheo:1000055 a owl:ObjectProperty ;
    rdfs:label "records tariff applied"@en ;
    obo:IAO_0000115 "Relates a payment record to the tariff that set the amount of the recorded payment."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000077 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000075 ;
    rdfs:subPropertyOf obo:IAO_0000136 .

rheo:1000056 a owl:ObjectProperty ;
    rdfs:label "under payment mechanism"@en ;
    obo:IAO_0000115 "Relates a payment record or a tariff to the payment mechanism specification it follows."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
