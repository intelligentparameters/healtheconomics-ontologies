    rdfs:range rheo:0000064 ;
    rdfs:subPropertyOf obo:IAO_0000136 .

rheo:1000092 a owl:ObjectProperty ;
    rdfs:label "revises scheme version"@en ;
    obo:IAO_0000115 "Relates a classification revision record to the classification scheme version that was revised."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
