    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000129 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000065 .

rheo:1000094 a owl:ObjectProperty ;
    rdfs:label "introduces state"@en ;
    obo:IAO_0000115 "Relates a classification revision record to a state description that the revision added and that neither refines, renames nor merges a state of the revised version."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000129 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000064 .

rheo:1000095 a owl:ObjectProperty ;
    rdfs:label "concerns observation"@en ;
    obo:IAO_0000115 "Relates a knowledge change record to the state observation whose difference from the earlier observation reflects a change in knowledge, not in the entity."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
