    rdfs:domain rheo:0000034 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000021 .

rheo:1000091 a owl:ObjectProperty ;
    rdfs:label "records opened state"@en ;
    obo:IAO_0000115 "Relates a possibility change record to the state description of the state that became open."@en ;
