    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000005 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000064 .

rheo:1000084 a owl:ObjectProperty ;
    rdfs:label "has to state"@en ;
    obo:IAO_0000115 "Relates a clinical event type specification to the state the event leads to."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000005 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000064 .

rheo:1000085 a owl:ObjectProperty ;
    rdfs:label "defined by state"@en ;
    obo:IAO_0000115 "Relates a member group to the state description its members are in."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000118 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000064 .

rheo:1000086 a owl:ObjectProperty ;
    rdfs:label "assigned to group"@en ;
    obo:IAO_0000115 "Relates a case-mix group assignment to the case-mix group (a kind of care process) assigned."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000114 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000122 .

rheo:1000087 a owl:ObjectProperty ;
    rdfs:label "merges states"@en ;
    obo:IAO_0000115 "Relates a state description of a later scheme version to a state of an earlier version that it absorbs together with at least one other, such as a single progressed stage replacing separate mild and severe stages."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000064 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000064 .

rheo:1000088 a owl:ObjectProperty ;
    rdfs:label "records governing agreement"@en ;
    obo:IAO_0000115 "Relates a payment record to the price agreement, such as an outcomes-based agreement, under which the recorded payment was made."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000077 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000078 ;
    rdfs:subPropertyOf obo:IAO_0000136 .

rheo:1000089 a owl:ObjectProperty ;
    rdfs:label "references area"@en ;
    obo:IAO_0000115 "Relates an international reference pricing rule to a country or other area whose prices it references."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000120 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000116 .

rheo:1000090 a owl:ObjectProperty ;
    rdfs:label "model state represents"@en ;
    obo:IAO_0000115 "Relates a model state to the clinical or classification state description that it approximates, such as the model state 'stable disease' of a cohort model to the state 'stable disease' of a disease staging classification."@en ;
