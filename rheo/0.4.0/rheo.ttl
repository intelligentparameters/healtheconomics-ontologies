    rdfs:domain rheo:0000106 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000105 .

rheo:1000074 a owl:ObjectProperty ;
    rdfs:label "allocated to arm"@en ;
    obo:IAO_0000115 "Relates an allocation record to the trial arm the participant was allocated to."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000100 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000099 .

rheo:1000075 a owl:ObjectProperty ;
    rdfs:label "authorises technology"@en ;
    obo:IAO_0000115 "Relates a marketing authorisation to the intervention specification it permits."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000108 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000026 .

rheo:1000076 a owl:ObjectProperty ;
    rdfs:label "requires"@en ;
    obo:IAO_0000115 "Relates a funding rule to the class of document a technology must have to be funded, such as marketing authorisation or HTA recommendation (the class IRI is used as the value, which OWL 2 DL allows by punning)."@en ;
    obo:IAO_0000116 "Operational meaning (0.3.0). Under the OWL 2 Direct Semantics the class used as a value is a separate individual, so this link does not make a reasoner require, or infer, any document. Application logic reads 'rule R requires class C' as: a technology satisfies R on a date only if, for every class C that R requires, a record of class C about that technology is dated on or before that date; for an HTA recommendation, the latest such recommendation must be positive. ops/funding-rule.rq implements this reading for any required classes; run_demo.py tests it, and the record rules reject a value that is not a declared class of directive record."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000109 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> .

rheo:1000077 a owl:ObjectProperty ;
    rdfs:label "arm intervention"@en ;
    obo:IAO_0000115 "Relates a trial arm specification to the intervention specification the arm receives."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000099 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000026 .

rheo:1000080 a owl:ObjectProperty ;
    rdfs:label "is version of scheme"@en ;
    obo:IAO_0000115 "Relates a classification scheme version to the classification scheme it is a version of."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000065 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000110 .

rheo:1000081 a owl:ObjectProperty ;
    rdfs:label "refines state"@en ;
    obo:IAO_0000115 "Relates a state description of a later scheme version to the state of an earlier version that it is a finer part of, such as a severe stage split from a single progressed stage."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000064 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000064 .

rheo:1000082 a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "same state as"@en ;
    obo:IAO_0000115 "Relates a state description to a state description of another scheme version with the same meaning under a different name or identifier."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000064 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000064 .

rheo:1000083 a owl:ObjectProperty ;
    rdfs:label "has from state"@en ;
