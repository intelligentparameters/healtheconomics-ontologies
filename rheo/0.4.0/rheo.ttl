    rdfs:range rheo:0000076 .

rheo:1000057 a owl:ObjectProperty ;
    rdfs:label "issued by"@en ;
    obo:IAO_0000115 "Relates a tariff, price agreement or recommendation to the organization that issued it."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> .

rheo:1000058 a owl:ObjectProperty ;
    rdfs:label "sets price for"@en ;
    obo:IAO_0000115 "Relates a tariff to the kind of care process whose payment it sets."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000075 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000122 .

rheo:1000059 a owl:ObjectProperty ;
    rdfs:label "applies to technology"@en ;
    obo:IAO_0000115 "Relates a price agreement or a recommendation to the intervention specification it concerns."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000026 .

rheo:1000060 a owl:ObjectProperty ;
    rdfs:label "counts members of"@en ;
    obo:IAO_0000115 "Relates a stock measurement or a projected count to the member group, resource stock or workforce whose members it counts."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> .

rheo:1000061 a owl:ObjectProperty ;
    rdfs:label "based on result"@en ;
    obo:IAO_0000115 "Relates a recommendation to a model result the decision-making body relied on."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000083 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000032 .

rheo:1000062 a owl:ObjectProperty ;
    rdfs:label "records paid-for process"@en ;
    obo:IAO_0000115 "Relates a payment record to the care process or programme that the recorded payment was made for."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000077 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subPropertyOf rheo:1000041 .

rheo:1000063 a owl:ObjectProperty ;
    rdfs:label "has member record"@en ;
    obo:IAO_0000115 "Relates an evidence dataset to a record it contains."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subPropertyOf obo:RO_0002351 .

rheo:1000070 a owl:ObjectProperty ;
    rdfs:label "covers resource type"@en ;
    obo:IAO_0000115 "Relates a benefit package specification to a costed item type specification (a kind of care process or resource) that it covers."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000103 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000121 .

rheo:1000071 a owl:ObjectProperty ;
    rdfs:label "records scheme enrolled in"@en ;
    obo:IAO_0000115 "Relates an insurance enrolment record to the organization that runs the health insurance scheme or coverage programme in which the recorded person or household was enrolled."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000104 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subPropertyOf rheo:1000040 .

rheo:1000072 a owl:ObjectProperty ;
    rdfs:label "accounts for resource use"@en ;
