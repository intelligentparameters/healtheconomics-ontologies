@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix oboInOwl: <http://www.geneontology.org/formats/oboInOwl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

obo:BFO_0000030 a owl:Class ;
    rdfs:label "object"@en ;
    obo:IAO_0000115 "An object is a material entity which manifests causal unity & is of a type instances of which are maximal relative to the sort of causal unity manifested."@en ;
    obo:IAO_0000119 "BFO 2020 (ISO/IEC 21838-2:2021) (elucidation)" ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl> ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl> ;
    rdfs:subClassOf obo:BFO_0000040 .

obo:BFO_0000050 a owl:ObjectProperty ;
    rdfs:label "part of"@en ;
    obo:IAO_0000115 "a core relation that holds between a part and its whole"@en ;
    obo:IAO_0000119 "RO (http://purl.obolibrary.org/obo/ro.owl)" .

obo:BFO_0000055 a owl:ObjectProperty ;
    rdfs:label "realizes"@en ;
    obo:IAO_0000115 "realizes is a relation between a process b and realizable entity c such that c inheres in some d & for all t, if b has participant d then c exists & the type instantiated by b is correlated with the type instantiated by c."@en ;
    obo:IAO_0000119 "BFO 2020 (ISO/IEC 21838-2:2021) (elucidation)" ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl> ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl> .

obo:BFO_0000066 a owl:ObjectProperty ;
    rdfs:label "occurs in"@en ;
    obo:IAO_0000115 "b occurs in c =Def b is a process or a process boundary & c is a material entity or site & there exists a spatiotemporal region r & b occupies spatiotemporal region r & for all time t, if b exists at t then c exists at t & there exist spatial regions s and s' where b spatially projects onto s at t & c occupies spatial region s' at t & s is a continuant part of s' at t."@en ;
    obo:IAO_0000119 "BFO 2020 (ISO/IEC 21838-2:2021)" ;
    obo:IAO_0000412 <http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl> ;
    rdfs:isDefinedBy <http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl> .

obo:IAO_0000112 a owl:AnnotationProperty ;
    rdfs:label "example of usage"@en .

obo:IAO_0000115 a owl:AnnotationProperty ;
    rdfs:label "definition"@en .

obo:IAO_0000116 a owl:AnnotationProperty ;
    rdfs:label "editor note"@en .

obo:IAO_0000117 a owl:AnnotationProperty ;
    rdfs:label "term editor"@en .

obo:IAO_0000118 a owl:AnnotationProperty ;
    rdfs:label "alternative label"@en .

obo:IAO_0000119 a owl:AnnotationProperty ;
    rdfs:label "definition source"@en .

obo:IAO_0000231 a owl:AnnotationProperty ;
    rdfs:label "has obsolescence reason"@en .

obo:IAO_0000412 a owl:AnnotationProperty ;
    rdfs:label "imported from"@en .

obo:IAO_0100001 a owl:AnnotationProperty ;
    rdfs:label "term replaced by"@en .

obo:OBI_0000293 a owl:ObjectProperty ;
    rdfs:label "has specified input"@en ;
    obo:IAO_0000115 "A relation between a planned process and a continuant participating in that process that is not created during the process (OBI; paraphrased)."@en ;
    obo:IAO_0000119 "OBI (http://purl.obolibrary.org/obo/obi.owl)" .

obo:OBI_0000299 a owl:ObjectProperty ;
    rdfs:label "has specified output"@en ;
    obo:IAO_0000115 "A relation between a planned process and a continuant participating in that process that is created during the process (OBI; paraphrased)."@en ;
    obo:IAO_0000119 "OBI (http://purl.obolibrary.org/obo/obi.owl)" .

obo:OGMS_0000031 a owl:Class ;
    rdfs:label "disease"@en ;
    obo:IAO_0000115 "A disposition (i) to undergo pathological processes that (ii) exists in an organism because of one or more disorders in that organism."@en ;
    obo:IAO_0000119 "OGMS (http://purl.obolibrary.org/obo/ogms.owl)" ;
    rdfs:isDefinedBy obo:ogms.owl ;
    rdfs:subClassOf obo:BFO_0000016 .

obo:OMRSE_00000011 a owl:Class ;
    rdfs:label "patient role"@en ;
    obo:IAO_0000115 "A health care role borne by an organism and that is realized by presenting to a health care provider in a clinical encounter."@en ;
    obo:IAO_0000119 "OMRSE (http://purl.obolibrary.org/obo/omrse.owl)" ;
    rdfs:isDefinedBy obo:omrse.owl ;
    rdfs:subClassOf obo:OMRSE_00000010 .

obo:OMRSE_00000012 a owl:Class ;
    rdfs:label "health care provider role"@en ;
    obo:IAO_0000115 "A health care role inhering in an organization or human being that is realized by a process of providing health care services to an organism."@en ;
    obo:IAO_0000119 "OMRSE (http://purl.obolibrary.org/obo/omrse.owl)" ;
    rdfs:isDefinedBy obo:omrse.owl ;
    rdfs:subClassOf obo:OMRSE_00000010 .

obo:RO_0000057 a owl:ObjectProperty ;
    rdfs:label "has participant"@en ;
    obo:IAO_0000115 "a relation between a process and a continuant, in which the continuant is somehow involved in the process"@en ;
    obo:IAO_0000119 "RO (http://purl.obolibrary.org/obo/ro.owl)" .

obo:RO_0000087 a owl:ObjectProperty ;
    rdfs:label "has role"@en ;
    obo:IAO_0000115 "a relation between an independent continuant (the bearer) and a role, in which the role specifically depends on the bearer for its existence"@en ;
    obo:IAO_0000119 "RO (http://purl.obolibrary.org/obo/ro.owl)" .

obo:RO_0001025 a owl:ObjectProperty ;
    rdfs:label "located in"@en ;
    obo:IAO_0000115 "a relation between two independent continuants, the target and the location, in which the target is entirely within the location"@en ;
    obo:IAO_0000119 "RO (http://purl.obolibrary.org/obo/ro.owl)" .

obo:RO_0002231 a owl:ObjectProperty ;
    rdfs:label "has start location"@en ;
    obo:IAO_0000115 "x 'has starts location' y if and only if there exists some process z such that x 'starts with' z and z 'occurs in' y"@en ;
    obo:IAO_0000119 "RO (http://purl.obolibrary.org/obo/ro.owl)" .

obo:RO_0002232 a owl:ObjectProperty ;
    rdfs:label "has end location"@en ;
    obo:IAO_0000115 "x 'has end location' y if and only if there exists some process z such that x 'ends with' z and z 'occurs in' y"@en ;
    obo:IAO_0000119 "RO (http://purl.obolibrary.org/obo/ro.owl)" .

obo:VO_0000002 a owl:Class ;
    rdfs:label "vaccination"@en ;
    obo:IAO_0000115 "Process of administering a vaccine in vivo to a recipient (e.g., a human), with the intent to invoke a protective or therapeutic adaptive immune response."@en ;
    obo:IAO_0000119 "VO (http://purl.obolibrary.org/obo/vo.owl)" ;
    rdfs:isDefinedBy obo:vo.owl ;
    rdfs:subClassOf obo:OBI_0600007 .

dcterms:bibliographicCitation a owl:AnnotationProperty .

dcterms:created a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:identifier a owl:AnnotationProperty .

dcterms:issued a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

dcterms:publisher a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

oboInOwl:consider a owl:AnnotationProperty ;
    rdfs:label "consider"@en .

rheo:0000001 a owl:Class ;
    rdfs:label "obsolete health care process"@en ;
    obo:IAO_0000115 "OBSOLETE. A process in which health care is delivered to one or more persons, such as a consultation, an inpatient stay, an emergency admission or the administration of a medicine."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    obo:IAO_0000231 obo:IAO_0000228 ;
    obo:IAO_0100001 obo:OGMS_0000096 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    owl:deprecated true .

rheo:0000002 a owl:Class ;
    rdfs:label "health care resource role"@en ;
    obo:IAO_0000115 "A role borne by a material entity, such as a medicine, a medical device or a hospital bed, that is realised when the entity is consumed or occupied in a health care, social care or informal care process."@en ;
    obo:IAO_0000116 "Being a resource is a role, not a kind of thing: a bed is a material entity that bears this role in a care process. Staff time is represented through the participation of staff in a health care process."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf obo:BFO_0000023 .

rheo:0000003 a owl:Class ;
    rdfs:label "clinical event"@en ;
    obo:IAO_0000115 "A process in the health course of a person, such as a stroke, a fracture or the progression of a disease."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf obo:BFO_0000015 .

rheo:0000006 a owl:Class ;
    rdfs:label "obsolete care process or resource type specification"@en ;
    obo:IAO_0000115 "OBSOLETE. An information content entity that identifies a kind of health care process or a kind of resource that cost and resource use estimates refer to, such as an emergency admission or a hospital bed day, optionally with a code from a classification."@en ;
    obo:IAO_0000116 "Split in 0.2.2 into care process type specification (RHEO_0000122) and resource type specification (RHEO_0000123), under costed item type specification (RHEO_0000121). Use the subclass that fits."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    obo:IAO_0000231 obo:IAO_0000229 ;
    obo:IAO_0100001 rheo:0000121 ;
    oboInOwl:consider rheo:0000122,
        rheo:0000123 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    owl:deprecated true .

rheo:0000014 a owl:Class ;
    rdfs:label "unit cost estimate"@en ;
    obo:IAO_0000115 "A cost estimate for one unit of a resource or of a health care process, such as one hospital bed day or one consultation."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Drummond et al. 2015" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf rheo:0000013 .

rheo:0000016 a owl:Class ;
    rdfs:label "probability estimate"@en ;
    obo:IAO_0000115 "An economic evaluation estimate of the probability that a kind of clinical event occurs, either within a stated time interval or per event, in a stated population."@en ;
    obo:IAO_0000116 "A probability over a time interval always needs that interval: the same rate gives different probabilities over different intervals."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Briggs et al. 2006" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf rheo:0000011 .

rheo:0000017 a owl:Class ;
    rdfs:label "event rate estimate"@en ;
    obo:IAO_0000112 "1.8 emergency admissions per patient-year among adults with moderate Merrow's disease (fictional)."@en ;
    obo:IAO_0000115 "An economic evaluation estimate of the number of clinical events of a kind per unit of person-time in a stated population."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Briggs et al. 2006" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf rheo:0000011 .

rheo:0000018 a owl:Class ;
    rdfs:label "relative effect estimate"@en ;
    obo:IAO_0000115 "An economic evaluation estimate of the effect of an intervention relative to a comparator, expressed as a ratio or a difference, such as a hazard ratio or a relative risk."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Briggs et al. 2006" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf rheo:0000011 .

rheo:0000022 a owl:Class ;
    rdfs:label "evidence source document"@en ;
    obo:IAO_0000115 "A document from which an economic evaluation estimate is taken, such as a trial report, a published study, a national cost schedule or a registry report."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf obo:IAO_0000310 .

rheo:0000033 a owl:Class ;
    rdfs:label "health state classification profile"@en ;
    obo:IAO_0000112 "The EQ-5D-3L profile 21121."@en ;
    obo:IAO_0000115 "A health state description given as a combination of levels on the dimensions of a health state classification system, such as the EQ-5D profile 21121."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Brazier et al. 2017" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf rheo:0000021 .

rheo:0000035 a owl:Class ;
    rdfs:label "evidence dataset"@en ;
    obo:IAO_0000115 "An information content entity that is a collection of patient-level or aggregate data from which an economic evaluation estimate is calculated, such as a trial dataset or an extract of routine data."@en ;
    obo:IAO_0000116 "Used when an estimate comes from an analysis of data rather than from a published document."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf obo:IAO_0000030 .

rheo:0000040 a owl:Class ;
    rdfs:label "payer role"@en ;
    obo:IAO_0000112 "The payer role of a commissioner, realised when it pays a hospital trust for an emergency admission."@en ;
    obo:IAO_0000115 "A role borne by an organization, a household or a person that is realised in paying for health care, social care or health insurance."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf obo:BFO_0000023 .

rheo:0000041 a owl:Class ;
    rdfs:label "informal carer role"@en ;
    obo:IAO_0000115 "A role borne by a person that is realised in providing unpaid care to someone because of illness, disability or age."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf obo:BFO_0000023 .

rheo:0000044 a owl:Class ;
    rdfs:label "medicinal product"@en ;
    obo:IAO_0000115 "A material entity, such as a pack of tablets or a dose of vaccine, that is or contains a substance intended for the prevention, diagnosis or treatment of disease."@en ;
    obo:IAO_0000116 "The physical product. The product as a marketed type (what a price agreement or a marketing authorisation is about) is an intervention specification. Candidate for replacement by DRON clinical drug product."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf obo:BFO_0000040 .

rheo:0000045 a owl:Class ;
    rdfs:label "obsolete medical device"@en ;
    obo:IAO_0000115 "OBSOLETE. An object, other than a medicinal product, used in the prevention, diagnosis, monitoring or treatment of disease, such as a diagnostic test kit or an infusion pump."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    obo:IAO_0000231 obo:IAO_0000228 ;
    obo:IAO_0100001 obo:COB_0001300 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    owl:deprecated true .

rheo:0000046 a owl:Class ;
    rdfs:label "inpatient stay"@en ;
    obo:IAO_0000115 "A health care process in which a person is admitted to a hospital bed and cared for until discharge."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf obo:OGMS_0000096 .

rheo:0000047 a owl:Class ;
    rdfs:label "emergency department attendance"@en ;
    obo:IAO_0000115 "A health care process in which a person is assessed or treated in an emergency department without, or before, admission."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf obo:OGMS_0000096 .

rheo:0000048 a owl:Class ;
    rdfs:label "consultation"@en ;
    obo:IAO_0000115 "A health care encounter in which a person is seen by a health professional in an outpatient, primary care or community setting, in person or remotely."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf obo:OGMS_0000097 .

rheo:0000049 a owl:Class ;
    rdfs:label "diagnostic testing process"@en ;
    obo:IAO_0000115 "A health care process in which a diagnostic test is carried out on a person or a specimen to detect or rule out a condition."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf obo:OGMS_0000096 .

rheo:0000050 a owl:Class ;
    rdfs:label "medicine dispensing"@en ;
    obo:IAO_0000115 "A health care process in which a medicinal product is supplied to a person or to those caring for them."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf obo:OGMS_0000096 .

rheo:0000051 a owl:Class ;
    rdfs:label "patient transport"@en ;
    obo:IAO_0000115 "A planned process in which a person is conveyed to, from or between care settings, such as an emergency ambulance journey."@en ;
    obo:IAO_0000116 "Not placed under OGMS health care process, which requires direct treatment, diagnosis or prevention. A patient transport can have patient movements as parts."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf obo:COB_0000082 .

rheo:0000052 a owl:Class ;
    rdfs:label "care episode"@en ;
    obo:IAO_0000115 "A health care process made up of the health care processes delivered to one person for one health problem between a start and an end, such as an emergency admission from arrival to discharge."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf obo:OGMS_0000096 .

rheo:0000053 a owl:Class ;
    rdfs:label "behavioural support session"@en ;
    obo:IAO_0000115 "A health care process in which a person receives support to change a health-related behaviour, such as a stop smoking session."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf obo:OGMS_0000096 .

rheo:0000055 a owl:Class ;
    rdfs:label "informal care process"@en ;
    obo:IAO_0000115 "A process in which a person bearing an informal carer role provides unpaid care to another person."@en ;
    obo:IAO_0000116 "Counted, and valued, only in perspectives that include informal care, such as a societal perspective."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf obo:BFO_0000015 .

rheo:0000056 a owl:Class ;
    rdfs:label "paid work process"@en ;
    obo:IAO_0000115 "A process in which a person carries out work for pay."@en ;
    obo:IAO_0000116 "Time lost from paid work because of ill health is an absence, not part of work: it is recorded by a work absence record and valued as a productivity loss in a societal perspective."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf obo:BFO_0000015 .

rheo:0000057 a owl:Class ;
    rdfs:label "resource use process"@en ;
    obo:IAO_0000115 "A process, part of a health care, social care or informal care process, in which a material entity bearing a health care resource role is consumed or occupied, or in which a person takes part as staff or carer."@en ;
    obo:IAO_0000116 "Resource use is a real process. A cost is the information produced when a costing process values recorded resource use: RHEO represents that valuation process and the cost record it produces, and records the perspective and the assumptions of the valuation with them (see costing process and cost record)."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf obo:BFO_0000015 .

rheo:0000058 a owl:Class ;
    rdfs:label "patient movement"@en ;
    obo:IAO_0000115 "A process in which a person moves from one care setting to another, such as arriving at an emergency department from home or being discharged from a ward to home."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf obo:BFO_0000015 .

rheo:0000059 a owl:Class ;
    rdfs:label "payment process"@en ;
    obo:IAO_0000115 "A planned process in which money is transferred from a payer to a payee, such as a reimbursement to a hospital, an insurance premium, a capitation payment or a payment made out of pocket by a household."@en ;
    obo:IAO_0000116 "A payment is a flow of money between agents. It is not the cost of care: a tariff payment and the cost of the resources used can differ."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000118 "payment"@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf obo:COB_0000082 .

rheo:0000060 a owl:Class ;
    rdfs:label "infection transmission"@en ;
    obo:IAO_0000115 "A process in which an infectious agent passes from an infectious host to a susceptible host."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf obo:BFO_0000015 .

rheo:0000061 a owl:Class ;
    rdfs:label "health-related behaviour"@en ;
    obo:IAO_0000115 "A process of a person's own conduct that affects their health, such as smoking, drinking alcohol or physical activity."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf obo:BFO_0000015 .

rheo:0000062 a owl:Class ;
    rdfs:label "health technology assessment decision process"@en ;
    obo:IAO_0000115 "A planned process in which a decision-making body considers evidence, including economic evaluations, and decides whether a health technology should be funded and on what terms."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf obo:COB_0000082 .

rheo:0000063 a owl:Class ;
    rdfs:label "death"@en ;
    obo:IAO_0000115 "A process boundary at which the life of an organism ends."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf obo:BFO_0000035 .

rheo:0000084 a owl:Class ;
    rdfs:label "test accuracy estimate"@en ;
    obo:IAO_0000115 "An economic evaluation estimate of how well a diagnostic test classifies people, such as its sensitivity or specificity, in a stated population against a stated reference standard."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf rheo:0000011 .

rheo:0000091 a owl:Class ;
    rdfs:label "QALY calculation process"@en ;
    obo:IAO_0000115 "A planned process in which quality-adjusted life years are calculated from utility values and the time over which they apply, with or without discounting."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Drummond et al. 2015" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf obo:COB_0000082 .

rheo:0000095 a owl:Class ;
    rdfs:label "disability weight estimate"@en ;
    obo:IAO_0000115 "An economic evaluation estimate of the severity of a health state on a scale on which 0 is full health and 1 is equivalent to death, used to calculate years lived with disability."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Murray 1994" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf rheo:0000011 .

rheo:0000096 a owl:Class ;
    rdfs:label "public health programme"@en ;
    obo:IAO_0000115 "A planned process in which an organization delivers an intervention to a population rather than to individual patients, such as distributing insecticide-treated bed nets or running a vaccination campaign."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf obo:COB_0000082 .

rheo:0000101 a owl:Class ;
    rdfs:label "care home stay"@en ;
    obo:IAO_0000115 "A social care process in which a person lives in a care home and receives personal care there."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf rheo:0000054 .

rheo:0000102 a owl:Class ;
    rdfs:label "home care visit"@en ;
    obo:IAO_0000115 "A social care process in which a care worker visits a person at home to help with personal care or daily living."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf rheo:0000054 .

rheo:0000107 a owl:Class ;
    rdfs:label "regulatory decision process"@en ;
    obo:IAO_0000115 "A planned process in which a regulatory body decides whether a health technology may be marketed, on the evidence of its quality, safety and efficacy."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf obo:COB_0000082 .

rheo:0000111 a owl:Class ;
    rdfs:label "state change process"@en ;
    obo:IAO_0000112 "A person's disease progressing from stable to progressed between two clinic visits."@en ;
    obo:IAO_0000115 "An entity change process in which a person or other entity changes so that it passes from one state to another, such as progressing from stable to progressed disease or becoming immune after vaccination."@en ;
    obo:IAO_0000116 "The real change in the entity. A transition record is information about it. A difference between two recorded states is evidence of a state change only when it is not explained by a classification revision or a change in knowledge."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf rheo:0000125 .

rheo:0000115 a owl:Class ;
    rdfs:label "case-mix grouping process"@en ;
    obo:IAO_0000115 "A planned process in which the coded record of a care episode or spell is assigned to a case-mix group by a grouping algorithm."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf obo:COB_0000082 .

rheo:0000124 a owl:Class ;
    rdfs:label "possibility change process"@en ;
    obo:IAO_0000115 "An entity change process in which a state becomes open, or ceases to be open, to an entity or to entities of a kind, such as a vaccine programme starting in an area or a new medicine becoming available to patients, whether or not any entity has yet entered the state."@en ;
    obo:IAO_0000116 "A change in what can happen to the entity, not in how it is described: a new category in a classification is not a possibility change, and a possibility can open although the classification already had a category for it."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf rheo:0000125 .

rheo:0000150 a owl:Class ;
    rdfs:label "unit cost valuation process"@en ;
    obo:IAO_0000115 "A costing process in which the quantity of each recorded resource use, or of a recorded absence from work, is multiplied by a stated unit cost, producing one cost record for each record valued."@en ;
    obo:IAO_0000116 "Micro-costing (unit costs of individual items such as staff minutes and consumables) and gross costing (unit costs of whole care processes such as an admission) are both unit cost valuations; they differ in the level of the item valued (review B, 0.3.0)."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Drummond et al. 2015" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf rheo:0000073 .

rheo:0000151 a owl:Class ;
    rdfs:label "cost aggregation process"@en ;
    obo:IAO_0000115 "A costing process in which cost records are added together into a total, such as the cost of a care episode, a patient's annual cost or the cost of a programme."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf rheo:0000073 .

rheo:0000152 a owl:Class ;
    rdfs:label "cost adjustment process"@en ;
    obo:IAO_0000115 "A costing process in which a cost record is converted to another currency, inflated or deflated to another price year, or discounted to a base year, using a stated factor."@en ;
    obo:IAO_0000116 "The kind of adjustment is stated with has adjustment kind (inflation, deflation, currency conversion or discounting); the record rules check that the currency, price year and discounting fit the kind."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Drummond et al. 2015" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf rheo:0000073 .

rheo:0000153 a owl:Class ;
    rdfs:label "cost comparison process"@en ;
    obo:IAO_0000115 "A costing process in which the costs of two alternatives are compared, producing an incremental cost record, such as the difference in mean cost between a new treatment and standard care."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Drummond et al. 2015" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf rheo:0000073 .

rheo:0000154 a owl:Class ;
    rdfs:label "cost estimation process"@en ;
    obo:IAO_0000115 "A costing process in which a cost is estimated by a statistical or accounting method rather than by multiplying one quantity by one unit cost, such as a regression of costs on patient characteristics, or an activity-based or step-down allocation of a budget to activities."@en ;
    obo:IAO_0000116 "The method is stated with has estimation method. Micro-costing is not estimation: it is a unit cost valuation at the level of individual items."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Drummond et al. 2015" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subClassOf rheo:0000073 .

rheo:1000001 a owl:ObjectProperty ;
    rdfs:label "applies to population"@en ;
    obo:IAO_0000115 "Relates an estimate, an assumption or an estimand to the population specification it is intended to apply to."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000004 .

rheo:1000002 a owl:ObjectProperty ;
    rdfs:label "values health state"@en ;
    obo:IAO_0000115 "Relates a utility estimate or an assumed utility to the health state description it values. A utility measured in people values a clinical or classification state description, not a model state."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000021 .

rheo:1000003 a owl:ObjectProperty ;
    rdfs:label "concerns event type"@en ;
    obo:IAO_0000115 "Relates a probability, rate or relative effect estimate, or an assumption, to the kind of clinical event it concerns."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000005 .

rheo:1000004 a owl:ObjectProperty ;
    rdfs:label "concerns costed item type"@en ;
    obo:IAO_0000115 "Relates a cost, resource use or emission factor estimate, a resource use or work absence record, or an assumption, to the costed item type specification (a kind of care process or a kind of resource) that it values or counts."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000121 .

rheo:1000005 a owl:ObjectProperty ;
    rdfs:label "estimates"@en ;
    obo:IAO_0000115 "Relates an economic evaluation estimate to the estimand it is an estimate of."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000011 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000010 .

rheo:1000006 a owl:ObjectProperty ;
    rdfs:label "has uncertainty specification"@en ;
    obo:IAO_0000115 "Relates an estimate or an assumed value to the description of its uncertainty."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000019 .

rheo:1000007 a owl:ObjectProperty ;
    rdfs:label "reports investigation"@en ;
    obo:IAO_0000115 "Relates a document to the investigation it reports."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain obo:IAO_0000310 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range obo:OBI_0000066 .

rheo:1000008 a owl:ObjectProperty ;
    rdfs:label "corrects"@en ;
    obo:IAO_0000115 "Relates a correction notice to the document it corrects."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000023 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range obo:IAO_0000310 .

rheo:1000009 a owl:ObjectProperty ;
    rdfs:label "retracts"@en ;
    obo:IAO_0000115 "Relates a retraction notice to the document it withdraws."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000024 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range obo:IAO_0000310 .

rheo:1000010 a owl:ObjectProperty ;
    rdfs:label "selects estimate"@en ;
    obo:IAO_0000115 "Relates a parameter assignment to the economic evaluation estimate whose value it gives to the parameter."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000030 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000011 ;
    rdfs:subPropertyOf rheo:1000098 .

rheo:1000011 a owl:ObjectProperty ;
    rdfs:label "adopts assumption"@en ;
    obo:IAO_0000115 "Relates a parameter assignment to the modelling assumption whose value it gives to the parameter."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000030 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000020 ;
    rdfs:subPropertyOf rheo:1000098 .

rheo:1000014 a owl:ObjectProperty ;
    rdfs:label "is version of"@en ;
    obo:IAO_0000115 "Relates an economic model version to the economic model it is a version of."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000028 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000027 .

rheo:1000015 a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "has previous version"@en ;
    obo:IAO_0000115 "Relates an economic model version to the version it replaced."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000028 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000028 ;
    rdfs:subPropertyOf prov:wasRevisionOf .

rheo:1000016 a owl:ObjectProperty ;
    rdfs:label "has parameter"@en ;
    obo:IAO_0000115 "Relates an economic model version to a model parameter it takes as input."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000028 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000029 .

rheo:1000018 a owl:ObjectProperty ;
    rdfs:label "uses assignment"@en ;
    obo:IAO_0000115 "Relates a model run to a parameter assignment whose value it used."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000031 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000030 ;
    rdfs:subPropertyOf prov:used .

rheo:1000020 a owl:ObjectProperty ;
    rdfs:label "addresses decision problem"@en ;
    obo:IAO_0000115 "Relates an economic model to the decision problem specification it addresses."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000027 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000025 .

rheo:1000021 a owl:ObjectProperty ;
    rdfs:label "has option"@en ;
    obo:IAO_0000115 "Relates a decision problem specification to an intervention specification it compares."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000025 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000026 .

rheo:1000022 a owl:ObjectProperty ;
    rdfs:label "has decision population"@en ;
    obo:IAO_0000115 "Relates a decision problem specification to the population specification the decision concerns."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000025 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000004 .

rheo:1000023 a owl:ObjectProperty ;
    rdfs:label "has comparator"@en ;
    obo:IAO_0000115 "Relates a decision problem specification to the intervention specification against which the other options are compared."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000025 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000026 .

rheo:1000024 a owl:ObjectProperty ;
    rdfs:label "measured in population"@en ;
    obo:IAO_0000115 "Relates an estimate to the population specification of the persons in whom it was measured, when this differs from the population it is applied to."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000004 .

rheo:1000025 a owl:ObjectProperty ;
    rdfs:label "taken from source"@en ;
    obo:IAO_0000115 "Relates an estimate to the document or dataset it was taken from."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subPropertyOf prov:wasDerivedFrom .

rheo:1000026 a owl:ObjectProperty ;
    rdfs:label "derived from"@en ;
    obo:IAO_0000115 "Relates an estimate to another estimate or an assumption it was calculated from, such as a treatment-arm probability calculated from a baseline probability and a hazard ratio."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subPropertyOf prov:wasDerivedFrom .

rheo:1000027 a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "supersedes"@en ;
    obo:IAO_0000115 "Relates an estimate or an assumption to an earlier record of the same quantity that it replaces, for example after a correction to the source."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:subPropertyOf prov:wasRevisionOf .

rheo:1000028 a owl:ObjectProperty ;
    rdfs:label "has estimand population"@en ;
    obo:IAO_0000115 "Relates an estimand to the population specification it is defined for."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000010 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000004 .

rheo:1000029 a owl:ObjectProperty ;
    rdfs:label "has compared condition"@en ;
    obo:IAO_0000115 "Relates an estimand to an intervention specification whose effect it concerns, where the estimand compares conditions."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000010 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000026 .

rheo:1000030 a owl:ObjectProperty ;
    rdfs:label "for health state"@en ;
    obo:IAO_0000115 "Relates a parameter assignment to the model state the parameter refers to, where it refers to one."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
