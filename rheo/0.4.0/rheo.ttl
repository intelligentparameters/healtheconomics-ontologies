    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range rheo:0000066 .

rheo:1000096 a owl:ObjectProperty ;
    rdfs:label "specifies transitions for"@en ;
    obo:IAO_0000115 "Relates a transition specification to the economic model version, or the classification scheme version, whose transitions it governs."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain rheo:0000134 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( rheo:0000028 rheo:0000065 ) ] .

rheo:1000099 a owl:ObjectProperty ;
    rdfs:label "reviewed by"@en ;
    obo:IAO_0000115 "Relates a record to the person or organization that reviewed or approved it."@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/rheo> .

rheo:1000100 a owl:ObjectProperty ;
