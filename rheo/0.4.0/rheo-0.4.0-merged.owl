        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">cost of alternative</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_1000104 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000104">
