    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_1000051 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000051">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000080"/>
                    <rdf:Description rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000112"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0000245"/>
                    <rdf:Description rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000042"/>
                    <rdf:Description rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000043"/>
                    <rdf:Description rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000097"/>
                    <rdf:Description rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000118"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <obo:IAO_0000115 xml:lang="en">Relates a flow measurement or a projected count to the member group, resource stock, workforce, care setting or organization that the counted entities left.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">For counts only. The movement of a person from one care setting to another is recorded on the patient movement itself, with RO has start location (RO_0002231) and has end location (RO_0002232). An organization is admitted as the outside source or destination of a flow, such as a supplier of vaccine doses.</obo:IAO_0000116>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">counts flow from</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_1000052 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000052">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000080"/>
                    <rdf:Description rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000112"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0000245"/>
                    <rdf:Description rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000042"/>
                    <rdf:Description rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000043"/>
                    <rdf:Description rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000097"/>
                    <rdf:Description rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000118"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <obo:IAO_0000115 xml:lang="en">Relates a flow measurement or a projected count to the member group, resource stock, workforce, care setting or organization that the counted entities entered.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">For counts only. The movement of a person from one care setting to another is recorded on the patient movement itself, with RO has start location (RO_0002231) and has end location (RO_0002232). An organization is admitted as the outside source or destination of a flow, such as a supplier of vaccine doses.</obo:IAO_0000116>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">counts flow to</rdfs:label>
    </owl:ObjectProperty>
    


