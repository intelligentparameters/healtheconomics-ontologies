        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000011"/>
        <obo:IAO_0000115 xml:lang="en">Relates an adjusted cost record to the estimate it applies, such as an exchange rate, a price index ratio or a discount factor.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">uses adjustment factor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_1000103 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000103">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000074"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000026"/>
        <obo:IAO_0000115 xml:lang="en">Relates a cost record to the option whose cost it records, or, for an incremental cost record, the option whose cost is compared.</obo:IAO_0000115>
