        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000064"/>
        <obo:IAO_0000115 xml:lang="en">Relates a transition specification to a state that, under it, no entity leaves once it has entered.</obo:IAO_0000115>
