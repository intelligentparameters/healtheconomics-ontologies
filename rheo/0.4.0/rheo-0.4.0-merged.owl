        <rdfs:label xml:lang="en">authorises technology</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_1000076 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000076">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000109"/>
        <obo:IAO_0000115 xml:lang="en">Relates a funding rule to the class of document a technology must have to be funded, such as marketing authorisation or HTA recommendation (the class IRI is used as the value, which OWL 2 DL allows by punning).</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Operational meaning (0.3.0). Under the OWL 2 Direct Semantics the class used as a value is a separate individual, so this link does not make a reasoner require, or infer, any document. Application logic reads &apos;rule R requires class C&apos; as: a technology satisfies R on a date only if, for every class C that R requires, a record of class C about that technology is dated on or before that date; for an HTA recommendation, the latest such recommendation must be positive. ops/funding-rule.rq implements this reading for any required classes; run_demo.py tests it, and the record rules reject a value that is not a declared class of directive record.</obo:IAO_0000116>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">requires</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_1000077 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000077">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000099"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000026"/>
        <obo:IAO_0000115 xml:lang="en">Relates a trial arm specification to the intervention specification the arm receives.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">arm intervention</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_1000080 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000080">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000065"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000110"/>
        <obo:IAO_0000115 xml:lang="en">Relates a classification scheme version to the classification scheme it is a version of.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">is version of scheme</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_1000081 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000081">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000064"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000064"/>
        <obo:IAO_0000115 xml:lang="en">Relates a state description of a later scheme version to the state of an earlier version that it is a finer part of, such as a severe stage split from a single progressed stage.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">refines state</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_1000082 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000082">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000064"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000064"/>
        <obo:IAO_0000115 xml:lang="en">Relates a state description to a state description of another scheme version with the same meaning under a different name or identifier.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">same state as</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_1000083 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000083">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000005"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000064"/>
        <obo:IAO_0000115 xml:lang="en">Relates a clinical event type specification to the state the event starts from.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has from state</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_1000084 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000084">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000005"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000064"/>
        <obo:IAO_0000115 xml:lang="en">Relates a clinical event type specification to the state the event leads to.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has to state</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_1000085 -->

