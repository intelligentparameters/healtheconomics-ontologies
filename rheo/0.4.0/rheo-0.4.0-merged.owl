                    <rdf:Description rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000065"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <obo:IAO_0000115 xml:lang="en">Relates a transition specification to the economic model version, or the classification scheme version, whose transitions it governs.</obo:IAO_0000115>
