        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">adjusts cost record</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_1000102 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000102">
