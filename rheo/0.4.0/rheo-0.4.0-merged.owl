    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_1000105 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000105">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000074"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000074"/>
        <obo:IAO_0000115 xml:lang="en">Relates an incremental cost record to one of the two cost records whose difference it records.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">compares cost record</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_1000106 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000106">
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000020"/>
        <obo:IAO_0000115 xml:lang="en">Relates a costing process or a cost record to a modelling assumption its valuation depends on, such as the choice of a replacement cost for informal care.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">valuation rests on assumption</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_1000107 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000107">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000155"/>
        <obo:IAO_0000115 xml:lang="en">Relates an opportunity cost record to the alternative use of the resource that was forgone, given as an intervention specification or a care process type specification.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">forgoes alternative</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_1000110 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000110">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000067"/>
        <obo:IAO_0000115 xml:lang="en">Relates a transition record to a record of a process, intervention or resource use that maintained the entity&apos;s state between the two observations, such as the resource use record of a maintenance treatment: the analogue of the state costs of a Markov model.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">In the core since 0.3.0 (review B): state costs are not RNI theory. The RNI module uses this link for actively reproduced replacement. A maintenance record counts when its date, or its period, overlaps the interval between the two observations.</obo:IAO_0000116>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has state maintenance resource use</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_1000116 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000116">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000128"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000116"/>
        <obo:IAO_0000115 xml:lang="en">Relates a possibility change record to the geographic area in which the state became open, where the opening was local.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">records opened area</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_1000117 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000117">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000074"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000093"/>
        <obo:IAO_0000115 xml:lang="en">Relates a discounted cost record to the discounting specification (rates and base year) it applies.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">uses discounting specification</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_1000119 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000119">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000032"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000032"/>
        <obo:IAO_0000115 xml:lang="en">Relates a model result to another result of the same run it was calculated from, such as an ICER from its incremental cost and incremental QALYs.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">computed from result</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_1000120 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000120">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000074"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0000245"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OMRSE_00000076"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <obo:IAO_0000115 xml:lang="en">Relates a cost record to the organization, household or person that bears the cost, such as the commissioner, a local authority or a household paying a co-payment.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">borne by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_1000121 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000121">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000072"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0000245"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OMRSE_00000076"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <obo:IAO_0000115 xml:lang="en">Relates a perspective specification to an organization, household or person whose costs it counts. A perspective with no such list counts every bearer.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">counts costs borne by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000001 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000001">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <obo:IAO_0000115 xml:lang="en">The numeric value of an estimate, an assumed value or a model result.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has numeric value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000002 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000002">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">The unit or scale in which a value is expressed, in words, such as &apos;utility (0 = dead, 1 = full health)&apos; or &apos;GBP per admission&apos;.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has unit label</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000003 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000003">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">The ISO 4217 code of the currency of a cost, a model version or a model result, such as GBP.</obo:IAO_0000115>
        <obo:IAO_0000119>ISO 4217</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has currency code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000004 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000004">
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_3000003"/>
        <obo:IAO_0000115 xml:lang="en">The year or financial year whose prices a cost, a model version or a model result is expressed in, such as 2024 or 2023/24.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has price year</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000005 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000005">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">The ISO 3166 code of the country or region that an estimate, price or record applies to, or that a geographic area is, such as GB or GB-ENG, or INT for several countries.</obo:IAO_0000115>
        <obo:IAO_0000119>ISO 3166</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has jurisdiction code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000006 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000006">
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_3000002"/>
        <obo:IAO_0000115 xml:lang="en">The time interval a probability or a resource use estimate refers to, as an ISO 8601 duration such as P1Y.</obo:IAO_0000115>
        <obo:IAO_0000119>ISO 8601</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has time interval</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000007 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000007">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">The value set (tariff) used to turn an instrument&apos;s health state descriptions into utilities, such as the UK value set, without the instrument or its version, which are given by has instrument and has instrument version.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has value set</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000008 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000008">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">Where in the source document the value was taken from, such as Table 3, or which part a correction notice changes.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has source location</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000009 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000009">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">How an estimate was obtained from its source or calculated from other estimates.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has estimation method</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000010 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000010">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000019"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <obo:IAO_0000115 xml:lang="en">The standard error of an estimate.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has standard error</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000011 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000011">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000019"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <obo:IAO_0000115 xml:lang="en">The lower limit of an interval around an estimate or an assumed value.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has lower limit</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000012 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000012">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000019"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <obo:IAO_0000115 xml:lang="en">The upper limit of an interval around an estimate or an assumed value.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has upper limit</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000013 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000013">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000019"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <obo:IAO_0000115 xml:lang="en">The level of an interval as a proportion, such as 0.95 for a 95% confidence interval.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has interval level</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000014 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000014">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000019"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <obo:IAO_0000115 xml:lang="en">The STATO identifier of the probability distribution family describing the uncertainty, such as STATO_0000177 (beta distribution).</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has distribution family</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000015 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000015">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000019"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">The parameters of a distribution as text, such as alpha=48; beta=352, kept for people to read.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Where the uncertainty extension module (rheo-uncertainty.ttl) is used, its structured distribution parameters are authoritative and this text is a copy for display.</obo:IAO_0000116>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has distribution parameters</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000016 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000016">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">The reason for a parameter assignment or the justification of a modelling assumption.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has rationale</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000017 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000017">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000028"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">The label of an economic model version, such as 2.0.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has version label</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000018 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000018">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000028"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_3000001"/>
        <obo:IAO_0000115 xml:lang="en">The date an economic model version was fixed for use, written as an ISO 8601 date (YYYY-MM-DD).</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has release date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000019 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000019">
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_3000001"/>
        <obo:IAO_0000115 xml:lang="en">The date a correction notice or a retraction notice was issued (ISO 8601 date).</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has notice date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000020 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000020">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">The analysis that a model run or a parameter assignment belongs to, such as base case or scenario 2. An assignment can belong to several analyses and carries one label for each. An assignment without a label belongs to no stated analysis: missing is kept as missing.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has analysis label</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000021 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000021">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000004"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">The criteria that define a population, in words.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has population criteria</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000022 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000022">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">What a model result or a record measures, such as incremental cost-effectiveness ratio, incremental QALYs or total household consumption expenditure.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has measured quantity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000023 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000023">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">The method used to value a health state: indirect (an instrument with a value set) or direct, such as time trade-off or standard gamble.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has valuation method</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000024 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000024">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">The period the data behind an estimate refer to, such as 2019-2022.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has reference period</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000025 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000025">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">States that a probability is per event (for example, per procedure) rather than over a time interval.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has probability basis</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000026 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000026">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">A code from a clinical terminology or classification, with the name of the system, such as SNOMED CT 230690007.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000027 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000027">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">A free-text name of the perspective of a record, such as NHS and personal social services, kept as a label for people to read.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Rule (0.3.0): the perspective specification linked by &apos;under perspective&apos; (RHEO_1000049) is authoritative. This text is a label only: it is never used in checks or queries, a record that has it must also link a perspective specification, and where the two differ the specification governs.</obo:IAO_0000116>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has perspective label</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000028 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000028">
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_3000004"/>
        <obo:IAO_0000115 xml:lang="en">The time horizon of a decision problem or a model version, as an ISO 8601 duration such as P40Y, or the word lifetime.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has time horizon</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000029 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000029">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000028"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_3000002"/>
        <obo:IAO_0000115 xml:lang="en">The cycle length of a cohort model version, as an ISO 8601 duration such as P1Y.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has cycle length</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000030 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000030">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <obo:IAO_0000115 xml:lang="en">The annual discount rate applied to costs, as a proportion such as 0.035.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has cost discount rate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000031 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000031">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <obo:IAO_0000115 xml:lang="en">The annual discount rate applied to health outcomes, as a proportion such as 0.035.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has outcome discount rate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000032 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000032">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000010"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">The variable or outcome an estimand concerns, such as EQ-5D-3L utility at 12 months.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has variable</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000033 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000033">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000010"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">The population-level summary of the variable, such as the mean or a hazard ratio.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has summary measure</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000034 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000034">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000010"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">How events after the start of treatment that affect the variable are handled, such as treatment policy.</obo:IAO_0000115>
        <obo:IAO_0000119>ICH E9(R1) 2019</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has intercurrent event strategy</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000035 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000035">
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_3000001"/>
        <obo:IAO_0000115 xml:lang="en">The date a source document was published (ISO 8601 date).</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has publication date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000036 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000036">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">Why a value is absent: not reported, not applicable or not yet extracted. Keeps a missing value distinct from zero.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has missingness reason</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000037 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000037">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">The review status of a record: draft, reviewed or approved. An approved record names who approved it (reviewed by), when (has review date) and for what (has approval scope).</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Operational meaning (0.3.0): the status is a designation that workflow software acts on. The record rules reject &apos;approved&apos; without a reviewer, a review date and an approval scope, and a status outside draft, reviewed and approved.</obo:IAO_0000116>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has record status</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000040 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000040">
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_3000001"/>
        <obo:IAO_0000115 xml:lang="en">The date on which the state, quantity, payment, decision or event that a record describes was observed, took place or took effect, written as an ISO 8601 date (YYYY-MM-DD). It is not the date the record was made, which is given by has recording time.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has observation date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000041 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000041">
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_3000001"/>
        <obo:IAO_0000115 xml:lang="en">The first day of the period a record covers (YYYY-MM-DD).</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has period start</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000042 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000042">
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_3000001"/>
        <obo:IAO_0000115 xml:lang="en">The last day of the period a record covers (YYYY-MM-DD).</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has period end</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000043 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000043">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <obo:IAO_0000115 xml:lang="en">The quantity of a resource used, in the units given by the unit label.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has quantity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000044 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000044">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <obo:IAO_0000115 xml:lang="en">The number of members of a stock or of entities moving in a flow.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has count</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000045 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000045">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000078"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">Whether a price is a list price or a net price after discounts or agreements.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has price type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000046 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000046">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <obo:IAO_0000115 xml:lang="en">States that a value, such as a net price, is confidential and may not be published.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Operational meaning (0.3.0): &apos;true&apos; records a designation; it does not by itself restrict access. Software that publishes or shares records must remove confidential values (the public view query ops/public-view.rq does this and run_demo.py tests it). The record rules flag estimates taken from a confidential source and results computed from a confidential value that are not marked confidential.</obo:IAO_0000116>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">is confidential</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000047 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000047">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000082"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">The ISO 4217 code of the currency a conversion estimate converts into.</obo:IAO_0000115>
        <obo:IAO_0000119>ISO 4217</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has target currency code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000048 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000048">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">Whether a count records what was observed (stock and flow measurements, observed) or what a model run projects (projected counts, projected).</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has measurement basis</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000050 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000050">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000083"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">The decision stated in a recommendation: recommended, recommended with restrictions, recommended with managed access, recommended only in research, not recommended, or terminated appraisal.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has decision</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000051 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000051">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000082"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_3000005"/>
        <obo:IAO_0000115 xml:lang="en">The year a currency conversion estimate applies to.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has conversion year</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000060 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000060">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <obo:IAO_0000115 xml:lang="en">The time of an observation in years from a stated baseline, used to calculate quantities over time such as QALYs.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has time point</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000062 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000062">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <obo:IAO_0000115 xml:lang="en">States whether a QALY or cost record has been discounted.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">is discounted</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000063 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000063">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000094"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <obo:IAO_0000115 xml:lang="en">The years of life lost to premature death that a DALY record includes.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has years of life lost</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000064 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000064">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000094"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <obo:IAO_0000115 xml:lang="en">The years lived with disability that a DALY record includes.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has years lived with disability</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000065 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000065">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000098"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">The outcome on which payment under an outcomes-based agreement depends, in words.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has payment condition</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000066 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000066">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <obo:IAO_0000115 xml:lang="en">The size of a workforce or a flow of staff in full-time equivalents.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has full-time equivalents</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000067 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000067">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <obo:IAO_0000115 xml:lang="en">The number of people in a household.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has household size</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000068 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000068">
        <obo:IAO_0000115 xml:lang="en">OBSOLETE. Stated, on a state description, that once an entity is in the state it cannot leave it.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Made obsolete in 0.3.0. On a state description it read as a universal claim about the world. Use a transition specification for the model version or classification scheme version concerned, with &apos;treats as absorbing&apos;.</obo:IAO_0000116>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <obo:IAO_0100001 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000097"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">obsolete is absorbing</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000069 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000069">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">Why the entities in a flow left or entered a stock or group, such as administered, wasted, joined or left; used when a flow runs to or from outside the system recorded.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has flow reason</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000070 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000070">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000120"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <obo:IAO_0000115 xml:lang="en">The rank, from the lowest, of the adjusted reference price that sets the benchmark: 1 for the lowest, 2 for the second-lowest.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has benchmark rank</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000071 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000071">
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_3000001"/>
        <obo:IAO_0000115 xml:lang="en">The date from which a recorded change, such as a state becoming open, takes effect (ISO 8601 date, YYYY-MM-DD).</obo:IAO_0000115>
        <obo:IAO_0000119>ISO 8601</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has effective date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000072 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000072">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <obo:IAO_0000115 xml:lang="en">The date and time at which a record was made or entered into the system that holds it (xsd:dateTime). It is never earlier than the observation date, and is kept apart from it.</obo:IAO_0000115>
        <obo:IAO_0000119>ISO 8601</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has recording time</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000073 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000073">
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_3000001"/>
        <obo:IAO_0000115 xml:lang="en">The date a record was reviewed or approved (ISO 8601 date, YYYY-MM-DD).</obo:IAO_0000115>
        <obo:IAO_0000119>ISO 8601</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has review date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000074 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000074">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">What an approval covers, such as the base case inputs of a stated model version for a stated submission. An approval outside its scope is not an approval.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has approval scope</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000076 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000076">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">The instrument used to describe or measure a health state for valuation, such as EQ-5D or SF-6D, without its version or value set.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has instrument</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000077 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000077">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">The version of the instrument, such as 3L or 5L for EQ-5D.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has instrument version</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000088 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000088">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">How a state was observed, such as clinical examination, CT imaging or self-report. A change of method between two observations can change the state recorded without any change in the entity.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has observation method</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000089 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000089">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000074"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">The kind of adjustment an adjusted cost record applies: inflation, deflation, currency conversion or discounting.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has adjustment kind</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_2000092 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000092">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">The unit of a value as a UCUM code, such as 1 for a utility or a proportion, /a for a rate per year, a for years, or /{admission} for a cost per admission (the currency is given separately by its ISO 4217 code).</obo:IAO_0000115>
        <obo:IAO_0000119>UCUM (Unified Code for Units of Measure)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has unit code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.obolibrary.org/obo/BFO_0000001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000001">
        <obo:IAO_0000115 xml:lang="en">An entity is anything that exists or has existed or will exist.</obo:IAO_0000115>
        <obo:IAO_0000119>BFO 2020 (ISO/IEC 21838-2:2021) (elucidation)</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <dc:identifier>001-BFO</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <rdfs:label xml:lang="en">entity</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) An entity is anything that exists or has existed or will exist</skos:definition>
        <skos:example xml:lang="en">Julius Caesar; the Second World War; your body mass index; Verdi&apos;s Requiem</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000176"/>
                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <obo:IAO_0000115 xml:lang="en">A continuant is an entity that persists, endures, or continues to exist through time while maintaining its identity.</obo:IAO_0000115>
        <obo:IAO_0000119>BFO 2020 (ISO/IEC 21838-2:2021) (elucidation)</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <dc:identifier>008-BFO</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <rdfs:label xml:lang="en">continuant</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) A continuant is an entity that persists, endures, or continues to exist through time while maintaining its identity</skos:definition>
        <skos:example xml:lang="en">A human being; a tennis ball; a cave; a region of space; someone&apos;s temperature</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000003 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
        <obo:IAO_0000115 xml:lang="en">An occurrent is an entity that unfolds itself in time or it is the start or end of such an entity or it is a temporal or spatiotemporal region.</obo:IAO_0000115>
        <obo:IAO_0000119>BFO 2020 (ISO/IEC 21838-2:2021) (elucidation)</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <dc:identifier>077-BFO</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <rdfs:label xml:lang="en">occurrent</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) An occurrent is an entity that unfolds itself in time or it is the start or end of such an entity or it is a temporal or spatiotemporal region</skos:definition>
        <skos:example xml:lang="en">As for process, history, process boundary, spatiotemporal region, zero-dimensional temporal region, one-dimensional temporal region, temporal interval, temporal instant.</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000176"/>
                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <obo:IAO_0000115 xml:lang="en">b is an independent continuant =Def b is a continuant &amp; there is no c such that b specifically depends on c or b generically depends on c.</obo:IAO_0000115>
        <obo:IAO_0000119>BFO 2020 (ISO/IEC 21838-2:2021)</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <dc:identifier>017-BFO</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <rdfs:label xml:lang="en">independent continuant</rdfs:label>
        <skos:definition xml:lang="en">b is an independent continuant =Def b is a continuant &amp; there is no c such that b specifically depends on c or b generically depends on c</skos:definition>
        <skos:example xml:lang="en">An atom; a molecule; an organism; a heart; a chair; the bottom right portion of a human torso; a leg; the interior of your mouth; a spatial region; an orchestra</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000006 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000006">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000141"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000176"/>
                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000006"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:identifier>035-BFO</dc:identifier>
        <rdfs:label xml:lang="en">spatial region</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) A spatial region is a continuant entity that is a continuant part of the spatial projection of a portion of spacetime at a given time</skos:definition>
        <skos:example xml:lang="en">As for zero-dimensional spatial region, one-dimensional spatial region, two-dimensional spatial region, three-dimensional spatial region</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000008 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000008">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000132"/>
                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000008"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000139"/>
                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000008"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:identifier>100-BFO</dc:identifier>
        <rdfs:label xml:lang="en">temporal region</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) A temporal region is an occurrent over which processes can unfold</skos:definition>
        <skos:example xml:lang="en">As for zero-dimensional temporal region and one-dimensional temporal region</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000009 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000009">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000178"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000009"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000018"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000026"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:identifier>039-BFO</dc:identifier>
        <rdfs:label xml:lang="en">two-dimensional spatial region</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) A two-dimensional spatial region is a spatial region that is a whole consisting of a surface together with zero or more surfaces which may have spatial regions of lower dimension as parts</skos:definition>
        <skos:example xml:lang="en">The surface of a sphere-shaped part of space; an infinitely thin plane in space</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000011 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000011">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000132"/>
                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000011"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000139"/>
                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000011"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:identifier>095-BFO</dc:identifier>
        <rdfs:label xml:lang="en">spatiotemporal region</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) A spatiotemporal region is an occurrent that is an occurrent part of spacetime</skos:definition>
        <skos:example xml:lang="en">The spatiotemporal region occupied by the development of a cancer tumour; the spatiotemporal region occupied by an orbiting satellite</skos:example>
        <skos:scopeNote xml:lang="en">&apos;Spacetime&apos; here refers to the maximal instance of the universal spatiotemporal region.</skos:scopeNote>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000015 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000015">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000117"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000015"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000035"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000132"/>
                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000139"/>
                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/BFO_0000035"/>
        <obo:IAO_0000115 xml:lang="en">p is a process means p is an occurrent that has some temporal proper part and for some time t, p has some material entity as participant.</obo:IAO_0000115>
        <obo:IAO_0000119>BFO 2020 (ISO/IEC 21838-2:2021) (elucidation)</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <dc:identifier>083-BFO</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <rdfs:label xml:lang="en">process</rdfs:label>
        <skos:altLabel xml:lang="en">event</skos:altLabel>
        <skos:definition xml:lang="en">(Elucidation) p is a process means p is an occurrent that has some temporal proper part and for some time t, p has some material entity as participant</skos:definition>
        <skos:example xml:lang="en">An act of selling; the life of an organism; a process of sleeping; a process of cell-division; a beating of the heart; a process of meiosis; the taxiing of an aircraft; the programming of a computer</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000016 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000016">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <obo:IAO_0000115 xml:lang="en">A disposition b is a realizable entity such that if b ceases to exist then its bearer is physically changed &amp; b&apos;s realization occurs when and because this bearer is in some special physical circumstances &amp; this realization occurs in virtue of the bearer&apos;s physical make-up.</obo:IAO_0000115>
        <obo:IAO_0000119>BFO 2020 (ISO/IEC 21838-2:2021) (elucidation)</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <dc:identifier>062-BFO</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <rdfs:label xml:lang="en">disposition</rdfs:label>
        <skos:altLabel xml:lang="en">internally-grounded realizable entity</skos:altLabel>
        <skos:definition xml:lang="en">(Elucidation) A disposition b is a realizable entity such that if b ceases to exist then its bearer is physically changed &amp; b&apos;s realization occurs when and because this bearer is in some special physical circumstances &amp; this realization occurs in virtue of the bearer&apos;s physical make-up</skos:definition>
        <skos:example xml:lang="en">An atom of element X has the disposition to decay to an atom of element Y; the cell wall is disposed to transport cellular material through endocytosis and exocytosis; certain people have a predisposition to colon cancer; children are innately disposed to categorize objects in certain ways</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000017 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000017">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000020"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <obo:IAO_0000115 xml:lang="en">A realizable entity is a specifically dependent continuant that inheres in some independent continuant which is not a spatial region &amp; which is of a type some instances of which are realized in processes of a correlated type.</obo:IAO_0000115>
        <obo:IAO_0000119>BFO 2020 (ISO/IEC 21838-2:2021) (elucidation)</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <dc:identifier>058-BFO</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <rdfs:label xml:lang="en">realizable entity</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) A realizable entity is a specifically dependent continuant that inheres in some independent continuant which is not a spatial region &amp; which is of a type some instances of which are realized in processes of a correlated type</skos:definition>
        <skos:example xml:lang="en">The role of being a doctor; the role of this boundary to delineate where Utah and Colorado meet; the function of your reproductive organs; the disposition of your blood to coagulate; the disposition of this piece of metal to conduct electricity</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000018 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000018">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000178"/>
                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000018"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:identifier>037-BFO</dc:identifier>
        <rdfs:label xml:lang="en">zero-dimensional spatial region</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) A zero-dimensional spatial region is one or a collection of more than one spatially disjoint points in space</skos:definition>
        <skos:example xml:lang="en">The spatial region occupied at some time instant by the North Pole</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000019 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000020"/>
        <dc:identifier>055-BFO</dc:identifier>
        <rdfs:label xml:lang="en">quality</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) A quality is a specifically dependent continuant that, in contrast to roles and dispositions, does not require any further process in order to be realized</skos:definition>
        <skos:example xml:lang="en">The colour of a tomato; the ambient temperature of this portion of air; the length of the circumference of your waist; the shape of your nose; the shape of your nostril; the mass of this piece of gold</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000020 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <obo:IAO_0000115 xml:lang="en">b is a specifically dependent continuant =Def b is a continuant &amp; there is some independent continuant c which is not a spatial region &amp; which is such that b specifically depends on c.</obo:IAO_0000115>
        <obo:IAO_0000119>BFO 2020 (ISO/IEC 21838-2:2021)</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <dc:identifier>050-BFO</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <rdfs:label xml:lang="en">specifically dependent continuant</rdfs:label>
        <skos:definition xml:lang="en">b is a specifically dependent continuant =Def b is a continuant &amp; there is some independent continuant c which is not a spatial region &amp; which is such that b specifically depends on c</skos:definition>
        <skos:example xml:lang="en">(with multiple bearers) John&apos;s love for Mary; the ownership relation between John and this statue; the relation of authority between John and his subordinates</skos:example>
        <skos:example xml:lang="en">(with one bearer) The mass of this tomato; the pink colour of a medium rare piece of grilled filet mignon at its centre; the smell of this portion of mozzarella; the disposition of this fish to decay; the role of being a doctor; the function of this heart to pump blood; the shape of this hole</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000023 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000023">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
        <obo:IAO_0000115 xml:lang="en">A role b is a realizable entity such that b exists because there is some single bearer that is in some special physical, social, or institutional set of circumstances in which this bearer does not have to be &amp; b is not such that, if it ceases to exist, then the physical make-up of the bearer is thereby changed.</obo:IAO_0000115>
        <obo:IAO_0000119>BFO 2020 (ISO/IEC 21838-2:2021) (elucidation)</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <dc:identifier>061-BFO</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <rdfs:label xml:lang="en">role</rdfs:label>
        <skos:altLabel xml:lang="en">externally-grounded realizable entity</skos:altLabel>
        <skos:definition xml:lang="en">(Elucidation) A role b is a realizable entity such that b exists because there is some single bearer that is in some special physical, social, or institutional set of circumstances in which this bearer does not have to be &amp; b is not such that, if it ceases to exist, then the physical make-up of the bearer is thereby changed</skos:definition>
        <skos:example xml:lang="en">The priest role; the student role; the role of subject in a clinical trial; the role of a stone in marking a property boundary; the role of a boundary to demarcate two neighbouring administrative territories; the role of a building in serving as a military target</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000024 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000024">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <dc:identifier>027-BFO</dc:identifier>
        <rdfs:label xml:lang="en">fiat object part</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) A fiat object part b is a material entity &amp; such that if b exists then it is continuant part of some object c &amp; demarcated from the remainder of c by one or more fiat surfaces</skos:definition>
        <skos:example xml:lang="en">The upper and lower lobes of the left lung; the dorsal and ventral surfaces of the body; the Western hemisphere of the Earth; the FMA:regional parts of an intact human body</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000026 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000026">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000178"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000018"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000026"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:identifier>038-BFO</dc:identifier>
        <rdfs:label xml:lang="en">one-dimensional spatial region</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) A one-dimensional spatial region is a whole consisting of a line together with zero or more lines which may have points as parts</skos:definition>
        <skos:example xml:lang="en">An edge of a cube-shaped portion of space; a line connecting two points; two parallel lines extended in space</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000027 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <obo:IAO_0000115 xml:lang="en">An object aggregate is a material entity consisting exactly of a plurality (≥1) of objects as member parts which together form a unit.</obo:IAO_0000115>
        <obo:IAO_0000119>BFO 2020 (ISO/IEC 21838-2:2021) (elucidation)</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <dc:identifier>025-BFO</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <rdfs:label xml:lang="en">object aggregate</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) An object aggregate is a material entity consisting exactly of a plurality (≥1) of objects as member parts which together form a unit</skos:definition>
        <skos:example xml:lang="en">The aggregate of the musicians in a symphony orchestra and their instruments; the aggregate of bearings in a constant velocity axle joint; the nitrogen atoms in the atmosphere; a collection of cells in a blood biobank</skos:example>
        <skos:scopeNote>&apos;Exactly&apos; means that there are no parts of the object aggregate other than its member parts.</skos:scopeNote>
        <skos:scopeNote>The unit can, at certain times, consist of exactly one object, for example, when a wolf litter loses all but one of its pups, but it must at some time have a plurality of member parts.</skos:scopeNote>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000028 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000028">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000178"/>
                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000006"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:identifier>040-BFO</dc:identifier>
        <rdfs:label xml:lang="en">three-dimensional spatial region</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) A three-dimensional spatial region is a whole consisting of a spatial volume together with zero or more spatial volumes which may have spatial regions of lower dimension as parts</skos:definition>
        <skos:example xml:lang="en">A cube-shaped region of space; a sphere-shaped region of space; the region of space occupied by all and only the planets in the solar system at some point in time</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000029 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000029">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000141"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000176"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000029"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000040"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000178"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000029"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000140"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000210"/>
                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000028"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A site is a three-dimensional immaterial entity whose boundaries either (partially or wholly) coincide with the boundaries of one or more material entities or have locations determined in relation to some material entity.</obo:IAO_0000115>
        <obo:IAO_0000119>BFO 2020 (ISO/IEC 21838-2:2021) (elucidation)</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <dc:identifier>034-BFO</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <rdfs:label xml:lang="en">site</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) A site is a three-dimensional immaterial entity whose boundaries either (partially or wholly) coincide with the boundaries of one or more material entities or have locations determined in relation to some material entity</skos:definition>
        <skos:example xml:lang="en">A hole in a portion of cheese; a rabbit hole; the Grand Canyon; the Piazza San Marco; the kangaroo-joey-containing hole of a kangaroo pouch; your left nostril (a fiat part - the opening - of your left nasal cavity); the lumen of your gut; the hold of a ship; the interior of the trunk of your car; hole in an engineered floor joist</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000030 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000030">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <obo:IAO_0000115 xml:lang="en">An object is a material entity which manifests causal unity &amp; is of a type instances of which are maximal relative to the sort of causal unity manifested.</obo:IAO_0000115>
        <obo:IAO_0000119>BFO 2020 (ISO/IEC 21838-2:2021) (elucidation)</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <dc:identifier>024-BFO</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <rdfs:label xml:lang="en">object</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) An object is a material entity which manifests causal unity &amp; is of a type instances of which are maximal relative to the sort of causal unity manifested</skos:definition>
        <skos:example xml:lang="en">An organism; a fish tank; a planet; a laptop; a valve; a block of marble; an ice cube</skos:example>
        <skos:scopeNote xml:lang="en">A description of three primary sorts of causal unity is provided in Basic Formal Ontology 2.0. Specification and User Guide</skos:scopeNote>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000031 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000031">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <obo:IAO_0000115 xml:lang="en">A generically dependent continuant is an entity that exists in virtue of the fact that there is at least one of what may be multiple copies which is the content or the pattern that multiple copies would share.</obo:IAO_0000115>
        <obo:IAO_0000119>BFO 2020 (ISO/IEC 21838-2:2021) (elucidation)</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <dc:identifier>074-BFO</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <rdfs:label xml:lang="en">generically dependent continuant</rdfs:label>
        <skos:altLabel xml:lang="en">g-dependent continuant</skos:altLabel>
        <skos:definition xml:lang="en">(Elucidation) A generically dependent continuant is an entity that exists in virtue of the fact that there is at least one of what may be multiple copies which is the content or the pattern that multiple copies would share</skos:definition>
        <skos:example xml:lang="en">The pdf file on your laptop; the pdf file that is a copy thereof on my laptop; the sequence of this protein molecule; the sequence that is a copy thereof in that protein molecule; the content that is shared by a string of dots and dashes written on a page and the transmitted Morse code signal; the content of a sentence; an engineering blueprint</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000034 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000034">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
        <dc:identifier>064-BFO</dc:identifier>
        <rdfs:label xml:lang="en">function</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) A function is a disposition that exists in virtue of its bearer&apos;s physical make-up &amp; this physical make-up is something the bearer possesses because it came into being either through evolution (in the case of natural biological entities) or through intentional design (in the case of artefacts) in order to realize processes of a certain sort</skos:definition>
        <skos:example xml:lang="en">The function of a hammer to drive in nails; the function of a heart pacemaker to regulate the beating of a heart through electricity</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000035 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000035">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000117"/>
                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000035"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000121"/>
                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000035"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000132"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000015"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000035"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000139"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000015"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000035"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">p is a process boundary =Def p is a temporal part of a process &amp; p has no proper temporal parts.</obo:IAO_0000115>
        <obo:IAO_0000119>BFO 2020 (ISO/IEC 21838-2:2021)</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <dc:identifier>084-BFO</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <rdfs:label xml:lang="en">process boundary</rdfs:label>
        <skos:definition xml:lang="en">p is a process boundary =Def p is a temporal part of a process &amp; p has no proper temporal parts</skos:definition>
        <skos:example xml:lang="en">The boundary between the 2nd and 3rd year of your life</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000038 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000038">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000008"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000121"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000038"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000148"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000139"/>
                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000038"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/BFO_0000148"/>
        <dc:identifier>103-BFO</dc:identifier>
        <rdfs:label xml:lang="en">one-dimensional temporal region</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) A one-dimensional temporal region is a temporal region that is a whole that has a temporal interval and zero or more temporal intervals and temporal instants as parts</skos:definition>
        <skos:example xml:lang="en">The temporal region during which a process occurs</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000040 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000040">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000176"/>
                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000178"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000029"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000040"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000140"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/BFO_0000141"/>
        <obo:IAO_0000115 xml:lang="en">A material entity is an independent continuant that at all times at which it exists has some portion of matter as continuant part.</obo:IAO_0000115>
        <obo:IAO_0000119>BFO 2020 (ISO/IEC 21838-2:2021) (elucidation)</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <dc:identifier>019-BFO</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <rdfs:label xml:lang="en">material entity</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) A material entity is an independent continuant has some portion of matter as continuant part</skos:definition>
        <skos:example xml:lang="en">A human being; the undetached arm of a human being; an aggregate of human beings</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000140 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000140">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000141"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000124"/>
                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000140"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000178"/>
                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000140"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:identifier>029-BFO</dc:identifier>
        <rdfs:label xml:lang="en">continuant fiat boundary</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) A continuant fiat boundary b is an immaterial entity that is of zero, one or two dimensions &amp; such that there is no time t when b has a spatial region as continuant part &amp; whose location is determined in relation to some material entity</skos:definition>
        <skos:example xml:lang="en">As for fiat point, fiat line, fiat surface</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000141 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000141">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
        <obo:IAO_0000115 xml:lang="en">b is an immaterial entity =Def b is an independent continuant which is such that there is no time t when it has a material entity as continuant part.</obo:IAO_0000115>
        <obo:IAO_0000119>BFO 2020 (ISO/IEC 21838-2:2021)</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <dc:identifier>028-BFO</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <rdfs:label xml:lang="en">immaterial entity</rdfs:label>
        <skos:definition xml:lang="en">b is an immaterial entity =Def b is an independent continuant which is such that there is no time t when it has a material entity as continuant part</skos:definition>
        <skos:example xml:lang="en">As for fiat point, fiat line, fiat surface, site</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000142 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000142">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000140"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000178"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000142"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000147"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:identifier>032-BFO</dc:identifier>
        <rdfs:label xml:lang="en">fiat line</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) A fiat line is a one-dimensional continuant fiat boundary that is continuous</skos:definition>
        <skos:example xml:lang="en">The Equator; all geopolitical boundaries; all lines of latitude and longitude; the median sulcus of your tongue; the line separating the outer surface of the mucosa of the lower lip from the outer surface of the skin of the chin</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000145 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000145">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <dc:identifier>057-BFO</dc:identifier>
        <rdfs:label xml:lang="en">relational quality</rdfs:label>
        <skos:definition xml:lang="en">b is a relational quality =Def b is a quality &amp; there exists c and d such that c and d are not identical &amp; b specifically depends on c &amp; b specifically depends on d</skos:definition>
        <skos:example xml:lang="en">A marriage bond; an instance of love; an obligation between one person and another</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000146 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000146">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000140"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000178"/>
                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000140"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:identifier>033-BFO</dc:identifier>
        <rdfs:label xml:lang="en">fiat surface</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) A fiat surface is a two-dimensional continuant fiat boundary that is self-connected</skos:definition>
        <skos:example xml:lang="en">The surface of the Earth; the plane separating the smoking from the non-smoking zone in a restaurant</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000147 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000147">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000140"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000178"/>
                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000147"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:identifier>031-BFO</dc:identifier>
        <rdfs:label xml:lang="en">fiat point</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) A fiat point is a zero-dimensional continuant fiat boundary that consists of a single point</skos:definition>
        <skos:example xml:lang="en">The geographic North Pole; the quadripoint where the boundaries of Colorado, Utah, New Mexico and Arizona meet; the point of origin of some spatial coordinate system</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000148 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000148">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000008"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000121"/>
                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:identifier>102-BFO</dc:identifier>
        <rdfs:label xml:lang="en">zero-dimensional temporal region</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) A zero-dimensional temporal region is a temporal region that is a whole consisting of one or more separated temporal instants as parts</skos:definition>
        <skos:example xml:lang="en">A temporal region that is occupied by a process boundary; the moment at which a finger is detached in an industrial accident</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000182 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000182">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <dc:identifier>138-BFO</dc:identifier>
        <rdfs:label xml:lang="en">history</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) A history is a process that is the sum of the totality of processes taking place in the spatiotemporal region occupied by the material part of a material entity</skos:definition>
        <skos:example xml:lang="en">The life of an organism from the beginning to the end of its existence</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000202 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000202">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000038"/>
        <dc:identifier>155-BFO</dc:identifier>
        <rdfs:label xml:lang="en">temporal interval</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) A temporal interval is a one-dimensional temporal region that is continuous, thus without gaps or breaks</skos:definition>
        <skos:example xml:lang="en">The year 2018.</skos:example>
        <skos:scopeNote xml:lang="en">A one-dimensional temporal region can include as parts not only temporal intervals but also temporal instants separated from other parts by gaps.</skos:scopeNote>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000203 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000203">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000148"/>
        <dc:identifier>209-BFO</dc:identifier>
        <rdfs:label xml:lang="en">temporal instant</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) A temporal instant is a zero-dimensional temporal region that has no proper temporal part</skos:definition>
        <skos:example xml:lang="en">The millennium</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/COB_0000022 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/COB_0000022">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <obo:IAO_0000115 xml:lang="en">A material entity that is a maximal functionally integrated unit that develops from a program encoded in a genome.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">COB places organism under material entity; OBI&apos;s import shows it under &apos;material anatomical entity&apos;.</obo:IAO_0000116>
        <obo:IAO_0000119>OBI (http://purl.obolibrary.org/obo/obi.owl)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/obi.owl"/>
        <rdfs:label xml:lang="en">organism</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/COB_0000082 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/COB_0000082">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000115 xml:lang="en">A process that is initiated by an agent who intends to carry out a plan to achieve an objective through one or more actions as described in a plan specification.</obo:IAO_0000115>
        <obo:IAO_0000119>OBI (http://purl.obolibrary.org/obo/obi.owl)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/obi.owl"/>
        <rdfs:label xml:lang="en">planned process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/COB_0001300 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/COB_0001300">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <obo:IAO_0000115 xml:lang="en">A processed material entity which is designed to be capable of a process.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">COB asserts COB_0000026 (processed material entity), a material entity; abbreviated here to material entity. Reused in place of RHEO_0000045, now obsolete.</obo:IAO_0000116>
        <obo:IAO_0000119>OBI (http://purl.obolibrary.org/obo/obi.owl)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/obi.owl"/>
        <rdfs:label xml:lang="en">device</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000027 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that is intended to be one or more truthful statement(s) about something (modulo, e.g., measurement precision or other systematic errors) and is constructed/acquired by a method which reliably tends to produce (approximately) truthful statements.</obo:IAO_0000115>
        <obo:IAO_0000119>IAO (http://purl.obolibrary.org/obo/iao.owl)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/iao.owl"/>
        <rdfs:label xml:lang="en">data entity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000030 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000030">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <obo:IAO_0000115 xml:lang="en">A generically dependent continuant that is about some thing.</obo:IAO_0000115>
        <obo:IAO_0000119>IAO (http://purl.obolibrary.org/obo/iao.owl)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/iao.owl"/>
        <rdfs:label xml:lang="en">information content entity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000033 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000033">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity whose concretizations indicate to their bearer how to realize them in a process.</obo:IAO_0000115>
        <obo:IAO_0000119>IAO (http://purl.obolibrary.org/obo/iao.owl)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/iao.owl"/>
        <rdfs:label xml:lang="en">directive information entity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000104 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000104">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <obo:IAO_0000115 xml:lang="en">A directive information entity with action specifications and objective specifications as parts, and that may be concretized as a realizable entity that, if realized, is realized in a process in which the bearer tries to achieve the objectives by taking the actions specified.</obo:IAO_0000115>
        <obo:IAO_0000119>IAO (http://purl.obolibrary.org/obo/iao.owl)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/iao.owl"/>
        <rdfs:label xml:lang="en">plan specification</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000109 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000109">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000032"/>
        <obo:IAO_0000115 xml:lang="en">A measurement datum is an information content entity that is a recording of the output of a measurement such as produced by a device.</obo:IAO_0000115>
        <obo:IAO_0000119>IAO (http://purl.obolibrary.org/obo/iao.owl)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/iao.owl"/>
        <rdfs:label xml:lang="en">measurement datum</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000310 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000310">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">A collection of information content entities intended to be understood together as a whole</obo:IAO_0000115>
        <obo:IAO_0000119>IAO (http://purl.obolibrary.org/obo/iao.owl)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/iao.owl"/>
        <rdfs:label xml:lang="en">document</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/NCBITaxon_9606 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCBITaxon_9606">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0000022"/>
        <obo:IAO_0000115 xml:lang="en">The species of human beings; used here for persons as organisms.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">NCBI Taxonomy gives no textual definition; the definition here is a RHEO gloss. Its asserted parent is the genus Homo, abbreviated here to organism.</obo:IAO_0000116>
        <obo:IAO_0000119>NCBI Taxonomy (http://purl.obolibrary.org/obo/ncbitaxon.owl)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/ncbitaxon.owl"/>
        <rdfs:label xml:lang="en">Homo sapiens</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0000066 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0000066">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0000082"/>
        <obo:IAO_0000115 xml:lang="en">a planned process that consists of parts: planning, study design execution, documentation and which produce conclusion(s).</obo:IAO_0000115>
        <obo:IAO_0000119>OBI (http://purl.obolibrary.org/obo/obi.owl)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/obi.owl"/>
        <rdfs:label xml:lang="en">investigation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0000245 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0000245">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <obo:IAO_0000115 xml:lang="en">An entity that can bear roles, has members, and has a set of organization rules. Members of organizations are either organizations themselves or individual people.</obo:IAO_0000115>
        <obo:IAO_0000119>OBI (http://purl.obolibrary.org/obo/obi.owl)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/obi.owl"/>
        <rdfs:label xml:lang="en">organization</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0600007 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0600007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0000082"/>
        <obo:IAO_0000115 xml:lang="en">A process by which a substance is intentionally given to an organism resulting in exposure of the organism to that substance.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">OBI asserts OBI_0000274 (adding a material entity into a target), itself a planned process; abbreviated here to COB_0000082.</obo:IAO_0000116>
        <obo:IAO_0000119>OBI (http://purl.obolibrary.org/obo/obi.owl)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/obi.owl"/>
        <rdfs:label xml:lang="en">administering substance in vivo</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OGMS_0000031 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OGMS_0000031">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
        <obo:IAO_0000115 xml:lang="en">A disposition (i) to undergo pathological processes that (ii) exists in an organism because of one or more disorders in that organism.</obo:IAO_0000115>
        <obo:IAO_0000119>OGMS (http://purl.obolibrary.org/obo/ogms.owl)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/ogms.owl"/>
        <rdfs:label xml:lang="en">disease</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OGMS_0000096 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OGMS_0000096">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0000082"/>
        <obo:IAO_0000115 xml:lang="en">A planned process with the objective to improve the health status of a patient that directly involves the treatment, diagnosis, or prevention of disease or injury of a patient.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">OGMS asserts OBI_0000011, now obsolete and replaced by COB_0000035 (completely executed planned process), a subclass of COB_0000082; abbreviated here to COB_0000082. Reused in place of RHEO_0000001, which is now obsolete. An emergency admission is included: the event is unplanned, but the care given is a planned process.</obo:IAO_0000116>
        <obo:IAO_0000119>OGMS (http://purl.obolibrary.org/obo/ogms.owl)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/ogms.owl"/>
        <rdfs:label xml:lang="en">health care process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OGMS_0000097 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OGMS_0000097">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000096"/>
        <obo:IAO_0000115 xml:lang="en">A temporally-connected health care process that has as participants an organization or person realizing the health care provider role and a person realizing the patient role. The health care provider role and patient are realized during the health care encounter.</obo:IAO_0000115>
        <obo:IAO_0000119>OGMS (http://purl.obolibrary.org/obo/ogms.owl)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/ogms.owl"/>
        <rdfs:label xml:lang="en">health care encounter</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OMRSE_00000010 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OMRSE_00000010">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <obo:IAO_0000115 xml:lang="en">A role in human social processes that is realized by health care processes such as seeking or providing treatment for disease and injury, diagnosing disease and injury, or undergoing diagnosis.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">OMRSE places it under &apos;role in human social processes&apos;, a kind of role; abbreviated here to role.</obo:IAO_0000116>
        <obo:IAO_0000119>OMRSE (http://purl.obolibrary.org/obo/omrse.owl)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/omrse.owl"/>
        <rdfs:label xml:lang="en">health care role</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OMRSE_00000011 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OMRSE_00000011">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OMRSE_00000010"/>
        <obo:IAO_0000115 xml:lang="en">A health care role borne by an organism and that is realized by presenting to a health care provider in a clinical encounter.</obo:IAO_0000115>
        <obo:IAO_0000119>OMRSE (http://purl.obolibrary.org/obo/omrse.owl)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/omrse.owl"/>
        <rdfs:label xml:lang="en">patient role</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OMRSE_00000012 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OMRSE_00000012">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OMRSE_00000010"/>
        <obo:IAO_0000115 xml:lang="en">A health care role inhering in an organization or human being that is realized by a process of providing health care services to an organism.</obo:IAO_0000115>
        <obo:IAO_0000119>OMRSE (http://purl.obolibrary.org/obo/omrse.owl)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/omrse.owl"/>
        <rdfs:label xml:lang="en">health care provider role</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OMRSE_00000076 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OMRSE_00000076">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <obo:IAO_0000115 xml:lang="en">A human or collection of humans that occupies a housing unit by storing their possessions there and habitually sleeping there thereby participating in the realization of that housing unit&apos;s residence function.</obo:IAO_0000115>
        <obo:IAO_0000119>OMRSE (http://purl.obolibrary.org/obo/omrse.owl)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/omrse.owl"/>
        <rdfs:label xml:lang="en">household</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/STATO_0000039 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/STATO_0000039">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <obo:IAO_0000115 xml:lang="en">a statistic is a measurement datum to describe a dataset or a variable. It is generated by a calculation on set of observed data.</obo:IAO_0000115>
        <obo:IAO_0000119>STATO (http://purl.obolibrary.org/obo/stato.owl)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/stato.owl"/>
        <rdfs:label xml:lang="en">statistic</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/STATO_0000471 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/STATO_0000471">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/STATO_0000039"/>
        <obo:IAO_0000115 xml:lang="en">a estimate is a data item which is computed from a dataset to provide an approximated value (an estimator) for a &apos;statistical parameter&apos; (a &apos;characteristics/parameter&apos; of the true underlying distribution) of a real population.</obo:IAO_0000115>
        <obo:IAO_0000119>STATO (http://purl.obolibrary.org/obo/stato.owl)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/stato.owl"/>
        <rdfs:label xml:lang="en">estimate</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/STATO_0000599 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/STATO_0000599">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/STATO_0000471"/>
        <obo:IAO_0000115 xml:lang="en">a point estimate is a data item which provides a particular value evaluating a population parameter</obo:IAO_0000115>
        <obo:IAO_0000119>STATO (http://purl.obolibrary.org/obo/stato.owl)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/stato.owl"/>
        <rdfs:label xml:lang="en">point estimate</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/VO_0000002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/VO_0000002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0600007"/>
        <obo:IAO_0000115 xml:lang="en">Process of administering a vaccine in vivo to a recipient (e.g., a human), with the intent to invoke a protective or therapeutic adaptive immune response.</obo:IAO_0000115>
        <obo:IAO_0000119>VO (http://purl.obolibrary.org/obo/vo.owl)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/vo.owl"/>
        <rdfs:label xml:lang="en">vaccination</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000001 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000001">
        <obo:IAO_0000115 xml:lang="en">OBSOLETE. A process in which health care is delivered to one or more persons, such as a consultation, an inpatient stay, an emergency admission or the administration of a medicine.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <obo:IAO_0000231 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000228"/>
        <obo:IAO_0100001 rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000096"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">obsolete health care process</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000002 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <obo:IAO_0000115 xml:lang="en">A role borne by a material entity, such as a medicine, a medical device or a hospital bed, that is realised when the entity is consumed or occupied in a health care, social care or informal care process.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Being a resource is a role, not a kind of thing: a bed is a material entity that bears this role in a care process. Staff time is represented through the participation of staff in a health care process.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">health care resource role</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000003 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000115 xml:lang="en">A process in the health course of a person, such as a stroke, a fracture or the progression of a disease.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">clinical event</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000004 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that states the criteria, such as condition, severity, age range and care setting, defining the persons to whom an estimate, a study or a decision applies.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">A specification, not the group of persons itself: criteria-defined populations include future patients. The actual persons in a study can be added later as an OBI population (OBI_0000181).</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">population specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000005 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000005">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that identifies a kind of clinical event that estimates refer to, such as disease progression or stroke, optionally with a code from a clinical terminology.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Estimates are about kinds of event, not one particular occurrence, so they point to this specification rather than to an individual clinical event.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">clinical event type specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000006 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000006">
        <obo:IAO_0000115 xml:lang="en">OBSOLETE. An information content entity that identifies a kind of health care process or a kind of resource that cost and resource use estimates refer to, such as an emergency admission or a hospital bed day, optionally with a code from a classification.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Split in 0.2.2 into care process type specification (RHEO_0000122) and resource type specification (RHEO_0000123), under costed item type specification (RHEO_0000121). Use the subclass that fits.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <obo:IAO_0000231 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000229"/>
        <obo:IAO_0100001 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000121"/>
        <oboInOwl:consider rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000122"/>
        <oboInOwl:consider rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000123"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">obsolete care process or resource type specification</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000010 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000010">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000011"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000020"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that specifies the quantity an analysis aims to estimate by stating the population, the variable or outcome, the summary measure and, where relevant, the conditions compared and the handling of intercurrent events.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">ICH E9(R1) defines estimands for treatment effects in trials. RHEO extends the idea to descriptive quantities such as a mean utility, for which conditions compared and intercurrent events may not apply.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from ICH E9(R1) 2019</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">estimand</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000011 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000011">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/STATO_0000599"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000020"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">A point estimate of a quantity used in an economic evaluation, such as a utility, a cost, a probability or a relative effect.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Which estimate a model uses is recorded separately, in a parameter assignment, so that one estimate can serve several models and a model can change its choice without changing the estimate. The context a usable estimate must carry is set by the record rules.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">economic evaluation estimate</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000012 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000012">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000011"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000090"/>
        <obo:IAO_0000112 xml:lang="en">Mean EQ-5D-3L utility of 0.78 for stable disease, UK value set.</obo:IAO_0000112>
        <obo:IAO_0000115 xml:lang="en">An economic evaluation estimate of the preference-based value of a health state on a scale on which full health is 1 and dead is 0, obtained by a stated valuation method and, for indirect methods, a stated instrument and value set.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">utility estimate</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000013 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000013">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000011"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000074"/>
        <obo:IAO_0000115 xml:lang="en">An economic evaluation estimate of the monetary value of resources consumed, valued from a stated perspective, in a stated currency and price year.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">May be negative, for example an incremental cost or a cost offset.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">cost estimate</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000014 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000014">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000013"/>
        <obo:IAO_0000115 xml:lang="en">A cost estimate for one unit of a resource or of a health care process, such as one hospital bed day or one consultation.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">unit cost estimate</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000015 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000015">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000011"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000071"/>
        <obo:IAO_0000115 xml:lang="en">An economic evaluation estimate of the quantity of a resource or a health care process used per person or per event over a stated period, in natural units.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">resource use estimate</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000016 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000016">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000011"/>
        <obo:IAO_0000115 xml:lang="en">An economic evaluation estimate of the probability that a kind of clinical event occurs, either within a stated time interval or per event, in a stated population.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">A probability over a time interval always needs that interval: the same rate gives different probabilities over different intervals.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Briggs et al. 2006</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">probability estimate</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000017 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000017">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000011"/>
        <obo:IAO_0000112 xml:lang="en">1.8 emergency admissions per patient-year among adults with moderate Merrow&apos;s disease (fictional).</obo:IAO_0000112>
        <obo:IAO_0000115 xml:lang="en">An economic evaluation estimate of the number of clinical events of a kind per unit of person-time in a stated population.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Briggs et al. 2006</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">event rate estimate</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000018 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000018">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000011"/>
        <obo:IAO_0000115 xml:lang="en">An economic evaluation estimate of the effect of an intervention relative to a comparator, expressed as a ratio or a difference, such as a hazard ratio or a relative risk.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Briggs et al. 2006</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">relative effect estimate</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000019 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that describes the uncertainty about an estimate or an assumed value, as a standard error, as an interval with its level, or as a probability distribution with its parameters.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Briggs et al. 2006</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">uncertainty specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000020 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that states a value or a condition adopted in an analysis without direct estimation from data, together with its justification.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">An assumption is not an estimate. Recording it separately lets an analyst list every result that depends on a judgement rather than on data. An assumed value may still carry a range for sensitivity analysis.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">modelling assumption</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000021 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000021">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000064"/>
        <obo:IAO_0000115 xml:lang="en">A state description that describes a health state of a person, such as stable disease or the EQ-5D profile 21121, that is observed, valued or modelled.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">A description, not the state of a person: a utility estimate values the state as described.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">health state description</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000022 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000022">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000310"/>
        <obo:IAO_0000115 xml:lang="en">A document from which an economic evaluation estimate is taken, such as a trial report, a published study, a national cost schedule or a registry report.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">evidence source document</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000023 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000023">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000310"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000024"/>
        <obo:IAO_0000115 xml:lang="en">A document issued by the authors or publisher of a document that corrects part of its content while the rest stands.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">A correction notice can itself be the source of a corrected value.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">correction notice</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000024 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000024">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000310"/>
        <obo:IAO_0000115 xml:lang="en">A document issued by the authors or publisher of a document that withdraws it, so that its findings are no longer to be relied on.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">retraction notice</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000025 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000025">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that states the decision an economic evaluation is to inform: the population, the options compared, the outcomes, the perspective, the setting and the time horizon.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">decision problem specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000026 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000026">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
        <obo:IAO_0000115 xml:lang="en">A plan specification describing a health care intervention or programme that is one of the options compared in an economic evaluation.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Being the comparator is not a kind of intervention: it is the place an intervention specification takes in a particular decision problem (see has comparator).</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">intervention specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000027 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000028"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that represents a decision problem mathematically and combines evidence and assumptions to estimate the costs and outcomes of the options compared.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Briggs et al. 2006</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">economic model</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000028 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000028">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that is a fixed, identified state of an economic model, with a defined structure and set of parameters, that can be run to produce results.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The spreadsheet or program file is the bearer that concretises a version; it is not part of the version&apos;s definition.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">economic model version</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000029 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000029">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that is a named input quantity of an economic model version, such as the utility of a health state or a transition probability.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The parameter is the input slot, not its value. Close to STATO model parameter (STATO_0000034), which is defined for statistical models.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">model parameter</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000030 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000030">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000012"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000029"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000013"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000028"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000098"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000011"/>
                            <rdf:Description rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000020"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000012"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000013"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000098"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An information content entity recording that, in a stated economic model version, a stated model parameter takes the value of one stated economic evaluation estimate or one stated modelling assumption, with the reason for the choice.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">OWL axioms (0.3.0): at most one basis, one parameter and one model version, and at least one of each. Under open-world semantics a missing basis is not an error for a reasoner, and two bases of the same kind are read as the same thing; an estimate and an assumption as two bases contradict, because estimates and assumptions are disjoint. Completeness (exactly one basis, units, population, time interval, justification, analysis) is checked by the record rules in rheo-shapes.ttl.</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">The assignment separates the evidence (the estimate) from the modelling decision to use it. A value computed from several inputs (a treatment-arm probability, an inflated cost) is recorded as a derived estimate, and the assignment selects that.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">parameter assignment</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000031 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000031">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0000082"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000017"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000028"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000017"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A planned process in which an economic model version is executed with a set of parameter assignments to produce results for a stated analysis, such as the base case or a scenario.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">model run</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000032 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000032">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000019"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000090"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000092"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000094"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000100"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000104"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000106"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000112"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000128"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000129"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000130"/>
        <obo:IAO_0000115 xml:lang="en">A data entity produced by a model run, such as a total cost, total quality-adjusted life years or an incremental cost-effectiveness ratio, for a stated option or comparison.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">model result</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000033 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000033">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000021"/>
        <obo:IAO_0000112 xml:lang="en">The EQ-5D-3L profile 21121.</obo:IAO_0000112>
        <obo:IAO_0000115 xml:lang="en">A health state description given as a combination of levels on the dimensions of a health state classification system, such as the EQ-5D profile 21121.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">health state classification profile</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000034 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000034">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000021"/>
        <obo:IAO_0000115 xml:lang="en">A health state description used as a state of an economic model, such as stable disease or progressed disease in a cohort model, that stands for the clinical or classification state descriptions it approximates.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">A model state is a component of an economic model. It is not a stage of disease, and no person is ever in it. Utilities measured in people value clinical or classification state descriptions; a model state points to the state it approximates with &apos;model state represents&apos;.</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">Tunnel states, which count time spent since an event, are model states: record them as model states that represent a clinical state (model state represents), not as states of a classification used for observation.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Briggs et al. 2006</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">model state</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000035 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000035">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that is a collection of patient-level or aggregate data from which an economic evaluation estimate is calculated, such as a trial dataset or an extract of routine data.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Used when an estimate comes from an analysis of data rather than from a published document.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">evidence dataset</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000040 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000040">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <obo:IAO_0000112 xml:lang="en">The payer role of a commissioner, realised when it pays a hospital trust for an emergency admission.</obo:IAO_0000112>
        <obo:IAO_0000115 xml:lang="en">A role borne by an organization, a household or a person that is realised in paying for health care, social care or health insurance.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">payer role</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000041 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000041">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <obo:IAO_0000115 xml:lang="en">A role borne by a person that is realised in providing unpaid care to someone because of illness, disability or age.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">informal carer role</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000042 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000042">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000029"/>
        <obo:IAO_0000115 xml:lang="en">A site in which health or social care is delivered or received, such as a hospital ward, an emergency department, a general practice or a person&apos;s home.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Decision (0.3.0): a care setting stays a RHEO site (BFO site), not the OMRSE health care facility (OMRSE_00000102). A setting is the place where care is delivered, which includes a person&apos;s home and a remote consultation, and many settings lie within one facility (a ward and an emergency department in one hospital). A facility is a material entity; a setting is the site it, or a home, provides. Where a record needs the building or estate, reuse OMRSE health care facility and relate the setting to it with RO located in, rather than define a RHEO duplicate.</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">Patient movements and flows run from one care setting to another.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">care setting</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000043 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000043">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000027"/>
        <obo:IAO_0000115 xml:lang="en">An object aggregate of objects of one kind that are available to bear a health care resource role at a time, such as the beds of a ward or the vaccine doses held by a programme.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">A stock is measured at a point in time; flows are measured over a period.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">resource stock</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000044 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000044">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <obo:IAO_0000115 xml:lang="en">A material entity, such as a pack of tablets or a dose of vaccine, that is or contains a substance intended for the prevention, diagnosis or treatment of disease.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The physical product. The product as a marketed type (what a price agreement or a marketing authorisation is about) is an intervention specification. Candidate for replacement by DRON clinical drug product.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">medicinal product</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000045 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000045">
        <obo:IAO_0000115 xml:lang="en">OBSOLETE. An object, other than a medicinal product, used in the prevention, diagnosis, monitoring or treatment of disease, such as a diagnostic test kit or an infusion pump.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <obo:IAO_0000231 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000228"/>
        <obo:IAO_0100001 rdf:resource="http://purl.obolibrary.org/obo/COB_0001300"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">obsolete medical device</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000046 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000046">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000096"/>
        <obo:IAO_0000115 xml:lang="en">A health care process in which a person is admitted to a hospital bed and cared for until discharge.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">inpatient stay</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000047 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000047">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000096"/>
        <obo:IAO_0000115 xml:lang="en">A health care process in which a person is assessed or treated in an emergency department without, or before, admission.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">emergency department attendance</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000048 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000048">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000097"/>
        <obo:IAO_0000115 xml:lang="en">A health care encounter in which a person is seen by a health professional in an outpatient, primary care or community setting, in person or remotely.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">consultation</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000049 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000049">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000096"/>
        <obo:IAO_0000115 xml:lang="en">A health care process in which a diagnostic test is carried out on a person or a specimen to detect or rule out a condition.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">diagnostic testing process</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000050 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000050">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000096"/>
        <obo:IAO_0000115 xml:lang="en">A health care process in which a medicinal product is supplied to a person or to those caring for them.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">medicine dispensing</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000051 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000051">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0000082"/>
        <obo:IAO_0000115 xml:lang="en">A planned process in which a person is conveyed to, from or between care settings, such as an emergency ambulance journey.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Not placed under OGMS health care process, which requires direct treatment, diagnosis or prevention. A patient transport can have patient movements as parts.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">patient transport</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000052 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000052">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000096"/>
        <obo:IAO_0000115 xml:lang="en">A health care process made up of the health care processes delivered to one person for one health problem between a start and an end, such as an emergency admission from arrival to discharge.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">care episode</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000053 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000053">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000096"/>
        <obo:IAO_0000115 xml:lang="en">A health care process in which a person receives support to change a health-related behaviour, such as a stop smoking session.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">behavioural support session</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000054 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000054">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0000082"/>
        <obo:IAO_0000115 xml:lang="en">A planned process in which support with daily living is provided to a person because of illness, disability or age, such as home care or a care home stay.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">social care process</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000055 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000055">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000115 xml:lang="en">A process in which a person bearing an informal carer role provides unpaid care to another person.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Counted, and valued, only in perspectives that include informal care, such as a societal perspective.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">informal care process</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000056 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000056">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000115 xml:lang="en">A process in which a person carries out work for pay.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Time lost from paid work because of ill health is an absence, not part of work: it is recorded by a work absence record and valued as a productivity loss in a societal perspective.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">paid work process</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000057 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000057">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000115 xml:lang="en">A process, part of a health care, social care or informal care process, in which a material entity bearing a health care resource role is consumed or occupied, or in which a person takes part as staff or carer.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Resource use is a real process. A cost is the information produced when a costing process values recorded resource use: RHEO represents that valuation process and the cost record it produces, and records the perspective and the assumptions of the valuation with them (see costing process and cost record).</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">resource use process</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000058 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000058">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000115 xml:lang="en">A process in which a person moves from one care setting to another, such as arriving at an emergency department from home or being discharged from a ward to home.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">patient movement</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000059 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000059">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0000082"/>
        <obo:IAO_0000115 xml:lang="en">A planned process in which money is transferred from a payer to a payee, such as a reimbursement to a hospital, an insurance premium, a capitation payment or a payment made out of pocket by a household.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">A payment is a flow of money between agents. It is not the cost of care: a tariff payment and the cost of the resources used can differ.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000118 xml:lang="en">payment</obo:IAO_0000118>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">payment process</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000060 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000060">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000115 xml:lang="en">A process in which an infectious agent passes from an infectious host to a susceptible host.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">infection transmission</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000061 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000061">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000115 xml:lang="en">A process of a person&apos;s own conduct that affects their health, such as smoking, drinking alcohol or physical activity.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">health-related behaviour</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000062 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000062">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0000082"/>
        <obo:IAO_0000115 xml:lang="en">A planned process in which a decision-making body considers evidence, including economic evaluations, and decides whether a health technology should be funded and on what terms.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">health technology assessment decision process</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000063 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000063">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000035"/>
        <obo:IAO_0000115 xml:lang="en">A process boundary at which the life of an organism ends.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">death</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000064 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000064">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that describes one of the states into which persons or other entities can be classified at a time, such as stable disease, infected, vaccinated, current smoker, waiting for treatment or a deprivation quintile.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">state description</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000065 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000065">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that is a fixed, identified set of mutually exclusive and jointly exhaustive state descriptions used to classify persons or other entities at a time.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">When a scheme changes (a state is added, split, merged or renamed), a new version is issued, and the revision can be recorded with a classification revision record. A revision changes the description, not the entities described: a difference between states recorded under two versions is not by itself evidence that an entity changed or that a new possibility opened.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">classification scheme version</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000066 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000066">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000109"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000067"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000071"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000074"/>
