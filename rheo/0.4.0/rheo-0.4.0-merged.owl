        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000011"/>
        <obo:IAO_0000115 xml:lang="en">An economic evaluation estimate of the severity of a health state on a scale on which 0 is full health and 1 is equivalent to death, used to calculate years lived with disability.</obo:IAO_0000115>
