        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000026"/>
        <obo:IAO_0000115 xml:lang="en">Relates an incremental cost record to the comparator against which the difference is taken.</obo:IAO_0000115>
