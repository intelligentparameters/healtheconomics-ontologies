    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_3000001 -->

    <rdfs:Datatype rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_3000001">
        <obo:IAO_0000115 xml:lang="en">A date written as an ISO 8601 calendar date, YYYY-MM-DD, as a plain string. The record rules also check that the date exists in the calendar.</obo:IAO_0000115>
        <obo:IAO_0000119>ISO 8601</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">ISO 8601 calendar date</rdfs:label>
        <owl:equivalentClass>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:pattern>[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])</xsd:pattern>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </owl:equivalentClass>
    </rdfs:Datatype>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_3000002 -->

    <rdfs:Datatype rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_3000002">
        <obo:IAO_0000115 xml:lang="en">A duration written in the ISO 8601 form PnYnMnWnDTnHnMnS, such as P1Y or P28D, as a plain string.</obo:IAO_0000115>
        <obo:IAO_0000119>ISO 8601</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">ISO 8601 duration</rdfs:label>
        <owl:equivalentClass>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:pattern>P([0-9]+Y)?([0-9]+M)?([0-9]+W)?([0-9]+D)?(T([0-9]+H)?([0-9]+M)?([0-9]+S)?)?</xsd:pattern>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </owl:equivalentClass>
    </rdfs:Datatype>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_3000003 -->

    <rdfs:Datatype rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_3000003">
        <obo:IAO_0000115 xml:lang="en">A price year (2024) or a financial year (2023/24), as a plain string.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">price year</rdfs:label>
        <owl:equivalentClass>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:pattern>[0-9]{4}(/[0-9]{2})?</xsd:pattern>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </owl:equivalentClass>
    </rdfs:Datatype>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_3000004 -->

    <rdfs:Datatype rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_3000004">
        <obo:IAO_0000115 xml:lang="en">A time horizon written as an ISO 8601 duration, such as P40Y, or the word lifetime, as a plain string.</obo:IAO_0000115>
        <obo:IAO_0000119>ISO 8601</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">time horizon</rdfs:label>
        <owl:equivalentClass>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:pattern>(P([0-9]+Y)?([0-9]+M)?([0-9]+W)?([0-9]+D)?|[Ll]ifetime)</xsd:pattern>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </owl:equivalentClass>
    </rdfs:Datatype>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_3000005 -->

    <rdfs:Datatype rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_3000005">
        <obo:IAO_0000115 xml:lang="en">A calendar year, such as 2025, as a plain string.</obo:IAO_0000115>
        <obo:IAO_0000119>ISO 8601</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">calendar year</rdfs:label>
        <owl:equivalentClass>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:pattern>[0-9]{4}</xsd:pattern>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </owl:equivalentClass>
    </rdfs:Datatype>
    


