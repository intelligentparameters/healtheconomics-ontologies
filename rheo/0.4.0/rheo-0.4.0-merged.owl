        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000114"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000122"/>
        <obo:IAO_0000115 xml:lang="en">Relates a case-mix group assignment to the case-mix group (a kind of care process) assigned.</obo:IAO_0000115>
