        <rdfs:label xml:lang="en">references area</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_1000090 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000090">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000034"/>
