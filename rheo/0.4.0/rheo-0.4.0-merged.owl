    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_1000095 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000095">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000130"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000066"/>
        <obo:IAO_0000115 xml:lang="en">Relates a knowledge change record to the state observation whose difference from the earlier observation reflects a change in knowledge, not in the entity.</obo:IAO_0000115>
