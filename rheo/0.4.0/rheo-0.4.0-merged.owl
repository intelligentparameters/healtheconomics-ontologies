        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000078"/>
        <obo:IAO_0000115 xml:lang="en">Relates a payment record to the price agreement, such as an outcomes-based agreement, under which the recorded payment was made.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
