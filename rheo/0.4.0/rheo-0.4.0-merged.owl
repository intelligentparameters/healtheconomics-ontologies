        <obo:IAO_0000115 xml:lang="en">An economic evaluation estimate of how well a diagnostic test classifies people, such as its sensitivity or specificity, in a stated population against a stated reference standard.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
