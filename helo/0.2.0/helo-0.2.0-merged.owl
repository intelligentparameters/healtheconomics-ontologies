        <rdfs:label xml:lang="en">has next learning step</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_1000004 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_1000004">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000002"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000002"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">Relates a learning step to the learning step that comes straight before it in the same learning pathway.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>Ashley M. How the knowledge map works, notes for the site developer, 12 October 2026</ns1:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">has previous learning step</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_1000005 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_1000005">
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000003"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">Relates a learning step or a course module to a learning topic it is about.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>Ashley M. How the knowledge map works, notes for the site developer, 12 October 2026</ns1:IAO_0000119>
