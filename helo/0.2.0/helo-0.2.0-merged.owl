        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/mcda-in-hta"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/multi-criteria-decision-analysis"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/real-option-value"/>
        <helo1:HELO_1000012 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5000038"/>
        <helo1:HELO_2000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</helo1:HELO_2000001>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">HTA processes and methods in Deciding What to Fund</rdfs:label>
        <helo1:HELO_9000004 xml:lang="en">How an HTA body reviews the evidence on a technology, and how a committee weighs that evidence against its decision criteria to reach a funding recommendation.</helo1:HELO_9000004>
        <helo1:HELO_9000005 xml:lang="en">The pathway starts with how a technology is assessed and appraised, because every later funding and access decision rests on that recommendation.</helo1:HELO_9000005>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_6000016 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_6000016">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000002"/>
        <helo1:HELO_1000002 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5000004"/>
        <helo1:HELO_1000004 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_6000015"/>
        <helo1:HELO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5100016"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/formulary"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/managed-entry-agreement"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/amcp-dossier"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/appeals-design"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/prior-authorization"/>
        <helo1:HELO_1000012 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5000039"/>
        <helo1:HELO_2000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</helo1:HELO_2000001>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">Reimbursement and managed access in Deciding What to Fund</rdfs:label>
        <helo1:HELO_9000004 xml:lang="en">How payers put a technology on a formulary and control its use, and how managed entry agreements let a technology be funded while doubts about its value or cost remain.</helo1:HELO_9000004>
        <helo1:HELO_9000005 xml:lang="en">Once an HTA body has made its recommendation, payers still have to set the terms on which patients get the technology, so access arrangements come next.</helo1:HELO_9000005>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_6000017 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_6000017">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000002"/>
        <helo1:HELO_1000002 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5000005"/>
        <helo1:HELO_1000003 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_6000018"/>
        <helo1:HELO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5100017"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/assumption-structure"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/deterministic-model"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/health-economic-model"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/continuous-model"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/discrete-model"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/equilibrium"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/time-dependency"/>
        <helo1:HELO_1000012 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5000040"/>
        <helo1:HELO_2000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</helo1:HELO_2000001>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">Model types and structures (general) in Building the Model</rdfs:label>
        <helo1:HELO_9000004 xml:lang="en">What a health economic model is, and the main ways a model can be built to represent a disease and its treatment.</helo1:HELO_9000004>
        <helo1:HELO_9000005 xml:lang="en">Every model in the later steps is one of these types, so the pathway starts with what a model is and the choices that shape its structure.</helo1:HELO_9000005>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_6000018 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_6000018">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000002"/>
        <helo1:HELO_1000002 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5000005"/>
