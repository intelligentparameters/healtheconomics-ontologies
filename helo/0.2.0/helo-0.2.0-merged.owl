        <helo1:HELO_1000027 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000010"/>
        <helo1:HELO_1000028 rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <helo1:HELO_2000002 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</helo1:HELO_2000002>
        <dcterms:identifier>costs</dcterms:identifier>
        <dcterms:source>https://healtheconomics.wiki/api/pathways, read-only GET on 2026-10-19</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">Counting the Cost</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/knowledge-map/costs"/>
        <helo1:HELO_9000002 xml:lang="en">How to get the cost of care by measuring the resources used and valuing them</helo1:HELO_9000002>
        <helo1:HELO_9000003 xml:lang="en">Learn how to identify the resources used in care, measure their use and assign monetary values.</helo1:HELO_9000003>
