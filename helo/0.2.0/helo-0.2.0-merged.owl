        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">Discounting in Judging Value for Money</rdfs:label>
        <helo1:HELO_9000004 xml:lang="en">Why costs and health effects that arrive later count for less today, and by how much.</helo1:HELO_9000004>
        <helo1:HELO_9000005 xml:lang="en">Most evaluations run over several years, so future costs and health need converting to present values before options are compared.</helo1:HELO_9000005>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_6000010 -->

