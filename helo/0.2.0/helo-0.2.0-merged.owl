        <rdfs:label xml:lang="en">draft</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_4000020 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_4000020">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000014"/>
