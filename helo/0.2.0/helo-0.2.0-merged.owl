        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">proposed from an unreviewed HEO relationship</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_4000030 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_4000030">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000010"/>
        <owl:differentFrom rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000031"/>
        <owl:differentFrom rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000032"/>
        <owl:differentFrom rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000033"/>
        <owl:differentFrom rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000034"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">A prerequisite derivation rule by which a HEO prerequisite for relationship from one concept to another gives the proposal that the first concept is understood before the second.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">HEO defines prerequisite for as a learning dependency and marks it for learning.</ns1:IAO_0000116>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>HELO 0.2.0 design (best practice), Michelle Ashley with Claude, 19 October 2026; HEO 2.0.0</ns1:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">prerequisite from HEO prerequisite for</rdfs:label>
        <helo1:HELO_9000014 rdf:resource="https://healtheconomics.wiki/ontologies/heo#prerequisiteFor"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000030"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_9000014"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/ontologies/heo#prerequisiteFor"/>
        <rdfs:comment xml:lang="en">The rule reads the HEO relationship type Prerequisite for and records a proposed order of learning, so it represents HEO relationships and does not change them. HEO defines prerequisite for as a learning dependency and marks it for learning.</rdfs:comment>
        <ns2:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000002"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_4000031 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_4000031">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000010"/>
        <owl:differentFrom rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000032"/>
        <owl:differentFrom rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000033"/>
        <owl:differentFrom rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000034"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">A prerequisite derivation rule by which a HEO is foundation for relationship from one concept to another gives the proposal that the first concept is understood before the second.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">HEO defines is foundation for as a basic idea on which another is built and marks it for learning.</ns1:IAO_0000116>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>HELO 0.2.0 design (best practice), Michelle Ashley with Claude, 19 October 2026; HEO 2.0.0</ns1:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">prerequisite from HEO is foundation for</rdfs:label>
        <helo1:HELO_9000014 rdf:resource="https://healtheconomics.wiki/ontologies/heo#isFoundationFor"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000031"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_9000014"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/ontologies/heo#isFoundationFor"/>
        <rdfs:comment xml:lang="en">The rule reads the HEO relationship type Is foundation for and records a proposed order of learning, so it represents HEO relationships and does not change them. HEO defines is foundation for as a basic idea on which another is built and marks it for learning.</rdfs:comment>
        <ns2:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000002"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_4000032 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_4000032">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000010"/>
        <owl:differentFrom rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000033"/>
        <owl:differentFrom rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000034"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">A prerequisite derivation rule by which a HEO depends on relationship from one concept to another gives the proposal that the second concept is understood before the first.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">HEO marks depends on for learning. It holds one relationship in HEO 2.0.0.</ns1:IAO_0000116>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>HELO 0.2.0 design (best practice), Michelle Ashley with Claude, 19 October 2026; HEO 2.0.0</ns1:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">prerequisite from HEO depends on</rdfs:label>
        <helo1:HELO_9000014 rdf:resource="https://healtheconomics.wiki/ontologies/heo#dependsOn"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000032"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_9000014"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/ontologies/heo#dependsOn"/>
        <rdfs:comment xml:lang="en">The rule reads the HEO relationship type Depends on and records a proposed order of learning, so it represents HEO relationships and does not change them. HEO marks depends on for learning. It holds one relationship in HEO 2.0.0.</rdfs:comment>
        <ns2:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000002"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_4000033 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_4000033">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000010"/>
        <owl:differentFrom rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000034"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">A prerequisite derivation rule by which a HEO assumes relationship from a method or model to an assumption gives the proposal that the assumption is understood no later than the method or model, so that the two may be taught in one step.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">HEO marks assumes for learning. Assumptions are usually taught with their method, so a pair in one step agrees with the pathway and only an assumption taught later conflicts (curator decision, 19 October 2026, after review B S2).</ns1:IAO_0000116>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>HELO 0.2.0 design (best practice), Michelle Ashley with Claude, 19 October 2026; HEO 2.0.0</ns1:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">prerequisite from HEO assumes</rdfs:label>
        <helo1:HELO_9000014 rdf:resource="https://healtheconomics.wiki/ontologies/heo#assumes"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000033"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_9000014"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/ontologies/heo#assumes"/>
        <rdfs:comment xml:lang="en">The rule reads the HEO relationship type Assumes and records a proposed order of learning, so it represents HEO relationships and does not change them. HEO marks assumes for learning. Assumptions are usually taught with their method, so a pair in one step agrees with the pathway and only an assumption taught later conflicts (curator decision, 19 October 2026, after review B S2).</rdfs:comment>
        <ns2:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000002"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_4000034 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_4000034">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000010"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">A prerequisite derivation rule by which a HEO used to calculate relationship from an input to a result gives the weaker proposal that the input is understood before the result, only where the input is part of what the result means, read as the HEO definition of the result naming the input.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">HEO marks used to calculate for formal inference and navigation, not for learning, so HELO keeps these proposals as a separate weaker tier (curator decision, 19 October 2026). An input that is only one way of computing the result, such as cumulative hazard for a transition probability, gives no proposal (review B S1).</ns1:IAO_0000116>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>HELO 0.2.0 design (best practice), Michelle Ashley with Claude, 19 October 2026; HEO 2.0.0</ns1:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">prerequisite from HEO used to calculate</rdfs:label>
        <helo1:HELO_9000014 rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000034"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_9000014"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <rdfs:comment xml:lang="en">The rule reads the HEO relationship type Used to calculate and records a proposed order of learning, so it represents HEO relationships and does not change them. HEO marks used to calculate for formal inference and navigation, not for learning, so HELO keeps these proposals as a separate weaker tier (curator decision, 19 October 2026). An input that is only one way of computing the result, such as cumulative hazard for a transition probability, gives no proposal (review B S1).</rdfs:comment>
        <ns2:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000002"/>
    </owl:Axiom>
    


