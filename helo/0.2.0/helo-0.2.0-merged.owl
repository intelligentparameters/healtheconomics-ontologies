        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/time-varying-hazard"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/unimodal-hazard"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/weibull-distribution"/>
