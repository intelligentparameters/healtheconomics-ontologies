        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/net-present-value"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/break-even-analysis"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/break-even-point"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/internal-rate-of-return"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/payback-period"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/return-on-investment"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/shadow-price"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/social-return-on-investment"/>
        <helo1:HELO_1000012 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5000036"/>
        <helo1:HELO_2000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</helo1:HELO_2000001>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">Cost-benefit analysis and investment appraisal in Judging Value for Money</rdfs:label>
        <helo1:HELO_9000004 xml:lang="en">Valuing health gains in money, so an option can be judged on whether its benefits exceed its costs.</helo1:HELO_9000004>
        <helo1:HELO_9000005 xml:lang="en">Some decisions reach beyond health care, and valuing every outcome in money puts them on one scale.</helo1:HELO_9000005>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_6000013 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_6000013">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000002"/>
