        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/individual-patient-simulation"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/microsimulation"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/monte-carlo-simulation"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/time-to-event"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/agent-based-model"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/arrival-process"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/departure-process"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/event-queue"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/markov-microsimulation"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/pseudo-random-number"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/queuing-model"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/random-number-generation"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/stochastic-simulation"/>
        <helo1:HELO_1000012 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5000046"/>
        <helo1:HELO_2000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</helo1:HELO_2000001>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">Discrete event and individual-level simulation in Building the Model</rdfs:label>
        <helo1:HELO_9000004 xml:lang="en">Models that follow simulated patients one at a time, so each person&apos;s history and the timing of events can shape what happens next.</helo1:HELO_9000004>
        <helo1:HELO_9000005 xml:lang="en">Some questions need each patient&apos;s past to matter, which cohort models capture poorly, so individual-level methods come once cohort models are familiar.</helo1:HELO_9000005>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_6000024 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_6000024">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000002"/>
        <helo1:HELO_1000002 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5000005"/>
        <helo1:HELO_1000003 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_6000025"/>
        <helo1:HELO_1000004 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_6000023"/>
        <helo1:HELO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5100024"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/compartmental-model"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/dynamic-transmission-model"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/sir-model"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/dynamic-model"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/seir-model"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/stock-and-flow-model"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/system-dynamics-model"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/transmission-model"/>
        <helo1:HELO_1000012 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5000047"/>
        <helo1:HELO_2000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</helo1:HELO_2000001>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">Dynamic transmission and system dynamics models in Building the Model</rdfs:label>
        <helo1:HELO_9000004 xml:lang="en">Models where the number of people infected changes the risk for everyone else, as with infectious disease and vaccination.</helo1:HELO_9000004>
        <helo1:HELO_9000005 xml:lang="en">For infectious disease, treating one person changes the risk for others, which needs a model where the population feeds back on itself.</helo1:HELO_9000005>
    </owl:NamedIndividual>
    


