    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_4000001 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_4000001">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000107"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">A kind of cross-ontology relationship in which one term defines or classifies another, such as a subclass bridge axiom or a mapping from a HEO concept to the HEAO class it explains.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>Ashley M. HEAO 0.2.0 locked decisions (best practice), 18 October 2026</ns1:IAO_0000119>
        <ns1:IAO_0000412 rdf:resource="https://healtheconomics.wiki/ontologies/heao/0.2.0/heao.owl"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">definitional relationship</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_4000002 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_4000002">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000107"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">A kind of cross-ontology relationship in which one entity records, represents or describes another, such as a valuation context recording a jurisdiction or a provenance record describing who adopted a weight.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>Ashley M. HEAO 0.2.0 locked decisions (best practice), 18 October 2026</ns1:IAO_0000119>
        <ns1:IAO_0000412 rdf:resource="https://healtheconomics.wiki/ontologies/heao/0.2.0/heao.owl"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">representational relationship</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_4000003 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_4000003">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000107"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">A kind of cross-ontology relationship in which one value is calculated from another by a formula, such as a discount factor from a discount rate, to be formalised in HEMO.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>Ashley M. HEAO 0.2.0 locked decisions (best practice), 18 October 2026</ns1:IAO_0000119>
        <ns1:IAO_0000412 rdf:resource="https://healtheconomics.wiki/ontologies/heao/0.2.0/heao.owl"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">computational relationship</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_4000004 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_4000004">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000107"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">A kind of cross-ontology relationship in which one thing brings about another in reality, such as spending on a constrained budget displacing health elsewhere. It holds between real processes or the things taking part in them, not between records.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>Ashley M. HEAO 0.2.0 locked decisions (best practice), 18 October 2026</ns1:IAO_0000119>
        <ns1:IAO_0000412 rdf:resource="https://healtheconomics.wiki/ontologies/heao/0.2.0/heao.owl"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">causal relationship</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_4000005 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_4000005">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000107"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">A kind of cross-ontology relationship in which a value is assigned to something, such as a valuation applying a weight to a quantity.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>Ashley M. HEAO 0.2.0 locked decisions (best practice), 18 October 2026</ns1:IAO_0000119>
        <ns1:IAO_0000412 rdf:resource="https://healtheconomics.wiki/ontologies/heao/0.2.0/heao.owl"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">valuational relationship</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_4000001 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_4000001">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000005"/>
        <owl:differentFrom rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000002"/>
        <owl:differentFrom rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000003"/>
        <owl:differentFrom rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000004"/>
        <owl:differentFrom rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000005"/>
        <owl:differentFrom rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000006"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">An intended learner profile of a person studying health economics or a related subject, who may not yet have done the work in practice.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>The Semantic Layer for Health Economics, course outline draft for Michelle Ashley and Darrin Baines, 18 October 2026</ns1:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">student</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_4000002 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_4000002">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000005"/>
        <owl:differentFrom rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000003"/>
        <owl:differentFrom rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000004"/>
        <owl:differentFrom rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000005"/>
        <owl:differentFrom rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000006"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">An intended learner profile of a person who works in health economics, in research, in practice or in government.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>The Semantic Layer for Health Economics, course outline draft for Michelle Ashley and Darrin Baines, 18 October 2026</ns1:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">health economist</rdfs:label>
        <helo1:HELO_9000008 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000040"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000002"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_9000008"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000040"/>
        <rdfs:comment xml:lang="en">The HELO profile health economist describes people who bear this HETO role. HELO defines health economist as &quot;An intended learner profile of a person who works in health economics, in research, in practice or in government.&quot; and HETO defines health economics practitioner role as &quot;A role borne by a person that is realised when that person carries out health economics work, such as framing, costing, modelling, analysing or reporting an economic evaluation.&quot;. The profile is information about an audience and the role is borne by people, so the profile describes the role&apos;s bearers, a representational relationship.</rdfs:comment>
        <ns2:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000002"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_4000003 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_4000003">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000005"/>
        <owl:differentFrom rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000004"/>
        <owl:differentFrom rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000005"/>
        <owl:differentFrom rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000006"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">An intended learner profile of a person who prepares or reviews evidence, including economic evidence, for a health technology assessment body.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000118 xml:lang="en">HTA analyst</ns1:IAO_0000118>
        <ns1:IAO_0000119>The Semantic Layer for Health Economics, course outline draft for Michelle Ashley and Darrin Baines, 18 October 2026</ns1:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">health technology assessment analyst</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_4000004 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_4000004">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000005"/>
        <owl:differentFrom rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000005"/>
        <owl:differentFrom rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000006"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">An intended learner profile of a person who measures or values the health outcomes of care, such as survival and quality of life, for research or for appraisal.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>The Semantic Layer for Health Economics, course outline draft for Michelle Ashley and Darrin Baines, 18 October 2026</ns1:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">outcomes researcher</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_4000005 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_4000005">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000005"/>
        <owl:differentFrom rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000006"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">An intended learner profile of a person who designs, builds, runs or checks economic models.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000118 xml:lang="en">modeller</ns1:IAO_0000118>
        <ns1:IAO_0000119>Baines D. Scope of the learning pathways ontology, 18 October 2026, passed on by Michelle Ashley in the HELO 0.2.0 brief; HETO 0.3.0</ns1:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">economic modeller</rdfs:label>
        <helo1:HELO_9000008 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000041"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000005"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_9000008"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000041"/>
        <rdfs:comment xml:lang="en">The HELO profile economic modeller describes people who bear this HETO role. HELO defines economic modeller as &quot;An intended learner profile of a person who designs, builds, runs or checks economic models.&quot; and HETO defines economic modeller role as &quot;A health economics practitioner role that is realised when its bearer designs, builds, runs or checks an economic model.&quot;. The profile is information about an audience and the role is borne by people, so the profile describes the role&apos;s bearers, a representational relationship.</rdfs:comment>
        <ns2:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000002"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_4000006 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_4000006">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000005"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">An intended learner profile of a person who takes or advises on decisions about health policy, funding or access, and who uses health economic evidence rather than producing it.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">No pathway or curriculum is stated to be for policy makers yet. Open question for Darrin Baines.</ns1:IAO_0000116>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>Baines D. Scope of the learning pathways ontology, 18 October 2026, passed on by Michelle Ashley in the HELO 0.2.0 brief</ns1:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">policy maker</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_4000010 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_4000010">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000013"/>
        <owl:differentFrom rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000011"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">A publication status of a learning pathway, curriculum or course module that is shown on the site.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>Ashley M. How the knowledge map works, notes for the site developer, 12 October 2026</ns1:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">published</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_4000011 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_4000011">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000013"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">A publication status of a learning pathway, curriculum or course module that is still being written and is not shown on the site.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>Ashley M. How the knowledge map works, notes for the site developer, 12 October 2026</ns1:IAO_0000119>
