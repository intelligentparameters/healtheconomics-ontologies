        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/full-economic-evaluation"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/intervention"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/partial-economic-evaluation"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/perspective"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/population"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/time-horizon"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/adaptation"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/cost-consequence-analysis"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/cost-minimisation-analysis"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/societal-perspective"/>
        <helo1:HELO_1000012 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5000032"/>
        <helo1:HELO_2000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</helo1:HELO_2000001>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">Evaluation types and frameworks in Judging Value for Money</rdfs:label>
        <helo1:HELO_9000004 xml:lang="en">What an economic evaluation compares, for whom, and over what period.</helo1:HELO_9000004>
        <helo1:HELO_9000005 xml:lang="en">Every later method assumes a clearly framed question, so the pathway starts with what is compared and whose costs count.</helo1:HELO_9000005>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_6000009 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_6000009">
