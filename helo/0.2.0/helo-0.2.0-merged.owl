    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_9000004 -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_9000004">
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">The one-sentence summary of what a learning step covers, as the site shows it, kept word for word.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>Ashley M. How the knowledge map works, notes for the site developer, 12 October 2026</ns1:IAO_0000119>
