    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_9000006 -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_9000006">
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">Relates a learning pathway to a HETO task specification that the HELO build proposes the pathway prepares for, not yet reviewed. The basis, the share and the counts of the task&apos;s HEO concepts that the pathway covers are recorded on the axiom.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>HELO 0.2.0 design (best practice), Michelle Ashley with Claude, 19 October 2026; HETO 0.3.0</ns1:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">proposed to prepare for task</rdfs:label>
        <ns2:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000002"/>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_9000007 -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_9000007">
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">Relates a learning pathway to an intended learner profile that the HELO build proposes it is for, not yet reviewed, with the basis recorded on the axiom.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>HELO 0.2.0 design (best practice), Michelle Ashley with Claude, 19 October 2026</ns1:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">proposed intended learner</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_9000008 -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_9000008">
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">Relates an intended learner profile to the HETO practitioner role class whose bearers the profile describes.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>HELO 0.2.0 design (best practice), Michelle Ashley with Claude, 19 October 2026; HETO 0.3.0</ns1:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">has corresponding HETO role</rdfs:label>
        <ns2:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000002"/>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_9000009 -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_9000009">
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">On a proposed to prepare for task axiom, the share of the HEO concepts that HETO relates to the task which are core concepts of the pathway, between 0 and 1.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>HELO 0.2.0 design (best practice), Michelle Ashley with Claude, 19 October 2026</ns1:IAO_0000119>
