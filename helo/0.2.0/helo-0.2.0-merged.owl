    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_9000012 -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_9000012">
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
