    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_9000011 -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_9000011">
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">The interactive piece of a course module as its course outline describes it, kept word for word.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>The Semantic Layer for Health Economics, course outline draft for Michelle Ashley and Darrin Baines, 18 October 2026</ns1:IAO_0000119>
