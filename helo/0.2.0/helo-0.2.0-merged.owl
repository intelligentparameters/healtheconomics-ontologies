        <rdfs:label xml:lang="en">Health utility and preference elicitation in Measuring Health Gain</rdfs:label>
        <helo1:HELO_9000004 xml:lang="en">How a health state gets a number on a scale from dead to full health, either asked of people directly or read from a value set.</helo1:HELO_9000004>
        <helo1:HELO_9000005 xml:lang="en">QALYs need a quality weight for each health state, so the outcomes measured in the first step are now turned into utilities.</helo1:HELO_9000005>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_6000006 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_6000006">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000002"/>
        <helo1:HELO_1000002 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5000002"/>
