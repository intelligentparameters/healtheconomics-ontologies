        <rdfs:label xml:lang="en">Follow the Money</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems"/>
        <helo1:HELO_9000002 xml:lang="en">How to get a clear view of a health system by tracing where its money comes from and what it buys</helo1:HELO_9000002>
        <helo1:HELO_9000003 xml:lang="en">The pathway follows the money in a health system, starting with how the system is organised and how it raises and pools funds for care. Later steps cover how providers are paid and manage their finances, and how their performance and quality are measured.</helo1:HELO_9000003>
        <helo1:HELO_9000007 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000001"/>
        <helo1:HELO_9000007 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000002"/>
        <helo1:HELO_9000007 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000006"/>
    </owl:NamedIndividual>
