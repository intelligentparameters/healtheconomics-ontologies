        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">has learning topic</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_1000006 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_1000006">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000002"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">Relates a learning step to a HEO concept that a learner is to understand at that step, a must-learn concept of its pathway framework.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>Ashley M. How the knowledge map works, notes for the site developer, 12 October 2026</ns1:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">has core concept</rdfs:label>
        <ns2:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000002"/>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_1000007 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_1000007">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000002"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">Relates a learning step to a HEO concept that goes further than the core of that step and that a learner may choose to study.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>Ashley M. How the knowledge map works, notes for the site developer, 12 October 2026</ns1:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">has optional concept</rdfs:label>
        <ns2:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000002"/>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_1000008 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_1000008">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000001"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">Relates a learning pathway to a HEO concept from another part of the Knowledge Tree that the pathway builds on, so that it is best understood before the pathway is started.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>Ashley M. How the knowledge map works, notes for the site developer, 12 October 2026</ns1:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">builds on concept</rdfs:label>
        <ns2:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000002"/>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_1000009 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_1000009">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000001"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">Relates a learning pathway to a HEO concept that takes the pathway&apos;s concepts further, to be explored after the pathway is finished.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>Ashley M. How the knowledge map works, notes for the site developer, 12 October 2026</ns1:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">has onward concept</rdfs:label>
        <ns2:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000002"/>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_1000010 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_1000010">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000001"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000002"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">Relates a learning pathway to a learning step of another learning pathway that it leads into on the Knowledge Map, so that a learner who finishes the first pathway can join the second at that step.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>Ashley M. How the knowledge map works, notes for the site developer, 12 October 2026</ns1:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">leads into step</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_1000011 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_1000011">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000004"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000001"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">Relates a pathway framework to the one learning pathway it lays out.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>Ashley M. How the knowledge map works, notes for the site developer, 12 October 2026</ns1:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">is framework of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_1000012 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_1000012">
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000006"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">Relates a learning pathway, a curriculum or a course module to a learning goal it is intended to reach.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>HELO 0.2.0 design (best practice), Michelle Ashley with Claude, 19 October 2026</ns1:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">has learning goal</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_1000013 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_1000013">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000007"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">Relates a concept understanding goal to a HEO concept or a learning topic that a learner is intended to understand.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>HELO 0.2.0 design (best practice), Michelle Ashley with Claude, 19 October 2026</ns1:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">concerns concept</rdfs:label>
        <ns2:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000002"/>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_1000014 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_1000014">
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000005"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">Relates a learning pathway or a curriculum to an intended learner profile that its own source states it is for.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">Used only where the source of the pathway or curriculum states the learners. Profiles proposed by the HELO build are held in the annotation property proposed intended learner until a curator accepts them.</ns1:IAO_0000116>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>HELO 0.2.0 design (best practice), Michelle Ashley with Claude, 19 October 2026; Christou et al. 2025</ns1:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">is intended for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_1000015 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_1000015">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000001"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">Relates a learning pathway to a HETO task specification whose concepts the pathway builds understanding of, so that a learner is ready to be trained in the task elsewhere. The pathway does not train the learner to carry out the task.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">Not used in HELO 0.2.0. Proposed relationships are held in the annotation property proposed to prepare for task, with their basis, until a curator accepts them. No HELO property says that a pathway trains a task, and none should be added.</ns1:IAO_0000116>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>Baines D. Scope of the learning pathways ontology, 18 October 2026, passed on by Michelle Ashley in the HELO 0.2.0 brief</ns1:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">prepares for task</rdfs:label>
        <ns2:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000002"/>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_1000016 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_1000016">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000009"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">Relates a prerequisite relationship to the HEO concept that is to be understood first.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">Not functional in OWL, so that a faulty record never makes two HEO concepts the same. The SHACL rules allow one value.</ns1:IAO_0000116>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>HELO 0.2.0 design (best practice), Michelle Ashley with Claude, 19 October 2026</ns1:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">has prerequisite concept</rdfs:label>
        <ns2:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000002"/>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_1000017 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_1000017">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000009"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">Relates a prerequisite relationship to the HEO concept that is understood after its prerequisite concept and with its help.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">Not functional in OWL, so that a faulty record never makes two HEO concepts the same. The SHACL rules allow one value.</ns1:IAO_0000116>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>HELO 0.2.0 design (best practice), Michelle Ashley with Claude, 19 October 2026</ns1:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">has dependent concept</rdfs:label>
        <ns2:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000002"/>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_1000018 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_1000018">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000009"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000010"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">Relates a prerequisite relationship to a prerequisite derivation rule by which it was derived.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>HELO 0.2.0 design (best practice), Michelle Ashley with Claude, 19 October 2026</ns1:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">follows derivation rule</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_1000019 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_1000019">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000009"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000014"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">Relates a prerequisite relationship to its prerequisite status.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>HELO 0.2.0 design (best practice), Michelle Ashley with Claude, 19 October 2026</ns1:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">has prerequisite status</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_1000020 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_1000020">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000009"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000001"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">Relates a prerequisite relationship to a learning pathway that places its prerequisite concept in an earlier step than its dependent concept, or among the concepts the pathway builds on.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>HELO 0.2.0 design (best practice), Michelle Ashley with Claude, 19 October 2026</ns1:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">agrees with order of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_1000021 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_1000021">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000009"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000001"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">Relates a prerequisite relationship to a learning pathway that places its prerequisite concept in a later step than its dependent concept, or that builds on the dependent concept while teaching the prerequisite concept in one of its steps.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>HELO 0.2.0 design (best practice), Michelle Ashley with Claude, 19 October 2026</ns1:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">conflicts with order of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_1000022 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_1000022">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000009"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000001"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">Relates a prerequisite relationship to a learning pathway that places both of its concepts in the same learning step.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>HELO 0.2.0 design (best practice), Michelle Ashley with Claude, 19 October 2026</ns1:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">is within one step of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_1000023 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_1000023">
        <owl:inverseOf rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_1000024"/>
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000011"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000012"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">Relates a curriculum to one of its course modules.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>Christou et al. 2025</ns1:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">has course module</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_1000024 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_1000024">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000012"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000011"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">Relates a course module to the one curriculum it is part of.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>Christou et al. 2025</ns1:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">is course module of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_1000025 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_1000025">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000012"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000012"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">Relates a course module to the course module that comes straight after it in the same curriculum.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>Christou et al. 2025</ns1:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">has next course module</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_1000026 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_1000026">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000012"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">Relates a course module to a HEO concept that its material uses.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>The Semantic Layer for Health Economics, course outline draft for Michelle Ashley and Darrin Baines, 18 October 2026</ns1:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">uses concept</rdfs:label>
        <ns2:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000002"/>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_1000027 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_1000027">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000013"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">Relates a learning pathway, a curriculum or a course module to its publication status.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>Ashley M. How the knowledge map works, notes for the site developer, 12 October 2026</ns1:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">has publication status</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_1000028 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_1000028">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000001"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">Relates a learning pathway to the HEO concept naming the subdomain of the Knowledge Tree whose topics the pathway follows.</ns1:IAO_0000115>
        <ns1:IAO_0000116 xml:lang="en">Not functional in OWL, so that a faulty record never makes two HEO concepts the same. The SHACL rules allow one subdomain.</ns1:IAO_0000116>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>Ashley M. How the knowledge map works, notes for the site developer, 12 October 2026</ns1:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">covers subdomain</rdfs:label>
        <ns2:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000002"/>
    </owl:ObjectProperty>
    


