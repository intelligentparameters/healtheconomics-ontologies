        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/discounting-costs"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/discounting-health"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/present-value"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/time-preference"/>
