    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_4000022 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_4000022">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000014"/>
        <owl:differentFrom rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000023"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">A prerequisite status of a prerequisite relationship that a named curator has reviewed and rejected, on a recorded date.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>HELO 0.2.0 design (best practice), Michelle Ashley with Claude, 19 October 2026</ns1:IAO_0000119>
