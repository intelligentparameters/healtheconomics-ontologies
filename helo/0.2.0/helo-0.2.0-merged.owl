        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/healthy-year-equivalent"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/quality-adjusted-time-without-symptoms"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/time-without-symptoms-of-progression"/>
        <helo1:HELO_1000012 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5000030"/>
        <helo1:HELO_2000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</helo1:HELO_2000001>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">QALYs, DALYs and summary measures in Measuring Health Gain</rdfs:label>
        <helo1:HELO_9000004 xml:lang="en">Combining length of life with its quality in one number, counted as QALYs gained or DALYs averted.</helo1:HELO_9000004>
        <helo1:HELO_9000005 xml:lang="en">With a utility for each health state, time spent in each state can now be weighted and added up into one measure of health.</helo1:HELO_9000005>
    </owl:NamedIndividual>
    


