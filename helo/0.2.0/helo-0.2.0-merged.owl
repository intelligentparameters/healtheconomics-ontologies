        <helo1:HELO_1000004 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_6000010"/>
        <helo1:HELO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5100011"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/cost-per-qaly"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/cost-utility-analysis"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/incremental-cost-utility-ratio"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/absolute-shortfall"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/proportional-shortfall"/>
        <helo1:HELO_1000012 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5000035"/>
        <helo1:HELO_2000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</helo1:HELO_2000001>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">Cost-utility analysis in Judging Value for Money</rdfs:label>
        <helo1:HELO_9000004 xml:lang="en">Cost-effectiveness with health measured in QALYs, the form most health technology assessment bodies ask for.</helo1:HELO_9000004>
        <helo1:HELO_9000005 xml:lang="en">Cost-utility analysis is cost-effectiveness analysis with QALYs as the outcome, so cost-utility analysis builds directly on the step before.</helo1:HELO_9000005>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_6000012 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_6000012">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000002"/>
