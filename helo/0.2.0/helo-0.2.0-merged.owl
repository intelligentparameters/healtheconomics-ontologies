        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/budget-impact-model"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/net-budget-impact"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/adoption-curve"/>
