        <helo1:HELO_2000002 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</helo1:HELO_2000002>
        <dcterms:identifier>economic-modelling</dcterms:identifier>
        <dcterms:source>https://healtheconomics.wiki/api/pathways, read-only GET on 2026-10-19</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">Building the Model</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling"/>
        <helo1:HELO_9000002 xml:lang="en">How to get a decision model by combining the evidence on costs and outcomes</helo1:HELO_9000002>
        <helo1:HELO_9000003 xml:lang="en">This pathway shows how a health economic model is built, filled with evidence and tested. It ends with how sure a decision maker can be of the answer and whether more research is worth paying for.</helo1:HELO_9000003>
        <helo1:HELO_9000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000005"/>
        <helo1:HELO_9000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000006"/>
