        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/marginal-cost-of-healthcare"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/operating-cost"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/standard-costing"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/step-down-allocation"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/time-driven-activity-based-costing"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/time-value-of-money"/>
        <helo1:HELO_1000012 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5000025"/>
        <helo1:HELO_2000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</helo1:HELO_2000001>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">Costing methods in Counting the Cost</rdfs:label>
        <helo1:HELO_9000004 xml:lang="en">How to count what a treatment uses and give each resource a money value, whether that is one item or a whole budget.</helo1:HELO_9000004>
        <helo1:HELO_9000005 xml:lang="en">Every economic evaluation rests on its cost inputs, so the pathway starts with how resource use is measured and valued.</helo1:HELO_9000005>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_6000002 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_6000002">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000002"/>
        <helo1:HELO_1000002 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5000001"/>
        <helo1:HELO_1000003 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_6000003"/>
        <helo1:HELO_1000004 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_6000001"/>
        <helo1:HELO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5100002"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/absenteeism"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/friction-cost-method"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/human-capital-approach"/>
        <helo1:HELO_1000012 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5000026"/>
        <helo1:HELO_2000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</helo1:HELO_2000001>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">Productivity and indirect costs in Counting the Cost</rdfs:label>
        <helo1:HELO_9000004 xml:lang="en">How the time people lose from paid work through illness is valued, and why two accepted methods give different answers.</helo1:HELO_9000004>
        <helo1:HELO_9000005 xml:lang="en">With health care costs in place, a wider perspective adds the paid work that patients lose, which needs its own valuation methods.</helo1:HELO_9000005>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_6000003 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_6000003">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000002"/>
        <helo1:HELO_1000002 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5000001"/>
        <helo1:HELO_1000004 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_6000002"/>
        <helo1:HELO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5100003"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/attributable-cost-estimation"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/cost-of-illness-study"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/amr-economic-burden"/>
        <helo1:HELO_1000012 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5000027"/>
        <helo1:HELO_2000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</helo1:HELO_2000001>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">Cost of illness in Counting the Cost</rdfs:label>
        <helo1:HELO_9000004 xml:lang="en">How much a disease costs a population each year, and what that figure can and cannot tell a decision maker.</helo1:HELO_9000004>
        <helo1:HELO_9000005 xml:lang="en">Cost-of-illness studies take the same costing methods further, adding up what a disease costs a whole population each year rather than one episode of care.</helo1:HELO_9000005>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_6000004 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_6000004">
