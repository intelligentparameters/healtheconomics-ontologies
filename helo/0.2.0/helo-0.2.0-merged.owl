        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/external-reference-pricing"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/access-negotiation"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/annuity-payment"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/340b-program"/>
        <helo1:HELO_1000012 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5000063"/>
        <helo1:HELO_2000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</helo1:HELO_2000001>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">Pricing and market access in Setting the Rules of Access</rdfs:label>
        <helo1:HELO_9000004 xml:lang="en">How the price of a medicine is set and agreed with payers, and the deals that let patients get it when the cost is high or paid over time.</helo1:HELO_9000004>
        <helo1:HELO_9000005 xml:lang="en">Once a medicine is approved, its price and the terms of payment decide whether patients can get it, so pricing follows regulation.</helo1:HELO_9000005>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_6000041 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_6000041">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000002"/>
        <helo1:HELO_1000002 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5000008"/>
        <helo1:HELO_1000003 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_6000042"/>
        <helo1:HELO_1000004 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_6000040"/>
        <helo1:HELO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5100041"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/vaccination-policy"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/alcohol-policy"/>
        <helo1:HELO_1000012 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5000064"/>
        <helo1:HELO_2000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</helo1:HELO_2000001>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">Public health and prevention policy in Setting the Rules of Access</rdfs:label>
        <helo1:HELO_9000004 xml:lang="en">How governments use measures such as vaccination programmes and limits on alcohol to prevent illness across a whole population.</helo1:HELO_9000004>
        <helo1:HELO_9000005 xml:lang="en">Not all health policy concerns single medicines, so the pathway widens to measures that act on a whole population before people fall ill.</helo1:HELO_9000005>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_6000042 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_6000042">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000002"/>
        <helo1:HELO_1000002 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5000008"/>
        <helo1:HELO_1000004 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_6000041"/>
        <helo1:HELO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5100042"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/access-to-care"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/concentration-index"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/distributional-cost-effectiveness"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/equity-efficiency-trade-off"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/health-equity"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/health-inequality"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/health-inequity"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/horizontal-equity"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/vertical-equity"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/acceptability"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/access-barrier"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/access-policy"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/accessibility"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/administrative-barrier"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/atkinson-index"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/concentration-curve"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/equity-analysis"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/equity-weighted-analysis"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/extended-cost-effectiveness"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/gini-coefficient-health"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/kakwani-index"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/reynolds-smolensky"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/slope-index-of-inequality"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/suits-index"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/theil-index-health"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/unmet-need"/>
        <helo1:HELO_1000012 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5000065"/>
        <helo1:HELO_2000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</helo1:HELO_2000001>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">Equity and inequality in Setting the Rules of Access</rdfs:label>
        <helo1:HELO_9000004 xml:lang="en">How differences in health and in access to care are measured, which of them count as unfair, and how an evaluation can show who gains and who loses.</helo1:HELO_9000004>
        <helo1:HELO_9000005 xml:lang="en">With medicines and prevention policy in place, the last step asks whether their gains are shared fairly, which needs its own measures and methods.</helo1:HELO_9000005>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_8000001 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_8000001">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000011"/>
        <helo1:HELO_1000012 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_8000028"/>
        <helo1:HELO_1000012 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_8000029"/>
        <helo1:HELO_1000012 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_8000030"/>
        <helo1:HELO_1000012 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_8000031"/>
        <helo1:HELO_1000012 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_8000032"/>
        <helo1:HELO_1000012 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_8000033"/>
        <helo1:HELO_1000012 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_8000034"/>
        <helo1:HELO_1000012 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_8000035"/>
        <helo1:HELO_1000012 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_8000036"/>
        <helo1:HELO_1000012 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_8000037"/>
        <helo1:HELO_1000012 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_8000038"/>
        <helo1:HELO_1000014 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000001"/>
        <helo1:HELO_1000014 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000002"/>
        <helo1:HELO_1000014 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000003"/>
        <helo1:HELO_1000014 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000004"/>
        <helo1:HELO_1000023 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_8000008"/>
        <helo1:HELO_1000023 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_8000009"/>
        <helo1:HELO_1000023 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_8000010"/>
        <helo1:HELO_1000023 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_8000011"/>
        <helo1:HELO_1000023 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_8000012"/>
        <helo1:HELO_1000023 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_8000013"/>
        <helo1:HELO_1000023 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_8000014"/>
        <helo1:HELO_1000023 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_8000015"/>
        <helo1:HELO_1000023 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_8000016"/>
        <helo1:HELO_1000023 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_8000017"/>
        <helo1:HELO_1000027 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000011"/>
        <ns1:IAO_0000116 xml:lang="en">Working title only, as the course outline says. Other titles under consideration are Structured Knowledge for Health Economics and From Glossary to Graph.</ns1:IAO_0000116>
        <dcterms:source>The Semantic Layer for Health Economics, course outline draft for Michelle Ashley and Darrin Baines, 18 October 2026</dcterms:source>
        <rdfs:comment xml:lang="en">Its intended learners are stated in the outline, health economists, HTA analysts, outcomes researchers and their students.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">The Semantic Layer for Health Economics</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_8000002 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_8000002">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000003"/>
        <ns1:IAO_0000115 xml:lang="en">The learning topic of controlled vocabularies, lists of explicitly enumerated terms kept by an authority that registers them, in which each term has one unambiguous and non-redundant definition, a design goal that may not be met in practice. At least a term used for different concepts is qualified, and one of several terms for the same thing is chosen as the preferred term with the others as synonyms, as the concepts of the Health Economics Ontology (HEO) do with their preferred and alternative labels.</ns1:IAO_0000115>
        <ns1:IAO_0000119>NISO 2005, section 4</ns1:IAO_0000119>
        <dcterms:source>Baines D. Scope of the learning pathways ontology, 18 October 2026, passed on by Michelle Ashley in the HELO 0.2.0 brief, building block 1 of 6 of the semantic layer</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">controlled vocabulary</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_8000003 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_8000003">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000003"/>
        <ns1:IAO_0000115 xml:lang="en">The learning topic of metadata schemas, which extend a metadata element set, a set of predefined properties for describing a resource, with rules for syntax, structure and encoding, such as the fields recorded for every HEO concept.</ns1:IAO_0000115>
        <ns1:IAO_0000119>NISO 2005, section 5.5</ns1:IAO_0000119>
        <dcterms:source>Baines D. Scope of the learning pathways ontology, 18 October 2026, passed on by Michelle Ashley in the HELO 0.2.0 brief, building block 2 of 6 of the semantic layer</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">metadata schema</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_8000004 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_8000004">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000003"/>
        <ns1:IAO_0000115 xml:lang="en">The learning topic of taxonomies, collections of controlled vocabulary terms arranged in a hierarchy in which each term has broader or narrower terms, such as the Knowledge Tree of health economics with its subdomains and topics.</ns1:IAO_0000115>
        <ns1:IAO_0000119>NISO 2005, section 4</ns1:IAO_0000119>
        <dcterms:source>Baines D. Scope of the learning pathways ontology, 18 October 2026, passed on by Michelle Ashley in the HELO 0.2.0 brief, building block 3 of 6 of the semantic layer</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">taxonomy</rdfs:label>
        <helo1:HELO_9000023 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_8000002"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_8000004"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_9000023"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_8000002"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <helo1:HELO_9000010 xml:lang="en">NISO 2005 section 5.4 orders controlled vocabularies by increasing structural complexity, list, synonym ring, taxonomy and thesaurus, and the more complex include the simpler, so controlled vocabulary is proposed to be understood before taxonomy (review B S8).</helo1:HELO_9000010>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_8000005 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_8000005">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000003"/>
        <ns1:IAO_0000115 xml:lang="en">The learning topic of thesauri, controlled vocabularies arranged in a known order whose equivalence, hierarchical and associative relationships between terms (use and used for, broader and narrower, related) are shown by standard relationship indicators used in both directions, such as a vocabulary recording QALY as an equivalent of quality-adjusted life year.</ns1:IAO_0000115>
        <ns1:IAO_0000119>NISO 2005, sections 4 and 8</ns1:IAO_0000119>
        <dcterms:source>Baines D. Scope of the learning pathways ontology, 18 October 2026, passed on by Michelle Ashley in the HELO 0.2.0 brief, building block 4 of 6 of the semantic layer</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">thesaurus</rdfs:label>
        <helo1:HELO_9000023 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_8000004"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_8000005"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_9000023"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_8000004"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <helo1:HELO_9000010 xml:lang="en">NISO 2005 section 5.4 orders controlled vocabularies by increasing structural complexity, list, synonym ring, taxonomy and thesaurus, and the more complex include the simpler, so taxonomy is proposed to be understood before thesaurus (review B S8).</helo1:HELO_9000010>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_8000006 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_8000006">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000003"/>
        <ns1:IAO_0000115 xml:lang="en">The learning topic of ontologies, explicit specifications of a conceptualisation, which in the healtheconomics.wiki family state either the concepts of health economics and their relationships, as HEO does, or, in the realist sense, the kinds of real things those concepts are about, as RHEO does, with tasks, outcomes, values and mathematics alongside.</ns1:IAO_0000115>
        <ns1:IAO_0000119>Gruber 1993; RHEO 0.4.0 README</ns1:IAO_0000119>
        <dcterms:source>Baines D. Scope of the learning pathways ontology, 18 October 2026, passed on by Michelle Ashley in the HELO 0.2.0 brief, building block 5 of 6 of the semantic layer</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">ontology</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_8000007 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_8000007">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000003"/>
        <ns1:IAO_0000115 xml:lang="en">The learning topic of knowledge graphs, graphs of data intended to gather and convey knowledge of the real world, whose nodes stand for things of interest and whose edges stand for relationships between them, such as the HEO and RHEO graph together. The definition is an inclusive one and is contested.</ns1:IAO_0000115>
        <ns1:IAO_0000119>Hogan et al. 2021</ns1:IAO_0000119>
        <dcterms:source>Baines D. Scope of the learning pathways ontology, 18 October 2026, passed on by Michelle Ashley in the HELO 0.2.0 brief, building block 6 of 6 of the semantic layer</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">knowledge graph</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_8000008 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_8000008">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000012"/>
        <helo1:HELO_1000024 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_8000001"/>
        <helo1:HELO_1000025 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_8000009"/>
        <helo1:HELO_1000026 rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <helo1:HELO_1000026 rdf:resource="https://healtheconomics.wiki/concept/discounting"/>
        <helo1:HELO_1000026 rdf:resource="https://healtheconomics.wiki/concept/icer"/>
        <helo1:HELO_1000026 rdf:resource="https://healtheconomics.wiki/concept/qaly"/>
        <helo1:HELO_1000026 rdf:resource="https://healtheconomics.wiki/concept/utility"/>
        <helo1:HELO_1000027 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000011"/>
        <helo1:HELO_2000003 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</helo1:HELO_2000003>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">Why structure matters</rdfs:label>
        <helo1:HELO_9000011 xml:lang="en">Glossary to graph. A flat list of terms folds into a live, connected graph, then the same question goes to an AI with and without the graph</helo1:HELO_9000011>
        <helo1:HELO_9000012 xml:lang="en">HEO 1.3.0 terms around QALY and ICER</helo1:HELO_9000012>
        <helo1:HELO_9000013 rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_8000008"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_9000013"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:comment xml:lang="en">The outline row of module 1 names HEO in its real material, so the module&apos;s material uses the Health Economics Ontology (HEO). Representational is the nearest of the five linking kinds of HEAO 0.2.0. A module whose material uses an ontology records that use and does not describe the ontology.</rdfs:comment>
        <ns2:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000002"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_8000009 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_8000009">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000012"/>
        <helo1:HELO_1000024 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_8000001"/>
        <helo1:HELO_1000025 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_8000010"/>
        <helo1:HELO_1000027 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000011"/>
        <helo1:HELO_2000003 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</helo1:HELO_2000003>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">Vocabulary and identifiers</rdfs:label>
        <helo1:HELO_9000011 xml:lang="en">Mint a URI. Learners give a term a permanent address and watch it resolve to a real wiki page</helo1:HELO_9000011>
        <helo1:HELO_9000012 xml:lang="en">Live wiki concept URIs</helo1:HELO_9000012>
        <helo1:HELO_9000015 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_8000002"/>
        <helo1:HELO_9000015 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_8000003"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_8000009"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_9000015"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_8000002"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <helo1:HELO_9000010 xml:lang="en">The module title names vocabulary, and outcome 2 (a permanent identifier and one definition for every term) is the controlled vocabulary of NISO 2005, so the module is proposed to cover controlled vocabulary.</helo1:HELO_9000010>
    </owl:Axiom>
    <owl:Axiom>
