        <helo1:HELO_9000002 xml:lang="en">How to get a funding decision by appraising the evidence on a treatment</helo1:HELO_9000002>
        <helo1:HELO_9000003 xml:lang="en">This pathway shows how an HTA body judges a new treatment and reaches a recommendation on whether it should be funded. It then covers how payers list the treatment and manage access to it.</helo1:HELO_9000003>
        <helo1:HELO_9000007 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000001"/>
