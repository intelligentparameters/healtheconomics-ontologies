    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_4000021 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_4000021">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000014"/>
        <owl:differentFrom rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000022"/>
        <owl:differentFrom rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000023"/>
