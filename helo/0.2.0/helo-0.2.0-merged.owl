        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/transition-reward"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/treatment-sequence-model"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/tunnel-state"/>
        <helo1:HELO_1000012 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5000042"/>
        <helo1:HELO_2000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</helo1:HELO_2000001>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">Markov and state-transition models in Building the Model</rdfs:label>
        <helo1:HELO_9000004 xml:lang="en">Models where patients move between health states in fixed cycles, with costs and health added up for each state over time.</helo1:HELO_9000004>
        <helo1:HELO_9000005 xml:lang="en">Decision trees grow unwieldy when events repeat over many years, and state-transition models handle repeating events in a compact way.</helo1:HELO_9000005>
    </owl:NamedIndividual>
    


