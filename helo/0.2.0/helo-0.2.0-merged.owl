    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_9000001 -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_9000001">
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">Relates a relationship that HEAO makes across ontologies, a property or an annotated bridge axiom, to the kind of relationship it is, one of definitional, representational, computational, causal or valuational.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>Ashley M. HEAO 0.2.0 locked decisions (best practice), 18 October 2026</ns1:IAO_0000119>
        <ns1:IAO_0000412 rdf:resource="https://healtheconomics.wiki/ontologies/heao/0.2.0/heao.owl"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">has linking kind</rdfs:label>
    </owl:AnnotationProperty>
    


