        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">Model validation and calibration in Building the Model</rdfs:label>
        <helo1:HELO_9000004 xml:lang="en">Checking that a model works as intended and matches observed data, and adjusting unknown values until the model fits.</helo1:HELO_9000004>
        <helo1:HELO_9000005 xml:lang="en">Once a model is built, its results can be trusted only after it has been checked against the evidence and tuned where data are missing.</helo1:HELO_9000005>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_6000026 -->

