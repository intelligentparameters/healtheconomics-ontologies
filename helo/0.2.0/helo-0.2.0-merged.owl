        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">Budget impact analysis in Judging Value for Money</rdfs:label>
        <helo1:HELO_9000004 xml:lang="en">Whether a payer can afford an option in the years after the option is adopted, which is a separate question from value for money.</helo1:HELO_9000004>
        <helo1:HELO_9000005 xml:lang="en">A cost-effective option can still be too costly to fund in a given year, so affordability is checked as a separate question.</helo1:HELO_9000005>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_6000014 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_6000014">
