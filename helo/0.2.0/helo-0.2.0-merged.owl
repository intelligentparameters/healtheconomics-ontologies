    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_9000010 -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_9000010">
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns1:IAO_0000115 xml:lang="en">On a proposed relationship, the reason the HELO build proposes it, in plain words.</ns1:IAO_0000115>
        <ns1:IAO_0000117>Michelle Ashley (drafted with Claude)</ns1:IAO_0000117>
        <ns1:IAO_0000119>HELO 0.2.0 design (best practice), Michelle Ashley with Claude, 19 October 2026</ns1:IAO_0000119>
