        <helo1:HELO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5100018"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/chance-node"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/decision-node"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/decision-tree"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/expected-value"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/decision-tree-model"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/expected-value-analysis"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/folding-back"/>
        <helo1:HELO_1000012 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5000041"/>
        <helo1:HELO_2000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</helo1:HELO_2000001>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">Decision trees in Building the Model</rdfs:label>
        <helo1:HELO_9000004 xml:lang="en">The simplest model, where branches show each choice and chance event, and each path ends in a cost and an outcome.</helo1:HELO_9000004>
        <helo1:HELO_9000005 xml:lang="en">A decision tree shows the logic of expected values most plainly, so it comes first among the model types.</helo1:HELO_9000005>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_6000019 -->

