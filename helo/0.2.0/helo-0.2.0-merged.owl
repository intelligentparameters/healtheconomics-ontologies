        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">Evidence synthesis and appraisal in Weighing the Evidence</rdfs:label>
        <helo1:HELO_9000004 xml:lang="en">Finding and appraising all the relevant studies and combining their results, including comparisons of treatments never tested against each other in one trial.</helo1:HELO_9000004>
        <helo1:HELO_9000005 xml:lang="en">A single study rarely settles a question, so once the analysis of one study is clear, the results of many studies are appraised and pooled.</helo1:HELO_9000005>
    </owl:NamedIndividual>
    


