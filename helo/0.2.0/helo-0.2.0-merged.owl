        <helo1:HELO_2000002 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</helo1:HELO_2000002>
        <dcterms:identifier>economic-evaluation</dcterms:identifier>
        <dcterms:source>https://healtheconomics.wiki/api/pathways, read-only GET on 2026-10-19</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">Judging Value for Money</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation"/>
        <helo1:HELO_9000002 xml:lang="en">How to get a value-for-money result by comparing extra costs with extra health</helo1:HELO_9000002>
        <helo1:HELO_9000003 xml:lang="en">Do you want to learn how to tell if a treatment is worth the money? You compare its extra cost with its extra health and check the result against a threshold.</helo1:HELO_9000003>
        <helo1:HELO_9000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000001"/>
