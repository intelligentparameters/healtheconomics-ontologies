        <helo1:HELO_2000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</helo1:HELO_2000001>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">Organisation and governance in Follow the Money</rdfs:label>
        <helo1:HELO_9000004 xml:lang="en">How a health system is arranged, who holds authority over funds and providers, and the policies and rules that govern care.</helo1:HELO_9000004>
        <helo1:HELO_9000005 xml:lang="en">Every later step happens inside a particular system, so the pathway starts with how health systems are organised and governed.</helo1:HELO_9000005>
    </owl:NamedIndividual>
    


