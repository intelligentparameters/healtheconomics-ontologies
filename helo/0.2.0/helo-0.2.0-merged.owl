        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">Survival analysis and extrapolation in Building the Model</rdfs:label>
        <helo1:HELO_9000004 xml:lang="en">How time-to-event data from trials are analysed, and how survival curves are extended beyond the end of follow-up.</helo1:HELO_9000004>
        <helo1:HELO_9000005 xml:lang="en">Trials rarely follow patients for a lifetime, so a model often needs survival curves fitted and extended well past the observed data.</helo1:HELO_9000005>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_6000022 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_6000022">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000002"/>
        <helo1:HELO_1000002 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5000005"/>
        <helo1:HELO_1000003 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_6000023"/>
        <helo1:HELO_1000004 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_6000021"/>
        <helo1:HELO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5100022"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/area-under-curve-approach"/>
        <helo1:HELO_1000006 rdf:resource="https://healtheconomics.wiki/concept/partitioned-survival-model"/>
        <helo1:HELO_1000012 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5000045"/>
        <helo1:HELO_2000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</helo1:HELO_2000001>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">Partitioned survival models in Building the Model</rdfs:label>
        <helo1:HELO_9000004 xml:lang="en">Models that take the share of patients in each health state directly from survival curves, often used for cancer treatments.</helo1:HELO_9000004>
        <helo1:HELO_9000005 xml:lang="en">A partitioned survival model is built from the fitted curves of the step before, so it follows survival analysis.</helo1:HELO_9000005>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_6000023 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_6000023">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000002"/>
        <helo1:HELO_1000002 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5000005"/>
        <helo1:HELO_1000003 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_6000024"/>
