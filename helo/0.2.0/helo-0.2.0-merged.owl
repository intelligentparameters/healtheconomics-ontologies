        <helo1:HELO_1000012 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5000012"/>
        <helo1:HELO_1000027 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000010"/>
        <helo1:HELO_1000028 rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <helo1:HELO_2000002 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</helo1:HELO_2000002>
        <dcterms:identifier>outcomes</dcterms:identifier>
        <dcterms:source>https://healtheconomics.wiki/api/pathways, read-only GET on 2026-10-19</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">Measuring Health Gain</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/knowledge-map/outcomes"/>
        <helo1:HELO_9000002 xml:lang="en">How to get quality-adjusted life years by valuing health states with people&apos;s preferences</helo1:HELO_9000002>
        <helo1:HELO_9000003 xml:lang="en">Do you want to learn how to measure the health a treatment gives? You take patients&apos; answers to a health questionnaire and turn them into QALYs.</helo1:HELO_9000003>
        <helo1:HELO_9000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000009"/>
        <helo1:HELO_9000007 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000001"/>
        <helo1:HELO_9000007 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000002"/>
        <helo1:HELO_9000007 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000003"/>
        <helo1:HELO_9000007 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000004"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5000002"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_9000006"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000009"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <ns2:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000002"/>
        <helo1:HELO_9000009 rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.00</helo1:HELO_9000009>
        <helo1:HELO_9000010 xml:lang="en">3 of the 3 HEO concepts that HETO 0.3.0 relates to the task Assign utility values to model health states are core concepts of Measuring Health Gain (Health State Utility Value, Quality-Adjusted Life Year (QALY), Utility), at least half, so the build proposes that the pathway prepares for the task. HETO&apos;s own relationships from tasks to HEO concepts are proposals too. The pathway builds understanding of these concepts and does not train the task. Representational is the nearest of the five linking kinds of HEAO 0.2.0. Preparing a learner for a task is none of them exactly.</helo1:HELO_9000010>
        <helo1:HELO_9000021 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</helo1:HELO_9000021>
        <helo1:HELO_9000022 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</helo1:HELO_9000022>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5000002"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_9000007"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_4000001"/>
        <ns1:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000428"/>
        <helo1:HELO_9000010 xml:lang="en">Review B of HELO 0.2.0 (19 October 2026) proposes that Measuring Health Gain is primarily for the student, for Darrin Baines to confirm. The site does not state who the pathway is for.</helo1:HELO_9000010>
        <helo1:HELO_9000020>primarily</helo1:HELO_9000020>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5000002"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_9000007"/>
