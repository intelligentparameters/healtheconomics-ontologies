<?xml version="1.0"?>
<rdf:RDF xmlns="https://healtheconomics.wiki/ontologies/helo#"
     xml:base="https://healtheconomics.wiki/ontologies/helo"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:ns1="http://purl.obolibrary.org/obo/"
     xmlns:ns2="https://healtheconomics.wiki/ontologies/heao/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:helo="https://healtheconomics.wiki/ontologies/helo/HELO_"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:helo1="https://healtheconomics.wiki/ontologies/helo/"
     xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://healtheconomics.wiki/ontologies/helo">
        <owl:versionIRI rdf:resource="https://healtheconomics.wiki/ontologies/helo/0.2.0/helo.owl"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dcterms:created>
        <dcterms:creator rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <dcterms:creator rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <dcterms:description xml:lang="en">HELO 0.2.0 core terms and the records of the eight learning pathways of HealthEconomics.wiki and the draft semantic layer course, merged with BFO 2020, the IAO terms HELO uses and the HEAO linking kinds. The HEO concepts and HETO tasks the records name are given by IRI only, without HEO&apos;s or HETO&apos;s labels, so that BioPortal lists only HELO&apos;s own terms. The prerequisite relationships proposed from HEO are left out until a curator reviews them, and are in helo-pathways.owl. Learning pathways build understanding, not hands-on skills. HELO here is the Health Economics Learning Ontology of HealthEconomics.wiki. It is not the HypothEsis and Law Ontology, also called HELO (Soldatova et al. 2013), and is unrelated to it.</dcterms:description>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dcterms:modified>
        <dcterms:publisher>Intelligent Parameters Ltd</dcterms:publisher>
        <dcterms:title xml:lang="en">Health Economics Learning Ontology (HELO), merged file for BioPortal</dcterms:title>
        <vann:preferredNamespacePrefix>helo</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://healtheconomics.wiki/ontologies/helo/HELO_</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">Version 0.1.0 alpha, fixed in place after three independent reviews of 19 October 2026. HELO here is the Health Economics Learning Ontology of HealthEconomics.wiki. It is not the HypothEsis and Law Ontology, also called HELO (Soldatova et al. 2013), and is unrelated to it.</rdfs:comment>
        <owl:versionInfo>0.2.0</owl:versionInfo>
    </owl:Ontology>
    


