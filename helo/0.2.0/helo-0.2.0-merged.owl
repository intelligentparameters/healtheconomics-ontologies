        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/efficient-design"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/experimental-design"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/latent-class-model"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/meta-regression-transfer"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/orthogonal-design"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/part-worth-utility"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/random-parameter-model"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/utility-function"/>
        <helo1:HELO_1000007 rdf:resource="https://healtheconomics.wiki/concept/willingness-to-pay-estimation"/>
        <helo1:HELO_1000012 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5000031"/>
        <helo1:HELO_2000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</helo1:HELO_2000001>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/helo"/>
        <rdfs:label xml:lang="en">Stated preference and monetary valuation in Measuring Health Gain</rdfs:label>
        <helo1:HELO_9000004 xml:lang="en">Asking people what they would pay or which option they would choose, so outcomes can be valued in money or traded against each other.</helo1:HELO_9000004>
        <helo1:HELO_9000005 xml:lang="en">Some decisions need outcomes valued in money, or need to know which features of care people value, and QALYs alone cannot show either.</helo1:HELO_9000005>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/helo/HELO_6000008 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/helo/HELO_6000008">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_0000002"/>
        <helo1:HELO_1000002 rdf:resource="https://healtheconomics.wiki/ontologies/helo/HELO_5000003"/>
