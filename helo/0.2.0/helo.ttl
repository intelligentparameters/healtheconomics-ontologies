        owl:ObjectProperty ;
    rdfs:label "has publication status"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a learning pathway, a curriculum or a course module to its publication status."@en ;
