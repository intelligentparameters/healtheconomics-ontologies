        owl:FunctionalProperty ;
    rdfs:label "has step position"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "The place of a learning step in its learning pathway, counted from 1 at the first step."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
