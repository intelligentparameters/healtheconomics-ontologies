dcterms:title a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

helo:1000003 a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:InverseFunctionalProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "has next learning step"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a learning step to the learning step that comes straight after it in the same learning pathway."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. How the knowledge map works, notes for the site developer, 12 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain helo:0000002 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/helo> ;
    rdfs:range helo:0000002 ;
    owl:inverseOf helo:1000004 .

helo:1000005 a owl:ObjectProperty ;
    rdfs:label "has learning topic"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a learning step or a course module to a learning topic it is about."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. How the knowledge map works, notes for the site developer, 12 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/helo> ;
    rdfs:range helo:0000003 .

helo:1000006 a owl:ObjectProperty ;
    rdfs:label "has core concept"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a learning step to a HEO concept that a learner is to understand at that step, a must-learn concept of its pathway framework."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. How the knowledge map works, notes for the site developer, 12 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain helo:0000002 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/helo> ;
    heao:9000001 heao:4000002 .

helo:1000007 a owl:ObjectProperty ;
    rdfs:label "has optional concept"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a learning step to a HEO concept that goes further than the core of that step and that a learner may choose to study."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. How the knowledge map works, notes for the site developer, 12 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain helo:0000002 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/helo> ;
    heao:9000001 heao:4000002 .

helo:1000008 a owl:ObjectProperty ;
    rdfs:label "builds on concept"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a learning pathway to a HEO concept from another part of the Knowledge Tree that the pathway builds on, so that it is best understood before the pathway is started."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. How the knowledge map works, notes for the site developer, 12 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain helo:0000001 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/helo> ;
    heao:9000001 heao:4000002 .

helo:1000009 a owl:ObjectProperty ;
    rdfs:label "has onward concept"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a learning pathway to a HEO concept that takes the pathway's concepts further, to be explored after the pathway is finished."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. How the knowledge map works, notes for the site developer, 12 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain helo:0000001 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/helo> ;
    heao:9000001 heao:4000002 .

helo:1000010 a owl:ObjectProperty ;
    rdfs:label "leads into step"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a learning pathway to a learning step of another learning pathway that it leads into on the Knowledge Map, so that a learner who finishes the first pathway can join the second at that step."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. How the knowledge map works, notes for the site developer, 12 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain helo:0000001 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/helo> ;
    rdfs:range helo:0000002 .

helo:1000011 a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "is framework of"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a pathway framework to the one learning pathway it lays out."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. How the knowledge map works, notes for the site developer, 12 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain helo:0000004 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/helo> ;
    rdfs:range helo:0000001 .

helo:1000013 a owl:ObjectProperty ;
    rdfs:label "concerns concept"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a concept understanding goal to a HEO concept or a learning topic that a learner is intended to understand."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "HELO 0.2.0 design (best practice), Michelle Ashley with Claude, 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain helo:0000007 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/helo> ;
    heao:9000001 heao:4000002 .

helo:1000014 a owl:ObjectProperty ;
    rdfs:label "is intended for"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a learning pathway or a curriculum to an intended learner profile that its own source states it is for."@en ;
    obo:IAO_0000116 "Used only where the source of the pathway or curriculum states the learners. Profiles proposed by the HELO build are held in the annotation property proposed intended learner until a curator accepts them."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "HELO 0.2.0 design (best practice), Michelle Ashley with Claude, 19 October 2026; Christou et al. 2025" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/helo> ;
    rdfs:range helo:0000005 .

helo:1000015 a owl:ObjectProperty ;
    rdfs:label "prepares for task"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a learning pathway to a HETO task specification whose concepts the pathway builds understanding of, so that a learner is ready to be trained in the task elsewhere. The pathway does not train the learner to carry out the task."@en ;
    obo:IAO_0000116 "Not used in HELO 0.2.0. Proposed relationships are held in the annotation property proposed to prepare for task, with their basis, until a curator accepts them. No HELO property says that a pathway trains a task, and none should be added."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Baines D. Scope of the learning pathways ontology, 18 October 2026, passed on by Michelle Ashley in the HELO 0.2.0 brief" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain helo:0000001 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/helo> ;
    heao:9000001 heao:4000002 .

helo:1000016 a owl:ObjectProperty ;
    rdfs:label "has prerequisite concept"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a prerequisite relationship to the HEO concept that is to be understood first."@en ;
    obo:IAO_0000116 "Not functional in OWL, so that a faulty record never makes two HEO concepts the same. The SHACL rules allow one value."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "HELO 0.2.0 design (best practice), Michelle Ashley with Claude, 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain helo:0000009 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/helo> ;
    heao:9000001 heao:4000002 .

helo:1000017 a owl:ObjectProperty ;
    rdfs:label "has dependent concept"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a prerequisite relationship to the HEO concept that is understood after its prerequisite concept and with its help."@en ;
    obo:IAO_0000116 "Not functional in OWL, so that a faulty record never makes two HEO concepts the same. The SHACL rules allow one value."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "HELO 0.2.0 design (best practice), Michelle Ashley with Claude, 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain helo:0000009 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/helo> ;
    heao:9000001 heao:4000002 .

helo:1000018 a owl:ObjectProperty ;
    rdfs:label "follows derivation rule"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a prerequisite relationship to a prerequisite derivation rule by which it was derived."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "HELO 0.2.0 design (best practice), Michelle Ashley with Claude, 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain helo:0000009 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/helo> ;
    rdfs:range helo:0000010 .

helo:1000019 a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has prerequisite status"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a prerequisite relationship to its prerequisite status."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "HELO 0.2.0 design (best practice), Michelle Ashley with Claude, 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain helo:0000009 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/helo> ;
    rdfs:range helo:0000014 .

helo:1000020 a owl:ObjectProperty ;
    rdfs:label "agrees with order of"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a prerequisite relationship to a learning pathway that places its prerequisite concept in an earlier step than its dependent concept, or among the concepts the pathway builds on."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "HELO 0.2.0 design (best practice), Michelle Ashley with Claude, 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain helo:0000009 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/helo> ;
    rdfs:range helo:0000001 .

helo:1000021 a owl:ObjectProperty ;
    rdfs:label "conflicts with order of"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a prerequisite relationship to a learning pathway that places its prerequisite concept in a later step than its dependent concept, or that builds on the dependent concept while teaching the prerequisite concept in one of its steps."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "HELO 0.2.0 design (best practice), Michelle Ashley with Claude, 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain helo:0000009 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/helo> ;
    rdfs:range helo:0000001 .

helo:1000022 a owl:ObjectProperty ;
    rdfs:label "is within one step of"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a prerequisite relationship to a learning pathway that places both of its concepts in the same learning step."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "HELO 0.2.0 design (best practice), Michelle Ashley with Claude, 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain helo:0000009 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/helo> ;
    rdfs:range helo:0000001 .

helo:1000023 a owl:ObjectProperty ;
    rdfs:label "has course module"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a curriculum to one of its course modules."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Christou et al. 2025" ;
