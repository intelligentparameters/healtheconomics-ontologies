helo:1000028 a owl:ObjectProperty ;
    rdfs:label "covers subdomain"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a learning pathway to the HEO concept naming the subdomain of the Knowledge Tree whose topics the pathway follows."@en ;
    obo:IAO_0000116 "Not functional in OWL, so that a faulty record never makes two HEO concepts the same. The SHACL rules allow one subdomain."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
