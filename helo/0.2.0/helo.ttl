    rdfs:label "has HEO link identifier"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "The permanent identifier of a HEO relationship from which a prerequisite relationship was derived, of the form HEO-L- followed by twelve hexadecimal digits."@en ;
