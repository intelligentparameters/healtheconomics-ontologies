        hewc:appraisal-committee,
        hewc:assessment,
        hewc:coverage-decision,
        hewc:decision-criteria,
        hewc:health-technology-assessment,
        hewc:reference-case ;
    helo:1000007 hewc:accountability-for-reasonableness,
        hewc:added-therapeutic-value,
        hewc:ai-diagnostic-value,
        hewc:algorithm-development,
        hewc:appeal-process,
        hewc:artificial-intelligence-in-health,
        hewc:asmr-rating,
        hewc:clinical-guideline,
        hewc:decision,
        hewc:decision-algorithm,
        hewc:early-health-technology-assessment,
        hewc:evidence-synthesis,
        hewc:mcda-in-hta,
        hewc:multi-criteria-decision-analysis,
        hewc:real-option-value ;
    helo:1000012 helo:5000038 ;
    helo:2000001 1 ;
    helo:9000004 "How an HTA body reviews the evidence on a technology, and how a committee weighs that evidence against its decision criteria to reach a funding recommendation."@en ;
    helo:9000005 "The pathway starts with how a technology is assessed and appraised, because every later funding and access decision rests on that recommendation."@en .

helo:6000016 a owl:NamedIndividual,
        helo:0000002 ;
    rdfs:label "Reimbursement and managed access in Deciding What to Fund"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/helo> ;
    helo:1000002 helo:5000004 ;
    helo:1000004 helo:6000015 ;
    helo:1000005 helo:5100016 ;
    helo:1000006 hewc:formulary,
        hewc:managed-entry-agreement ;
    helo:1000007 hewc:amcp-dossier,
        hewc:appeals-design,
        hewc:prior-authorization ;
    helo:1000012 helo:5000039 ;
    helo:2000001 2 ;
    helo:9000004 "How payers put a technology on a formulary and control its use, and how managed entry agreements let a technology be funded while doubts about its value or cost remain."@en ;
    helo:9000005 "Once an HTA body has made its recommendation, payers still have to set the terms on which patients get the technology, so access arrangements come next."@en .

helo:6000018 a owl:NamedIndividual,
        helo:0000002 ;
