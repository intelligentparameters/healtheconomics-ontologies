        hewc:partitioned-survival-model ;
    helo:1000012 helo:5000045 ;
    helo:2000001 6 ;
    helo:9000004 "Models that take the share of patients in each health state directly from survival curves, often used for cancer treatments."@en ;
    helo:9000005 "A partitioned survival model is built from the fitted curves of the step before, so it follows survival analysis."@en .

helo:6000023 a owl:NamedIndividual,
