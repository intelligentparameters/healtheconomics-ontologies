<https://healtheconomics.wiki/ontologies/helo/helo-pathways.owl> a owl:Ontology ;
    dcterms:created "2026-10-19"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    dcterms:description "The eight learning pathways of HealthEconomics.wiki as HELO records, generated by src/build_helo.py from a read-only snapshot of /api/pathways taken on 19 October 2026, with their steps, topics, frameworks, concept understanding goals and the concepts each step covers, all live HEO 2.0.0 concepts. It also holds the draft semantic layer course as a curriculum of ten course modules, the prerequisite relationships proposed from HEO, and the proposed relationships from pathways to HETO tasks and intended learners, none of them reviewed yet. HELO here is the Health Economics Learning Ontology of HealthEconomics.wiki. It is not the HypothEsis and Law Ontology, also called HELO (Soldatova et al. 2013), and is unrelated to it."@en ;
    dcterms:issued "2026-10-19"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-19"^^xsd:date ;
    dcterms:publisher "Intelligent Parameters Ltd" ;
    dcterms:title "HELO 0.2.0 learning pathways and courses"@en ;
    vann:preferredNamespacePrefix "helo" ;
    vann:preferredNamespaceUri "https://healtheconomics.wiki/ontologies/helo/HELO_" ;
    rdfs:comment "Version 0.1.0 alpha, fixed in place after three independent reviews of 19 October 2026. Not uploaded. Every term has the curation status pending final vetting, and every proposal requires discussion. HELO here is the Health Economics Learning Ontology of HealthEconomics.wiki. It is not the HypothEsis and Law Ontology, also called HELO (Soldatova et al. 2013), and is unrelated to it."@en ;
    owl:imports <https://healtheconomics.wiki/ontologies/helo/0.2.0/helo.owl>,
        <https://healtheconomics.wiki/ontologies/helo/0.2.0/imports/heo-extract.owl>,
        <https://healtheconomics.wiki/ontologies/helo/0.2.0/imports/heto-extract.owl> ;
    owl:versionIRI <https://healtheconomics.wiki/ontologies/helo/0.2.0/helo-pathways.owl> ;
    owl:versionInfo "0.2.0" .

