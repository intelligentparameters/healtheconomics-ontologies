helo:8000038 a owl:NamedIndividual,
        helo:0000008 ;
    rdfs:label "Build, publish and query a small vocabulary of their own"@en ;
    dcterms:source "The Semantic Layer for Health Economics, course outline draft for Michelle Ashley and Darrin Baines, 18 October 2026, What learners can do at the end, item 10" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/helo> ;
    helo:2000005 10 ;
    helo:9000024 "Build, publish and query a small vocabulary of their own."@en .

helo:6000001 a owl:NamedIndividual,
