        hewc:stochastic-simulation ;
    helo:1000012 helo:5000046 ;
    helo:2000001 7 ;
    helo:9000004 "Models that follow simulated patients one at a time, so each person's history and the timing of events can shape what happens next."@en ;
    helo:9000005 "Some questions need each patient's past to matter, which cohort models capture poorly, so individual-level methods come once cohort models are familiar."@en .

helo:6000024 a owl:NamedIndividual,
        helo:0000002 ;
    rdfs:label "Dynamic transmission and system dynamics models in Building the Model"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/helo> ;
