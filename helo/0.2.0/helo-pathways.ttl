    helo:9000005 "Trials rarely follow patients for a lifetime, so a model often needs survival curves fitted and extended well past the observed data."@en .

helo:6000022 a owl:NamedIndividual,
        helo:0000002 ;
    rdfs:label "Partitioned survival models in Building the Model"@en ;
