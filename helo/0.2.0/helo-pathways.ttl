        hewc:expected-value-analysis,
        hewc:folding-back ;
    helo:1000012 helo:5000041 ;
    helo:2000001 2 ;
    helo:9000004 "The simplest model, where branches show each choice and chance event, and each path ends in a cost and an outcome."@en ;
    helo:9000005 "A decision tree shows the logic of expected values most plainly, so it comes first among the model types."@en .

helo:6000019 a owl:NamedIndividual,
        helo:0000002 ;
