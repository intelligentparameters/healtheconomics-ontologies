        hewc:access-negotiation,
        hewc:annuity-payment ;
    helo:1000012 helo:5000063 ;
    helo:2000001 2 ;
    helo:9000004 "How the price of a medicine is set and agreed with payers, and the deals that let patients get it when the cost is high or paid over time."@en ;
    helo:9000005 "Once a medicine is approved, its price and the terms of payment decide whether patients can get it, so pricing follows regulation."@en .

helo:6000041 a owl:NamedIndividual,
        helo:0000002 ;
    rdfs:label "Public health and prevention policy in Setting the Rules of Access"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/helo> ;
