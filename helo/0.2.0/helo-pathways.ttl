        hewc:precision-medicine,
        hewc:risk-evaluation ;
    helo:1000012 helo:5000062 ;
    helo:2000001 1 ;
    helo:9000004 "How a new medicine gains approval and how its safety is watched once patients use it, including faster routes for serious conditions."@en ;
    helo:9000005 "The pathway starts with drug development and regulation, because a medicine must be approved before anyone can set its price or judge its value."@en .

helo:6000040 a owl:NamedIndividual,
        helo:0000002 ;
    rdfs:label "Pricing and market access in Setting the Rules of Access"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/helo> ;
    helo:1000002 helo:5000008 ;
    helo:1000003 helo:6000041 ;
