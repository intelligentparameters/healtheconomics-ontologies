helo:8000002 a owl:NamedIndividual,
        helo:0000003 ;
    rdfs:label "controlled vocabulary"@en ;
    obo:IAO_0000115 "The learning topic of controlled vocabularies, lists of explicitly enumerated terms kept by an authority that registers them, in which each term has one unambiguous and non-redundant definition, a design goal that may not be met in practice. At least a term used for different concepts is qualified, and one of several terms for the same thing is chosen as the preferred term with the others as synonyms, as the concepts of the Health Economics Ontology (HEO) do with their preferred and alternative labels."@en ;
    obo:IAO_0000119 "NISO 2005, section 4" ;
    dcterms:source "Baines D. Scope of the learning pathways ontology, 18 October 2026, passed on by Michelle Ashley in the HELO 0.2.0 brief, building block 1 of 6 of the semantic layer" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/helo> .

