    helo:9000005 "The way a provider is paid shapes its income, so its budgets and financial health are looked at next."@en .

helo:6000039 a owl:NamedIndividual,
        helo:0000002 ;
    rdfs:label "Drug development and regulation in Setting the Rules of Access"@en ;
