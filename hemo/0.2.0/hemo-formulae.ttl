hemo:7003939 a owl:NamedIndividual,
        hemo:0000016 ;
    rdfs:label "EVPPI_2L in the test Article's EVPPI for the utility with exact inner means"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000039 hemo:6002829 ;
    rheo:2000001 350.0 .

hemo:7003940 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Nested estimator with every parameter of interest returns the EVPI"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000007 ;
    hemo:1000037 hemo:7003941,
        hemo:7003942,
        hemo:7003943,
        hemo:7003944,
        hemo:7003945,
        hemo:7003946 ;
    hemo:1000038 hemo:7003947,
        hemo:7003948,
        hemo:7003949 ;
    hemo:2000008 0.5 ;
    hemo:9000008 "Limiting case. When the outer draws carry every uncertain parameter, nothing is left to vary in the inner loop, so the inner runs at each outer draw are identical and each inner mean is a single model run. With two equally likely runs of GBP 1,500 and GBP -1,100 the estimate is GBP 750 less GBP 200, which gives GBP 550, the per-person EVPI of the same two runs (HE-FM-VOI-001). Validation Test HE-VT-EVPP-003 checks the same identity on the article's four combinations, where it gives the EVPI of GBP 600." ;
    hemo:9000009 "Nested estimator with every parameter of interest returns the EVPI" ;
    hemo:9000014 "K = 2; J = 2; INB_11 = 1500; INB_12 = 1500; INB_21 = -1100; INB_22 = -1100; ibar_1 = 1500; ibar_2 = -1100; EVPPI_2L = 550" ;
    hemo:9000018 "HE-EX-EVPP-003" ;
    hemo:9000023 "nested-estimator-with-every-parameter-of-interest-returns-the-evpi" .

hemo:7003941 a owl:NamedIndividual,
        hemo:0000016 ;
    rdfs:label "K in the test Nested estimator with every parameter of interest returns the EVPI"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000039 hemo:6002836 ;
    rheo:2000001 2.0 .

