    hemo:1000008 hemo:6000009 ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 true ;
    hemo:9000008 "Maps an effectiveness-ordered set of non-dominated alternatives to sequential incremental cost-effectiveness ratios." ;
    hemo:9000009 "Fully incremental cost-effectiveness function" ;
    hemo:9000014 "g(C_i,E_i) = ICER_i" ;
