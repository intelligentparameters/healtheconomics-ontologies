hemo:5000887 a owl:NamedIndividual,
        hemo:0000010 ;
    rdfs:label "Catastrophic health spending share, flag and amount in international dollars"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Gives the share of a household's consumption spent out of pocket on health, whether it exceeds a threshold share, and the out-of-pocket amount converted to international dollars."@en ;
    obo:IAO_0000116 "A HEMO-native record, for a formula the Functions and Formulae module does not yet hold. It is listed in module-backlog.md for the module curator."@en,
        "Wagstaff et al. 2018 define catastrophic spending as out-of-pocket spending above 10% or 25% of household consumption. Turner et al. 2019 support the conversion to international dollars only. The factor e is international dollars per unit of local currency, the reciprocal of the purchasing power parity factor of HE-FM-BOC-002."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Wagstaff et al. 2018; Turner et al. 2019" ;
    dcterms:identifier "HEMO-FM-CHE-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6003671,
        hemo:6003672,
        hemo:6003673,
        hemo:6003674,
        hemo:6003675,
        hemo:6003676,
        hemo:6003677 ;
    hemo:1000007 hemo:6003672,
        hemo:6003673,
        hemo:6003675,
        hemo:6003677 ;
    hemo:1000008 hemo:6003674,
        hemo:6003676 ;
    hemo:1000009 hemo:7005963 ;
    hemo:1000010 hemo:7006057 ;
    hemo:1000011 hemo:8001217 ;
    hemo:1000018 hemo:8001199,
        hemo:8001205,
        hemo:8001211 ;
    hemo:1000035 hemo:4000017 ;
    hemo:2000019 true ;
    hemo:9000003 "rheo 0.3.0 cq19-catastrophic-spending.rq" ;
    hemo:9000014 "share = OOP / X; flag = (share > z); OOP_int = OOP * e" ;
    hemo:9000015 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><apply><csymbol cd=\"logic1\">and</csymbol><apply><csymbol cd=\"relation1\">eq</csymbol><ci>share</ci><apply><csymbol cd=\"arith1\">divide</csymbol><ci>OOP</ci><ci>X</ci></apply></apply><apply><csymbol cd=\"relation1\">eq</csymbol><ci>flag</ci><apply><csymbol cd=\"relation1\">gt</csymbol><ci>share</ci><ci>z</ci></apply></apply><apply><csymbol cd=\"relation1\">eq</csymbol><ci>OOP_int</ci><apply><csymbol cd=\"arith1\">times</csymbol><ci>OOP</ci><ci>e</ci></apply></apply></apply></math>" ;
    hemo:9000016 "\\mathrm{share} = \\frac{\\mathrm{OOP}}{X} ;\\quad \\mathrm{flag} = \\mathrm{share} > z ;\\quad \\mathrm{OOP}_{\\mathrm{int}} = \\mathrm{OOP} \\, e" ;
    hemo:9000018 "HEMO-FM-CHE-001" .

hemo:5000889 a owl:NamedIndividual,
        hemo:0000010 ;
    rdfs:label "Gross cost per quitter of a stop smoking service"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Gives the cost of a stop smoking service divided by the number of its clients who quit."@en ;
    obo:IAO_0000116 "A HEMO-native record, for a formula the Functions and Formulae module does not yet hold. It is listed in module-backlog.md for the module curator."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Drummond et al. 2015" ;
    dcterms:identifier "HEMO-FM-CPQ-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6003682,
        hemo:6003683,
        hemo:6003684 ;
    hemo:1000007 hemo:6003683,
        hemo:6003684 ;
    hemo:1000008 hemo:6003682 ;
    hemo:1000009 hemo:7005965 ;
    hemo:1000010 hemo:7006070 ;
    hemo:1000011 hemo:8001249 ;
    hemo:1000018 hemo:8001243 ;
    hemo:1000035 hemo:4000017 ;
    hemo:2000019 true ;
    hemo:9000003 "rheo 0.3.0 cq24-cost-per-quitter.rq" ;
    hemo:9000014 "c_q = C / Q" ;
    hemo:9000015 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><apply><csymbol cd=\"relation1\">eq</csymbol><ci>c_q</ci><apply><csymbol cd=\"arith1\">divide</csymbol><ci>C</ci><ci>Q</ci></apply></apply></math>" ;
    hemo:9000016 "c_{q} = \\frac{C}{Q}" ;
    hemo:9000018 "HEMO-FM-CPQ-001" .

hemo:5000891 a owl:NamedIndividual,
        hemo:0000010 ;
    rdfs:label "Donor funding share of programme spending"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Gives the share of a programme's spending covered by donor grants earmarked for it, with the spending converted to the grants' currency."@en ;
    obo:IAO_0000116 "A HEMO-native record, for a formula the Functions and Formulae module does not yet hold. It is listed in module-backlog.md for the module curator."@en,
        "The donor share is defined as RHEO competency query cq28 computes it. Turner et al. 2019 support the currency conversion step only."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "RHEO 0.4.0 competency query cq28-donor-funding-share; Turner et al. 2019" ;
    dcterms:identifier "HEMO-FM-DONOR-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6003692,
        hemo:6003693,
        hemo:6003694,
        hemo:6003695 ;
    hemo:1000007 hemo:6003693,
        hemo:6003694,
        hemo:6003695 ;
    hemo:1000008 hemo:6003692 ;
    hemo:1000009 hemo:7005967 ;
    hemo:1000010 hemo:7006082 ;
    hemo:1000011 hemo:8001285 ;
    hemo:1000018 hemo:8001277 ;
    hemo:1000035 hemo:4000017 ;
    hemo:2000019 true ;
    hemo:9000003 "rheo 0.3.0 cq28-donor-funding-share.rq" ;
    hemo:9000014 "s = G / (S * e)" ;
    hemo:9000015 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><apply><csymbol cd=\"relation1\">eq</csymbol><ci>s</ci><apply><csymbol cd=\"arith1\">divide</csymbol><ci>G</ci><apply><csymbol cd=\"arith1\">times</csymbol><ci>S</ci><ci>e</ci></apply></apply></apply></math>" ;
    hemo:9000016 "s = \\frac{G}{S \\, e}" ;
    hemo:9000018 "HEMO-FM-DONOR-001" .

hemo:5000892 a owl:NamedIndividual,
        hemo:0000010 ;
    rdfs:label "Vaccine wastage rate and cost of wasted doses"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Gives the share of doses used up that were wasted, the wasted doses over those given plus those wasted, and the cost of the wasted doses at a unit cost per dose."@en ;
    obo:IAO_0000116 "A HEMO-native record, for a formula the Functions and Formulae module does not yet hold. It is listed in module-backlog.md for the module curator."@en,
        "The wastage rate is defined as RHEO competency query cq33 computes it. A WHO source on vaccine wastage is for the curator to add."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "RHEO 0.4.0 competency query cq33-vaccine-wastage" ;
    dcterms:identifier "HEMO-FM-WASTE-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6003696,
        hemo:6003697,
        hemo:6003698,
        hemo:6003699,
        hemo:6003700 ;
    hemo:1000007 hemo:6003697,
        hemo:6003698,
        hemo:6003700 ;
    hemo:1000008 hemo:6003696,
        hemo:6003699 ;
    hemo:1000009 hemo:7005968 ;
    hemo:1000010 hemo:7006087 ;
    hemo:1000011 hemo:8001304 ;
    hemo:1000018 hemo:8001290,
        hemo:8001298 ;
    hemo:1000035 hemo:4000017 ;
    hemo:2000019 true ;
    hemo:9000003 "rheo 0.3.0 cq33-vaccine-wastage.rq" ;
    hemo:9000014 "w = W / (A + W); C_w = W * c" ;
    hemo:9000015 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><apply><csymbol cd=\"logic1\">and</csymbol><apply><csymbol cd=\"relation1\">eq</csymbol><ci>w</ci><apply><csymbol cd=\"arith1\">divide</csymbol><ci>W</ci><apply><csymbol cd=\"arith1\">plus</csymbol><ci>A</ci><ci>W</ci></apply></apply></apply><apply><csymbol cd=\"relation1\">eq</csymbol><ci>C_w</ci><apply><csymbol cd=\"arith1\">times</csymbol><ci>W</ci><ci>c</ci></apply></apply></apply></math>" ;
    hemo:9000016 "w = \\frac{W}{A + W} ;\\quad C_{w} = W \\, c" ;
    hemo:9000018 "HEMO-FM-WASTE-001" .

hemo:5000001 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Cohort state-transition function"@en ;
    dcterms:identifier "HE-FN-MM-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 false ;
    hemo:9000008 "Maps a cohort's current state distribution and transition probabilities to its state distribution in the next model cycle." ;
    hemo:9000009 "Cohort state-transition function" ;
    hemo:9000014 "f(s_t, P_t) = s_t P_t" ;
    hemo:9000018 "HE-FN-MM-001" ;
    hemo:9000023 "cohort-state-transition-function" .

