hemo:7001979 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Late-entry loading paid for a limited period of cover"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "In both countries the loading stops after 10 years of cover, in Australia 10 years of continuous hospital cover. The formula gives the premium during that period, not over a lifetime." ;
    hemo:9000009 "Late-entry loading paid for a limited period of cover" ;
    hemo:9000018 "HE-AS-CRAT-008" ;
    hemo:9000023 "late-entry-loading-paid-for-a-limited-period-of-cover" .

hemo:7001980 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Counted years follow each scheme's own rules"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "y follows the scheme's counting rules, including credit for earlier periods of cover and permitted absences, which the formula does not model. Ireland counts years from age 35, and Australia counts years over 30 based on age on the 1 July before joining." ;
    hemo:9000009 "Counted years follow each scheme's own rules" ;
    hemo:9000018 "HE-AS-CRAT-009" ;
    hemo:9000023 "counted-years-follow-each-scheme-s-own-rules" .

hemo:7001981 a owl:NamedIndividual,
        hemo:0000014 ;
    rdfs:label "Late-entry loading and loaded premium in two Excel cells"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000004 hemo:5000437 ;
    hemo:1000040 hemo:4000019 ;
    hemo:9000008 "With the rate per year in LoadRate, the counted years in YearsWithoutCover, the cap in MaxLoading and the premium before loading in BasePremium, the first formula returns the loading and the second the loaded premium." ;
    hemo:9000009 "Late-entry loading and loaded premium in two Excel cells" ;
    hemo:9000018 "HE-IM-CRAT-004" ;
    hemo:9000023 "late-entry-loading-and-loaded-premium-in-two-excel-cells" ;
    hemo:9000024 "=MIN(LoadRate*YearsWithoutCover,MaxLoading); =BasePremium*(1+MIN(LoadRate*YearsWithoutCover,MaxLoading))" .

hemo:7001982 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Late-entry loading never exceeds the cap"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000009 ;
    hemo:9000008 "Enter 41 counted years in YearsWithoutCover, which would give 82% without the cap. The computed loading in the cell named Loading must then equal the cap and not exceed it. Expected result: TRUE. FALSE shows that the cap is missing from the loading formula." ;
    hemo:9000009 "Late-entry loading never exceeds the cap" ;
    hemo:9000018 "HE-VT-CRAT-008" ;
    hemo:9000023 "late-entry-loading-never-exceeds-the-cap" ;
    hemo:9000024 "=AND(Loading<=MaxLoading,ABS(Loading-MaxLoading)<1E-9)" .

hemo:7001983 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Irish late-entry loading for a first purchase at 49"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000009 ;
    hemo:9000008 "The Health Insurance Authority's second example counts 15 years and gives 30%. Expected result: TRUE." ;
    hemo:9000009 "Irish late-entry loading for a first purchase at 49" ;
    hemo:9000018 "HE-VT-CRAT-009" ;
    hemo:9000023 "irish-late-entry-loading-for-a-first-purchase-at-49" ;
    hemo:9000024 "=ROUND(MIN(0.02*15,0.7),2)=0.3" .

hemo:7001984 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Late-entry loading reaches the cap at 35 counted years"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000009 ;
    hemo:9000008 "Thirty-five counted years give exactly 70%, which the Health Insurance Authority states applies to people aged 69 or above buying cover for the first time. Expected result: TRUE." ;
    hemo:9000009 "Late-entry loading reaches the cap at 35 counted years" ;
    hemo:9000018 "HE-VT-CRAT-010" ;
    hemo:9000023 "late-entry-loading-reaches-the-cap-at-35-counted-years" ;
    hemo:9000024 "=ROUND(MIN(0.02*35,0.7),2)=0.7" .

hemo:7001985 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Irish late-entry loading for a person first insured at 45"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000007 ;
