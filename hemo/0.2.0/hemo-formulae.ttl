    hemo:1000017 hemo:8000931 ;
    hemo:2000007 1 ;
    hemo:9000014 "DF_t = (1 + r_1)^(-min(t, y_1)) * (1 + r_2)^(-max(min(t, y_2) - y_1, 0)) * (1 + r_3)^(-max(t - y_2, 0))" ;
    hemo:9000015 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><apply><csymbol cd=\"relation1\">eq</csymbol><ci>DF_t</ci><apply><csymbol cd=\"arith1\">times</csymbol><apply><csymbol cd=\"arith1\">power</csymbol><apply><csymbol cd=\"arith1\">plus</csymbol><cn type=\"integer\">1</cn><ci>r_1</ci></apply><apply><csymbol cd=\"arith1\">unary_minus</csymbol><apply><csymbol cd=\"minmax1\">min</csymbol><apply><csymbol cd=\"set1\">set</csymbol><ci>t</ci><ci>y_1</ci></apply></apply></apply></apply><apply><csymbol cd=\"arith1\">power</csymbol><apply><csymbol cd=\"arith1\">plus</csymbol><cn type=\"integer\">1</cn><ci>r_2</ci></apply><apply><csymbol cd=\"arith1\">unary_minus</csymbol><apply><csymbol cd=\"minmax1\">max</csymbol><apply><csymbol cd=\"set1\">set</csymbol><apply><csymbol cd=\"arith1\">minus</csymbol><apply><csymbol cd=\"minmax1\">min</csymbol><apply><csymbol cd=\"set1\">set</csymbol><ci>t</ci><ci>y_2</ci></apply></apply><ci>y_1</ci></apply><cn type=\"integer\">0</cn></apply></apply></apply></apply><apply><csymbol cd=\"arith1\">power</csymbol><apply><csymbol cd=\"arith1\">plus</csymbol><cn type=\"integer\">1</cn><ci>r_3</ci></apply><apply><csymbol cd=\"arith1\">unary_minus</csymbol><apply><csymbol cd=\"minmax1\">max</csymbol><apply><csymbol cd=\"set1\">set</csymbol><apply><csymbol cd=\"arith1\">minus</csymbol><ci>t</ci><ci>y_2</ci></apply><cn type=\"integer\">0</cn></apply></apply></apply></apply></apply></apply></math>" ;
    hemo:9000016 "\\mathrm{DF}_{t} = \\left(1 + r_{1}\\right)^{-\\min\\left(t, y_{1}\\right)} \\, \\left(1 + r_{2}\\right)^{-\\max\\left(\\min\\left(t, y_{2}\\right) - y_{1}, 0\\right)} \\, \\left(1 + r_{3}\\right)^{-\\max\\left(t - y_{2}, 0\\right)}" .

