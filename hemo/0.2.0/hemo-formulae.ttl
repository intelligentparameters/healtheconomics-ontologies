hemo:7003468 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Article's 0.8 QALYs a year as an even flow discounted at 3.5 per cent"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000007 ;
    hemo:1000037 hemo:7003469,
        hemo:7003470,
        hemo:7003471 ;
    hemo:1000038 hemo:7003472,
        hemo:7003473 ;
    hemo:2000008 0.00005 ;
    hemo:9000008 "Treating the article's gain as an even flow over 30 years gives about 14.97 discounted QALYs, between 14.71 for end-of-year and 15.23 for start-of-year counting (computed here for illustration)." ;
    hemo:9000009 "Article's 0.8 QALYs a year as an even flow discounted at 3.5 per cent" ;
    hemo:9000014 "r = 0.035; q = 0.8; T = 30; rho = 0.0344; Q_c = 14.9696" ;
    hemo:9000018 "HE-EX-DISC-007" ;
    hemo:9000023 "article-s-0-8-qalys-a-year-as-an-even-flow-discounted-at-3-5-per-cent" .

hemo:7003469 a owl:NamedIndividual,
        hemo:0000016 ;
    rdfs:label "r in the test Article's 0.8 QALYs a year as an even flow discounted at 3.5 per cent"@en ;
