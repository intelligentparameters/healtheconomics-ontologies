hemo:7001991 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Expected profits cancel when the payment equals the payment cell's average cost"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000010 ;
    hemo:9000008 "In the article's example the £5,000 payment equals the average expected cost of 70-year-olds, so the expected profits of the two types, weighted by their shares of 70% and 30%, sum to zero. Expected result: TRUE." ;
    hemo:9000009 "Expected profits cancel when the payment equals the payment cell's average cost" ;
    hemo:9000018 "HE-VT-CSKM-001" ;
    hemo:9000023 "expected-profits-cancel-when-the-payment-equals-the-payment-cell-s-average-cost" ;
