        hemo:6003664,
        hemo:6003665,
        hemo:6003666 ;
    hemo:1000007 hemo:6003661,
        hemo:6003662,
        hemo:6003663,
        hemo:6003664,
        hemo:6003665,
        hemo:6003666 ;
    hemo:1000008 hemo:6003660 ;
    hemo:1000009 hemo:7005961 ;
    hemo:1000010 hemo:7006040,
        hemo:7006048 ;
    hemo:1000011 hemo:8001173 ;
    hemo:1000018 hemo:8001159 ;
    hemo:1000035 hemo:4000017 ;
    hemo:2000019 true ;
    hemo:9000001 heao:0000096,
        heao:0000097,
        heao:0000098 ;
    hemo:9000004 "HEMO-HOOK-29" ;
    hemo:9000014 "V = w_1 * v_1 + w_2 * v_2 + w_3 * v_3" ;
    hemo:9000015 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><apply><csymbol cd=\"relation1\">eq</csymbol><ci>V</ci><apply><csymbol cd=\"arith1\">plus</csymbol><apply><csymbol cd=\"arith1\">times</csymbol><ci>w_1</ci><ci>v_1</ci></apply><apply><csymbol cd=\"arith1\">times</csymbol><ci>w_2</ci><ci>v_2</ci></apply><apply><csymbol cd=\"arith1\">times</csymbol><ci>w_3</ci><ci>v_3</ci></apply></apply></apply></math>" ;
    hemo:9000016 "V = w_{1} \\, v_{1} + w_{2} \\, v_{2} + w_{3} \\, v_{3}" ;
