[] a owl:Axiom ;
    rdfs:comment "The relative risk of progression carries the claim that Intervention X lowers progression. RHEO holds it as a relative effect estimate."@en ;
    owl:annotatedProperty hemo:9000012 ;
    owl:annotatedSource hemo:6003708 ;
    owl:annotatedTarget rheo:0000018 ;
    heao:9000001 heao:4000002 .

[] a owl:Axiom ;
    rdfs:comment "A relative risk applied to a baseline probability carries the causal claim that the intervention changes the risk. RHEO holds that claim as a relative effect estimate."@en ;
    owl:annotatedProperty hemo:9000012 ;
    owl:annotatedSource hemo:6000727 ;
    owl:annotatedTarget rheo:0000018 ;
    heao:9000001 heao:4000002 .

[] a owl:Axiom ;
    rdfs:comment "The parameter epsilon of the Atkinson equally distributed equivalent is the HEAO relative inequality aversion parameter (HEMO-HOOK-15)."@en ;
    owl:annotatedProperty hemo:9000001 ;
    owl:annotatedSource hemo:5000293 ;
    owl:annotatedTarget heao:0000105 ;
    heao:9000001 heao:4000003 .

[] a owl:Axiom ;
    rdfs:comment "The two shortfalls select the severity weight."@en ;
    owl:annotatedProperty hemo:1000031 ;
    owl:annotatedSource hemo:5000238 ;
    owl:annotatedTarget hemo:5000240 .

