    hemo:9000014 "EVPI = sum_(s=1)^S [NBmax_s_(s)] / S - ENB_cur" ;
    hemo:9000015 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><apply><csymbol cd=\"relation1\">eq</csymbol><ci>EVPI</ci><apply><csymbol cd=\"arith1\">minus</csymbol><apply><csymbol cd=\"arith1\">divide</csymbol><apply><csymbol cd=\"arith1\">sum</csymbol><apply><csymbol cd=\"interval1\">integer_interval</csymbol><cn type=\"integer\">1</cn><ci>S</ci></apply><bind><csymbol cd=\"fns1\">lambda</csymbol><bvar><ci>s</ci></bvar><apply><csymbol cd=\"hemo1\" cdbase=\"https://healtheconomics.wiki/ontologies/hemo/cd\">element</csymbol><ci>NBmax_s</ci><ci>s</ci></apply></bind></apply><ci>S</ci></apply><ci>ENB_cur</ci></apply></apply></math>" ;
