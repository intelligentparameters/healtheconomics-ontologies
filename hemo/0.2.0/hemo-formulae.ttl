hemo:7000298 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Five draws of a two-option model"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000007 ;
    hemo:1000037 hemo:7000299,
        hemo:7000300,
        hemo:7000301 ;
    hemo:1000038 hemo:7000302 ;
    hemo:2000008 0.5 ;
    hemo:9000008 "In the five illustrative draws on the expected net benefit page, the highest net benefits are £138,000, £134,000, £142,000, £136,000 and £147,500, with a mean of £139,500. Treatment B is chosen on current information with expected net benefit £137,700, so EVPI is £1,800 per patient, the same as the mean loss from choosing B in the three draws where A is better." ;
    hemo:9000009 "Five draws of a two-option model" ;
    hemo:9000014 "S = 5; NBmax_s = [138000,134000,142000,136000,147500]; ENB_cur = 137700; EVPI = 1800" ;
    hemo:9000018 "HE-EX-VOI-002" ;
    hemo:9000023 "five-draws-of-a-two-option-model" .

hemo:7000299 a owl:NamedIndividual,
        hemo:0000016 ;
