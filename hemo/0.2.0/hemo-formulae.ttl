hemo:7004399 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Basket price already in the home currency"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000007 ;
    hemo:1000037 hemo:7004400,
        hemo:7004401 ;
    hemo:1000038 hemo:7004402 ;
    hemo:2000008 0.5 ;
    hemo:9000008 "When a basket price is already expressed in the home currency, as in the article's worked example, the rate is 1 and the converted price equals the observed price, a limiting case that checks an implementation." ;
    hemo:9000009 "Basket price already in the home currency" ;
    hemo:9000014 "p_i = 95; e_i = 1; c_i = 95" ;
    hemo:9000018 "HE-EX-BOC-003" ;
    hemo:9000023 "basket-price-already-in-the-home-currency" .

hemo:7004400 a owl:NamedIndividual,
        hemo:0000016 ;
