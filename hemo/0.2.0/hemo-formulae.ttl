hemo:7001992 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Expected profit plus expected cost returns the payment for one member"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000010 ;
    hemo:9000008 "Adding the expected cost back to the expected profit recovers the payment. Expected result: TRUE." ;
    hemo:9000009 "Expected profit plus expected cost returns the payment for one member" ;
    hemo:9000018 "HE-VT-CSKM-002" ;
    hemo:9000023 "expected-profit-plus-expected-cost-returns-the-payment-for-one-member" ;
    hemo:9000024 "=ABS(ExpectedProfit+ExpectedCost-Payment)<1E-9" .

hemo:7001993 a owl:NamedIndividual,
        hemo:0000015 ;
