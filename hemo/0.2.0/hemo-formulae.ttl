hemo:7004401 a owl:NamedIndividual,
        hemo:0000016 ;
    rdfs:label "e_i in the test Basket price already in the home currency"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
