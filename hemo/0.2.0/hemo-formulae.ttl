hemo:7001997 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Same payment for every member of the payment cell"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "The payment formula does not distinguish the risk groups in the sum, for example because it adjusts for age but not for chronic disease. Groups that the formula does distinguish are treated as separate payment cells." ;
    hemo:9000009 "Same payment for every member of the payment cell" ;
    hemo:9000018 "HE-AS-CSKM-003" ;
