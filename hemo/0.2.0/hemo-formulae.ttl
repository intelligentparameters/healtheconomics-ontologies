hemo:7000559 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Absolute shortfall decides the weight"@en ;
    obo:IAO_0000116 "The cut-offs 12 and 18 QALYs and 0.85 and 0.95, and the weights 1.2 and 1.7, are those of NICE PMG36 (last updated 13 October 2026) table 6.1, added by HEMO as inputs."@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
