hemo:5000005 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Monetised cost-benefit comparison function"@en ;
    dcterms:identifier "HE-FN-CBA-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6000013,
        hemo:6000014,
        hemo:6000015,
        hemo:6000016 ;
    hemo:1000007 hemo:6000013,
        hemo:6000014 ;
    hemo:1000008 hemo:6000015,
        hemo:6000016 ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 true ;
    hemo:9000008 "Maps the present values of monetised benefits and resource costs to measures of net social value and relative return." ;
    hemo:9000009 "Monetised cost-benefit comparison function" ;
    hemo:9000014 "k(PV_B,PV_C) = (NPV,BCR)" ;
    hemo:9000018 "HE-FN-CBA-001" ;
    hemo:9000023 "monetised-cost-benefit-comparison-function" .

hemo:5000007 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Budget-change function"@en ;
    dcterms:identifier "HE-FN-BIA-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6000017,
        hemo:6000018,
        hemo:6000019,
        hemo:6000020 ;
    hemo:1000007 hemo:6000017,
        hemo:6000018 ;
    hemo:1000008 hemo:6000019,
        hemo:6000020 ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 true ;
    hemo:9000008 "Maps reference- and adoption-scenario expenditure to periodic and cumulative changes in spending for a specified budget holder." ;
    hemo:9000009 "Budget-change function" ;
    hemo:9000014 "b(E_A_t,E_R_t) = (BI_t,CBI_T)" ;
    hemo:9000018 "HE-FN-BIA-001" ;
    hemo:9000023 "budget-change-function" .

hemo:5000009 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Mixed-comparator construction function"@en ;
    dcterms:identifier "HE-FN-COMP-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6000021,
        hemo:6000022,
        hemo:6000023,
        hemo:6000024,
        hemo:6000025 ;
    hemo:1000007 hemo:6000021,
        hemo:6000022,
        hemo:6000023 ;
    hemo:1000008 hemo:6000024,
        hemo:6000025 ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 true ;
    hemo:9000008 "Maps the treatment shares and expected results of current-care options to a weighted mixed comparator." ;
    hemo:9000009 "Mixed-comparator construction function" ;
    hemo:9000014 "q(w_j,C_j,E_j) = (C_mix,E_mix)" ;
    hemo:9000018 "HE-FN-COMP-001" ;
    hemo:9000023 "mixed-comparator-construction-function" .

hemo:5000012 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Quality-adjusted survival function"@en ;
    dcterms:identifier "HE-FN-QALY-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6000035,
        hemo:6000036,
        hemo:6000037 ;
    hemo:1000007 hemo:6000035,
        hemo:6000036 ;
    hemo:1000008 hemo:6000037 ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 true ;
    hemo:9000008 "Maps a profile of health-state utility over time to quality-adjusted life years, the area under the utility-over-time curve." ;
    hemo:9000009 "Quality-adjusted survival function" ;
    hemo:9000014 "Q(u_t,d_t) = QALY" ;
    hemo:9000018 "HE-FN-QALY-001" ;
    hemo:9000023 "quality-adjusted-survival-function" .

hemo:5000014 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Dominance classification function"@en ;
    dcterms:identifier "HE-FN-DOM-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6000042,
        hemo:6000043,
        hemo:6000044 ;
    hemo:1000007 hemo:6000042,
        hemo:6000043 ;
    hemo:1000008 hemo:6000044 ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 true ;
    hemo:9000008 "Maps the expected costs and expected health effects of mutually exclusive options to a classification of which options are dominated, a result that holds at every non-negative cost-effectiveness threshold." ;
    hemo:9000009 "Dominance classification function" ;
    hemo:9000014 "s(C_j,E_j) = DOM_j" ;
    hemo:9000018 "HE-FN-DOM-001" ;
    hemo:9000023 "dominance-classification-function" .

hemo:5000015 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Extended dominance function"@en ;
    dcterms:identifier "HE-FN-EXD-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6000045,
        hemo:6000046,
        hemo:6000047 ;
    hemo:1000007 hemo:6000045,
        hemo:6000046 ;
    hemo:1000008 hemo:6000047 ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 true ;
    hemo:9000008 "Maps the expected costs and effects of options that survive the dominance screen, ordered by effect, to a flag for each intermediate option that a blend of its neighbours would beat." ;
    hemo:9000009 "Extended dominance function" ;
    hemo:9000014 "x(C_j,E_j) = EXD_j" ;
    hemo:9000018 "HE-FN-EXD-001" ;
    hemo:9000023 "extended-dominance-function" .

hemo:5000017 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Expected net benefit function"@en ;
    dcterms:identifier "HE-FN-ENB-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 false ;
    hemo:9000008 "Maps the joint distribution of an option's uncertain costs and health effects, and a threshold, to the mean of its net benefit. The option with the highest expected net benefit is the one to adopt on current evidence, and the same quantity is the baseline for value of information analysis." ;
    hemo:9000009 "Expected net benefit function" ;
    hemo:9000014 "e(lambda,C_j(theta),E_j(theta)) = ENB_j" ;
    hemo:9000018 "HE-FN-ENB-001" ;
    hemo:9000023 "expected-net-benefit-function" .

hemo:5000019 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "One-way sensitivity function"@en ;
    dcterms:identifier "HE-FN-OWSA-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 false ;
    hemo:9000008 "Maps a model output to its value when a single input j is set to a stated value while every other input stays at its base-case value. Running it at the input's lower and upper values gives the endpoints of one bar in a tornado diagram." ;
    hemo:9000009 "One-way sensitivity function" ;
    hemo:9000014 "f(theta_j,theta0_(-j)) = Y_j" ;
    hemo:9000018 "HE-FN-OWSA-001" ;
    hemo:9000023 "one-way-sensitivity-function" .

hemo:5000020 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Supply-side threshold function"@en ;
    dcterms:identifier "HE-FN-CET-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6000052,
        hemo:6000053,
        hemo:6000054 ;
    hemo:1000007 hemo:6000052,
        hemo:6000053 ;
    hemo:1000008 hemo:6000054 ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 true ;
    hemo:9000008 "Maps a change in health-care expenditure under a fixed budget, and the change in population health that results, to the cost at which the health system gains or loses one unit of health at the margin. This is the opportunity-cost basis of the threshold, distinct from a demand-side value placed on health." ;
    hemo:9000009 "Supply-side threshold function" ;
    hemo:9000014 "s(Delta_B,Delta_H) = k" ;
    hemo:9000018 "HE-FN-CET-001" ;
    hemo:9000023 "supply-side-threshold-function" .

hemo:5000025 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Absorbing Markov chain function"@en ;
    dcterms:identifier "HE-FN-ABS-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 false ;
    hemo:9000008 "A state k is absorbing when p_kk = 1 and p_kj = 0 for every other state j, so no one who enters it can leave. Ordering the transient states first writes the transition matrix in canonical form, with Q the transitions among transient states, R the transitions from transient to absorbing states, a zero block and an identity block for the absorbing states. From Q and R the expected time before absorption and the probability of ending in each absorbing state follow without running the cohort trace s_(t+1) = s_t P." ;
    hemo:9000009 "Absorbing Markov chain function" ;
    hemo:9000014 "P = [[Q,R],[0,I]]" ;
    hemo:9000018 "HE-FN-ABS-001" ;
    hemo:9000023 "absorbing-markov-chain-function" .

hemo:5000033 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Willingness-to-pay estimation function"@en ;
    dcterms:identifier "HE-FN-WTP-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6000075,
        hemo:6000076 ;
    hemo:1000007 hemo:6000075 ;
    hemo:1000008 hemo:6000076 ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 true ;
    hemo:9000008 "Maps stated or modelled preferences for a change in health or health care to a sum of money: the marginal value of an attribute from the coefficients of a discrete choice model, or the mean of individual valuations from a contingent valuation survey, scaled to the affected population. Aggregate WTP is the monetary benefit that cost-benefit analysis sets against the present value of costs." ;
    hemo:9000009 "Willingness-to-pay estimation function" ;
    hemo:9000014 "w(preferences) = WTP" ;
    hemo:9000018 "HE-FN-WTP-001" ;
    hemo:9000023 "willingness-to-pay-estimation-function" .

hemo:5000035 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Social marginal cost and benefit function"@en ;
    dcterms:identifier "HE-FN-EXT-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6000083,
        hemo:6000084,
        hemo:6000085,
        hemo:6000086,
        hemo:6000087,
        hemo:6000088 ;
    hemo:1000007 hemo:6000083,
        hemo:6000084,
        hemo:6000085,
        hemo:6000086 ;
    hemo:1000008 hemo:6000087,
        hemo:6000088 ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 true ;
    hemo:9000008 "Adds the marginal effect that an activity has on third parties to the marginal cost or benefit that the decision-maker weighs, giving the marginal social cost or benefit. The efficient quantity is where marginal social benefit equals marginal social cost; a private decision that ignores the external term stops at a different quantity, and a Pigouvian tax or subsidy set at the marginal external effect at the efficient quantity closes the gap." ;
    hemo:9000009 "Social marginal cost and benefit function" ;
    hemo:9000014 "s(MPC,MEC,MPB,MEB) = (MSC,MSB)" ;
    hemo:9000018 "HE-FN-EXT-001" ;
    hemo:9000023 "social-marginal-cost-and-benefit-function" .

hemo:5000037 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Health capital accumulation and investment function"@en ;
    dcterms:identifier "HE-FN-DFH-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 false ;
    hemo:9000008 "In the Grossman model health is a durable capital stock that produces healthy time. The stock carried into the next period is the current stock less depreciation plus gross investment, which the individual produces with medical care and own time. The optimal stock in each period equates the marginal return on health capital with its user cost, the real rate of interest plus the rate of depreciation." ;
    hemo:9000009 "Health capital accumulation and investment function" ;
    hemo:9000014 "H_(t+1) = f(H_t, delta_t, I_t)" ;
    hemo:9000018 "HE-FN-DFH-001" ;
    hemo:9000023 "health-capital-accumulation-and-investment-function" .

hemo:5000053 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Average cost-effectiveness ratio function"@en ;
    dcterms:identifier "HE-FN-ACER-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6000114,
        hemo:6000115,
        hemo:6000116 ;
    hemo:1000007 hemo:6000114,
        hemo:6000115 ;
    hemo:1000008 hemo:6000116 ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 true ;
    hemo:9000008 "Maps the expected cost and expected health effect of one option, either in total or measured against a do-nothing baseline, to its cost per unit of health effect without reference to any competing option. Choices between mutually exclusive options rest instead on the pairwise ICER (HE-FM-ICER-001) and on net monetary benefit (HE-FM-NMB-001), which use the same cost and effect notation." ;
    hemo:9000009 "Average cost-effectiveness ratio function" ;
    hemo:9000014 "a(C_i,E_i) = ACER_i" ;
    hemo:9000018 "HE-FN-ACER-001" ;
    hemo:9000023 "average-cost-effectiveness-ratio-function" .

hemo:5000081 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Chance node evaluation in a decision tree"@en ;
    dcterms:identifier "HE-FN-CHN-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 false ;
    hemo:9000008 "Maps the branches leaving a chance node, each with a probability conditional on the pathway that leads to the node and a cost and health outcome at its end, to the expected cost and expected health outcome at the node. It also maps the chain of conditional branch probabilities along a pathway to the probability of reaching the terminal node at its end. The branch probabilities at every chance node sum to one. Strategies are compared only after the tree has been evaluated, with the ICER formula HE-FM-ICER-001 or net monetary benefit HE-FM-NMB-001, which are not restated here. Rolling back a whole tree from the terminal nodes to the first decision is covered on the Folding Back page; the formulae below work at the level of one node or one pathway." ;
    hemo:9000009 "Chance node evaluation in a decision tree" ;
    hemo:9000014 "sum_(j=1)^k p_(j|h) = 1; C_n = sum_j p_j C_j, E_n = sum_j p_j E_j; pi_t = p_1 * p_(2|1) * ... * p_(m|1,...,m-1)" ;
    hemo:9000018 "HE-FN-CHN-001" ;
    hemo:9000023 "chance-node-evaluation-in-a-decision-tree" .

hemo:5000083 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Cohen's d standardisation and re-expression"@en ;
    dcterms:identifier "HE-FN-CD-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 false ;
    hemo:9000008 "Maps a difference between two group means on a continuous outcome to standard deviation units, so that trials which measured the same construct on different instruments can be compared and pooled, and maps a standardised difference back to a quantity a decision model can use, here a log odds ratio for responding. A confidence interval for the standardised difference is the large-sample interval HE-FM-AN-001 applied with its standard error, and a comparator response probability combined with an odds ratio gives the intervention probability by HE-FM-NMA-004; neither is restated here. Hedges' small-sample correction and its standard error belong on the Hedges' g page." ;
    hemo:9000009 "Cohen's d standardisation and re-expression" ;
    hemo:9000014 "d = (xbar_1 - xbar_2) / s_p; lnOR = (pi / sqrt(3)) * d" ;
    hemo:9000018 "HE-FN-CD-001" ;
    hemo:9000023 "cohen-s-d-standardisation-and-re-expression" .

hemo:5000088 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Begg and Mazumdar adjusted rank correlation test function for small-study effects"@en ;
    dcterms:identifier "HE-FN-BEGG-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 false ;
    hemo:9000008 "Maps the effect estimates of K studies in a meta-analysis, on an approximately normal scale such as log hazard ratios, and their within-study variances to the Begg test. Each estimate is standardised against the inverse-variance pooled estimate, and Kendall's rank correlation between the standardised effects and the variances is tested against zero. A significant correlation signals funnel plot asymmetry, a small-study effect, but not its cause: non-reporting of small studies, flawed small trials, genuinely different patients in small trials, artefact and chance can all produce it. The records follow the notation of the Begg Test article. The pooled estimate itself is the common-effect estimate HE-FM-ADMA-001." ;
    hemo:9000009 "Begg and Mazumdar adjusted rank correlation test function for small-study effects" ;
    hemo:9000014 "(tau, Z) = f(C, D, K); t_j = g(theta_j, v_j, theta_IV, W)" ;
    hemo:9000018 "HE-FN-BEGG-001" ;
    hemo:9000023 "begg-and-mazumdar-adjusted-rank-correlation-test-function-for-small-study-effects" .

hemo:5000089 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Break-even price, cost-neutral price and service volume function"@en ;
    dcterms:identifier "HE-FN-BEA-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 false ;
    hemo:9000008 "Solves for the value of one input at which a decision criterion is exactly zero, holding every other input at its base-case value. For a new health technology the input is the unit price and the criterion is incremental net monetary benefit at a stated threshold (the break-even price) or incremental cost alone (the cost-neutral price). For a service paid per unit of activity the input is volume and the criterion is the surplus of income over fixed and variable costs (the break-even volume). The records follow the notation of the Break-Even Analysis article. NICE's manual (PMG36) calls the general calculation threshold analysis and its result a switching value; the switching value of a non-linear input by interpolation is HE-FM-OWSA-002, and the payer's maximum price per patient in price negotiation is HE-FM-BARG-002." ;
    hemo:9000009 "Break-even price, cost-neutral price and service volume function" ;
    hemo:9000014 "p_star = f(lambda, Delta_E, Delta_C_0, u); p_0 = g(Delta_C_0, u); Q_star = h(F, P, V)" ;
    hemo:9000018 "HE-FN-BEA-001" ;
    hemo:9000023 "break-even-price-cost-neutral-price-and-service-volume-function" .

hemo:5000090 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Compensating variation function for health and choice-set changes"@en ;
    dcterms:identifier "HE-FN-CVAR-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 false ;
    hemo:9000008 "Maps a change from the status quo, in prices, in a non-market quantity such as a health state, or in the alternatives a person can choose from, to the compensating variation: the income that must be taken away after a gain, or given after a loss, to leave the person exactly as well off as before the change. Under the article's sign convention it is positive for a gain, when it is the most the person would pay, and negative for a loss, when its absolute value is the least compensation the person would accept. The general expenditure-function definition is given on the Welfare Economics formula page; these records give the closed forms used with a log-income utility function and with a multinomial logit choice model. The records follow the notation of the Compensating Variation article." ;
    hemo:9000009 "Compensating variation function for health and choice-set changes" ;
    hemo:9000014 "v(p_1, q_1, Y - CV) = v(p_0, q_0, Y); CV = Y * (1 - exp(-b * Delta_h)); CV = (log(sum exp(V1_j)) - log(sum exp(V0_j))) / alpha" ;
    hemo:9000018 "HE-FN-CVAR-001" ;
    hemo:9000023 "compensating-variation-function-for-health-and-choice-set-changes" .

hemo:5000091 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Equivalent variation function for health and income changes measured at the status quo"@en ;
    dcterms:identifier "HE-FN-EVAR-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 false ;
    hemo:9000008 "Maps a change from the status quo to the equivalent variation: the change in income, without the change, that would leave the person as well off as the change would. For a gain it is the least the person would accept to forgo the gain, and for a loss the most the person would pay to avoid it. Because every option is valued at the same status quo prices and quantities, equivalent variation ranks several options in the same order as the person's utility. The general expenditure-function definition is given on the Welfare Economics formula page; these records give the closed forms under a log-income utility function, and the log-sum formula of a logit model, HE-FM-CVAR-002, gives both Hicksian measures at once. The records follow the notation of the Equivalent Variation article." ;
    hemo:9000009 "Equivalent variation function for health and income changes measured at the status quo" ;
    hemo:9000014 "v(p_0, q_0, Y + EV) = v(p_1, q_1, Y); EV = Y * (exp(b * Delta_h) - 1); EV_k = Y_k * exp(b * Delta_h_k) - Y_0" ;
    hemo:9000018 "HE-FN-EVAR-001" ;
    hemo:9000023 "equivalent-variation-function-for-health-and-income-changes-measured-at-the-status-quo" .

hemo:5000110 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Correcting prevalence and cost estimates for misclassification by a measure validated against a criterion"@en ;
    dcterms:identifier "HE-FN-CRV-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 false ;
    hemo:9000008 "Uses the sensitivity and specificity of a measure, estimated against a criterion such as medical record review, to recover the true prevalence from the share the measure flags and to show how false positives shift the mean cost of a flagged cohort. Sensitivity, specificity and predictive values themselves are HE-FM-DXA-001 (from the two-by-two table) and HE-FM-DXA-003 (at a given prevalence) on the Diagnostic Accuracy page. Notation follows the Criterion Validity article and its heart failure claims algorithm." ;
    hemo:9000009 "Correcting prevalence and cost estimates for misclassification by a measure validated against a criterion" ;
    hemo:9000014 "p = (a + Sp - 1) / (Se + Sp - 1); C_flag = PPV * C_1 + (1 - PPV) * C_0" ;
    hemo:9000018 "HE-FN-CRV-001" ;
    hemo:9000023 "correcting-prevalence-and-cost-estimates-for-misclassification-by-a-measure-validated-against-a-criterion" .

hemo:5000112 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Deviance residuals for finding poorly fitted patients in cost regressions and survival models"@en ;
    dcterms:identifier "HE-FN-DEVR-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 false ;
    hemo:9000008 "Turns each patient's contribution to a fitted model's deviance into a signed residual, so the patients a cost regression or a survival curve describes worst can be found before its estimates feed a cost-effectiveness model. The generalised linear model version takes the square root of the unit deviance with the sign of the raw residual; the survival version applies the same idea to the martingale residual, treating the event indicator as a Poisson count with mean equal to the fitted cumulative hazard. The Cox-Snell residual itself, the fitted cumulative hazard, is HE-FM-CUMH-001 on the Cumulative Hazard page. Notation follows the Deviance Residual article." ;
    hemo:9000009 "Deviance residuals for finding poorly fitted patients in cost regressions and survival models" ;
    hemo:9000014 "r_D = sign(y - mu) * sqrt(d); D = sum of d over patients" ;
    hemo:9000018 "HE-FN-DEVR-001" ;
    hemo:9000023 "deviance-residuals-for-finding-poorly-fitted-patients-in-cost-regressions-and-survival-models" .

hemo:5000117 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Dirichlet distribution for one row of a transition matrix, moments, conjugate update from transition counts and beta marginals"@en ;
    dcterms:identifier "HE-FN-DIRI-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 false ;
    hemo:9000008 "Treats the probabilities of moving from one health state to each of K destinations as a single uncertain vector that always adds to one, with one positive parameter per destination. The ratios of the parameters fix the means and their sum fixes the precision; observed transition counts add to a Dirichlet prior to give a Dirichlet posterior, and each component on its own follows a beta distribution. Sampling a row from normalised gamma draws is HE-FM-BETA-005 on the beta distribution page. Notation follows the Dirichlet Distribution article." ;
    hemo:9000009 "Dirichlet distribution for one row of a transition matrix: moments, conjugate update from transition counts and beta marginals" ;
    hemo:9000014 "E_j = alpha_j / alpha_0; V_j = alpha_j * (alpha_0 - alpha_j) / (alpha_0^2 * (alpha_0 + 1)); C_ij = -alpha_i * alpha_j / (alpha_0^2 * (alpha_0 + 1)); alpha_j = a_j + n_j; p_j ~ Beta(alpha_j, alpha_0 - alpha_j)" ;
    hemo:9000018 "HE-FN-DIRI-001" ;
    hemo:9000023 "dirichlet-distribution-for-one-row-of-a-transition-matrix-moments-conjugate-update-from-transition-counts-and-beta-marginals" .

hemo:5000123 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Discounted and episode-level occupancy of a time-homogeneous absorbing Markov chain"@en ;
    dcterms:identifier "HE-FN-MKCH-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 false ;
    hemo:9000008 "Maps the transient block Q of a time-homogeneous absorbing Markov chain to the expected number of cycles spent in each transient state, either with each cycle discounted at a constant rate or split into separate episodes of a state that can be left and re-entered. The undiscounted fundamental matrix N, the expected cycles before absorption t = Nc and the absorption probabilities B = NR are HE-FM-ABS-001 and HE-FM-ABS-002, the cohort update s_(t+1) = s_t P is HE-FM-MM-001 and a cohort trace with counting weights and discounting is HE-FM-CSIM-001. Notation follows the Markov Chain article." ;
    hemo:9000009 "Discounted and episode-level occupancy of a time-homogeneous absorbing Markov chain" ;
    hemo:9000014 "N_disc = sum_(k=0)^inf (Q / (1 + r)^Delta)^k = (I - Q / (1 + r)^Delta)^(-1)" ;
    hemo:9000018 "HE-FN-MKCH-001" ;
    hemo:9000023 "discounted-and-episode-level-occupancy-of-a-time-homogeneous-absorbing-markov-chain" .

hemo:5000129 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Bound corrections of the concentration index for binary and bounded health variables"@en ;
    dcterms:identifier "HE-FN-CIX-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6000217,
        hemo:6000218,
        hemo:6000219,
        hemo:6000220,
        hemo:6000221,
        hemo:6000222 ;
    hemo:1000007 hemo:6000217,
        hemo:6000218,
        hemo:6000219,
        hemo:6000220 ;
    hemo:1000008 hemo:6000221,
        hemo:6000222 ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 true ;
    hemo:9000008 "Maps the standard concentration index of a health variable, its mean and the bounds of its measurement scale to an index whose feasible range does not depend on the mean. For a binary variable the standard index can only lie between mu minus 1 and 1 minus mu in large samples, so Wagstaff divides it by 1 minus the mean, while Erreygers multiplies it by 4 times the mean over the range of the scale, which equals 8 times the covariance of health and fractional rank over that range. The standard index itself, C = 2 cov_hr / mu, is HE-FM-HINQ-005, computed from grouped data in HE-CF-HINQ-001; the curve form by trapezoids is HE-FM-VEQ-002, the horizontal inequity index C_M minus C_N is HE-FM-HEQ-003 and the rule of 75 is HE-FM-HEQ-004. Notation follows the Concentration Index article." ;
    hemo:9000009 "Bound corrections of the concentration index for binary and bounded health variables" ;
    hemo:9000014 "g(C, mu, a, b) = (W, E)" ;
    hemo:9000018 "HE-FN-CIX-001" ;
    hemo:9000023 "bound-corrections-of-the-concentration-index-for-binary-and-bounded-health-variables" .

hemo:5000132 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Last observation carried forward imputation and the bias it adds to an analysed mean"@en ;
    dcterms:identifier "HE-FN-LOCF-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6000231,
        hemo:6000232,
        hemo:6000233,
        hemo:6000234 ;
    hemo:1000007 hemo:6000231,
        hemo:6000232,
        hemo:6000233 ;
    hemo:1000008 hemo:6000234 ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 true ;
    hemo:9000008 "Maps a participant's last observed value to every later scheduled visit, so that the value used at visit k is the value recorded at the last completed visit d whenever k is after d, and then maps the fraction of each arm imputed this way, with the true means at the last observed visit and at the final visit, to the expected mean and between-arm difference that the completed data return. The difference between those expected values and the true final-visit values is the bias that the imputation adds. Trapezoidal QALYs reuse HE-FM-QALY-002 and the cost-effectiveness ratio reuses HE-FM-ICER-001; this package adds the mixture mean, the between-arm bias under unequal dropout and a function that carries both into incremental QALYs and the ICER." ;
    hemo:9000009 "Last observation carried forward imputation and the bias it adds to an analysed mean" ;
    hemo:9000014 "L(tau, mu_last, mu_end) = mu_tilde" ;
    hemo:9000018 "HE-FN-LOCF-001" ;
    hemo:9000023 "last-observation-carried-forward-imputation-and-the-bias-it-adds-to-an-analysed-mean" .

hemo:5000146 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Health forgone for equity, switching weight and implied inequality aversion function"@en ;
    dcterms:identifier "HE-FN-EET-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6000284,
        hemo:6000285,
        hemo:6000286,
        hemo:6000287,
        hemo:6000288,
        hemo:6000289,
        hemo:6000290 ;
    hemo:1000007 hemo:6000284,
        hemo:6000285,
        hemo:6000286,
        hemo:6000287 ;
    hemo:1000008 hemo:6000288,
        hemo:6000289,
        hemo:6000290 ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 true ;
    hemo:9000008 "Takes two options of equal cost, the population share of a worse-off and a better-off group, each group's net health gain per person under each option after the health displaced elsewhere, and each group's baseline health. It returns the total health forgone by choosing the fairer option (HE-FM-EET-001), the weight on the worse-off group's gain at which the two options tie, and the Atkinson inequality aversion that this weight implies at baseline health (HE-FM-EET-003). The weight is the switching weight w_s of the live record HE-FM-WE-004 (function HE-FN-WE-001), with each group's QALYs read as its population share times its net gain per person, and it is cited there rather than restated. It exceeds 1 by the health forgone divided by the share-weighted extra gain to the worse-off group, the link that HE-VT-EET-003 checks, and it differs from the equity switching weight HE-FM-EQWA-004, which sets one programme against the health displaced by its cost. The implied aversion inverts the live Atkinson relative weight HE-FM-ATK-004, whose test HE-VT-ATK-005 recovers epsilon from a weight. Equally distributed equivalent health itself is live as HE-FM-ATK-002 and HE-FM-ATK-003 (function HE-FN-ATK-001, computational function HE-CF-ATK-001) and is not restated, and the exact switching value of the aversion parameter, found by solving the EDE comparison numerically, belongs to the Distributional Cost-Effectiveness package. Notation follows the Equity-Efficiency Trade-off article." ;
    hemo:9000009 "Health forgone for equity, switching weight and implied inequality aversion function" ;
    hemo:9000014 "t(s_g, g_g_max, g_g_fair, h_g) = (H_forgone, w_star, epsilon_star)" ;
    hemo:9000018 "HE-FN-EET-001" ;
    hemo:9000023 "health-forgone-for-equity-switching-weight-and-implied-inequality-aversion-function" .

hemo:5000163 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Probabilistic sensitivity analysis run that turns joint parameter draws into stored decision outputs"@en ;
    dcterms:identifier "HE-FN-PSA-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6000386,
        hemo:6000387,
        hemo:6000388,
        hemo:6000389,
        hemo:6000390,
        hemo:6000391,
        hemo:6000392,
        hemo:6000393 ;
    hemo:1000007 hemo:6000386,
        hemo:6000387,
        hemo:6000388,
        hemo:6000389 ;
    hemo:1000008 hemo:6000390,
        hemo:6000391,
        hemo:6000392,
        hemo:6000393 ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 true ;
    hemo:9000008 "Maps a decision model f, the joint distribution of its uncertain inputs and a cost-effectiveness threshold lambda to the outputs stored for every draw and their summaries. Each of the N draws theta_i is one complete set of inputs, applied to every option so that incremental results keep their dependence, and the model returns each option's cost and QALYs in that draw. The summaries are live records and are not restated here. Expected net monetary and net health benefit from the draws are HE-FM-ENB-001 and HE-FM-ENB-002, the probability that each option is cost-effective and the acceptability frontier are HE-FM-CEAC-001 to HE-FM-CEAC-003, and per-person EVPI from the same draws is HE-FM-VOI-001 with the forms in HE-FM-EVPI-001 to HE-FM-EVPI-004. A probabilistic ICER is the two-option ratio HE-FM-ICER-001 taken on expected values (HE-AS-ICER-003). The Monte Carlo standard error of a mean output over independent draws is the standard deviation across draws divided by the square root of N, the form of HE-FM-ANTV-002 with one observation per draw, and the number of draws for a target standard error is HE-FM-ABM-003 (HE-FM-ABM-004 for a share of draws); antithetic pairs are HE-FN-ANTV-001. Why a run at the mean inputs differs from the mean of the runs is covered by HE-FM-EV-001 to HE-FM-EV-004, and input distributions by HE-FN-BETA-001, HE-CF-BETA-001, HE-FM-BETA-005 and HE-FM-DIRI-001. The probability of a wrong decision and the Monte Carlo error of that probability belong to the Decision Uncertainty page. This package adds the two-parameter Cholesky step that draws a correlated pair of normal inputs, the expected loss of each of two options with the identity that links the two losses to expected net health benefit, and a computational function that runs the whole analysis on a small fixed set of draws. Notation follows the Probabilistic Sensitivity Analysis article." ;
    hemo:9000009 "Probabilistic sensitivity analysis run that turns joint parameter draws into stored decision outputs" ;
    hemo:9000014 "psa(f, theta_i, lambda, N) = (ENHB, P_CE, EL_new, EL_comp)" ;
    hemo:9000018 "HE-FN-PSA-001" ;
    hemo:9000023 "probabilistic-sensitivity-analysis-run-that-turns-joint-parameter-draws-into-stored-decision-outputs" .

hemo:5000168 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Specific attachment point expected reimbursement, variance and claims inflation response function"@en ;
    dcterms:identifier "HE-FN-ATTP-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6000425,
        hemo:6000426,
        hemo:6000427,
        hemo:6000428,
        hemo:6000429,
        hemo:6000430,
        hemo:6000431,
        hemo:6000432,
        hemo:6000433,
        hemo:6000434,
        hemo:6000435,
        hemo:6000436 ;
    hemo:1000007 hemo:6000425,
        hemo:6000426,
        hemo:6000427,
        hemo:6000428,
        hemo:6000429,
        hemo:6000430 ;
    hemo:1000008 hemo:6000431,
        hemo:6000432,
        hemo:6000433,
        hemo:6000434,
        hemo:6000435,
        hemo:6000436 ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 true ;
    hemo:9000008 "Maps the distribution of one covered person's eligible claims for a contract year, a specific attachment point A, a cap on claims U and a coinsurance rate c to the mean, second moment, variance and standard deviation of the stop-loss or reinsurance reimbursement for that person, and maps a uniform claims inflation rate g to the proportional rise in the expected reimbursement of an uncapped excess layer whose attachment point stays fixed. The one-year payment rule of the article, R equal to c times the positive part of min(C, U) minus A, is the payment rule of HE-FM-ASL-001 applied to one person's claims C in place of the group's net claims S, with a layer limit M equal to U minus A, multiplied by c, because for any cap at or above the attachment point min(max(C minus A, 0), U minus A) equals max(min(C, U) minus A, 0) (derived, checked numerically), so the rule is cited and not restated. The aggregate side of a stop-loss policy is live as HE-FM-ASL-001 to HE-FM-ASL-005 and HE-CF-ASL-001, including the normal approximation to an expected excess (HE-FM-ASL-005), and the standard deviation of a total over independent members is the square-root rule of HE-FM-ASL-003. A probability-weighted mean in general is HE-FN-EV-001 (HE-FM-CHN-001 at a chance node), a member's cost sharing under a deductible, coinsurance and out-of-pocket maximum is HE-FM-AV-002, a gross premium with loadings is HE-FM-ACTA-002 and moving a cost from one price year to another with an index is HE-FM-COST-002. This package adds the variance of the specific reimbursement over a discrete claims distribution, with its mean, and the response of an excess layer to claims inflation. Notation follows the Attachment Point article." ;
    hemo:9000009 "Specific attachment point expected reimbursement, variance and claims inflation response function" ;
    hemo:9000014 "s(p_k, C_k, A, U, c, g) = (E_R, M2_R, V_R, SD_R, E_g, rise_E)" ;
    hemo:9000018 "HE-FN-ATTP-001" ;
    hemo:9000023 "specific-attachment-point-expected-reimbursement-variance-and-claims-inflation-response-function" .

hemo:5000178 a owl:NamedIndividual,
        hemo:0000010 ;
    rdfs:label "Incremental cost-utility ratio"@en ;
    dcterms:identifier "HE-FM-CUA-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000001 hemo:5000004 ;
    hemo:1000005 hemo:7000036 ;
    hemo:1000006 hemo:6000505,
        hemo:6000506,
        hemo:6000507 ;
    hemo:1000007 hemo:6000505,
        hemo:6000506 ;
    hemo:1000008 hemo:6000507 ;
    hemo:1000009 hemo:7000031,
        hemo:7000032,
        hemo:7000033,
        hemo:7000034,
        hemo:7000035 ;
    hemo:1000010 hemo:7000037,
        hemo:7000038,
        hemo:7000039,
        hemo:7000040 ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 true ;
    hemo:9000008 "Calculates the additional cost per additional quality-adjusted life year when ratio interpretation is appropriate." ;
    hemo:9000009 "Incremental cost-utility ratio" ;
    hemo:9000010 "National Institute for Health and Care Excellence. NICE technology appraisal and highly specialised technologies guidance: the manual (PMG36). Published 2022; last updated 31 March 2026. Chapter 4 Economic evaluation, sections 4.2.14 to 4.2.16 (cost-utility analysis, QALYs and the definition of the ICER). https://www.nice.org.uk/process/pmg36/chapter/economic-evaluation-2" ;
    hemo:9000011 "Interpreting a negative ICUR mechanically. A negative ratio may indicate either dominance or being dominated and cannot be interpreted without examining incremental cost and incremental QALYs.",
        "Reading a south-west ratio as cost per QALY gained. When incremental cost and incremental QALYs are both negative, the ICUR is positive but measures the saving per QALY forgone. The intervention is then favoured only if the ratio exceeds the threshold, so a ratio below the threshold counts against it." ;
    hemo:9000014 "ICUR = Delta_C / Delta_QALY" ;
    hemo:9000018 "HE-FM-CUA-001" ;
    hemo:9000023 "incremental-cost-utility-ratio" .

