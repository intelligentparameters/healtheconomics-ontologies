        hemo:0000013 ;
    rdfs:label "Computational function for comparing the UK MVH and Zimbabwe EQ-5D-3L value sets state by state"@en ;
    dcterms:identifier "HE-CF-CSVS-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000002 hemo:5000648,
        hemo:5000649,
        hemo:5000721 ;
    hemo:1000005 hemo:7005874,
        hemo:7005875,
        hemo:7005876 ;
    hemo:1000006 hemo:6004041,
        hemo:6004042,
        hemo:6004043,
