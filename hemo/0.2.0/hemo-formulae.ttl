hemo:5000214 a owl:NamedIndividual,
        hemo:0000010 ;
    rdfs:label "Transition probability from a constant rate"@en ;
    obo:IAO_0000119 "Fleurence and Hollenbeak 2007; the Source rows of the Functions and Formulae module record HE-FM-TP-001" ;
    dcterms:identifier "HE-FM-TP-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000001 hemo:5000021 ;
    hemo:1000005 hemo:7000367 ;
    hemo:1000006 hemo:6000665,
        hemo:6000666,
        hemo:6000667 ;
    hemo:1000007 hemo:6000666,
        hemo:6000667 ;
    hemo:1000008 hemo:6000665 ;
    hemo:1000009 hemo:7000365,
        hemo:7000366 ;
    hemo:1000010 hemo:7000368,
        hemo:7000369,
        hemo:7000373,
        hemo:7005990 ;
    hemo:1000011 hemo:8000236 ;
    hemo:1000018 hemo:8000226 ;
    hemo:1000028 hemo:5000215 ;
    hemo:1000035 hemo:4000017 ;
    hemo:2000019 true ;
    hemo:9000001 rheo:0000016 ;
    hemo:9000002 heto:4201802 ;
    hemo:9000008 "Converts a constant event rate into the probability that the event occurs within an interval of length Delta, among people at risk at the start of the interval. The function exp is the exponential function." ;
    hemo:9000009 "Transition probability from a constant rate" ;
    hemo:9000010 "Fleurence RL, Hollenbeak CS. Rates and probabilities in economic modelling: transformation, translation and appropriate application. PharmacoEconomics. 2007;25(1):3-6. https://doi.org/10.2165/00019053-200725010-00002",
        "Gidwani R, Russell LB. Estimating transition probabilities from published evidence: a tutorial for decision modelers. PharmacoEconomics. 2020;38(11):1153-1164. Section on the probability-rate equations when there are two state transitions (equations 8 to 10). https://doi.org/10.1007/s40273-020-00937-z" ;
    hemo:9000011 "Using the rate itself as a probability. Entering a rate directly as a per-cycle probability overstates the risk, and can exceed 1 at high rates. At a rate of 1 per year the one-year probability is about 0.632, not 1." ;
    hemo:9000014 "p = 1 - exp(-h * Delta)" ;
    hemo:9000015 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><apply><csymbol cd=\"relation1\">eq</csymbol><ci>p</ci><apply><csymbol cd=\"arith1\">minus</csymbol><cn type=\"integer\">1</cn><apply><csymbol cd=\"transc1\">exp</csymbol><apply><csymbol cd=\"arith1\">times</csymbol><apply><csymbol cd=\"arith1\">unary_minus</csymbol><ci>h</ci></apply><ci>Delta</ci></apply></apply></apply></apply></math>" ;
