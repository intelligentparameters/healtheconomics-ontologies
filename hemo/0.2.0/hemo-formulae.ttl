        hemo:6000012 ;
    hemo:1000007 hemo:6000010,
        hemo:6000011 ;
    hemo:1000008 hemo:6000012 ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 true ;
    hemo:9000008 "Maps incremental cost and incremental quality-adjusted life years to the additional cost per QALY gained." ;
    hemo:9000009 "Incremental cost-utility function" ;
    hemo:9000014 "h(Delta_C,Delta_QALY) = ICUR" ;
    hemo:9000018 "HE-FN-CUA-001" ;
    hemo:9000023 "incremental-cost-utility-function" .

hemo:5000006 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Equivalence-gated least-cost selection function"@en ;
