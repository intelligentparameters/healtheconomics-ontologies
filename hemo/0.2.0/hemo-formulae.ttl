hemo:7001986 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Australian late-entry loading for a person taking out hospital cover at 36"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000007 ;
    hemo:9000008 "The Commonwealth Ombudsman's example of a person aged 36 counts 6 years over 30 and gives a loading of 12%. On the illustrative £2,000 premium the loaded premium is £2,240, computed here for illustration." ;
    hemo:9000009 "Australian late-entry loading for a person taking out hospital cover at 36" ;
