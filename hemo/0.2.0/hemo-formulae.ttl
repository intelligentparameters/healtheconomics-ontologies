hemo:7000644 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Dutch costing manual absence shorter than the friction period"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000007 ;
    hemo:1000037 hemo:7000645,
        hemo:7000646,
        hemo:7000647,
        hemo:7000648,
        hemo:7000649 ;
    hemo:1000038 hemo:7000650 ;
    hemo:2000008 0.005 ;
    hemo:9000008 "The same person absent for 56 calendar days is below the cap, so all 8 weeks count: 7,656.96 euros, as in example 9 of the manual." ;
    hemo:9000009 "Dutch costing manual absence shorter than the friction period" ;
    hemo:9000014 "D_a = 56; D_F = 115; H = 24; w = 39.88; e = 1; C_FC = 7656.96" ;
    hemo:9000018 "HE-EX-ABSN-005" ;
