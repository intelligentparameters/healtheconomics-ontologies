heto:4000012 a owl:NamedIndividual ;
    rdfs:label "Calculate incremental cost-effectiveness results"@en ;
    obo:IAO_0000412 <https://healtheconomics.wiki/ontologies/heto/0.3.0/heto.owl> .

heto:4200802 a owl:NamedIndividual ;
    rdfs:label "Choose a unit cost for each resource and adjust it to the price year of the analysis where needed"@en ;
    obo:IAO_0000412 <https://healtheconomics.wiki/ontologies/heto/0.3.0/heto.owl> .

heto:4201202 a owl:NamedIndividual ;
    rdfs:label "Rank the options by cost and remove dominated and extendedly dominated options"@en ;
    obo:IAO_0000412 <https://healtheconomics.wiki/ontologies/heto/0.3.0/heto.owl> .

heto:4202001 a owl:NamedIndividual ;
    rdfs:label "Multiply each resource use estimate by the unit cost of that resource"@en ;
    obo:IAO_0000412 <https://healtheconomics.wiki/ontologies/heto/0.3.0/heto.owl> .

heto:4202002 a owl:NamedIndividual ;
    rdfs:label "Add the costs for each option or health state"@en ;
    obo:IAO_0000412 <https://healtheconomics.wiki/ontologies/heto/0.3.0/heto.owl> .

hemo:5000008 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Economic-burden estimation function"@en ;
    dcterms:identifier "HE-FN-COI-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 false ;
    hemo:9000008 "Maps attributable resource use, losses, population counts and valuation assumptions to the economic burden of a disease, injury or risk factor." ;
    hemo:9000009 "Economic-burden estimation function" ;
    hemo:9000014 "c(inputs,boundary) = Economic Burden" ;
    hemo:9000018 "HE-FN-COI-001" ;
    hemo:9000023 "economic-burden-estimation-function" .

hemo:5000010 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Present-value discounting function"@en ;
    dcterms:identifier "HE-FN-DR-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6000026,
        hemo:6000027,
        hemo:6000028,
        hemo:6000029 ;
    hemo:1000007 hemo:6000026,
        hemo:6000027,
        hemo:6000028 ;
    hemo:1000008 hemo:6000029 ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 true ;
    hemo:9000008 "Maps future costs or health outcomes to values at a common reference time using the applicable discount rate and timing convention." ;
    hemo:9000009 "Present-value discounting function" ;
    hemo:9000014 "d(V_t,r,t) = PV_t" ;
    hemo:9000018 "HE-FN-DR-001" ;
    hemo:9000023 "present-value-discounting-function" .

hemo:5000013 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Net monetary benefit function"@en ;
    dcterms:identifier "HE-FN-NMB-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6000038,
        hemo:6000039,
        hemo:6000040,
        hemo:6000041 ;
    hemo:1000007 hemo:6000038,
        hemo:6000039,
        hemo:6000040 ;
    hemo:1000008 hemo:6000041 ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 true ;
    hemo:9000008 "Values an option's expected health effect in money at a stated cost-effectiveness threshold and subtracts its expected cost, placing health and cost on one monetary scale." ;
    hemo:9000009 "Net monetary benefit function" ;
    hemo:9000014 "n(lambda,E_j,C_j) = NMB_j" ;
    hemo:9000018 "HE-FN-NMB-001" ;
    hemo:9000023 "net-monetary-benefit-function" .

hemo:5000016 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Cost-effectiveness acceptability function"@en ;
    dcterms:identifier "HE-FN-CEAC-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6000048,
        hemo:6000049,
        hemo:6000050,
        hemo:6000051 ;
    hemo:1000007 hemo:6000048,
        hemo:6000049,
        hemo:6000050 ;
    hemo:1000008 hemo:6000051 ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 true ;
    hemo:9000008 "Maps the simulated costs and health effects of mutually exclusive options from a probabilistic sensitivity analysis, together with a threshold, to the probability that each option has the highest net monetary benefit at that threshold. Evaluated across a range of thresholds, it traces the cost-effectiveness acceptability curve." ;
    hemo:9000009 "Cost-effectiveness acceptability function" ;
    hemo:9000014 "a(lambda,C_ij,E_ij) = CEAC_j" ;
    hemo:9000018 "HE-FN-CEAC-001" ;
    hemo:9000023 "cost-effectiveness-acceptability-function" .

hemo:5000018 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Value of information function"@en ;
    dcterms:identifier "HE-FN-VOI-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 false ;
    hemo:9000008 "Maps the joint distribution of net benefit across the options in a decision to the expected gain from resolving some or all of the uncertainty before choosing, compared with choosing the option with the highest expected net benefit on current information." ;
    hemo:9000009 "Value of information function" ;
    hemo:9000014 "v(NB_d(theta)) = EVPI" ;
    hemo:9000018 "HE-FN-VOI-001" ;
    hemo:9000023 "value-of-information-function" .

hemo:5000023 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Accelerated failure time function"@en ;
    dcterms:identifier "HE-FN-AFT-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 false ;
    hemo:9000008 "Models the logarithm of the time to an event as a linear function of covariates plus a scaled error term whose distribution defines the model, such as Weibull, log-logistic or log-normal. A covariate multiplies time itself, so the survival curve of the treated group is the reference curve stretched or shrunk along the time axis: S(t|x = 1) equals S_0(t / TR), where TR is the time ratio." ;
    hemo:9000009 "Accelerated failure time function" ;
    hemo:9000014 "log(T) = beta_0 + beta_1 * x + sigma * epsilon" ;
    hemo:9000018 "HE-FN-AFT-001" ;
    hemo:9000023 "accelerated-failure-time-function" .

hemo:5000024 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Event time sampling function"@en ;
    dcterms:identifier "HE-FN-DES-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 false ;
    hemo:9000008 "Maps a uniform random number and a fitted time-to-event distribution to a sampled time to the next event for one simulated patient. The sampled time is the value at which the survival function equals the random number, so repeated draws reproduce the fitted distribution. The simulation clock then advances to the earliest scheduled event." ;
    hemo:9000009 "Event time sampling function" ;
    hemo:9000014 "s(U,S) = T, where S(T) = U" ;
    hemo:9000018 "HE-FN-DES-001" ;
    hemo:9000023 "event-time-sampling-function" .

hemo:5000027 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Absolute risk reduction function"@en ;
    dcterms:identifier "HE-FN-ARR-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6000061,
        hemo:6000062,
        hemo:6000063 ;
    hemo:1000007 hemo:6000061,
        hemo:6000062 ;
    hemo:1000008 hemo:6000063 ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 true ;
    hemo:9000008 "Maps the risks of an adverse event with the comparator and with the intervention, over the same period, to their difference, oriented so that a benefit is positive. The difference converts a relative treatment effect into events avoided per person treated, the quantity that costs and QALYs in an economic evaluation are built from." ;
    hemo:9000009 "Absolute risk reduction function" ;
    hemo:9000014 "a(p_C,p_I) = ARR" ;
    hemo:9000018 "HE-FN-ARR-001" ;
    hemo:9000023 "absolute-risk-reduction-function" .

hemo:5000029 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Severity shortfall function"@en ;
    dcterms:identifier "HE-FN-ASF-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6000064,
        hemo:6000065,
        hemo:6000066,
        hemo:6000067 ;
    hemo:1000007 hemo:6000064,
        hemo:6000065 ;
    hemo:1000008 hemo:6000066,
        hemo:6000067 ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 true ;
    hemo:9000008 "Maps the remaining discounted QALYs expected for an age- and sex-matched general population, and for people with the condition under current NHS care, to absolute and proportional QALY shortfall. NICE uses whichever measure implies greater severity to set a weight on the incremental QALYs of a new technology." ;
    hemo:9000009 "Severity shortfall function" ;
    hemo:9000014 "s(Q_h,Q_c) = (AS,PS)" ;
    hemo:9000018 "HE-FN-ASF-001" ;
    hemo:9000023 "severity-shortfall-function" .

hemo:5000031 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Resource costing function"@en ;
    dcterms:identifier "HE-FN-COST-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6000068,
        hemo:6000069,
        hemo:6000070 ;
    hemo:1000007 hemo:6000068,
        hemo:6000069 ;
    hemo:1000008 hemo:6000070 ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 true ;
    hemo:9000008 "Maps the resources used by an option, and the unit cost of each, to a single cost expressed in one currency, one price year and one time basis. Costing identifies the resources that differ between options, measures how much of each is used and values each with a unit cost; costs from other years are moved to the common price year, and capital used over several years is spread as an equivalent annual cost. Future costs are then discounted, as set out on the Discount Rate page." ;
    hemo:9000009 "Resource costing function" ;
    hemo:9000014 "c(q_i,p_i) = C" ;
    hemo:9000018 "HE-FN-COST-001" ;
    hemo:9000023 "resource-costing-function" .

hemo:5000032 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Absenteeism measurement and valuation function"@en ;
    dcterms:identifier "HE-FN-ABSN-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6000071,
        hemo:6000072,
        hemo:6000073,
        hemo:6000074 ;
    hemo:1000007 hemo:6000071,
        hemo:6000072,
        hemo:6000073 ;
    hemo:1000008 hemo:6000074 ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 true ;
    hemo:9000008 "Maps the time a worker is absent from paid work because of ill health, the usual hours worked and a value per hour to the share of working time lost and to a productivity cost. The value depends on the method: the human capital approach counts the whole absence, while the friction cost method counts only the period an employer needs to restore production." ;
    hemo:9000009 "Absenteeism measurement and valuation function" ;
    hemo:9000014 "v(D_a,H,w) = C" ;
    hemo:9000018 "HE-FN-ABSN-001" ;
    hemo:9000023 "absenteeism-measurement-and-valuation-function" .

hemo:5000034 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Frontier efficiency measurement function"@en ;
    dcterms:identifier "HE-FN-EFF-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6000077,
        hemo:6000078,
        hemo:6000079,
        hemo:6000080,
        hemo:6000081,
        hemo:6000082 ;
    hemo:1000007 hemo:6000077,
        hemo:6000078,
        hemo:6000079 ;
    hemo:1000008 hemo:6000080,
        hemo:6000081,
        hemo:6000082 ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 true ;
    hemo:9000008 "Maps a decision-making unit's observed inputs, outputs and costs, and a production or cost frontier estimated for comparable units, to efficiency scores between 0 and 1. A score of 1 places the unit on the estimated frontier. The frontier itself is usually estimated by data envelopment analysis, a linear programming method, or by stochastic frontier analysis, a parametric method that separates inefficiency from random noise." ;
    hemo:9000009 "Frontier efficiency measurement function" ;
    hemo:9000014 "f(y,x,C) = (TE,AE,CE)" ;
    hemo:9000018 "HE-FN-EFF-001" ;
    hemo:9000023 "frontier-efficiency-measurement-function" .

hemo:5000036 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Ex post moral hazard welfare function"@en ;
    dcterms:identifier "HE-FN-MH-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6000089,
        hemo:6000090,
        hemo:6000091,
        hemo:6000092,
        hemo:6000093 ;
    hemo:1000007 hemo:6000089,
        hemo:6000090,
        hemo:6000091,
        hemo:6000092 ;
    hemo:1000008 hemo:6000093 ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 true ;
    hemo:9000008 "Maps the resource cost of care, the share of that cost the insured patient pays and the quantities of care used at the full and insured prices to the welfare loss attributed to insurance-induced use, and maps observed spending under two cost-sharing arrangements to a price elasticity of demand. The welfare measures assume that the demand curve measures the patient's marginal benefit, an assumption that the access motive and behavioural hazard challenge." ;
    hemo:9000009 "Ex post moral hazard welfare function" ;
    hemo:9000014 "w(p,c,q_0,q_1) = WL" ;
    hemo:9000018 "HE-FN-MH-001" ;
    hemo:9000023 "ex-post-moral-hazard-welfare-function" .

hemo:5000039 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "340B ceiling price function"@en ;
    dcterms:identifier "HE-FN-340B-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6000094,
        hemo:6000095,
        hemo:6000096 ;
    hemo:1000007 hemo:6000094,
        hemo:6000095 ;
    hemo:1000008 hemo:6000096 ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 true ;
    hemo:9000008 "Maps a covered outpatient drug's average manufacturer price and its Medicaid unit rebate amount for the preceding calendar quarter to the maximum price a covered entity can be required to pay for the smallest unit of the drug. The statute sets the ceiling as AMP reduced by the rebate percentage, the Medicaid rebate per unit divided by AMP, which is AMP minus the unit rebate amount." ;
    hemo:9000009 "340B ceiling price function" ;
    hemo:9000014 "c(AMP,URA) = P_340B" ;
    hemo:9000018 "HE-FN-340B-001" ;
    hemo:9000023 "340b-ceiling-price-function" .

hemo:5000040 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Average bioequivalence and generic price function"@en ;
    dcterms:identifier "HE-FN-ANDA-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6000097,
        hemo:6000098,
        hemo:6000099,
        hemo:6000100,
        hemo:6000101 ;
    hemo:1000007 hemo:6000097,
        hemo:6000098,
        hemo:6000099 ;
    hemo:1000008 hemo:6000100,
        hemo:6000101 ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 true ;
    hemo:9000008 "For an ANDA, bioequivalence to the reference listed drug is shown when the 90% confidence interval for the ratio of geometric means of a pharmacokinetic measure, such as AUC or Cmax, lies within 80.00% to 125.00% after rounding. The interval is computed on the log scale and exponentiated. For economic models, the approval of generic competitors is then translated into a post-entry price." ;
    hemo:9000009 "Average bioequivalence and generic price function" ;
    hemo:9000014 "b(d,SE,t_crit) = (GMR_L,GMR_U)" ;
    hemo:9000018 "HE-FN-ANDA-001" ;
    hemo:9000023 "average-bioequivalence-and-generic-price-function" .

hemo:5000044 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Annuity payment schedule valuation function"@en ;
    dcterms:identifier "HE-FN-AP-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6000102,
        hemo:6000103,
        hemo:6000104,
        hemo:6000105,
        hemo:6000106,
        hemo:6000107,
        hemo:6000108,
        hemo:6000109 ;
    hemo:1000007 hemo:6000102,
        hemo:6000103,
        hemo:6000104,
        hemo:6000105,
        hemo:6000106 ;
    hemo:1000008 hemo:6000107,
        hemo:6000108,
        hemo:6000109 ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 true ;
    hemo:9000008 "Turns the upfront price of a one-off therapy into equal yearly instalments at an agreed financing rate, and values the resulting schedule, fixed or conditional on continued response, at the discount rate of the economic evaluation. The instalment is set so that the schedule matches the upfront price at the financing rate. The cost that enters a cost-effectiveness model is the present value of the expected payments at the evaluation's own rate, not the list price or the nominal sum of the instalments." ;
    hemo:9000009 "Annuity payment schedule valuation function" ;
    hemo:9000014 "f(P, n, i, r, S_t) = (A, PV, EPV)" ;
    hemo:9000018 "HE-FN-AP-001" ;
    hemo:9000023 "annuity-payment-schedule-valuation-function" .

hemo:5000047 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Discrimination AUC as the probability of correct ranking"@en ;
    dcterms:identifier "HE-FN-AUC-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 false ;
    hemo:9000008 "Maps the scores that a diagnostic test or risk prediction model gives to people with and without an outcome to a single probability: the chance that a randomly chosen person with the outcome scores higher than a randomly chosen person without it, with tied scores counted as half. S_1 and S_0 are the scores of the two people and P denotes probability. The result has no units, equals 0.5 for a score unrelated to the outcome and 1 for perfect separation, and is the area under the receiver operating characteristic (ROC) curve and the C-statistic for a binary outcome. It measures discrimination only; calibration and the costs and health effects of acting on the score are separate questions." ;
    hemo:9000009 "Discrimination AUC as the probability of correct ranking" ;
    hemo:9000014 "AUC = P(S_1 > S_0) + 0.5 * P(S_1 = S_0)" ;
    hemo:9000018 "HE-FN-AUC-001" ;
    hemo:9000023 "discrimination-auc-as-the-probability-of-correct-ranking" .

hemo:5000052 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Antithetic variates estimator of an expected model output"@en ;
    dcterms:identifier "HE-FN-ANTV-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 false ;
    hemo:9000008 "Estimates the expected value of a simulation model's output, such as expected costs, QALYs or net monetary benefit, by running the model on n/2 independent sets of random inputs and again on their mirror images, then averaging all n results. For uniform random numbers the mirror image of U is 1-U, applied before the numbers are transformed into parameter values or event times; for a normal input it is the reflection about the mean. The estimate is unbiased, and its variance depends on the correlation between the outputs of the two members of each pair, so the method helps when that correlation is negative." ;
    hemo:9000009 "Antithetic variates estimator of an expected model output" ;
    hemo:9000014 "mu_anti = (1/n) * sum_(i=1)^(n/2) (f(X_i) + f(X~_i)); X~_i = 1 - X_i for uniform inputs" ;
    hemo:9000018 "HE-FN-ANTV-001" ;
    hemo:9000023 "antithetic-variates-estimator-of-an-expected-model-output" .

hemo:5000055 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Actuarial value calculation function for health plan cost sharing"@en ;
    dcterms:identifier "HE-FN-AV-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 false ;
    hemo:9000008 "Maps a health plan's cost-sharing rules and the allowed costs of a standard population over one benefit year to the share of those costs that the plan pays. Each person's allowed cost is split into the cost sharing paid by the member and the remainder paid by the plan, and the plan's total is divided by the total allowed cost. The records follow the notation of the Actuarial Value article, where X is allowed cost, S is cost sharing and P is the plan payment. Premiums appear in neither term." ;
    hemo:9000009 "Actuarial value calculation function for health plan cost sharing" ;
    hemo:9000014 "S = f(X, D, c, M); P = X - S; AV = g(P, X)" ;
    hemo:9000018 "HE-FN-AV-001" ;
    hemo:9000023 "actuarial-value-calculation-function-for-health-plan-cost-sharing" .

hemo:5000062 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Partial pooling of response rates across basket trial baskets"@en ;
    dcterms:identifier "HE-FN-BSKT-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 false ;
    hemo:9000008 "Maps the responders and evaluable patients in each basket of a basket trial, together with a common mean response and a between-basket variance, to a response estimate for each basket that borrows information from the other baskets. The result lies between analysing each basket separately and pooling every patient. The basket estimates can then be reweighted to the mix of tumour types expected in practice before they enter a response-based economic model. A full hierarchical model does the same jointly on the log-odds scale." ;
    hemo:9000009 "Partial pooling of response rates across basket trial baskets" ;
    hemo:9000014 "p_tilde_j = w_j * p_hat_j + (1 - w_j) * mu" ;
    hemo:9000018 "HE-FN-BSKT-001" ;
    hemo:9000023 "partial-pooling-of-response-rates-across-basket-trial-baskets" .

hemo:5000071 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Schwarz criterion for ranking survival curves and approximating Bayes factors"@en ;
    dcterms:identifier "HE-FN-BIC-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 false ;
    hemo:9000008 "Maps the maximised log-likelihood, the number of estimated parameters and a sample count for each model fitted to the same data to the Bayesian information criterion: minus twice the log-likelihood plus the parameter count times the natural log of the count. Lower values rank higher, and the difference between two models approximates twice the natural log of the Bayes factor between them, which also yields approximate posterior model probabilities. The patient-count form, with its worked examples, is recorded on the Akaike information criterion page; this page adds the event-count penalty for censored survival data and the Bayesian readings of BIC differences. Like AIC, the criterion describes fit within follow-up only." ;
    hemo:9000009 "Schwarz criterion for ranking survival curves and approximating Bayes factors" ;
    hemo:9000014 "BIC(lnL, k, c) = -2 * lnL + k * log(c); 2 * log(B_12) ≈ BIC_2 - BIC_1" ;
    hemo:9000018 "HE-FN-BIC-001" ;
    hemo:9000023 "schwarz-criterion-for-ranking-survival-curves-and-approximating-bayes-factors" .

hemo:5000073 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Brier score as a proper scoring rule for predicted risks"@en ;
    dcterms:identifier "HE-FN-BRIER-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 false ;
    hemo:9000008 "Maps a set of predicted event probabilities and the observed binary outcomes to the mean squared difference between them, a proper scoring rule in which lower values are better. The score rewards predictions that are both well calibrated and able to separate patients who have the event from those who do not, and it can be partitioned into reliability, resolution and uncertainty terms. In health economic models it is one check on a risk equation before its predictions become event probabilities. Discrimination alone is covered by HE-FM-AUC-001." ;
    hemo:9000009 "Brier score as a proper scoring rule for predicted risks" ;
    hemo:9000014 "BS(p, y) = mean((p - y)^2)" ;
    hemo:9000018 "HE-FN-BRIER-001" ;
    hemo:9000023 "brier-score-as-a-proper-scoring-rule-for-predicted-risks" .

hemo:5000077 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Pigouvian tax on a negative externality set at marginal external cost at the efficient quantity"@en ;
    dcterms:identifier "HE-FN-PIGT-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 false ;
    hemo:9000008 "Finds the quantity at which the marginal private benefit of an activity equals its marginal social cost, the marginal private cost plus the marginal external cost, and sets a tax per unit equal to the marginal external cost at that quantity, so that the decision-maker faces the full social cost of each unit. It is the negative-externality mirror of the vaccination subsidy HE-FM-EXT-002 within the social marginal cost and benefit framework HE-FM-EXT-001 on the Externality page. The formulae below apply the rule with a linear demand curve, a constant marginal private cost and a marginal external cost that rises with the quantity consumed." ;
    hemo:9000009 "Pigouvian tax on a negative externality set at marginal external cost at the efficient quantity" ;
    hemo:9000014 "MPB(Q_star) = MPC(Q_star) + MEC(Q_star); t_star = MEC(Q_star)" ;
    hemo:9000018 "HE-FN-PIGT-001" ;
    hemo:9000023 "pigouvian-tax-on-a-negative-externality-set-at-marginal-external-cost-at-the-efficient-quantity" .

hemo:5000080 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Selection incentive function for payments that do not match expected cost"@en ;
    dcterms:identifier "HE-FN-CSKM-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6000194,
        hemo:6000195,
        hemo:6000196,
        hemo:6000197,
        hemo:6000198,
        hemo:6000199,
        hemo:6000200,
        hemo:6000201,
        hemo:6000202,
        hemo:6000203,
        hemo:6000204,
        hemo:6000205,
        hemo:6000206 ;
    hemo:1000007 hemo:6000194,
        hemo:6000195,
        hemo:6000196,
        hemo:6000197,
        hemo:6000198,
        hemo:6000199,
        hemo:6000200,
        hemo:6000201 ;
    hemo:1000008 hemo:6000202,
        hemo:6000203,
        hemo:6000204,
        hemo:6000205,
        hemo:6000206 ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 true ;
    hemo:9000008 "Maps the payment an insurer or provider receives for a member and the member's expected cost of care to the expected profit or loss on that member, the expected profit per member from the mix of risks a plan enrols, and the group-level over- or undercompensation and predictive ratio that evaluators of payment systems use to find groups likely to be targets of selection. Cream skimming is profitable where these measures differ predictably between groups that a plan can identify and influence. Community rating creates such differences through the premium, as the cross-subsidies on the Community Rating page show (HE-FM-CRAT-002), and the risk equalisation transfers that offset them are on that page (HE-FM-CRAT-003)." ;
    hemo:9000009 "Selection incentive function for payments that do not match expected cost" ;
    hemo:9000014 "F(R_i, EC_i, R, m_k, EC_k, N, R_g, C_g) = (pi_i, pi_bar, Pi, OC_g, PR_g)" ;
    hemo:9000018 "HE-FN-CSKM-001" ;
    hemo:9000023 "selection-incentive-function-for-payments-that-do-not-match-expected-cost" .

hemo:5000092 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Cumulative hazard function linking the hazard, survival and cycle probabilities"@en ;
    dcterms:identifier "HE-FN-CUMH-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 false ;
    hemo:9000008 "Maps a hazard function over follow-up to its running total from the time origin, the cumulative hazard H(t). Survival is the exponential of minus H(t), so H(t) can be read off a survival curve and turned back into survival, and the rise in H(t) across a model cycle gives the probability of the event in that cycle for people event free at its start. On the log scale a Weibull cumulative hazard is a straight line in log time, which is the basis of the log-cumulative hazard plot. The notation follows the Cumulative Hazard article." ;
    hemo:9000009 "Cumulative hazard function linking the hazard, survival and cycle probabilities" ;
    hemo:9000014 "H(t) = integral_0^t h(u) du; S(t) = exp(-H(t)); p(t) = 1 - exp(-(H(t) - H(t - Delta)))" ;
    hemo:9000018 "HE-FN-CUMH-001" ;
    hemo:9000023 "cumulative-hazard-function-linking-the-hazard-survival-and-cycle-probabilities" .

hemo:5000105 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Forecasting health service use and measuring forecast accuracy"@en ;
    dcterms:identifier "HE-FN-DFC-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 false ;
    hemo:9000008 "Maps past use and projected populations to forecasts of future service use, by applying age-specific use rates to a projected population or by smoothing a time series of activity, and compares forecasts with data held back from fitting to measure their accuracy. The notation follows the Demand Forecasting article and its ageing district." ;
    hemo:9000009 "Forecasting health service use and measuring forecast accuracy" ;
    hemo:9000014 "U_t = sum_a P_(a,t) * r_(a,0); yhat_next = alpha * y_t + (1 - alpha) * yhat_t; MAE = (1 / n) * sum_t |y_t - yhat_t|" ;
    hemo:9000018 "HE-FN-DFC-001" ;
    hemo:9000023 "forecasting-health-service-use-and-measuring-forecast-accuracy" .

hemo:5000108 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Mixed provider payment and the quantity of care chosen under imperfect agency"@en ;
    dcterms:identifier "HE-FN-CTH-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 false ;
    hemo:9000008 "Maps a provider payment rule with a prospective amount per case and a reimbursed share of cost to the provider's revenue and margin and, with the index of agency (the weight a provider puts on a pound of patient benefit relative to a pound of net revenue), to the quantity of care it chooses. Ellis and McGuire showed that the efficient reimbursed share equals one minus the index of agency. Notation follows the Contract Theory article and its blended bed-day example." ;
    hemo:9000009 "Mixed provider payment and the quantity of care chosen under imperfect agency" ;
    hemo:9000014 "R = P + r * c * q; alpha * b(q) = (1 - r) * c; r_star = 1 - alpha" ;
    hemo:9000018 "HE-FN-CTH-001" ;
    hemo:9000023 "mixed-provider-payment-and-the-quantity-of-care-chosen-under-imperfect-agency" .

hemo:5000111 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Prevalence estimation from a cross-sectional survey and its relation to incidence and duration"@en ;
    dcterms:identifier "HE-FN-XSD-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 false ;
    hemo:9000008 "Estimates the prevalence of a condition from a single survey round, weighting respondents for how the sample was drawn, and links point prevalence to incidence and mean duration in a steady state. The same link shows why averages taken over prevalent cases weight each form of a condition by incidence times duration, not by incidence alone. Notation follows the Cross-Sectional Design article and its prevalent-case utility example." ;
    hemo:9000009 "Prevalence estimation from a cross-sectional survey and its relation to incidence and duration" ;
    hemo:9000014 "P_w = sum_(i=1)^n [w_i * y_i] / sum_(i=1)^n [w_i]; P / (1 - P) = I * D" ;
    hemo:9000018 "HE-FN-XSD-001" ;
    hemo:9000023 "prevalence-estimation-from-a-cross-sectional-survey-and-its-relation-to-incidence-and-duration" .

hemo:5000113 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Distribution-based yardsticks for a minimal important difference in patient-reported and utility scores"@en ;
    dcterms:identifier "HE-FN-DMID-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 false ;
    hemo:9000008 "Expresses an important or detectable change in a questionnaire or utility score as a multiple of the spread of scores or of the instrument's measurement error: half a baseline standard deviation, a benchmark effect size, one standard error of measurement, the minimally detectable change and the reliable change index for one person. These yardsticks describe precision, not what patients value, and methodological and regulatory guidance ranks them behind anchor-based estimates. Standardised mean differences themselves are HE-FM-CD-001 on the Cohen's d page. Notation follows the Distribution-Based MID article." ;
    hemo:9000009 "Distribution-based yardsticks for a minimal important difference in patient-reported and utility scores" ;
    hemo:9000014 "MID_SD = k_SD * SD_0; SEM = SD * sqrt(1 - R); MDC = 1.96 * sqrt(2) * SEM; RC = (x_2 - x_1) / (sqrt(2) * SEM)" ;
    hemo:9000018 "HE-FN-DMID-001" ;
    hemo:9000023 "distribution-based-yardsticks-for-a-minimal-important-difference-in-patient-reported-and-utility-scores" .

hemo:5000120 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Years lived with disability counted from incident cases or from prevalent cases of a sequela"@en ;
    dcterms:identifier "HE-FN-YLD-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 false ;
    hemo:9000008 "Multiplies time spent with a non-fatal health state by its disability weight, counting the time either from the cases that begin in the reference year (all their future health loss, the GBD 1990 incidence perspective) or from everyone living with the state in the reference year (that year's health loss only, the perspective of GBD 2010 onwards and WHO's Global Health Estimates). Prevalence-based YLDs for one sequela are HE-FM-DWT-001 and their comorbidity adjustment HE-FM-DWT-004 on the disability weight page; steady-state prevalence from incidence and duration is HE-FM-XSD-002. Notation follows the Years Lived with Disability article." ;
    hemo:9000009 "Years lived with disability counted from incident cases or from prevalent cases of a sequela" ;
    hemo:9000014 "YLD_inc = sum_(s) [I_s * DW_s * L_s]; YLD_prev = sum_(s) [P_s * DW_s]" ;
    hemo:9000018 "HE-FN-YLD-001" ;
    hemo:9000023 "years-lived-with-disability-counted-from-incident-cases-or-from-prevalent-cases-of-a-sequela" .

hemo:5000121 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Tunnel-state expansion of a cohort state-transition model"@en ;
    dcterms:identifier "HE-FN-TUN-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 false ;
    hemo:9000008 "Maps a clinical state whose risks, costs or utilities depend on time since entry into a chain of K one-cycle tunnel states followed by a long-term state, so that a cohort model carries time in the state as well as the state itself. The expanded matrix P_tunnels is run with the cohort update s_(t+1) = s_t P of the Markov Model page (HE-FM-MM-001), which is not restated. Three existing records complete the method: tunnel probabilities from a survival curve for time since entry come from the rise in cumulative hazard across each cycle (HE-FM-CUMH-002), with the clock restarting on entry as HE-AS-CUMH-004 notes; the constant probability of a memoryless comparator calibrated to the same three-year survival is the rescaling formula HE-FM-TP-003 (p_old = 0.29344, Delta_old = 3 and Delta_new = 1 give 0.10933, as in the article); and life years from the expanded trace under a counting rule are HE-FM-CSIM-001 and HE-CF-CSIM-001. Notation follows the Tunnel State article." ;
    hemo:9000009 "Tunnel-state expansion of a cohort state-transition model" ;
    hemo:9000014 "m_(t+1) = m_t P_tunnels" ;
    hemo:9000018 "HE-FN-TUN-001" ;
    hemo:9000023 "tunnel-state-expansion-of-a-cohort-state-transition-model" .

hemo:5000126 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Years of life lost from deaths weighted by a loss function of age at death"@en ;
    dcterms:identifier "HE-FN-YLL-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 false ;
    hemo:9000008 "Converts deaths from a cause into years of life lost by multiplying the deaths at each age by the years that a loss function assigns to a death at that age, then summing over ages. In the Global Burden of Disease (GBD) study from 2010 onwards and in WHO's Global Health Estimates (GHE) the loss function is the remaining life expectancy at the age of death in a normative standard life table (HE-FM-YLL-001). Potential years of life lost replace it with the years from the age at death to a fixed cut-off age (HE-FM-YLL-002), and the original DALY discounted the standard years (HE-FM-YLL-003). YLLs added to years lived with disability (HE-FN-YLD-001, HE-FM-DWT-001) give DALYs. Notation follows the Years of Life Lost article." ;
    hemo:9000009 "Years of life lost from deaths weighted by a loss function of age at death" ;
    hemo:9000014 "YLL_c = sum_(a) [N_a * e_a]" ;
    hemo:9000018 "HE-FN-YLL-001" ;
    hemo:9000023 "years-of-life-lost-from-deaths-weighted-by-a-loss-function-of-age-at-death" .

hemo:5000131 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Economically justifiable price function solving the ICER for the unit price"@en ;
    dcterms:identifier "HE-FN-EJP-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6000226,
        hemo:6000227,
        hemo:6000228,
        hemo:6000229,
        hemo:6000230 ;
    hemo:1000007 hemo:6000226,
        hemo:6000227,
        hemo:6000228,
        hemo:6000229 ;
    hemo:1000008 hemo:6000230 ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 true ;
    hemo:9000008 "Maps a cost-effectiveness threshold, the incremental QALYs per patient, the incremental cost per patient other than the new medicine's acquisition cost and the discounted number of units per patient to the highest price per unit at which the incremental cost-effectiveness ratio equals the threshold. It solves the two-option ICER of HE-FM-ICER-001 with the medicine's price as the unknown, and the same price sets the incremental net monetary benefit of HE-FM-NMB-002 to zero. The algebra matches the break-even price HE-FM-BEA-001 and, per patient, the payer's maximum price HE-FM-BARG-002; this package adds the threshold range, the NICE severity weight and the probabilistic forms used in an EJP analysis. Notation follows the Economically Justifiable Price article." ;
    hemo:9000009 "Economically justifiable price function solving the ICER for the unit price" ;
    hemo:9000014 "e(lambda,Delta_E,Delta_C_other,U) = EJP" ;
    hemo:9000018 "HE-FN-EJP-001" ;
    hemo:9000023 "economically-justifiable-price-function-solving-the-icer-for-the-unit-price" .

hemo:5000134 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Capital outlay annualisation function at the evaluation discount rate"@en ;
    dcterms:identifier "HE-FN-ANLS-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6000239,
        hemo:6000240,
        hemo:6000241,
        hemo:6000242,
        hemo:6000243 ;
    hemo:1000007 hemo:6000239,
        hemo:6000240,
        hemo:6000241,
        hemo:6000242 ;
    hemo:1000008 hemo:6000243 ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 true ;
    hemo:9000008 "Maps a one-off capital outlay to the equal annual sum charged in each year of the asset's useful life. Its inputs are the purchase price K, the resale or residual value S, the annual discount rate r and the useful life n, and its output is the equivalent annual cost E, set so that the present value of E over n years equals K less the present value of S. It is the inverse of present-value discounting at the same rate (HE-FN-DR-001), applied to a single capital input in economic costing, and it moves no money, unlike the annuity payment contract of HE-FN-AP-001. The same equation appears in the Cost package as HE-FM-COST-003; this package adds the zero-resale form, the comparison with straight-line depreciation and the year-by-year split of the charge. Notation follows the Annualisation article." ;
    hemo:9000009 "Capital outlay annualisation function at the evaluation discount rate" ;
    hemo:9000014 "a(K, S, r, n) = E" ;
    hemo:9000018 "HE-FN-ANLS-001" ;
    hemo:9000023 "capital-outlay-annualisation-function-at-the-evaluation-discount-rate" .

hemo:5000140 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "EQ-5D-3L value set scoring function"@en ;
    dcterms:identifier "HE-FN-EQ3L-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6000266,
        hemo:6000267,
        hemo:6000268,
        hemo:6000269,
        hemo:6000270,
        hemo:6000271,
        hemo:6000272 ;
    hemo:1000007 hemo:6000266,
        hemo:6000267,
        hemo:6000268,
        hemo:6000269,
        hemo:6000270,
        hemo:6000271 ;
    hemo:1000008 hemo:6000272 ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 true ;
    hemo:9000008 "Maps an EQ-5D-3L profile, the level from 1 to 3 reported on each of mobility, self-care, usual activities, pain or discomfort and anxiety or depression, to a single utility under the coefficients of a chosen value set. The main-effects form with a constant for any departure from full health and an N3 term for any dimension at level 3 is the one Dolan used for the UK time trade-off tariff, and many of the time trade-off sets tabulated in the EuroQol reference volume follow it. It is the EQ-5D-3L counterpart of the additive 15D score in HE-FM-15D-001, and the utilities it returns are the weights in QALYs from periods of constant utility (HE-FM-QALY-001) and the baselines for utility decrements (HE-FN-DISU-001). Notation follows the EQ-5D-3L Value Set article." ;
    hemo:9000009 "EQ-5D-3L value set scoring function" ;
    hemo:9000014 "u(l_MO, l_SC, l_UA, l_PD, l_AD; theta) = U" ;
    hemo:9000018 "HE-FN-EQ3L-001" ;
    hemo:9000023 "eq-5d-3l-value-set-scoring-function" .

hemo:5000142 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Estimation of the expected value of partial perfect information from a probabilistic analysis"@en ;
    dcterms:identifier "HE-FN-EVPP-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6000276,
        hemo:6000277,
        hemo:6000278,
        hemo:6000279 ;
    hemo:1000007 hemo:6000276,
        hemo:6000277,
        hemo:6000278 ;
    hemo:1000008 hemo:6000279 ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 true ;
    hemo:9000008 "Maps a decision model, or the probabilistic sample it has produced, and a chosen group of parameters of interest theta_i to an estimate of the expected value of partial perfect information (EVPPI) per person. Each estimator approximates the expected net benefit of every option given theta_i, takes the best option for each value of theta_i, averages, and subtracts the value of the best option on current information. The definition and its order of expectation and maximisation, with a discrete worked case, are on the Value of Information page (HE-FM-VOI-003), the per-person EVPI that bounds every EVPPI from the same sample is HE-FM-VOI-001, and population scaling is HE-FM-VOI-002. This package adds the estimators set out by the ISPOR Value of Information Task Force, with checks that each estimate is at least zero and no larger than the EVPI. Notation follows the Expected Value of Partial Perfect Information article." ;
    hemo:9000009 "Estimation of the expected value of partial perfect information from a probabilistic analysis" ;
    hemo:9000014 "e(NB_d, theta_i, theta_c) = EVPPI_hat" ;
    hemo:9000018 "HE-FN-EVPP-001" ;
    hemo:9000023 "estimation-of-the-expected-value-of-partial-perfect-information-from-a-probabilistic-analysis" .

hemo:5000144 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Net benefit approach to a two-option cost-effectiveness decision and its sampling uncertainty"@en ;
    dcterms:identifier "HE-FN-NBA-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6000280,
        hemo:6000281,
        hemo:6000282,
        hemo:6000283 ;
    hemo:1000007 hemo:6000280,
        hemo:6000281,
        hemo:6000282 ;
    hemo:1000008 hemo:6000283 ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 true ;
    hemo:9000008 "Maps a threshold lambda and the differences in mean effect and mean cost between a new option and its comparator, or the per-arm trial data behind them, to incremental net benefit, whose sign gives the adoption decision, and to the sampling uncertainty around it. Option-level and incremental net monetary benefit, the maximum net monetary benefit rule and expected net benefit from simulations are on the Net Monetary Benefit and Expected Net Benefit pages (HE-FM-NMB-001 to HE-FM-NMB-003, HE-FM-ENB-001 and HE-FM-ENB-002). Incremental net health benefit at a threshold is HE-FM-CET-002, the ICER is HE-FM-ICER-001 and dominance is HE-FM-DOM-001. A normal interval for incremental net benefit built from the standard errors of the two differences is HE-FM-AN-004 with HE-CF-AN-001, its bootstrap variance is HE-FM-BSE-003, the acceptability curve and frontier are HE-FM-CEAC-001 to HE-FM-CEAC-003 and EVPI is HE-FM-VOI-001. This package adds Stinnett and Mullahy's interval for incremental net health benefit from two independent trial arms, the identity that links the sign of incremental net benefit to the ICER in each quadrant of the cost-effectiveness plane, and net-benefit regression. Notation follows the Net Benefit Approach article." ;
    hemo:9000009 "Net benefit approach to a two-option cost-effectiveness decision and its sampling uncertainty" ;
    hemo:9000014 "b(lambda, Delta_E, Delta_C) = INB" ;
    hemo:9000018 "HE-FN-NBA-001" ;
    hemo:9000023 "net-benefit-approach-to-a-two-option-cost-effectiveness-decision-and-its-sampling-uncertainty" .

hemo:5000145 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Cost-effectiveness frontier from the expected costs and QALYs of mutually exclusive strategies"@en ;
    dcterms:identifier "HE-FN-CEF-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 false ;
    hemo:9000008 "Maps the expected total costs C_j and expected total QALYs Q_j of a set of mutually exclusive strategies, estimated for one population, perspective and time horizon, to the strategies on the cost-effectiveness frontier, the slopes of the segments joining them and, at a value λ placed on one QALY, the strategy chosen. It builds on live records and does not restate them. The dominance screen is HE-FM-DOM-001 and HE-FM-DOM-002, the extended dominance condition and the blend of neighbours are HE-FM-EXD-001 and HE-FM-EXD-002, the ratio between adjacent frontier strategies is the sequential ICER HE-FM-CEA-001 and the maximum net monetary benefit rule is HE-FM-NMB-003. This package adds the range of λ over which each frontier strategy is chosen, the net monetary benefit a strategy gives up against the frontier choice, the gradient of the IQWiG efficiency frontier and two computational functions that build the frontier for any number of strategies. Notation follows the Cost-Effectiveness Frontier article." ;
    hemo:9000009 "Cost-effectiveness frontier from the expected costs and QALYs of mutually exclusive strategies" ;
    hemo:9000014 "f(C_j, Q_j, lambda) = (F, ICER_F, j*)" ;
    hemo:9000018 "HE-FN-CEF-001" ;
    hemo:9000023 "cost-effectiveness-frontier-from-the-expected-costs-and-qalys-of-mutually-exclusive-strategies" .

hemo:5000148 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Distributional cost-effectiveness comparison of options by social group function"@en ;
    dcterms:identifier "HE-FN-DCEA-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6000291,
        hemo:6000292,
        hemo:6000293,
        hemo:6000294,
        hemo:6000295,
        hemo:6000296,
        hemo:6000297,
        hemo:6000298,
        hemo:6000299,
        hemo:6000300,
        hemo:6000301 ;
    hemo:1000007 hemo:6000291,
        hemo:6000292,
        hemo:6000293,
        hemo:6000294,
        hemo:6000295,
        hemo:6000296 ;
    hemo:1000008 hemo:6000297,
        hemo:6000298,
        hemo:6000299,
        hemo:6000300,
        hemo:6000301 ;
    hemo:1000035 hemo:4000018 ;
    hemo:2000019 true ;
    hemo:9000008 "Maps each social group's baseline health, its QALY gain from a programme, its share of the health opportunity cost and its size, together with a chosen inequality aversion, to the group's health under the programme, the change in equally distributed equivalent (EDE) health and in the Atkinson index against the comparator, the programme's quadrant on the equity-efficiency impact plane, and the inequality aversion at which two options give equal EDE health. The health opportunity cost of the incremental cost is the live record HE-FM-CET-002, and the EDE and Atkinson index of each distribution are the live records HE-FM-ATK-002, HE-FM-ATK-003, HE-CF-ATK-001 and HE-FM-ATK-001, which are cited here and not redrafted. Other inequality indices for grouped data, such as the absolute gap and the concentration index, are in HE-FN-HINQ-001, and direct equity weights on QALY gains are in HE-FN-EQWA-001. The two-group closed approximation to the switching aversion belongs to the equity-efficiency trade-off package, while the computational function here solves the EDE comparison itself for any number of groups. Notation follows the Distributional Cost-Effectiveness article." ;
    hemo:9000009 "Distributional cost-effectiveness comparison of options by social group function" ;
    hemo:9000014 "d(h0_g, dQ_g, o_g, H_d, N_g, epsilon) = (h1_g, d_EDE, d_A, quadrant, epsilon_star)" ;
    hemo:9000018 "HE-FN-DCEA-001" ;
    hemo:9000023 "distributional-cost-effectiveness-comparison-of-options-by-social-group-function" .

hemo:5000149 a owl:NamedIndividual,
        hemo:0000012 ;
