    hemo:9000014 "[0.0, 0.0857, 0.0, 0.0, 0.0]" .

hemo:7003878 a owl:NamedIndividual,
        hemo:0000016 ;
    rdfs:label "EVPI in the test Article's five draws at GBP 35,000 per QALY as opportunity losses"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000039 hemo:6002811 ;
    rheo:2000001 0.0171 .

hemo:7003879 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Uncertain net benefit with no decision uncertainty gives zero EVPI"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000007 ;
    hemo:1000037 hemo:7003880,
        hemo:7003881,
        hemo:7003882 ;
    hemo:1000038 hemo:7003883,
        hemo:7003884 ;
    hemo:2000008 0.5 ;
    hemo:9000008 "In three illustrative draws the drug's net benefit lies between 0.10 and 0.30 QALYs and so is positive in every draw, so the drug is the best option in each draw and every loss is zero. This limiting case shows that uncertainty which never changes the preferred option has no value of information. This example is for reading, as its draw-by-draw lists may not run in the site calculator." ;
    hemo:9000009 "Uncertain net benefit with no decision uncertainty gives zero EVPI" ;
    hemo:9000014 "S = 3; NBmax_s = [0.10,0.30,0.25]; NBcur_s = [0.10,0.30,0.25]; L_s = [0,0,0]; EVPI = 0" ;
    hemo:9000018 "HE-EX-EVPI-003" ;
    hemo:9000023 "uncertain-net-benefit-with-no-decision-uncertainty-gives-zero-evpi" .

hemo:7003880 a owl:NamedIndividual,
        hemo:0000016 ;
    rdfs:label "S in the test Uncertain net benefit with no decision uncertainty gives zero EVPI"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000039 hemo:6002812 ;
    rheo:2000001 3.0 .

