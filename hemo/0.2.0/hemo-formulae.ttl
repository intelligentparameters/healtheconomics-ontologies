    hemo:1000031 hemo:5000183 ;
    hemo:1000035 hemo:4000017 ;
    hemo:1000049 hemo:4000043 ;
    hemo:2000019 true ;
    hemo:9000003 "rheo 0.3.0 cq21-budget-impact.rq" ;
    hemo:9000014 "B = PY * (c_d - c_x)" ;
    hemo:9000015 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><apply><csymbol cd=\"relation1\">eq</csymbol><ci>B</ci><apply><csymbol cd=\"arith1\">times</csymbol><ci>PY</ci><apply><csymbol cd=\"arith1\">minus</csymbol><ci>c_d</ci><ci>c_x</ci></apply></apply></apply></math>" ;
