        hemo:7007025,
        hemo:7007026,
        hemo:7007027,
        hemo:7007028 ;
    hemo:2000008 0.5 ;
    hemo:9000008 "GBP 300,000 at the start and 0.8 QALYs a year for 30 years give a factor sum of 18.3920, 14.71 discounted QALYs and about GBP 20,389 per QALY against GBP 12,500 undiscounted, a rise of about 63%. `C_0 = 300000; q = 0.8; T = 30; r = 0.035; s = 0; A = 18.392045; Q_d = 14.713636; ICER_d = 20389.25; ICER_0 = 12500; rise = 0.631140`" ;
    hemo:9000014 "C_0 = 300000; q = 0.8; T = 30; r = 0.035; s = 0; A = 18.392045; Q_d = 14.713636; ICER_d = 20389.25; ICER_0 = 12500; rise = 0.631140" .

