    hemo:1000039 hemo:6003128 ;
    rheo:2000001 1.25 .

hemo:7004394 a owl:NamedIndividual,
        hemo:0000016 ;
    rdfs:label "c_i in the test GLOBE reference country A rate of 0.800 applied to an illustrative price"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000039 hemo:6003126 ;
    rheo:2000001 150.0 .

hemo:7004395 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Vietnamese cost converted at the 2016 rate in Turner and colleagues' example"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000007 ;
    hemo:1000037 hemo:7004396,
        hemo:7004397 ;
    hemo:1000038 hemo:7004398 ;
    hemo:2000008 0.005 ;
    hemo:9000008 "In the method 2 example of Turner and colleagues a cost of 2,360,037 Vietnamese dong in 2016 prices is converted at 21,935 dong per US dollar, so e_i is 1 divided by 21,935, about 0.0000455893 US dollars per dong, and the cost is US$107.59, as in their Figure 1B." ;
    hemo:9000009 "Vietnamese cost converted at the 2016 rate in Turner and colleagues' example" ;
    hemo:9000014 "p_i = 2360037; e_i = 0.0000455893; c_i = 107.59" ;
    hemo:9000018 "HE-EX-BOC-002" ;
    hemo:9000023 "vietnamese-cost-converted-at-the-2016-rate-in-turner-and-colleagues-example" .

hemo:7004396 a owl:NamedIndividual,
        hemo:0000016 ;
    rdfs:label "p_i in the test Vietnamese cost converted at the 2016 rate in Turner and colleagues' example"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000039 hemo:6003127 ;
    rheo:2000001 2360037.0 .

hemo:7004397 a owl:NamedIndividual,
        hemo:0000016 ;
    rdfs:label "e_i in the test Vietnamese cost converted at the 2016 rate in Turner and colleagues' example"@en ;
