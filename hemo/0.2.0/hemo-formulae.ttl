    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000039 hemo:6002634 ;
    rheo:2000001 20389.25 .

hemo:7003484 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Article's one-off treatment discounted at 1.5 per cent"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000007 ;
    hemo:1000037 hemo:7003485,
        hemo:7003486,
        hemo:7003487,
        hemo:7003488 ;
    hemo:1000038 hemo:7003489 ;
    hemo:2000008 0.005 ;
    hemo:9000008 "At 1.5% the same treatment costs about GBP 15,615 per QALY, GBP 15,600 to the nearest GBP 100 in the article." ;
    hemo:9000009 "Article's one-off treatment discounted at 1.5 per cent" ;
    hemo:9000014 "C_0 = 300000; q = 0.8; r = 0.015; T = 30; ICER = 15614.70" ;
    hemo:9000018 "HE-EX-DISC-009" ;
    hemo:9000023 "article-s-one-off-treatment-discounted-at-1-5-per-cent" .

hemo:7003485 a owl:NamedIndividual,
        hemo:0000016 ;
    rdfs:label "C_0 in the test Article's one-off treatment discounted at 1.5 per cent"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000039 hemo:6002635 ;
    rheo:2000001 300000.0 .

