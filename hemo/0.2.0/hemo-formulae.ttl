    hemo:9000015 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><apply><csymbol cd=\"logic1\">and</csymbol><apply><csymbol cd=\"logic1\">and</csymbol><apply><csymbol cd=\"logic1\">and</csymbol><apply><csymbol cd=\"logic1\">and</csymbol><apply><csymbol cd=\"logic1\">and</csymbol><apply><csymbol cd=\"logic1\">and</csymbol><apply><csymbol cd=\"relation1\">geq</csymbol><ci>t</ci><cn type=\"integer\">0</cn></apply><apply><csymbol cd=\"relation1\">leq</csymbol><ci>t</ci><ci>y_3</ci></apply></apply><apply><csymbol cd=\"relation1\">leq</csymbol><ci>y_1</ci><ci>y_2</ci></apply></apply><apply><csymbol cd=\"relation1\">leq</csymbol><ci>y_2</ci><ci>y_3</ci></apply></apply><apply><csymbol cd=\"relation1\">gt</csymbol><ci>r_1</ci><apply><csymbol cd=\"arith1\">unary_minus</csymbol><cn type=\"integer\">1</cn></apply></apply></apply><apply><csymbol cd=\"relation1\">gt</csymbol><ci>r_2</ci><apply><csymbol cd=\"arith1\">unary_minus</csymbol><cn type=\"integer\">1</cn></apply></apply></apply><apply><csymbol cd=\"relation1\">gt</csymbol><ci>r_3</ci><apply><csymbol cd=\"arith1\">unary_minus</csymbol><cn type=\"integer\">1</cn></apply></apply></apply></math>" .

