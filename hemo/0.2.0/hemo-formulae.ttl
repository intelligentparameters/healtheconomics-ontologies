    hemo:1000035 hemo:4000018 ;
    hemo:2000019 false ;
    hemo:9000008 "Selects the lowest-cost feasible healthcare alternative only when reliable evidence shows that all decision-relevant outcomes do not differ meaningfully." ;
    hemo:9000009 "Equivalence-gated least-cost selection function" ;
    hemo:9000014 "m(C_j,G) = j*" ;
    hemo:9000018 "HE-FN-CMA-001" ;
    hemo:9000023 "equivalence-gated-least-cost-selection-function" .

hemo:5000011 a owl:NamedIndividual,
        hemo:0000012 ;
    rdfs:label "Pairwise incremental cost-effectiveness function"@en ;
    dcterms:identifier "HE-FN-ICER-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6000030,
        hemo:6000031,
