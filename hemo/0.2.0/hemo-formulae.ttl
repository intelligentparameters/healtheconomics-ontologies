    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000039 hemo:6001020 ;
    rheo:2000001 2.0 .

hemo:7000958 a owl:NamedIndividual,
        hemo:0000016 ;
    rdfs:label "epsilon in the test Atkinson EDE for programme U at epsilon of 2"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000039 hemo:6001021 ;
    rheo:2000001 2.0 .

