hemo:7000963 a owl:NamedIndividual,
        hemo:0000016 ;
    rdfs:label "epsilon in the test Atkinson EDE for programme T at epsilon of 2"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000039 hemo:6001021 ;
    rheo:2000001 2.0 .

hemo:7000964 a owl:NamedIndividual,
        hemo:0000016 ;
    rdfs:label "h_EDE in the test Atkinson EDE for programme T at epsilon of 2"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000039 hemo:6001018 ;
    rheo:2000001 65.733400000000003 .

hemo:7000965 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Atkinson EDE for programme T at the English median epsilon"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000007 ;
    hemo:1000037 hemo:7000966,
        hemo:7000967,
        hemo:7000968 ;
    hemo:1000038 hemo:7000969 ;
    hemo:2000008 0.00005 ;
    hemo:9000008 "At the English median epsilon of 10.95 the EDE for programme T is about 63.73 years, against about 63.51 years for programme U computed the same way, so T is preferred at the elicited level of aversion." ;
    hemo:9000009 "Atkinson EDE for programme T at the English median epsilon" ;
    hemo:9000014 "h_i = [60.4,72.1]; n = 2; epsilon = 10.95; h_EDE = 63.7344" ;
    hemo:9000018 "HE-EX-ATK-005" ;
    hemo:9000023 "atkinson-ede-for-programme-t-at-the-english-median-epsilon" .

hemo:7000966 a owl:NamedIndividual,
        hemo:0000016 ;
    rdfs:label "h_i in the test Atkinson EDE for programme T at the English median epsilon"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000039 hemo:6001019 ;
    hemo:9000014 "[60.4, 72.1]" .

