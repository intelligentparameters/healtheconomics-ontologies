    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000039 hemo:6002637 ;
    rheo:2000001 0.035 .

hemo:7003482 a owl:NamedIndividual,
        hemo:0000016 ;
