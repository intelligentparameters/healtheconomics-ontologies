    hemo:9000002 heto:4200503 ;
    hemo:9000008 "Updates the cohort distribution when the same transition probability matrix is applied in each cycle." ;
    hemo:9000009 "Time-homogeneous cohort state update" ;
    hemo:9000010 "Siebert U, Alagoz O, Bayoumi AM, et al. State-transition modeling: a report of the ISPOR-SMDM Modeling Good Research Practices Task Force-3. Value in Health. 2012;15(6):812-820. https://pubmed.ncbi.nlm.nih.gov/22999130/",
        "Sonnenberg FA, Beck JR. Markov models in medical decision making: a practical guide. Medical Decision Making. 1993;13(4):322-338. https://doi.org/10.1177/0272989X9301300409" ;
    hemo:9000011 "Using probabilities from the wrong time interval. Applying an annual transition probability directly in a monthly-cycle model changes the intended transition process. Convert or estimate probabilities for the model's actual cycle length first." ;
    hemo:9000014 "s_(t+1) = s_t P" ;
    hemo:9000015 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><apply><csymbol cd=\"relation1\">eq</csymbol><ci>s_(t+1)</ci><apply><csymbol cd=\"hemo1\" cdbase=\"https://healtheconomics.wiki/ontologies/hemo/cd\">matrix_product</csymbol><ci>s_t</ci><ci>P</ci></apply></apply></math>" ;
    hemo:9000016 "s_{\\mathrm{(t+1)}} = s_{t} \\, P" ;
