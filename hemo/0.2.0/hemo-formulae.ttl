hemo:5000888 a owl:NamedIndividual,
        hemo:0000010 ;
    rdfs:label "Net budget impact from patient-years on treatment"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Gives the net budget impact of a year as the patient-years on treatment times the annual drug cost less the annual cost of the care it displaces."@en ;
    obo:IAO_0000116 "A HEMO-native record, for a formula the Functions and Formulae module does not yet hold. It is listed in module-backlog.md for the module curator."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Sullivan et al. 2014" ;
    dcterms:identifier "HEMO-FM-BIPY-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000006 hemo:6003678,
