    hemo:9000015 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><apply><csymbol cd=\"relation1\">eq</csymbol><ci>p_new</ci><apply><csymbol cd=\"arith1\">minus</csymbol><cn type=\"integer\">1</cn><apply><csymbol cd=\"arith1\">power</csymbol><apply><csymbol cd=\"arith1\">minus</csymbol><cn type=\"integer\">1</cn><ci>p_old</ci></apply><apply><csymbol cd=\"arith1\">divide</csymbol><ci>Delta_new</ci><ci>Delta_old</ci></apply></apply></apply></apply></math>" ;
    hemo:9000016 "p_{\\mathrm{new}} = 1 - \\left(1 - p_{\\mathrm{old}}\\right)^{\\frac{\\Delta_{\\mathrm{new}}}{\\Delta_{\\mathrm{old}}}}" .

