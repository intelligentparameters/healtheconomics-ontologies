    hemo:9000014 "C_tot = sum_(t=0)^(H - 1) [(mS_(t) * c_S + mP_(t) * c_P) * L / (1 + disc_c)^(t * L)]" ;
    hemo:9000015 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><apply><csymbol cd=\"relation1\">eq</csymbol><ci>C_tot</ci><apply><csymbol cd=\"arith1\">sum</csymbol><apply><csymbol cd=\"interval1\">integer_interval</csymbol><cn type=\"integer\">0</cn><apply><csymbol cd=\"arith1\">minus</csymbol><ci>H</ci><cn type=\"integer\">1</cn></apply></apply><bind><csymbol cd=\"fns1\">lambda</csymbol><bvar><ci>t</ci></bvar><apply><csymbol cd=\"arith1\">divide</csymbol><apply><csymbol cd=\"arith1\">times</csymbol><apply><csymbol cd=\"arith1\">plus</csymbol><apply><csymbol cd=\"arith1\">times</csymbol><apply><csymbol cd=\"hemo1\" cdbase=\"https://healtheconomics.wiki/ontologies/hemo/cd\">element</csymbol><ci>mS</ci><ci>t</ci></apply><ci>c_S</ci></apply><apply><csymbol cd=\"arith1\">times</csymbol><apply><csymbol cd=\"hemo1\" cdbase=\"https://healtheconomics.wiki/ontologies/hemo/cd\">element</csymbol><ci>mP</ci><ci>t</ci></apply><ci>c_P</ci></apply></apply><ci>L</ci></apply><apply><csymbol cd=\"arith1\">power</csymbol><apply><csymbol cd=\"arith1\">plus</csymbol><cn type=\"integer\">1</cn><ci>disc_c</ci></apply><apply><csymbol cd=\"arith1\">times</csymbol><ci>t</ci><ci>L</ci></apply></apply></apply></bind></apply></apply></math>" ;
    hemo:9000016 "C_{\\mathrm{tot}} = \\sum_{t=0}^{H - 1} \\left[\\frac{\\left(\\mathrm{mS}_{t} \\, c_{S} + \\mathrm{mP}_{t} \\, c_{P}\\right) \\, L}{\\left(1 + \\mathrm{disc}_{c}\\right)^{t \\, L}}\\right]" .

