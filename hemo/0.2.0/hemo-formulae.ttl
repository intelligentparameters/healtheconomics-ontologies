        heao:0000093 ;
    hemo:9000004 "HEMO-HOOK-25" ;
    hemo:9000014 "w = min(max(1 + (dQ - Q_lo) / (Q_hi - Q_lo) * (w_max - 1), 1), w_max)" ;
    hemo:9000015 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><apply><csymbol cd=\"relation1\">eq</csymbol><ci>w</ci><apply><csymbol cd=\"minmax1\">min</csymbol><apply><csymbol cd=\"set1\">set</csymbol><apply><csymbol cd=\"minmax1\">max</csymbol><apply><csymbol cd=\"set1\">set</csymbol><apply><csymbol cd=\"arith1\">plus</csymbol><cn type=\"integer\">1</cn><apply><csymbol cd=\"arith1\">times</csymbol><apply><csymbol cd=\"arith1\">divide</csymbol><apply><csymbol cd=\"arith1\">minus</csymbol><ci>dQ</ci><ci>Q_lo</ci></apply><apply><csymbol cd=\"arith1\">minus</csymbol><ci>Q_hi</ci><ci>Q_lo</ci></apply></apply><apply><csymbol cd=\"arith1\">minus</csymbol><ci>w_max</ci><cn type=\"integer\">1</cn></apply></apply></apply><cn type=\"integer\">1</cn></apply></apply><ci>w_max</ci></apply></apply></apply></math>" ;
    hemo:9000016 "w = \\min\\left(\\max\\left(1 + \\frac{\\mathrm{dQ} - Q_{\\mathrm{lo}}}{Q_{\\mathrm{hi}} - Q_{\\mathrm{lo}}} \\, \\left(w_{\\mathrm{max}} - 1\\right), 1\\right), w_{\\mathrm{max}}\\right)" ;
    hemo:9000018 "HEMO-FM-SOB-001" .

