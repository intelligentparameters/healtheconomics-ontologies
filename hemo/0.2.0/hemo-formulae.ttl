    hemo:9000003 "rheo 0.3.0 cq17-waiting-list-balance.rq" ;
    hemo:9000014 "S_end = S_start + F_in - F_out" ;
    hemo:9000015 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><apply><csymbol cd=\"relation1\">eq</csymbol><ci>S_end</ci><apply><csymbol cd=\"arith1\">minus</csymbol><apply><csymbol cd=\"arith1\">plus</csymbol><ci>S_start</ci><ci>F_in</ci></apply><ci>F_out</ci></apply></apply></math>" ;
