hemo:7001998 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Expected cost of each risk group unchanged by selection"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "Enrolling a different mix of members changes the plan's average cost but not the expected cost of a member of any given group, so the profit measures the effect of the mix alone." ;
    hemo:9000009 "Expected cost of each risk group unchanged by selection" ;
