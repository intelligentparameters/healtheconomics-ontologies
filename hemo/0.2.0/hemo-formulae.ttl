        hemo:7003639 ;
    hemo:2000008 0.5 ;
    hemo:9000008 "Entering the prior variance of 1,000,000 as s2 corresponds to an unlimited sample and returns the per-person EVPI of about GBP 197.80 under normality, the upper limiting case." ;
    hemo:9000009 "Closed-form EVPI recovered with the prior variance of incremental net benefit" ;
    hemo:9000014 "m0 = 500; s2 = 1000000; Q_z = 0.30853754; s = 1000; z = 0.5; phi_z = 0.352065; EVSI = 197.8" ;
    hemo:9000018 "HE-EX-EVSI-008" ;
