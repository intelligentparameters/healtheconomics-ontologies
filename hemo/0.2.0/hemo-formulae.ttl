hemo:7000541 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Young population with a severe condition"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000007 ;
    hemo:1000037 hemo:7000542,
        hemo:7000543 ;
    hemo:1000038 hemo:7000544,
        hemo:7000545 ;
    hemo:2000008 0.05 ;
    hemo:9000008 "A general population with 20 remaining discounted QALYs and a condition leaving 1.5 gives an absolute shortfall of 18.5 and a proportional shortfall of 0.925, as in the article. The figures are illustrative." ;
    hemo:9000009 "Young population with a severe condition" ;
    hemo:9000014 "Q_h = 20; Q_c = 1.5; AS = 18.5; PS = 0.925" ;
    hemo:9000018 "HE-EX-ASF-003" ;
    hemo:9000023 "young-population-with-a-severe-condition" .

