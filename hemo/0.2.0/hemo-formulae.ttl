    hemo:1000037 hemo:7003448,
        hemo:7003449,
        hemo:7003450 ;
    hemo:1000038 hemo:7003451 ;
    hemo:2000008 0.00005 ;
    hemo:9000008 "Ten years of 1 counted at the start of each year and discounted at 3% are worth about 8.786 present years, Larson's discrete-time value for 10 years of life lost." ;
    hemo:9000009 "Larson's ten years counted at the start of each year at 3 per cent" ;
    hemo:9000014 "q = 1; r = 0.03; T = 10; Q_s = 8.7861" ;
    hemo:9000018 "HE-EX-DISC-004" ;
    hemo:9000023 "larson-s-ten-years-counted-at-the-start-of-each-year-at-3-per-cent" .

