    hemo:9000015 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><apply><csymbol cd=\"relation1\">eq</csymbol><ci>QALY_AUC</ci><apply><csymbol cd=\"arith1\">sum</csymbol><apply><csymbol cd=\"interval1\">integer_interval</csymbol><cn type=\"integer\">1</cn><ci>T</ci></apply><bind><csymbol cd=\"fns1\">lambda</csymbol><bvar><ci>t</ci></bvar><apply><csymbol cd=\"arith1\">times</csymbol><apply><csymbol cd=\"arith1\">divide</csymbol><apply><csymbol cd=\"arith1\">plus</csymbol><apply><csymbol cd=\"hemo1\" cdbase=\"https://healtheconomics.wiki/ontologies/hemo/cd\">element</csymbol><ci>u_start_t</ci><ci>t</ci></apply><apply><csymbol cd=\"hemo1\" cdbase=\"https://healtheconomics.wiki/ontologies/hemo/cd\">element</csymbol><ci>u_end_t</ci><ci>t</ci></apply></apply><cn type=\"integer\">2</cn></apply><apply><csymbol cd=\"hemo1\" cdbase=\"https://healtheconomics.wiki/ontologies/hemo/cd\">element</csymbol><ci>d_t</ci><ci>t</ci></apply></apply></bind></apply></apply></math>" ;
    hemo:9000016 "\\mathrm{QALY}_{\\mathrm{AUC}} = \\sum_{t=1}^{T} \\left[\\frac{u_{\\mathrm{start},t}_{t} + u_{\\mathrm{end},t}_{t}}{2} \\, d_{t}_{t}\\right]" .

