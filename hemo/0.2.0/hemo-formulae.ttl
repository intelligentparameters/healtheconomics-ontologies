    hemo:1000030 hemo:5000198,
        hemo:5000965 ;
    hemo:1000035 hemo:4000017 ;
    hemo:2000019 true ;
    hemo:9000014 "dom = (Delta_C <= tau_C) and (Delta_E >= -tau_E) and (Delta_C < -tau_C or Delta_E > tau_E); domd = (Delta_C >= -tau_C) and (Delta_E <= tau_E) and (Delta_C > tau_C or Delta_E < -tau_E); dup = (abs(Delta_C) <= tau_C) and (abs(Delta_E) <= tau_E); neither = 1 - dom - domd - dup" ;
    hemo:9000015 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><apply><csymbol cd=\"logic1\">and</csymbol><apply><csymbol cd=\"relation1\">eq</csymbol><ci>dom</ci><apply><csymbol cd=\"logic1\">and</csymbol><apply><csymbol cd=\"logic1\">and</csymbol><apply><csymbol cd=\"relation1\">leq</csymbol><ci>Delta_C</ci><ci>tau_C</ci></apply><apply><csymbol cd=\"relation1\">geq</csymbol><ci>Delta_E</ci><apply><csymbol cd=\"arith1\">unary_minus</csymbol><ci>tau_E</ci></apply></apply></apply><apply><csymbol cd=\"logic1\">or</csymbol><apply><csymbol cd=\"relation1\">lt</csymbol><ci>Delta_C</ci><apply><csymbol cd=\"arith1\">unary_minus</csymbol><ci>tau_C</ci></apply></apply><apply><csymbol cd=\"relation1\">gt</csymbol><ci>Delta_E</ci><ci>tau_E</ci></apply></apply></apply></apply><apply><csymbol cd=\"relation1\">eq</csymbol><ci>domd</ci><apply><csymbol cd=\"logic1\">and</csymbol><apply><csymbol cd=\"logic1\">and</csymbol><apply><csymbol cd=\"relation1\">geq</csymbol><ci>Delta_C</ci><apply><csymbol cd=\"arith1\">unary_minus</csymbol><ci>tau_C</ci></apply></apply><apply><csymbol cd=\"relation1\">leq</csymbol><ci>Delta_E</ci><ci>tau_E</ci></apply></apply><apply><csymbol cd=\"logic1\">or</csymbol><apply><csymbol cd=\"relation1\">gt</csymbol><ci>Delta_C</ci><ci>tau_C</ci></apply><apply><csymbol cd=\"relation1\">lt</csymbol><ci>Delta_E</ci><apply><csymbol cd=\"arith1\">unary_minus</csymbol><ci>tau_E</ci></apply></apply></apply></apply></apply><apply><csymbol cd=\"relation1\">eq</csymbol><ci>dup</ci><apply><csymbol cd=\"logic1\">and</csymbol><apply><csymbol cd=\"relation1\">leq</csymbol><apply><csymbol cd=\"arith1\">abs</csymbol><ci>Delta_C</ci></apply><ci>tau_C</ci></apply><apply><csymbol cd=\"relation1\">leq</csymbol><apply><csymbol cd=\"arith1\">abs</csymbol><ci>Delta_E</ci></apply><ci>tau_E</ci></apply></apply></apply><apply><csymbol cd=\"relation1\">eq</csymbol><ci>neither</ci><apply><csymbol cd=\"arith1\">minus</csymbol><apply><csymbol cd=\"arith1\">minus</csymbol><apply><csymbol cd=\"arith1\">minus</csymbol><cn type=\"integer\">1</cn><ci>dom</ci></apply><ci>domd</ci></apply><ci>dup</ci></apply></apply></apply></math>" ;
    hemo:9000016 "\\mathrm{dom} = \\left(\\Delta_{C} \\le \\tau_{C} \\land \\Delta_{E} \\ge -\\tau_{E}\\right) \\land \\left(\\Delta_{C} < -\\tau_{C} \\lor \\Delta_{E} > \\tau_{E}\\right) ;\\quad \\mathrm{domd} = \\left(\\Delta_{C} \\ge -\\tau_{C} \\land \\Delta_{E} \\le \\tau_{E}\\right) \\land \\left(\\Delta_{C} > \\tau_{C} \\lor \\Delta_{E} < -\\tau_{E}\\right) ;\\quad \\mathrm{dup} = \\left|\\Delta_{C}\\right| \\le \\tau_{C} \\land \\left|\\Delta_{E}\\right| \\le \\tau_{E} ;\\quad \\mathrm{neither} = 1 - \\mathrm{dom} - \\mathrm{domd} - \\mathrm{dup}" ;
    hemo:9000018 "HEMO-FM-DOMC-001" .

