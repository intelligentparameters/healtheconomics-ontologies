    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000039 hemo:6001018 ;
    rheo:2000001 65.720200000000006 .

hemo:7000960 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Atkinson EDE for programme T at epsilon of 2"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000007 ;
    hemo:1000037 hemo:7000961,
        hemo:7000962,
        hemo:7000963 ;
    hemo:1000038 hemo:7000964 ;
    hemo:2000008 0.00005 ;
    hemo:9000008 "Programme T gives QALE of 60.4 and 72.1 years. At epsilon of 2 the EDE is about 65.7334 years, above the 65.7202 for U, so the ranking by mean health, where U leads by 0.05 years, is reversed. In the article the switching value of epsilon is about 1.6." ;
    hemo:9000009 "Atkinson EDE for programme T at epsilon of 2" ;
    hemo:9000014 "h_i = [60.4,72.1]; n = 2; epsilon = 2; h_EDE = 65.7334" ;
    hemo:9000018 "HE-EX-ATK-004" ;
    hemo:9000023 "atkinson-ede-for-programme-t-at-epsilon-of-2" .

hemo:7000961 a owl:NamedIndividual,
        hemo:0000016 ;
    rdfs:label "h_i in the test Atkinson EDE for programme T at epsilon of 2"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000039 hemo:6001019 ;
    hemo:9000014 "[60.4, 72.1]" .

hemo:7000962 a owl:NamedIndividual,
        hemo:0000016 ;
    rdfs:label "n in the test Atkinson EDE for programme T at epsilon of 2"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000039 hemo:6001020 ;
