    dcterms:identifier "HE-CF-EVSI-001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000002 hemo:5000209,
        hemo:5000636,
        hemo:5000637,
        hemo:5000638 ;
    hemo:1000005 hemo:7005624,
        hemo:7005625,
