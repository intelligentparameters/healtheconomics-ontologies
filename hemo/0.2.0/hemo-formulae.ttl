hemo:7003640 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Closed-form EVSI with the two options equally preferred now"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000007 ;
    hemo:1000037 hemo:7003641,
        hemo:7003642 ;
    hemo:1000038 hemo:7003643,
        hemo:7003644,
        hemo:7003645,
        hemo:7003646,
        hemo:7003647 ;
    hemo:2000008 0.5 ;
    hemo:9000008 "With a prior mean of zero, z is zero, Q_z is 0.5 and EVSI is s times the density at zero, about 0.3989, or about GBP 230.33 per patient for 100 per arm. For a given s2 this is the largest EVSI any prior mean can give, because every result then decides the choice." ;
    hemo:9000009 "Closed-form EVSI with the two options equally preferred now" ;
    hemo:9000014 "m0 = 0; s2 = 333333.33; Q_z = 0.5; s = 577.350266; z = 0; phi_z = 0.398942; EVSI = 230.33" ;
    hemo:9000018 "HE-EX-EVSI-009" ;
    hemo:9000023 "closed-form-evsi-with-the-two-options-equally-preferred-now" .

