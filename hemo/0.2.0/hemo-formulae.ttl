hemo:7003689 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Same two subgroups with every equity weight set to 1"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000007 ;
    hemo:1000037 hemo:7003690,
        hemo:7003691,
        hemo:7003692,
        hemo:7003693 ;
    hemo:1000038 hemo:7003694,
        hemo:7003695,
        hemo:7003696 ;
    hemo:2000008 0.5 ;
    hemo:9000008 "With both weights equal to 1 the weighted values equal the group gains and the equity-weighted total is the unweighted 740 QALYs, the limiting case in which equity weighting changes nothing." ;
    hemo:9000009 "Same two subgroups with every equity weight set to 1" ;
    hemo:9000014 "w_1 = 1; Delta_E_1 = 180; w_2 = 1; Delta_E_2 = 560; V_1 = 180; V_2 = 560; Delta_E_w = 740" ;
    hemo:9000018 "HE-EX-EQWA-002" ;
    hemo:9000023 "same-two-subgroups-with-every-equity-weight-set-to-1" .

