    hemo:9000014 "w = 1 + (w_a - 1) * (AS >= AS_a or PS >= PS_a) + (w_b - w_a) * (AS >= AS_b or PS >= PS_b)" ;
    hemo:9000015 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><apply><csymbol cd=\"relation1\">eq</csymbol><ci>w</ci><apply><csymbol cd=\"arith1\">plus</csymbol><cn type=\"integer\">1</cn><apply><csymbol cd=\"arith1\">times</csymbol><apply><csymbol cd=\"arith1\">minus</csymbol><ci>w_a</ci><cn type=\"integer\">1</cn></apply><apply><csymbol cd=\"hemo1\" cdbase=\"https://healtheconomics.wiki/ontologies/hemo/cd\">indicator</csymbol><apply><csymbol cd=\"logic1\">or</csymbol><apply><csymbol cd=\"relation1\">geq</csymbol><ci>AS</ci><ci>AS_a</ci></apply><apply><csymbol cd=\"relation1\">geq</csymbol><ci>PS</ci><ci>PS_a</ci></apply></apply></apply></apply><apply><csymbol cd=\"arith1\">times</csymbol><apply><csymbol cd=\"arith1\">minus</csymbol><ci>w_b</ci><ci>w_a</ci></apply><apply><csymbol cd=\"hemo1\" cdbase=\"https://healtheconomics.wiki/ontologies/hemo/cd\">indicator</csymbol><apply><csymbol cd=\"logic1\">or</csymbol><apply><csymbol cd=\"relation1\">geq</csymbol><ci>AS</ci><ci>AS_b</ci></apply><apply><csymbol cd=\"relation1\">geq</csymbol><ci>PS</ci><ci>PS_b</ci></apply></apply></apply></apply></apply></apply></math>" ;
    hemo:9000016 "w = 1 + \\left(w_{a} - 1\\right) \\, \\mathbb{1}\\left[\\mathrm{AS} \\ge \\mathrm{AS}_{a} \\lor \\mathrm{PS} \\ge \\mathrm{PS}_{a}\\right] + \\left(w_{b} - w_{a}\\right) \\, \\mathbb{1}\\left[\\mathrm{AS} \\ge \\mathrm{AS}_{b} \\lor \\mathrm{PS} \\ge \\mathrm{PS}_{b}\\right]" .

