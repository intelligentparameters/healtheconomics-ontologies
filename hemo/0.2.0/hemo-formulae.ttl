hemo:5000886 a owl:NamedIndividual,
        hemo:0000010 ;
    rdfs:label "Stock balance over one period"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Gives the size of a stock at the end of a period, such as a waiting list, from its size at the start, the inflow and the outflow during the period."@en ;
    obo:IAO_0000116 "A HEMO-native record, for a formula the Functions and Formulae module does not yet hold. It is listed in module-backlog.md for the module curator."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
