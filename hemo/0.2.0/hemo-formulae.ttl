        hemo:6003398 ;
    hemo:1000007 hemo:6003393,
        hemo:6003394,
        hemo:6003395,
        hemo:6003396,
        hemo:6003397,
        hemo:6003398 ;
    hemo:1000008 hemo:6003392 ;
    hemo:1000009 hemo:7004689,
