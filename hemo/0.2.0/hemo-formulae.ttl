    rdfs:label "Risk equalisation receipt for a high-risk member of the article's pool"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000007 ;
    hemo:9000008 "For each high-risk member, expected to cost £6,000, the insurer receives £4,000. The fund collects 800 × 1,000 = 800,000 and pays out 200 × 4,000 = 800,000, as in the article." ;
    hemo:9000009 "Risk equalisation receipt for a high-risk member of the article's pool" ;
