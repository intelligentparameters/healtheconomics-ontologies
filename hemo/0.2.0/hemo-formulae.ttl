hemo:7003632 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Closed-form EVPI recovered with the prior variance of incremental net benefit"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
