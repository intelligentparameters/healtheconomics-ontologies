hemo:7000123 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Consistent timing convention"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "Every value is assigned to a time point using the same beginning-, middle- or end-of-period convention across alternatives." ;
    hemo:9000009 "Consistent timing convention" ;
    hemo:9000018 "HE-AS-DR-003" ;
    hemo:9000023 "consistent-timing-convention" .

hemo:7000124 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Complete included stream"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "The stream contains all relevant values within the justified time horizon; discounting does not correct omitted consequences." ;
    hemo:9000009 "Complete included stream" ;
    hemo:9000018 "HE-AS-DR-004" ;
    hemo:9000023 "complete-included-stream" .

hemo:7000125 a owl:NamedIndividual,
        hemo:0000014 ;
    rdfs:label "Time-zero value plus later values"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000004 hemo:5000190 ;
    hemo:1000040 hemo:4000019 ;
    hemo:9000008 "Excel NPV treats the first value in its range as occurring at the end of period 1, so a time-zero value is added separately." ;
    hemo:9000009 "Time-zero value plus later values" ;
    hemo:9000018 "HE-IM-DR-002" ;
    hemo:9000023 "time-zero-value-plus-later-values" ;
    hemo:9000024 "=TimeZeroValue+NPV(DiscountRate,Year1:YearN)" .

hemo:7000126 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Row-sum reconciliation"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000010 ;
    hemo:9000008 "Calculate each discounted value separately and sum the rows. Expected result: the reported total present value." ;
    hemo:9000009 "Row-sum reconciliation" ;
    hemo:9000018 "HE-VT-DR-003" ;
    hemo:9000023 "row-sum-reconciliation" ;
    hemo:9000024 "=SUM(DiscountedValues)" .

hemo:7000127 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Positive-rate ordering"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000009 ;
    hemo:9000008 "For non-negative future values and r greater than 0, confirm total present value does not exceed the undiscounted total. Expected result: TRUE." ;
    hemo:9000009 "Positive-rate ordering" ;
    hemo:9000018 "HE-VT-DR-004" ;
    hemo:9000023 "positive-rate-ordering" ;
    hemo:9000024 "=TotalPresentValue<=SUM(UndiscountedValues)" .

hemo:7000128 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Three-year cost stream"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000007 ;
    hemo:1000037 hemo:7000129,
        hemo:7000130,
        hemo:7000131,
        hemo:7000132 ;
    hemo:1000038 hemo:7000133 ;
    hemo:2000008 0.005 ;
    hemo:9000008 "Costs of £10,000 at time zero and £5,000 at the end of years 1 and 2 have a total present value of approximately £19,498 at 3.5%." ;
    hemo:9000009 "Three-year cost stream" ;
    hemo:9000014 "T = 2; r = 0.035; t = [0,1,2]; V_t = [10000,5000,5000]; PV_total = 19498.47" ;
    hemo:9000018 "HE-EX-DR-002" ;
    hemo:9000023 "three-year-cost-stream" .

