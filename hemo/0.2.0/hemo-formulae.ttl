    hemo:1000039 hemo:6002810 ;
    hemo:9000014 "[0.1, -0.2, 0.3, -0.1, 0.25]" .

hemo:7003871 a owl:NamedIndividual,
        hemo:0000016 ;
    rdfs:label "L_s in the test Article's five draws at GBP 25,000 per QALY as opportunity losses"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000039 hemo:6002808 ;
    hemo:9000014 "[0.0, 0.2, 0.0, 0.1, 0.0]" .

hemo:7003872 a owl:NamedIndividual,
        hemo:0000016 ;
    rdfs:label "EVPI in the test Article's five draws at GBP 25,000 per QALY as opportunity losses"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000039 hemo:6002811 ;
    rheo:2000001 0.06 .

hemo:7003873 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Article's five draws at GBP 35,000 per QALY as opportunity losses"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000007 ;
    hemo:1000037 hemo:7003874,
        hemo:7003875,
        hemo:7003876 ;
    hemo:1000038 hemo:7003877,
        hemo:7003878 ;
    hemo:2000008 0.5 ;
    hemo:9000008 "At GBP 35,000 per QALY the incremental cost of GBP 10,000 is worth about 0.2857 QALYs, so the drug's net benefit in the five draws is about 0.2143, minus 0.0857, 0.4143, 0.0143 and 0.3643 QALYs. Only draw 2 favours standard care, so the only loss is about 0.0857 QALYs and EVPI is about 0.0171 QALYs per patient, as in the article. This example is for reading, as its draw-by-draw lists may not run in the site calculator." ;
    hemo:9000009 "Article's five draws at GBP 35,000 per QALY as opportunity losses" ;
    hemo:9000014 "S = 5; NBmax_s = [0.2143,0,0.4143,0.0143,0.3643]; NBcur_s = [0.2143,-0.0857,0.4143,0.0143,0.3643]; L_s = [0,0.0857,0,0,0]; EVPI = 0.0171" ;
    hemo:9000018 "HE-EX-EVPI-002" ;
    hemo:9000023 "article-s-five-draws-at-gbp-35-000-per-qaly-as-opportunity-losses" .

hemo:7003874 a owl:NamedIndividual,
