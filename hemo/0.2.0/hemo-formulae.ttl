        hemo:6002483 ;
    hemo:1000007 hemo:6002480,
        hemo:6002481,
        hemo:6002482,
        hemo:6002483 ;
    hemo:1000008 hemo:6002478 ;
    hemo:1000009 hemo:7003172,
        hemo:7003173 ;
