    hemo:9000023 "australian-late-entry-loading-for-a-person-taking-out-hospital-cover-at-36" .

hemo:7001987 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Late-entry loading held at the 70% cap"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000007 ;
    hemo:9000008 "A person with 41 counted years, for example someone first insured in Ireland at 75, would reach 82% without the cap. The cap holds the loading at 70%, and the illustrative £2,000 premium becomes £3,400. Figures computed here for illustration." ;
    hemo:9000009 "Late-entry loading held at the 70% cap" ;
    hemo:9000014 "a = 0.02; y = 41; L_max = 0.70; P_0 = 2000; L = 0.70; P_L = 3400" ;
    hemo:9000018 "HE-EX-CRAT-011" ;
    hemo:9000023 "late-entry-loading-held-at-the-70-cap" .

hemo:7001988 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Payment fixed in advance of the member's actual costs"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "R_i does not rise with the costs the member actually incurs. If part of the payment follows actual costs, as in risk sharing, the gain from selection is smaller." ;
    hemo:9000009 "Payment fixed in advance of the member's actual costs" ;
    hemo:9000018 "HE-AS-CSKM-001" ;
    hemo:9000023 "payment-fixed-in-advance-of-the-member-s-actual-costs" .

hemo:7001989 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Plan information on expected cost beyond the payment formula"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "The plan can predict EC_i from information the payment does not use, such as chronic disease when the formula adjusts only for age. Without such information every member of a payment cell has the same expected profit and selection has nothing to act on." ;
    hemo:9000009 "Plan information on expected cost beyond the payment formula" ;
    hemo:9000018 "HE-AS-CSKM-002" ;
    hemo:9000023 "plan-information-on-expected-cost-beyond-the-payment-formula" .

hemo:7001990 a owl:NamedIndividual,
        hemo:0000014 ;
    rdfs:label "Expected profit per member from payment and expected cost in one Excel cell"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000004 hemo:5000438 ;
    hemo:1000040 hemo:4000019 ;
    hemo:9000008 "With the payment in a cell named Payment and the member's expected cost in a cell named ExpectedCost, Excel returns the expected profit; a negative result is an expected loss." ;
    hemo:9000009 "Expected profit per member from payment and expected cost in one Excel cell" ;
    hemo:9000018 "HE-IM-CSKM-001" ;
    hemo:9000023 "expected-profit-per-member-from-payment-and-expected-cost-in-one-excel-cell" ;
