    hemo:9000015 "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><apply><csymbol cd=\"relation1\">eq</csymbol><ci>A</ci><apply><csymbol cd=\"arith1\">sum</csymbol><apply><csymbol cd=\"interval1\">integer_interval</csymbol><cn type=\"integer\">1</cn><ci>T</ci></apply><bind><csymbol cd=\"fns1\">lambda</csymbol><bvar><ci>t</ci></bvar><apply><csymbol cd=\"arith1\">power</csymbol><apply><csymbol cd=\"arith1\">plus</csymbol><cn type=\"integer\">1</cn><ci>r</ci></apply><apply><csymbol cd=\"arith1\">unary_minus</csymbol><apply><csymbol cd=\"arith1\">minus</csymbol><ci>t</ci><ci>s</ci></apply></apply></apply></bind></apply></apply></math>" ;
