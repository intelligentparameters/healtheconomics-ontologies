        hemo:7007514,
        hemo:7007515 ;
    hemo:1000038 hemo:7000558 ;
    hemo:2000008 0.5 ;
    hemo:9000008 "Absolute shortfall of 5.93 and proportional shortfall of 0.50 are below both lower cut-offs, so the weight is 1." ;
    hemo:9000009 "Weight in the DSU hypothetical case" ;
    hemo:9000014 "AS = 5.93; PS = 0.50; w = 1" ;
    hemo:9000018 "HE-EX-ASF-005" ;
    hemo:9000023 "weight-in-the-dsu-hypothetical-case" .

