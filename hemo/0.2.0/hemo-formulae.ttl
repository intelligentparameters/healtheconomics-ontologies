hemo:7003452 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Article's 0.8 QALYs a year counted at the start of each year at 3.5 per cent"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000007 ;
    hemo:1000037 hemo:7003453,
        hemo:7003454,
        hemo:7003455 ;
    hemo:1000038 hemo:7003456 ;
    hemo:2000008 0.00005 ;
    hemo:9000008 "Counting the article's 0.8 QALYs a year for 30 years at the start of each year gives about 15.23 discounted QALYs instead of 14.71 (computed here for illustration)." ;
    hemo:9000009 "Article's 0.8 QALYs a year counted at the start of each year at 3.5 per cent" ;
    hemo:9000014 "q = 0.8; r = 0.035; T = 30; Q_s = 15.2286" ;
    hemo:9000018 "HE-EX-DISC-005" ;
    hemo:9000023 "article-s-0-8-qalys-a-year-counted-at-the-start-of-each-year-at-3-5-per-cent" .

hemo:7003453 a owl:NamedIndividual,
        hemo:0000016 ;
