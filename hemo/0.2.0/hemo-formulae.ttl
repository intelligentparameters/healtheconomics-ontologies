    hemo:1000035 hemo:4000018 ;
    hemo:2000019 true ;
    hemo:9000008 "Calculates the additional cost per additional unit of effect between each remaining alternative and the next less effective alternative." ;
    hemo:9000009 "Sequential incremental cost-effectiveness ratio" ;
    hemo:9000010 "National Institute for Health and Care Excellence. NICE technology appraisal and highly specialised technologies guidance: the manual (PMG36). Published 2022; last updated 31 March 2026. Chapter 4 Economic evaluation, sections 4.2.16 and 4.10.8 (fully incremental analysis with dominated and extendedly dominated technologies removed). https://www.nice.org.uk/process/pmg36/chapter/economic-evaluation-2" ;
    hemo:9000011 "Comparing every alternative with a common baseline. Using the same baseline for every ratio can retain dominated strategies and fails to construct the cost-effectiveness frontier." ;
    hemo:9000014 "ICER_i = (C_i - C_(i-1)) / (E_i - E_(i-1))" ;
    hemo:9000018 "HE-FM-CEA-001" ;
    hemo:9000023 "sequential-incremental-cost-effectiveness-ratio" .

hemo:5000179 a owl:NamedIndividual,
