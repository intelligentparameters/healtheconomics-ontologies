    rheo:2000001 14400.0 .

hemo:7000637 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Dutch costing manual absence longer than the friction period"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000007 ;
    hemo:1000037 hemo:7000638,
        hemo:7000639,
        hemo:7000640,
        hemo:7000641,
        hemo:7000642 ;
    hemo:1000038 hemo:7000643 ;
    hemo:2000008 0.005 ;
    hemo:9000008 "A person working 24 hours a week is absent for 150 calendar days. Losses are capped at the 115-day friction period and valued at the Dutch reference price of 39.88 euros an hour in 2022 prices, which already includes the elasticity adjustment, so e is 1. The cost is 15,724.11 euros, as in example 9 of the manual." ;
    hemo:9000009 "Dutch costing manual absence longer than the friction period" ;
    hemo:9000014 "D_a = 150; D_F = 115; H = 24; w = 39.88; e = 1; C_FC = 15724.11" ;
    hemo:9000018 "HE-EX-ABSN-004" ;
    hemo:9000023 "dutch-costing-manual-absence-longer-than-the-friction-period" .

hemo:7000638 a owl:NamedIndividual,
        hemo:0000016 ;
    rdfs:label "D_a in the test Dutch costing manual absence longer than the friction period"@en ;
