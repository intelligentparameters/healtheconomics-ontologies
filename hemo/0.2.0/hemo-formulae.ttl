    rdfs:comment "An OHEO QALY estimate is the output of this sum."@en ;
    owl:annotatedProperty hemo:9000001 ;
    owl:annotatedSource hemo:5000193 ;
    owl:annotatedTarget oheo:0000261 ;
    heao:9000001 heao:4000003 .

[] a owl:Axiom ;
