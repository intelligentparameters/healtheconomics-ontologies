    hemo:9000009 "Cost reconciliation" ;
    hemo:9000018 "HE-VT-EE-001" ;
    hemo:9000023 "cost-reconciliation" ;
    hemo:9000024 "=ComparatorCost+IncrementalCost" .

hemo:7000017 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Effect reconciliation"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000010 ;
    hemo:9000008 "Add comparator effect to incremental effect. Expected result: new-intervention effect." ;
    hemo:9000009 "Effect reconciliation" ;
    hemo:9000018 "HE-VT-EE-002" ;
    hemo:9000023 "effect-reconciliation" ;
    hemo:9000024 "=ComparatorEffect+IncrementalEffect" .

hemo:7000018 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Common-unit check"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000010 ;
    hemo:9000008 "Confirm that both alternatives use the same currency basis and outcome unit. Expected result: both checks pass." ;
    hemo:9000009 "Common-unit check" ;
    hemo:9000018 "HE-VT-EE-003" ;
    hemo:9000023 "common-unit-check" .

hemo:7000019 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Current care compared with a new intervention"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000007 ;
    hemo:9000008 "Current care costs £10,000 and produces 4.50 QALYs. The new intervention costs £14,000 and produces 4.80 QALYs. Incremental cost is £4,000 and incremental effect is 0.30 QALYs." ;
    hemo:9000009 "Current care compared with a new intervention" ;
    hemo:9000014 "C_new = 14000; C_comparator = 10000; E_new = 4.80; E_comparator = 4.50; Delta_C = 4000; Delta_E = 0.30" ;
    hemo:9000018 "HE-EX-EE-001" ;
    hemo:9000023 "current-care-compared-with-a-new-intervention" .

hemo:7000020 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Ordered by effectiveness"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "Alternatives are ordered from least to most effective before sequential comparisons are calculated." ;
    hemo:9000009 "Ordered by effectiveness" ;
    hemo:9000018 "HE-AS-CEA-001" ;
    hemo:9000023 "ordered-by-effectiveness" .

hemo:7000021 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Common outcome measure"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "Every alternative uses the same natural outcome definition and unit." ;
    hemo:9000009 "Common outcome measure" ;
    hemo:9000018 "HE-AS-CEA-002" ;
    hemo:9000023 "common-outcome-measure" .

hemo:7000022 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Strict dominance removed"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "Any alternative that costs no less and produces no more effect than another alternative, and is strictly worse on at least one of the two, is removed before sequential ICERs are calculated. This includes ties, such as equal cost with lower effect." ;
    hemo:9000009 "Strict dominance removed" ;
    hemo:9000018 "HE-AS-CEA-003" ;
    hemo:9000023 "strict-dominance-removed" .

hemo:7000023 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Extended dominance addressed"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "After strict dominance is removed, any alternative whose sequential ICER exceeds the sequential ICER of the next more effective alternative is removed as extendedly dominated. Sequential ICERs are then recalculated against the new adjacent alternatives, and the check is repeated until they increase with effectiveness." ;
    hemo:9000009 "Extended dominance addressed" ;
    hemo:9000018 "HE-AS-CEA-004" ;
    hemo:9000023 "extended-dominance-addressed" .

hemo:7000024 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Positive incremental effect"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "The denominator E_i minus E_(i-1) is greater than zero for every calculated sequential ICER." ;
    hemo:9000009 "Positive incremental effect" ;
    hemo:9000018 "HE-AS-CEA-005" ;
    hemo:9000023 "positive-incremental-effect" .

hemo:7000025 a owl:NamedIndividual,
        hemo:0000014 ;
    rdfs:label "Calculate a sequential ICER"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000004 hemo:5000177 ;
    hemo:1000040 hemo:4000019 ;
    hemo:9000008 "Excel divides sequential incremental cost by sequential incremental effect using named ranges and returns #N/A when the effect difference is not greater than zero." ;
    hemo:9000009 "Calculate a sequential ICER" ;
    hemo:9000018 "HE-IM-CEA-001" ;
    hemo:9000023 "calculate-a-sequential-icer" ;
    hemo:9000024 "=IF(CurrentEffect-PreviousEffect>0,(CurrentCost-PreviousCost)/(CurrentEffect-PreviousEffect),NA())" .

hemo:7000026 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Effect-order check"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000010 ;
    hemo:9000008 "Test whether each retained alternative produces more effect than the preceding alternative. Expected result: TRUE for every retained alternative." ;
    hemo:9000009 "Effect-order check" ;
    hemo:9000018 "HE-VT-CEA-001" ;
    hemo:9000023 "effect-order-check" ;
    hemo:9000024 "=CurrentEffect-PreviousEffect>0" .

hemo:7000027 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Dominance check"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000010 ;
    hemo:9000008 "Test whether each retained alternative costs more than the preceding, less effective alternative. Expected result: TRUE for every retained alternative, because a sequential incremental cost of zero or less means the preceding alternative is dominated, including the tie of equal cost with lower effect." ;
    hemo:9000009 "Dominance check" ;
    hemo:9000018 "HE-VT-CEA-002" ;
    hemo:9000023 "dominance-check" ;
    hemo:9000024 "=CurrentCost-PreviousCost>0" .

hemo:7000028 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Frontier check"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000010 ;
    hemo:9000008 "Confirm that sequential ICERs increase along the retained cost-effectiveness frontier. Expected result: each sequential ICER exceeds the preceding one." ;
    hemo:9000009 "Frontier check" ;
    hemo:9000018 "HE-VT-CEA-003" ;
    hemo:9000023 "frontier-check" .

hemo:7000029 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Sequential comparison of three alternatives"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000007 ;
    hemo:9000008 "Current care costs £10,000 and produces 8.0 life-years. Intervention A costs £12,500 and produces 8.5 life-years. Intervention B costs £16,000 and produces 8.8 life-years. Neither intervention is dominated and the ratios increase with effectiveness, so no option is removed. The sequential ICERs are £5,000 and approximately £11,667 per life-year gained. The calculation shows the first step, Intervention A against current care." ;
    hemo:9000009 "Sequential comparison of three alternatives" ;
    hemo:9000014 "C_i = 12500; C_(i-1) = 10000; E_i = 8.5; E_(i-1) = 8.0; ICER_i = 5000" ;
    hemo:9000018 "HE-EX-CEA-001" ;
    hemo:9000023 "sequential-comparison-of-three-alternatives" .

hemo:7000030 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Removing strict and extended dominance"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000007 ;
    hemo:9000008 "Five illustrative alternatives are measured in life-years. A costs £10,000 for 4.0, B costs £13,000 for 4.3, X costs £20,000 for 4.4, C costs £18,000 for 4.5 and D costs £22,000 for 4.8. Ordered by effect, X is strictly dominated by C, which costs less and produces more, so X is removed. The sequential ICERs are then £10,000 for B, £25,000 for C and approximately £13,333 for D per life-year gained. Because the ICER for C exceeds the ICER for D, C is extendedly dominated and removed. Recalculation gives £10,000 for B and £18,000 for D, which increase with effectiveness, so A, B and D form the frontier." ;
    hemo:9000009 "Removing strict and extended dominance" ;
    hemo:9000014 "C_A = 10000; E_A = 4.0; C_B = 13000; E_B = 4.3; C_X = 20000; E_X = 4.4; C_C = 18000; E_C = 4.5; C_D = 22000; E_D = 4.8; ICER_B = 10000; ICER_D = 18000; frontier = A, B, D" ;
    hemo:9000018 "HE-EX-CEA-002" ;
    hemo:9000023 "removing-strict-and-extended-dominance" .

hemo:7000031 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Relevant comparator for cost-utility analysis"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "The comparator represents the healthcare choice actually available to the decision-maker." ;
    hemo:9000009 "Relevant comparator for cost-utility analysis" ;
    hemo:9000018 "HE-AS-CUA-001" ;
    hemo:9000023 "relevant-comparator-for-cost-utility-analysis" .

hemo:7000032 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Consistent analytical basis for cost-utility analysis"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "Costs and QALYs for both alternatives use the same population, perspective, time horizon and applicable discounting conventions." ;
    hemo:9000009 "Consistent analytical basis for cost-utility analysis" ;
    hemo:9000018 "HE-AS-CUA-002" ;
    hemo:9000023 "consistent-analytical-basis-for-cost-utility-analysis" .

hemo:7000033 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Comparable QALY measurement"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "QALYs for both alternatives use compatible utility evidence and the same timing convention." ;
    hemo:9000009 "Comparable QALY measurement" ;
    hemo:9000018 "HE-AS-CUA-003" ;
    hemo:9000023 "comparable-qaly-measurement" .

hemo:7000034 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Positive incremental QALYs for threshold comparison"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "The ICUR reads as additional cost per QALY gained, and is compared with a threshold in the usual direction, only when Delta_QALY is greater than zero. When Delta_QALY is negative the ratio is the saving per QALY forgone and the threshold comparison reverses, and when Delta_QALY equals zero no ratio is calculated." ;
    hemo:9000009 "Positive incremental QALYs for threshold comparison" ;
    hemo:9000018 "HE-AS-CUA-004" ;
    hemo:9000023 "positive-incremental-qalys-for-threshold-comparison" .

hemo:7000035 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Dominance assessed"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "The signs of incremental cost and incremental QALYs are examined before the ratio is interpreted." ;
    hemo:9000009 "Dominance assessed" ;
    hemo:9000018 "HE-AS-CUA-005" ;
    hemo:9000023 "dominance-assessed" .

hemo:7000036 a owl:NamedIndividual,
        hemo:0000014 ;
    rdfs:label "Calculate cost per QALY gained"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000004 hemo:5000178 ;
    hemo:1000040 hemo:4000019 ;
    hemo:9000008 "Excel divides incremental cost by incremental QALYs using named ranges and returns #N/A when incremental QALYs equal zero." ;
    hemo:9000009 "Calculate cost per QALY gained" ;
    hemo:9000018 "HE-IM-CUA-001" ;
    hemo:9000023 "calculate-cost-per-qaly-gained" ;
    hemo:9000024 "=IF(IncrementalQALYs<>0,IncrementalCost/IncrementalQALYs,NA())" .

hemo:7000037 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Incremental QALY denominator check"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000010 ;
    hemo:9000008 "Test the sign of incremental QALYs before the ratio is interpreted. Expected result: TRUE, so the ICUR reads as cost per QALY gained. A negative value means the ratio is a saving per QALY forgone, and zero means no ratio is calculated." ;
    hemo:9000009 "Incremental QALY denominator check" ;
    hemo:9000018 "HE-VT-CUA-001" ;
    hemo:9000023 "incremental-qaly-denominator-check" ;
    hemo:9000024 "=IncrementalQALYs>0" .

hemo:7000038 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Ratio reconciliation"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000010 ;
    hemo:9000008 "Multiply the ICUR by incremental QALYs. Expected result: incremental cost within the stated rounding tolerance." ;
    hemo:9000009 "Ratio reconciliation" ;
    hemo:9000018 "HE-VT-CUA-002" ;
    hemo:9000023 "ratio-reconciliation" ;
    hemo:9000024 "=ICUR*IncrementalQALYs" .

hemo:7000039 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Incremental-position check"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000010 ;
    hemo:9000008 "Check the signs of incremental cost and incremental QALYs before interpreting the ratio. Expected result: the cost-effectiveness-plane position is identified." ;
    hemo:9000009 "Incremental-position check" ;
    hemo:9000018 "HE-VT-CUA-003" ;
    hemo:9000023 "incremental-position-check" .

hemo:7000040 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Cost per QALY gained"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000007 ;
    hemo:9000008 "Current care has discounted costs of £20,000 and produces 6.60 discounted QALYs. A new intervention has discounted costs of £28,000 and produces 7.10 discounted QALYs. Incremental cost is £8,000 and incremental QALYs are 0.50, so the ICUR is £16,000 per QALY gained." ;
    hemo:9000009 "Cost per QALY gained" ;
    hemo:9000014 "Delta_C = 8000; Delta_QALY = 0.50; ICUR = 16000" ;
    hemo:9000018 "HE-EX-CUA-001" ;
    hemo:9000023 "cost-per-qaly-gained" .

hemo:7000041 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Credible baseline"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "Costs and benefits are measured incrementally against a baseline that represents what would occur without the evaluated option." ;
    hemo:9000009 "Credible baseline" ;
    hemo:9000018 "HE-AS-CBA-001" ;
    hemo:9000023 "credible-baseline" .

hemo:7000042 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Consistent analytical perspective"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "Included costs and benefits follow the same stated perspective and affected population." ;
    hemo:9000009 "Consistent analytical perspective" ;
    hemo:9000018 "HE-AS-CBA-002" ;
    hemo:9000023 "consistent-analytical-perspective" .

hemo:7000043 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Common monetary basis"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "Benefits and costs use the same currency, price year, time horizon and timing convention." ;
    hemo:9000009 "Common monetary basis" ;
    hemo:9000018 "HE-AS-CBA-003" ;
    hemo:9000023 "common-monetary-basis" .

hemo:7000044 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "No double counting"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "Overlapping consequences and transfers are identified so that the same social effect is not counted more than once." ;
    hemo:9000009 "No double counting" ;
    hemo:9000018 "HE-AS-CBA-004" ;
    hemo:9000023 "no-double-counting" .

hemo:7000045 a owl:NamedIndividual,
        hemo:0000014 ;
    rdfs:label "Calculate net present value"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000004 hemo:5000179 ;
    hemo:1000040 hemo:4000019 ;
    hemo:9000008 "Excel subtracts present-value costs from present-value benefits using named ranges." ;
    hemo:9000009 "Calculate net present value" ;
    hemo:9000018 "HE-IM-CBA-001" ;
    hemo:9000023 "calculate-net-present-value" ;
    hemo:9000024 "=PVBenefits-PVCosts" .

hemo:7000046 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "NPV reconciliation"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000010 ;
    hemo:9000008 "Add present-value costs to net present value. Expected result: present-value benefits." ;
    hemo:9000009 "NPV reconciliation" ;
    hemo:9000018 "HE-VT-CBA-001" ;
    hemo:9000023 "npv-reconciliation" ;
    hemo:9000024 "=NPV+PVCosts" .

hemo:7000047 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Positive-value check"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000010 ;
    hemo:9000008 "Check whether net present value is greater than zero. Expected interpretation: monetised benefits exceed resource costs under the stated assumptions." ;
    hemo:9000009 "Positive-value check" ;
    hemo:9000018 "HE-VT-CBA-002" ;
    hemo:9000023 "positive-value-check" ;
    hemo:9000024 "=NPV>0" .

hemo:7000048 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Net present value of an option"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000007 ;
    hemo:9000008 "An option has present-value benefits of £251,505 and present-value resource costs of £133,168. Its net present value is £118,337." ;
    hemo:9000009 "Net present value of an option" ;
    hemo:9000014 "PV_B = 251505; PV_C = 133168; NPV = 118337" ;
    hemo:9000018 "HE-EX-CBA-001" ;
    hemo:9000023 "net-present-value-of-an-option" .

hemo:7000049 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Positive resource costs"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "Present-value resource costs are greater than zero because the ratio is undefined when the denominator equals zero." ;
    hemo:9000009 "Positive resource costs" ;
    hemo:9000018 "HE-AS-CBA-005" ;
    hemo:9000023 "positive-resource-costs" .

hemo:7000050 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Consistent cost-benefit classification"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "Items are classified consistently as resource costs or monetised benefits under the stated perspective." ;
    hemo:9000009 "Consistent cost-benefit classification" ;
    hemo:9000018 "HE-AS-CBA-006" ;
    hemo:9000023 "consistent-cost-benefit-classification" .

hemo:7000051 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Common monetary basis for the BCR"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "Benefits and costs use the same currency, price year, time horizon and timing convention." ;
    hemo:9000009 "Common monetary basis for the BCR" ;
    hemo:9000018 "HE-AS-CBA-007" ;
    hemo:9000023 "common-monetary-basis-for-the-bcr" .

hemo:7000052 a owl:NamedIndividual,
        hemo:0000014 ;
    rdfs:label "Calculate the benefit-cost ratio"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000004 hemo:5000180 ;
    hemo:1000040 hemo:4000019 ;
    hemo:9000008 "Excel divides present-value benefits by present-value resource costs using named ranges." ;
    hemo:9000009 "Calculate the benefit-cost ratio" ;
    hemo:9000018 "HE-IM-CBA-002" ;
    hemo:9000023 "calculate-the-benefit-cost-ratio" ;
    hemo:9000024 "=PVBenefits/PVCosts" .

hemo:7000053 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Denominator check"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000010 ;
    hemo:9000008 "Check present-value resource costs before division. Expected result: the value is greater than zero." ;
    hemo:9000009 "Denominator check" ;
    hemo:9000018 "HE-VT-CBA-003" ;
    hemo:9000023 "denominator-check" ;
    hemo:9000024 "=PVCosts>0" .

hemo:7000054 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Benefit-cost ratio reconciliation"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000010 ;
    hemo:9000008 "Multiply the benefit-cost ratio by present-value resource costs. Expected result: present-value benefits within the stated rounding tolerance." ;
    hemo:9000009 "Benefit-cost ratio reconciliation" ;
    hemo:9000018 "HE-VT-CBA-004" ;
    hemo:9000023 "benefit-cost-ratio-reconciliation" ;
    hemo:9000024 "=BCR*PVCosts" .

hemo:7000055 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Benefit-cost ratio of an option"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000007 ;
    hemo:9000008 "An option has present-value benefits of £251,505 and present-value resource costs of £133,168. Its benefit-cost ratio is approximately 1.89." ;
    hemo:9000009 "Benefit-cost ratio of an option" ;
    hemo:9000014 "PV_B = 251505; PV_C = 133168; BCR = 1.89" ;
    hemo:9000018 "HE-EX-CBA-002" ;
    hemo:9000023 "benefit-cost-ratio-of-an-option" .

hemo:7000056 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Equivalence evidence gate satisfied"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "Reliable comparative evidence shows that plausible differences in every decision-relevant outcome are too small to change the decision." ;
    hemo:9000009 "Equivalence evidence gate satisfied" ;
    hemo:9000018 "HE-AS-CMA-001" ;
    hemo:9000023 "equivalence-evidence-gate-satisfied" .

hemo:7000057 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Complete cost measurement"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "Total cost includes every material resource difference permitted by the stated analytical perspective." ;
    hemo:9000009 "Complete cost measurement" ;
    hemo:9000018 "HE-AS-CMA-002" ;
    hemo:9000023 "complete-cost-measurement" .

hemo:7000058 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Consistent costing basis"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "Alternatives use the same population, time horizon, currency, price year and applicable discounting convention." ;
    hemo:9000009 "Consistent costing basis" ;
    hemo:9000018 "HE-AS-CMA-003" ;
    hemo:9000023 "consistent-costing-basis" .

hemo:7000059 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Feasible alternatives"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "Every alternative in the comparison is available and relevant to the healthcare decision." ;
    hemo:9000009 "Feasible alternatives" ;
    hemo:9000018 "HE-AS-CMA-004" ;
    hemo:9000023 "feasible-alternatives" .

hemo:7000060 a owl:NamedIndividual,
        hemo:0000014 ;
    rdfs:label "Return the least-cost option"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000004 hemo:5000181 ;
    hemo:1000040 hemo:4000019 ;
    hemo:9000008 "Excel returns the option name associated with the minimum total cost after the equivalence gate is confirmed, and flags a tie when more than one option shares the minimum." ;
    hemo:9000009 "Return the least-cost option" ;
    hemo:9000018 "HE-IM-CMA-001" ;
    hemo:9000023 "return-the-least-cost-option" ;
    hemo:9000024 "=IF(EquivalenceGate<>1,\"CMA not valid\",IF(COUNTIF(TotalCosts,MIN(TotalCosts))>1,\"Equal lowest cost\",INDEX(OptionNames,MATCH(MIN(TotalCosts),TotalCosts,0))))" .

hemo:7000061 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Equivalence-gate check"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000009 ;
    hemo:9000008 "Confirm that the evidence-equivalence indicator equals 1 before comparing costs alone. Expected result: 1." ;
    hemo:9000009 "Equivalence-gate check" ;
    hemo:9000018 "HE-VT-CMA-001" ;
    hemo:9000023 "equivalence-gate-check" ;
    hemo:9000024 "=EquivalenceGate=1" .

hemo:7000062 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Minimum-cost reconciliation"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000009 ;
    hemo:9000008 "Look up the total cost of the selected alternative and compare it with the minimum value in TotalCosts. Expected result: TRUE." ;
    hemo:9000009 "Minimum-cost reconciliation" ;
    hemo:9000018 "HE-VT-CMA-002" ;
    hemo:9000023 "minimum-cost-reconciliation" ;
    hemo:9000024 "=INDEX(TotalCosts,MATCH(SelectedOption,OptionNames,0))=MIN(TotalCosts)" .

hemo:7000063 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Cost-completeness check"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000010 ;
    hemo:9000008 "Confirm that every material resource category under the stated perspective is included for each alternative. Expected result: no required category is missing." ;
    hemo:9000009 "Cost-completeness check" ;
    hemo:9000018 "HE-VT-CMA-003" ;
    hemo:9000023 "cost-completeness-check" .

hemo:7000064 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Selecting the least-cost equivalent option"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000007 ;
    hemo:9000008 "Reliable equivalence evidence supports a costs-only comparison. After acquisition, administration, monitoring and adverse-event costs are included, Treatment A costs £1,600 per patient and Treatment B costs £1,520 per patient. Treatment B is selected as the least-cost alternative, saving £80 per patient, although its acquisition price alone is £250 lower. Treatment B is alternative 2 in the calculation." ;
    hemo:9000009 "Selecting the least-cost equivalent option" ;
    hemo:9000014 "C_j = [1600,1520]; G = 1; j* = 2" ;
    hemo:9000018 "HE-EX-CMA-001" ;
    hemo:9000023 "selecting-the-least-cost-equivalent-option" .

hemo:7000065 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Comparable scenarios"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "Reference and adoption scenarios cover the same budget holder population and reporting period." ;
    hemo:9000009 "Comparable scenarios" ;
    hemo:9000018 "HE-AS-BIA-001" ;
    hemo:9000023 "comparable-scenarios" .

hemo:7000066 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Adoption-driven differences"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "The scenarios differ only where adoption is expected to change population flows, treatment mix, resource use, prices or implementation." ;
    hemo:9000009 "Adoption-driven differences" ;
    hemo:9000018 "HE-AS-BIA-002" ;
    hemo:9000023 "adoption-driven-differences" .

hemo:7000067 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Consistent monetary basis"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "Both scenarios use the same currency, price year and nominal-or-real convention." ;
    hemo:9000009 "Consistent monetary basis" ;
    hemo:9000018 "HE-AS-BIA-003" ;
    hemo:9000023 "consistent-monetary-basis" .

hemo:7000068 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Budget-relevant expenditure"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "Costs and savings are included only when they affect the stated budget holder during the specified period." ;
    hemo:9000009 "Budget-relevant expenditure" ;
    hemo:9000018 "HE-AS-BIA-004" ;
    hemo:9000023 "budget-relevant-expenditure" .

hemo:7000069 a owl:NamedIndividual,
        hemo:0000014 ;
    rdfs:label "Calculate periodic budget impact"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000004 hemo:5000182 ;
    hemo:1000040 hemo:4000019 ;
    hemo:9000008 "Excel subtracts reference-scenario expenditure from adoption-scenario expenditure for each period." ;
    hemo:9000009 "Calculate periodic budget impact" ;
    hemo:9000018 "HE-IM-BIA-001" ;
    hemo:9000023 "calculate-periodic-budget-impact" ;
    hemo:9000024 "=AdoptionExpenditure-ReferenceExpenditure" .

hemo:7000070 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Scenario reconciliation"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000010 ;
    hemo:9000008 "Add periodic budget impact to reference-scenario expenditure. Expected result: adoption-scenario expenditure." ;
    hemo:9000009 "Scenario reconciliation" ;
    hemo:9000018 "HE-VT-BIA-001" ;
    hemo:9000023 "scenario-reconciliation" ;
    hemo:9000024 "=ReferenceExpenditure+BudgetImpact" .

hemo:7000071 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Population comparability check"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000010 ;
    hemo:9000008 "Confirm that reference and adoption scenarios use the same covered population definition for period t. Expected result: definitions match." ;
    hemo:9000009 "Population comparability check" ;
    hemo:9000018 "HE-VT-BIA-002" ;
    hemo:9000023 "population-comparability-check" .

hemo:7000072 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Treatment-share check"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000010 ;
    hemo:9000008 "Sum mutually exclusive treatment shares within each scenario and period. Expected result: 100% of the relevant treated population." ;
    hemo:9000009 "Treatment-share check" ;
    hemo:9000018 "HE-VT-BIA-003" ;
    hemo:9000023 "treatment-share-check" ;
    hemo:9000024 "=SUM(TreatmentShares)" .

hemo:7000073 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Year-one expenditure increase"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000007 ;
    hemo:9000008 "Reference-scenario expenditure is £21,000,000 and adoption-scenario expenditure is £21,900,000. The year-one budget impact is a £900,000 expenditure increase." ;
    hemo:9000009 "Year-one expenditure increase" ;
    hemo:9000014 "t = 1; E_A_t = 21900000; E_R_t = 21000000; BI_t = 900000" ;
    hemo:9000018 "HE-EX-BIA-001" ;
    hemo:9000023 "year-one-expenditure-increase" .

hemo:7000074 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Complete period coverage"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "Every reporting period from 1 through T is included exactly once." ;
    hemo:9000009 "Complete period coverage" ;
    hemo:9000018 "HE-AS-BIA-005" ;
    hemo:9000023 "complete-period-coverage" .

hemo:7000075 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Consistent monetary basis across budget periods"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "Periodic impacts use a consistent currency and nominal-or-real convention before they are added." ;
    hemo:9000009 "Consistent monetary basis across budget periods" ;
    hemo:9000018 "HE-AS-BIA-006" ;
    hemo:9000023 "consistent-monetary-basis-across-budget-periods" .

hemo:7000076 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Undiscounted planning cash flows"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "Periodic budget impacts are normally reported as undiscounted cash flows unless the budget holder explicitly requires an additional present-value view." ;
    hemo:9000009 "Undiscounted planning cash flows" ;
    hemo:9000018 "HE-AS-BIA-007" ;
    hemo:9000023 "undiscounted-planning-cash-flows" .

hemo:7000077 a owl:NamedIndividual,
        hemo:0000014 ;
    rdfs:label "Calculate cumulative budget impact"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000004 hemo:5000183 ;
    hemo:1000040 hemo:4000019 ;
    hemo:9000008 "Excel sums the periodic budget-impact range across the planning horizon." ;
    hemo:9000009 "Calculate cumulative budget impact" ;
    hemo:9000018 "HE-IM-BIA-002" ;
    hemo:9000023 "calculate-cumulative-budget-impact" ;
    hemo:9000024 "=SUM(PeriodicBudgetImpact)" .

hemo:7000078 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Cumulative reconciliation"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000010 ;
    hemo:9000008 "Sum all periodic budget impacts independently. Expected result: reported cumulative budget impact." ;
    hemo:9000009 "Cumulative reconciliation" ;
    hemo:9000018 "HE-VT-BIA-004" ;
    hemo:9000023 "cumulative-reconciliation" ;
    hemo:9000024 "=SUM(PeriodicBudgetImpact)" .

hemo:7000079 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Period-count check"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000010 ;
    hemo:9000008 "Count the periodic budget-impact records. Expected result: T periods with no missing or duplicated period." ;
    hemo:9000009 "Period-count check" ;
    hemo:9000018 "HE-VT-BIA-005" ;
    hemo:9000023 "period-count-check" ;
    hemo:9000024 "=COUNT(PeriodicBudgetImpact)" .

hemo:7000080 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Three-year cumulative budget impact"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000007 ;
    hemo:9000008 "Annual budget impacts are £900,000, £1,200,000 and £1,500,000. The cumulative three-year budget impact is £3,600,000." ;
    hemo:9000009 "Three-year cumulative budget impact" ;
    hemo:9000014 "T = 3; BI_t = [900000,1200000,1500000]; CBI_T = 3600000" ;
    hemo:9000018 "HE-EX-BIA-002" ;
    hemo:9000023 "three-year-cumulative-budget-impact" .

hemo:7000081 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Representative person-level estimate"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "The mean attributable cost represents the affected population to which it is extrapolated." ;
    hemo:9000009 "Representative person-level estimate" ;
    hemo:9000018 "HE-AS-COI-001" ;
    hemo:9000023 "representative-person-level-estimate" .

hemo:7000082 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Consistent boundary"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "The per-person estimate and population count use the same case definition, perspective, jurisdiction and costing period." ;
    hemo:9000009 "Consistent boundary" ;
    hemo:9000018 "HE-AS-COI-002" ;
    hemo:9000023 "consistent-boundary" .

hemo:7000083 a owl:NamedIndividual,
        hemo:0000014 ;
    rdfs:label "Calculate bottom-up burden"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000004 hemo:5000184 ;
    hemo:1000040 hemo:4000019 ;
    hemo:9000008 "Excel multiplies mean attributable cost per affected person by the number of affected people." ;
    hemo:9000009 "Calculate bottom-up burden" ;
    hemo:9000018 "HE-IM-COI-001" ;
    hemo:9000023 "calculate-bottom-up-burden" ;
    hemo:9000024 "=MeanAttributableCost*AffectedPopulation" .

hemo:7000084 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Population-scaling reconciliation"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000010 ;
    hemo:9000008 "Divide population burden by the affected population. Expected result: mean attributable cost per affected person." ;
    hemo:9000009 "Population-scaling reconciliation" ;
    hemo:9000018 "HE-VT-COI-001" ;
    hemo:9000023 "population-scaling-reconciliation" ;
    hemo:9000024 "=PopulationBurden/AffectedPopulation" .

hemo:7000085 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Population-boundary check"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000010 ;
    hemo:9000008 "Confirm that the sample estimate and extrapolated population use the same case definition and period. Expected result: definitions match." ;
    hemo:9000009 "Population-boundary check" ;
    hemo:9000018 "HE-VT-COI-002" ;
    hemo:9000023 "population-boundary-check" .

hemo:7000086 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Bottom-up annual burden"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000007 ;
    hemo:9000008 "Mean attributable annual cost is £2,500 per affected person and 40,000 people are affected. Estimated annual population burden is £100 million." ;
    hemo:9000009 "Bottom-up annual burden" ;
    hemo:9000014 "c_bar_attr = 2500; N_aff = 40000; B_bottom = 100000000" ;
    hemo:9000018 "HE-EX-COI-001" ;
    hemo:9000023 "bottom-up-annual-burden" .

hemo:7000087 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Valid attributable fraction"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "The attributable fraction is supported by evidence relevant to the population, expenditure category and period." ;
    hemo:9000009 "Valid attributable fraction" ;
    hemo:9000018 "HE-AS-COI-003" ;
    hemo:9000023 "valid-attributable-fraction" .

hemo:7000088 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Compatible aggregate denominator"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "Aggregate expenditure covers the same services, population, jurisdiction and period represented by the attributable fraction." ;
    hemo:9000009 "Compatible aggregate denominator" ;
    hemo:9000018 "HE-AS-COI-004" ;
    hemo:9000023 "compatible-aggregate-denominator" .

hemo:7000089 a owl:NamedIndividual,
        hemo:0000014 ;
    rdfs:label "Calculate top-down burden"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000004 hemo:5000185 ;
    hemo:1000040 hemo:4000019 ;
    hemo:9000008 "Excel multiplies compatible aggregate expenditure by the disease-attributable fraction." ;
    hemo:9000009 "Calculate top-down burden" ;
    hemo:9000018 "HE-IM-COI-002" ;
    hemo:9000023 "calculate-top-down-burden" ;
    hemo:9000024 "=AggregateExpenditure*AttributableFraction" .

hemo:7000090 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Attributable-fraction bounds"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000009 ;
    hemo:9000008 "Check that the attributable fraction lies in the range 0 to 1 inclusive. Expected result: TRUE." ;
    hemo:9000009 "Attributable-fraction bounds" ;
    hemo:9000018 "HE-VT-COI-003" ;
    hemo:9000023 "attributable-fraction-bounds" ;
    hemo:9000024 "=AND(AttributableFraction>=0,AttributableFraction<=1)" .

hemo:7000091 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Top-down reconciliation"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000010 ;
    hemo:9000008 "Divide attributable burden by aggregate expenditure. Expected result: the disease-attributable fraction." ;
    hemo:9000009 "Top-down reconciliation" ;
    hemo:9000018 "HE-VT-COI-004" ;
    hemo:9000023 "top-down-reconciliation" ;
    hemo:9000024 "=AttributableBurden/AggregateExpenditure" .

hemo:7000092 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Top-down attributable expenditure"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000007 ;
    hemo:9000008 "Aggregate expenditure is £500 million and the supported disease-attributable fraction is 8%. Estimated attributable burden is £40 million." ;
    hemo:9000009 "Top-down attributable expenditure" ;
    hemo:9000014 "X_agg = 500000000; AF = 0.08; B_top = 40000000" ;
    hemo:9000018 "HE-EX-COI-002" ;
    hemo:9000023 "top-down-attributable-expenditure" .

hemo:7000093 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Mutually exclusive categories"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "Included cost categories do not overlap or count the same resource loss or consequence more than once." ;
    hemo:9000009 "Mutually exclusive categories" ;
    hemo:9000018 "HE-AS-COI-005" ;
    hemo:9000023 "mutually-exclusive-categories" .

hemo:7000094 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Common valuation basis"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "All categories use a compatible currency, price year, population, perspective and costing period." ;
    hemo:9000009 "Common valuation basis" ;
    hemo:9000018 "HE-AS-COI-006" ;
    hemo:9000023 "common-valuation-basis" .

hemo:7000095 a owl:NamedIndividual,
        hemo:0000014 ;
    rdfs:label "Calculate total economic burden"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000004 hemo:5000186 ;
    hemo:1000040 hemo:4000019 ;
    hemo:9000008 "Excel sums the included mutually exclusive burden categories." ;
    hemo:9000009 "Calculate total economic burden" ;
    hemo:9000018 "HE-IM-COI-003" ;
    hemo:9000023 "calculate-total-economic-burden" ;
    hemo:9000024 "=SUM(IncludedBurdenCategories)" .

hemo:7000096 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Category-total reconciliation"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000010 ;
    hemo:9000008 "Sum all included burden categories independently. Expected result: reported total economic burden." ;
    hemo:9000009 "Category-total reconciliation" ;
    hemo:9000018 "HE-VT-COI-005" ;
    hemo:9000023 "category-total-reconciliation" ;
    hemo:9000024 "=SUM(IncludedBurdenCategories)" .

hemo:7000097 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Overlap check"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000010 ;
    hemo:9000008 "Review the cost inventory for duplicated resources, losses or consequences. Expected result: no unresolved overlap." ;
    hemo:9000009 "Overlap check" ;
    hemo:9000018 "HE-VT-COI-006" ;
    hemo:9000023 "overlap-check" .

hemo:7000098 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Annual societal burden"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000007 ;
    hemo:9000008 "Direct medical costs are £60 million, direct non-medical costs £4 million, informal care £16 million and productivity losses £30 million. Total annual burden is £110 million." ;
    hemo:9000009 "Annual societal burden" ;
    hemo:9000014 "K = 4; B_k = [60000000,4000000,16000000,30000000]; B_total = 110000000" ;
    hemo:9000018 "HE-EX-COI-003" ;
    hemo:9000023 "annual-societal-burden" .

hemo:7000099 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Valid treatment shares"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "Treatment shares are non-negative and sum to 1 across the mutually exclusive comparator options." ;
    hemo:9000009 "Valid treatment shares" ;
    hemo:9000018 "HE-AS-COMP-001" ;
    hemo:9000023 "valid-treatment-shares" .

hemo:7000100 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Representative current practice"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "Treatment shares reflect the expected comparator mix for the relevant population, setting and period." ;
    hemo:9000009 "Representative current practice" ;
    hemo:9000018 "HE-AS-COMP-002" ;
    hemo:9000023 "representative-current-practice" .

hemo:7000101 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Consistent costing basis for mixed comparator"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "Option costs use the same perspective, population, time horizon, currency and price year." ;
    hemo:9000009 "Consistent costing basis for mixed comparator" ;
    hemo:9000018 "HE-AS-COMP-003" ;
    hemo:9000023 "consistent-costing-basis-for-mixed-comparator" .

hemo:7000102 a owl:NamedIndividual,
        hemo:0000014 ;
    rdfs:label "Calculate weighted comparator cost"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000004 hemo:5000187 ;
    hemo:1000040 hemo:4000019 ;
    hemo:9000008 "Excel multiplies each option cost by its treatment share and adds the products." ;
    hemo:9000009 "Calculate weighted comparator cost" ;
    hemo:9000018 "HE-IM-COMP-001" ;
    hemo:9000023 "calculate-weighted-comparator-cost" ;
    hemo:9000024 "=SUMPRODUCT(TreatmentShares,OptionCosts)" .

hemo:7000103 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Treatment-share reconciliation"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000010 ;
    hemo:9000008 "Sum comparator treatment shares. Expected result: 1." ;
    hemo:9000009 "Treatment-share reconciliation" ;
    hemo:9000018 "HE-VT-COMP-001" ;
    hemo:9000023 "treatment-share-reconciliation" ;
    hemo:9000024 "=SUM(TreatmentShares)" .

hemo:7000104 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Weighted-cost bounds"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000009 ;
    hemo:9000008 "Confirm that mixed-comparator cost lies between the minimum and maximum option costs when all shares are valid. Expected result: TRUE." ;
    hemo:9000009 "Weighted-cost bounds" ;
    hemo:9000018 "HE-VT-COMP-002" ;
    hemo:9000023 "weighted-cost-bounds" ;
    hemo:9000024 "=AND(MixedCost>=MIN(OptionCosts),MixedCost<=MAX(OptionCosts))" .

hemo:7000105 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Weighted comparator cost"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000007 ;
    hemo:9000008 "Current care consists of Option A for 70% of patients at £10,000 each and Option B for 30% at £15,000 each. Mixed-comparator cost is £11,500 per patient." ;
    hemo:9000009 "Weighted comparator cost" ;
    hemo:9000014 "J = 2; w_j = [0.70,0.30]; C_j = [10000,15000]; C_mix = 11500" ;
    hemo:9000018 "HE-EX-COMP-001" ;
    hemo:9000023 "weighted-comparator-cost" .

hemo:7000106 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Valid treatment shares for outcome weighting"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "Treatment shares are non-negative and sum to 1 across the mutually exclusive comparator options." ;
    hemo:9000009 "Valid treatment shares for outcome weighting" ;
    hemo:9000018 "HE-AS-COMP-004" ;
    hemo:9000023 "valid-treatment-shares-for-outcome-weighting" .

hemo:7000107 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Common outcome measure for mixed comparator"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "Every comparator option uses the same outcome definition, unit and timing convention." ;
    hemo:9000009 "Common outcome measure for mixed comparator" ;
    hemo:9000018 "HE-AS-COMP-005" ;
    hemo:9000023 "common-outcome-measure-for-mixed-comparator" .

hemo:7000108 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Representative current practice for outcome weighting"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "Treatment shares reflect the expected comparator mix for the relevant population, setting and period." ;
    hemo:9000009 "Representative current practice for outcome weighting" ;
    hemo:9000018 "HE-AS-COMP-006" ;
    hemo:9000023 "representative-current-practice-for-outcome-weighting" .

hemo:7000109 a owl:NamedIndividual,
        hemo:0000014 ;
    rdfs:label "Calculate weighted comparator outcome"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000004 hemo:5000188 ;
    hemo:1000040 hemo:4000019 ;
    hemo:9000008 "Excel multiplies each option outcome by its treatment share and adds the products." ;
    hemo:9000009 "Calculate weighted comparator outcome" ;
    hemo:9000018 "HE-IM-COMP-002" ;
    hemo:9000023 "calculate-weighted-comparator-outcome" ;
    hemo:9000024 "=SUMPRODUCT(TreatmentShares,OptionOutcomes)" .

hemo:7000110 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Outcome treatment-share reconciliation"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000010 ;
    hemo:9000008 "Sum comparator treatment shares. Expected result: 1." ;
    hemo:9000009 "Outcome treatment-share reconciliation" ;
    hemo:9000018 "HE-VT-COMP-003" ;
    hemo:9000023 "outcome-treatment-share-reconciliation" ;
    hemo:9000024 "=SUM(TreatmentShares)" .

hemo:7000111 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Weighted-outcome bounds"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000009 ;
    hemo:9000008 "Confirm that the mixed-comparator outcome lies between the minimum and maximum option outcomes when all shares are valid. Expected result: TRUE." ;
    hemo:9000009 "Weighted-outcome bounds" ;
    hemo:9000018 "HE-VT-COMP-004" ;
    hemo:9000023 "weighted-outcome-bounds" ;
    hemo:9000024 "=AND(MixedOutcome>=MIN(OptionOutcomes),MixedOutcome<=MAX(OptionOutcomes))" .

hemo:7000112 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Weighted comparator outcome"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000007 ;
    hemo:9000008 "Current care consists of Option A for 70% of patients with 4.20 QALYs and Option B for 30% with 4.60 QALYs. Mixed-comparator outcome is 4.32 QALYs." ;
    hemo:9000009 "Weighted comparator outcome" ;
    hemo:9000014 "J = 2; w_j = [0.70,0.30]; E_j = [4.20,4.60]; E_mix = 4.32" ;
    hemo:9000018 "HE-EX-COMP-002" ;
    hemo:9000023 "weighted-comparator-outcome" .

hemo:7000113 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Discrete annual compounding"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "The formula applies discrete annual discounting at one constant rate; t may be fractional when the timing convention permits. A schedule whose rate changes over time needs the product of the year-specific discount factors instead." ;
    hemo:9000009 "Discrete annual compounding" ;
    hemo:9000018 "HE-AS-DR-001" ;
    hemo:9000023 "discrete-annual-compounding" .

hemo:7000114 a owl:NamedIndividual,
        hemo:0000017 ;
    rdfs:label "Consistent price and rate basis"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:9000008 "Real values use a real discount rate and nominal values use a nominal discount rate." ;
    hemo:9000009 "Consistent price and rate basis" ;
    hemo:9000018 "HE-AS-DR-002" ;
    hemo:9000023 "consistent-price-and-rate-basis" .

hemo:7000115 a owl:NamedIndividual,
        hemo:0000014 ;
    rdfs:label "Calculate a single present value"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000004 hemo:5000189 ;
    hemo:1000040 hemo:4000019 ;
    hemo:9000008 "Enter the rate as 3.5% or 0.035, not 3.5." ;
    hemo:9000009 "Calculate a single present value" ;
    hemo:9000018 "HE-IM-DR-001" ;
    hemo:9000023 "calculate-a-single-present-value" ;
    hemo:9000024 "=Value/(1+DiscountRate)^Year" .

hemo:7000116 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Time-zero identity"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000010 ;
    hemo:9000008 "Set t to 0. Expected result: present value equals the undiscounted value." ;
    hemo:9000009 "Time-zero identity" ;
    hemo:9000018 "HE-VT-DR-001" ;
    hemo:9000023 "time-zero-identity" ;
    hemo:9000024 "=Value/(1+DiscountRate)^0" .

hemo:7000117 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Zero-rate identity"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000010 ;
    hemo:9000008 "Set r to 0. Expected result: present value equals the undiscounted value for any valid t." ;
    hemo:9000009 "Zero-rate identity" ;
    hemo:9000018 "HE-VT-DR-002" ;
    hemo:9000023 "zero-rate-identity" ;
    hemo:9000024 "=Value/(1+0)^Year" .

hemo:7000118 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Cost occurring in year 5"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
