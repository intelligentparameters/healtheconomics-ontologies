hemo:7003758 a owl:NamedIndividual,
        hemo:0000015 ;
    rdfs:label "Article's programme with DALYs discounted continuously at 3 per cent"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
    hemo:1000036 hemo:4000007 ;
    hemo:1000037 hemo:7003759,
        hemo:7003760,
        hemo:7003761,
        hemo:7003762 ;
    hemo:1000038 hemo:7003763,
        hemo:7003764 ;
    hemo:2000008 0.005 ;
    hemo:9000008 "With the article's discounted totals of 960.35 and 363.41 DALYs the programme averts 596.94 DALYs and costs about USD 744 per DALY averted, about 49% more than undiscounted, because the years saved by deaths prevented lie further in the future than the relief from lower severity." ;
    hemo:9000009 "Article's programme with DALYs discounted continuously at 3 per cent" ;
    hemo:9000014 "DALY_0 = 960.35; DALY_1 = 363.41; C_1 = 444000; C_0 = 0; DALY_av = 596.94; ICER = 743.79" ;
    hemo:9000018 "HE-EX-DALY-007" ;
    hemo:9000023 "article-s-programme-with-dalys-discounted-continuously-at-3-per-cent" .

