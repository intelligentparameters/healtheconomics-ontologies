        hemo:0000016 ;
    rdfs:label "Q (capital) in the test Thirty years of 0.8 QALYs counted at year end and discounted at 1.5 per cent"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo/hemo-formulae.owl> ;
