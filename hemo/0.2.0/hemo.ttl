hemo:0000002 a owl:Class ;
    rdfs:label "operator application"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A mathematical expression formed by applying one operator to an ordered list of argument expressions, the application object of OpenMath and the apply element of Content MathML."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Buswell et al. 2004; Carlisle et al. 2014" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:subClassOf hemo:0000001 .

hemo:0000004 a owl:Class ;
    rdfs:label "variable occurrence"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A mathematical expression that is one occurrence of a variable within a larger expression, the ci element of Content MathML."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Carlisle et al. 2014" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:subClassOf hemo:0000001 .

hemo:0000006 a owl:Class ;
    rdfs:label "equation"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A mathematical expression stating that two mathematical expressions are equal, the eq symbol of the OpenMath relation1 content dictionary."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Buswell et al. 2004" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:subClassOf hemo:0000001 .

hemo:0000007 a owl:Class ;
    rdfs:label "computational step"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An equation that is one ordered part of a formula or a computational function, whose left side names the output of the step and whose right side may use the outputs of earlier steps."@en ;
    obo:IAO_0000116 "The semicolon-separated parts of the calculator text on the website are computational steps, kept in their order."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Baines D. Formula, computational function, implementation, test and model use, note to the curator, 29 September 2026; Ashley M. HEMO stage 1 design, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:subClassOf hemo:0000006 .

hemo:0000012 a owl:Class ;
    rdfs:label "mathematical function"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An information content entity that names a mapping from input quantities to output quantities, written as a signature, which one or more formulas realise under different assumptions."@en ;
    obo:IAO_0000116 "The Functions and Formulae module of the website calls this record a Function. HEMO says mathematical function, so that it is never confused with a computational function (decision 1). The site label stays until its schema next changes."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000118 "function (site record type)"@en ;
    obo:IAO_0000119 "Baines D. Formula, computational function, implementation, test and model use, note to the curator, 29 September 2026; Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:subClassOf obo:IAO_0000030 .

hemo:0000013 a owl:Class ;
    rdfs:label "computational function"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An algorithm that is a reusable numerical procedure with stated inputs and outputs, which uses one or more formulas and may convert units and time, apply bounds and return several outputs, and whose inputs may differ from the variables of the formulas it uses."@en ;
    obo:IAO_0000116 "Darrin Baines's definition of 29 September 2026. One formula can feed several computational functions and one computational function can chain several formulas."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Baines D. Formula, computational function, implementation, test and model use, note to the curator, 29 September 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:subClassOf obo:IAO_0000064 .

hemo:0000017 a owl:Class ;
    rdfs:label "formula assumption"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An information content entity that states a condition under which a formula or a computational function holds, such as one constant rate in every period, and that belongs to the formula rather than to a real analysis."@en ;
    obo:IAO_0000116 "A RHEO modelling assumption (RHEO_0000020) is a different thing, a value or condition adopted in a real analysis."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Baines D. Formula, computational function, implementation, test and model use, note to the curator, 29 September 2026; Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:subClassOf obo:IAO_0000030 .

hemo:0000024 a owl:Class ;
    rdfs:label "model component"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An information content entity that is one part of a model structure, such as a state, a transition, a chance node, a compartment, an event or a cycle."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Siebert et al. 2012; Ashley M. HEMO stage 1 design, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:subClassOf obo:IAO_0000030 .

hemo:1000006 a owl:ObjectProperty ;
    rdfs:label "has mathematical variable"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a formula, a mathematical function, a computational function or a model structure to a variable that belongs to it."@en ;
