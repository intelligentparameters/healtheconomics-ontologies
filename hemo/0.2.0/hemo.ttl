hemo:0000030 a owl:Class ;
    rdfs:label "discount timing convention"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A categorical value specification naming when within each period an amount is counted for discounting, at the start, at the end, at the middle or as a continuous flow."@en ;
    obo:IAO_0000116 "A named input of every formula that depends on it, not an assumption hidden in prose. The start-of-period and end-of-period totals of a stream differ by exactly one plus the rate at any horizon. The within-cycle correction of a model's occupancy is a separate choice (reviewer B M3)."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Naimark et al. 2008; Elbasha and Chhatwal 2016; Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026; Baines D, Ashley M. Curator decisions on the HEMO 0.2.0 reviews, 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:subClassOf obo:OBI_0001930 .

hemo:0000033 a owl:Class ;
    rdfs:label "modelling level"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A categorical value specification naming the level at which a model type represents a population, as a cohort, as individuals, as aggregate stocks or as a mix."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Brennan et al. 2006; Siebert et al. 2012" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:subClassOf obo:OBI_0001930 .

hemo:0000034 a owl:Class ;
    rdfs:label "time treatment"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A categorical value specification naming how a model type treats time, not at all, in discrete cycles, continuously or as a mix."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Brennan et al. 2006; Siebert et al. 2012" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:subClassOf obo:OBI_0001930 .

hemo:0000038 a owl:Class ;
    rdfs:label "within-cycle correction"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A categorical value specification naming how the occupancy of each model cycle is estimated from the cohort at its start and at its end, with no correction, by the trapezoid rule, by Simpson's one-third rule or by a life-table method."@en ;
    obo:IAO_0000116 "Independent of the discount timing. A model can correct occupancy by the trapezoid rule and discount each cycle at its start, as the Build demonstrator does."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Naimark et al. 2008; Elbasha and Chhatwal 2016" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:subClassOf obo:OBI_0001930 .

hemo:4000029 a owl:NamedIndividual,
        hemo:0000034 ;
    rdfs:label "discrete time"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A time treatment of a model in which time passes in cycles of fixed length."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Brennan et al. 2006" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:0000029 a owl:Class ;
    rdfs:label "test kind"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A categorical value specification naming what a test case checks, a worked example, a limiting case, an identity check, a domain constraint check or a benchmark reproduction."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Baines D. Formula, computational function, implementation, test and model use, note to the curator, 29 September 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:subClassOf obo:OBI_0001930 .

hemo:0000032 a owl:Class ;
    rdfs:label "implementation language"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A categorical value specification naming the language or environment an implementation is written in, such as Excel, R, Python, JavaScript or SPARQL."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Baines D. Formula, computational function, implementation, test and model use, note to the curator, 29 September 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:subClassOf obo:OBI_0001930 .

hemo:0000035 a owl:Class ;
    rdfs:label "memory assumption"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A categorical value specification naming how far the next state in a model type depends on history, on the current state only, on the current state and the time spent in it, on any history, or not at all because the model has no states."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Sonnenberg and Beck 1993; Siebert et al. 2012" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:subClassOf obo:OBI_0001930 .

hemo:0000036 a owl:Class ;
    rdfs:label "interaction assumption"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A categorical value specification naming whether the people represented in a model type affect one another, not at all, through shared resources and queues, or directly as through a force of infection."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Brennan et al. 2006; Karnon et al. 2012; Pitman et al. 2012" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:subClassOf obo:OBI_0001930 .

hemo:4000036 a owl:NamedIndividual,
        hemo:0000036 ;
    rdfs:label "no interaction"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An interaction assumption that individuals do not affect one another."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Brennan et al. 2006" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:0000015 a owl:Class ;
    rdfs:label "test case"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An information content entity that states input values with an expected output and a tolerance, or a condition, that a formula, a computational function or an implementation must satisfy, and that is evidence that what it tests is stated and implemented correctly."@en ;
    obo:IAO_0000116 "Worked examples and validation tests on the website are test cases (decision 8). A test is evidence, not part of the identity of what it tests, as Darrin Baines's note of 29 September 2026 places tests after the implementation in his chain."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Baines D. Formula, computational function, implementation, test and model use, note to the curator, 29 September 2026; Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026; Baines D, Ashley M. Curator decisions on the HEMO 0.2.0 reviews, 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:subClassOf obo:IAO_0000030 .

hemo:0000026 a owl:Class ;
    rdfs:label "analysis wrapper"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An information content entity that names a calculation applied around any model structure, such as a cost-effectiveness analysis, a budget impact analysis, a probabilistic sensitivity analysis or a value of information analysis."@en ;
    obo:IAO_0000116 "Budget impact is an analysis, not a model structure."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Sullivan et al. 2014; Briggs et al. 2006; Ashley M. HEMO stage 1 design, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:subClassOf obo:IAO_0000030 .

hemo:0000028 a owl:Class ;
    rdfs:label "variable role"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A categorical value specification naming the part a variable plays in one formula or computational function, input, output, intermediate, index, parameter or constant."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO stage 1 design, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:subClassOf obo:OBI_0001930 .

hemo:4000039 a owl:NamedIndividual,
        hemo:0000037 ;
    rdfs:label "deterministic"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A stochasticity of a model that gives the same result for the same inputs on every run."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Briggs et al. 2006" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:4000088 a owl:NamedIndividual,
        hemo:0000021 ;
    rdfs:label "year"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A unit of measure, the Julian year of UCUM, the usual unit of time horizons, discounting periods and life-years."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Schadow and McDonald 2026; QUDT.org 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    hemo:9000006 <http://qudt.org/vocab/unit/YR> ;
    hemo:9000019 "a" .

hemo:4000093 a owl:NamedIndividual,
        hemo:0000021 ;
    rdfs:label "per year"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A unit of measure, the unit of a rate per year, such as a discount rate or an event rate."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Schadow and McDonald 2026; QUDT.org 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    hemo:9000006 <http://qudt.org/vocab/unit/PER-YR> ;
    hemo:9000019 "/a" ;
    hemo:9000029 "1/a",
        "a-1" .

hemo:0000020 a owl:Class ;
    rdfs:label "monetary quantity kind"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A quantity kind whose values are amounts of money, alone or per unit of something else, and are meaningful only with a currency code and a price year."@en ;
    obo:IAO_0000116 "UCUM has no currency units. As in RHEO, money is recorded as a UCUM code for the part that is not money, an ISO 4217 currency code and a price year."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Turner et al. 2019; Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:subClassOf hemo:0000019 .

hemo:0000001 a owl:Class ;
    rdfs:label "mathematical expression"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An information content entity that is a well-formed combination of symbols, numbers and operators denoting a quantity, a truth value or a set, such as one plus the discount rate raised to the power minus t."@en ;
    obo:IAO_0000116 "Aligned with an OpenMath object and a Content MathML expression. The mathematical expression branch of the Systems Biology Ontology (SBO_0000064) is a candidate alignment, see the SSSOM file."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Buswell et al. 2004; Carlisle et al. 2014" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:subClassOf obo:IAO_0000030 .

hemo:0000018 a owl:Class ;
    rdfs:label "variable"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An information content entity that is a named symbol of one formula, mathematical function, computational function or model structure, standing for a quantity of a stated kind in a stated unit and having a stated role there."@en ;
    obo:IAO_0000116 "A variable is scoped to one record. The r of one discounting formula and the r of another are two variables that denote the same HEO concept."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Carlisle et al. 2014; Ashley M. HEMO stage 1 design, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:subClassOf obo:IAO_0000030 .

hemo:0000025 a owl:Class ;
    rdfs:label "model type"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An information content entity that names a kind of model structure by its mathematical features, the level at which it represents a population, its treatment of time, its memory, whether individuals interact and whether it is deterministic or stochastic."@en ;
    obo:IAO_0000116 "HEMO owns the model types (decision 6). HEO keeps the words, mapped in the SSSOM file. A feature may take more than one value where the type allows it. Model types are individuals, a value partition, so that HEMO needs no punning. Defined classes would be needed if structures were ever to be classified from their features by a reasoner. A RHEO model version gets its model type through has implemented model type, the chain of implements model structure and has model type, so that RHEO need not import HEMO."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Brennan et al. 2006; Roberts et al. 2012; Caro et al. 2012; Siebert et al. 2012; Karnon et al. 2012; Pitman et al. 2012" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:subClassOf obo:IAO_0000030 .

hemo:0000021 a owl:Class ;
    rdfs:label "unit of measure"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A measurement unit label that names a unit in which a quantity is expressed, identified by its UCUM code and aligned with a QUDT unit where one exists."@en ;
    obo:IAO_0000116 "RHEO has unit code (RHEO_2000092) uses the same UCUM codes, written in the same way."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Schadow and McDonald 2026; QUDT.org 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:subClassOf obo:IAO_0000003 .

hemo:4000086 a owl:NamedIndividual,
        hemo:0000021 ;
    rdfs:label "unit one"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A unit of measure, the unit of a dimensionless number, such as a probability, a proportion, a utility or a ratio."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Schadow and McDonald 2026; QUDT.org 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    hemo:9000006 <http://qudt.org/vocab/unit/ONE> ;
    hemo:9000019 "1" .

hemo:0000011 a owl:Class ;
    rdfs:label "operator"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An information content entity that names one mathematical operation, identified by a symbol of an OpenMath content dictionary or, where no standard symbol exists, by a symbol of the HEMO content dictionary hemo1."@en ;
    obo:IAO_0000116 "Seven operations common in health economics have no OpenMath symbol that fits, the sequence element, the vector and matrix product, the indicator of a condition, argmax, argmin, the expectation over the draws of an analysis and the standard normal distribution function, so HEMO defines them in hemo1. The mean of a list uses the OpenMath symbol s_data1 mean applied to the list by fns2 apply_to_list."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Buswell et al. 2004" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:subClassOf obo:IAO_0000030 .

hemo:9000007 a owl:AnnotationProperty ;
    rdfs:label "is on measurement scale type"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a quantity kind to the OHEO measurement scale type its values lie on, which decides which operations are meaningful, so that a ratio of two values on an interval scale, such as two MCDA value scores, is flagged."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:0000019 a owl:Class ;
    rdfs:label "quantity kind"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An information content entity that names a kind of quantity a variable can stand for, such as a probability, a rate per unit time, a duration, an amount of money or a number of QALYs, which fixes the dimension of the quantity and which operations on it are meaningful."@en ;
    obo:IAO_0000116 "UCUM treats an annotation such as {QALY} as dimensionless, so a QALY and a life-year would pass a unit check as the same thing. The quantity kind is recorded beside the unit to tell them apart (decision 4). The dimension vectors are HEMO's own, with health-adjusted time Q and wellbeing-adjusted time W kept apart from time T. UCUM codes are for exchange and display."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "QUDT.org 2026; Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:subClassOf obo:IAO_0000030 .

obo:IAO_0000125 a owl:NamedIndividual ;
    rdfs:label "pending final vetting"@en .

<https://healtheconomics.wiki/ontologies/hemo> a owl:Ontology ;
    dcterms:bibliographicCitation "Baines D, Ashley M. Health Economics Mathematics Ontology (HEMO), version 0.1.0. Intelligent Parameters Ltd; 2026. https://healtheconomics.wiki/ontologies/hemo/0.2.0/hemo.owl. Licence CC BY 4.0." ;
    dcterms:created "2026-10-18"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    dcterms:description "HEMO, the Health Economics Mathematics Ontology, holds the mathematics the other ontologies of the healtheconomics.wiki family lean on. It answers one question, how a thing is formally represented. A formula states one or more ordered equations, and its identity is that expression with its assumptions and its domain of validity. Its tests are the evidence that it is stated and implemented correctly. A mathematical function is the signature that formulas realise. A computational function, in Darrin Baines's sense, is a reusable numerical procedure that uses formulas, and an implementation is its executable form in Excel, R, Python, JavaScript or SPARQL. Every variable has a role, a quantity kind and a unit of measure with its UCUM code, and money is a currency code and a price year as in RHEO. Expressions are written as the calculator text of the website, parsed into strict Content MathML with OpenMath symbols for their meaning, with LaTeX for display only. Model structures, model components and model types defined by their mathematical features are HEMO's. HEMO holds no values from evidence and makes no causal claim. A variable takes a real value from a RHEO model parameter through a parameter binding on the model version, takes a weight from HEAO for a value judgement, and marks the RHEO record that holds any causal claim its term carries. The formula catalogue, hemo-formulae.owl, is generated from the Functions and Formulae module of the website by a script on every release, with stable identifiers. Every relationship HEMO makes to another ontology is typed with one of the five linking kinds of HEAO 0.2.0, definitional, representational, computational, causal or valuational. Policy figures, such as NICE's severity cut-offs, are inputs of HEMO's formulas and never constants inside them."@en ;
    dcterms:issued "2026-10-18"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-19"^^xsd:date ;
    dcterms:publisher "Intelligent Parameters Ltd" ;
    dcterms:title "Health Economics Mathematics Ontology (HEMO)"@en ;
    vann:preferredNamespacePrefix "hemo" ;
    vann:preferredNamespaceUri "https://healtheconomics.wiki/ontologies/hemo/HEMO_" ;
    rdfs:comment "First release (status alpha) for review by its creators and three independent reviewers. HEMO imports OHEO 0.3.0, RHEO 0.4.0 with its uncertainty module, which imports BFO 2020 (ISO/IEC 21838-2), and the five linking kinds of HEAO 0.2.0 as a small extract, so that HEMO does not import all of HEAO for them. The BFO, IAO, COB, OBI and STATO terms RHEO and OHEO declare are reused. IAO measurement unit label and datum label are declared here from IAO. Term IRIs follow the family pattern https://healtheconomics.wiki/ontologies/hemo/HEMO_ and seven digits. Load hemo-formulae.owl for the formula catalogue."@en ;
    rdfs:seeAlso <https://healtheconomics.wiki/ontologies/heao>,
        <https://healtheconomics.wiki/ontologies/heo>,
        <https://healtheconomics.wiki/ontologies/heto>,
        <https://healtheconomics.wiki/ontologies/oheo>,
        <https://healtheconomics.wiki/ontologies/rheo> ;
    owl:imports <https://healtheconomics.wiki/ontologies/hemo/0.2.0/imports/heao-linking-kinds.owl>,
        <https://healtheconomics.wiki/ontologies/oheo/0.3.0/oheo.owl>,
        <https://healtheconomics.wiki/ontologies/rheo/0.4.0/rheo-uncertainty.owl>,
        <https://healtheconomics.wiki/ontologies/rheo/0.4.0/rheo.owl> ;
    owl:versionIRI <https://healtheconomics.wiki/ontologies/hemo/0.2.0/hemo.owl> ;
    owl:versionInfo "0.2.0 (alpha)" ;
    foaf:homepage <https://healtheconomics.wiki/ontologies/hemo> .

<https://orcid.org/0009-0006-0231-3731> rdfs:label "Michelle Ashley" .

