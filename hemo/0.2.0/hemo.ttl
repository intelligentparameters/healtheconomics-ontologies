hemo:1000026 a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "is special case of"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a formula to a more general formula that reduces to it when some of its inputs take fixed values, such as constant-rate exponential survival as a special case of Weibull survival."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    heao:9000001 heao:4000003 .

hemo:1000027 a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "is algebraically equivalent to"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a formula to another formula that gives the same outputs for every input on their shared domain."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    heao:9000001 heao:4000003 .

hemo:1000028 a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "is inverse of"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a formula to another formula that recovers its inputs from its outputs, such as a rate to a probability and a probability to a rate."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    heao:9000001 heao:4000003 .

hemo:1000029 a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "approximates"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a formula to another formula whose result it approaches under a stated condition, such as a trapezoid sum approximating an integral."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    heao:9000001 heao:4000003 .

hemo:1000030 a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "is derived from"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a formula to another formula from which it follows by algebra, such as a closed-form annuity from the sum of single present values."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    heao:9000001 heao:4000003 .

hemo:1000031 a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "feeds"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a formula or a computational function to another whose input is its output, building the dependency graph of a calculation."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
