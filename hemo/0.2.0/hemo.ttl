    hemo:9000005 <https://healtheconomics.wiki/ontologies/hemo/cd/hemo1#argmin> ;
    hemo:9000021 "argmin" .

hemo:4000083 a owl:NamedIndividual,
        hemo:0000011 ;
    rdfs:label "expectation"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An operator of the HEMO content dictionary hemo1, the expected value of an expression over a stated distribution or over the draws of a probabilistic analysis. OpenMath s_dist1 mean takes the function describing a distribution, while HEMO's expectation is often taken over the draws of a probabilistic analysis, so HEMO keeps its own symbol."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
