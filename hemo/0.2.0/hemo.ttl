hemo:4000174 a owl:NamedIndividual,
        hemo:0000038 ;
    rdfs:label "no within-cycle correction"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A within-cycle correction of none, in which the occupancy of each cycle is the cohort at its start or at its end."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Naimark et al. 2008; Elbasha and Chhatwal 2016" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:4000175 a owl:NamedIndividual,
        hemo:0000038 ;
    rdfs:label "trapezoidal within-cycle correction"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A within-cycle correction in which the occupancy of each cycle is the mean of its start and end occupancy, the half-cycle correction by the trapezoid rule."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Naimark et al. 2008; Elbasha and Chhatwal 2016" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:4000176 a owl:NamedIndividual,
        hemo:0000038 ;
    rdfs:label "Simpson one-third rule correction"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A within-cycle correction in which occupancy is integrated over cycles by Simpson's one-third rule, which Elbasha and Chhatwal recommend over the trapezoid rule."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Elbasha and Chhatwal 2016" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:4000177 a owl:NamedIndividual,
        hemo:0000038 ;
    rdfs:label "life-table within-cycle correction"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A within-cycle correction in which the occupancy of each cycle is estimated by the life-table method, from those alive at its start less half of those who leave during it."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Elbasha and Chhatwal 2016" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

