    rdfs:label "dynamic transmission compartmental model"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A model type of a structure in which compartments of an open population exchange members at rates that depend on the number infectious, through the force of infection, in continuous time or by difference equations."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Pitman et al. 2012" ;
