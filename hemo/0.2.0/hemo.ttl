hemo:4000134 a owl:NamedIndividual,
        hemo:0000019 ;
    rdfs:label "utility"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A quantity kind whose values are preference-based health state values with 1 for full health and 0 for dead, which can be below 0 and cannot exceed 1, and which give QALYs when multiplied by time. HEMO reads 0 for dead as the true zero of the scale, so that QALY totals, their ratios and proportional shortfalls are meaningful, a reading for the curator to confirm."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "QUDT.org 2026; Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    hemo:1000015 hemo:4000086 ;
    hemo:1000056 hemo:4000086 ;
    hemo:2000012 1.0 ;
    hemo:9000006 <http://qudt.org/vocab/quantitykind/Dimensionless> ;
    hemo:9000007 oheo:0000113 ;
    hemo:9000020 "Q T-1" .

