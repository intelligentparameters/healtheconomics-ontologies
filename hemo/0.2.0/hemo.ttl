    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:9000023 a owl:AnnotationProperty ;
    rdfs:label "has title key"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "The key the site importer derives from a module title, its lower-case letters and digits joined by hyphens, which must be unique across the module."@en ;
