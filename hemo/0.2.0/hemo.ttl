    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:subClassOf obo:OBI_0001930 .

hemo:0000037 a owl:Class ;
    rdfs:label "stochasticity"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A categorical value specification naming whether a model type gives the same result on every run for the same inputs or a result that varies with random draws of individual events, first-order randomness, apart from parameter uncertainty, which the probabilistic sensitivity analysis wrapper handles."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Brennan et al. 2006; Briggs et al. 2006" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:subClassOf obo:OBI_0001930 .

