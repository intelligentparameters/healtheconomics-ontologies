hemo:4000033 a owl:NamedIndividual,
        hemo:0000035 ;
    rdfs:label "current state and time in state"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A memory assumption that the next state depends on the current state and on the time spent in it, as with tunnel states."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Siebert et al. 2012" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:4000037 a owl:NamedIndividual,
