hemo:9000025 a owl:AnnotationProperty ;
    rdfs:label "has unit normalisation basis"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "How the quantity kind and unit of a variable were set, stated by HEMO for a fully formalised formula, or proposed by a named rule from the module's unit text and not yet reviewed."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:9000026 a owl:AnnotationProperty ;
    rdfs:label "takes input of type"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a formula, a computational function or a model structure to a term of another ontology of the healtheconomics.wiki family whose records supply one of its inputs or constraints, such as a RHEO discounting specification supplying a discount rate. Each assertion carries its linking kind and a reason as an axiom annotation."@en ;
