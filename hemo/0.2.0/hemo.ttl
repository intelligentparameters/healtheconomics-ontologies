obo:IAO_0000003 a owl:Class ;
    rdfs:label "measurement unit label"@en ;
    obo:IAO_0000115 "A measurement unit label is as a label that is part of a scalar measurement datum and denotes a unit of measure."@en ;
    obo:IAO_0000412 obo:iao.owl ;
    rdfs:isDefinedBy obo:iao.owl ;
    rdfs:subClassOf obo:IAO_0000009 .

obo:IAO_0000009 a owl:Class ;
    rdfs:label "datum label"@en ;
    obo:IAO_0000115 "A label is a symbol that is part of some other datum and is used to either partially define the denotation of that datum or to provide a means for identifying the datum as a member of the set of data with the same label"@en ;
    obo:IAO_0000412 obo:iao.owl ;
    rdfs:isDefinedBy obo:iao.owl ;
    rdfs:subClassOf obo:IAO_0000030 .

hemo:0000005 a owl:Class ;
    rdfs:label "numeric literal"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A mathematical expression that is one number written as a constant within a larger expression, the cn element of Content MathML."@en ;
    obo:IAO_0000116 "HEMO holds no real values from evidence. Numeric literals are constants of the mathematics, such as the 1 in one minus a probability, the 2 of a half-cycle correction or the 7 days of a week."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Carlisle et al. 2014" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:subClassOf hemo:0000001 .

hemo:0000009 a owl:Class ;
    rdfs:label "constraint"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A mathematical expression stating an order or a membership relation that values must satisfy, such as a probability lying between 0 and 1, used to state a domain of validity or a check."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Buswell et al. 2004" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:subClassOf hemo:0000001 .

