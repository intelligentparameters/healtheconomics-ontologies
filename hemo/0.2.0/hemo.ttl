hemo:4000186 a owl:NamedIndividual,
        hemo:0000019 ;
    rdfs:label "discount timing offset"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A quantity kind whose values between 0 and 1 say when within each period its amount is counted for discounting, 0 at the end of the period and 1 at its start, so that 0.5 counts it at the middle."@en ;
