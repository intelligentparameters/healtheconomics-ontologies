hemo:1000050 a owl:ObjectProperty ;
    rdfs:label "is bound to model parameter"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a variable of a formula to the RHEO model parameter whose value it takes, where only one model uses the formula, such as in a HEMO test. A variable of a structure that several models share is bound through a parameter binding on each model version."@en ;
    obo:IAO_0000116 "Kept for HEMO tests and single-model formulas. A model structure that several model versions share is bound through parameter bindings on each version."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
