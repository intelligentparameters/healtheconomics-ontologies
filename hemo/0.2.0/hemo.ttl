    hemo:9000005 <https://healtheconomics.wiki/ontologies/hemo/cd/hemo1#indicator> ;
    hemo:9000021 "(condition)" .

hemo:4000081 a owl:NamedIndividual,
        hemo:0000011 ;
    rdfs:label "argument of the maximum"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An operator of the HEMO content dictionary hemo1, the member of a set of options at which an expression in a bound variable is greatest, such as the option with the highest net monetary benefit. It binds the variable that runs over the options."@en ;
    obo:IAO_0000116 "A binder in the content dictionary hemo1, like a sum, taking a set of options and a lambda expression in the bound variable."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
