    rdfs:label "dimensionless parameter"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A quantity kind whose values are dimensionless constants of a functional form, such as an inequality aversion parameter or a hyperbolic discounting parameter."@en ;
