hemo:0000010 a owl:Class ;
    rdfs:label "formula"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An information content entity that states one or more ordered equations, its computational steps, giving output variables from input variables under stated assumptions and a stated domain of validity, and whose identity is that expression with those assumptions and that domain."@en ;
    obo:IAO_0000116 "The Functions and Formulae module of the website calls a formula an Applied Formula. Two formulas with the same expression and different assumptions are different formulas (decision 2), such as end-of-period and start-of-period discounted totals. Tests are evidence that a formula is stated and implemented correctly, not part of its identity, so a new worked example never makes a new formula. A formula is not itself a mathematical expression. It states its equations through has step, and its Content MathML is the conjunction of its steps in the order given by has step order, because the OpenMath and is unordered."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000118 "applied formula"@en ;
    obo:IAO_0000119 "Baines D. Formula, computational function, implementation, test and model use, note to the curator, 29 September 2026; Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026; Baines D, Ashley M. Curator decisions on the HEMO 0.2.0 reviews, 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:subClassOf obo:IAO_0000030 .

hemo:0000022 a owl:Class ;
    rdfs:label "domain of validity"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An information content entity that states the set of input values for which a formula holds, as one or more constraints on its variables."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:subClassOf obo:IAO_0000030 .

hemo:0000027 a owl:Class ;
    rdfs:label "implementation run record"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A data entity recording the value that one implementation returned for one test case, so that implementations of the same formula in different languages can be compared."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:subClassOf obo:IAO_0000027 .

