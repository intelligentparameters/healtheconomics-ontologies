    rdfs:label "standard normal distribution function"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An operator of the HEMO content dictionary hemo1, the distribution function of the standard normal distribution, the probability that a standard normal variable is at most its argument."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
