hemo:0000003 a owl:Class ;
    rdfs:label "binding expression"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A mathematical expression in which an operator such as a sum, a product or an integral binds an index variable that runs over a stated range, the binding object of OpenMath and the bind element of Content MathML."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Buswell et al. 2004; Carlisle et al. 2014" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
