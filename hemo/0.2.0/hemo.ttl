hemo:0000016 a owl:Class ;
    rdfs:label "test value specification"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A value specification that gives one variable one numeric value within one test case, either as an input or as the expected output."@en ;
    obo:IAO_0000116 "The number is given by RHEO has numeric value (RHEO_2000001). A money value also states its currency code and price year with the RHEO properties."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Bandrowski et al. 2016; Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
