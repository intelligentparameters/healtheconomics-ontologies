        hemo:0000025 ;
    rdfs:label "partitioned survival model"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A model type of a structure in which state occupancy over time is read from survival curves that are estimated separately, such as progression-free and overall survival, rather than from transitions between states."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Woods et al. 2017" ;
