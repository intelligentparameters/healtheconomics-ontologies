hemo:0000014 a owl:Class ;
    rdfs:label "implementation"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A plan specification that is the executable form of a formula or a computational function in one environment, a series of instructions that a spreadsheet, an interpreter or a query engine carries out, such as an Excel formula, an R function, a Python function or a SPARQL query, written in a stated language."@en ;
    obo:IAO_0000116 "Placed under IAO plan specification beside computational function, which is an IAO algorithm. Packaged code could also be typed IAO software (IAO_0000010), which IAO places under plan specification too."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Baines D. Formula, computational function, implementation, test and model use, note to the curator, 29 September 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:subClassOf obo:IAO_0000104 .

hemo:0000039 a owl:Class ;
    rdfs:label "parameter binding"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An information content entity that records that one variable of a HEMO model structure or formula takes its value from one RHEO model parameter in one RHEO economic model version, and for one option where the version compares options."@en ;
    obo:IAO_0000116 "A binding is an n-ary record on the model version, so that two model versions can bind the same variable of a shared structure to their own parameters without the bindings colliding."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO stage 1 design, 18 October 2026; Baines D, Ashley M. Curator decisions on the HEMO 0.2.0 reviews, 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:subClassOf obo:IAO_0000030 .

