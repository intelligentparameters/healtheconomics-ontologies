hemo:9000011 a owl:AnnotationProperty ;
    rdfs:label "has common error note"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A Common Error row of the Functions and Formulae module attached to a formula, verbatim, describing a mistake made when using it."@en ;
