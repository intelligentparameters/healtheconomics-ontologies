        hemo:0000021 ;
    rdfs:label "per cycle"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A unit of measure, the unit of an amount or probability per model cycle, which becomes a rate per unit time only with the cycle length."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Schadow and McDonald 2026" ;
