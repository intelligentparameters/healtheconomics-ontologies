hemo:4000085 a owl:NamedIndividual,
        hemo:0000011 ;
    rdfs:label "arithmetic mean"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An operator for arithmetic mean, the symbol mean of the OpenMath content dictionary s_data1."@en ;
    obo:IAO_0000116 "HEMO's mean of a list is written as fns2 apply_to_list applied to s_data1 mean and the list, because s_data1 mean is n-ary on the data values themselves."@en ;
