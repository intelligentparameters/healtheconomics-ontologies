    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:range hemo:0000013 ;
    heao:9000001 heao:4000003 .

hemo:1000004 a owl:ObjectProperty ;
    rdfs:label "implements formula or function"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates an implementation to the formula or computational function it makes executable."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain hemo:0000014 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    owl:inverseOf hemo:1000005 ;
    heao:9000001 heao:4000003 .

hemo:1000007 a owl:ObjectProperty ;
    rdfs:label "requires input"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a formula, a mathematical function or a computational function to a variable it needs as an input."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
