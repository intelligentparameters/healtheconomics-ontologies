    rdfs:label "discrete event simulation"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A model type of a structure that follows individuals through events at any time, which may compete for resources and queues through which they affect one another."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Karnon et al. 2012" ;
