    rdfs:label "health outcome in a stated measure"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A quantity kind whose values are amounts of a health outcome in a measure the analysis states, such as QALYs, life-years or cases avoided, used where a formula holds for any such measure."@en ;
