hemo:4000079 a owl:NamedIndividual,
        hemo:0000011 ;
    rdfs:label "vector and matrix product"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An operator of the HEMO content dictionary hemo1, the product of a row vector and a matrix, or of two matrices, as in the cohort update of a state-transition model. HEMO keeps its own symbol rather than arith1 times on matrix arguments, because the runner multiplies lists element by element under times, and the cohort update must be told apart from that."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    hemo:2000018 2 ;
    hemo:2000025 false ;
    hemo:9000005 <https://healtheconomics.wiki/ontologies/hemo/cd/hemo1#matrix_product> ;
    hemo:9000021 "*" .

hemo:4000080 a owl:NamedIndividual,
        hemo:0000011 ;
    rdfs:label "indicator of a condition"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An operator of the HEMO content dictionary hemo1, the number 1 when its condition is true and 0 when it is false, so that a condition can enter arithmetic, as in the severity weight selected by QALY shortfall bands."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
