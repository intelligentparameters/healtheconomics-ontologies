    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    heao:9000001 heao:4000003 .

hemo:1000033 a owl:ObjectProperty ;
    rdfs:label "has model component"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a model structure to one of its model components."@en ;
