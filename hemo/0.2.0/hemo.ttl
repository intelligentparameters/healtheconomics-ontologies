hemo:9000010 a owl:AnnotationProperty ;
    rdfs:label "has source in the module"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A Source row of the Functions and Formulae module attached to a formula, verbatim with its URL. These sources are the module's own and were not rechecked for HEMO unless src/checked-sources.md says so."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
