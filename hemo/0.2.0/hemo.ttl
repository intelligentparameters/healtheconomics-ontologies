    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:9000020 a owl:AnnotationProperty ;
    rdfs:label "has dimension vector"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "The dimension of a quantity kind as HEMO writes it, base letters with integer exponents separated by spaces, T time, C money, Q health-adjusted time such as QALYs and DALYs, W wellbeing-adjusted time, H a health outcome in a stated measure, X an amount of what a formula treats alike and N counted entities, which are dimensionless, such as T-1 for a rate per year or C Q-1 for money per QALY, which the dimension check uses."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:9000021 a owl:AnnotationProperty ;
    rdfs:label "has calculator token"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "The text by which an operator is written in the calculator grammar, such as +, ^, exp or sum_."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
