hemo:4000149 a owl:NamedIndividual,
        hemo:0000019 ;
    rdfs:label "discountable amount"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A quantity kind for an amount of money or of health in a stated measure that a formula treats alike, such as a value discounted to the present, whose dimension and unit are those of what it stands for."@en ;
