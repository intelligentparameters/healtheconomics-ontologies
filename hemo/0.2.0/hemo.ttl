hemo:9000009 a owl:AnnotationProperty ;
    rdfs:label "has title in the module"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "The Title of the row in the Functions and Formulae module, verbatim, which the site importer keys on."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
