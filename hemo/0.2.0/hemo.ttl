hemo:9000029 a owl:AnnotationProperty ;
    rdfs:label "has UCUM code variant"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Another way of writing the UCUM code of a unit of measure that UCUM reads as the same unit, such as a-1 or 1/a for /a, so that a RHEO record that writes a code differently is still matched."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
