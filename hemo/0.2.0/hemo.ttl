hemo:4000078 a owl:NamedIndividual,
        hemo:0000011 ;
    rdfs:label "sequence element"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An operator of the HEMO content dictionary hemo1, the element of a sequence, a vector, a list or a matrix at one or more stated indices, such as the cohort occupancy S at cycle t plus 1, or the incremental net benefit at outer draw k and inner draw j. OpenMath linalg selectors apply to vectors and matrices of fixed size, and health economics models index sequences by time from a stated start."@en ;
