    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:9000017 a owl:AnnotationProperty ;
    rdfs:label "has symbol"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "The symbol of a variable as written in the calculator text, such as r or Q_s."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:9000018 a owl:AnnotationProperty ;
    rdfs:label "has module record identifier"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "The Record ID of the row in the Functions and Formulae module that a HEMO record was generated from, such as HE-FM-DISC-001, which keeps the HEMO identifier stable when the row is retitled."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:9000019 a owl:AnnotationProperty ;
    rdfs:label "has UCUM code"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "The code of a unit of measure in the Unified Code for Units of Measure, written as RHEO writes it, such as /a for per year or {QALY} for a QALY."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
