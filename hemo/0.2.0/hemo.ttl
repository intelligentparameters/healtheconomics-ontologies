hemo:2000008 a owl:DatatypeProperty ;
    rdfs:label "has absolute tolerance"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "The largest absolute difference between a computed and an expected output that a test case accepts."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain hemo:0000015 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:range xsd:decimal .

hemo:2000009 a owl:DatatypeProperty ;
    rdfs:label "has relative tolerance"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "The largest difference between a computed and an expected output, as a proportion of the expected output, that a test case accepts."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain hemo:0000015 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:range xsd:decimal .

hemo:2000010 a owl:DatatypeProperty ;
    rdfs:label "has minimum inclusive"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "The smallest value a variable or a quantity kind allows, the value itself allowed."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:range xsd:decimal .

hemo:2000011 a owl:DatatypeProperty ;
    rdfs:label "has minimum exclusive"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A value that every value of a variable or a quantity kind must exceed."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:range xsd:decimal .

hemo:2000012 a owl:DatatypeProperty ;
    rdfs:label "has maximum inclusive"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "The largest value a variable or a quantity kind allows, the value itself allowed."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:range xsd:decimal .

hemo:2000013 a owl:DatatypeProperty ;
    rdfs:label "has maximum exclusive"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A value that every value of a variable or a quantity kind must stay below."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:range xsd:decimal .

hemo:2000014 a owl:DatatypeProperty ;
    rdfs:label "has plausible maximum"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A value above which a value of a quantity kind is almost certainly an entry error, such as a discount rate above 1, which is a percentage written where a decimal belongs. Exceeding it is a warning, not a violation."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain hemo:0000019 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:range xsd:decimal .

hemo:2000018 a owl:DatatypeProperty ;
    rdfs:label "has arity"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "The number of arguments an operator takes when it takes a fixed number, 0 for a constant such as pi. An operator that takes any number of arguments has no arity and is marked n-ary instead."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain hemo:0000011 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:range xsd:integer .

hemo:2000019 a owl:DatatypeProperty ;
    rdfs:label "parses in HEMO grammar"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Whether the calculator text of a record parses in the HEMO grammar, true or false."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:range xsd:boolean .

hemo:2000024 a owl:DatatypeProperty ;
    rdfs:label "is exempt from dimension check"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Whether the dimension check of the test runner does not apply to a record, true where its form is homogeneous in a quantity raised to a symbolic power, with the reason in an editor note."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:range xsd:boolean .

hemo:2000025 a owl:DatatypeProperty ;
    rdfs:label "is n-ary"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Whether an operator takes any number of arguments at or above its least number, such as addition or the set constructor, true or false."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain hemo:0000011 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:range xsd:boolean .

hemo:2000026 a owl:DatatypeProperty ;
    rdfs:label "has least number of arguments"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "The least number of arguments an n-ary operator takes."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain hemo:0000011 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:range xsd:integer .

hemo:4000001 a owl:NamedIndividual,
        hemo:0000028 ;
    rdfs:label "input role"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A variable role of a variable whose value is given to the formula or computational function."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO stage 1 design, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:4000002 a owl:NamedIndividual,
        hemo:0000028 ;
    rdfs:label "output role"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A variable role of a variable whose value the formula or computational function gives back."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO stage 1 design, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:4000003 a owl:NamedIndividual,
        hemo:0000028 ;
    rdfs:label "intermediate role"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A variable role of a variable computed by one step and used by a later step of the same record."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO stage 1 design, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:4000004 a owl:NamedIndividual,
        hemo:0000028 ;
    rdfs:label "index role"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A variable role of a variable that runs over a range inside a sum, a product or an integral, such as the year t of a discounted stream."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Buswell et al. 2004" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:4000005 a owl:NamedIndividual,
        hemo:0000028 ;
    rdfs:label "parameter role"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A variable role of a variable held fixed while a mathematical function is evaluated, such as the shape of a functional form."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO stage 1 design, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:4000006 a owl:NamedIndividual,
        hemo:0000028 ;
    rdfs:label "constant role"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A variable role of a symbol whose value is fixed by the mathematics, such as e or the number of days in a week."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO stage 1 design, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:4000007 a owl:NamedIndividual,
        hemo:0000029 ;
    rdfs:label "worked example"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A test kind of a test case that gives every input and the expected output of one realistic calculation."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Baines D. Formula, computational function, implementation, test and model use, note to the curator, 29 September 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:4000008 a owl:NamedIndividual,
        hemo:0000029 ;
    rdfs:label "limiting case"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A test kind of a test case at the edge of the domain, such as a zero discount rate giving the undiscounted total."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Baines D. Formula, computational function, implementation, test and model use, note to the curator, 29 September 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:4000009 a owl:NamedIndividual,
        hemo:0000029 ;
    rdfs:label "identity check"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A test kind of a test case that checks a mathematical identity between outputs, such as a start-of-year total equal to one plus the rate times the end-of-year total."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Baines D. Formula, computational function, implementation, test and model use, note to the curator, 29 September 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:4000010 a owl:NamedIndividual,
        hemo:0000029 ;
    rdfs:label "domain constraint check"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A test kind of a test case that checks that values lie in their domain, such as each row of a transition matrix summing to 1."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Baines D. Formula, computational function, implementation, test and model use, note to the curator, 29 September 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:4000011 a owl:NamedIndividual,
        hemo:0000029 ;
    rdfs:label "benchmark reproduction"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A test kind of a test case that reproduces a published or independently computed result."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Baines D. Formula, computational function, implementation, test and model use, note to the curator, 29 September 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:4000012 a owl:NamedIndividual,
        hemo:0000030 ;
    rdfs:label "end-of-period counting"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A discount timing convention in which each period's amount is counted at the end of the period, so the first period carries the factor 1 over 1 plus r."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Drummond et al. 2015; Naimark et al. 2008" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:4000013 a owl:NamedIndividual,
        hemo:0000030 ;
    rdfs:label "start-of-period counting"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A discount timing convention in which each period's amount is counted at the start of the period, so the first period is not discounted."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Drummond et al. 2015; Naimark et al. 2008" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:4000014 a owl:NamedIndividual,
        hemo:0000030 ;
    rdfs:label "mid-period counting"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A discount timing convention in which each period's amount is counted at the middle of the period."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Naimark et al. 2008; Elbasha and Chhatwal 2016" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:4000016 a owl:NamedIndividual,
        hemo:0000030 ;
    rdfs:label "continuous flow"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A discount timing convention in which the amount accrues evenly through time and is discounted continuously."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Attema et al. 2018" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:4000017 a owl:NamedIndividual,
        hemo:0000031 ;
    rdfs:label "fully formalised"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A formalisation level of a record whose expression is parsed into Content MathML with OpenMath symbols, whose variables all have a role, a quantity kind and a unit, whose domain of validity is stated and whose tests run."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:4000018 a owl:NamedIndividual,
        hemo:0000031 ;
    rdfs:label "catalogue record"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A formalisation level of a record that HEMO holds with its identifier, its expression text, its variables and roles and its normalised units, generated from the Functions and Formulae module."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:4000019 a owl:NamedIndividual,
        hemo:0000032 ;
    rdfs:label "Excel"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An implementation language, a Microsoft Excel cell formula."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Baines D. Formula, computational function, implementation, test and model use, note to the curator, 29 September 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:4000020 a owl:NamedIndividual,
        hemo:0000032 ;
    rdfs:label "R"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An implementation language, the R language for statistical computing."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Baines D. Formula, computational function, implementation, test and model use, note to the curator, 29 September 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:4000021 a owl:NamedIndividual,
        hemo:0000032 ;
    rdfs:label "Python"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An implementation language, the Python programming language."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Baines D. Formula, computational function, implementation, test and model use, note to the curator, 29 September 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:4000022 a owl:NamedIndividual,
        hemo:0000032 ;
    rdfs:label "JavaScript"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An implementation language, JavaScript, in which the calculator on the website evaluates a formula."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Baines D. Formula, computational function, implementation, test and model use, note to the curator, 29 September 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:4000023 a owl:NamedIndividual,
        hemo:0000032 ;
    rdfs:label "SPARQL"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An implementation language, the SPARQL query language, in which RHEO competency queries compute results."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO stage 1 design, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:4000042 a owl:NamedIndividual,
        hemo:0000026 ;
    rdfs:label "cost-effectiveness wrapper"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An analysis wrapper that compares the costs and health outcomes of options from the results of any model structure, by incremental ratios or net benefit."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Drummond et al. 2015" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:4000043 a owl:NamedIndividual,
        hemo:0000026 ;
    rdfs:label "budget impact wrapper"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An analysis wrapper that estimates the change in spending of a budget holder over a short horizon when a technology is adopted."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Sullivan et al. 2014" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:4000044 a owl:NamedIndividual,
        hemo:0000026 ;
    rdfs:label "probabilistic sensitivity analysis wrapper"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An analysis wrapper that runs a model structure for repeated draws of its inputs from their distributions."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Briggs et al. 2006" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:4000045 a owl:NamedIndividual,
        hemo:0000026 ;
    rdfs:label "deterministic sensitivity analysis wrapper"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An analysis wrapper that reruns a model structure with one or more inputs set to other fixed values."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Briggs et al. 2006" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:4000046 a owl:NamedIndividual,
        hemo:0000026 ;
    rdfs:label "value of information wrapper"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An analysis wrapper that values the reduction of decision uncertainty from the draws of a probabilistic sensitivity analysis."@en ;
