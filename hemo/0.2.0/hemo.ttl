    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a variable of a catalogue record to the quantity kind a named rule of src/unit-lookup.csv proposes from the module's unit text, not yet reviewed. It becomes has quantity kind once a curator reviews the rule."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
