    hemo:2000018 2 ;
    hemo:2000025 false ;
    hemo:9000005 <https://healtheconomics.wiki/ontologies/hemo/cd/hemo1#argmax> ;
    hemo:9000021 "argmax" .

hemo:4000082 a owl:NamedIndividual,
        hemo:0000011 ;
    rdfs:label "argument of the minimum"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An operator of the HEMO content dictionary hemo1, the member of a set of options at which an expression in a bound variable is least. It binds the variable that runs over the options."@en ;
    obo:IAO_0000116 "A binder in the content dictionary hemo1, like a sum, taking a set of options and a lambda expression in the bound variable."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
