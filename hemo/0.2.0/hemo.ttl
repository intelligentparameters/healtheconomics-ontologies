    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:9000008 a owl:AnnotationProperty ;
    rdfs:label "has description in the module"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "The Content text of the row in the Functions and Formulae module that a HEMO record was generated from, verbatim, so that it may contain the module's own colons."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
