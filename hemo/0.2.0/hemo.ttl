hemo:9000001 a owl:AnnotationProperty ;
    rdfs:label "formalises"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a formula, a mathematical function, a computational function or a model structure to a term of another ontology of the healtheconomics.wiki family whose quantity, calculation or valuation it states mathematically, such as a HEAO discount factor, a RHEO QALY calculation process or an OHEO QALY estimate. Each assertion carries its linking kind and a reason as an axiom annotation."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:9000002 a owl:AnnotationProperty ;
    rdfs:label "is executed by task"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a computational function or a formula to a HETO task specification, or one of its steps, that carries it out, such as Calculate discounted totals. Each assertion carries its linking kind and a reason as an axiom annotation."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:9000003 a owl:AnnotationProperty ;
    rdfs:label "is computed in competency query"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Names a RHEO competency query that computes the formula inside SPARQL, so that the arithmetic is stated once, in HEMO."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:9000004 a owl:AnnotationProperty ;
    rdfs:label "states HEMO hook"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Names the HEAO 0.2.0 hook, listed in hemo-hooks.md, that a HEMO formula states."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:9000005 a owl:AnnotationProperty ;
    rdfs:label "has OpenMath symbol"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates an operator to the OpenMath content dictionary symbol that gives its meaning."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:9000006 a owl:AnnotationProperty ;
    rdfs:label "is aligned with QUDT term"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a unit of measure or a quantity kind to the QUDT unit or quantity kind it corresponds to, checked in the QUDT vocabularies."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
