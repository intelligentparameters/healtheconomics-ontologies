hemo:0000008 a owl:Class ;
    rdfs:label "mathematical identity"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An equation that holds for every value of its variables within a stated domain, used to relate two formulas or as a test, such as a start-of-period discounted total equal to one plus the rate times the end-of-period total."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Drummond et al. 2015; Ashley M. HEMO stage 1 design, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:subClassOf hemo:0000006 .

hemo:1000001 a owl:ObjectProperty ;
    rdfs:label "realises mathematical function"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a formula to the mathematical function whose mapping it states under its own assumptions."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain hemo:0000010 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:range hemo:0000012 ;
    heao:9000001 heao:4000003 .

hemo:1000002 a owl:ObjectProperty ;
    rdfs:label "uses formula"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a computational function or a model structure to a formula it evaluates as one of its steps."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:range hemo:0000010 ;
    heao:9000001 heao:4000003 .

hemo:1000003 a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "uses computational function"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a computational function or a model structure to another computational function it calls, so that dependency graphs can nest."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
