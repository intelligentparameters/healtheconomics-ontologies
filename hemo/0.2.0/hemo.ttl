    rdfs:label "decision tree"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A model type of a structure of chance and decision nodes evaluated without explicit time, for a cohort, by rolling back expected values over the branches."@en ;
