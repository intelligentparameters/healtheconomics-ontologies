hemo:0000023 a owl:Class ;
    rdfs:label "model structure"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An information content entity that is the set of equations, recurrences and constraints a model evaluates, with their order of evaluation, independent of parameter values and of software."@en ;
    obo:IAO_0000116 "A RHEO economic model version implements a model structure (implements model structure). Two model versions with different parameter values can implement the same structure, and the values each version gives its variables are held in parameter bindings on that version, never on the structure."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Caro et al. 2012; Brennan et al. 2006; Ashley M. HEMO stage 1 design, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> ;
    rdfs:subClassOf obo:IAO_0000030 .

hemo:0000031 a owl:Class ;
    rdfs:label "formalisation level"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A categorical value specification naming how fully HEMO states a record, fully formalised with a parsed expression, typed variables, a domain and executed tests, or a catalogue record with its expression text, variables, roles and normalised units."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
