hemo:9000012 a owl:AnnotationProperty ;
    rdfs:label "carries causal claim held by"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a variable of a formula to the kind of RHEO record that holds a causal claim the term carries, such as a relative risk and the RHEO relative effect estimate. Each assertion carries its linking kind, representational because both ends are records, and a reason as an axiom annotation."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:9000013 a owl:AnnotationProperty ;
    rdfs:label "takes weight of type"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a variable of a formula to the kind of HEAO weight or parameter that supplies its value in a valuation, such as a utility variable and the HEAO preference-based utility weight. It names where the value comes from and applies no weight, so it is representational. Each assertion carries its linking kind and a reason as an axiom annotation."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:9000014 a owl:AnnotationProperty ;
    rdfs:label "has calculator text"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "The authoring text of a formula, a computational step, a constraint or a test condition in the calculator grammar of the website, which is the source from which HEMO parses the expression."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/hemo> .

hemo:9000015 a owl:AnnotationProperty ;
    rdfs:label "has Content MathML"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "The strict Content MathML of a parsed expression, generated from its calculator text with OpenMath symbols, which carries its meaning for exchange."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEMO 0.2.0 decisions, the recommended options of design section 12, 18 October 2026" ;
