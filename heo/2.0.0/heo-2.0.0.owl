        <dcterms:identifier>HS-HP-HD-115</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Third-Party Administrator</rdfs:label>
        <skos:altLabel xml:lang="en">TPA</skos:altLabel>
        <skos:definition xml:lang="en">An organisation providing administrative services, such as claims processing, for a self-insured employer&apos;s plan, without bearing the claims&apos; financial risk.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Benefits Administrator</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Third-Party Administrator</skos:prefLabel>
        <abbreviation xml:lang="en">TPA</abbreviation>
        <manages rdf:resource="https://healtheconomics.wiki/concept/self-funded-plan"/>
        <performs rdf:resource="https://healtheconomics.wiki/concept/claims-processing"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/third-party-administrator"/>
