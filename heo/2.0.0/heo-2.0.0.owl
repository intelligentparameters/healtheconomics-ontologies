    <!-- https://healtheconomics.wiki/concept/automatic-substitution -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/automatic-substitution">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-substitution"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/drug-substitution"/>
        <skos:notation>PP-PC-MS-002</skos:notation>
        <dcterms:identifier>PP-PC-MS-002</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>EMA &amp; HMA 2023</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Automatic Substitution</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Auto-Substitution</skos:altLabel>
        <skos:definition xml:lang="en">Automatic substitution is pharmacy dispensing of a lower-cost equivalent generic or biosimilar for a prescribed brand without consulting the prescriber.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Mandatory Substitution</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Automatic Substitution</skos:prefLabel>
        <abbreviation xml:lang="en">Auto-Substitution</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/therapeutic-interchange"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/biosimilar-uptake"/>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/generic-drug"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/automatic-substitution"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-substitution"/>
        <dcterms:identifier>HEO-L-4a2ccbc121ef</dcterms:identifier>
        <linkRationale xml:lang="en">Drug substitution definition names generic and biosimilar</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
