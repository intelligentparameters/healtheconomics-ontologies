        <skos:prefLabel xml:lang="en">Ambulatory Surgery Centre</skos:prefLabel>
        <abbreviation xml:lang="en">ASC</abbreviation>
        <performs rdf:resource="https://healtheconomics.wiki/concept/day-surgery"/>
