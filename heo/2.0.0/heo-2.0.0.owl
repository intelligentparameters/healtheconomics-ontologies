    <!-- https://healtheconomics.wiki/concept/adherence -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/adherence">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-behaviour"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q67004728"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-behaviour"/>
        <skos:notation>PP-PC-AS-001</skos:notation>
        <dcterms:identifier>PP-PC-AS-001</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>WHO 2003</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Adherence</rdfs:label>
        <owl:versionInfo>1.0.4</owl:versionInfo>
        <skos:definition xml:lang="en">Adherence is how far a person&apos;s behaviour, such as taking medicines or following diet or lifestyle advice, matches recommendations agreed with a clinician.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Patient Concordance</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Regimen Following</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Adherence</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/non-adherence"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/effectiveness"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/adherence"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-behaviour"/>
        <dcterms:identifier>HEO-L-f219a8b299fe</dcterms:identifier>
        <linkRationale xml:lang="en">Taking medicines and following advice are health behaviours</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
