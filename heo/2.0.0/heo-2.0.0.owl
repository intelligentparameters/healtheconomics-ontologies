        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Reminder Intervention</rdfs:label>
        <skos:definition xml:lang="en">An intervention using prompts, such as text messages or letters, to counteract forgetting or procrastination in completing a task.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cue-Based Intervention</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Prompt Intervention</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Reminder Intervention</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/medication-adherence"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/reminder-system"/>
    </owl:NamedIndividual>
