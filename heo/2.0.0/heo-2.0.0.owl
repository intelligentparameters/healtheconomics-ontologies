        <skos:altLabel xml:lang="en">Baumol Cost Disease</skos:altLabel>
        <skos:altLabel xml:lang="en">Cost Disease</skos:altLabel>
        <skos:definition xml:lang="en">The Baumol effect is the rising relative cost of labour-intensive services such as health care as their pay tracks faster productivity growth elsewhere.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Service-Sector Cost Disease</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Baumol Effect</skos:prefLabel>
