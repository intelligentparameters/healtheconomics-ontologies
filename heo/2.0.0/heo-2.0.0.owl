    <!-- https://healtheconomics.wiki/concept/goodness-of-fit-test -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/goodness-of-fit-test">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/hypothesis-testing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/hypothesis-testing"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/goodness-of-fit"/>
        <skos:notation>HE-EM-MV-031</skos:notation>
        <dcterms:identifier>HE-EM-MV-031</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Pearson 1900</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Goodness of Fit Test</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A goodness of fit test assesses whether a specified discrepancy between observed data and a proposed probability model is unusually large under that model’s sampling assumptions.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Distributional Fit Test</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Fit Test</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Goodness of Fit Test</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-9"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/chi-square-distribution"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/goodness-of-fit-test"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
