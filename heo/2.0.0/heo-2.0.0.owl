    <!-- https://healtheconomics.wiki/concept/instrumental-variable -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/instrumental-variable">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/real-world-evidence"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/real-world-evidence"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/instrumental-variable-analysis"/>
        <skos:notation>HE-ES-RWE-005</skos:notation>
        <dcterms:identifier>HE-ES-RWE-005</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Angrist, Imbens &amp; Rubin 1996</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Instrumental Variable</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">IV</skos:altLabel>
        <skos:altLabel xml:lang="en">Instrument</skos:altLabel>
        <skos:definition xml:lang="en">An instrumental variable is a variable that changes treatment or exposure uptake while, under specified causal assumptions, being independent of potential outcomes and affecting the outcome only through that treatment or exposure.</skos:definition>
        <skos:prefLabel xml:lang="en">Instrumental Variable</skos:prefLabel>
        <abbreviation xml:lang="en">IV</abbreviation>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/confounding"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/instrumental-variable"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/real-world-evidence"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-93728df160e4</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Causal inference and real world evidence in subdomain Evidence Synthesis; placed under Real-World Evidence, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/instrumental-variable"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/instrumental-variable-analysis"/>
        <dcterms:identifier>HEO-L-974d13f53860</dcterms:identifier>
