        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/recommendation"/>
        <dcterms:identifier>HEO-L-7bfaf155253d</dcterms:identifier>
