    <!-- https://healtheconomics.wiki/concept/critical-appraisal -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/critical-appraisal">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-assessment"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q5186693"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-assessment"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/evidence-based-medicine"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/systematic-review"/>
        <skos:notation>HE-ES-EA-011</skos:notation>
        <dcterms:identifier>HE-ES-EA-011</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</dcterms:modified>
        <dcterms:source>Sobiesuo et al. 2024</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Critical Appraisal</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:definition xml:lang="en">Critical appraisal is the structured judgement of whether a study, model or economic evaluation is sound and relevant enough to inform a health decision.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Evidence Critical Review</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Study Appraisal</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Critical Appraisal</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/spin"/>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/economic-evaluation"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/quality-of-evidence"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/evaluation-standards"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/level-of-evidence"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/quality-assessment-model"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/critical-appraisal"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-assessment"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-e668210aff12</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Evidence Appraisal: catalogue subdomain Evidence Synthesis is one of the subdomains; placed under Evidence Assessment, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/critical-appraisal"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-based-medicine"/>
