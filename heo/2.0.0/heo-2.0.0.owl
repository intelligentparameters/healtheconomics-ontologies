    <!-- https://healtheconomics.wiki/concept/service-innovation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/service-innovation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/innovation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/innovation"/>
        <skos:notation>HE-PE-TI-029</skos:notation>
        <dcterms:identifier>HE-PE-TI-029</dcterms:identifier>
        <dcterms:source>Christensen, Raynor &amp; McDonald 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Service Innovation</rdfs:label>
        <skos:definition xml:lang="en">An innovation introducing a new or substantially improved way of delivering a service, such as a care coordination model, rather than a clinical product.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Care Delivery Innovation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Service Delivery Innovation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Service Innovation</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/process-innovation"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/service-innovation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/innovation"/>
        <dcterms:identifier>HEO-L-d0a49dd77f5a</dcterms:identifier>
        <linkRationale xml:lang="en">Service innovation is a type of innovation.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/service-innovation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/process-innovation"/>
        <dcterms:identifier>HEO-L-892e5dede292</dcterms:identifier>
        <linkRationale xml:lang="en">Service innovation (new way of delivering a service) contrasts with process innovation in production.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/service-limit -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/service-limit">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/benefit-limit"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/benefit-limit"/>
        <skos:notation>HS-HP-HI-177</skos:notation>
        <dcterms:identifier>HS-HP-HI-177</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Service Limit</rdfs:label>
        <skos:definition xml:lang="en">A restriction on the maximum number of times a specific service, such as physical therapy visits, will be covered within a period.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Coverage Cap</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Service Frequency Limit</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Service Limit</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/service-utilisation"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/service-limit"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/benefit-limit"/>
        <dcterms:identifier>HEO-L-639693a26b1f</dcterms:identifier>
        <linkRationale xml:lang="en">A cap on visits covered is a benefit limit.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/service-limit"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/service-utilisation"/>
