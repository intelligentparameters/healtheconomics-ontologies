        <rdfs:label xml:lang="en">Net Survival Model</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A survival model estimating the survival a population would experience if the disease studied were the only possible cause of death.</skos:definition>
