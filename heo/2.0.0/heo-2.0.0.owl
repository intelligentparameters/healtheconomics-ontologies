    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/fleming-harrington-estimator">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:notation>HE-EM-SM-021</skos:notation>
        <dcterms:identifier>HE-EM-SM-021</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Fleming &amp; Harrington 1991</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Fleming-Harrington Estimator</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Fleming-Harrington Survival Estimator</skos:altLabel>
        <skos:definition xml:lang="en">A statistical technique for estimating the survival function from censored data, more flexible than the Kaplan-Meier estimator in weighting events over time.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Weighted Survival Estimator</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Fleming-Harrington Estimator</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/kaplan-meier-estimator"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/fleming-harrington-estimator"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-4f9d8f8a3573</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Survival analysis and extrapolation in subdomain Economic Modelling</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/fleming-harrington-estimator"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/kaplan-meier-estimator"/>
        <dcterms:identifier>HEO-L-efa12b9d6024</dcterms:identifier>
        <linkRationale xml:lang="en">Fleming-Harrington is an alternative survival estimator to Kaplan-Meier</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/fleming-harrington-test -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/fleming-harrington-test">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/weighted-log-rank"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/weighted-log-rank"/>
        <skos:notation>HE-EM-SM-022</skos:notation>
        <dcterms:identifier>HE-EM-SM-022</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Fleming &amp; Harrington 1991</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Fleming-Harrington Test</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Fleming-Harrington Weighted Test</skos:altLabel>
        <skos:altLabel xml:lang="en">G-Rho Test</skos:altLabel>
        <skos:definition xml:lang="en">A hypothesis test comparing survival distributions between groups, generalising the log-rank test by allowing different weights for events at different follow-up times.</skos:definition>
        <skos:prefLabel xml:lang="en">Fleming-Harrington Test</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/log-rank-test"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/kaplan-meier-estimator"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/fleming-harrington-test"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/weighted-log-rank"/>
        <dcterms:identifier>HEO-L-60f843610054</dcterms:identifier>
        <linkRationale xml:lang="en">The subject definition describes a log-rank test with time-varying weights, i.e. a weighted log-rank test</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/fleming-harrington-test"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/log-rank-test"/>
        <dcterms:identifier>HEO-L-b28954e7e86b</dcterms:identifier>
        <linkRationale xml:lang="en">Full page kept; its weights are functions of the pooled Kaplan-Meier estimate; alternative to the unweighted log-rank.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
