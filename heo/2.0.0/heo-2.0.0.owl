    <!-- https://healtheconomics.wiki/concept/astana-declaration -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/astana-declaration">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
