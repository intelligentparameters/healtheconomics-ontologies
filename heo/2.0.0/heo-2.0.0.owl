    <!-- https://healtheconomics.wiki/concept/cross-price-elasticity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cross-price-elasticity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/elasticity"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/elasticity"/>
        <skos:notation>HE-EE-ME-013</skos:notation>
        <dcterms:identifier>HE-EE-ME-013</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Varian 2014</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cross-Price Elasticity</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Cross-Elasticity of Demand</skos:altLabel>
        <skos:definition xml:lang="en">Cross-price elasticity measures how demand for one good responds to a change in another good&apos;s price: positive for substitutes, negative for complements.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cross Elasticity</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cross-Price Elasticity</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/income-elasticity-of-demand"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/price-elasticity-of-demand"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/demand"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cross-price-elasticity"/>
