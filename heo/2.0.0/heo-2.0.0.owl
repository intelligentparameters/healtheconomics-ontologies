        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/utility"/>
        <skos:notation>HE-EM-MP-014</skos:notation>
        <dcterms:identifier>HE-EM-MP-014</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>von Neumann &amp; Morgenstern 1944</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Expected Utility</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">EU</skos:altLabel>
        <skos:definition xml:lang="en">Expected utility is the probability-weighted average of the utilities assigned to an uncertain option&apos;s possible outcomes, used to rank choices under risk when preferences satisfy the required axioms.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Utility Under Uncertainty</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Expected Utility</skos:prefLabel>
        <abbreviation xml:lang="en">EU</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-4"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/expected-utility"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/expected-value"/>
        <dcterms:identifier>HEO-L-9ac74d7b9e9f</dcterms:identifier>
        <linkRationale xml:lang="en">Expected utility is the expected value of utilities (both definitions), a kind of expected value, not a user of it</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/expected-utility"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
