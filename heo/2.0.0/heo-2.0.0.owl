        <skos:altLabel xml:lang="en">IDE</skos:altLabel>
        <skos:definition xml:lang="en">An investigational device exemption (IDE) is a US FDA permit to test an unapproved medical device in a clinical study, often to support premarket approval.</skos:definition>
        <skos:prefLabel xml:lang="en">Investigational Device Exemption</skos:prefLabel>
        <abbreviation xml:lang="en">IDE</abbreviation>
        <counterpartOf rdf:resource="https://healtheconomics.wiki/concept/ind-application"/>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/technology-innovation"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/investigational-device-exemption"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
