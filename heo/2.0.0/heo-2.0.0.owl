    <!-- https://healtheconomics.wiki/concept/direct-contracting -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/direct-contracting">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/strategic-purchasing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/strategic-purchasing"/>
        <skos:notation>HS-HP-PP-041</skos:notation>
        <dcterms:identifier>HS-HP-PP-041</dcterms:identifier>
        <dcterms:source>Carlson JJ, Sullivan SD, Garrison LP, Neumann PJ, Veenstra DL. Linking payment to health outcomes: a taxonomy and examination of performance-based reimbursement schemes. Health Policy. 2010;96(3):179-190.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Direct Contracting</rdfs:label>
        <skos:definition xml:lang="en">An arrangement where a payer contracts directly with providers or an accountable care organisation, bypassing traditional insurance intermediaries.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Direct Provider Contracting</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Direct-to-Provider Contracting</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Direct Contracting</skos:prefLabel>
        <produces rdf:resource="https://healtheconomics.wiki/concept/negotiated-rate"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/direct-contracting"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/strategic-purchasing"/>
        <dcterms:identifier>HEO-L-a3243477c726</dcterms:identifier>
        <linkRationale xml:lang="en">contracting directly with selected providers is a strategic purchasing approach</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/direct-contracting"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#produces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/negotiated-rate"/>
        <dcterms:identifier>HEO-L-591635a83d62</dcterms:identifier>
