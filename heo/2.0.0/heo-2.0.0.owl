    <!-- https://healtheconomics.wiki/concept/number-needed-to-treat -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/number-needed-to-treat">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/absolute-measure"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q614132"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/absolute-measure"/>
        <skos:notation>HE-ES-RM-018</skos:notation>
        <dcterms:identifier>HE-ES-RM-018</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Cook &amp; Sackett 1995</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Number Needed to Treat</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">NNT</skos:altLabel>
        <skos:definition xml:lang="en">The reciprocal of a nonzero absolute difference in event risk between an intervention and comparator, interpreted as the expected number treated for one additional beneficial or harmful outcome over a stated period.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Treatment Number Needed</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Number Needed to Treat</skos:prefLabel>
        <abbreviation xml:lang="en">NNT</abbreviation>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/number-needed-to-treat"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/absolute-measure"/>
        <dcterms:identifier>HEO-L-e38feb75d6ab</dcterms:identifier>
        <linkRationale xml:lang="en">Subject definition says the reciprocal of an absolute risk difference, an effect measure</linkRationale>
