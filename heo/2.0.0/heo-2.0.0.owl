        <measures rdf:resource="https://healtheconomics.wiki/concept/marginal-rate-of-substitution"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/patient-preference"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/treatment-preference"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/willingness-to-pay"/>
        <skos:notation>HE-EE-CBA-016</skos:notation>
        <dcterms:identifier>HE-EE-CBA-016</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-21</dcterms:modified>
        <dcterms:source>Louviere, Hensher &amp; Swait 2000</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Discrete Choice Experiment</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Choice Experiment</skos:altLabel>
        <skos:altLabel xml:lang="en">DCE</skos:altLabel>
        <skos:altLabel xml:lang="en">Discrete-Choice Experiment</skos:altLabel>
        <skos:definition xml:lang="en">A discrete choice experiment, or DCE, presents respondents with repeated sets of hypothetical alternatives described by attributes and asks them to select a preferred option.</skos:definition>
        <skos:prefLabel xml:lang="en">Discrete Choice Experiment</skos:prefLabel>
        <abbreviation xml:lang="en">DCE</abbreviation>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/outcomes#step-4"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/benefit-risk-assessment"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/cost-benefit-analysis"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/part-worth-utility"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/efficient-design"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/latent-class-model"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/multinomial-logit-model"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/orthogonal-design"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/random-parameter-model"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/discrete-choice-experiment"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/conjoint-analysis"/>
        <dcterms:identifier>HEO-L-0a6acc53f6bc</dcterms:identifier>
        <linkRationale xml:lang="en">the object definition covers choice-based methods; DCE is choice-based conjoint analysis</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
