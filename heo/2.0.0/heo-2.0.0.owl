        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/standard-gamble"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-state-valuation"/>
        <dcterms:identifier>HEO-L-04db50202bf0</dcterms:identifier>
        <linkRationale xml:lang="en">Standard gamble is a health state valuation method.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
