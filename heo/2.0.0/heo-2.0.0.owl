        <skos:notation>HS-HP-HD-100</skos:notation>
        <dcterms:identifier>HS-HP-HD-100</dcterms:identifier>
        <dcterms:source>AHA, American Hospital Association</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Secondary Service Area</rdfs:label>
        <skos:definition xml:lang="en">A geographic area beyond a facility&apos;s primary service area from which it draws a smaller, still meaningful, patient proportion.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Outer Service Area</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Secondary Catchment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Secondary Service Area</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
