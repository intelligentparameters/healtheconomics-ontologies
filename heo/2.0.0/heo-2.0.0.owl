    <!-- https://healtheconomics.wiki/concept/antithetic-variates -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/antithetic-variates">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/variance-reduction"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/variance-reduction"/>
        <skos:notation>HE-EM-UA-002</skos:notation>
        <dcterms:identifier>HE-EM-UA-002</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Hammersley &amp; Morton 1956</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Antithetic Variates</rdfs:label>
        <owl:versionInfo>1.0.3</owl:versionInfo>
        <skos:altLabel xml:lang="en">Antithetic Sampling</skos:altLabel>
        <skos:definition xml:lang="en">Antithetic variates are a variance reduction method that pairs each random draw with its mirror image so errors tend to cancel in Monte Carlo simulation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Antithetic Variables</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Antithetic Variates</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/common-random-numbers"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-10"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/monte-carlo-error"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/correlation"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/antithetic-variates"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/variance-reduction"/>
        <dcterms:identifier>HEO-L-d7cd25d497a6</dcterms:identifier>
        <linkRationale xml:lang="en">Definition calls it a variance reduction method</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/antithetic-variates"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/common-random-numbers"/>
        <dcterms:identifier>HEO-L-fcea9bfcf555</dcterms:identifier>
        <linkRationale xml:lang="en">Two alternative Monte Carlo variance reduction techniques</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/antithetic-variates"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/monte-carlo-error"/>
        <dcterms:identifier>HEO-L-a5af65d12093</dcterms:identifier>
        <linkRationale xml:lang="en">Antithetic variates are an optional variance reduction method that lowers Monte Carlo error, not a required part of simulation</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/antithetic-variates"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
