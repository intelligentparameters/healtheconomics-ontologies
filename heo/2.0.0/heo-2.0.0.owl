        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">EPDS</rdfs:label>
        <skos:definition xml:lang="en">EPDS is a ten-item self-report scale scored 0 to 30 that screens for depression in pregnancy and after birth, used in trials and screening models.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Edinburgh Depression Scale</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Edinburgh Postnatal Depression Scale</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">EPDS</skos:prefLabel>
