        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/urgent-care"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/emergency-care"/>
        <dcterms:identifier>HEO-L-dda9650abf02</dcterms:identifier>
