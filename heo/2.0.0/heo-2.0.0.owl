        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Friedman LM, Furberg CD, DeMets DL, Reboussin DM, Granger CB. Fundamentals of Clinical Trials. 5th ed. Springer; 2015. doi:10.1007/978-3-319-18539-2.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Sample Size Calculation</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">The process of determining the number of participants a study needs to have an adequate chance of detecting a specified treatment effect.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Sample Size Optimisation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Sample Size Optimization</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Sample Size Calculation</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/recruitment"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/optimal-sample-size"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/design-effect"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/effect-size"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/effective-sample-size"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/statistical-power"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/sample-size-calculation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
