    <!-- https://healtheconomics.wiki/concept/limited-societal-perspective -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/limited-societal-perspective">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/perspective"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/perspective"/>
        <skos:notation>HE-EE-EPR-023</skos:notation>
        <dcterms:identifier>HE-EE-EPR-023</dcterms:identifier>
        <dcterms:source>Sanders et al. 2016</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Limited Societal Perspective</rdfs:label>
        <skos:definition xml:lang="en">An analytic viewpoint including healthcare sector costs along with a defined subset of non-healthcare costs, such as informal carer time, short of a full societal view.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Modified Societal Perspective</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Restricted Societal Perspective</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Limited Societal Perspective</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/payer-perspective"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/societal-perspective"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/patient-time-cost"/>
    </owl:NamedIndividual>
    <owl:Axiom>
