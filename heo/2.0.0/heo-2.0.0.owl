        <dcterms:identifier>HS-NHS-HQ-025</dcterms:identifier>
        <dcterms:source>Pyzdek &amp; Keller, The Six Sigma Handbook</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">DMAIC</rdfs:label>
        <skos:altLabel xml:lang="en">Define Measure Analyse Improve Control</skos:altLabel>
        <skos:definition xml:lang="en">A structured, five-phase Six Sigma methodology, Define, Measure, Analyse, Improve, Control, for identifying and addressing root causes of a quality problem.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Six Sigma Improvement Cycle</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">DMAIC</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/plan-do-study-act"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/dmaic"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
