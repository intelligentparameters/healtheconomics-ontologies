    <!-- https://healtheconomics.wiki/concept/length-bias -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/length-bias">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/bias"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/bias"/>
        <skos:notation>HE-DS-BV-018</skos:notation>
        <dcterms:identifier>HE-DS-BV-018</dcterms:identifier>
        <dcterms:source>Morrison 1985</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Length Bias</rdfs:label>
        <skos:definition xml:lang="en">A bias in screening evaluations arising because screening preferentially detects slower-growing cases that stay detectable longer, while aggressive cases are more often missed.</skos:definition>
        <skos:prefLabel xml:lang="en">Length Bias</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/screening-economics"/>
    </owl:NamedIndividual>
