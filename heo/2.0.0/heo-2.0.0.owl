    <!-- https://healtheconomics.wiki/concept/jackknife-standard-error -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/jackknife-standard-error">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/standard-error"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/standard-error"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/confidence-interval"/>
        <skos:notation>HE-ES-SA-089</skos:notation>
        <dcterms:identifier>HE-ES-SA-089</dcterms:identifier>
        <dcterms:source>Tukey 1958</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Jackknife Standard Error</rdfs:label>
        <skos:altLabel xml:lang="en">Jackknife SE</skos:altLabel>
        <skos:definition xml:lang="en">An estimate of a parameter&apos;s statistical uncertainty calculated using the jackknife technique of omitting one observation at a time and examining resulting variability.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Jackknife Variance Estimate</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Jackknife Standard Error</skos:prefLabel>
        <abbreviation xml:lang="en">Jackknife SE</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
