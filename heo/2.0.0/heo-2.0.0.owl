    <!-- https://healtheconomics.wiki/concept/pressure-ulcer-rate -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/pressure-ulcer-rate">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
