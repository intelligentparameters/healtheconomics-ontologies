    <!-- https://healtheconomics.wiki/concept/selection-bias -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/selection-bias">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/bias"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q284172"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/bias"/>
        <skos:notation>HE-DS-BV-033</skos:notation>
        <dcterms:identifier>HE-DS-BV-033</dcterms:identifier>
        <dcterms:source>Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams &amp; Wilkins; 2008.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Selection Bias</rdfs:label>
        <skos:definition xml:lang="en">Bias arising when the individuals included in a study differ systematically from the broader population of interest, in ways linked to exposure and outcome.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Sampling Bias</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Selection Effect</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Selection Bias</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/risk-of-bias"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/big-data"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/selection-bias"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/bias"/>
        <dcterms:identifier>HEO-L-015390e57c5d</dcterms:identifier>
        <linkRationale xml:lang="en">Selection bias is a systematic error, a type of bias.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/selection-bias"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/risk-of-bias"/>
        <dcterms:identifier>HEO-L-2c22cc72074e</dcterms:identifier>
        <linkRationale xml:lang="en">Selection bias is one of the systematic errors that raise risk of bias.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/selection-bias"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#threatensValidityOf"/>
