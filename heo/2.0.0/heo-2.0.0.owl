    <!-- https://healtheconomics.wiki/concept/data-visualisation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/data-visualisation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q6504956"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:notation>HS-SS_DH-072</skos:notation>
        <dcterms:identifier>HS-SS_DH-072</dcterms:identifier>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Data Visualisation</rdfs:label>
        <skos:altLabel xml:lang="en">Data Visualization</skos:altLabel>
        <skos:definition xml:lang="en">In health economics and analytics, the graphical presentation of data to reveal patterns, relationships and uncertainty, such as plotting probabilistic sensitivity analysis results or quality-control trends.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Information Graphics</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Data Visualisation</skos:prefLabel>
        <represents rdf:resource="https://healtheconomics.wiki/concept/uncertainty"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/data-visualisation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-6e7cf7aaf3bf</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: curated: review B: analytic graphics (CEACs, tornado plots) belong to Mathematical and computational methods, not Digital Health</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/data-visualisation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#represents"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/uncertainty"/>
        <dcterms:identifier>HEO-L-199cf8a0f6d5</dcterms:identifier>
        <linkRationale xml:lang="en">Plots such as cost-effectiveness planes and acceptability curves depict decision uncertainty</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
