        <skos:notation>HS-HP-HTA-210</skos:notation>
        <dcterms:identifier>HS-HP-HTA-210</dcterms:identifier>
        <dcterms:source>Prentice 1989</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Surrogate Evidence</rdfs:label>
        <skos:definition xml:lang="en">Data based on an intermediate biomarker used as a substitute for a direct measure of clinical benefit, when final outcome data are unavailable.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Biomarker-Based Evidence</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Intermediate-Marker Evidence</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Surrogate Evidence</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/accelerated-approval"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
