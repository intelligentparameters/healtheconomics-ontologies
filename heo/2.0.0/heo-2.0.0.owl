    <!-- https://healtheconomics.wiki/concept/managed-care-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/managed-care-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
