    <!-- https://healtheconomics.wiki/concept/good-characteristic -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/good-characteristic">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <skos:notation>HE-EE-ME-080</skos:notation>
        <dcterms:identifier>HE-EE-ME-080</dcterms:identifier>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Good Characteristic</rdfs:label>
        <skos:definition xml:lang="en">In health economics, a property used to classify health goods and services by their rivalry in consumption and their excludability, explaining why provisions such as public health protection behave as public goods that private markets undersupply while most treatments behave as private goods.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Good Property</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Goods Classification Characteristic</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Good Characteristic</skos:prefLabel>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/economic-good"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/public-good"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/good-characteristic"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-c780498a01c2</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Scarcity choice and opportunity cost in subdomain Economic Foundations</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/good-characteristic"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isPropertyOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-good"/>
        <dcterms:identifier>HEO-L-c0ef53f5b4fe</dcterms:identifier>
        <linkRationale xml:lang="en">Rivalry and excludability are characteristics that classify an economic good (object definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
