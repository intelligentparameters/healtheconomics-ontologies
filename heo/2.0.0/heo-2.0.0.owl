    <!-- https://healtheconomics.wiki/concept/reproductive-epidemiology -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/reproductive-epidemiology">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/epidemiology"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/epidemiology"/>
        <skos:notation>HE-ES-EP-038</skos:notation>
        <dcterms:identifier>HE-ES-EP-038</dcterms:identifier>
        <dcterms:source>Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams &amp; Wilkins; 2008.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Reproductive Epidemiology</rdfs:label>
        <skos:definition xml:lang="en">A branch of epidemiology studying factors affecting human fertility, reproductive health, and reproductive outcomes within populations.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Fertility Epidemiology</skos:hiddenLabel>
