    <!-- https://healtheconomics.wiki/concept/affordability-threshold -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/affordability-threshold">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/budget-impact-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/budget-impact-analysis"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/affordability-criterion"/>
        <skos:notation>HE-EE-EPR-001</skos:notation>
        <dcterms:identifier>HE-EE-EPR-001</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>NICE resource impact manual 2026</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Affordability Threshold</rdfs:label>
        <owl:versionInfo>1.0.3</owl:versionInfo>
        <skos:definition xml:lang="en">An affordability threshold is the budget impact level above which a payer flags a new technology for special handling, even if it is cost-effective.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Budget-Impact Threshold</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Total-Cost Ceiling</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Affordability Threshold</skos:prefLabel>
        <benchmarkFor rdf:resource="https://healtheconomics.wiki/concept/affordability"/>
        <benchmarkFor rdf:resource="https://healtheconomics.wiki/concept/budget-impact"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-threshold"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-6"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/affordability-threshold"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/budget-impact-analysis"/>
