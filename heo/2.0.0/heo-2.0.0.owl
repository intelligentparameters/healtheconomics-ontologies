    <!-- https://healtheconomics.wiki/concept/kakwani-index -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/kakwani-index">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/vertical-equity"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/financing-incidence"/>
        <skos:notation>HE-EE-HE-009</skos:notation>
        <dcterms:identifier>HE-EE-HE-009</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Kakwani 1977</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Kakwani Index</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Kakwani Progressivity Index</skos:altLabel>
        <skos:definition xml:lang="en">A measure of the progressivity of a tax or financing system, calculated as the concentration index of payments minus the Gini coefficient of pre-tax income.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Payment Progressivity Index</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Kakwani Index</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-policy#step-4"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/kakwani-index"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-acd5ff61cd25</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Equity and inequality in subdomain Health Policy</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/kakwani-index"/>
