        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/deep-molecular-response"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/molecular-response"/>
        <skos:notation>HE-ES-CO-013</skos:notation>
