    <!-- https://healtheconomics.wiki/concept/decision-relevance-period -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/decision-relevance-period">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/value-of-information"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/value-of-information"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/population-evpi"/>
