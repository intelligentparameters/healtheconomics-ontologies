        <skos:notation>HE-EE-CBA-034</skos:notation>
        <dcterms:identifier>HE-EE-CBA-034</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Mitchell &amp; Carson 1989</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Monetary Valuation</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Monetisation</skos:altLabel>
        <skos:definition xml:lang="en">Monetary valuation expresses a health outcome or other non-market good in money terms, using stated preference, revealed preference or wellbeing methods.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Money-Metric Valuation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Monetary Valuation</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/outcomes#step-4"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/value-of-statistical-life"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/value-of-statistical-life-year"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/contingent-valuation"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/discrete-choice-experiment"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/human-capital-approach"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/revealed-preference"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/stated-preference"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/willingness-to-pay"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/monetary-valuation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
