        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/response-error -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/response-error">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/measurement-error"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/measurement-error"/>
        <skos:notation>HE-DS-BV-030</skos:notation>
        <dcterms:identifier>HE-DS-BV-030</dcterms:identifier>
        <dcterms:source>Groves et al. 2009</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Response Error</rdfs:label>
        <skos:definition xml:lang="en">Inaccuracy in a survey response from a respondent&apos;s misunderstanding, faulty memory, or deliberate misreporting, unlike errors introduced later in processing.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Answer Error</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Respondent Error</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Response Error</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/non-response-error"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/survey-data"/>
    </owl:NamedIndividual>
