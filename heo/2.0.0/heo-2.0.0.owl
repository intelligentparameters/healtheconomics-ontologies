    <!-- https://healtheconomics.wiki/concept/average-treatment-effect -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/average-treatment-effect">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/treatment-effect"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q4828276"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/treatment-effect"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/icer"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/incremental-net-monetary-benefit"/>
        <skos:notation>HE-ES-CER-003</skos:notation>
        <dcterms:identifier>HE-ES-CER-003</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Rubin 1974</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Average Treatment Effect</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">ATE</skos:altLabel>
        <skos:definition xml:lang="en">The average treatment effect (ATE) is the mean change in costs or health outcomes if a whole population received a treatment rather than its comparator.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Population Average Effect</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Average Treatment Effect</skos:prefLabel>
        <abbreviation xml:lang="en">ATE</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/heterogeneous-treatment-effect"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/average-treatment-effect"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/treatment-effect"/>
        <dcterms:identifier>HEO-L-4de85ea065c3</dcterms:identifier>
        <linkRationale xml:lang="en">ATE is a treatment effect</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
