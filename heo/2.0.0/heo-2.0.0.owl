        <skos:notation>HS-NHS-HSP-017</skos:notation>
        <dcterms:identifier>HS-NHS-HSP-017</dcterms:identifier>
        <dcterms:source>Fetter et al. 1980</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Severity of Illness</rdfs:label>
        <skos:definition xml:lang="en">A classification indicating how clinically serious a condition is, based on physiological instability and organ involvement, used to risk-adjust comparisons.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Clinical Severity Class</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Illness Severity</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Severity of Illness</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/case-complexity"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
