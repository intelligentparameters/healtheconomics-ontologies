    <!-- https://healtheconomics.wiki/concept/lifetime-prevalence -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/lifetime-prevalence">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
