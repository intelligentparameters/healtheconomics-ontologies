    <!-- https://healtheconomics.wiki/concept/reference-case -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/reference-case">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:notation>HE-EE-CEA-056</skos:notation>
        <dcterms:identifier>HE-EE-CEA-056</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>NICE PMG36 | Canada’s Drug Agency Guidelines for the Economic Evaluation of Health Technologies, 4th edition | Sanders et al. JAMA 2016 | PBAC Guidelines Section 3</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Reference Case</rdfs:label>
        <owl:versionInfo>1.5.22</owl:versionInfo>
        <skos:altLabel xml:lang="en">Economic Evidence Requirements</skos:altLabel>
        <skos:definition xml:lang="en">A reference case is the set of methods, such as perspective, outcome measure and discounting, that HTA bodies like NICE expect economic evaluations to use.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Base-Case Methods Standard</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Cost-Evidence Standards</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Economic Submission Requirements</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Standard Analytic Case</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Reference Case</skos:prefLabel>
        <benchmarkFor rdf:resource="https://healtheconomics.wiki/concept/economic-evaluation"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-technology-assessment#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/base-case"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/discount-rate"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/perspective"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/qaly"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
