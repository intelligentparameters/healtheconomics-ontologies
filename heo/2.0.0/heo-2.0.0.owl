    <!-- https://healtheconomics.wiki/concept/rawlsian-welfare -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/rawlsian-welfare">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/social-welfare-function"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/social-welfare-function"/>
        <skos:notation>HE-EE-WE-019</skos:notation>
        <dcterms:identifier>HE-EE-WE-019</dcterms:identifier>
        <dcterms:source>Rawls 1971</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Rawlsian Welfare</rdfs:label>
        <skos:altLabel xml:lang="en">Maximin Welfare</skos:altLabel>
        <skos:definition xml:lang="en">A conception of social welfare judging policies by their effect on the least advantaged, rather than the total or average welfare produced.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Rawlsian Objective</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Rawlsian Welfare</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/utilitarian-welfare"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/maximin-criterion"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/rawlsian-welfare"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/social-welfare-function"/>
        <dcterms:identifier>HEO-L-d3a72ad633ce</dcterms:identifier>
        <linkRationale xml:lang="en">Rawlsian welfare is a social welfare function.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
