    <!-- https://healtheconomics.wiki/concept/decision-curve-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/decision-curve-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/decision-analysis"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q105038687"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/decision-analysis"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/clinical-utility"/>
        <skos:notation>HE-ES-CER-007</skos:notation>
        <dcterms:identifier>HE-ES-CER-007</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-02</dcterms:modified>
        <dcterms:source>Vickers &amp; Elkin 2006</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Decision Curve Analysis</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">DCA</skos:altLabel>
        <skos:definition xml:lang="en">Decision curve analysis (DCA) plots the net benefit of a prediction model or test across risk thresholds against treating all or no patients.</skos:definition>
        <skos:prefLabel xml:lang="en">Decision Curve Analysis</skos:prefLabel>
        <abbreviation xml:lang="en">DCA</abbreviation>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/risk-prediction-model"/>
