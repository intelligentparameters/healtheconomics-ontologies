    <!-- https://healtheconomics.wiki/concept/profile-instrument -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/profile-instrument">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/profile-based-measure"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/profile-based-measure"/>
        <skos:notation>HE-EE-HU-058</skos:notation>
        <dcterms:identifier>HE-EE-HU-058</dcterms:identifier>
        <dcterms:source>Brazier et al. 2007</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Profile Instrument</rdfs:label>
        <skos:definition xml:lang="en">A health status questionnaire reporting scores separately for each measured dimension, producing a multidimensional profile rather than a single summary score.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Health-Profile Questionnaire</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Multi-Domain Instrument</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Profile Instrument</skos:prefLabel>
        <produces rdf:resource="https://healtheconomics.wiki/concept/health-profile"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/profile-instrument"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/profile-based-measure"/>
        <dcterms:identifier>HEO-L-69c504bb11ec</dcterms:identifier>
        <linkRationale xml:lang="en">A profile instrument is a profile-based measure.</linkRationale>
