    <!-- https://healtheconomics.wiki/concept/financial-protection-index -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/financial-protection-index">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
