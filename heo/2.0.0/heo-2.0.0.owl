    <!-- https://healtheconomics.wiki/concept/best-practice -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/best-practice">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-NHS-PM-004</skos:notation>
        <dcterms:identifier>HS-NHS-PM-004</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Ng &amp; de Colombani 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Best Practice</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Best practice in health care is an intervention shown to be effective and efficient in one setting that other providers could adopt with similar results.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Leading Practice</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Proven Practice</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Best Practice</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/standard-of-care"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/best-practice"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-8ad4f975bc5f</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; NHS Productivity &gt; Productivity Measurement: wiki topic Performance, productivity and quality sits in Health Systems</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/best-practice"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/standard-of-care"/>
        <dcterms:identifier>HEO-L-08a7ae2bdbad</dcterms:identifier>
