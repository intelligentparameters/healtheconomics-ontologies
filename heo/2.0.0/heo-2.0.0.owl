    <!-- https://healtheconomics.wiki/concept/performance-standards -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/performance-standards">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
