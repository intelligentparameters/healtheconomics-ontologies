        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Wellbeing or Capability Instrument</rdfs:label>
        <skos:definition xml:lang="en">Wellbeing or capability instruments are outcome measures, such as ICECAP, WEMWBS or EQ-HWB, that capture benefits beyond health that EQ-5D QALYs miss.</skos:definition>
