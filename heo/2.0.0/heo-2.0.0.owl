        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Gompertz Hazard Model</skos:altLabel>
        <skos:altLabel xml:lang="en">Gompertz Survival Model</skos:altLabel>
        <skos:definition xml:lang="en">A survival model based on the Gompertz distribution, assuming the hazard rate rises exponentially over time, a pattern common in age-related mortality.</skos:definition>
        <skos:prefLabel xml:lang="en">Gompertz Model</skos:prefLabel>
        <assumes rdf:resource="https://healtheconomics.wiki/concept/gompertz-distribution"/>
