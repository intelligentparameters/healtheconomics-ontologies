    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/linear-programming-health -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/linear-programming-health">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/linear-programming"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/linear-programming"/>
        <skos:notation>HE-EM-DM-050</skos:notation>
        <dcterms:identifier>HE-EM-DM-050</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-24</dcterms:modified>
        <dcterms:source>Dantzig 1963</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Linear Programming Health</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Health LP</skos:altLabel>
        <skos:definition xml:lang="en">An optimisation technique identifying the resource allocation that maximises or minimises a linear objective subject to linear constraints, such as a fixed budget.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Health Resource Optimisation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Linear Programming Health</skos:prefLabel>
        <abbreviation xml:lang="en">Health LP</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/integer-programming-health"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/resource-allocation"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-12"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/linear-programming-health"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/linear-programming"/>
        <dcterms:identifier>HEO-L-31377a117a16</dcterms:identifier>
        <linkRationale xml:lang="en">The health application is an instance of linear programming</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/linear-programming-health"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/integer-programming-health"/>
        <dcterms:identifier>HEO-L-52fcd6945fa3</dcterms:identifier>
        <linkRationale xml:lang="en">Divisible (LP) versus indivisible (integer) programmes are the standard alternative formulations</linkRationale>
