    <!-- https://healtheconomics.wiki/concept/rapid-cycle-improvement -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/rapid-cycle-improvement">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/continuous-quality-improvement"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/continuous-quality-improvement"/>
        <skos:notation>HS-SS_HQ-014</skos:notation>
        <dcterms:identifier>HS-SS_HQ-014</dcterms:identifier>
        <dcterms:source>Deming 1986</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Rapid Cycle Improvement</rdfs:label>
        <skos:altLabel xml:lang="en">RCI</skos:altLabel>
        <skos:altLabel xml:lang="en">Rapid-Cycle QI</skos:altLabel>
        <skos:definition xml:lang="en">An approach emphasising testing small, incremental changes quickly through successive plan-do-study-act cycles, allowing rapid learning and adjustment.</skos:definition>
        <skos:prefLabel xml:lang="en">Rapid Cycle Improvement</skos:prefLabel>
        <abbreviation xml:lang="en">RCI</abbreviation>
        <abbreviation xml:lang="en">Rapid-Cycle QI</abbreviation>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/plan-do-study-act"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/rapid-cycle-improvement"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/continuous-quality-improvement"/>
        <dcterms:identifier>HEO-L-d582f50faff6</dcterms:identifier>
        <linkRationale xml:lang="en">Rapid cycle improvement is CQI using PDSA.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/rapid-cycle-improvement"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/plan-do-study-act"/>
        <dcterms:identifier>HEO-L-2aaeb4029987</dcterms:identifier>
        <linkRationale xml:lang="en">Definition: successive PDSA cycles</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/rapid-review -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/rapid-review">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HS-HP-HTA-166</skos:notation>
        <dcterms:identifier>HS-HP-HTA-166</dcterms:identifier>
        <dcterms:source>Khangura et al. 2012</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Rapid Review</rdfs:label>
        <skos:definition xml:lang="en">An abbreviated systematic review conducted under time constraints, streamlining literature searching or quality assessment to produce timely evidence.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Accelerated Evidence Review</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Streamlined Review</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Rapid Review</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/narrative-review"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/rapid-review"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:identifier>HEO-L-bbb98dc0a5ad</dcterms:identifier>
        <linkRationale xml:lang="en">A rapid review is evidence synthesis.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/rapid-review"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/narrative-review"/>
        <dcterms:identifier>HEO-L-65bf32b87725</dcterms:identifier>
        <linkRationale xml:lang="en">A rapid review abbreviates a systematic review but still reports its methods, unlike a narrative review with no reproducible search (Narrative Review article).</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


