    <!-- https://healtheconomics.wiki/concept/causal-loop-diagram -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/causal-loop-diagram">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <precedes rdf:resource="https://healtheconomics.wiki/concept/stock-and-flow-model"/>
        <skos:notation>HE-EM-DM-007</skos:notation>
        <dcterms:identifier>HE-EM-DM-007</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-09</dcterms:modified>
        <dcterms:source>Crielaard et al. 2024</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Causal Loop Diagram</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">CLD</skos:altLabel>
        <skos:definition xml:lang="en">A causal loop diagram (CLD) maps signed cause-and-effect links between variables to show the feedback loops driving a health system or decision problem.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Systems Feedback Diagram</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Causal Loop Diagram</skos:prefLabel>
        <abbreviation xml:lang="en">CLD</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/logic-model"/>
        <represents rdf:resource="https://healtheconomics.wiki/concept/system-dynamics-model"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
