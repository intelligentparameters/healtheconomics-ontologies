    <!-- https://healtheconomics.wiki/concept/average-manufacturer-price -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/average-manufacturer-price">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
