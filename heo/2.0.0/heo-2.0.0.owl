    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/decision-tree-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/decision-tree-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/decision-tree"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
