    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/concept/point-estimate -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/point-estimate">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/parameter-input"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/parameter-input"/>
        <skos:notation>HE-EM-MP-031</skos:notation>
        <dcterms:identifier>HE-EM-MP-031</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Fisher 1922</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Point Estimate</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A point estimate is a single numerical value calculated from observed data or a fitted model to represent a specified unknown quantity on a stated scale.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Best-Guess Estimate</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Single-Value Estimate</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Point Estimate</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-4"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/point-estimate"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/parameter-input"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-60b9c4e2b7ac</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Model inputs and parameters in subdomain Economic Modelling; placed under Parameter Input, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/point-of-care-trial -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/point-of-care-trial">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/pragmatic-trial"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/randomised-controlled-trial"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/pragmatic-trial"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/randomised-controlled-trial"/>
        <skos:notation>HE-ES-CTM-068</skos:notation>
        <dcterms:identifier>HE-ES-CTM-068</dcterms:identifier>
        <dcterms:source>Fiore &amp; Lavori 2016</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Point-of-Care Trial</rdfs:label>
        <skos:altLabel xml:lang="en">POC Trial</skos:altLabel>
        <skos:definition xml:lang="en">A trial embedded directly within routine clinical care, using existing workflows and electronic records to randomise patients and collect outcome data.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Bedside Randomised Trial</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Point-of-Care Trial</skos:prefLabel>
        <abbreviation xml:lang="en">POC Trial</abbreviation>
        <produces rdf:resource="https://healtheconomics.wiki/concept/real-world-evidence"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/point-of-care-trial"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/pragmatic-trial"/>
        <dcterms:identifier>HEO-L-cafdbd3a956b</dcterms:identifier>
        <linkRationale xml:lang="en">A trial embedded in routine care is a pragmatic trial</linkRationale>
