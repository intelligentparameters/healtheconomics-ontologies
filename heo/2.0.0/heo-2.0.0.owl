    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/structural-assumption -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/structural-assumption">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/model-assumption"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/model-assumption"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/assumption-structure"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/model-structure"/>
        <skos:notation>HE-EM-MV-075</skos:notation>
        <dcterms:identifier>HE-EM-MV-075</dcterms:identifier>
        <dcterms:source>Philips et al. 2004</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Structural Assumption</rdfs:label>
        <skos:definition xml:lang="en">A simplifying premise embedded in a model&apos;s overall design, such as representing a disease with a fixed number of health states.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Model-Form Assumption</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Structural Modelling Assumption</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Structural Assumption</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/structural-uncertainty"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/structural-assumption"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/model-assumption"/>
        <dcterms:identifier>HEO-L-ad769277e876</dcterms:identifier>
        <linkRationale xml:lang="en">A structural assumption is a model assumption about design rather than parameter values.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/structural-assumption"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/assumption-structure"/>
        <dcterms:identifier>HEO-L-846416cc0cc0</dcterms:identifier>
        <linkRationale xml:lang="en">Object definition, the assumption structure is the full set of design assumptions, so each is a member</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/structural-assumption"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/model-structure"/>
        <dcterms:identifier>HEO-L-9f339aa71e6f</dcterms:identifier>
        <linkRationale xml:lang="en">Structural assumptions are embedded elements of a model&apos;s structure, per the subject definition</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/structural-assumption"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/structural-uncertainty"/>
        <dcterms:identifier>HEO-L-e2a8c72690a3</dcterms:identifier>
        <linkRationale xml:lang="en">Choices embedded in model design are the source of structural uncertainty.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


