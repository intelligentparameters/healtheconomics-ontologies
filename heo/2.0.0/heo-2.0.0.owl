        <skos:hiddenLabel xml:lang="en">Take-Up</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Take-Up Rate</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/undercoverage-rate"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-2"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/take-up-rate"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/uptake-rate"/>
        <dcterms:identifier>HEO-L-df4d0e7cbc4d</dcterms:identifier>
        <linkRationale xml:lang="en">Take-up rate is the uptake share among those eligible for a coverage programme.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
