    <!-- https://healtheconomics.wiki/concept/monopsony -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/monopsony">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/market-structure"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q319808"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/market-structure"/>
        <skos:notation>HE-EE-ME-042</skos:notation>
        <dcterms:identifier>HE-EE-ME-042</dcterms:identifier>
        <dcterms:source>Robinson 1933</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Monopsony</rdfs:label>
        <skos:altLabel xml:lang="en">Buyer Monopoly</skos:altLabel>
        <skos:definition xml:lang="en">A market structure in which a single buyer accounts for all or most purchases of a good, giving it power to push the price down.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Single-Buyer Market</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Monopsony</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/monopsony"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/market-structure"/>
        <dcterms:identifier>HEO-L-526c33428b68</dcterms:identifier>
        <linkRationale xml:lang="en">A market structure by definition</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


