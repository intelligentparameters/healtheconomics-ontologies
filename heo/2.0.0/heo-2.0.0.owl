        <dcterms:identifier>HEO-L-eb7c25a85c99</dcterms:identifier>
        <linkRationale xml:lang="en">Severity is one of the two components of symptom burden (object definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
