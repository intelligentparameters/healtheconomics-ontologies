    <!-- https://healtheconomics.wiki/concept/folding-back -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/folding-back">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/decision-tree"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/decision-tree"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/decision-tree"/>
        <skos:notation>HE-EM-DM-035</skos:notation>
        <dcterms:identifier>HE-EM-DM-035</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Weinstein &amp; Fineberg 1980</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Folding Back</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Backward Induction</skos:altLabel>
        <skos:altLabel xml:lang="en">Rolling Back</skos:altLabel>
        <skos:definition xml:lang="en">Folding back is the backward evaluation of a decision tree that takes probability-weighted values at chance nodes and selects the preferred feasible action at decision nodes under a stated objective.</skos:definition>
        <skos:prefLabel xml:lang="en">Folding Back</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/chance-node"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/expected-value"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/folding-back"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
