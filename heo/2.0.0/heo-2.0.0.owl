    <!-- https://healtheconomics.wiki/concept/health-system-strengthening -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/health-system-strengthening">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
