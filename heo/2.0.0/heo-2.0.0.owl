        <dcterms:identifier>HE-EE-BE-027</dcterms:identifier>
        <dcterms:source>Thaler 1999</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Mental Accounting Concept</rdfs:label>
        <skos:altLabel xml:lang="en">Mental Accounting</skos:altLabel>
        <skos:definition xml:lang="en">The tendency to categorise and treat money differently depending on its source or intended use, rather than as fully interchangeable.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Psychological Accounting</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Mental Accounting Concept</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
