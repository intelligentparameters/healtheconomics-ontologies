    <!-- https://healtheconomics.wiki/concept/dynamic-programming-health -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/dynamic-programming-health">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
