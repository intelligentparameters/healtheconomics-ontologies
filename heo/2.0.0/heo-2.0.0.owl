    <!-- https://healtheconomics.wiki/concept/coinsurance-maximum -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/coinsurance-maximum">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/out-of-pocket-maximum"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/out-of-pocket-maximum"/>
        <skos:notation>HS-HP-HI-038</skos:notation>
        <dcterms:identifier>HS-HP-HI-038</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Coinsurance Maximum</rdfs:label>
        <skos:definition xml:lang="en">The highest total amount an insured person will pay in coinsurance within a defined period, beyond which the insurer covers everything further.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Coinsurance Cap</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Coinsurance Limit</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Coinsurance Maximum</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/coinsurance"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/out-of-pocket-cost"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/coinsurance-maximum"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/out-of-pocket-maximum"/>
        <dcterms:identifier>HEO-L-55fe9343d62d</dcterms:identifier>
        <linkRationale xml:lang="en">A cap on coinsurance is an out-of-pocket cap</linkRationale>
