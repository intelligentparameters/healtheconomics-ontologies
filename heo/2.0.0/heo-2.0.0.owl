        <skos:altLabel xml:lang="en">ABF</skos:altLabel>
        <skos:altLabel xml:lang="en">Activity-Based Payment</skos:altLabel>
        <skos:definition xml:lang="en">Activity-based funding (ABF) pays hospitals a preset, case-mix-weighted price for each episode of care, so income follows patient numbers and complexity.</skos:definition>
        <skos:prefLabel xml:lang="en">Activity-Based Funding</skos:prefLabel>
        <abbreviation xml:lang="en">ABF</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/global-budget"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/cream-skimming"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/drg-creep"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/case-weight"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/diagnosis-related-group"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/activity-based-funding"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/case-based-payment"/>
        <dcterms:identifier>HEO-L-3bdfba359b07</dcterms:identifier>
        <linkRationale xml:lang="en">ABF pays a preset price per case-mix-weighted episode, a kind of case-based payment, not the reverse</linkRationale>
