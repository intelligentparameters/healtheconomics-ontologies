    <!-- https://healtheconomics.wiki/concept/language-barrier -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/language-barrier">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/access-barrier"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/access-barrier"/>
        <skos:notation>HS-HP-HE-024</skos:notation>
        <dcterms:identifier>HS-HP-HE-024</dcterms:identifier>
        <dcterms:source>Penchansky R, Thomas JW. The concept of access: definition and relationship to consumer satisfaction. Medical Care. 1981;19(2):127-140. doi:10.1097/00005650-198102000-00001.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Language Barrier</rdfs:label>
        <skos:altLabel xml:lang="en">Linguistic Barrier</skos:altLabel>
        <skos:definition xml:lang="en">An obstacle to healthcare arising from a mismatch between a patient&apos;s primary language and that used by providers or health materials.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Communication Barrier</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Language Barrier</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/acceptability"/>
