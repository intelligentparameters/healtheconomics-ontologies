        <dcterms:identifier>HE-EE-EPR-008</dcterms:identifier>
        <dcterms:source>Folland, Goodman &amp; Stano 2016</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Economic Incentive</rdfs:label>
        <skos:definition xml:lang="en">A financial or non-financial inducement designed to encourage a particular decision or behaviour.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Behavioural Incentive</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Financial Inducement</skos:hiddenLabel>
