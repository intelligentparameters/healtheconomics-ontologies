        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Charity care is free or discounted care a provider gives to patients who meet its financial assistance criteria and cannot pay all or part of the bill.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Financial Assistance Care</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Free Care</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Charity Care</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/bad-debt"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/access-to-care"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/financial-protection"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/means-testing"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/charity-care"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
