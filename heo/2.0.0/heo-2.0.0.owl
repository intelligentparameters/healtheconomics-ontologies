    <!-- https://healtheconomics.wiki/concept/incremental-budget -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/incremental-budget">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/budget-allocation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/budget-allocation"/>
        <skos:notation>HE-EE-BIA-036</skos:notation>
        <dcterms:identifier>HE-EE-BIA-036</dcterms:identifier>
        <dcterms:source>Wildavsky 1964</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Incremental Budget</rdfs:label>
        <skos:altLabel xml:lang="en">Incremental Budgeting</skos:altLabel>
        <skos:definition xml:lang="en">A budget built by adjusting the previous period&apos;s budget slightly rather than starting each line item from zero.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Roll-Forward Budget</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Incremental Budget</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
