    <!-- https://healtheconomics.wiki/concept/orthogonal-design -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/orthogonal-design">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/experimental-design"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/experimental-design"/>
        <skos:notation>HE-EE-CBA-038</skos:notation>
        <dcterms:identifier>HE-EE-CBA-038</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Louviere, Hensher &amp; Swait 2000</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Orthogonal Design</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">An experimental design for a choice experiment in which attribute levels are varied independently, so each attribute&apos;s effect on preference can be separated statistically.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Orthogonal Array Design</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Uncorrelated Design</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Orthogonal Design</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/outcomes#step-4"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/orthogonal-design"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/experimental-design"/>
        <dcterms:identifier>HEO-L-54b7db5866c0</dcterms:identifier>
        <linkRationale xml:lang="en">Orthogonal design is an experimental design for choice experiments</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/orthogonal-rotation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/orthogonal-rotation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/factor-rotation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/factor-rotation"/>
        <skos:notation>HE-ES-SA-143</skos:notation>
        <dcterms:identifier>HE-ES-SA-143</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Kaiser 1958</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Orthogonal Rotation</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A factor analysis technique transforming a solution into a more interpretable structure while constraining the resulting factors to remain uncorrelated.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Uncorrelated-Factor Rotation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Varimax-Type Rotation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Orthogonal Rotation</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/orthogonal-rotation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/factor-rotation"/>
        <dcterms:identifier>HEO-L-ca4367162aed</dcterms:identifier>
        <linkRationale xml:lang="en">Orthogonal rotation is a factor rotation</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


