    <!-- https://healtheconomics.wiki/concept/evic -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/evic">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/value-of-information"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/value-of-information"/>
        <skos:notation>HE-EE_VI-001</skos:notation>
        <dcterms:identifier>HE-EE_VI-001</dcterms:identifier>
        <dcterms:source>Claxton &amp; Posnett 1996</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">EVIC</rdfs:label>
        <skos:definition xml:lang="en">A value of information measure expressing the expected value of collecting further evidence before a technology decision, weighed against its cost.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Information Value Measure</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">VoI Decision Criterion</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">EVIC</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/evic"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/value-of-information"/>
        <dcterms:identifier>HEO-L-78f4a3fec888</dcterms:identifier>
        <linkRationale xml:lang="en">EVIC is a value of information measure (subject definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


