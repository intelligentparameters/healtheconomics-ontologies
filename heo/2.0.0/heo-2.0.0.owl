    <!-- https://healtheconomics.wiki/concept/gompertz-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/gompertz-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/parametric-survival-model"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/parametric-survival-model"/>
        <skos:notation>HE-EM-SM-032</skos:notation>
        <dcterms:identifier>HE-EM-SM-032</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-23</dcterms:modified>
