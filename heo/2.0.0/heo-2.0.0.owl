        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/common-pool-resources"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-good"/>
        <dcterms:identifier>HEO-L-a338bf92c4f9</dcterms:identifier>
