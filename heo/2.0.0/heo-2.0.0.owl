        <dcterms:identifier>HEO-L-db9482d07da1</dcterms:identifier>
        <linkRationale xml:lang="en">Blood incompatibility is one of the CMS hospital-acquired condition categories (non-payment policy).</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
