    <!-- https://healtheconomics.wiki/concept/abbreviated-new-drug-application -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/abbreviated-new-drug-application">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q4664417"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <precedes rdf:resource="https://healtheconomics.wiki/concept/drug-approval"/>
        <precedes rdf:resource="https://healtheconomics.wiki/concept/first-generic-entry"/>
        <precedes rdf:resource="https://healtheconomics.wiki/concept/subsequent-generic-entry"/>
        <skos:notation>HS-DC-GC-001</skos:notation>
        <dcterms:identifier>HS-DC-GC-001</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>FDA, Hatch-Waxman Act</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Abbreviated New Drug Application</rdfs:label>
        <owl:versionInfo>1.0.3</owl:versionInfo>
        <skos:altLabel xml:lang="en">ANDA</skos:altLabel>
        <skos:altLabel xml:lang="en">Abbreviated NDA</skos:altLabel>
        <skos:definition xml:lang="en">A streamlined US regulatory application letting a generic manufacturer gain approval by demonstrating bioequivalence to an approved reference drug, without repeating full trials.</skos:definition>
        <skos:prefLabel xml:lang="en">Abbreviated New Drug Application</skos:prefLabel>
        <abbreviation xml:lang="en">ANDA</abbreviation>
        <abbreviation xml:lang="en">Abbreviated NDA</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/biosimilar-approval"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/generic-entry-impact"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-policy#step-1"/>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/generic-drug"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/abbreviated-new-drug-application"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
