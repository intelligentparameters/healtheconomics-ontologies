    <!-- https://healtheconomics.wiki/concept/transplant-economics -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/transplant-economics">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/surgery-economics"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/surgery-economics"/>
        <skos:notation>HE-PE-AT-011</skos:notation>
        <dcterms:identifier>HE-PE-AT-011</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Transplant Economics</rdfs:label>
        <skos:definition xml:lang="en">The application of health economic evaluation to organ and tissue transplantation, weighing donor, surgical, and lifelong immunosuppression costs against survival and quality of life gains.</skos:definition>
        <skos:prefLabel xml:lang="en">Transplant Economics</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/transplant-economics"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/surgery-economics"/>
        <dcterms:identifier>HEO-L-9939dcfa154c</dcterms:identifier>
        <linkRationale xml:lang="en">Transplantation is a surgical procedure, so its evaluation is a branch of surgery economics.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/transplant-economics"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <dcterms:identifier>HEO-L-f55a46568474</dcterms:identifier>
        <linkRationale xml:lang="en">Transplant evaluations typically use cost-effectiveness analysis.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/transportability -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/transportability">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/transferability"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/transferability"/>
        <skos:notation>HE-ES-CER-027</skos:notation>
        <dcterms:identifier>HE-ES-CER-027</dcterms:identifier>
        <dcterms:source>Pearl &amp; Bareinboim 2011</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Transportability</rdfs:label>
        <skos:definition xml:lang="en">The degree to which causal effects estimated in one population can be validly generalised to apply to a different target population.</skos:definition>
        <skos:prefLabel xml:lang="en">Transportability</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/transportability"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/transferability"/>
        <dcterms:identifier>HEO-L-25798dbc6023</dcterms:identifier>
        <linkRationale xml:lang="en">Transportability is transferability of causal effects to a new target population.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/transportation-barrier -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/transportation-barrier">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/access-barrier"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/access-barrier"/>
        <skos:notation>HS-HP-HE-033</skos:notation>
        <dcterms:identifier>HS-HP-HE-033</dcterms:identifier>
        <dcterms:source>Penchansky R, Thomas JW. The concept of access: definition and relationship to consumer satisfaction. Medical Care. 1981;19(2):127-140. doi:10.1097/00005650-198102000-00001.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Transportation Barrier</rdfs:label>
        <skos:definition xml:lang="en">An obstacle to healthcare arising from a lack of adequate transport to reach facilities, particularly relevant in rural or mobility-limited populations.</skos:definition>
        <skos:prefLabel xml:lang="en">Transportation Barrier</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/accessibility"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/transportation-barrier"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/access-barrier"/>
        <dcterms:identifier>HEO-L-efc0fb66f2e3</dcterms:identifier>
        <linkRationale xml:lang="en">Lack of transport is one obstacle to obtaining care, an access barrier.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/transportation-barrier"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/accessibility"/>
        <dcterms:identifier>HEO-L-6c04b9c88382</dcterms:identifier>
        <linkRationale xml:lang="en">Lack of transport limits how easily people can reach services, given travel time and cost</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/trapezoidal-rule -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/trapezoidal-rule">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/numerical-integration"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/numerical-integration"/>
        <skos:notation>HE-EM-MV-085</skos:notation>
        <dcterms:identifier>HE-EM-MV-085</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-22</dcterms:modified>
        <dcterms:source>Press et al. 2007</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Trapezoidal Rule</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">The trapezoidal rule approximates a definite integral by replacing a curve with straight-line segments and summing the resulting trapezoid areas.</skos:definition>
        <skos:prefLabel xml:lang="en">Trapezoidal Rule</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-12"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/trapezoidal-rule"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/numerical-integration"/>
        <dcterms:identifier>HEO-L-f49f8737dbf3</dcterms:identifier>
        <linkRationale xml:lang="en">The trapezoidal rule is a numerical integration method.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/trauma-centre -->

