        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/curative-model-uncertainty"/>
        <dcterms:identifier>HEO-L-f628f9ee2044</dcterms:identifier>
        <linkRationale xml:lang="en">That uncertainty is defined as how long a one-time treatment effect lasts.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
