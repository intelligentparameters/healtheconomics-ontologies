    <!-- https://healtheconomics.wiki/concept/distribution-based-mid -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/distribution-based-mid">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/minimal-clinically-important-difference"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/minimal-clinically-important-difference"/>
        <skos:notation>HE-EE-HU-020</skos:notation>
