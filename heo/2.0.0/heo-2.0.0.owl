    <!-- https://healtheconomics.wiki/concept/mechanism-design -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/mechanism-design">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/game-theory-health"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/game-theory-health"/>
        <skos:notation>HE-EE-ME-038</skos:notation>
        <dcterms:identifier>HE-EE-ME-038</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-03</dcterms:modified>
        <dcterms:source>Royal Swedish Academy of Sciences 2007</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Mechanism Design</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Reverse Game Theory</skos:altLabel>
        <skos:definition xml:lang="en">Mechanism design uses game theory to set rules, such as auctions, tenders or matching schemes, under which self-interested choices serve a chosen goal.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Incentive Design</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Mechanism Design</skos:prefLabel>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/nash-equilibrium-health"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
