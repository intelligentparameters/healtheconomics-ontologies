    <!-- https://healtheconomics.wiki/concept/step-up-therapy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/step-up-therapy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
