    <!-- https://healtheconomics.wiki/concept/intraclass-correlation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/intraclass-correlation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/cluster-effect"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/inter-rater-reliability"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/design-effect"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/effective-sample-size"/>
        <skos:notation>HE-ES-SA-087</skos:notation>
        <dcterms:identifier>HE-ES-SA-087</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Shrout &amp; Fleiss 1979</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Intraclass Correlation</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">ICC</skos:altLabel>
        <skos:altLabel xml:lang="en">Intra-Cluster Correlation</skos:altLabel>
        <skos:definition xml:lang="en">A measure quantifying the proportion of total variance in an outcome attributable to differences between groups or clusters, relative to variance within them.</skos:definition>
        <skos:prefLabel xml:lang="en">Intraclass Correlation</skos:prefLabel>
        <abbreviation xml:lang="en">ICC</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/intraclass-correlation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
