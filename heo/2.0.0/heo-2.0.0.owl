    <!-- https://healtheconomics.wiki/concept/health-capital -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/health-capital">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/demand-for-health"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/demand-for-health"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/grossman-model"/>
        <skos:notation>HE-EE-EPR-014</skos:notation>
        <dcterms:identifier>HE-EE-EPR-014</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Grossman 1972</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Health Capital</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Stock of Health</skos:altLabel>
        <skos:definition xml:lang="en">Health capital is a conceptual stock of health that yields healthy time and changes through deterioration and health-producing investment over a person’s life.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Grossman Health Stock</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Health Capital</skos:prefLabel>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/health-capital"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/demand-for-health"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-66ff857a040c</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: curated: demand-for-health theory (Grossman), filed with Demand for Health, review B</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/health-capital"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/grossman-model"/>
        <dcterms:identifier>HEO-L-cc4467e5ca06</dcterms:identifier>
