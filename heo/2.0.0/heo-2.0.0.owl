        <rdfs:label xml:lang="en">Equity Analysis</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">An assessment of whether the distribution of health, access, or financing burden across a population is fair, distinct from merely equal.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Distributional Equity Assessment</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Fairness Assessment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Equity Analysis</skos:prefLabel>
