    <!-- https://healtheconomics.wiki/concept/integer-programming-health -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/integer-programming-health">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/constrained-optimisation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/constrained-optimisation"/>
        <skos:notation>HE-EM-DM-046</skos:notation>
        <dcterms:identifier>HE-EM-DM-046</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-03</dcterms:modified>
        <dcterms:source>Crown et al. 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Integer Programming</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Integer Optimisation</skos:altLabel>
        <skos:definition xml:lang="en">Integer programming chooses which indivisible health programmes or medicines to fund to maximise health gain, such as QALYs, within a fixed budget.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Discrete Optimisation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Integer Programming</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-league-table"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/linear-programming"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/resource-allocation"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-12"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/budget-constraint"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/integer-programming-health"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/constrained-optimisation"/>
        <dcterms:identifier>HEO-L-a0aed3fde114</dcterms:identifier>
        <linkRationale xml:lang="en">Maximising health within a budget is constrained optimisation</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
