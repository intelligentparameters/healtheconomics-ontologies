    <!-- https://healtheconomics.wiki/concept/transplant-centre -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/transplant-centre">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/healthcare-facility"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/healthcare-facility"/>
        <skos:notation>HS-HP-HD-116</skos:notation>
        <dcterms:identifier>HS-HP-HD-116</dcterms:identifier>
        <dcterms:source>AHA, American Hospital Association</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Transplant Centre</rdfs:label>
        <skos:altLabel xml:lang="en">Transplant Center</skos:altLabel>
        <skos:definition xml:lang="en">A specialist facility performing organ transplantation, maintaining certifications reflecting sufficient surgical volume and demonstrated outcomes for its transplant types.</skos:definition>
        <skos:prefLabel xml:lang="en">Transplant Centre</skos:prefLabel>
        <performs rdf:resource="https://healtheconomics.wiki/concept/inpatient-surgery"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/transplant-centre"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/healthcare-facility"/>
        <dcterms:identifier>HEO-L-0d2d5582169d</dcterms:identifier>
        <linkRationale xml:lang="en">second check: Transplant centres are usually units within general or academic hospitals, as decided for Cardiac Centre; subject definition says specialist facility</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
