    <!-- https://healtheconomics.wiki/concept/prospective-risk-adjustment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/prospective-risk-adjustment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/risk-adjustment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/risk-adjustment"/>
        <skos:notation>HS-HP-HI-148</skos:notation>
        <dcterms:identifier>HS-HP-HI-148</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Ellis 2008</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Prospective Risk Adjustment</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">An approach that uses characteristics recorded before a target period to predict that period’s expected health care needs or spending, often to adjust prospective payments across populations with different risk.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Forward Risk Adjustment</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Predictive Risk Adjustment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Prospective Risk Adjustment</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/retrospective-risk-adjustment"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-2"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/risk-score"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/prospective-risk-adjustment"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/risk-adjustment"/>
        <dcterms:identifier>HEO-L-c3e300ddfb94</dcterms:identifier>
        <linkRationale xml:lang="en">Prospective risk adjustment is risk adjustment.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
