        <owl:versionInfo>1.0.4</owl:versionInfo>
        <skos:altLabel xml:lang="en">ACR</skos:altLabel>
        <skos:definition xml:lang="en">Administrative cost ratio is the share of an insurer&apos;s premium income, or a health system&apos;s spending, used for administration rather than claims or care.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Expense Ratio</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Administrative Cost Ratio</skos:prefLabel>
        <abbreviation xml:lang="en">ACR</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/medical-loss-ratio"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/benchmarking"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/health-system-performance"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/administrative-cost-ratio"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/financial-ratio"/>
        <dcterms:identifier>HEO-L-415002101b25</dcterms:identifier>
        <linkRationale xml:lang="en">It is a ratio from financial accounts</linkRationale>
