        <rdfs:label xml:lang="en">Pharmaceutical Benefits Scheme</rdfs:label>
        <skos:altLabel xml:lang="en">PBS</skos:altLabel>
        <skos:definition xml:lang="en">The Pharmaceutical Benefits Scheme (PBS) is Australia&apos;s public subsidy scheme for medicines; the PBAC recommends which medicines it subsidises.</skos:definition>
        <skos:prefLabel xml:lang="en">Pharmaceutical Benefits Scheme</skos:prefLabel>
        <abbreviation xml:lang="en">PBS</abbreviation>
        <instanceOf rdf:resource="https://healtheconomics.wiki/concept/government-subsidy"/>
