    <!-- https://healtheconomics.wiki/concept/competition-based-pricing -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/competition-based-pricing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:notation>HS-DC-DP-015</skos:notation>
        <dcterms:identifier>HS-DC-DP-015</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Gomez Albrecht et al. 2023</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Competition-Based Pricing</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Competitive Pricing</skos:altLabel>
        <skos:definition xml:lang="en">Competition-based pricing sets a medicine&apos;s price from the prices of rival treatments for the same condition, not from its own cost or added health value.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Market-Based Pricing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Competition-Based Pricing</skos:prefLabel>
        <assumes rdf:resource="https://healtheconomics.wiki/concept/therapeutic-competition"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/cost-based-pricing"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/value-based-pricing"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/competition-based-pricing"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <dcterms:identifier>HEO-L-be57bc4ca1fd</dcterms:identifier>
        <linkRationale xml:lang="en">One approach to setting medicine prices</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
