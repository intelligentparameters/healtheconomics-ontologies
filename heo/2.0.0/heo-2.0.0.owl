        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Social Welfare</rdfs:label>
        <skos:altLabel xml:lang="en">Societal Welfare</skos:altLabel>
        <skos:definition xml:lang="en">The overall wellbeing of a society, treated as some aggregation of the wellbeing of its individual members under a specified welfare function.</skos:definition>
