    <!-- https://healtheconomics.wiki/concept/not-cost-effective -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/not-cost-effective">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <skos:notation>HE-EE-CEA-048</skos:notation>
        <dcterms:identifier>HE-EE-CEA-048</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Not Cost-Effective</rdfs:label>
        <skos:definition xml:lang="en">A judgement that an intervention&apos;s ICER exceeds the relevant cost-effectiveness threshold, meaning its extra benefit does not justify its extra cost.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Poor Value for Money</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Not Cost-Effective</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/cost-effective-intervention"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/coverage-decision"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/not-cost-effective"/>
