    <!-- https://healtheconomics.wiki/concept/digital-equity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/digital-equity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-equity"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-equity"/>
        <skos:notation>HS-SS_DH-017</skos:notation>
        <dcterms:identifier>HS-SS_DH-017</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</dcterms:modified>
        <dcterms:source>Richardson et al. 2022</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Digital Equity</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:altLabel xml:lang="en">Digital Health Equity</skos:altLabel>
        <skos:definition xml:lang="en">Digital equity in health is fair access to digital health care, with the devices, connection and skills to use it, and fair outcomes across social groups.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Fair Digital Access</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Digital Equity</skos:prefLabel>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/digital-equity"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-equity"/>
        <dcterms:identifier>HEO-L-790da2e69505</dcterms:identifier>
        <linkRationale xml:lang="en">digital equity is health equity in access to digital care</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/digital-evidence-framework -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/digital-evidence-framework">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
