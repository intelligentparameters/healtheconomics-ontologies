        <uses rdf:resource="https://healtheconomics.wiki/concept/number-needed-to-treat"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/benefit-risk-assessment"/>
