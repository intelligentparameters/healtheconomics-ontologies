    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/sensitivity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/specificity"/>
        <dcterms:identifier>HEO-L-7969902fbd50</dcterms:identifier>
        <linkRationale xml:lang="en">Sensitivity (true positive rate) and specificity (true negative rate) are paired opposing accuracy measures. Kept as the one direction of the pair.</linkRationale>
