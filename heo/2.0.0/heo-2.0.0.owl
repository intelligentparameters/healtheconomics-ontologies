    <!-- https://healtheconomics.wiki/concept/resource-based-value -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/resource-based-value">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <skos:notation>HS-HP-PP-090</skos:notation>
        <dcterms:identifier>HS-HP-PP-090</dcterms:identifier>
        <dcterms:source>Hsiao et al. 1988</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Resource-Based Value</rdfs:label>
        <skos:definition xml:lang="en">A payment concept tying reimbursement to actual resources, such as time and skill, required for a service, rather than historical charges.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Input-Based Value</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Resource-Cost Value</skos:hiddenLabel>
