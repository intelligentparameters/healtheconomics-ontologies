    <!-- https://healtheconomics.wiki/concept/political-feasibility -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/political-feasibility">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
