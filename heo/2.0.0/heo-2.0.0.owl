        <skos:notation>HE-EE-CBA-010</skos:notation>
        <dcterms:identifier>HE-EE-CBA-010</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Hauber et al. 2016</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Conjoint Analysis</rdfs:label>
        <owl:versionInfo>1.0.3</owl:versionInfo>
        <skos:definition xml:lang="en">Conjoint analysis is a family of stated preference methods estimating how people value treatment or service attributes from ratings, rankings or choices.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Attribute Trade-Off Study</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Conjoint Study</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Conjoint Analysis</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/benefit-risk-assessment"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/multi-criteria-decision-analysis"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/outcomes#step-4"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/part-worth-utility"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/orthogonal-design"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/conjoint-analysis"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/stated-preference"/>
        <dcterms:identifier>HEO-L-cd7b2ba4d950</dcterms:identifier>
        <linkRationale xml:lang="en">Elicits stated preferences</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
