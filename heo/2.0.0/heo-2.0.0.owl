    <!-- https://healtheconomics.wiki/concept/biomarker-endpoint -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/biomarker-endpoint">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/surrogate-endpoint"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/surrogate-endpoint"/>
        <skos:notation>HE-ES-CO-005</skos:notation>
        <dcterms:identifier>HE-ES-CO-005</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>FDA 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Biomarker Endpoint</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">A biomarker endpoint is a trial outcome built on a measured biological marker, such as LDL cholesterol, which cost-utility models must convert into QALYs.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Biomarker Outcome</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Biomarker-Based Endpoint</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Biomarker Endpoint</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/final-outcome"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/outcomes#step-1"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/accelerated-approval"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/biomarker"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/biomarker-endpoint"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/surrogate-endpoint"/>
        <dcterms:identifier>HEO-L-7428960e37d0</dcterms:identifier>
        <linkRationale xml:lang="en">As defined, a biomarker endpoint stands in for clinical benefit that models must convert to QALYs</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
