        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Malmquist Productivity Index</skos:altLabel>
        <skos:definition xml:lang="en">A productivity measure decomposing efficiency change over time into genuine technical progress versus change relative to an evolving best-practice frontier.</skos:definition>
        <skos:hiddenLabel xml:lang="en">TFP Index</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Malmquist Index</skos:prefLabel>
