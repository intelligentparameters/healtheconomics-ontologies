    <!-- https://healtheconomics.wiki/concept/precision -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/precision">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-ES-SA-161</skos:notation>
        <dcterms:identifier>HE-ES-SA-161</dcterms:identifier>
        <dcterms:source>Casella G, Berger RL. Statistical Inference. 2nd ed. Duxbury; 2002.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Precision</rdfs:label>
        <skos:definition xml:lang="en">A measure of how closely repeated statistical estimates cluster together, with a more precise estimate having a narrower confidence interval.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Measurement Consistency</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Reproducibility of Measurement</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Precision</skos:prefLabel>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/effect-estimate"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/precision"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-2652eccbcd54</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Statistical Analysis: catalogue subdomain Evidence Synthesis is one of the subdomains</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/precision"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isPropertyOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/effect-estimate"/>
        <dcterms:identifier>HEO-L-2a8136aa6707</dcterms:identifier>
        <linkRationale xml:lang="en">Subject is the precision of a statistical estimate, not an instrument measurement property</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/precision-assessment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/precision-assessment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-assessment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-assessment"/>
        <skos:notation>HE-ES-EA-030</skos:notation>
        <dcterms:identifier>HE-ES-EA-030</dcterms:identifier>
        <dcterms:source>Guyatt GH, Oxman AD, Vist GE, et al. GRADE: an emerging consensus on rating quality of evidence and strength of recommendations. BMJ. 2008;336:924-926. doi:10.1136/bmj.39489.470347.AD.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Precision Assessment</rdfs:label>
        <skos:definition xml:lang="en">An evaluation of an effect estimate&apos;s statistical precision, typically judged by the width of its confidence interval, wider meaning greater uncertainty.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Imprecision Rating</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Precision Appraisal</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Precision Assessment</skos:prefLabel>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/precision"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/certainty-of-evidence"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/confidence-interval-estimation"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/precision-assessment"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-assessment"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-2171a108470d</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Evidence Appraisal: catalogue subdomain Evidence Synthesis is one of the subdomains; placed under Evidence Assessment, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/precision-assessment"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#evaluates"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/precision"/>
        <dcterms:identifier>HEO-L-9d7b76c9fa86</dcterms:identifier>
        <linkRationale xml:lang="en">An assessment of precision appraises precision; it is not itself a kind of precision</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
