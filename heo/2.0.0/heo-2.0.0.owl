        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/cognitively-impaired-research"/>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/pregnant-women-research"/>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/prisoner-research"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/research-ethics"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/bioethics"/>
        <dcterms:identifier>HEO-L-c4f532a28694</dcterms:identifier>
        <linkRationale xml:lang="en">Research ethics is a branch of bioethics.</linkRationale>
