    <!-- https://healtheconomics.wiki/concept/confounding -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/confounding">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/bias"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/bias"/>
        <skos:notation>HE-ES-EP-008</skos:notation>
        <dcterms:identifier>HE-ES-EP-008</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Hernán &amp; Robins 2020</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Confounding</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Confounding is bias in an estimated treatment effect when a common cause of treatment and outcome mixes the treatment&apos;s effect with group differences.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Confounded Association</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Third-Variable Bias</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Confounding</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/effect-modification"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/simpson-paradox"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/before-and-after-study"/>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/causal-inference"/>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/non-randomised-controlled-trial"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/confounding"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
