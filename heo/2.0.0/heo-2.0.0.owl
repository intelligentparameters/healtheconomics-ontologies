    <!-- https://healtheconomics.wiki/concept/activity-based-funding -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/activity-based-funding">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/case-based-payment"/>
