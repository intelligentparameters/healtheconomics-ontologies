        <dcterms:identifier>HE-ES-CO-002</dcterms:identifier>
        <dcterms:source>Osterberg &amp; Blaschke 2005</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Adherence Outcome</rdfs:label>
        <skos:definition xml:lang="en">A measure of the extent to which a patient follows a prescribed treatment regimen as recommended, such as taking medication at the correct dose.</skos:definition>
