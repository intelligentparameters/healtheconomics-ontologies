    <!-- https://healtheconomics.wiki/concept/lifecycle-management -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/lifecycle-management">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:notation>HE-PE-PE-017</skos:notation>
        <dcterms:identifier>HE-PE-PE-017</dcterms:identifier>
        <dcterms:source>DiMasi JA, Grabowski HG, Hansen RW. Innovation in the pharmaceutical industry: new estimates of R&amp;D costs. Journal of Health Economics. 2016;47:20-33. doi:10.1016/j.jhealeco.2016.01.012.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Lifecycle Management</rdfs:label>
        <skos:altLabel xml:lang="en">Product Life-Cycle Management</skos:altLabel>
        <skos:definition xml:lang="en">The strategic planning of activities maximising a product&apos;s commercial value over its market life, including label expansions and new formulations.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Brand Lifecycle Strategy</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Lifecycle Plan</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Lifecycle Management</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/label-extension"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/lifecycle-management"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
