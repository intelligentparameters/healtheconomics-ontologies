        <skos:notation>HE-EE-CRE-002</skos:notation>
        <dcterms:identifier>HE-EE-CRE-002</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Coase 1960</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Coase Theorem</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Coase&apos;s Theorem</skos:altLabel>
        <skos:definition xml:lang="en">The Coase theorem holds that, with clear property rights and no transaction costs, bargaining reaches an efficient outcome whoever holds the rights.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Coasean Bargaining</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Coase Theorem</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/externality"/>
        <assumes rdf:resource="https://healtheconomics.wiki/concept/property-rights"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/pigouvian-tax"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/coase-theorem"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-52146d48ad73</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Market failure and information in subdomain Economic Foundations</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/coase-theorem"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#addresses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/externality"/>
        <dcterms:identifier>HEO-L-95fd67f2aa82</dcterms:identifier>
        <linkRationale xml:lang="en">The theorem is a theoretical solution to externalities via bargaining</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
