    <!-- https://healtheconomics.wiki/concept/active-treatment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/active-treatment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/clinical-trial"/>
        <skos:notation>HE-PE-DT-001</skos:notation>
        <dcterms:identifier>HE-PE-DT-001</dcterms:identifier>
        <dcterms:source>Friedman LM, Furberg CD, DeMets DL, Reboussin DM, Granger CB. Fundamentals of Clinical Trials. 5th ed. Springer; 2015. doi:10.1007/978-3-319-18539-2.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Active Treatment</rdfs:label>
        <skos:definition xml:lang="en">The intervention under investigation in a trial intended to have a genuine pharmacological or therapeutic effect, unlike a placebo or inactive comparator.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Active Arm Treatment</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Investigational Treatment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Active Treatment</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/placebo-comparator"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
