    <!-- https://healtheconomics.wiki/concept/kaplan-meier-curve -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/kaplan-meier-curve">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1432420"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:notation>HE-EM-SM-037</skos:notation>
        <dcterms:identifier>HE-EM-SM-037</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Kaplan &amp; Meier 1958</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Kaplan-Meier Curve</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">KM Curve</skos:altLabel>
        <skos:definition xml:lang="en">A graphical display of the Kaplan-Meier survival estimate, shown as a step function that decreases at each observed event over time.</skos:definition>
