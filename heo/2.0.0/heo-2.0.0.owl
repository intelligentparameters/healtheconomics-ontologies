    <!-- https://healtheconomics.wiki/concept/direct-cost -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/direct-cost">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/societal-cost"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/economic-burden"/>
        <skos:notation>HE-EE-CA-033</skos:notation>
        <dcterms:identifier>HE-EE-CA-033</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</dcterms:modified>
        <dcterms:source>Jo 2014</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Direct Cost</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:altLabel xml:lang="en">Direct Costs</skos:altLabel>
        <skos:definition xml:lang="en">Direct cost is a cost traced to a service or patient or, in economic evaluation, resources used for care or due to illness, such as medicines and travel.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Directly-Attributable Cost</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Direct Cost</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/indirect-cost"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/direct-cost"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <dcterms:identifier>HEO-L-ce2f341cefa5</dcterms:identifier>
        <linkRationale xml:lang="en">a direct cost is a cost, the value of resources used</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/direct-cost"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/societal-cost"/>
        <dcterms:identifier>HEO-L-e07056cdb58c</dcterms:identifier>
        <linkRationale xml:lang="en">The object definition lists direct costs as a component of societal cost</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/direct-cost"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-burden"/>
        <dcterms:identifier>HEO-L-d25098ed6804</dcterms:identifier>
