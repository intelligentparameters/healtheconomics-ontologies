    <!-- https://healtheconomics.wiki/concept/performance-based-agreement -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/performance-based-agreement">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/managed-entry-agreement"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/managed-entry-agreement"/>
        <skos:notation>HS-DC-MA-022</skos:notation>
        <dcterms:identifier>HS-DC-MA-022</dcterms:identifier>
        <dcterms:source>Carlson JJ, Sullivan SD, Garrison LP, Neumann PJ, Veenstra DL. Linking payment to health outcomes: a taxonomy and examination of performance-based reimbursement schemes. Health Policy. 2010;96(3):179-190.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Performance-Based Agreement</rdfs:label>
        <skos:altLabel xml:lang="en">Outcome-Based Pricing</skos:altLabel>
        <skos:altLabel xml:lang="en">PBA</skos:altLabel>
        <skos:definition xml:lang="en">A contractual arrangement in which pricing or continued reimbursement depends on a treatment achieving specified performance criteria in real-world use.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Pay-for-Performance Pricing</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Performance Agreement</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Performance-Based Pricing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Performance-Based Agreement</skos:prefLabel>
        <abbreviation xml:lang="en">PBA</abbreviation>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/performance-based-agreement"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/managed-entry-agreement"/>
        <dcterms:identifier>HEO-L-f28740f5ff71</dcterms:identifier>
        <linkRationale xml:lang="en">Performance-based agreements are a recognised form of managed entry agreement</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/performance-based-financing -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/performance-based-financing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/results-based-financing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/results-based-financing"/>
        <skos:notation>HS-HP-HF-053</skos:notation>
        <dcterms:identifier>HS-HP-HF-053</dcterms:identifier>
        <dcterms:source>Carlson JJ, Sullivan SD, Garrison LP, Neumann PJ, Veenstra DL. Linking payment to health outcomes: a taxonomy and examination of performance-based reimbursement schemes. Health Policy. 2010;96(3):179-190.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Performance-Based Financing</rdfs:label>
        <skos:altLabel xml:lang="en">PBF</skos:altLabel>
        <skos:definition xml:lang="en">A financing approach tying provider or programme payments to achievement of predefined performance targets, such as immunisation coverage.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Results-Linked Financing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Performance-Based Financing</skos:prefLabel>
        <abbreviation xml:lang="en">PBF</abbreviation>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/performance-based-financing"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/results-based-financing"/>
        <dcterms:identifier>HEO-L-7e0a784a8b23</dcterms:identifier>
        <linkRationale xml:lang="en">Performance-based financing is the supply-side form of results-based financing</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/performance-based-rebate -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/performance-based-rebate">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/performance-based-agreement"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/rebate"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/performance-based-agreement"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/rebate"/>
        <skos:notation>HS-DC-DP-062</skos:notation>
        <dcterms:identifier>HS-DC-DP-062</dcterms:identifier>
        <dcterms:source>Carlson JJ, Sullivan SD, Garrison LP, Neumann PJ, Veenstra DL. Linking payment to health outcomes: a taxonomy and examination of performance-based reimbursement schemes. Health Policy. 2010;96(3):179-190.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Performance-Based Rebate</rdfs:label>
        <skos:altLabel xml:lang="en">Outcome-Based Rebate</skos:altLabel>
        <skos:altLabel xml:lang="en">Outcomes-Based Rebate</skos:altLabel>
        <skos:altLabel xml:lang="en">Risk-Sharing Rebate</skos:altLabel>
        <skos:definition xml:lang="en">A rebate arrangement in which a manufacturer discount to a payer is contingent on the treatment achieving a specified level of clinical performance.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Outcome-Linked Rebate</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Performance Rebate</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Performance-Linked Rebate</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Results-Linked Rebate</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Value-Based Rebate</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Performance-Based Rebate</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/performance-based-rebate"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/performance-based-agreement"/>
        <dcterms:identifier>HEO-L-657861fcd93f</dcterms:identifier>
        <linkRationale xml:lang="en">A rebate contingent on clinical performance is one form of performance-based agreement</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/performance-based-rebate"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/rebate"/>
        <dcterms:identifier>HEO-L-0c0075430c90</dcterms:identifier>
        <linkRationale xml:lang="en">A performance-based rebate is a rebate by both definitions</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
