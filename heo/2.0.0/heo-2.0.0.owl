        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/quality-adjusted-coverage"/>
        <skos:notation>HS_SS_HS-014</skos:notation>
        <dcterms:identifier>HS_SS_HS-014</dcterms:identifier>
        <dcterms:source>WHO, UHC Service Coverage Index</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Service Coverage</rdfs:label>
        <skos:altLabel xml:lang="en">Intervention Coverage</skos:altLabel>
        <skos:definition xml:lang="en">The proportion of a target population that receives a specific needed healthcare service, a building block of overall health system performance.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Coverage Breadth</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Coverage of Intervention</skos:hiddenLabel>
