    <!-- https://healtheconomics.wiki/concept/gatekeeping -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/gatekeeping">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/hierarchical-testing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/hierarchical-testing"/>
        <skos:notation>HE-ES-SA-069</skos:notation>
        <dcterms:identifier>HE-ES-SA-069</dcterms:identifier>
        <dcterms:source>Dmitrienko, Tamhane &amp; Bretz 2009</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Gatekeeping</rdfs:label>
        <skos:definition xml:lang="en">A multiple testing strategy in which a lower-priority endpoint is only formally tested if a higher-priority endpoint has already achieved significance.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Priority-Ordered Testing</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Sequential Testing Strategy</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Gatekeeping</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/multiple-comparisons"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/type-i-error"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/gatekeeping"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/hierarchical-testing"/>
        <dcterms:identifier>HEO-L-8d45a948e4f3</dcterms:identifier>
        <linkRationale xml:lang="en">Definitions: gatekeeping tests lower-priority endpoints only after higher ones succeed, a kind of hierarchical testing.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/gatekeeping"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#addresses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/multiple-comparisons"/>
        <dcterms:identifier>HEO-L-4bda52dd6f78</dcterms:identifier>
        <linkRationale xml:lang="en">Multiple Comparisons is the problem; gatekeeping is a procedure designed to deal with it</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/gatekeeping"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/type-i-error"/>
        <dcterms:identifier>HEO-L-84264c61ef43</dcterms:identifier>
        <linkRationale xml:lang="en">Gatekeeping controls the familywise Type I error</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


