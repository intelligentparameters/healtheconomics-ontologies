    <!-- https://healtheconomics.wiki/concept/triple-therapy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/triple-therapy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/combination-therapy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/combination-therapy"/>
        <skos:notation>HE-PE-DT-062</skos:notation>
        <dcterms:identifier>HE-PE-DT-062</dcterms:identifier>
        <dcterms:source>Katzung 2017</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Triple Therapy</rdfs:label>
        <skos:definition xml:lang="en">A treatment regimen combining three distinct agents administered together, used when a single agent or two-drug combination gives inadequate control.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Three-Drug Regimen</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Triple Combination</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Triple Therapy</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/dual-therapy"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/triple-therapy"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/combination-therapy"/>
        <dcterms:identifier>HEO-L-9cde8c988e76</dcterms:identifier>
        <linkRationale xml:lang="en">Triple therapy combines agents, a combination therapy.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/triple-therapy"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/dual-therapy"/>
        <dcterms:identifier>HEO-L-8f1c5e261230</dcterms:identifier>
        <linkRationale xml:lang="en">Triple and dual therapy are alternative combination intensities.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
