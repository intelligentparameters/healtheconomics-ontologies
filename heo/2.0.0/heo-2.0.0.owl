        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Service Area</rdfs:label>
        <skos:altLabel xml:lang="en">Catchment Area</skos:altLabel>
        <skos:altLabel xml:lang="en">Origin of Patients</skos:altLabel>
        <skos:altLabel xml:lang="en">Patient Origin</skos:altLabel>
        <skos:definition xml:lang="en">The defined geographic region from which a facility draws most of its patients, used in planning and regulatory determinations.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Facility Draw Area</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Patient Catchment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Service Area</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/capacity-planning"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/service-area"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
