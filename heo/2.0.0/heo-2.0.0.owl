    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/biological-therapy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/treatment"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q4915355"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/treatment"/>
        <skos:notation>HE-PE-BM-003</skos:notation>
        <dcterms:identifier>HE-PE-BM-003</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>FDA, Biologics Price Competition and Innovation Act 2009</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Biological Therapy</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Biologic Therapy</skos:altLabel>
        <skos:altLabel xml:lang="en">Biotherapy</skos:altLabel>
        <skos:definition xml:lang="en">Treatment using a medicinal product made from or derived from a biological source, assessed for a specific indication, delivery pathway and patient outcome.</skos:definition>
        <skos:prefLabel xml:lang="en">Biological Therapy</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-policy#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/biologic"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/biological-therapy"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/treatment"/>
        <dcterms:identifier>HEO-L-e909c2b452ad</dcterms:identifier>
        <linkRationale xml:lang="en">Not every biological therapy (e.g. vaccines, blood products) acts on a molecular target; it is a kind of treatment</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
