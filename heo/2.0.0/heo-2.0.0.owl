    <!-- https://healtheconomics.wiki/concept/take-up-rate -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/take-up-rate">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/uptake-rate"/>
