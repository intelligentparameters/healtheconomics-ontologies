    <!-- https://healtheconomics.wiki/concept/user-adjusted-coverage -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/user-adjusted-coverage">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-system-performance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-system-performance"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/effective-coverage"/>
        <skos:notation>HS-SS_HSP-067</skos:notation>
        <dcterms:identifier>HS-SS_HSP-067</dcterms:identifier>
        <dcterms:source>Tanahashi 1978</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">User-Adjusted Coverage</rdfs:label>
        <skos:definition xml:lang="en">A coverage measure accounting for whether people who received an intervention actually adhered to and properly utilised it as intended.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Use-Adjusted Coverage</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Utilisation-Weighted Coverage</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">User-Adjusted Coverage</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/user-adjusted-coverage"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-system-performance"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-4c0a1929d3aa</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Systems Strengthening &gt; Health System Performance: health system strengthening is the Health Systems subdomain; placed under Health System Performance, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/user-adjusted-coverage"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/effective-coverage"/>
        <dcterms:identifier>HEO-L-29b787e5ef05</dcterms:identifier>
        <linkRationale xml:lang="en">User-adjusted coverage is a step in the effective coverage cascade (received, then used as intended, then health gain), not a kind of it.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/user-fee -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/user-fee">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-sharing"/>
