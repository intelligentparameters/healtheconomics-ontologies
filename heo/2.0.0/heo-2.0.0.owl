        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Medication Persistence</rdfs:label>
        <skos:definition xml:lang="en">The duration a patient continues taking a prescribed medication from initiation until discontinuation, distinct from adherence&apos;s measure of consistency while in use.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Drug Persistence</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Therapy Continuation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Medication Persistence</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
