    <!-- https://healtheconomics.wiki/concept/geographic-transferability -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/geographic-transferability">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
