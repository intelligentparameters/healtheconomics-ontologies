        <dcterms:source>Musgrave &amp; Musgrave 1989</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cost-Sharing Reduction</rdfs:label>
        <skos:altLabel xml:lang="en">CSR</skos:altLabel>
        <skos:altLabel xml:lang="en">Cost-Sharing Subsidy</skos:altLabel>
        <skos:definition xml:lang="en">A policy or benefit feature lowering the out-of-pocket amount a patient pays for healthcare, typically targeted at lower-income individuals.</skos:definition>
        <skos:prefLabel xml:lang="en">Cost-Sharing Reduction</skos:prefLabel>
        <abbreviation xml:lang="en">CSR</abbreviation>
        <modifies rdf:resource="https://healtheconomics.wiki/concept/silver-plan"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/cost-sharing"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/out-of-pocket-cost"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
