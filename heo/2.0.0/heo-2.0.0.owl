    <!-- https://healtheconomics.wiki/concept/simpson-paradox -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/simpson-paradox">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/confounding"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q757290"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/confounding"/>
        <skos:notation>HE-DS-BV-035</skos:notation>
        <dcterms:identifier>HE-DS-BV-035</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Simpson 1951</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Simpson Paradox</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Simpson&apos;s Paradox</skos:altLabel>
        <skos:altLabel xml:lang="en">Yule-Simpson Effect</skos:altLabel>
        <skos:definition xml:lang="en">A statistical phenomenon where a trend seen within subgroups reverses or disappears once those subgroups are combined into a single aggregated analysis.</skos:definition>
        <skos:prefLabel xml:lang="en">Simpson Paradox</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-4"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/simpson-paradox"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/confounding"/>
        <dcterms:identifier>HEO-L-5ec7f03f85ef</dcterms:identifier>
        <linkRationale xml:lang="en">The reversal arises when the grouping variable confounds the pooled association, an extreme case of confounding rather than generic bias.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/simpson-rule -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/simpson-rule">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/numerical-integration"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/numerical-integration"/>
        <skos:notation>HE-EM-DM-089</skos:notation>
        <dcterms:identifier>HE-EM-DM-089</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Press et al. 2007</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Simpson Rule</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Simpson&apos;s Rule</skos:altLabel>
        <skos:definition xml:lang="en">Simpson rule is a closed Newton-Cotes numerical integration formula that approximates a definite integral over pairs of equal subintervals by integrating quadratic interpolants through successive triples of function values.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Parabolic Integration</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Simpson Rule</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/trapezoidal-rule"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-12"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/simpson-rule"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/numerical-integration"/>
        <dcterms:identifier>HEO-L-d5508c3fbef5</dcterms:identifier>
        <linkRationale xml:lang="en">Simpson rule approximates a definite integral, a numerical integration method.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
