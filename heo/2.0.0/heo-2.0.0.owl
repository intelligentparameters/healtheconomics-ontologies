        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/daly"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/healthy-life-expectancy"/>
        <skos:notation>HE-EE-DALY-007</skos:notation>
        <dcterms:identifier>HE-EE-DALY-007</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Vos et al. 2012</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
