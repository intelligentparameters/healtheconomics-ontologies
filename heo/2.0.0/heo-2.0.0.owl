        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">ROI</skos:altLabel>
        <skos:definition xml:lang="en">Return on investment is a monetary measure of the gain attributable to an intervention relative to its investment cost, calculated under an explicitly stated benefit, cost, time, and ratio convention.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Investment Return</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Return on Investment</skos:prefLabel>
        <abbreviation xml:lang="en">ROI</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/return-on-investment"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-benefit-analysis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-1a2dd14831b8</dcterms:identifier>
