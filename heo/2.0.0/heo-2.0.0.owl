    <!-- https://healtheconomics.wiki/concept/hepatotoxicity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/hepatotoxicity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/adverse-drug-reaction"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/adverse-event"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1349821"/>
