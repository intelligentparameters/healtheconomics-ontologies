    <!-- https://healtheconomics.wiki/concept/risk-adjustment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/risk-adjustment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q67399836"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:notation>HS-HP-HI-160</skos:notation>
        <dcterms:identifier>HS-HP-HI-160</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Ellis 2008</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Risk Adjustment</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">Risk adjustment makes outcomes, costs, utilisation or payments more comparable by accounting for differences in characteristics that affect expected results but are not the focus of the comparison.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Morbidity Adjustment</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Risk-Adjusted Payment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Risk Adjustment</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-2"/>
        <modifies rdf:resource="https://healtheconomics.wiki/concept/benchmark-price"/>
        <modifies rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/adverse-selection"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/cream-skimming"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/case-mix"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/comorbidity"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/diagnosis-based-risk-score"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/hierarchical-condition-category"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/pharmacy-based-risk-score"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/risk-score"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/severity-of-illness"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/risk-adjustment"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
