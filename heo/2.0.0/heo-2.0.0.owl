    <!-- https://healtheconomics.wiki/concept/misuse -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/misuse">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <skos:notation>HS-NHS-HQ-041</skos:notation>
        <dcterms:identifier>HS-NHS-HQ-041</dcterms:identifier>
        <dcterms:source>Chassin &amp; Galvin 1998</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Misuse</rdfs:label>
        <skos:definition xml:lang="en">The use of a service in a manner inconsistent with best practice, resulting in an avoidable complication, unlike overuse or underuse.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Improper Utilisation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Non-Best-Practice Use</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Misuse</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/overutilization"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/underuse"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/misuse"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-70ea88b2c11c</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; NHS Productivity &gt; Healthcare Quality: wiki topic Performance, productivity and quality sits in Health Systems; placed under Quality of Care, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
