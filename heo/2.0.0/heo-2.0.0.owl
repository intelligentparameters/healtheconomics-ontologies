    <!-- https://healtheconomics.wiki/concept/digital-health -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/digital-health">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-technology"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q50815224"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-technology"/>
