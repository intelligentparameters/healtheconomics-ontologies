    <!-- https://healtheconomics.wiki/concept/surrogate-evidence -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/surrogate-evidence">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-evidence"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
