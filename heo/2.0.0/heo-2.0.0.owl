        <skos:altLabel xml:lang="en">Concomitant Therapy</skos:altLabel>
        <skos:altLabel xml:lang="en">Concurrent Therapy</skos:altLabel>
        <skos:definition xml:lang="en">A treatment approach using two or more distinct agents together, often to achieve a greater effect than either alone or address multiple mechanisms.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Multi-Drug Therapy</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Simultaneous Treatment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Combination Therapy</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/monotherapy"/>
