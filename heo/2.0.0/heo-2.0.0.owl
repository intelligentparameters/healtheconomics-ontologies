    <!-- https://healtheconomics.wiki/concept/interdisciplinary-care -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/interdisciplinary-care">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/team-based-care"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/team-based-care"/>
        <skos:notation>HS-SS_IC-003</skos:notation>
        <dcterms:identifier>HS-SS_IC-003</dcterms:identifier>
        <dcterms:source>AHA, American Hospital Association</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Interdisciplinary Care</rdfs:label>
        <skos:altLabel xml:lang="en">Interprofessional Care</skos:altLabel>
        <skos:definition xml:lang="en">A delivery model in which providers from different disciplines work together interactively, integrating expertise into a jointly developed care plan.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Collaborative Team Care</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Interdisciplinary Care</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/multidisciplinary-care"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/transdisciplinary-care"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
