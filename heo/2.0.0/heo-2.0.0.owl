        <dcterms:identifier>HE-ES-CTM-066</dcterms:identifier>
        <dcterms:source>Woodcock &amp; LaVange 2017</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Platform Trial</rdfs:label>
        <skos:definition xml:lang="en">A trial design using one continuously operating master protocol to evaluate multiple treatments over time, letting treatments enter or leave by predefined rules.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Multi-Arm Multi-Stage Trial</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Standing-Platform Study</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Platform Trial</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/umbrella-trial"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/interim-analysis"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/platform-trial"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/adaptive-trial-design"/>
        <dcterms:identifier>HEO-L-77102b152ffb</dcterms:identifier>
        <linkRationale xml:lang="en">Arms enter and leave by prespecified interim rules.</linkRationale>
