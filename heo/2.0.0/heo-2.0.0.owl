    <!-- https://healtheconomics.wiki/concept/sequential-monte-carlo -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/sequential-monte-carlo">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/monte-carlo-simulation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/monte-carlo-simulation"/>
        <skos:notation>HE-EM-MP-039</skos:notation>
        <dcterms:identifier>HE-EM-MP-039</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Gordon, Salmond &amp; Smith 1993</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Sequential Monte Carlo</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A class of algorithms, including particle filtering, estimating a sequence of unknown quantities over time by updating weighted samples as new data arrive.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Particle Filtering</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Recursive Bayesian Estimation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Sequential Monte Carlo</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-4"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/bayesian-analysis"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/sequential-monte-carlo"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/monte-carlo-simulation"/>
        <dcterms:identifier>HEO-L-2dd3c5529463</dcterms:identifier>
        <linkRationale xml:lang="en">Sequential Monte Carlo is a repeated random sampling method.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/sequential-monte-carlo"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/bayesian-analysis"/>
        <dcterms:identifier>HEO-L-f3097d7adc6a</dcterms:identifier>
        <linkRationale xml:lang="en">Particle filtering updates weighted samples as data arrive, Bayesian updating.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
