        <skos:notation>HS-DC-DP-052</skos:notation>
        <dcterms:identifier>HS-DC-DP-052</dcterms:identifier>
        <dcterms:source>Carlson JJ, Sullivan SD, Garrison LP, Neumann PJ, Veenstra DL. Linking payment to health outcomes: a taxonomy and examination of performance-based reimbursement schemes. Health Policy. 2010;96(3):179-190.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Market Share Rebate</rdfs:label>
        <skos:definition xml:lang="en">A rebate arrangement in which the discount a manufacturer provides depends on the treatment&apos;s achieved market share relative to competing products.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Share-Based Rebate</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Volume Share Rebate</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Market Share Rebate</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/performance-based-rebate"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
