    <!-- https://healtheconomics.wiki/concept/brier-score -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/brier-score">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/mean-squared-error"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q4967066"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/mean-squared-error"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/predictive-accuracy"/>
        <skos:notation>HE-ES-SA-019</skos:notation>
        <dcterms:identifier>HE-ES-SA-019</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Brier 1950</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Brier Score</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Brier Loss</skos:altLabel>
        <skos:altLabel xml:lang="en">Probability Score</skos:altLabel>
        <skos:definition xml:lang="en">The Brier score is the mean squared difference between predicted risks and observed binary outcomes, used to judge prediction models; lower is better.</skos:definition>
        <skos:prefLabel xml:lang="en">Brier Score</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/area-under-curve"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/decision-curve-analysis"/>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/risk-prediction-model"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/brier-score"/>
