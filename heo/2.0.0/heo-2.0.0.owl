        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-system-performance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-system-performance"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/universal-health-coverage-index"/>
        <skos:notation>HS-SS_HSP-020</skos:notation>
        <dcterms:identifier>HS-SS_HSP-020</dcterms:identifier>
        <dcterms:source>WHO, UHC Service Coverage Index</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Crude Coverage</rdfs:label>
        <skos:definition xml:lang="en">A basic measure of the proportion of a target population receiving a service, without adjustment for its quality or timing, unlike effective coverage.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Raw Coverage Rate</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Unadjusted Coverage</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Crude Coverage</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/effective-coverage"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/crude-coverage"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-system-performance"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-bca8c77ab763</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Systems Strengthening &gt; Health System Performance: health system strengthening is the Health Systems subdomain; placed under Health System Performance, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/crude-coverage"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
