    <!-- https://healtheconomics.wiki/concept/operating-margin -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/operating-margin">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/profitability-ratio"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/profitability-ratio"/>
        <skos:notation>HE-EE_EA-036</skos:notation>
        <dcterms:identifier>HE-EE_EA-036</dcterms:identifier>
        <dcterms:source>Brealey, Myers &amp; Allen 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Operating Margin</rdfs:label>
        <skos:definition xml:lang="en">A financial ratio calculated as operating income divided by revenue, showing the proportion remaining after operating expenses but before non-operating items.</skos:definition>
        <skos:hiddenLabel xml:lang="en">EBIT Margin</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Operating Profit Ratio</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Operating Margin</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-4"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/operating-margin"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/profitability-ratio"/>
        <dcterms:identifier>HEO-L-5c4e4a7b8d97</dcterms:identifier>
        <linkRationale xml:lang="en">Operating margin measures profit relative to revenue, a profitability ratio</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


