    <!-- https://healtheconomics.wiki/concept/international-health -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/international-health">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/public-health"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/public-health"/>
        <precedes rdf:resource="https://healtheconomics.wiki/concept/global-health"/>
        <skos:notation>HS-SS-GH-015</skos:notation>
        <dcterms:identifier>HS-SS-GH-015</dcterms:identifier>
        <dcterms:source>Koplan et al. 2009</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">International Health</rdfs:label>
        <skos:definition xml:lang="en">A traditional field focused on health issues primarily affecting developing countries, emphasising knowledge transfer from wealthier to poorer nations.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Developing-Country Health</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Overseas Health</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">International Health</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/global-health"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/international-health"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/public-health"/>
