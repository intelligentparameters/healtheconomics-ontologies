    <!-- https://healtheconomics.wiki/concept/inpatient-rehabilitation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/inpatient-rehabilitation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/rehabilitation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/rehabilitation"/>
        <skos:notation>HS-HP-HD-064</skos:notation>
        <dcterms:identifier>HS-HP-HD-064</dcterms:identifier>
        <dcterms:source>AHA, American Hospital Association</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Inpatient Rehabilitation</rdfs:label>
        <skos:altLabel xml:lang="en">IRF Care</skos:altLabel>
        <skos:definition xml:lang="en">Intensive, multidisciplinary rehabilitative care for a hospitalised patient recovering from a significant illness, injury, or surgery, in a dedicated unit.</skos:definition>
