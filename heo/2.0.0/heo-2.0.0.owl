        <dcterms:identifier>HE-EE-DALY-006</dcterms:identifier>
        <dcterms:source>Romeder &amp; McWhinnie 1977</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Potential Life Years</rdfs:label>
        <skos:altLabel xml:lang="en">PYLL</skos:altLabel>
        <skos:definition xml:lang="en">A measure of premature mortality calculated as the years of life lost when death occurs before a specified reference age, such as seventy.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Life-Years Foregone</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Potential Life Years</skos:prefLabel>
        <abbreviation xml:lang="en">PYLL</abbreviation>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/potential-life-years"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/outcome-measure"/>
        <dcterms:identifier>HEO-L-1c30d9402363</dcterms:identifier>
        <linkRationale xml:lang="en">Potential life years lost is an outcome measure of premature mortality</linkRationale>
