    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/incremental-cost -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/incremental-cost">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/icer"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/incremental-cost-utility-ratio"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/incremental-net-monetary-benefit"/>
        <skos:notation>HE-EE-CA-050</skos:notation>
        <dcterms:identifier>HE-EE-CA-050</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Drummond et al. 2015 | NICE PMG36 Economic evaluation | Canada’s Drug Agency Guidelines for the Economic Evaluation of Health Technologies, 4th edition | PBAC Guidelines Section 3 | CHEERS 2022</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Incremental Cost</rdfs:label>
        <owl:versionInfo>1.2.13</owl:versionInfo>
        <skos:definition xml:lang="en">Incremental cost is the difference in expected total cost between one healthcare option and its stated comparator, calculated using the same population, perspective, time horizon, currency, price year and costing methods.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Additional Cost</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Marginal Cost Difference</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Incremental Cost</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/costs#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
