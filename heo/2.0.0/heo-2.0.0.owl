        <skos:altLabel xml:lang="en">Instrumental Variable Design</skos:altLabel>
        <skos:definition xml:lang="en">Instrumental variable analysis is a causal estimation approach that uses variation in treatment or exposure induced by a qualifying instrument to estimate an effect under explicit identification and modelling assumptions.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Instrument-Based Design</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Instrumental Variable Analysis</skos:prefLabel>
        <abbreviation xml:lang="en">IV Analysis</abbreviation>
        <abbreviation xml:lang="en">IV Design</abbreviation>
        <abbreviation xml:lang="en">IV Estimation</abbreviation>
