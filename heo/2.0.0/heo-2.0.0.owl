    <!-- https://healtheconomics.wiki/concept/primary-research -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/primary-research">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-source"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/evidence-source"/>
        <skos:notation>HE-ES-ES-046</skos:notation>
        <dcterms:identifier>HE-ES-ES-046</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</dcterms:modified>
        <dcterms:source>Wickham 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Primary Research</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">Primary research is research that collects new data, as in trials, cohort studies and preference or costing surveys, rather than reusing existing data.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Primary Study</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Primary Research</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/evidence-gap"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/secondary-data-analysis"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/secondary-research"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/primary-data-collection"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/primary-research"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-source"/>
        <dcterms:identifier>HEO-L-7238f8dc99e5</dcterms:identifier>
        <linkRationale xml:lang="en">A primary study is an evidence source for a model</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
