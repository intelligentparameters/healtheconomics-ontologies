        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <dcterms:identifier>HEO-L-8f46aace1b86</dcterms:identifier>
        <linkRationale xml:lang="en">Retrospective payment is a provider payment method.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/retrospective-query -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/retrospective-query">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/physician-query"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/physician-query"/>
        <skos:notation>HS-HP-HSR-054</skos:notation>
        <dcterms:identifier>HS-HP-HSR-054</dcterms:identifier>
        <dcterms:source>AHIMA, Clinical Documentation Improvement guidance</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Retrospective Query</rdfs:label>
        <skos:altLabel xml:lang="en">Retro Query</skos:altLabel>
        <skos:definition xml:lang="en">A request from a documentation specialist to a physician made after discharge, seeking clarification to ensure accurate coding of a completed record.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Post-Discharge Query</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Retrospective Query</skos:prefLabel>
        <abbreviation xml:lang="en">Retro Query</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/concurrent-query"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/coding-accuracy"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/retrospective-query"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/physician-query"/>
        <dcterms:identifier>HEO-L-cca220f9991c</dcterms:identifier>
        <linkRationale xml:lang="en">A retrospective query is a physician query made after discharge.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
