        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">SMD</skos:altLabel>
        <skos:altLabel xml:lang="en">Standardized Mean Difference</skos:altLabel>
        <skos:definition xml:lang="en">The standardised mean difference (SMD) is a mean difference divided by a standard deviation, used to pool continuous outcomes measured on different scales.</skos:definition>
        <skos:prefLabel xml:lang="en">Standardised Mean Difference</skos:prefLabel>
        <abbreviation xml:lang="en">SMD</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/mean-difference"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/standardised-response-mean"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/propensity-score-matching"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/standard-deviation"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/standardised-mean-difference"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/effect-size"/>
        <dcterms:identifier>HEO-L-76a57d338ba7</dcterms:identifier>
        <linkRationale xml:lang="en">SMD is an effect size.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/standardised-mean-difference"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/mean-difference"/>
        <dcterms:identifier>HEO-L-ffb6266394e5</dcterms:identifier>
