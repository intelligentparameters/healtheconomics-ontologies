    <!-- https://healtheconomics.wiki/concept/disaggregate-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/disaggregate-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-economic-model"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-economic-model"/>
        <skos:notation>HE-EM-DM-021</skos:notation>
        <dcterms:identifier>HE-EM-DM-021</dcterms:identifier>
        <dcterms:source>Briggs A, Claxton K, Sculpher M. Decision Modelling for Health Economic Evaluation. Oxford University Press; 2006. doi:10.1093/oso/9780198526629.001.0001.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Disaggregate Model</rdfs:label>
        <skos:altLabel xml:lang="en">Patient-Level Model</skos:altLabel>
        <skos:definition xml:lang="en">A model that represents individual patients or small subgroups separately, rather than summarising the population using aggregate averages.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Subgroup-Resolved Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Disaggregate Model</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/aggregate-model"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/disaggregate-model"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-economic-model"/>
        <dcterms:identifier>HEO-L-a8d8cb584d94</dcterms:identifier>
        <linkRationale xml:lang="en">a disaggregate model is a kind of model; Model Structure is the organisation of a model, not a model</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/disaggregate-model"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/aggregate-model"/>
        <dcterms:identifier>HEO-L-ec561d50edd0</dcterms:identifier>
        <linkRationale xml:lang="en">individual-level and aggregate cohort models are alternative modelling approaches</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/discharge-disposition -->

