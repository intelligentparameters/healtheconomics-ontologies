    <!-- https://healtheconomics.wiki/concept/generic-penetration -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/generic-penetration">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/market-share"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/market-share"/>
        <skos:notation>HS-DC-GC-005</skos:notation>
        <dcterms:identifier>HS-DC-GC-005</dcterms:identifier>
        <dcterms:source>Danzon 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Generic Penetration</rdfs:label>
        <skos:altLabel xml:lang="en">Generic Share</skos:altLabel>
        <skos:altLabel xml:lang="en">Generic Uptake</skos:altLabel>
        <skos:definition xml:lang="en">The proportion of prescriptions or utilisation within a therapeutic class accounted for by generic products rather than the original brand-name drug.</skos:definition>
        <skos:prefLabel xml:lang="en">Generic Penetration</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/price-erosion"/>
