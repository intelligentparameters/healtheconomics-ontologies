        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Provider Payment: wiki topic Provider payment sits in Health Systems; placed under Provider Payment, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/correct-coding-initiative"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
