    <!-- https://healtheconomics.wiki/concept/health-index -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/health-index">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/index-instrument"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/index-instrument"/>
        <skos:notation>HE-EE-HU-031</skos:notation>
        <dcterms:identifier>HE-EE-HU-031</dcterms:identifier>
        <dcterms:source>Torrance GW. Measurement of health state utilities for economic appraisal. Journal of Health Economics. 1986;5(1):1-30. doi:10.1016/0167-6296(86)90020-2.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Health Index</rdfs:label>
        <skos:altLabel xml:lang="en">Health Status Index</skos:altLabel>
        <skos:definition xml:lang="en">A single numerical summary of overall health status, derived by combining scores across multiple health dimensions using a specified scoring algorithm.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Composite Health Score</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Health Index</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/health-profile"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/health-index"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/index-instrument"/>
        <dcterms:identifier>HEO-L-2fe17a3878d1</dcterms:identifier>
        <linkRationale xml:lang="en">A health index in the index-versus-profile sense is an index-type instrument producing one summary score.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
