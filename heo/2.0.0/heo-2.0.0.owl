        <dcterms:identifier>HEO-L-7416e7df3c6e</dcterms:identifier>
        <linkRationale xml:lang="en">Process mapping is a tool whose maps inform improvement work; not a causal contributor.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/process-mapping"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#produces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/flow-chart"/>
        <dcterms:identifier>HEO-L-c2b742394033</dcterms:identifier>
