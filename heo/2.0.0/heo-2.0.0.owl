        <rdfs:label xml:lang="en">Panel Data</rdfs:label>
        <skos:altLabel xml:lang="en">Cross-Sectional Time-Series Data</skos:altLabel>
        <skos:definition xml:lang="en">Data following the same individuals or units repeatedly over multiple time periods, combining features of both cross-sectional and time series data.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Longitudinal Panel</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Panel Data</skos:prefLabel>
        <counterpartOf rdf:resource="https://healtheconomics.wiki/concept/repeated-measures"/>
