        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Bargaining Theory</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Bargaining theory explains how negotiating parties divide the gains from reaching agreement, as when a payer and a manufacturer agree a drug price.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Nash Bargaining</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Negotiation Theory</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Bargaining Theory</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/access-negotiation"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/managed-entry-agreement"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/bargaining-theory"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/game-theory-health"/>
        <dcterms:identifier>HEO-L-80729052bab9</dcterms:identifier>
        <linkRationale xml:lang="en">Bargaining is a strategic game (Nash bargaining)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
