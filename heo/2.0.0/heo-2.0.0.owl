    <!-- https://healtheconomics.wiki/concept/informal-care-cost -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/informal-care-cost">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <skos:notation>HS-DC-HC-008</skos:notation>
        <dcterms:identifier>HS-DC-HC-008</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Informal Care Cost</rdfs:label>
        <skos:altLabel xml:lang="en">Informal Caregiving Cost</skos:altLabel>
        <skos:altLabel xml:lang="en">Unpaid Care Cost</skos:altLabel>
        <skos:definition xml:lang="en">The economic value of unpaid caregiving time from family or friends, typically estimated using replacement cost or the carer&apos;s forgone time.</skos:definition>
        <skos:prefLabel xml:lang="en">Informal Care Cost</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/informal-care-cost"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <dcterms:identifier>HEO-L-f6e1bf8bc62c</dcterms:identifier>
        <linkRationale xml:lang="en">Guidelines differ on classing informal care as indirect or direct non-medical; it is uncontestably a cost of forgone carer time</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


