    <!-- https://healtheconomics.wiki/concept/coverage-broadening -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/coverage-broadening">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/coverage-expansion"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/coverage-expansion"/>
        <skos:notation>HS_SS_HS-002</skos:notation>
        <dcterms:identifier>HS_SS_HS-002</dcterms:identifier>
        <dcterms:source>WHO, Health Financing for Universal Coverage</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Coverage Broadening</rdfs:label>
        <skos:definition xml:lang="en">An expansion in the proportion of a population covered by a health financing scheme, one dimension of progress toward universal health coverage.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Breadth Expansion</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Population-Reach Expansion</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Coverage Broadening</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/coverage-deepening"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/population-coverage"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/universal-health-coverage"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/coverage-broadening"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/coverage-expansion"/>
        <dcterms:identifier>HEO-L-02ae7ab0d6f2</dcterms:identifier>
        <linkRationale xml:lang="en">Coverage expansion includes extending cover to more people</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
