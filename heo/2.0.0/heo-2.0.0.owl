    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/absolute-risk"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/incidence-rate"/>
        <dcterms:identifier>HEO-L-45c4461cb32f</dcterms:identifier>
        <linkRationale xml:lang="en">Risk is a proportion over a period, incidence rate is per person-time; standard epidemiological distinction</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/absolute-risk-reduction -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/absolute-risk-reduction">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/absolute-measure"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/risk-difference"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q2138790"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/absolute-measure"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/risk-difference"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/number-needed-to-treat"/>
        <skos:notation>HE-ES-RM-003</skos:notation>
        <dcterms:identifier>HE-ES-RM-003</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams &amp; Wilkins; 2008.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Absolute Risk Reduction</rdfs:label>
        <owl:versionInfo>1.0.5</owl:versionInfo>
        <skos:altLabel xml:lang="en">ARR</skos:altLabel>
        <skos:definition xml:lang="en">Absolute risk reduction is the arithmetic difference in the probability of a specified adverse outcome between a comparator group and an intervention group over the same defined time horizon.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Absolute Benefit Increase</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Absolute Risk Reduction</skos:prefLabel>
        <abbreviation xml:lang="en">ARR</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/relative-risk-reduction"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/absolute-risk-reduction"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/absolute-measure"/>
        <dcterms:identifier>HEO-L-4e293200b734</dcterms:identifier>
        <linkRationale xml:lang="en">ARR is the example given in the Absolute Effect Measure definition</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/absolute-risk-reduction"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
