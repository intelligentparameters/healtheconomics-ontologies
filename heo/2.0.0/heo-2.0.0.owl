    <!-- https://healtheconomics.wiki/concept/minimum-necessary -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/minimum-necessary">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/hipaa"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/privacy-standards"/>
        <skos:notation>HS-HP-DH-031</skos:notation>
        <dcterms:identifier>HS-HP-DH-031</dcterms:identifier>
        <dcterms:source>HHS, HIPAA Privacy Rule</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Minimum Necessary</rdfs:label>
        <skos:definition xml:lang="en">A US privacy principle requiring only the minimum amount of protected health information necessary for a specific purpose be used or disclosed.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Least-Data Principle</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Need-to-Know Data Rule</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Minimum Necessary</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
