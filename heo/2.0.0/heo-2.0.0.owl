    <!-- https://healtheconomics.wiki/concept/retaliation-protection -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/retaliation-protection">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/compliance-programme"/>
        <skos:notation>HS-HP-HSR-053</skos:notation>
        <dcterms:identifier>HS-HP-HSR-053</dcterms:identifier>
        <dcterms:source>US, False Claims Act (31 U.S.C. § 3729)</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Retaliation Protection</rdfs:label>
        <skos:definition xml:lang="en">A legal safeguard preventing an employer from punishing an employee for reporting suspected fraud, compliance violations, or other misconduct.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Anti-Retaliation Safeguard</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Whistleblower Protection</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Retaliation Protection</skos:prefLabel>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/whistleblower"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/retaliation-protection"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-b1dcdf1d4e18</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health System Regulation: compliance, audit and accreditation govern how providers work (Organisation and governance)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/retaliation-protection"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/compliance-programme"/>
        <dcterms:identifier>HEO-L-b2b963088e18</dcterms:identifier>
        <linkRationale xml:lang="en">Non-retaliation safeguards for reporting are an element of a compliance programme</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/retaliation-protection"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#promotes"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/whistleblower"/>
        <dcterms:identifier>HEO-L-3e8d614f8b00</dcterms:identifier>
