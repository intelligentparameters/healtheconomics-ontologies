        <dcterms:identifier>HE-EE-CA-030</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015. | Wailoo A, Dixon S. The Use of Cost Minimisation Analysis for the Appraisal of Health Technologies. NICE Decision Support Unit, University of Sheffield; 2019. | Dakin H, Wordsworth S. Cost-minimisation analysis versus cost-effectiveness analysis, revisited. Health Economics. 2013;22(1):22–34. doi:10.1002/hec.1812. | Briggs AH, O’Brien BJ. The death of cost-minimization analysis? Health Economics. 2001;10(2):179–184. doi:10.1002/hec.584. | PBAC. Section 3 and Section 3B: Economic Evaluation and Cost Minimisation. https://pbac.pbs.gov.au/section-3-economic-evaluation.html | NICE. Health Technology Evaluations: The Manual, PMG36.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cost-Minimisation Analysis</rdfs:label>
        <owl:versionInfo>1.5.24</owl:versionInfo>
        <skos:altLabel xml:lang="en">CMA</skos:altLabel>
        <skos:altLabel xml:lang="en">Cost-Minimization Analysis</skos:altLabel>
        <skos:definition xml:lang="en">Cost-minimisation analysis compares only the costs of healthcare options, and is valid only when evidence shows their health outcomes are equivalent.</skos:definition>
        <skos:prefLabel xml:lang="en">Cost-Minimisation Analysis</skos:prefLabel>
        <abbreviation xml:lang="en">CMA</abbreviation>
        <informs rdf:resource="https://healtheconomics.wiki/concept/coverage-decision"/>
