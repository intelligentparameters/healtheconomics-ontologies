    <!-- https://healtheconomics.wiki/concept/out-of-network -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/out-of-network">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:notation>HS-HP-HI-126</skos:notation>
        <dcterms:identifier>HS-HP-HI-126</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Out-of-Network</rdfs:label>
        <skos:altLabel xml:lang="en">OON</skos:altLabel>
        <skos:definition xml:lang="en">A designation for providers without a contractual agreement with a specific plan, typically resulting in higher cost-sharing or no coverage.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Out-of-Plan Provider</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Out-of-Network</skos:prefLabel>
        <abbreviation xml:lang="en">OON</abbreviation>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/surprise-billing"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/out-of-network-referral"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
