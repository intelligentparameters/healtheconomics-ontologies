        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/risk-prediction-model"/>
        <dcterms:identifier>HEO-L-281d7c8f1acb</dcterms:identifier>
        <linkRationale xml:lang="en">A prognostic model predicts future outcomes, i.e. a risk prediction model.</linkRationale>
