        <dcterms:identifier>HE-EE-BE-004</dcterms:identifier>
        <dcterms:source>Hertwig &amp; Grune-Yanoff 2017</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Boost Intervention</rdfs:label>
        <skos:definition xml:lang="en">An intervention that strengthens a person&apos;s own decision-making skills, such as statistical literacy, rather than changing the choice environment.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Boosting</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Competence-Building Intervention</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Boost Intervention</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/nudge-intervention"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
