    <!-- https://healtheconomics.wiki/concept/strength-of-evidence -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/strength-of-evidence">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q109973342"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:notation>HS-HP-HTA-206</skos:notation>
        <dcterms:identifier>HS-HP-HTA-206</dcterms:identifier>
        <dcterms:source>Guyatt GH, Oxman AD, Vist GE, et al. GRADE: an emerging consensus on rating quality of evidence and strength of recommendations. BMJ. 2008;336:924-926. doi:10.1136/bmj.39489.470347.AD.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Strength Of Evidence</rdfs:label>
        <skos:altLabel xml:lang="en">Evidence Strength</skos:altLabel>
        <skos:definition xml:lang="en">An overall judgement of how much confidence can be placed in a body of evidence, incorporating study quality, consistency, and precision.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Body-of-Evidence Rating</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Strength Of Evidence</skos:prefLabel>
        <counterpartOf rdf:resource="https://healtheconomics.wiki/concept/quality-of-evidence"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/strength-of-evidence"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-262cdae28e71</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health Technology Assessment: HTA concepts belong to the HTA subdomain</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/strength-of-evidence"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#counterpartOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/quality-of-evidence"/>
        <dcterms:identifier>HEO-L-477c326047b0</dcterms:identifier>
        <linkRationale xml:lang="en">Strength of evidence (AHRQ term) and quality of evidence (GRADE term) play the same role in different grading frameworks.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


