        <rdfs:label xml:lang="en">Perceived Health</rdfs:label>
        <skos:altLabel xml:lang="en">General Health Perception</skos:altLabel>
        <skos:definition xml:lang="en">A patient&apos;s own subjective rating of overall health status, shown to independently predict future health outcomes and healthcare use beyond clinical measures alone.</skos:definition>
