        <skos:notation>HS-NHS-HSC-001</skos:notation>
        <dcterms:identifier>HS-NHS-HSC-001</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Surge Capacity Cost</rdfs:label>
        <skos:definition xml:lang="en">The expense of maintaining a health system&apos;s ability to rapidly expand service capacity in response to a sudden demand increase.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Capacity Surge Cost</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Surge Cost</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Surge Capacity Cost</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/capacity-planning"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
