    <!-- https://healtheconomics.wiki/concept/information-barrier -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/information-barrier">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/access-barrier"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/access-barrier"/>
        <skos:notation>HS-SS-EQ-004</skos:notation>
        <dcterms:identifier>HS-SS-EQ-004</dcterms:identifier>
        <dcterms:source>Penchansky R, Thomas JW. The concept of access: definition and relationship to consumer satisfaction. Medical Care. 1981;19(2):127-140. doi:10.1097/00005650-198102000-00001.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Information Barrier</rdfs:label>
        <skos:altLabel xml:lang="en">Knowledge Barrier</skos:altLabel>
        <skos:definition xml:lang="en">An obstacle to healthcare arising from a lack of adequate information, whether about available services, one&apos;s condition, or the system.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Awareness Barrier</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Comprehension Barrier</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Information Access Obstacle</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Understanding Gap</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Information Barrier</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/information-barrier"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/access-barrier"/>
        <dcterms:identifier>HEO-L-1fa810b1e170</dcterms:identifier>
        <linkRationale xml:lang="en">A lack of information that blocks care is an access barrier</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


