    <!-- https://healtheconomics.wiki/concept/therapeutic-group-premium -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/therapeutic-group-premium">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/therapeutic-reference-pricing"/>
        <skos:notation>HS-DC-DP-099</skos:notation>
        <dcterms:identifier>HS-DC-DP-099</dcterms:identifier>
        <dcterms:source>Danzon 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Therapeutic Group Premium</rdfs:label>
        <skos:definition xml:lang="en">The additional price a treatment commands over the reference price for its therapeutic group under internal reference pricing, requiring the difference paid separately.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Reference Group Premium</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Therapeutic Reference Premium</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Therapeutic Group Premium</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/out-of-pocket-cost"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/therapeutic-group-premium"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-48ba89d2ee4f</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Drug Costs &gt; Drug Pricing: wiki topic Pricing and market access sits in Health Policy; placed under Drug Pricing, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/therapeutic-group-premium"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/therapeutic-reference-pricing"/>
        <dcterms:identifier>HEO-L-b8f53993060f</dcterms:identifier>
        <linkRationale xml:lang="en">The premium paid above the group reference price is an element of how therapeutic reference pricing works</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
