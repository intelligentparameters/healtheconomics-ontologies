    <!-- https://healtheconomics.wiki/concept/medication-safety -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/medication-safety">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
