        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">HYE</skos:altLabel>
        <skos:definition xml:lang="en">An alternative to the QALY deriving its valuations directly from a sequence of health states over a lifetime, rather than combining separate utility values.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Lifetime Health Equivalent</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Healthy Year Equivalent</skos:prefLabel>
        <abbreviation xml:lang="en">HYE</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/qaly"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/outcomes#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/standard-gamble"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/healthy-year-equivalent"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-adjusted-life-year"/>
        <dcterms:identifier>HEO-L-70ad99f3f831</dcterms:identifier>
        <linkRationale xml:lang="en">The HYE combines length and quality into one unit.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
