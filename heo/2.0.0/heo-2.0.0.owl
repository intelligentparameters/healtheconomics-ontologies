        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/p-value"/>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/post-hoc-analysis"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/multiple-comparisons"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
