    <!-- https://healtheconomics.wiki/concept/substance-use-economics -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/substance-use-economics">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/mental-health-economics"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/mental-health-economics"/>
        <skos:notation>HE-PE-MH-034</skos:notation>
        <dcterms:identifier>HE-PE-MH-034</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
