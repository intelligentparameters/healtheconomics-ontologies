        <skos:altLabel xml:lang="en">Medical IoT</skos:altLabel>
        <skos:definition xml:lang="en">The network of interconnected medical devices and health technologies collecting and exchanging data over the internet, including wearables and remote monitors.</skos:definition>
        <skos:prefLabel xml:lang="en">Internet Of Medical Things</skos:prefLabel>
        <abbreviation xml:lang="en">IoMT</abbreviation>
        <produces rdf:resource="https://healtheconomics.wiki/concept/real-world-data"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/internet-of-medical-things"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/digital-health"/>
        <dcterms:identifier>HEO-L-b191e566f938</dcterms:identifier>
        <linkRationale xml:lang="en">Wearables and remote monitors are digital health</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/internet-of-medical-things"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#produces"/>
