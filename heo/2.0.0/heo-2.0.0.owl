        <dcterms:source>AHA, American Hospital Association</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Secondary Care</rdfs:label>
        <skos:altLabel xml:lang="en">Secondary Healthcare</skos:altLabel>
        <skos:altLabel xml:lang="en">Specialist Care Model</skos:altLabel>
        <skos:definition xml:lang="en">Specialised medical care typically provided by a specialist following referral from primary care, between basic and highly specialised tertiary care.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Specialist Care</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Specialist Delivery Model</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Specialist-Led Care</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Secondary Care</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
