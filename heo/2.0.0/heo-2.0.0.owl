        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Capital Cost</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Capital Cost is the cost of assets used for over a year, such as buildings and medical equipment, spread over their useful life in economic evaluation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">CapEx</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Capital Expenditure</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Capital Cost</skos:prefLabel>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/capital-cost"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
