        <skos:hiddenLabel xml:lang="en">Real Options Analysis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Real Option Value</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/value-assessment"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-technology-assessment#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/real-option-value"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/value-element"/>
        <dcterms:identifier>HEO-L-e50bc030e96b</dcterms:identifier>
        <linkRationale xml:lang="en">Real option value is a component of a technology&apos;s value; Value Element names it as one kind</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
