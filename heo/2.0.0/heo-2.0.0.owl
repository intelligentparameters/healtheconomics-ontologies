    <!-- https://healtheconomics.wiki/concept/ratio-scaling -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/ratio-scaling">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cardinal-scaling"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
