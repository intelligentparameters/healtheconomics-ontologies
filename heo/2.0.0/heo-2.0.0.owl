        <dcterms:identifier>HEO-L-b5071f2fdf91</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic QALYs, DALYs and summary measures in subdomain Outcomes</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/health-related-quality-of-life"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/quality-of-life"/>
        <dcterms:identifier>HEO-L-1e58bfc2aa67</dcterms:identifier>
        <linkRationale xml:lang="en">The object definition states health is one part of overall quality of life</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
