    <!-- https://healtheconomics.wiki/concept/administration-cost -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/administration-cost">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/direct-cost"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/direct-cost"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/drug-cost"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/incremental-cost"/>
        <skos:notation>HS-DC-DAA-002</skos:notation>
        <dcterms:identifier>HS-DC-DAA-002</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>NICE TA1170 2026</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Treatment Administration Cost</rdfs:label>
        <owl:versionInfo>1.0.4</owl:versionInfo>
        <skos:definition xml:lang="en">Treatment administration cost is the cost of giving a medicine to a patient, such as nurse and chair time and consumables; it varies by route.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Delivery Cost</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Drug Delivery Cost</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Treatment Administration Cost</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/costs#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/administration-cost"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
