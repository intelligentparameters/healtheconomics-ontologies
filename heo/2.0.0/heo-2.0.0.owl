        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/decision-tree"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/joint-probability"/>
        <dcterms:identifier>HEO-L-f897a751ba62</dcterms:identifier>
        <linkRationale xml:lang="en">Bayes theorem is built on joint probability; decision-tree pathway probabilities are joint probabilities.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
