        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Response Option Design</rdfs:label>
        <skos:definition xml:lang="en">The methodological decisions involved in constructing the answer choices offered for each question in a health status instrument, including their number and wording.</skos:definition>
