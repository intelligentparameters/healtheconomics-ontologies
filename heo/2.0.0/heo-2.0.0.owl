    <!-- https://healtheconomics.wiki/concept/patient-satisfaction -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/patient-satisfaction">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q22907659"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <skos:notation>HE-ES-PRO-019</skos:notation>
        <dcterms:identifier>HE-ES-PRO-019</dcterms:identifier>
        <dcterms:source>U.S. Food and Drug Administration. Guidance for Industry: Patient-Reported Outcome Measures-Use in Medical Product Development to Support Labeling Claims. FDA; 2009.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Patient Satisfaction</rdfs:label>
        <skos:altLabel xml:lang="en">Satisfaction with Care</skos:altLabel>
        <skos:definition xml:lang="en">A patient&apos;s overall subjective evaluation of their care experience, covering communication, perceived competence, and overall contentment with treatment received.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Care Satisfaction</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Patient Satisfaction</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
