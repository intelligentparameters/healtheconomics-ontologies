    <!-- https://healtheconomics.wiki/concept/per-protocol-population -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/per-protocol-population">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
