    <!-- https://healtheconomics.wiki/concept/piecewise-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/piecewise-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/parametric-survival-model"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/parametric-survival-model"/>
        <skos:notation>HE-EM-SM-066</skos:notation>
        <dcterms:identifier>HE-EM-SM-066</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Collett 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Piecewise Model</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A survival model dividing follow-up into distinct segments, each modelled with a separate, often simpler function, letting the hazard shape vary in steps.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Piecewise Exponential Model</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Segmented Hazard Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Piecewise Model</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/spline-model"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/piecewise-model"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/parametric-survival-model"/>
        <dcterms:identifier>HEO-L-0b7da2857084</dcterms:identifier>
        <linkRationale xml:lang="en">A piecewise survival model specifies a distribution within each segment, so it is parametric</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/piecewise-model"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/spline-model"/>
        <dcterms:identifier>HEO-L-91ee4da4f0a0</dcterms:identifier>
        <linkRationale xml:lang="en">Piecewise and spline models are alternative flexible approaches to hazard shape</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/piggyback-evaluation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/piggyback-evaluation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/trial-based-analysis"/>
