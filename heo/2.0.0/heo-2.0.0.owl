        <dcterms:identifier>HS-HP-PP-001</dcterms:identifier>
        <dcterms:source>McClellan et al. 2010</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Accountable Care</rdfs:label>
        <skos:definition xml:lang="en">A delivery and payment model in which providers accept collective responsibility for cost and quality for a defined patient population.</skos:definition>
