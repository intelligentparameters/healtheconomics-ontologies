    <!-- https://healtheconomics.wiki/concept/alert-fatigue -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/alert-fatigue">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <riskFactorFor rdf:resource="https://healtheconomics.wiki/concept/adverse-drug-event"/>
        <riskFactorFor rdf:resource="https://healtheconomics.wiki/concept/medication-error"/>
        <skos:notation>HS-HP-DH-001</skos:notation>
        <dcterms:identifier>HS-HP-DH-001</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>van der Sijs et al. 2006</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Alert Fatigue</rdfs:label>
        <owl:versionInfo>1.0.3</owl:versionInfo>
        <skos:definition xml:lang="en">Alert fatigue is clinicians&apos; falling response when too many low-value computerised alerts consume time and attention, so important ones are overridden too.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Alert Desensitisation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Alert Fatigue</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/override-rate"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-1"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/patient-safety"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/alert-fatigue"/>
