    <!-- https://healtheconomics.wiki/concept/bioavailability -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/bioavailability">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-PE-CP-001</skos:notation>
        <dcterms:identifier>HE-PE-CP-001</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>FDA 2022</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Bioavailability</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Systemic Availability</skos:altLabel>
        <skos:definition xml:lang="en">Bioavailability is the rate and extent to which an active drug reaches the systemic circulation, which sets the dose and drug cost of a target exposure.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Bioavailable Fraction</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Bioavailability</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/drug-cost"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/drug-approval"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/bioequivalence"/>
