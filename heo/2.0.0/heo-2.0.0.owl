    <!-- https://healtheconomics.wiki/concept/choice-based-method -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/choice-based-method">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/direct-elicitation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/direct-elicitation"/>
        <skos:notation>HE-EE-HU-009</skos:notation>
        <dcterms:identifier>HE-EE-HU-009</dcterms:identifier>
        <dcterms:source>Torrance GW. Measurement of health state utilities for economic appraisal. Journal of Health Economics. 1986;5(1):1-30. doi:10.1016/0167-6296(86)90020-2.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Choice-Based Method</rdfs:label>
        <skos:definition xml:lang="en">A health state valuation technique in which respondents choose between alternative states or gambles, such as the standard gamble or time trade-off.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Choice-Based Valuation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Preference Elicitation Choice</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Choice-Based Method</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/choice-based-method"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/direct-elicitation"/>
        <dcterms:identifier>HEO-L-1183f5c14b69</dcterms:identifier>
        <linkRationale xml:lang="en">Choosing between states or gambles is direct elicitation (both definitions)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


