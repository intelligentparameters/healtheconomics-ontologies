        <dcterms:source>Wright et al. 1998</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Health Needs Assessment</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">Health needs assessment is a systematic method for finding unmet capacity to benefit from care in a population, to set priorities and allocate resources.</skos:definition>
        <skos:prefLabel xml:lang="en">Health Needs Assessment</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/health-inequality"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/priority-setting"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/resource-allocation"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/descriptive-epidemiology"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/health-needs-assessment"/>
