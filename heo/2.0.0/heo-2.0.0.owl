    <!-- https://healtheconomics.wiki/concept/aging-driven-cost-growth -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/aging-driven-cost-growth">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/healthcare-cost-growth"/>
        <skos:notation>HE-EE-CA-002</skos:notation>
        <dcterms:identifier>HE-EE-CA-002</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>OECD 2024</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Aging-Driven Cost Growth</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Ageing-Driven Cost Growth</skos:altLabel>
        <skos:definition xml:lang="en">Aging-driven cost growth is the share of health spending growth due to an older population, usually smaller than growth from rising incomes and technology.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Demographic Cost Pressure</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Aging-Driven Cost Growth</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/technology-driven-cost-growth"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/health-spending-as-gdp-share"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/aging-driven-cost-growth"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
