        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/grey-box-model"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-economic-model"/>
        <dcterms:identifier>HEO-L-c0578cbf8946</dcterms:identifier>
        <linkRationale xml:lang="en">Grey box is a transparency category of model, not a model structure</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
