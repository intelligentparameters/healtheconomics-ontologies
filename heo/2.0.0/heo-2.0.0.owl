    <!-- https://healtheconomics.wiki/concept/coverage-gap -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/coverage-gap">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/benefit-design"/>
        <skos:notation>HS-HP-HI-056</skos:notation>
        <dcterms:identifier>HS-HP-HI-056</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</dcterms:modified>
        <dcterms:source>US Congress 2022 (42 USC 1395w-102)</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Coverage Gap</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:altLabel xml:lang="en">Benefit Gap</skos:altLabel>
        <skos:definition xml:lang="en">A coverage gap is a band of drug spending that a plan covers little or not at all, best known as the Medicare Part D doughnut hole, which ended in 2025.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Coverage Shortfall</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Doughnut Hole</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Medicare Part D Doughnut Hole</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Prescription Coverage Band</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Coverage Gap</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/non-adherence"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/out-of-pocket-cost"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/coverage-gap"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-b2279bf3c128</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health Insurance: wiki topic Health financing and insurance sits in Health Systems; placed under Health Insurance, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/coverage-gap"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
