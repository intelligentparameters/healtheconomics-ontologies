    <!-- https://healtheconomics.wiki/concept/discount-rate -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/discount-rate">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/discounting"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/discounting"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/future-value"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/net-present-value"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/present-value"/>
        <skos:notation>HE-EE-DC-003</skos:notation>
        <dcterms:identifier>HE-EE-DC-003</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015. | NICE. Health Technology Evaluations: The Manual (PMG36), Economic evaluation. | CADTH. Guidelines for the Economic Evaluation of Health Technologies: Canada. 4th ed.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Discount Rate</rdfs:label>
        <owl:versionInfo>1.5.24</owl:versionInfo>
        <skos:definition xml:lang="en">The discount rate is the annual rate, such as NICE&apos;s 3.5%, used in economic evaluation to convert future costs and health outcomes into present values.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Annual Discount Percentage</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Discounting Rate</skos:hiddenLabel>
