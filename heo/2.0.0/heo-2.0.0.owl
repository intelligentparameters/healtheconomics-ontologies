    <!-- https://healtheconomics.wiki/concept/best-price -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/best-price">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/price"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/price"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/rebate"/>
        <skos:notation>HS-DC-DP-006</skos:notation>
        <dcterms:identifier>HS-DC-DP-006</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>US, Social Security Act § 1927 (42 U.S.C. § 1396r-8)</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Best Price</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Best price is the lowest US price a manufacturer offers almost any buyer for a brand-name drug in a quarter, used to set its Medicaid rebate.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Lowest Acquisition Price</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Manufacturer Lowest Price</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Best Price</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/average-manufacturer-price"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/best-price"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/price"/>
        <dcterms:identifier>HEO-L-227301512674</dcterms:identifier>
        <linkRationale xml:lang="en">Best price is a price measure, a kind of price; Drug Pricing is the process of setting prices</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/best-price"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/rebate"/>
        <dcterms:identifier>HEO-L-58cfeeb71ab4</dcterms:identifier>
        <linkRationale xml:lang="en">The Medicaid basic rebate uses AMP minus best price, per the subject definition</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
