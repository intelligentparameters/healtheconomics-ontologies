    <!-- https://healtheconomics.wiki/concept/accessibility -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/accessibility">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/access-to-care"/>
        <skos:notation>HS-HP-HE-005</skos:notation>
        <dcterms:identifier>HS-HP-HE-005</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-03</dcterms:modified>
        <dcterms:source>Hirner et al. 2023</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Geographic Accessibility of Healthcare</rdfs:label>
        <owl:versionInfo>1.0.4</owl:versionInfo>
        <skos:definition xml:lang="en">Accessibility is the dimension of health care access concerned with how easily people can reach services, given location, travel time, distance and cost.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Physical Reachability</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Reaching Services</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Geographic Accessibility of Healthcare</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/service-utilisation"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-policy#step-4"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/accessibility"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-664a392519b5</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Equity and inequality in subdomain Health Policy</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/accessibility"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/access-to-care"/>
        <dcterms:identifier>HEO-L-6efccf39a3ad</dcterms:identifier>
