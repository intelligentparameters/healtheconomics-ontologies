    <!-- https://healtheconomics.wiki/concept/disclosure -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/disclosure">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/compliance-programme"/>
        <skos:notation>HS-HP-HSR-026</skos:notation>
        <dcterms:identifier>HS-HP-HSR-026</dcterms:identifier>
        <dcterms:source>OIG, Compliance Program Guidance</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Disclosure</rdfs:label>
        <skos:definition xml:lang="en">The formal reporting of information, such as a potential compliance violation or financial conflict of interest, to an appropriate authority.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Formal Reporting</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Interest Declaration</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Disclosure</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/conflict-of-interest"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/transparency"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/disclosure"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-22699428d609</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health System Regulation: compliance, audit and accreditation govern how providers work (Organisation and governance)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/disclosure"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
