    <!-- https://healtheconomics.wiki/concept/marginal-cost-of-healthcare -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/marginal-cost-of-healthcare">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
