        <dcterms:identifier>HS-HP-DH-022</dcterms:identifier>
        <dcterms:source>Office of the National Coordinator for Health IT</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
