        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <dcterms:identifier>HEO-L-dcfd974be400</dcterms:identifier>
        <linkRationale xml:lang="en">A sunk cost is a cost already incurred.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
