        <dcterms:identifier>HE-EE-HU-072</dcterms:identifier>
        <dcterms:source>Torrance GW. Measurement of health state utilities for economic appraisal. Journal of Health Economics. 1986;5(1):1-30. doi:10.1016/0167-6296(86)90020-2.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Single Attribute Utility</rdfs:label>
        <skos:definition xml:lang="en">A utility value derived from a single dimension of health or outcome, unlike multi-attribute utility, which integrates several dimensions.</skos:definition>
