        <dcterms:source>Carlson JJ, Sullivan SD, Garrison LP, Neumann PJ, Veenstra DL. Linking payment to health outcomes: a taxonomy and examination of performance-based reimbursement schemes. Health Policy. 2010;96(3):179-190.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Quality Incentive Design</rdfs:label>
        <skos:definition xml:lang="en">The specific structure of a payment arrangement tying financial incentives to a provider&apos;s performance on defined quality measures.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Incentive-Scheme Design</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">P4P Scheme Design</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Quality Incentive Design</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/quality-based-incentive"/>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/quality-bonus"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/quality-incentive-design"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
