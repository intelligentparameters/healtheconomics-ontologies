    <!-- https://healtheconomics.wiki/concept/total-cost -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/total-cost">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1289588"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/average-cost"/>
        <skos:notation>HE-EE-CA-083</skos:notation>
        <dcterms:identifier>HE-EE-CA-083</dcterms:identifier>
        <dcterms:source>Varian 2014</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Total Cost</rdfs:label>
        <skos:definition xml:lang="en">The sum of all costs, fixed and variable, incurred in producing a given level of output.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Aggregate Cost</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Total Expenditure</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Total Cost</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/total-cost"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <dcterms:identifier>HEO-L-cd5cd6f54535</dcterms:identifier>
        <linkRationale xml:lang="en">Total cost is a cost.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
