    <!-- https://healtheconomics.wiki/concept/symptomatic-outcome -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/symptomatic-outcome">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/symptom-frequency"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/symptom-severity"/>
        <skos:notation>HE-ES-CO-085</skos:notation>
        <dcterms:identifier>HE-ES-CO-085</dcterms:identifier>
        <dcterms:source>U.S. Food and Drug Administration. Guidance for Industry: Patient-Reported Outcome Measures-Use in Medical Product Development to Support Labeling Claims. FDA; 2009.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Symptomatic Outcome</rdfs:label>
        <skos:definition xml:lang="en">Any clinical outcome measure focused on the presence, frequency, or severity of disease-related symptoms, unlike survival, biomarker, or functional outcomes.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Symptom Endpoint</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Symptom-Based Outcome</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Symptomatic Outcome</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/symptomatic-outcome"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome"/>
        <dcterms:identifier>HEO-L-e1533eab2866</dcterms:identifier>
        <linkRationale xml:lang="en">Symptomatic outcomes reflect how a patient feels, a clinical outcome.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/symptomatic-outcome"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
