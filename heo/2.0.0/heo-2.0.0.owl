        <dcterms:identifier>HE-EE-EP-027</dcterms:identifier>
        <dcterms:source>Musgrave &amp; Musgrave 1989</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Progressive Taxation</rdfs:label>
        <skos:altLabel xml:lang="en">Graduated Taxation</skos:altLabel>
        <skos:altLabel xml:lang="en">Progressive Tax</skos:altLabel>
        <skos:definition xml:lang="en">A tax structure in which the rate rises as the taxable amount, such as income, rises, so higher earners pay a larger share.</skos:definition>
        <skos:prefLabel xml:lang="en">Progressive Taxation</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/redistribution"/>
