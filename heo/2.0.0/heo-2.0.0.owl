        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-HP-HD-125</skos:notation>
        <dcterms:identifier>HS-HP-HD-125</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Waiting List Management</rdfs:label>
        <skos:altLabel xml:lang="en">Wait List Management</skos:altLabel>
        <skos:definition xml:lang="en">The strategies used to organise, prioritise, and monitor patients awaiting access to a limited healthcare resource, such as elective surgery.</skos:definition>
        <skos:hiddenLabel xml:lang="en">List Prioritisation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Waiting List Management</skos:prefLabel>
        <manages rdf:resource="https://healtheconomics.wiki/concept/waiting-list"/>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/timely-access"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/waiting-time"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/waiting-list-management"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
