    <!-- https://healtheconomics.wiki/concept/high-deductible-health-plan -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/high-deductible-health-plan">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
