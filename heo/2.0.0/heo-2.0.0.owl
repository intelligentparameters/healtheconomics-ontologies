        <dcterms:source>Edwards &amp; Aronson 2000</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Safety Signal</rdfs:label>
        <skos:definition xml:lang="en">Information from post-marketing surveillance suggesting a possible new or worsened adverse effect, warranting investigation into whether a genuine causal link exists.</skos:definition>
