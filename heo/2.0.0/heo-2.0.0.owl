    <!-- https://healtheconomics.wiki/concept/health-related-quality-of-life -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/health-related-quality-of-life">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/quality-of-life"/>
        <skos:notation>HE-EE_HRQL-005</skos:notation>
        <dcterms:identifier>HE-EE_HRQL-005</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-23</dcterms:modified>
        <dcterms:source>Patrick &amp; Deyo 1989</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Health-Related Quality of Life</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">HRQL</skos:altLabel>
        <skos:altLabel xml:lang="en">HRQoL</skos:altLabel>
        <skos:definition xml:lang="en">A multidimensional concept covering the physical, psychological, and social aspects of wellbeing affected by a person&apos;s health status or its treatment.</skos:definition>
        <skos:prefLabel xml:lang="en">Health-Related Quality of Life</skos:prefLabel>
        <abbreviation xml:lang="en">HRQL</abbreviation>
        <abbreviation xml:lang="en">HRQoL</abbreviation>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/qaly"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/outcomes#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/health-related-quality-of-life"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
