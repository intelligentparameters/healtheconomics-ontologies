        <produces rdf:resource="https://healtheconomics.wiki/concept/cohort-trace"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/half-cycle-correction"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/markov-cohort-model"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/transition-matrix"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
