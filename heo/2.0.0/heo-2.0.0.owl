        <dcterms:identifier>HEO-L-c528f590c864</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Trial and study design in subdomain Evidence Synthesis</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/allocation-concealment"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
