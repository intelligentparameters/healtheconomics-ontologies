    <!-- https://healtheconomics.wiki/concept/number-needed-to-screen -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/number-needed-to-screen">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/absolute-measure"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/absolute-measure"/>
        <skos:notation>HE-ES-RM-017</skos:notation>
        <dcterms:identifier>HE-ES-RM-017</dcterms:identifier>
        <dcterms:source>Rembold 1998</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Number Needed to Screen</rdfs:label>
        <skos:altLabel xml:lang="en">NNS</skos:altLabel>
        <skos:definition xml:lang="en">The number of individuals who would need screening for a condition to prevent one adverse outcome, based on prevalence and programme effectiveness.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Screening Number Needed</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Number Needed to Screen</skos:prefLabel>
        <abbreviation xml:lang="en">NNS</abbreviation>
        <counterpartOf rdf:resource="https://healtheconomics.wiki/concept/number-needed-to-treat"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/screening-programme"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-2"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/number-needed-to-screen"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/absolute-measure"/>
        <dcterms:identifier>HEO-L-5119a98fb7a6</dcterms:identifier>
        <linkRationale xml:lang="en">NNS is the reciprocal of an absolute risk difference from screening, an effect measure</linkRationale>
