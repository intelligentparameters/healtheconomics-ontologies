    <!-- https://healtheconomics.wiki/concept/psychotherapy-cost -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/psychotherapy-cost">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
