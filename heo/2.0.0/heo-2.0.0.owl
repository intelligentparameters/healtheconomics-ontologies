        <skos:notation>HS-HP-PP-002</skos:notation>
        <dcterms:identifier>HS-HP-PP-002</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-03</dcterms:modified>
        <dcterms:source>Palmer et al. 2014</dcterms:source>
