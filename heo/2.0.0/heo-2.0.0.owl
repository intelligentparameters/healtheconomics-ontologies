        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/healthcare-payer"/>
        <skos:notation>HS-HP-HI-146</skos:notation>
        <dcterms:identifier>HS-HP-HI-146</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Private Payer</rdfs:label>
        <skos:altLabel xml:lang="en">Commercial Insurer</skos:altLabel>
        <skos:altLabel xml:lang="en">Commercial Payer</skos:altLabel>
        <skos:altLabel xml:lang="en">Private Health Insurer</skos:altLabel>
        <skos:definition xml:lang="en">A non-governmental entity, such as a commercial insurer or self-insured employer, responsible for financing healthcare for a covered population.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Non-Government Payer</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Private Insurer</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Private Payer</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/public-payer"/>
        <performs rdf:resource="https://healtheconomics.wiki/concept/private-health-insurance"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/private-payer"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/healthcare-payer"/>
        <dcterms:identifier>HEO-L-e78f17f30e26</dcterms:identifier>
        <linkRationale xml:lang="en">A private payer is a non-governmental healthcare payer per both definitions.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/private-payer"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/public-payer"/>
        <dcterms:identifier>HEO-L-2fa6caa5f6df</dcterms:identifier>
