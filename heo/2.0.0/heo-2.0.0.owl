    <!-- https://healtheconomics.wiki/concept/price-erosion -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/price-erosion">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q161081"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:notation>HS-DC-DP-065</skos:notation>
        <dcterms:identifier>HS-DC-DP-065</dcterms:identifier>
        <dcterms:source>Danzon 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Price Erosion</rdfs:label>
        <skos:definition xml:lang="en">The gradual decline in a drug&apos;s price over time, most commonly following generic or biosimilar competition after patent exclusivity is lost.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Post-Patent Erosion</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Price Decline</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Price Erosion</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/drug-cost"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/price-erosion"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-c52a93522ef1</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Drug Costs &gt; Drug Pricing: wiki topic Pricing and market access sits in Health Policy; placed under Drug Pricing, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/price-erosion"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-cost"/>
        <dcterms:identifier>HEO-L-a6de54999c0a</dcterms:identifier>
        <linkRationale xml:lang="en">Price erosion is a decline in a drug&apos;s price (subject definition); acquisition price is part of drug cost</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/price-freeze -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/price-freeze">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/price-control"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/price-control"/>
        <skos:notation>HS-DC-DP-066</skos:notation>
        <dcterms:identifier>HS-DC-DP-066</dcterms:identifier>
        <dcterms:source>Musgrave &amp; Musgrave 1989</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Price Freeze</rdfs:label>
        <skos:altLabel xml:lang="en">Price Standstill</skos:altLabel>
        <skos:definition xml:lang="en">A government or payer policy temporarily preventing a manufacturer from increasing a drug&apos;s price for a specified period.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Frozen Pricing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Price Freeze</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/price-growth"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/price-freeze"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/price-control"/>
        <dcterms:identifier>HEO-L-891af88356b7</dcterms:identifier>
        <linkRationale xml:lang="en">A price freeze is a price control</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/price-freeze"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/price-growth"/>
        <dcterms:identifier>HEO-L-dc882e7a1c97</dcterms:identifier>
        <linkRationale xml:lang="en">Blocking increases removes the price component of spending growth.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/price-growth -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/price-growth">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/healthcare-cost-growth"/>
        <skos:notation>HE-EE-CA-067</skos:notation>
        <dcterms:identifier>HE-EE-CA-067</dcterms:identifier>
        <dcterms:source>Newhouse 1992</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Price Growth</rdfs:label>
        <skos:definition xml:lang="en">The component of rising healthcare expenditure attributable to increases in input prices, such as wages or drug costs, rather than volume or intensity.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Price Increase</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Price Rise</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Price Growth</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/volume-growth"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/price-growth"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-6ce9d7225c03</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Cost Analysis: cost analysis is costing; most concepts with this Level 3 that the wiki places in a topic sit in Costs</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/price-growth"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/healthcare-cost-growth"/>
        <dcterms:identifier>HEO-L-a4e287af8b30</dcterms:identifier>
        <linkRationale xml:lang="en">The subject definition calls price growth the component of spending growth due to input prices</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/price-growth"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/volume-growth"/>
        <dcterms:identifier>HEO-L-af609551b4e7</dcterms:identifier>
