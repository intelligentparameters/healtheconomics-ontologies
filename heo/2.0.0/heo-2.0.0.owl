    <!-- https://healtheconomics.wiki/concept/high-quality-evidence -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/high-quality-evidence">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/quality-of-evidence"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/quality-of-evidence"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/grade"/>
        <skos:notation>HE-ES-EA-022</skos:notation>
        <dcterms:identifier>HE-ES-EA-022</dcterms:identifier>
        <dcterms:source>Guyatt GH, Oxman AD, Vist GE, et al. GRADE: an emerging consensus on rating quality of evidence and strength of recommendations. BMJ. 2008;336:924-926. doi:10.1136/bmj.39489.470347.AD.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">High-Quality Evidence</rdfs:label>
        <skos:altLabel xml:lang="en">High Certainty Evidence</skos:altLabel>
        <skos:definition xml:lang="en">Within GRADE, a rating indicating strong confidence that the true effect lies close to the reported estimate, typically from well-conducted trials.</skos:definition>
        <skos:hiddenLabel xml:lang="en">GRADE High</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">High-Quality Evidence</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/low-quality-evidence"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/high-quality-evidence"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/quality-of-evidence"/>
        <dcterms:identifier>HEO-L-4313ce56b972</dcterms:identifier>
        <linkRationale xml:lang="en">A GRADE rating.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
