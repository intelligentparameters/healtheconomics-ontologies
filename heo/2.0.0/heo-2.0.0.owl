        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/express-consent -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/express-consent">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/consent-for-treatment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/consent-for-treatment"/>
        <skos:notation>HS-HP-HD-044</skos:notation>
        <dcterms:identifier>HS-HP-HD-044</dcterms:identifier>
        <dcterms:source>Faden &amp; Beauchamp 1986</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Express Consent</rdfs:label>
        <skos:altLabel xml:lang="en">Explicit Consent</skos:altLabel>
        <skos:definition xml:lang="en">A form of consent in which a patient explicitly and directly agrees to treatment, verbally or in writing, unlike implied consent.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Direct Consent</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Express Consent</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/implied-consent"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/express-consent"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/consent-for-treatment"/>
        <dcterms:identifier>HEO-L-46dac5685991</dcterms:identifier>
        <linkRationale xml:lang="en">Express consent is one form of consent to treatment</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/express-consent"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/implied-consent"/>
        <dcterms:identifier>HEO-L-7d5ce2b4a695</dcterms:identifier>
