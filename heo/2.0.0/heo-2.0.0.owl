    <!-- https://healtheconomics.wiki/concept/expansion-path -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/expansion-path">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q3478677"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/cost-function"/>
        <skos:notation>HE-EE-CEA-027</skos:notation>
        <dcterms:identifier>HE-EE-CEA-027</dcterms:identifier>
        <dcterms:source>Varian 2014</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Expansion Path</rdfs:label>
        <skos:definition xml:lang="en">The set of cost-minimising input combinations as output rises, holding relative input prices constant.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cost-Minimising Path</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Optimal Input Trajectory</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Expansion Path</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/expansion-path"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-c36796d5933a</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Cost-Effectiveness Analysis: wiki topic Cost-effectiveness analysis sits in Economic Evaluation; placed under Cost-Effectiveness Analysis, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/expansion-path"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-function"/>
        <dcterms:identifier>HEO-L-7d60d524ed0c</dcterms:identifier>
        <linkRationale xml:lang="en">The long-run cost function is derived from the cost-minimising input combinations on the expansion path</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/expected-loss -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/expected-loss">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/expected-value"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/expected-value"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/evpi"/>
        <skos:notation>HE-EE_VI-002</skos:notation>
        <dcterms:identifier>HE-EE_VI-002</dcterms:identifier>
        <dcterms:source>Raiffa &amp; Schlaifer 1961</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Expected Loss</rdfs:label>
        <skos:altLabel xml:lang="en">Expected Opportunity Loss</skos:altLabel>
        <skos:definition xml:lang="en">The probability-weighted average cost of making an incorrect decision under uncertainty, calculated across all possible states and their probabilities.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Probability-Weighted Loss</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Expected Loss</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-11"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/expected-loss"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/expected-value"/>
        <dcterms:identifier>HEO-L-7d7ab6177bd1</dcterms:identifier>
        <linkRationale xml:lang="en">Expected loss is a probability-weighted average</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/expected-loss"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evpi"/>
        <dcterms:identifier>HEO-L-9d5441d86313</dcterms:identifier>
        <linkRationale xml:lang="en">EVPI is computed as the expected opportunity loss of the decision made under current information</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/expected-net-benefit -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/expected-net-benefit">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/expected-value"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/expected-value"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/ceaf"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/evpi"/>
        <skos:notation>HE-EE-CBA-019</skos:notation>
        <dcterms:identifier>HE-EE-CBA-019</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Drummond et al. 2015 | Stinnett and Mullahy 1998 | Fenwick et al. 2001 | NICE PMG36</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Expected Net Benefit</rdfs:label>
        <owl:versionInfo>1.2.3</owl:versionInfo>
        <skos:altLabel xml:lang="en">ENB</skos:altLabel>
        <skos:definition xml:lang="en">Expected net benefit is the mean net benefit of a healthcare option across parameter uncertainty at a set threshold; the option with the highest is chosen.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Average Net Benefit</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Expected Net Benefit</skos:prefLabel>
        <abbreviation xml:lang="en">ENB</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/probability-of-cost-effectiveness"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/expected-net-benefit"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/expected-value"/>
        <dcterms:identifier>HEO-L-9ca839b9f544</dcterms:identifier>
        <linkRationale xml:lang="en">Expected net benefit is an expected value</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/expected-net-benefit"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/ceaf"/>
        <dcterms:identifier>HEO-L-af7db5c5bb00</dcterms:identifier>
        <linkRationale xml:lang="en">The CEAF tracks the option with highest expected net benefit at each threshold</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
