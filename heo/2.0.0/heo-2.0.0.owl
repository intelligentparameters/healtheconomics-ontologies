        <dcterms:identifier>HS-DC-DP-021</dcterms:identifier>
        <dcterms:source>Varian 2014</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Demand Price</rdfs:label>
        <skos:definition xml:lang="en">The maximum price consumers are willing to pay for a given quantity of a good, represented along a standard demand curve.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Marginal Willingness to Pay</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Maximum Buyer Price</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Demand Price</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
