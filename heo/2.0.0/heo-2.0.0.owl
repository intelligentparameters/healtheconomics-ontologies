    <!-- https://healtheconomics.wiki/concept/cost-avoidance -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cost-avoidance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-system-performance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-system-performance"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/budget-impact"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/return-on-investment"/>
        <skos:notation>HS-SS_HSP-017</skos:notation>
        <dcterms:identifier>HS-SS_HSP-017</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cost Avoidance</rdfs:label>
        <skos:altLabel xml:lang="en">Avoided Cost</skos:altLabel>
        <skos:definition xml:lang="en">A reduction in future spending achieved by preventing a costly event, such as hospitalisation, unlike a direct reduction of current spending.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Averted Expenditure</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cost Avoidance</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
