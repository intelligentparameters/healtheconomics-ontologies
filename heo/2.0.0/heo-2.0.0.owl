    <!-- https://healtheconomics.wiki/concept/spin -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/spin">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-DS-BV-036</skos:notation>
        <dcterms:identifier>HE-DS-BV-036</dcterms:identifier>
        <dcterms:source>Boutron et al. 2010</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Spin</rdfs:label>
        <skos:definition xml:lang="en">The practice of presenting research results, especially non-significant primary outcomes, in a way that emphasises secondary findings to convey false favourability.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Interpretation Bias</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Result Overstatement</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Spin</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/interpretation-error"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/reporting-bias"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/spin"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-e320ee478e70</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Bias &amp; Validity: catalogue subdomain Evidence Synthesis is one of the subdomains</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/spin"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/interpretation-error"/>
        <dcterms:identifier>HEO-L-fb655d983014</dcterms:identifier>
        <linkRationale xml:lang="en">Spin leads readers to misinterpret results; critical appraisal is the check against it.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/spin"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/reporting-bias"/>
        <dcterms:identifier>HEO-L-ccd2d62543d1</dcterms:identifier>
        <linkRationale xml:lang="en">Spin is a reporting practice, not a bias itself; its selective emphasis drives reporting bias.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/spinal-cord-injury -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/spinal-cord-injury">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/neurological-disease-economics"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/neurological-disease-economics"/>
        <skos:notation>HE-PE-NR-017</skos:notation>
        <dcterms:identifier>HE-PE-NR-017</dcterms:identifier>
        <dcterms:source>Ahuja et al. 2017</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Spinal Cord Injury</rdfs:label>
        <skos:altLabel xml:lang="en">SCI</skos:altLabel>
        <skos:definition xml:lang="en">Damage to the spinal cord that can cause permanent loss of movement and sensation below the injury level, typically from trauma.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Spinal Injury</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Spinal Cord Injury</skos:prefLabel>
        <abbreviation xml:lang="en">SCI</abbreviation>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/dependency"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/disability"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/spinal-cord-injury"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/neurological-disease-economics"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-dbb508b8f61a</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: curated: review B: disease or clinical specialty term; a disease is not an evidence synthesis method; classify under its disease-area economics concept</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/spinal-cord-injury"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/dependency"/>
        <dcterms:identifier>HEO-L-28087cd1f3b9</dcterms:identifier>
        <linkRationale xml:lang="en">Permanent loss of movement leads to needing assistance with daily activities.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/spinal-cord-injury"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
