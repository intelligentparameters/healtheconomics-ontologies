        <dcterms:identifier>HE-PE-DD-019</dcterms:identifier>
        <dcterms:source>FDA, Accelerated Approval Program</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Full Approval</rdfs:label>
        <skos:altLabel xml:lang="en">Traditional Approval</skos:altLabel>
        <skos:definition xml:lang="en">Standard market authorisation granted based on a well-established, definitive clinical benefit endpoint, unlike accelerated approval, which relies on a surrogate.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Standard Approval</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Full Approval</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
