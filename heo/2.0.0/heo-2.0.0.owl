        <uses rdf:resource="https://healtheconomics.wiki/concept/attributable-fraction"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/cost-of-illness-study"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
