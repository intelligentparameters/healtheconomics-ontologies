        <dcterms:identifier>HEO-L-dcdaa03a924b</dcterms:identifier>
        <linkRationale xml:lang="en">Definition: research without prospective consent in emergencies, a kind of consent waiver.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
