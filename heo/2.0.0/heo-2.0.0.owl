    <!-- https://healtheconomics.wiki/concept/emulator -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/emulator">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/metamodel"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/metamodel"/>
        <skos:notation>HE-EM-DM-029</skos:notation>
        <dcterms:identifier>HE-EM-DM-029</dcterms:identifier>
        <dcterms:source>O&apos;Hagan 2006</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Emulator</rdfs:label>
        <skos:altLabel xml:lang="en">Surrogate Model</skos:altLabel>
        <skos:definition xml:lang="en">A statistical model trained to approximate a more computationally expensive simulation model&apos;s input-output relationship, running much faster than the original.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Fast Surrogate</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Reduced-Order Model</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Surrogate-Based Model</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Trained Approximation Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Emulator</skos:prefLabel>
        <represents rdf:resource="https://healtheconomics.wiki/concept/simulation-model"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/gaussian-process"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/emulator"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/metamodel"/>
        <dcterms:identifier>HEO-L-60b49a3c6d56</dcterms:identifier>
        <linkRationale xml:lang="en">An emulator is a fast statistical approximation of a complex model, i.e. a metamodel</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/emulator"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#represents"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/simulation-model"/>
        <dcterms:identifier>HEO-L-d8e83c70bd85</dcterms:identifier>
        <linkRationale xml:lang="en">The emulator reproduces the simulation model&apos;s input-output relationship (subject definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
