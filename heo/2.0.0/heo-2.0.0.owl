    <!-- https://healtheconomics.wiki/concept/public-system -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/public-system">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-system"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-system"/>
