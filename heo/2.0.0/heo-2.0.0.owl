    <!-- https://healtheconomics.wiki/concept/expected-utility -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/expected-utility">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
