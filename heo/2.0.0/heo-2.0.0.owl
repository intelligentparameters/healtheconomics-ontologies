        <dcterms:identifier>HE-ES-EA-048</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</dcterms:modified>
        <dcterms:source>Fryback &amp; Thornbury 1991</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Hierarchy of Diagnostic Efficacy</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:altLabel xml:lang="en">Fryback and Thornbury Model</skos:altLabel>
        <skos:altLabel xml:lang="en">Fryback-Thornbury Hierarchy</skos:altLabel>
        <skos:definition xml:lang="en">The hierarchy of diagnostic efficacy is Fryback and Thornbury&apos;s six-level model for judging a test, from image quality and accuracy to societal value.</skos:definition>
        <skos:prefLabel xml:lang="en">Hierarchy of Diagnostic Efficacy</skos:prefLabel>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/medical-imaging"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/diagnostic-efficacy-hierarchy"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-assessment"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-46940723d37c</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Evidence Appraisal: catalogue subdomain Evidence Synthesis is one of the subdomains; placed under Evidence Assessment, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/diagnostic-efficacy-hierarchy"/>
