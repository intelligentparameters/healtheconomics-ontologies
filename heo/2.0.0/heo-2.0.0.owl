        <skos:altLabel xml:lang="en">Diagnosis Rate</skos:altLabel>
        <skos:definition xml:lang="en">A measure of the proportion of people with a specific condition who have actually been diagnosed, capturing the gap between prevalence and recognition.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Detection Coverage</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Diagnosis Coverage</skos:prefLabel>
