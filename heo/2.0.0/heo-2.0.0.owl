        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/quality-based-incentive"/>
        <dcterms:identifier>HEO-L-fde5aa18a1ab</dcterms:identifier>
        <linkRationale xml:lang="en">A payment penalty and a quality reward are opposing incentive designs</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
