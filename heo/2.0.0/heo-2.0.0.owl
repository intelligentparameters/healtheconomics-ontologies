        <dcterms:source>Drummond et al. 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Resource</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:definition xml:lang="en">Resource, in health economics, means any scarce input such as staff time, medicines, beds or equipment, whose use in one place denies it to other uses.</skos:definition>
        <skos:prefLabel xml:lang="en">Resource</skos:prefLabel>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/resource-allocation"/>
