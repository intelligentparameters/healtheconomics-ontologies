    <!-- https://healtheconomics.wiki/concept/population-evpi -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/population-evpi">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evpi"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/evpi"/>
        <skos:notation>HE-EM-VI-038</skos:notation>
        <dcterms:identifier>HE-EM-VI-038</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Claxton &amp; Posnett 1996</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Population EVPI</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">The expected value of perfect information calculated for an entire affected patient population over time, rather than for a single patient.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Aggregate EVPI</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Whole-Jurisdiction EVPI</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Population EVPI</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-11"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/research-prioritisation"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/population-evpi"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evpi"/>
        <dcterms:identifier>HEO-L-46a6f6faa89c</dcterms:identifier>
        <linkRationale xml:lang="en">Population EVPI is EVPI scaled to the affected population</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
