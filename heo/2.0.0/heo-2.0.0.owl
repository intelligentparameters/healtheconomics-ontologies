    <!-- https://healtheconomics.wiki/concept/fully-insured-plan -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/fully-insured-plan">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:notation>HS-HP-HI-083</skos:notation>
        <dcterms:identifier>HS-HP-HI-083</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Fully Insured Plan</rdfs:label>
        <skos:definition xml:lang="en">An arrangement where an employer purchases coverage from an insurer that assumes the financial risk for claims, unlike a self-insured plan.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Fully-Insured Arrangement</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Insured Plan</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Fully Insured Plan</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/self-funded-plan"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/fully-insured-plan"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <dcterms:identifier>HEO-L-1570be3ae53f</dcterms:identifier>
        <linkRationale xml:lang="en">A fully insured plan is health insurance</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
