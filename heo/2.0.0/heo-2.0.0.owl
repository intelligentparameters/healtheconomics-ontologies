    <!-- https://healtheconomics.wiki/concept/step-down-allocation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/step-down-allocation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-allocation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cost-allocation"/>
        <skos:notation>HE-EE-CM-016</skos:notation>
        <dcterms:identifier>HE-EE-CM-016</dcterms:identifier>
        <dcterms:source>Horngren, Datar &amp; Rajan 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Step-Down Allocation</rdfs:label>
        <skos:altLabel xml:lang="en">Step-Down Method</skos:altLabel>
        <skos:definition xml:lang="en">A method of allocating support department costs to operating departments in sequence, so that once allocated, no further costs return to that department.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Sequential Cost Allocation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Step-Down Allocation</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/costs#step-1"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/cost-centre"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/overhead-cost"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/step-down-allocation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-allocation"/>
        <dcterms:identifier>HEO-L-1bfdc44626f3</dcterms:identifier>
        <linkRationale xml:lang="en">Step-down allocation is a cost allocation method.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
