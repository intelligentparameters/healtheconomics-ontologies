        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:notation>HS-HP-HTA-278</skos:notation>
        <dcterms:identifier>HS-HP-HTA-278</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</dcterms:modified>
        <dcterms:source>Thokala et al. 2023</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Living HTA</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Living Health Technology Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Living HTA is a health technology assessment planned from the start to be updated at set intervals or triggers as evidence, comparators or prices change.</skos:definition>
        <skos:prefLabel xml:lang="en">Living HTA</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/moving-target-problem"/>
        <counterpartOf rdf:resource="https://healtheconomics.wiki/concept/living-guideline"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/coverage-decision"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/disinvestment"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/living-review"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/model-update"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/living-hta"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <dcterms:identifier>HEO-L-9e5482e8799f</dcterms:identifier>
        <linkRationale xml:lang="en">Living HTA is a form of health technology assessment</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
