    <!-- https://healtheconomics.wiki/concept/continuous-quality-improvement -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/continuous-quality-improvement">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
