        <reduces rdf:resource="https://healtheconomics.wiki/concept/administrative-barrier"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/administrative-waste"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/transaction-cost"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/interoperability-standards"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
