    <!-- https://healtheconomics.wiki/concept/public-good -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/public-good">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-good"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/non-excludable-goods"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/economic-good"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/non-excludable-goods"/>
        <skos:notation>HE-EE-ME-059</skos:notation>
        <dcterms:identifier>HE-EE-ME-059</dcterms:identifier>
        <dcterms:source>Samuelson 1954</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Public Good</rdfs:label>
        <skos:definition xml:lang="en">A good characterised by non-excludability and non-rivalry, so no one can be excluded from it and one person&apos;s use does not reduce others&apos;.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Collective Good</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Non-Rival Good</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Public Good</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/free-rider-problem"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/market-failure"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/public-good"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-good"/>
        <dcterms:identifier>HEO-L-8bd0b5b11505</dcterms:identifier>
        <linkRationale xml:lang="en">A public good is an economic good classed by rivalry and excludability.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
