    <!-- https://healtheconomics.wiki/concept/interval-censoring -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/interval-censoring">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/censoring"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/censoring"/>
        <skos:notation>HE-EM-SM-035</skos:notation>
