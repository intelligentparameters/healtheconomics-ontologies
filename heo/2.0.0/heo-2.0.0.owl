    <!-- https://healtheconomics.wiki/concept/exclusion-error -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/exclusion-error">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:notation>HE-EE-HE-004</skos:notation>
        <dcterms:identifier>HE-EE-HE-004</dcterms:identifier>
        <dcterms:source>Cornia &amp; Stewart 1993</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Exclusion Error</rdfs:label>
        <skos:definition xml:lang="en">A failure of a targeted programme to reach individuals who meet its eligibility criteria and should receive its benefits.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Eligible Non-Reach</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Under-Targeting</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Exclusion Error</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/effective-coverage"/>
