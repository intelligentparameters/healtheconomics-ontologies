        <skos:altLabel xml:lang="en">Oral Route</skos:altLabel>
        <skos:altLabel xml:lang="en">Per Os Administration</skos:altLabel>
        <skos:definition xml:lang="en">A route of drug administration in which medication is taken by mouth and absorbed through the digestive system, generally the most convenient long-term route.</skos:definition>
