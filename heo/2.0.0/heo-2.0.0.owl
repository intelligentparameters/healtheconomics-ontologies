        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/poverty"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/social-determinants-of-health"/>
        <dcterms:identifier>HEO-L-f3cfb26af9ce</dcterms:identifier>
        <linkRationale xml:lang="en">Income and poverty are named social determinants of health</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
