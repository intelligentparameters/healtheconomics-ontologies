    <!-- https://healtheconomics.wiki/concept/attack-rate -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/attack-rate">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cumulative-incidence"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cumulative-incidence"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/attack-rate-ratio"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/vaccine-effectiveness"/>
        <skos:notation>HE-ES-EP-002</skos:notation>
        <dcterms:identifier>HE-ES-EP-002</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams &amp; Wilkins; 2008.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Attack Rate</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Incidence Proportion</skos:altLabel>
        <skos:definition xml:lang="en">Attack rate is the proportion of an at-risk population that develops the disease during an outbreak or other defined period: a risk, not a true rate.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Outbreak Incidence</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Attack Rate</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/incidence-rate"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/outbreak-investigation"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/attack-rate"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cumulative-incidence"/>
        <dcterms:identifier>HEO-L-8ef91b1583ef</dcterms:identifier>
        <linkRationale xml:lang="en">Attack rate is a proportion over a period, a cumulative incidence</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
