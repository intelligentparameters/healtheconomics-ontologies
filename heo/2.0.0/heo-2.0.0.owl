        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <skos:notation>HE-EE-CA-051</skos:notation>
        <dcterms:identifier>HE-EE-CA-051</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Indirect Cost</rdfs:label>
        <skos:definition xml:lang="en">A cost associated with an intervention that is not directly incurred in providing it, such as lost productivity from illness or premature death.</skos:definition>
        <skos:prefLabel xml:lang="en">Indirect Cost</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/indirect-cost"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <dcterms:identifier>HEO-L-6e0612125a36</dcterms:identifier>
        <linkRationale xml:lang="en">A cost.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


