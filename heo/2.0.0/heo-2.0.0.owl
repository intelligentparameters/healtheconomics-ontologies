    <!-- https://healtheconomics.wiki/concept/price-elasticity-of-healthcare -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/price-elasticity-of-healthcare">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/price-elasticity-of-demand"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/price-elasticity-of-demand"/>
        <skos:notation>HE-EE-ME-054</skos:notation>
        <dcterms:identifier>HE-EE-ME-054</dcterms:identifier>
        <dcterms:source>Newhouse et al. 1993</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Price Elasticity of Healthcare</rdfs:label>
        <skos:definition xml:lang="en">An empirical estimate of how sensitive healthcare use is to changes in out-of-pocket price, most famously quantified by a large randomised experiment.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Healthcare Demand Elasticity</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">RAND HIE Elasticity</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Price Elasticity of Healthcare</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/cost-sharing"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/price-elasticity-of-healthcare"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/price-elasticity-of-demand"/>
        <dcterms:identifier>HEO-L-89f248e9171f</dcterms:identifier>
        <linkRationale xml:lang="en">Healthcare price elasticity is price elasticity of demand for care</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
