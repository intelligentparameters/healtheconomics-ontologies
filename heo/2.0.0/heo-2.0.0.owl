    <!-- https://healtheconomics.wiki/concept/emancipated-minor -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/emancipated-minor">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-HP-HD-040</skos:notation>
        <dcterms:identifier>HS-HP-HD-040</dcterms:identifier>
        <dcterms:source>Uniform Law Commission, Uniform Emancipation of Minors Act</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Emancipated Minor</rdfs:label>
        <skos:definition xml:lang="en">A legal status granting an individual below the age of majority the authority to make their own decisions, including healthcare, independent of parental consent.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Legally Independent Minor</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Self-Consenting Minor</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Emancipated Minor</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/informed-consent"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/emancipated-minor"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-0cf27ef68371</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Healthcare Delivery: organisation and delivery of care is the Health Systems subdomain (Organisation and governance)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/emancipated-minor"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#setsScopeOf"/>
