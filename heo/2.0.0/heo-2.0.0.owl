    <!-- https://healtheconomics.wiki/concept/cohort-trace -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cohort-trace">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/model-output"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/model-output"/>
        <skos:notation>HE-EM-MM-003</skos:notation>
        <dcterms:identifier>HE-EM-MM-003</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Sonnenberg FA, Beck JR. Markov models in medical decision making: a practical guide. Medical Decision Making. 1993;13(4):322?338. doi:10.1177/0272989X9301300409.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cohort Trace</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Markov Trace</skos:altLabel>
        <skos:definition xml:lang="en">A cohort trace is the cycle-by-cycle record of a state-transition model’s expected cohort distribution across its health states under a specified strategy.</skos:definition>
        <skos:hiddenLabel xml:lang="en">State-Occupancy Trace</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cohort Trace</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-3"/>
        <represents rdf:resource="https://healtheconomics.wiki/concept/state-membership"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cohort-trace"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/model-output"/>
        <dcterms:identifier>HEO-L-094aa2be7152</dcterms:identifier>
        <linkRationale xml:lang="en">A cohort trace is a cycle-by-cycle result a state-transition model produces; Model Output is the results a model produces</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
