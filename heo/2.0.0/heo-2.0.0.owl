    <!-- https://healtheconomics.wiki/concept/structure-quality-indicator -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/structure-quality-indicator">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/quality-indicator"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
