    <!-- https://healtheconomics.wiki/concept/diffusion-of-innovation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/diffusion-of-innovation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-HP-SS-010</skos:notation>
        <dcterms:identifier>HS-HP-SS-010</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</dcterms:modified>
        <dcterms:source>Dearing 2009</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Diffusion of Innovation</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:definition xml:lang="en">Diffusion of innovation is Rogers&apos; theory of how new treatments and practices spread through a health system over time, via communication and imitation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Innovation Adoption Theory</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Rogers Diffusion Theory</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Diffusion of Innovation</skos:prefLabel>
        <explains rdf:resource="https://healtheconomics.wiki/concept/diffusion"/>
        <explains rdf:resource="https://healtheconomics.wiki/concept/innovation-adoption"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/implementation-strategy"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/adoption-curve"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/dissemination-research"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/diffusion-of-innovation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
