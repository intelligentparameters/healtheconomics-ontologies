        <dcterms:source>Bates et al. 1995</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Medication Error</rdfs:label>
        <skos:definition xml:lang="en">A preventable mistake occurring anywhere in the medication use process, from prescribing through dispensing to administration, whether or not harm results.</skos:definition>
