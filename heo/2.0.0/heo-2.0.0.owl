    <!-- https://healtheconomics.wiki/concept/robust-standard-error -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/robust-standard-error">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/standard-error"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/standard-error"/>
        <skos:notation>HE-ES-SA-185</skos:notation>
        <dcterms:identifier>HE-ES-SA-185</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>White 1980</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Robust Standard Error</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Heteroskedasticity-Consistent Standard Error</skos:altLabel>
        <skos:altLabel xml:lang="en">Robust SE</skos:altLabel>
        <skos:definition xml:lang="en">An estimate of a regression coefficient&apos;s statistical uncertainty that remains valid even when standard modelling assumptions, such as constant error variance, are violated.</skos:definition>
        <skos:prefLabel xml:lang="en">Robust Standard Error</skos:prefLabel>
        <abbreviation xml:lang="en">Robust SE</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/regression-analysis"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/sandwich-estimator"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/robust-standard-error"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/standard-error"/>
        <dcterms:identifier>HEO-L-d19ff8018395</dcterms:identifier>
        <linkRationale xml:lang="en">A robust standard error is a standard error.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/robust-standard-error"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/regression-analysis"/>
        <dcterms:identifier>HEO-L-728a40ee8a73</dcterms:identifier>
        <linkRationale xml:lang="en">Robust standard errors are computed from a fitted regression.</linkRationale>
