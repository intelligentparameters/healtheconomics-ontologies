        <dcterms:identifier>HS-DC-HC-009</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Lifetime Cost</rdfs:label>
        <skos:definition xml:lang="en">The total expected healthcare expenditure a patient will incur over the remainder of their life, related to a condition and sometimes unrelated future costs.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Lifetime Healthcare Cost</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Whole-of-Life Cost</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Lifetime Cost</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/annual-cost"/>
