    <!-- https://healtheconomics.wiki/concept/coherence -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/coherence">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/value-of-information"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/value-of-information"/>
        <skos:notation>HE-EM-VI-003</skos:notation>
        <dcterms:identifier>HE-EM-VI-003</dcterms:identifier>
        <dcterms:source>Cooke 1991</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Coherence</rdfs:label>
        <skos:definition xml:lang="en">A property requiring a set of subjective probability judgements to satisfy the basic axioms of probability theory, such as summing to one.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Axiom Consistency</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Probabilistic Consistency</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Coherence</skos:prefLabel>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/prior-probability"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/coherence"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/value-of-information"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-aa03934aef74</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Modelling &gt; Value of Information: catalogue subdomain Economic Modelling is one of the subdomains; placed under Value of Information, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/coherence"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isPropertyOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/prior-probability"/>
        <dcterms:identifier>HEO-L-212cdf3f1a02</dcterms:identifier>
