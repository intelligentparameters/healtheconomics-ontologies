        <skos:notation>HE-EE-EPR-030</skos:notation>
        <dcterms:identifier>HE-EE-EPR-030</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</dcterms:modified>
        <dcterms:source>Palmer &amp; Raftery 1999</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Opportunity Cost</rdfs:label>
        <owl:versionInfo>1.0.31</owl:versionInfo>
        <skos:altLabel xml:lang="en">Alternative Cost</skos:altLabel>
        <skos:definition xml:lang="en">Opportunity cost is the value of the best alternative given up when a resource is put to one use; in health care, usually health lost elsewhere.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Forgone Benefit</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Opportunity Cost</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/sunk-cost"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/allocative-efficiency"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-threshold"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/discount-rate-selection"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/disinvestment"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/economic-evaluation"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/opportunity-cost-criterion"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/patient-time-cost"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/resource-allocation"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/resource-valuation"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/shadow-price"/>
        <prerequisiteFor rdf:resource="https://healtheconomics.wiki/concept/production-possibility-frontier"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/opportunity-cost"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-principle"/>
        <dcterms:identifier>HEO-L-c27f2ff54cf4</dcterms:identifier>
        <linkRationale xml:lang="en">Object definition names opportunity cost as an economic principle</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
