        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Escapable Cost</skos:altLabel>
        <skos:definition xml:lang="en">Avoidable cost is the cost a budget holder would no longer pay if a health service stopped or a disease was prevented, within a stated time period.</skos:definition>
