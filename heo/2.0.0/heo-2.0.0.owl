        <dcterms:identifier>HS-SS-GH-016</dcterms:identifier>
        <dcterms:source>Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams &amp; Wilkins; 2008.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Isolation</rdfs:label>
        <skos:definition xml:lang="en">An infection control practice separating individuals known to be infected with a contagious disease from others, preventing further transmission.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Contagion Separation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Infectious-Patient Separation</skos:hiddenLabel>
