    <!-- https://healtheconomics.wiki/concept/uncertainty-quantification -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/uncertainty-quantification">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/uncertainty-assessment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/uncertainty-assessment"/>
        <skos:notation>HE-EM-UA-081</skos:notation>
        <dcterms:identifier>HE-EM-UA-081</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Briggs A, Claxton K, Sculpher M. Decision Modelling for Health Economic Evaluation. Oxford University Press; 2006. doi:10.1093/oso/9780198526629.001.0001.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Uncertainty Quantification</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">UQ</skos:altLabel>
        <skos:definition xml:lang="en">The formal process of measuring how much confidence should be placed in a model&apos;s results, given the sources of uncertainty affecting it.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Numerical Uncertainty Analysis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Uncertainty Quantification</skos:prefLabel>
        <abbreviation xml:lang="en">UQ</abbreviation>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/parameter-uncertainty"/>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/structural-uncertainty"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-10"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/psa"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/uncertainty-quantification"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/uncertainty-assessment"/>
        <dcterms:identifier>HEO-L-74aed9c0e2ea</dcterms:identifier>
        <linkRationale xml:lang="en">Uncertainty quantification is a formal uncertainty assessment.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/uncertainty-quantification"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#addresses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/parameter-uncertainty"/>
