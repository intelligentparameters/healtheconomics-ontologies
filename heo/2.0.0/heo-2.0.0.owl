    <!-- https://healtheconomics.wiki/concept/price-linkage -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/price-linkage">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/reference-pricing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/reference-pricing"/>
        <skos:notation>HS-DC-DP-068</skos:notation>
        <dcterms:identifier>HS-DC-DP-068</dcterms:identifier>
        <dcterms:source>Danzon 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Price Linkage</rdfs:label>
        <skos:definition xml:lang="en">A policy or contractual arrangement connecting a drug&apos;s price in one market to its price in another, such as international reference pricing.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cross-Country Price Linking</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Price Referencing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Price Linkage</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/price-spillover"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/price-linkage"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/reference-pricing"/>
