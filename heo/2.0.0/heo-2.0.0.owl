    <!-- https://healtheconomics.wiki/concept/quality-assessment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/quality-assessment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/critical-appraisal"/>
