    <!-- https://healtheconomics.wiki/concept/evsi -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/evsi">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/value-of-information"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/value-of-information"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/expected-net-benefit-of-sampling"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/optimal-sample-size"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/optimal-study-design"/>
        <skos:notation>HE-EM-VI-011</skos:notation>
        <dcterms:identifier>HE-EM-VI-011</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</dcterms:modified>
        <dcterms:source>Fenwick et al. 2020</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Expected Value of Sample Information</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:altLabel xml:lang="en">EVSI</skos:altLabel>
        <skos:definition xml:lang="en">Expected value of sample information (EVSI) is the expected net benefit gained by deciding after a specific proposed study reports instead of deciding now.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Sample-Information Value</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Expected Value of Sample Information</skos:prefLabel>
        <abbreviation xml:lang="en">EVSI</abbreviation>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-11"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/bayes-theorem"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/psa"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/evsi"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/value-of-information"/>
        <dcterms:identifier>HEO-L-31f2aab98a1f</dcterms:identifier>
        <linkRationale xml:lang="en">EVSI is a value of information measure</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
