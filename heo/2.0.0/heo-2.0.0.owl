    <!-- https://healtheconomics.wiki/concept/cost-per-qaly -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cost-per-qaly">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/icer"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/icer"/>
        <skos:notation>HE-EE-CUA-002</skos:notation>
        <dcterms:identifier>HE-EE-CUA-002</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>NICE PMG36 (2022, updated 2026) section 4.2.16</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cost per QALY</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Cost per Quality-Adjusted Life Year</skos:altLabel>
        <skos:altLabel xml:lang="en">Cost/QALY</skos:altLabel>
        <skos:definition xml:lang="en">Cost per QALY gained is the extra cost of a treatment compared with an alternative, divided by the quality-adjusted life years (QALYs) it adds.</skos:definition>
        <skos:prefLabel xml:lang="en">Cost per QALY</skos:prefLabel>
        <abbreviation xml:lang="en">Cost/QALY</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/average-cost-effectiveness-ratio"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-4"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/coverage-decision"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
