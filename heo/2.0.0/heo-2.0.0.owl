    <!-- https://healtheconomics.wiki/concept/late-adopter -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/late-adopter">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/adoption-curve"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/diffusion-of-innovation"/>
        <skos:notation>HS-HP-SS-021</skos:notation>
        <dcterms:identifier>HS-HP-SS-021</dcterms:identifier>
        <dcterms:source>Rogers 2003</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Late Adopter</rdfs:label>
        <skos:definition xml:lang="en">An individual or organisation beginning to use a new innovation relatively late in its diffusion, often facing greater scepticism or barriers.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Laggard</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Late Majority</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Late Adopter</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/early-adopter"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/late-adopter"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
