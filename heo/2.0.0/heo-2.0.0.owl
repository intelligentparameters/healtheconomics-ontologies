    <!-- https://healtheconomics.wiki/concept/innovation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/innovation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <precedes rdf:resource="https://healtheconomics.wiki/concept/innovation-adoption"/>
        <skos:notation>HS-HP-HTA-113</skos:notation>
        <dcterms:identifier>HS-HP-HTA-113</dcterms:identifier>
        <dcterms:source>Christensen, Raynor &amp; McDonald 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Innovation</rdfs:label>
        <skos:definition xml:lang="en">The introduction of a new idea, technology, or method that creates value, from incremental improvement to fundamental, disruptive change.</skos:definition>
        <skos:hiddenLabel xml:lang="en">New Idea Introduction</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Value-Creating Novelty</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Innovation</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
