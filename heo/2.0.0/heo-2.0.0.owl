    <!-- https://healtheconomics.wiki/concept/financial-barrier -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/financial-barrier">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/access-barrier"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/access-barrier"/>
        <skos:notation>HS-HP-HE-016</skos:notation>
        <dcterms:identifier>HS-HP-HE-016</dcterms:identifier>
        <dcterms:source>Penchansky R, Thomas JW. The concept of access: definition and relationship to consumer satisfaction. Medical Care. 1981;19(2):127-140. doi:10.1097/00005650-198102000-00001.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Financial Barrier</rdfs:label>
        <skos:altLabel xml:lang="en">Cost Barrier</skos:altLabel>
        <skos:definition xml:lang="en">An obstacle to healthcare arising from cost, including high out-of-pocket expenses, lack of insurance, or the opportunity cost of time off work.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Affordability Barrier</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Financial Barrier</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/delayed-care"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/affordability"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/financial-barrier"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/access-barrier"/>
        <dcterms:identifier>HEO-L-1c5bb2505056</dcterms:identifier>
        <linkRationale xml:lang="en">Cost barriers are one kind of access barrier</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
