    <!-- https://healtheconomics.wiki/concept/total-effect-index -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/total-effect-index">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/sobol-indices"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/sobol-indices"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/parameter-importance"/>
        <skos:notation>HE-EM-UA-024</skos:notation>
        <dcterms:identifier>HE-EM-UA-024</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Homma &amp; Saltelli 1996</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Total Effect Index</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Total Sobol Index</skos:altLabel>
        <skos:altLabel xml:lang="en">Total-Order Index</skos:altLabel>
        <skos:definition xml:lang="en">A variance-based sensitivity measure quantifying an input&apos;s total contribution to output variance, including its individual effect and all interactions with other inputs.</skos:definition>
        <skos:prefLabel xml:lang="en">Total Effect Index</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-10"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/total-effect-index"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/sobol-indices"/>
        <dcterms:identifier>HEO-L-7d873e8ab54b</dcterms:identifier>
        <linkRationale xml:lang="en">The total effect index is one of the Sobol indices.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/total-effect-index"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/parameter-importance"/>
        <dcterms:identifier>HEO-L-53ff1953a566</dcterms:identifier>
        <linkRationale xml:lang="en">A total-effect index is an input share of output variance, a measure of parameter importance, not of data variance</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/total-quality-management -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/total-quality-management">
