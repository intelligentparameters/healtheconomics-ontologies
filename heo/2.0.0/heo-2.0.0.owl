    <!-- https://healtheconomics.wiki/concept/economies-of-scale -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/economies-of-scale">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q5970087"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <skos:notation>HE-EE-CA-037</skos:notation>
        <dcterms:identifier>HE-EE-CA-037</dcterms:identifier>
        <dcterms:source>Varian 2014</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Economies of Scale</rdfs:label>
        <skos:altLabel xml:lang="en">Scale Economies</skos:altLabel>
        <skos:definition xml:lang="en">A situation in which average cost of production falls as output rises, typically because fixed costs are spread across greater volume.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Falling Average Cost</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Economies of Scale</skos:prefLabel>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/cost-function"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/economies-of-scale"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-a1f5ed74c7f7</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Cost Analysis: cost analysis is costing; most concepts with this Level 3 that the wiki places in a topic sit in Costs</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/economies-of-scale"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isPropertyOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-function"/>
        <dcterms:identifier>HEO-L-315cb0136a64</dcterms:identifier>
        <linkRationale xml:lang="en">falling average cost is a characteristic of a cost function, not a kind of function</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


