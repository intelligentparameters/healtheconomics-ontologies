        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/advance-directive"/>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/best-interest-standard"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/capacity-assessment"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
