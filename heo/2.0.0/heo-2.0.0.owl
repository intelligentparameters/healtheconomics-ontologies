    <!-- https://healtheconomics.wiki/concept/income-elasticity-of-demand -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/income-elasticity-of-demand">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/elasticity"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
