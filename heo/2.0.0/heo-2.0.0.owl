    <!-- https://healtheconomics.wiki/concept/availability-concept -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/availability-concept">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cognitive-bias-concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/heuristics-concept"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cognitive-bias-concept"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/heuristics-concept"/>
        <skos:notation>HE-EE-BE-002</skos:notation>
        <dcterms:identifier>HE-EE-BE-002</dcterms:identifier>
        <dcterms:source>Tversky &amp; Kahneman 1973</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Availability Heuristic</rdfs:label>
        <skos:altLabel xml:lang="en">Availability Bias</skos:altLabel>
        <skos:definition xml:lang="en">A cognitive heuristic in which perceived probability is based on how easily examples come to mind rather than actual frequency.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Ease-of-Recall Heuristic</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Availability Heuristic</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/representativeness-concept"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/availability-concept"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cognitive-bias-concept"/>
        <dcterms:identifier>HEO-L-3c35e3a79d61</dcterms:identifier>
        <linkRationale xml:lang="en">Cognitive bias definition covers errors from mental shortcuts</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/availability-concept"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
