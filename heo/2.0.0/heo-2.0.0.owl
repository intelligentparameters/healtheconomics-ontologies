        <owl:versionInfo>1.0.3</owl:versionInfo>
        <skos:altLabel xml:lang="en">A4R</skos:altLabel>
        <skos:definition xml:lang="en">Accountability for reasonableness (A4R) is a fair-process framework for health priority setting: publicity, relevance, revisability and enforcement.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Fair Priority-Setting Framework</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Accountability for Reasonableness</skos:prefLabel>
        <abbreviation xml:lang="en">A4R</abbreviation>
