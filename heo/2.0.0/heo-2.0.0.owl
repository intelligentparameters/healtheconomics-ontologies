    <!-- https://healtheconomics.wiki/concept/therapeutic-interchange -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/therapeutic-interchange">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-substitution"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/utilisation-management"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/drug-substitution"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/utilisation-management"/>
        <skos:notation>PP-PC-FM-011</skos:notation>
        <dcterms:identifier>PP-PC-FM-011</dcterms:identifier>
        <dcterms:source>Danzon 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Therapeutic Interchange</rdfs:label>
        <skos:definition xml:lang="en">Substituting a different medication within the same class for a prescribed drug, based on protocols indicating therapeutic equivalence, typically with physician notification.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Protocol Substitution</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Therapeutic Swap</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Therapeutic Interchange</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/therapeutic-interchange"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-substitution"/>
        <dcterms:identifier>HEO-L-02101e9a2de6</dcterms:identifier>
        <linkRationale xml:lang="en">Therapeutic interchange substitutes an equivalent medicine.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/therapeutic-interchange"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/utilisation-management"/>
        <dcterms:identifier>HEO-L-67935c687dbf</dcterms:identifier>
        <linkRationale xml:lang="en">Payers and formularies use interchange protocols to control drug use.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/therapeutic-misconception -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/therapeutic-misconception">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-HP-HSG-030</skos:notation>
        <dcterms:identifier>HS-HP-HSG-030</dcterms:identifier>
        <dcterms:source>Appelbaum, Roth &amp; Lidz 1982</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Therapeutic Misconception</rdfs:label>
        <skos:definition xml:lang="en">A phenomenon where a trial participant mistakenly believes their participation is meant to provide personalised treatment rather than generate scientific knowledge.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Research Misconception</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Trial Misconception</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Therapeutic Misconception</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/informed-consent"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/therapeutic-misconception"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-b96cff6b865d</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health System Governance: organisation and delivery of care is the Health Systems subdomain (Organisation and governance)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/therapeutic-misconception"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#threatensValidityOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/informed-consent"/>
        <dcterms:identifier>HEO-L-037a57bd6fc8</dcterms:identifier>
        <linkRationale xml:lang="en">Believing a trial is personal treatment undermines informed consent.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/therapeutic-privilege -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/therapeutic-privilege">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-HP-HD-114</skos:notation>
        <dcterms:identifier>HS-HP-HD-114</dcterms:identifier>
        <dcterms:source>Faden &amp; Beauchamp 1986</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Therapeutic Privilege</rdfs:label>
        <skos:altLabel xml:lang="en">Therapeutic Exception</skos:altLabel>
        <skos:definition xml:lang="en">A limited, ethically contested exception to consent requirements in which a physician withholds information judged likely to cause significant psychological harm.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Physician Withholding</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Therapeutic Privilege</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/shared-decision-making"/>
        <modifies rdf:resource="https://healtheconomics.wiki/concept/informed-consent"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/therapeutic-privilege"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-fd5829650acc</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Healthcare Delivery: organisation and delivery of care is the Health Systems subdomain (Organisation and governance)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/therapeutic-privilege"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/shared-decision-making"/>
        <dcterms:identifier>HEO-L-1ecae9c11b13</dcterms:identifier>
        <linkRationale xml:lang="en">Withholding information opposes the shared disclosure of shared decision making.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/therapeutic-privilege"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#modifies"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/informed-consent"/>
        <dcterms:identifier>HEO-L-75f642cdb8d6</dcterms:identifier>
        <linkRationale xml:lang="en">Therapeutic privilege is an exception that changes when full disclosure for consent applies (subject definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/therapeutic-reference-pricing -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/therapeutic-reference-pricing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/internal-reference-pricing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/internal-reference-pricing"/>
        <skos:notation>HS-DC-DP-100</skos:notation>
        <dcterms:identifier>HS-DC-DP-100</dcterms:identifier>
        <dcterms:source>Danzon 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Therapeutic Reference Pricing</rdfs:label>
        <skos:definition xml:lang="en">A policy grouping drugs believed to produce similar therapeutic effects and setting one reference reimbursement level, encouraging use of the most cost-effective option.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Class-Based Reference Pricing</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Therapeutic Class Reference Pricing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Therapeutic Reference Pricing</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/therapeutic-class"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/therapeutic-reference-pricing"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/internal-reference-pricing"/>
        <dcterms:identifier>HEO-L-6aafd94b654f</dcterms:identifier>
        <linkRationale xml:lang="en">Grouping similar drugs at one reference level is internal reference pricing.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/therapeutic-reference-pricing"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/therapeutic-class"/>
        <dcterms:identifier>HEO-L-08e16f1019eb</dcterms:identifier>
        <linkRationale xml:lang="en">Reference groups are formed by therapeutic class.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


