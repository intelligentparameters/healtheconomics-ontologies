    <!-- https://healtheconomics.wiki/concept/rate-to-probability-conversion -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/rate-to-probability-conversion">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:notation>HE-EM-MP-036</skos:notation>
        <dcterms:identifier>HE-EM-MP-036</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Miller &amp; Homan 1994</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Rate-to-Probability Conversion</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Hazard-to-Probability Conversion</skos:altLabel>
        <skos:definition xml:lang="en">The mathematical transformation converting a continuous-time hazard rate into the probability of an event occurring within a discrete time interval.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Hazard Transformation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Rate-Based Probability Estimation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Rate-Probability Transform</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Rate-Probability Transformation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Rate-to-Probability Conversion</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-4"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/transition-probability"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/hazard-rate"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/rate-to-probability-conversion"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <dcterms:identifier>HEO-L-29baa592e7cf</dcterms:identifier>
        <linkRationale xml:lang="en">A standard mathematical procedure used in model parameter estimation (Briggs, Claxton and Sculpher 2006).</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/rate-to-probability-conversion"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#produces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/transition-probability"/>
        <dcterms:identifier>HEO-L-4be2c83b469a</dcterms:identifier>
        <linkRationale xml:lang="en">A conversion is a transformation that yields the probability, not an input quantity</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
