        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/adverse-drug-reaction"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/adverse-event"/>
        <skos:notation>HE-PE-CP-006</skos:notation>
        <dcterms:identifier>HE-PE-CP-006</dcterms:identifier>
        <dcterms:source>FDA-NIH Biomarker Working Group 2016</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Hepatotoxicity</rdfs:label>
        <skos:altLabel xml:lang="en">Liver Toxicity</skos:altLabel>
        <skos:definition xml:lang="en">An adverse effect in which a drug or treatment damages the liver, ranging from mild, reversible enzyme changes to severe liver failure.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Drug-Induced Liver Injury</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Hepatotoxicity</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
