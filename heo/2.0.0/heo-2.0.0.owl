    <!-- https://healtheconomics.wiki/concept/gainsharing -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/gainsharing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/efficiency-incentive"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/efficiency-incentive"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <skos:notation>HS-HP-PP-054</skos:notation>
        <dcterms:identifier>HS-HP-PP-054</dcterms:identifier>
        <dcterms:source>Carlson JJ, Sullivan SD, Garrison LP, Neumann PJ, Veenstra DL. Linking payment to health outcomes: a taxonomy and examination of performance-based reimbursement schemes. Health Policy. 2010;96(3):179-190.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Gainsharing</rdfs:label>
        <skos:altLabel xml:lang="en">Gain Sharing</skos:altLabel>
        <skos:definition xml:lang="en">An arrangement in which a hospital shares cost savings from improved efficiency with the physicians whose practice changes helped generate them.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Savings-Sharing Arrangement</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Gainsharing</skos:prefLabel>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/operational-efficiency"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/gainsharing"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/efficiency-incentive"/>
        <dcterms:identifier>HEO-L-217a2e400fa5</dcterms:identifier>
        <linkRationale xml:lang="en">Sharing efficiency savings with physicians is a financial reward for using fewer resources.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
