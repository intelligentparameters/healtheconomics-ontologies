    <!-- https://healtheconomics.wiki/concept/shared-frailty -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/shared-frailty">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/frailty-model"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/frailty-model"/>
        <skos:notation>HE-EM-SM-079</skos:notation>
        <dcterms:identifier>HE-EM-SM-079</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Vaupel, Manton &amp; Stallard 1979</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Shared Frailty</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">An extension of the frailty model in which individuals within the same group are assumed to share a common unobserved risk effect.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Group Frailty</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Shared Frailty</skos:prefLabel>
        <counterpartOf rdf:resource="https://healtheconomics.wiki/concept/random-effects-model"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/shared-frailty"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/frailty-model"/>
        <dcterms:identifier>HEO-L-855af5a32b66</dcterms:identifier>
        <linkRationale xml:lang="en">Shared frailty extends the frailty model.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/shared-frailty"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#counterpartOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/random-effects-model"/>
        <dcterms:identifier>HEO-L-a37b342735eb</dcterms:identifier>
