    <!-- https://healtheconomics.wiki/concept/direct-elicitation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/direct-elicitation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
