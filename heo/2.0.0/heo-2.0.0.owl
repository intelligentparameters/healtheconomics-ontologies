    <!-- https://healtheconomics.wiki/concept/exponential-discounting -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/exponential-discounting">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/discounting"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q5421517"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/discounting"/>
        <skos:notation>HE-EE-DC-015</skos:notation>
        <dcterms:identifier>HE-EE-DC-015</dcterms:identifier>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Exponential Discounting</rdfs:label>
        <skos:definition xml:lang="en">A discounting model in which future costs and benefits are reduced at a constant proportional rate each period, producing time-consistent preferences.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Constant-Rate Discounting</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Time-Consistent Discounting</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Exponential Discounting</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/discount-rate"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/exponential-discounting"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/discounting"/>
        <dcterms:identifier>HEO-L-76ce6b1ef4c9</dcterms:identifier>
        <linkRationale xml:lang="en">Constant-rate exponential discounting is the form social planners most often use, per the Discounting article</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
