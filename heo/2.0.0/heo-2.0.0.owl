    <!-- https://healtheconomics.wiki/concept/severity-of-disease -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/severity-of-disease">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
