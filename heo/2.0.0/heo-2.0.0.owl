        <skos:prefLabel xml:lang="en">Behaviour Change</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/population-health"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
