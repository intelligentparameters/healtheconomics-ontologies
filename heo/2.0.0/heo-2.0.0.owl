        <dcterms:source>Brealey, Myers &amp; Allen 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Quick Ratio</rdfs:label>
        <skos:altLabel xml:lang="en">Acid-Test Ratio</skos:altLabel>
        <skos:definition xml:lang="en">A financial ratio calculated as current assets excluding inventory, divided by current liabilities, a more conservative liquidity measure than the current ratio.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Liquidity Gauge</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Quick Ratio</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-4"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/quick-ratio"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/liquidity-ratio"/>
        <dcterms:identifier>HEO-L-38ea418c9bb7</dcterms:identifier>
        <linkRationale xml:lang="en">The quick ratio is a liquidity ratio.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


