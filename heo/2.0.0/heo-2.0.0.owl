        <uses rdf:resource="https://healtheconomics.wiki/concept/net-health-benefit"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/social-welfare-function"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
