    <!-- https://healtheconomics.wiki/concept/annual-limit -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/annual-limit">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/benefit-limit"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/benefit-limit"/>
        <skos:notation>HS-HP-HI-008</skos:notation>
        <dcterms:identifier>HS-HP-HI-008</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Annual Limit</rdfs:label>
        <skos:altLabel xml:lang="en">Annual Benefit Limit</skos:altLabel>
        <skos:altLabel xml:lang="en">Annual Maximum</skos:altLabel>
        <skos:definition xml:lang="en">A cap on the total amount an insurance plan will pay for covered services within a year, beyond which the enrollee pays.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Maximum Annual Payout</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Yearly Benefit Cap</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Yearly Maximum Benefit</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Annual Limit</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/out-of-pocket-maximum"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/out-of-pocket-cost"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/annual-limit"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/benefit-limit"/>
        <dcterms:identifier>HEO-L-099790e434bf</dcterms:identifier>
