        <skos:altLabel xml:lang="en">Tele-Medicine</skos:altLabel>
        <skos:definition xml:lang="en">The practice of delivering clinical healthcare services remotely using telecommunications technology, such as video conferencing, avoiding an in-person visit.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Remote Clinical Care</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Telemedicine</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/telemedicine-platform"/>
    </owl:NamedIndividual>
