    <!-- https://healtheconomics.wiki/concept/blame-free-reporting -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/blame-free-reporting">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/safety-culture"/>
        <skos:notation>HS-NHS-HQ-008</skos:notation>
        <dcterms:identifier>HS-NHS-HQ-008</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
