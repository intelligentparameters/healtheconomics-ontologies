    <!-- https://healtheconomics.wiki/concept/clinical-effectiveness-review -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/clinical-effectiveness-review">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
