    <!-- https://healtheconomics.wiki/concept/uncompensated-care -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/uncompensated-care">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q70447363"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <skos:notation>HS-HP-HF-080</skos:notation>
        <dcterms:identifier>HS-HP-HF-080</dcterms:identifier>
        <dcterms:source>CMS, Medicaid Disproportionate Share Hospital Program</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Uncompensated Care</rdfs:label>
        <skos:definition xml:lang="en">Healthcare services provided for which no payment is received, covering both free charity care and unpaid bad debt.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Unreimbursed Care</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Uncompensated Care</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/uncompensated-care"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <dcterms:identifier>HEO-L-13975b9f571e</dcterms:identifier>
        <linkRationale xml:lang="en">Uncompensated care is reported as a cost borne by providers (charity care and bad debt).</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/uncontrollable-cost -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/uncontrollable-cost">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <skos:notation>HE-EE-CA-085</skos:notation>
        <dcterms:identifier>HE-EE-CA-085</dcterms:identifier>
        <dcterms:source>Horngren, Datar &amp; Rajan 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Uncontrollable Cost</rdfs:label>
        <skos:altLabel xml:lang="en">Non-Controllable Cost</skos:altLabel>
        <skos:definition xml:lang="en">A cost that a specific manager or department cannot influence through their own decisions, often set at a higher organisational level.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Non-Discretionary Cost</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Uncontrollable Cost</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/uncontrollable-cost"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <dcterms:identifier>HEO-L-cc369913d2c3</dcterms:identifier>
        <linkRationale xml:lang="en">An uncontrollable cost is a cost.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/undercoverage-rate -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/undercoverage-rate">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/exclusion-error"/>
        <skos:notation>HE-EE-HE-018</skos:notation>
        <dcterms:identifier>HE-EE-HE-018</dcterms:identifier>
        <dcterms:source>Cornia &amp; Stewart 1993</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Undercoverage Rate</rdfs:label>
        <skos:definition xml:lang="en">The proportion of a programme&apos;s intended eligible population that does not actually receive its benefits, whether from awareness, administrative, or targeting failures.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Coverage Shortfall Rate</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Non-Coverage Rate</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Undercoverage Rate</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/targeting-policy"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/undercoverage-rate"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-2e05aa47588e</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Health Equity: wiki topic Equity and inequality sits in Health Policy</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/undercoverage-rate"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/exclusion-error"/>
        <dcterms:identifier>HEO-L-4d8cb40063f0</dcterms:identifier>
        <linkRationale xml:lang="en">Undercoverage is eligible people missed, i.e. exclusion error; effective coverage needs health gain</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/undercoverage-rate"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
