        <rdfs:label xml:lang="en">Clinical Endpoint</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">A clinical endpoint is a predefined trial outcome for judging a treatment; strictly, one directly measuring how a patient feels, functions or survives.</skos:definition>
