        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/fee-for-service"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/unbundled-payment"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/risk-adjustment"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/bundled-payment"/>
