    <!-- https://healtheconomics.wiki/concept/population-level-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/population-level-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/aggregate-model"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/aggregate-model"/>
        <skos:notation>HE-EM-DM-080</skos:notation>
        <dcterms:identifier>HE-EM-DM-080</dcterms:identifier>
        <dcterms:source>Briggs A, Claxton K, Sculpher M. Decision Modelling for Health Economic Evaluation. Oxford University Press; 2006. doi:10.1093/oso/9780198526629.001.0001.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Population-Level Model</rdfs:label>
        <skos:definition xml:lang="en">A decision-analytic model representing outcomes for an entire population rather than individual patients, often used to capture transmission or budget effects.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Aggregate-Level Model</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Whole-Population Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Population-Level Model</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/individual-level-model"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/population-level-model"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/aggregate-model"/>
        <dcterms:identifier>HEO-L-efa6f3e4f12c</dcterms:identifier>
        <linkRationale xml:lang="en">A population-level model uses summary parameters, so it is an aggregate model</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/population-level-model"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/individual-level-model"/>
        <dcterms:identifier>HEO-L-7ab0b5493019</dcterms:identifier>
        <linkRationale xml:lang="en">Population-level and individual-level models are the standard alternative model types</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
