        <rdfs:label xml:lang="en">Accelerated Approval</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Accelerated approval is an FDA pathway that approves medicines for serious conditions on a surrogate endpoint, with confirmatory trials to verify benefit.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Conditional Marketing Authorisation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Fast-Track Approval</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Accelerated Approval</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/full-approval"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-policy#step-1"/>
        <counterpartOf rdf:resource="https://healtheconomics.wiki/concept/conditional-approval"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/surrogate-endpoint"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/accelerated-approval"/>
