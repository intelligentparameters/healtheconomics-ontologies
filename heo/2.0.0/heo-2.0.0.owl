    <!-- https://healtheconomics.wiki/concept/content-validity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/content-validity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/measurement-property"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1663508"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/measurement-property"/>
        <skos:notation>HE-ES-EA-008</skos:notation>
        <dcterms:identifier>HE-ES-EA-008</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Terwee et al. 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Content Validity</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:definition xml:lang="en">Content validity is how far a health measure&apos;s items are relevant, comprehensive and understood for its construct, target population and context of use.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Content Soundness</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Domain Representativeness</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Content Validity</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/criterion-validity"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/patient-reported-outcome"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/preference-based-measure"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/content-validity"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/measurement-property"/>
        <dcterms:identifier>HEO-L-d8841ff52d35</dcterms:identifier>
        <linkRationale xml:lang="en">Object definition names validity</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
