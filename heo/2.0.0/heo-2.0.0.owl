    <!-- https://healtheconomics.wiki/concept/mixture-cure-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/mixture-cure-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cure-model"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/mixture-model"/>
