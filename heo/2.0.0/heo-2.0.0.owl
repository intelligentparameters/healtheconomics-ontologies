        <uses rdf:resource="https://healtheconomics.wiki/concept/marginal-cost"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/marginal-cost-of-healthcare"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/opportunity-cost"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
