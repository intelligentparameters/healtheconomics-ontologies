    <!-- https://healtheconomics.wiki/concept/molecular-epidemiology -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/molecular-epidemiology">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/epidemiology"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q4118435"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/epidemiology"/>
        <skos:notation>HE-ES-EP-027</skos:notation>
        <dcterms:identifier>HE-ES-EP-027</dcterms:identifier>
        <dcterms:source>Khoury, Beaty &amp; Cohen 1993</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Molecular Epidemiology</rdfs:label>
        <skos:altLabel xml:lang="en">Molecular Epi</skos:altLabel>
        <skos:definition xml:lang="en">A branch of epidemiology incorporating molecular and genetic biomarkers into the study of disease distribution and causation, allowing precise characterisation of disease subtypes.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Molecular Disease Tracking</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Molecular Epidemiology</skos:prefLabel>
