        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Stepped Economic Evaluation</rdfs:label>
        <skos:definition xml:lang="en">Stepped economic evaluation, in a PBAC submission, reports costs, outcomes and the ICER after each step that turns trial data into the modelled base case.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Stepped Approach</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Stepped Translation of Trial Evidence</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Stepped Economic Evaluation</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/extrapolation"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/trial-based-analysis"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/stepped-economic-evaluation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-evaluation"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-71476a601fc3</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Evaluation Methods: wiki topic Evaluation types and frameworks sits in Economic Evaluation</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/stepped-economic-evaluation"/>
