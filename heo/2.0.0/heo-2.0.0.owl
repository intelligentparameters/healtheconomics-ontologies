        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Distributive Justice</rdfs:label>
        <skos:definition xml:lang="en">A branch of ethical and political philosophy concerned with the fair allocation of resources, benefits, and burdens across a society.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Fair Allocation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Justice in Distribution</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Distributive Justice</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/procedural-justice"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/bioethics"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/health-equity"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/health-inequity"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
