        <dcterms:identifier>HEO-L-8e400b42b21e</dcterms:identifier>
        <linkRationale xml:lang="en">an effectiveness outcome is a clinical outcome</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
