    <!-- https://healtheconomics.wiki/concept/service-line-budget -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/service-line-budget">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/operating-budget"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/operating-budget"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/service-line-management"/>
        <skos:notation>HE-EE-BIA-044</skos:notation>
        <dcterms:identifier>HE-EE-BIA-044</dcterms:identifier>
        <dcterms:source>Gapenski 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Service Line Budget</rdfs:label>
        <skos:altLabel xml:lang="en">Service-Line Budgeting</skos:altLabel>
        <skos:definition xml:lang="en">A budget allocated to a specific clinical service line, such as cardiology, covering its costs and expected revenues.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Clinical Service Budget</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Service Line Budget</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
