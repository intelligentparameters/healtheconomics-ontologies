        <rdfs:label xml:lang="en">Ambulatory Surgery Centre</rdfs:label>
        <skos:altLabel xml:lang="en">ASC</skos:altLabel>
        <skos:definition xml:lang="en">A specialist facility providing same-day surgical procedures not requiring overnight stay, typically at lower cost than an equivalent hospital procedure.</skos:definition>
