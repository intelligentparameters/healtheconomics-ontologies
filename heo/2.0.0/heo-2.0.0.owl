        <dcterms:identifier>HE-ES-SA-001</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Kalbfleisch &amp; Prentice 2002</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Accelerated Failure Time Model</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">AFT Model</skos:altLabel>
        <skos:altLabel xml:lang="en">AFT Regression</skos:altLabel>
        <skos:definition xml:lang="en">An accelerated failure time (AFT) model is a survival model in which treatment or another factor stretches or shrinks time to an event by a time ratio.</skos:definition>
        <skos:prefLabel xml:lang="en">Accelerated Failure Time Model</skos:prefLabel>
        <abbreviation xml:lang="en">AFT Model</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/cox-proportional-hazards"/>
