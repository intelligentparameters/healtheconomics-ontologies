    <!-- https://healtheconomics.wiki/concept/blended-payment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/blended-payment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <skos:notation>HS-HP-PP-010</skos:notation>
        <dcterms:identifier>HS-HP-PP-010</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Robinson 2001</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Blended Payment</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Mixed Payment</skos:altLabel>
        <skos:definition xml:lang="en">Blended payment pays health care providers by mixing methods, such as capitation plus fee-for-service or case rates, so each offsets the others&apos; flaws.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Hybrid Payment Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Blended Payment</skos:prefLabel>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/capitation"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/fee-for-service"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/pay-for-performance"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/blended-payment"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <dcterms:identifier>HEO-L-99e0c1449b0b</dcterms:identifier>
        <linkRationale xml:lang="en">Blended payment is a provider payment method</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
