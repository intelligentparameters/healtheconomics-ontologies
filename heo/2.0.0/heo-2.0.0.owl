    <!-- https://healtheconomics.wiki/concept/missing-not-at-random -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/missing-not-at-random">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:notation>HE-ES-SA-123</skos:notation>
        <dcterms:identifier>HE-ES-SA-123</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Rubin 1976</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Missing Not at Random</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">MNAR</skos:altLabel>
        <skos:altLabel xml:lang="en">Non-Ignorable Missingness</skos:altLabel>
        <skos:definition xml:lang="en">Missing not at random describes a missing-data mechanism in which the probability that a value is unobserved depends on that unobserved value even after conditioning on the available observed information.</skos:definition>
        <skos:prefLabel xml:lang="en">Missing Not at Random</skos:prefLabel>
        <abbreviation xml:lang="en">MNAR</abbreviation>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/missing-data"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/last-observation-carried-forward"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/missing-not-at-random"/>
