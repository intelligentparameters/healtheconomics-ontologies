    <!-- https://healtheconomics.wiki/concept/experienced-utility -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/experienced-utility">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/utility"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/utility"/>
        <skos:notation>HE-EE-HU-025</skos:notation>
        <dcterms:identifier>HE-EE-HU-025</dcterms:identifier>
        <dcterms:source>Kahneman, Wakker &amp; Sarin 1997</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Experienced Utility</rdfs:label>
        <skos:altLabel xml:lang="en">Hedonic Utility</skos:altLabel>
        <skos:definition xml:lang="en">The actual hedonic experience, such as pleasure or suffering, undergone while in a health state, unlike the decision utility anticipated in advance.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Lived Utility</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Experienced Utility</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/decision-utility"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/health-state-utility-value"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/experienced-utility"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/utility"/>
        <dcterms:identifier>HEO-L-656bfd804e04</dcterms:identifier>
        <linkRationale xml:lang="en">Experienced utility is a form of utility</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/experienced-utility"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/decision-utility"/>
        <dcterms:identifier>HEO-L-6a99eb9aa35a</dcterms:identifier>
