        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/quality-of-well-being-scale"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/cost-utility-analysis"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/country-specific-value-set"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/visual-analogue-scale"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/eq-5d"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
