        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-23</dcterms:modified>
        <dcterms:source>Nagin 1999</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Group-Based Trajectory Model</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">GBTM</skos:altLabel>
        <skos:altLabel xml:lang="en">Latent Class Growth Analysis</skos:altLabel>
        <skos:definition xml:lang="en">A technique identifying distinct subgroups following similar patterns of change over time, without assuming everyone follows the same single trajectory.</skos:definition>
        <skos:prefLabel xml:lang="en">Group-Based Trajectory Model</skos:prefLabel>
        <abbreviation xml:lang="en">GBTM</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/growth-curve-model"/>
