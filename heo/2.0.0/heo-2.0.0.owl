    <!-- https://healtheconomics.wiki/concept/combination-pricing -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/combination-pricing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:notation>HS-DC-DP-012</skos:notation>
        <dcterms:identifier>HS-DC-DP-012</dcterms:identifier>
        <dcterms:source>Carlson JJ, Sullivan SD, Garrison LP, Neumann PJ, Veenstra DL. Linking payment to health outcomes: a taxonomy and examination of performance-based reimbursement schemes. Health Policy. 2010;96(3):179-190.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Combination Pricing</rdfs:label>
        <skos:altLabel xml:lang="en">Combo Pricing</skos:altLabel>
        <skos:definition xml:lang="en">A pricing approach applied when two or more treatments are used together, requiring negotiation to establish a total price for the combined regimen.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Regimen Pricing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Combination Pricing</skos:prefLabel>
        <abbreviation xml:lang="en">Combo Pricing</abbreviation>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/price-negotiation"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/combination-pricing"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <dcterms:identifier>HEO-L-5eb9f7239a3a</dcterms:identifier>
        <linkRationale xml:lang="en">Pricing combined regimens is drug pricing</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/combination-pricing"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/price-negotiation"/>
        <dcterms:identifier>HEO-L-fe87af598b09</dcterms:identifier>
