    <!-- https://healtheconomics.wiki/concept/adverse-event -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/adverse-event">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/parameter-input"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/parameter-input"/>
        <skos:notation>HS-NHS-HQ-002</skos:notation>
        <dcterms:identifier>HS-NHS-HQ-002</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>ICH E2A 1994; Brennan et al. 1991</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Adverse Event</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">AE</skos:altLabel>
        <skos:definition xml:lang="en">An adverse event (AE) is any unfavourable medical occurrence after treatment, caused by it or not; in patient safety, an injury caused by medical care.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Adverse Medical Event</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Adverse Event</skos:prefLabel>
        <abbreviation xml:lang="en">AE</abbreviation>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/adverse-event-cost"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/disutility"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-5"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/benefit-risk-assessment"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/pharmacovigilance"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/adverse-event"/>
