    <!-- https://healtheconomics.wiki/concept/parameter-distribution -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/parameter-distribution">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/parameter-input"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/parameter-input"/>
        <skos:notation>HE-EM-UA-050</skos:notation>
        <dcterms:identifier>HE-EM-UA-050</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Briggs A, Claxton K, Sculpher M. Decision Modelling for Health Economic Evaluation. Oxford University Press; 2006. doi:10.1093/oso/9780198526629.001.0001.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Parameter Distribution</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A parameter distribution is a probability model for the plausible values of an uncertain model input, specified from evidence and assumptions so its uncertainty can be propagated through an analysis.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Input Distribution</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">PSA Distribution</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Parameter Distribution</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-10"/>
        <represents rdf:resource="https://healtheconomics.wiki/concept/parameter-uncertainty"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/parameter-distribution"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/parameter-input"/>
        <dcterms:identifier>HEO-L-f5938683f5d6</dcterms:identifier>
        <linkRationale xml:lang="en">Object definition says an input may be a value or a distribution</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/parameter-distribution"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#represents"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/parameter-uncertainty"/>
        <dcterms:identifier>HEO-L-0c1dd8ee40dc</dcterms:identifier>
        <linkRationale xml:lang="en">A distribution is not a kind of uncertainty; it is the probability model that represents parameter uncertainty (subject definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/parameter-estimation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/parameter-estimation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:notation>HE-EM-MP-026</skos:notation>
        <dcterms:identifier>HE-EM-MP-026</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Fisher 1922</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Parameter Estimation</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Estimation of Parameters</skos:altLabel>
        <skos:definition xml:lang="en">Parameter estimation is the process of using evidence and a specified model or estimating rule to infer the values of quantities needed to describe a population, relationship, or decision model.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Data-Driven Estimation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Parameter Estimation</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-4"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/parameter-input"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/point-estimate"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/maximum-likelihood-estimation"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/parameter-estimation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <dcterms:identifier>HEO-L-bb12978342d9</dcterms:identifier>
        <linkRationale xml:lang="en">Parameter estimation is a statistical procedure</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
