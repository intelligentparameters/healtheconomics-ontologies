        <skos:altLabel xml:lang="en">Economics of Substance Use</skos:altLabel>
        <skos:definition xml:lang="en">The application of health economic evaluation to substance use disorders broadly, covering prevention, medication-assisted treatment, and behavioural therapy.</skos:definition>
