    <!-- https://healtheconomics.wiki/concept/cost-effectiveness-criterion -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cost-effectiveness-criterion">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/decision-criteria"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/decision-criteria"/>
        <skos:notation>HS-HP-HTA-052</skos:notation>
        <dcterms:identifier>HS-HP-HTA-052</dcterms:identifier>
        <dcterms:source>Claxton et al. 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cost-Effectiveness Criterion</rdfs:label>
        <skos:altLabel xml:lang="en">CE Criterion</skos:altLabel>
        <skos:altLabel xml:lang="en">Threshold Criterion</skos:altLabel>
        <skos:definition xml:lang="en">The specific standard, typically a threshold, an assessment body uses to judge whether a technology&apos;s ICER represents acceptable value for money.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Threshold Cut-Off</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Threshold Rule</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Value Threshold Standard</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cost-Effectiveness Criterion</skos:prefLabel>
        <abbreviation xml:lang="en">CE Criterion</abbreviation>
        <informs rdf:resource="https://healtheconomics.wiki/concept/coverage-decision"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
