        <dcterms:identifier>HE-PE-DD-031</dcterms:identifier>
        <dcterms:source>FDA, Hatch-Waxman Act</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
