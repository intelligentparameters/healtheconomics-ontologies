    <!-- https://healtheconomics.wiki/concept/opportunity-cost-criterion -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/opportunity-cost-criterion">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/decision-rule"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/decision-rule"/>
        <skos:notation>HE-EE-EPR-033</skos:notation>
        <dcterms:identifier>HE-EE-EPR-033</dcterms:identifier>
        <dcterms:source>Claxton et al. 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Opportunity Cost Criterion</rdfs:label>
        <skos:definition xml:lang="en">A decision rule stating that an intervention should only be adopted if the value it produces exceeds the value of resources it displaces elsewhere.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Health-Maximising Criterion</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Opportunity-Cost Decision Rule</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Opportunity Cost Criterion</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-threshold"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/shadow-price-of-health"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/opportunity-cost-criterion"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/decision-rule"/>
        <dcterms:identifier>HEO-L-61fae9ababb9</dcterms:identifier>
        <linkRationale xml:lang="en">The criterion is an adoption rule, a decision rule</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/opportunity-cost-criterion"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-threshold"/>
        <dcterms:identifier>HEO-L-df263fddece8</dcterms:identifier>
        <linkRationale xml:lang="en">The criterion is applied in practice via a cost-effectiveness threshold</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
