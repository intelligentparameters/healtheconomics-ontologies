        <dcterms:identifier>HEO-L-f5d5b64d04e0</dcterms:identifier>
        <linkRationale xml:lang="en">Object definition lists case mix as a driver</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
