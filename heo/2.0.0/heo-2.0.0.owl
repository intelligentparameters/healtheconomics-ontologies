        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Workup Bias</skos:altLabel>
        <skos:definition xml:lang="en">Verification bias is error in estimated sensitivity and specificity when who receives the reference standard, or which one, depends on the test result.</skos:definition>
