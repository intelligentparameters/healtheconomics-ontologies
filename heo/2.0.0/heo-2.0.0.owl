        <skos:notation>HE-PE-AT-001</skos:notation>
        <dcterms:identifier>HE-PE-AT-001</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>European Parliament and Council 2007; Hettle et al. 2017</dcterms:source>
