    <!-- https://healtheconomics.wiki/concept/nominal-group-technique -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/nominal-group-technique">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
