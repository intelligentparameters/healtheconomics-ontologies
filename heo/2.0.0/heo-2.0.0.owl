    <!-- https://healtheconomics.wiki/concept/rivalrous-consumption -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/rivalrous-consumption">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/good-characteristic"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/good-characteristic"/>
        <skos:notation>HE-EE-ME-063</skos:notation>
        <dcterms:identifier>HE-EE-ME-063</dcterms:identifier>
        <dcterms:source>Musgrave 1959</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Rivalrous Consumption</rdfs:label>
        <skos:altLabel xml:lang="en">Consumption Rivalry</skos:altLabel>
        <skos:altLabel xml:lang="en">Rivalry</skos:altLabel>
        <skos:definition xml:lang="en">A characteristic of a good in which one person&apos;s consumption of it reduces the quantity available for others.</skos:definition>
        <skos:prefLabel xml:lang="en">Rivalrous Consumption</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/public-good"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/common-pool-resources"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
