    <!-- https://healtheconomics.wiki/concept/complete-remission -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/complete-remission">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/remission"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/remission"/>
        <skos:notation>HE-PE-OO-006</skos:notation>
        <dcterms:identifier>HE-PE-OO-006</dcterms:identifier>
        <dcterms:source>DeVita, Lawrence &amp; Rosenberg 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Complete Remission</rdfs:label>
        <skos:definition xml:lang="en">A cancer treatment outcome in which all detectable signs of disease have disappeared, though undetectable cells may still remain.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Disease Clearance</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Full Remission</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Complete Remission</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/partial-remission"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
