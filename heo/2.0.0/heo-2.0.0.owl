    <!-- https://healtheconomics.wiki/concept/seamless-trial-design -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/seamless-trial-design">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/adaptive-trial-design"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/adaptive-trial-design"/>
        <skos:notation>HE-PE-DD-067</skos:notation>
        <dcterms:identifier>HE-PE-DD-067</dcterms:identifier>
        <dcterms:source>Chow &amp; Chang 2008</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Seamless Trial Design</rdfs:label>
        <skos:definition xml:lang="en">An adaptive design combining traditionally separate phase II and III trials into one continuous study, avoiding an intervening design and startup gap.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Inferentially Seamless Design</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Seamless Phase 2/3 Design</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Seamless Trial Design</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/time-to-market"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/interim-analysis"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/seamless-trial-design"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/adaptive-trial-design"/>
        <dcterms:identifier>HEO-L-5f8f12565cbe</dcterms:identifier>
        <linkRationale xml:lang="en">A seamless phase II/III design is a prespecified adaptive design.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
