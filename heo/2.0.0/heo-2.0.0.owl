        <dcterms:identifier>HEO-L-1be79095ced4</dcterms:identifier>
        <linkRationale xml:lang="en">Retrospective and concurrent queries are opposite timings.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
