        <owl:versionInfo>1.5.5</owl:versionInfo>
        <skos:altLabel xml:lang="en">HTA</skos:altLabel>
        <skos:definition xml:lang="en">Health technology assessment (HTA) evaluates the clinical, economic, social and ethical effects of a drug, test, device or procedure to guide its use.</skos:definition>
        <skos:editorialNote xml:lang="en">In HEO this concept is the wiki subdomain Health Technology Assessment, directly under Health Economics. Concepts in that subdomain with no is-type-of parent are classified under it or under a concept within it.</skos:editorialNote>
        <skos:hiddenLabel xml:lang="en">Technology Assessment</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Technology Evaluation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Health Technology Assessment</skos:prefLabel>
        <abbreviation xml:lang="en">HTA</abbreviation>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/technological-imperative"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-technology-assessment#step-1"/>
