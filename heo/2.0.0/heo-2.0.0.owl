    <!-- https://healtheconomics.wiki/concept/trade-off -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/trade-off">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-principle"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-principle"/>
        <skos:notation>HE-EE-EPR-049</skos:notation>
        <dcterms:identifier>HE-EE-EPR-049</dcterms:identifier>
        <dcterms:source>Varian 2014</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Trade-off</rdfs:label>
        <skos:altLabel xml:lang="en">Tradeoff</skos:altLabel>
        <skos:definition xml:lang="en">A situation in which achieving more of one objective requires accepting less of another, such as extra health benefit only at extra cost.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Competing-Objective Balance</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Trade-off</skos:prefLabel>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/opportunity-cost"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
