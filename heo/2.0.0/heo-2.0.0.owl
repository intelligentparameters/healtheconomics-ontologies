        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Marginal Benefit</rdfs:label>
        <skos:definition xml:lang="en">The additional benefit gained from one more unit of a good, service, or activity.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Benefit at the Margin</skos:hiddenLabel>
