        <dcterms:identifier>HEO-L-17ed03684fd4</dcterms:identifier>
        <linkRationale xml:lang="en">Consent to care versus consent to research participation</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/consequentiality -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/consequentiality">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:notation>HE-EE-CBA-011</skos:notation>
        <dcterms:identifier>HE-EE-CBA-011</dcterms:identifier>
        <dcterms:source>Carson &amp; Groves 2007</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Consequentiality</rdfs:label>
        <skos:definition xml:lang="en">The extent to which respondents in a stated preference survey believe their answers could influence a real policy or funding outcome.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Perceived Policy Influence</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Response Consequence Belief</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Consequentiality</skos:prefLabel>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/stated-preference"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/hypothetical-bias"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/consequentiality"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-3285eef07770</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Cost-Benefit Analysis: the unplaced concepts here are stated preference terms; the wiki&apos;s topic Stated preference and monetary valuation sits in Outcomes</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/consequentiality"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isPropertyOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/stated-preference"/>
        <dcterms:identifier>HEO-L-6f6b372d2c48</dcterms:identifier>
        <linkRationale xml:lang="en">A characteristic of a stated preference survey as perceived by respondents</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/consequentiality"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/hypothetical-bias"/>
        <dcterms:identifier>HEO-L-4bb2fb9bdd7b</dcterms:identifier>
        <linkRationale xml:lang="en">Belief that answers are consequential lowers hypothetical bias (incentive compatibility); they are not opposing concepts</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/consistency -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/consistency">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-ES-ESM-008</skos:notation>
        <dcterms:identifier>HE-ES-ESM-008</dcterms:identifier>
        <dcterms:source>Dias et al. 2013</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Consistency</rdfs:label>
        <skos:altLabel xml:lang="en">Network Coherence</skos:altLabel>
        <skos:definition xml:lang="en">Within network meta-analysis, the property that direct and indirect evidence for the same treatment pair agree with one another.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Direct-Indirect Agreement</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Consistency</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/inconsistency"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/consistency"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-18e5bc01765a</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Evidence Synthesis Methods: catalogue subdomain Evidence Synthesis is one of the subdomains</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/consistency"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/inconsistency"/>
        <dcterms:identifier>HEO-L-23ce62cca071</dcterms:identifier>
        <linkRationale xml:lang="en">Inconsistency is disagreement between direct and indirect evidence; consistency is their agreement (both definitions)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


