    <!-- https://healtheconomics.wiki/concept/nash-equilibrium-health -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/nash-equilibrium-health">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
