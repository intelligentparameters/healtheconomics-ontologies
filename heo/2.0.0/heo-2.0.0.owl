    <!-- https://healtheconomics.wiki/concept/delta-adjustment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/delta-adjustment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/sensitivity-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/sensitivity-analysis"/>
        <skos:notation>HE-ES-SA-045</skos:notation>
        <dcterms:identifier>HE-ES-SA-045</dcterms:identifier>
        <dcterms:source>Carpenter &amp; Kenward 2013</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Delta Adjustment</rdfs:label>
        <skos:definition xml:lang="en">A sensitivity analysis technique shifting the assumed outcome for patients with missing trial data by a specified amount to test conclusions&apos; robustness.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Delta Imputation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Delta Sensitivity Analysis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Delta Adjustment</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/missing-data"/>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/intention-to-treat-analysis"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
