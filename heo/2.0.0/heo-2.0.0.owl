        <skos:notation>HE-ES-RWE-009</skos:notation>
        <dcterms:identifier>HE-ES-RWE-009</dcterms:identifier>
        <dcterms:source>Edwards &amp; Aronson 2000</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Post-Marketing Surveillance</rdfs:label>
        <skos:altLabel xml:lang="en">Post-Market Monitoring</skos:altLabel>
        <skos:definition xml:lang="en">The ongoing monitoring of a drug&apos;s safety and effectiveness after regulatory approval, capturing information not always evident from pre-approval trials.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Ongoing Market Watch</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Phase IV Surveillance</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Post-Approval Monitoring</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Post-Launch Monitoring</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Post-Marketing Surveillance</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/safety-profile"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/technology-withdrawal"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/real-world-evidence"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/safety-evidence"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/safety-signal"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/post-marketing-surveillance"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/real-world-evidence"/>
