    <!-- https://healtheconomics.wiki/concept/prediction-interval -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/prediction-interval">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:notation>HE-ES-SA-163</skos:notation>
        <dcterms:identifier>HE-ES-SA-163</dcterms:identifier>
        <dcterms:source>Casella G, Berger RL. Statistical Inference. 2nd ed. Duxbury; 2002.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Prediction Interval</rdfs:label>
        <skos:altLabel xml:lang="en">Forecast Interval</skos:altLabel>
        <skos:definition xml:lang="en">A range calculated to contain a future individual observation with a specified confidence, unlike a confidence interval describing a population parameter.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Predictive Range</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Prediction Interval</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/confidence-interval"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/prediction-interval"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
