    <!-- https://healtheconomics.wiki/concept/efficient-design -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/efficient-design">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/experimental-design"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/experimental-design"/>
        <skos:notation>HE-EE-CBA-017</skos:notation>
        <dcterms:identifier>HE-EE-CBA-017</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Huber &amp; Zwerina 1996</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Efficient Design</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">An experimental design built to maximise the statistical information obtained from a given number of choice tasks.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Information-Maximising Design</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Optimal Choice-Task Design</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Efficient Design</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/orthogonal-design"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/outcomes#step-4"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/efficient-design"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/experimental-design"/>
        <dcterms:identifier>HEO-L-739b3b92b956</dcterms:identifier>
        <linkRationale xml:lang="en">An efficient design is one way of planning a choice experiment, matching Orthogonal Design isTypeOf Experimental Design</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/efficient-design"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/orthogonal-design"/>
        <dcterms:identifier>HEO-L-e16dc90adc8c</dcterms:identifier>
        <linkRationale xml:lang="en">Efficient and orthogonal designs are the two alternative strategies for building choice-experiment designs</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
