    <!-- https://healtheconomics.wiki/concept/charity-care -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/charity-care">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/uncompensated-care"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q5074539"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/uncompensated-care"/>
