        <dcterms:identifier>HE-EE-ME-072</dcterms:identifier>
        <dcterms:source>Evans 1974</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Target Income Hypothesis</rdfs:label>
        <skos:altLabel xml:lang="en">Target Income Theory</skos:altLabel>
        <skos:definition xml:lang="en">A theory that physicians facing a fee cut may respond by increasing service volume to maintain their targeted earnings, rather than accepting lower income.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Income-Targeting Hypothesis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Target Income Hypothesis</skos:prefLabel>
        <assumes rdf:resource="https://healtheconomics.wiki/concept/fee-for-service"/>
        <explains rdf:resource="https://healtheconomics.wiki/concept/supplier-induced-demand"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/target-income-hypothesis"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-6f7186057be8</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Market Economics: demand, supply, agency and moral hazard describe how health care markets are organised and paid for</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/target-income-hypothesis"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#assumes"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/fee-for-service"/>
        <dcterms:identifier>HEO-L-7a04b8528d55</dcterms:identifier>
        <linkRationale xml:lang="en">Real theory of physician behaviour; it only bites where income rises with service volume, i.e. fee-for-service.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/target-income-hypothesis"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#explains"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/supplier-induced-demand"/>
        <dcterms:identifier>HEO-L-2310931bc05c</dcterms:identifier>
        <linkRationale xml:lang="en">The target income hypothesis is a standard explanation of supplier-induced demand.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/target-population -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/target-population">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
