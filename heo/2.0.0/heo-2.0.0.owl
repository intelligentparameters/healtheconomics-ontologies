        <rdfs:label xml:lang="en">Appropriate Care</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Appropriate care is care whose expected benefit exceeds its harms by a clear margin, avoiding overuse and underuse that reduce health system efficiency.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Appropriate Treatment</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Evidence-Concordant Care</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Appropriate Care</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/low-value-care"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/overutilization"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/underuse"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/allocative-efficiency"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/appropriate-care"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-57345411a568</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Performance productivity and quality in subdomain Health Systems</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/appropriate-care"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
