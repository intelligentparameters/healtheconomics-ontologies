    <!-- https://healtheconomics.wiki/concept/individual-funding-request -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/individual-funding-request">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
