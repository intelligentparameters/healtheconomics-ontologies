    <!-- https://healtheconomics.wiki/concept/aggregate-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/aggregate-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/simulation-model"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/simulation-model"/>
        <skos:notation>HE-EM-DM-001</skos:notation>
        <dcterms:identifier>HE-EM-DM-001</dcterms:identifier>
        <dcterms:source>Briggs A, Claxton K, Sculpher M. Decision Modelling for Health Economic Evaluation. Oxford University Press; 2006. doi:10.1093/oso/9780198526629.001.0001.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Aggregate Model</rdfs:label>
        <skos:definition xml:lang="en">A model representing a population using summary-level parameters, such as average transition probabilities, rather than tracking individual patients separately.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Population-Summary Model</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Summary-Parameter Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Aggregate Model</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/aggregate-model"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/simulation-model"/>
        <dcterms:identifier>HEO-L-967cff971331</dcterms:identifier>
        <linkRationale xml:lang="en">An aggregate model is a kind of simulation model; replaces a two-way type-of loop with Cohort Model</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/aggregate-stop-loss -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/aggregate-stop-loss">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/stop-loss"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/stop-loss"/>
        <skos:notation>HS-HP-HI-006</skos:notation>
        <dcterms:identifier>HS-HP-HI-006</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563?643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Aggregate Stop-Loss</rdfs:label>
        <owl:versionInfo>1.0.3</owl:versionInfo>
        <skos:definition xml:lang="en">Aggregate stop-loss is insurance that reimburses a self-funded employer for total health claims above an agreed attachment point in a plan year.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Aggregate Claims Cover</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Aggregate Excess Cover</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Aggregate Stop-Loss</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/specific-stop-loss"/>
        <counterpartOf rdf:resource="https://healtheconomics.wiki/concept/reinsurance"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/aggregate-stop-loss"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/stop-loss"/>
        <dcterms:identifier>HEO-L-659904b657f9</dcterms:identifier>
        <linkRationale xml:lang="en">It reimburses aggregate claims above an attachment point</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/aggregate-stop-loss"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/specific-stop-loss"/>
