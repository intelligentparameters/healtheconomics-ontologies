    <!-- https://healtheconomics.wiki/concept/continuity-design -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/continuity-design">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/benefit-design"/>
        <skos:notation>HS-HP-HI-046</skos:notation>
        <dcterms:identifier>HS-HP-HI-046</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Continuity Design</rdfs:label>
        <skos:definition xml:lang="en">Provisions within an insurance plan intended to ensure enrollees maintain uninterrupted coverage and access to existing providers when transitioning between plans.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Coverage Continuity Provisions</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Transition Protection</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Continuity Design</skos:prefLabel>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/continuity-of-care"/>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/continuous-coverage"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/continuity-design"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-6d775e0076a9</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health Insurance: wiki topic Health financing and insurance sits in Health Systems; placed under Health Insurance, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/continuity-design"/>
