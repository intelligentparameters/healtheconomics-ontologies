    <!-- https://healtheconomics.wiki/concept/number-needed-to-harm -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/number-needed-to-harm">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/absolute-measure"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q7069573"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/absolute-measure"/>
        <skos:notation>HE-ES-RM-016</skos:notation>
        <dcterms:identifier>HE-ES-RM-016</dcterms:identifier>
        <dcterms:source>Cook &amp; Sackett 1995</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Number Needed to Harm</rdfs:label>
        <skos:altLabel xml:lang="en">NNH</skos:altLabel>
        <skos:definition xml:lang="en">The number of patients who would need exposure to a treatment or risk factor for one additional patient to experience an adverse outcome.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Harm Number</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Number Needed to Harm</skos:prefLabel>
        <abbreviation xml:lang="en">NNH</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/number-needed-to-treat"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-2"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/number-needed-to-harm"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/absolute-measure"/>
        <dcterms:identifier>HEO-L-29a9ef5966a4</dcterms:identifier>
        <linkRationale xml:lang="en">NNH is the reciprocal of an absolute risk increase, an effect measure, not an outcome instrument</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/number-needed-to-harm"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/number-needed-to-treat"/>
        <dcterms:identifier>HEO-L-0586a6b21418</dcterms:identifier>
