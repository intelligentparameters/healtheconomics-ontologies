    <!-- https://healtheconomics.wiki/concept/primary-prevention -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/primary-prevention">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/preventive-intervention"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q10353754"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/preventive-intervention"/>
        <skos:notation>HE-PE-CVP-002</skos:notation>
        <dcterms:identifier>HE-PE-CVP-002</dcterms:identifier>
        <dcterms:source>Last 2001</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Primary Prevention</rdfs:label>
        <skos:definition xml:lang="en">Preventive intervention aimed at stopping disease onset in people who have not yet developed it, unlike secondary prevention&apos;s early detection focus.</skos:definition>
        <skos:hiddenLabel xml:lang="en">First-Level Prevention</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Risk-Factor Prevention</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Primary Prevention</skos:prefLabel>
