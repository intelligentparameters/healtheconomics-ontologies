    <!-- https://healtheconomics.wiki/concept/late-effects -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/late-effects">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome"/>
        <skos:notation>HE-PE-OO-011</skos:notation>
        <dcterms:identifier>HE-PE-OO-011</dcterms:identifier>
        <dcterms:source>DeVita, Lawrence &amp; Rosenberg 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Late Effects</rdfs:label>
        <skos:altLabel xml:lang="en">Long-Term Sequelae</skos:altLabel>
        <skos:definition xml:lang="en">Health problems arising months or years after cancer treatment ends, resulting from the lasting impact of the disease or its treatment.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Delayed Treatment Effects</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Late Effects</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/late-effects"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
