    <!-- https://healtheconomics.wiki/concept/human-subjects-protection -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/human-subjects-protection">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/research-ethics"/>
        <skos:notation>HS-HP-HSG-015</skos:notation>
        <dcterms:identifier>HS-HP-HSG-015</dcterms:identifier>
        <dcterms:source>HHS, Common Rule (45 CFR 46)</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Human Subjects Protection</rdfs:label>
        <skos:altLabel xml:lang="en">Human Participant Protection</skos:altLabel>
        <skos:altLabel xml:lang="en">Research Participant Protection</skos:altLabel>
        <skos:definition xml:lang="en">The comprehensive set of ethical principles and oversight mechanisms designed to safeguard the rights, safety, and wellbeing of research participants.</skos:definition>
        <skos:prefLabel xml:lang="en">Human Subjects Protection</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/coercion"/>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/undue-inducement"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/human-subjects-protection"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
