    <!-- https://healtheconomics.wiki/concept/cost-effectiveness-frontier -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cost-effectiveness-frontier">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-plane"/>
        <skos:notation>HE-EE-CEA-013</skos:notation>
        <dcterms:identifier>HE-EE-CEA-013</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</dcterms:modified>
        <dcterms:source>Suen &amp; Goldhaber-Fiebert 2016</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cost-Effectiveness Frontier</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">CE Frontier</skos:altLabel>
        <skos:altLabel xml:lang="en">Efficient Frontier in Cost-Effectiveness Analysis</skos:altLabel>
        <skos:definition xml:lang="en">The cost-effectiveness frontier joins the strategies not ruled out by strict or extended dominance on a plot of expected cost against health effect.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cost-Effectiveness Efficiency Frontier</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cost-Effectiveness Frontier</skos:prefLabel>
        <abbreviation xml:lang="en">CE Frontier</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/ceaf"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/decision-rule"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-frontier"/>
