        <dcterms:identifier>HEO-L-ec888b68bf63</dcterms:identifier>
        <linkRationale xml:lang="en">A chart is not an improvement approach; ranking problem categories is an input to choosing improvement targets</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/pareto-efficiency -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/pareto-efficiency">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/efficiency"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q36829"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/efficiency"/>
        <skos:notation>HE-EE_EA-038</skos:notation>
        <dcterms:identifier>HE-EE_EA-038</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-03</dcterms:modified>
        <dcterms:source>Brouwer et al. 2008</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Pareto Efficiency</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Pareto Optimality</skos:altLabel>
        <skos:definition xml:lang="en">Pareto efficiency, or Pareto optimality, is a state where resources such as a health budget cannot be reallocated to help anyone without harming someone.</skos:definition>
        <skos:prefLabel xml:lang="en">Pareto Efficiency</skos:prefLabel>
        <benchmarkFor rdf:resource="https://healtheconomics.wiki/concept/market-failure"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/allocative-efficiency"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/pareto-frontier"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/welfare-theorem"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/pareto-efficiency"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/efficiency"/>
        <dcterms:identifier>HEO-L-9e0681f44c91</dcterms:identifier>
        <linkRationale xml:lang="en">Pareto efficiency is a form of efficiency</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/pareto-efficiency"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#benchmarkFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/market-failure"/>
        <dcterms:identifier>HEO-L-2843f1e9d9dc</dcterms:identifier>
        <linkRationale xml:lang="en">Market failure is defined as departure from efficient allocation, judged against Pareto efficiency</linkRationale>
