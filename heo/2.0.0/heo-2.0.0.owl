    <!-- https://healtheconomics.wiki/concept/dependent-censoring -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/dependent-censoring">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/censoring"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/censoring"/>
        <skos:notation>HE-ES-CTM-026</skos:notation>
        <dcterms:identifier>HE-ES-CTM-026</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-02</dcterms:modified>
        <dcterms:source>Latimer &amp; Abrams 2014</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Dependent Censoring</rdfs:label>
        <owl:versionInfo>1.0.3</owl:versionInfo>
        <skos:altLabel xml:lang="en">Informative Censoring</skos:altLabel>
        <skos:altLabel xml:lang="en">Non-Ignorable Censoring</skos:altLabel>
        <skos:definition xml:lang="en">Dependent censoring occurs when the chance of being censored is linked to a patient&apos;s risk of the event, so standard survival estimates can be biased.</skos:definition>
        <skos:prefLabel xml:lang="en">Dependent Censoring</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/independent-censoring"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/selection-bias"/>
        <counterpartOf rdf:resource="https://healtheconomics.wiki/concept/missing-not-at-random"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/dependent-censoring"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/censoring"/>
        <dcterms:identifier>HEO-L-8e4cb8048b11</dcterms:identifier>
        <linkRationale xml:lang="en">A form of censoring</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
