        <dcterms:identifier>HEO-L-15d500c76fc5</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: the wiki subdomain Costs (https://healtheconomics.wiki/subdomain/costs)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/costs"/>
