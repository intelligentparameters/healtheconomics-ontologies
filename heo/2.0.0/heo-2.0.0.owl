    <!-- https://healtheconomics.wiki/concept/time-homogeneous-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/time-homogeneous-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/markov-model"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/markov-model"/>
        <skos:notation>HE-EM-MM-023</skos:notation>
        <dcterms:identifier>HE-EM-MM-023</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Sonnenberg FA, Beck JR. Markov models in medical decision making: a practical guide. Medical Decision Making. 1993;13(4):322?338. doi:10.1177/0272989X9301300409.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Time-Homogeneous Model</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Stationary Markov Model</skos:altLabel>
        <skos:definition xml:lang="en">A Markov model in which transition probabilities remain constant throughout the entire modelled time horizon, regardless of how many cycles have passed.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Time-Constant Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Time-Homogeneous Model</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/time-inhomogeneous-model"/>
