        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Data Timeliness</rdfs:label>
        <skos:altLabel xml:lang="en">Data Currency</skos:altLabel>
        <skos:definition xml:lang="en">The degree to which a dataset reflects current, rather than outdated, conditions, practices, or populations.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Data Recency</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Data Timeliness</skos:prefLabel>
