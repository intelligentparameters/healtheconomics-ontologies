    <!-- https://healtheconomics.wiki/concept/process-quality -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/process-quality">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <skos:notation>HS-HP-HQ-034</skos:notation>
        <dcterms:identifier>HS-HP-HQ-034</dcterms:identifier>
        <dcterms:source>Donabedian A. Evaluating the quality of medical care. Milbank Memorial Fund Quarterly. 1966;44(3):166-206. doi:10.2307/3348969.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Process Quality</rdfs:label>
        <skos:definition xml:lang="en">A healthcare quality dimension focused on whether appropriate, evidence-based care processes were followed, unlike outcomes achieved or structural resources.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Delivery Quality</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Process Dimension of Care</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Process Quality</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/structural-quality"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/process-quality"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <dcterms:identifier>HEO-L-43d21310945c</dcterms:identifier>
        <linkRationale xml:lang="en">Process quality is a dimension of quality of care.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/process-quality"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/structural-quality"/>
        <dcterms:identifier>HEO-L-0e459f23144d</dcterms:identifier>
        <linkRationale xml:lang="en">Donabedian dimensions: process versus structure.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
