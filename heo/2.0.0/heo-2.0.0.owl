    <!-- https://healtheconomics.wiki/concept/capacity-management -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/capacity-management">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/resource-management"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
