    <!-- https://healtheconomics.wiki/concept/evidence-grading -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/evidence-grading">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/critical-appraisal"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/critical-appraisal"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-ES-EA-017</skos:notation>
        <dcterms:identifier>HE-ES-EA-017</dcterms:identifier>
        <dcterms:source>Guyatt GH, Oxman AD, Vist GE, et al. GRADE: an emerging consensus on rating quality of evidence and strength of recommendations. BMJ. 2008;336:924-926. doi:10.1136/bmj.39489.470347.AD.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Evidence Grading</rdfs:label>
        <skos:definition xml:lang="en">The formal process of classifying the quality or certainty of a body of research evidence into defined categories, such as high or low.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Certainty Grading</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Evidence Quality Grading</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Evidence Rating</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Evidence Grading</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/strong-recommendation"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/weak-recommendation"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/certainty-of-evidence"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/quality-of-evidence"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/strength-of-evidence"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/level-of-evidence"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/evidence-grading"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/critical-appraisal"/>
        <dcterms:identifier>HEO-L-e7b6eb2ac8f9</dcterms:identifier>
        <linkRationale xml:lang="en">Grading certainty is appraisal of a body of evidence</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/evidence-grading"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:identifier>HEO-L-65e95b2f7cce</dcterms:identifier>
