    <!-- https://healtheconomics.wiki/concept/preference-elicitation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/preference-elicitation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/primary-research"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/primary-research"/>
        <skos:notation>HE-EE-HU-099</skos:notation>
        <dcterms:identifier>HE-EE-HU-099</dcterms:identifier>
        <dcterms:source>Brazier et al. 2017</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Preference Elicitation</rdfs:label>
        <skos:definition xml:lang="en">Preference elicitation measures what people value in health care from stated or revealed choices, yielding QALY weights, money values or risk trade-offs.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Elicitation of Preferences</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Preference Measurement</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Preference Elicitation</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/expert-elicitation"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/benefit-risk-assessment"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/preference-weight"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/preference-elicitation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/primary-research"/>
        <dcterms:identifier>HEO-L-ead8b2ecf6f7</dcterms:identifier>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/preference-elicitation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
