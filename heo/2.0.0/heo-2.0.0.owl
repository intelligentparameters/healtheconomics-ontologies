    <!-- https://healtheconomics.wiki/concept/confidentiality -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/confidentiality">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/professional-ethics"/>
        <skos:notation>HS-HP-DH-007</skos:notation>
        <dcterms:identifier>HS-HP-DH-007</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>GMC 2017</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Confidentiality</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Confidentiality is the ethical and legal duty to protect identifiable patient information from disclosure unless there is consent or another lawful basis.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Information Privacy Duty</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Patient Privacy Duty</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Confidentiality</skos:prefLabel>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/confidentiality"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-de450234fa2c</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Digital Health: health information systems are one of the WHO health system building blocks</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/confidentiality"/>
