    <!-- https://healtheconomics.wiki/concept/non-response-error -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/non-response-error">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/non-sampling-error"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/selection-bias"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/non-sampling-error"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/selection-bias"/>
        <skos:notation>HE-DS-BV-020</skos:notation>
        <dcterms:identifier>HE-DS-BV-020</dcterms:identifier>
        <dcterms:source>Groves et al. 2009</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Non-Response Error</rdfs:label>
        <skos:altLabel xml:lang="en">Non-Response Bias</skos:altLabel>
        <skos:definition xml:lang="en">A survey error arising when selected participants fail to respond, and respondents differ systematically from non-respondents, potentially biasing the results.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Unit Non-Response</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Non-Response Error</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/random-sampling"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/non-response-error"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/non-sampling-error"/>
        <dcterms:identifier>HEO-L-899456d475d6</dcterms:identifier>
        <linkRationale xml:lang="en">Object definition names non-response error</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/non-response-error"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/selection-bias"/>
        <dcterms:identifier>HEO-L-06fb27ff3d9c</dcterms:identifier>
        <linkRationale xml:lang="en">Non-response bias is a form of selection bias</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/non-response-error"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#threatensValidityOf"/>
