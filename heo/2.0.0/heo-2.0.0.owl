        <abbreviation xml:lang="en">LOS Review</abbreviation>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/length-of-stay"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/length-of-stay-management"/>
