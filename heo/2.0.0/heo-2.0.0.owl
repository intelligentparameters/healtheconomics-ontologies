    <!-- https://healtheconomics.wiki/concept/balance-billing-protection -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/balance-billing-protection">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/regulation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/regulation"/>
        <skos:notation>HS-HP-HI-018</skos:notation>
        <dcterms:identifier>HS-HP-HI-018</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>US, No Surprises Act (Public Law 116-260, Division BB, Title I); 45 CFR Part 149</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Balance Billing Protection</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Balance billing protection is a legal rule that stops providers billing insured patients above in-network cost sharing, as under the US No Surprises Act.</skos:definition>
        <skos:hiddenLabel xml:lang="en">No-Balance-Bill Rule</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Surprise-Billing Protection</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Balance Billing Protection</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/financial-protection"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/balance-billing"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/surprise-billing"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/balance-billing-protection"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/regulation"/>
        <dcterms:identifier>HEO-L-d153baec7b5d</dcterms:identifier>
        <linkRationale xml:lang="en">A current legal rule (US No Surprises Act, in force from 2022)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
