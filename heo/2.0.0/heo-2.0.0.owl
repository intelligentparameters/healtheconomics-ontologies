    <!-- https://healtheconomics.wiki/concept/inelastic-demand -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/inelastic-demand">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <skos:notation>HE-EE-ME-029</skos:notation>
        <dcterms:identifier>HE-EE-ME-029</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Varian 2014</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Inelastic Demand</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A condition in which quantity demanded changes proportionally less than a given price change, indicating consumers are relatively insensitive to price.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Price-Insensitive Demand</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Unresponsive Demand</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Inelastic Demand</skos:prefLabel>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/demand"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/inelastic-demand"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-8f43e0d77dfd</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Demand supply and markets in subdomain Economic Foundations</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/inelastic-demand"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isPropertyOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/demand"/>
        <dcterms:identifier>HEO-L-f1aa734bd643</dcterms:identifier>
        <linkRationale xml:lang="en">Inelasticity is a characteristic of a demand schedule, not a kind of elasticity measure</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
