    <!-- https://healtheconomics.wiki/concept/addiction-treatment-economics -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/addiction-treatment-economics">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
