    <!-- https://healtheconomics.wiki/concept/quartile -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/quartile">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/percentile"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q2786686"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/percentile"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/interquartile-range"/>
        <skos:notation>HE-ES-SA-171</skos:notation>
        <dcterms:identifier>HE-ES-SA-171</dcterms:identifier>
        <dcterms:source>Casella G, Berger RL. Statistical Inference. 2nd ed. Duxbury; 2002.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Quartile</rdfs:label>
        <skos:definition xml:lang="en">A descriptive statistic dividing a ranked dataset into four equal-sized groups, marking the twenty-fifth, fiftieth, and seventy-fifth percentiles.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Four-Part Split</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Quarter Division</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Quartile</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/quartile"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/percentile"/>
        <dcterms:identifier>HEO-L-190d64374c12</dcterms:identifier>
        <linkRationale xml:lang="en">A quartile is a specific percentile.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/quartile"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/interquartile-range"/>
        <dcterms:identifier>HEO-L-e4bc6d2793ee</dcterms:identifier>
        <linkRationale xml:lang="en">IQR is the 75th minus the 25th percentile, i.e. Q3 minus Q1</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/quasi-experimental-design -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/quasi-experimental-design">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/study-design"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/study-design"/>
        <skos:notation>HE-ES-CTM-074</skos:notation>
        <dcterms:identifier>HE-ES-CTM-074</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Shadish, Cook &amp; Campbell 2002</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Quasi-Experimental Design</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Quasi-Experiment</skos:altLabel>
        <skos:definition xml:lang="en">A research design estimating an intervention&apos;s causal effect without random assignment, instead using features such as a natural experiment or matched comparison group.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Non-Randomised Design</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Quasi-Experimental Design</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/randomised-controlled-trial"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/quasi-experimental-design"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/study-design"/>
        <dcterms:identifier>HEO-L-7be1fb2bdbe4</dcterms:identifier>
        <linkRationale xml:lang="en">A quasi-experimental design is a study design.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/quasi-experimental-design"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/randomised-controlled-trial"/>
        <dcterms:identifier>HEO-L-859202c349a1</dcterms:identifier>
        <linkRationale xml:lang="en">Quasi-experimental designs are the alternative to randomisation.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/quaternary-care -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/quaternary-care">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/levels-of-care"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/levels-of-care"/>
        <skos:notation>HS-HP-HD-093</skos:notation>
        <dcterms:identifier>HS-HP-HD-093</dcterms:identifier>
        <dcterms:source>AHA, American Hospital Association</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Quaternary Care</rdfs:label>
        <skos:definition xml:lang="en">The most highly specialised care level, involving advanced or experimental procedures typically available only at a few specialised centres.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Advanced Tertiary Care</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Highly Specialised Care</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Quaternary Care</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/tertiary-care"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/quaternary-care"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/levels-of-care"/>
        <dcterms:identifier>HEO-L-dcd426fabde3</dcterms:identifier>
        <linkRationale xml:lang="en">Quaternary care is one of the levels of care.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/quaternary-care"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/tertiary-care"/>
        <dcterms:identifier>HEO-L-8908d1f58daa</dcterms:identifier>
        <linkRationale xml:lang="en">Quaternary and tertiary are adjacent alternative care levels.</linkRationale>
