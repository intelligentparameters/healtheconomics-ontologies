    <!-- https://healtheconomics.wiki/concept/surrogate-endpoint -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/surrogate-endpoint">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q2368661"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/treatment-effect"/>
        <skos:notation>HE-ES-CTM-093</skos:notation>
        <dcterms:identifier>HE-ES-CTM-093</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Prentice 1989</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Surrogate Endpoint</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Surrogate Outcome</skos:altLabel>
        <skos:definition xml:lang="en">A trial outcome used as a substitute for a direct clinical benefit measure, such as survival, based on its expected predictive relationship to that outcome.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Surrogate Marker</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Surrogate Endpoint</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/clinical-endpoint"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-1"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/surrogate-evidence"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/biomarker"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/surrogate-endpoint"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
