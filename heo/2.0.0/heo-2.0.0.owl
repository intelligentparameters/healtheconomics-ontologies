        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/risk-factor"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/determinant-of-health"/>
        <dcterms:identifier>HEO-L-dcbe6f195167</dcterms:identifier>
        <linkRationale xml:lang="en">Risk factors are factors that influence health.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
