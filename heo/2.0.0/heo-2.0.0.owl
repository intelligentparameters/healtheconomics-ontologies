    <!-- https://healtheconomics.wiki/concept/patient-preference -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/patient-preference">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q67168266"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:notation>HE-ES-PRO-018</skos:notation>
        <dcterms:identifier>HE-ES-PRO-018</dcterms:identifier>
        <dcterms:source>Louviere, Hensher &amp; Swait 2000</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Patient Preference</rdfs:label>
        <skos:definition xml:lang="en">An individual patient&apos;s relative valuation of different treatment attributes or health outcomes, often elicited through methods such as a discrete choice experiment.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Patient Values</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Stated Treatment Preference</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Patient Preference</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/shared-decision-making"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/patient-preference"/>
