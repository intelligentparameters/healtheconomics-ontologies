        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/standard-gamble"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/time-trade-off"/>
