    <!-- https://healtheconomics.wiki/concept/risk-difference -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/risk-difference">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/absolute-measure"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/absolute-measure"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/number-needed-to-treat"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/population-attributable-risk"/>
        <skos:notation>HE-ES-RM-037</skos:notation>
        <dcterms:identifier>HE-ES-RM-037</dcterms:identifier>
        <dcterms:source>Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams &amp; Wilkins; 2008.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Risk Difference</rdfs:label>
        <skos:altLabel xml:lang="en">Absolute Difference in Risk</skos:altLabel>
        <skos:definition xml:lang="en">The absolute difference between the risk of an outcome in one group and in another, the excess or reduced risk from an exposure.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Between-Group Risk Gap</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Risk Difference</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/risk-ratio"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-2"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/risk-difference"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/absolute-measure"/>
        <dcterms:identifier>HEO-L-586afa6c7e6e</dcterms:identifier>
        <linkRationale xml:lang="en">Risk difference is an absolute effect measure.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
