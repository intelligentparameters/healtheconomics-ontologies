    <!-- https://healtheconomics.wiki/concept/all-inclusive-rate -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/all-inclusive-rate">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/bundled-payment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/bundled-payment"/>
        <skos:notation>HS-HP-PP-004</skos:notation>
        <dcterms:identifier>HS-HP-PP-004</dcterms:identifier>
        <dcterms:source>CMS, Medicare Payment Systems</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">All-Inclusive Rate</rdfs:label>
        <skos:definition xml:lang="en">A single, comprehensive payment amount covering all services during a defined care episode, such as a per diem hospital rate.</skos:definition>
        <skos:hiddenLabel xml:lang="en">All-Inclusive Payment</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Comprehensive Episode Rate</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Global Rate</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">All-Inclusive Rate</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/unbundled-payment"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/all-inclusive-rate"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/bundled-payment"/>
        <dcterms:identifier>HEO-L-2d4786db28ab</dcterms:identifier>
        <linkRationale xml:lang="en">A single payment for all services in an episode</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/all-inclusive-rate"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/unbundled-payment"/>
