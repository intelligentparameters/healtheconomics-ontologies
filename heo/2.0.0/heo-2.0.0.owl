        <dcterms:identifier>HEO-L-ce566361cbe8</dcterms:identifier>
        <linkRationale xml:lang="en">dynamic programming is an optimisation method solved computationally</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
