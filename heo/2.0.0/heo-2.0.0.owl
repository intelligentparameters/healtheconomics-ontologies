        <dcterms:identifier>HEO-L-bd091279fb86</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Population Health Outcomes: burden, comorbidity and multimorbidity are epidemiology; most concepts with this Level 3 that the wiki places in a topic sit in Evidence Synthesis</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/multimorbidity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#riskFactorFor"/>
