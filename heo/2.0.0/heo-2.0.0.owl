    <!-- https://healtheconomics.wiki/concept/symptom-free-survival -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/symptom-free-survival">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-endpoint"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/time-to-event"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/clinical-endpoint"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/time-to-event"/>
        <skos:notation>HE-ES-CO-087</skos:notation>
        <dcterms:identifier>HE-ES-CO-087</dcterms:identifier>
        <dcterms:source>Latimer 2013</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Symptom-Free Survival</rdfs:label>
        <skos:definition xml:lang="en">A time-to-event measure defined as the time from treatment start until the onset or return of clinically significant symptoms.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Symptom-Free Interval</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Time to Symptom Onset</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Symptom-Free Survival</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/outcomes#step-1"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/symptom-free-survival"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/clinical-endpoint"/>
        <dcterms:identifier>HEO-L-3436bea7640c</dcterms:identifier>
        <linkRationale xml:lang="en">Time to symptom onset directly reflects how a patient feels, a clinical endpoint.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
