        <dcterms:identifier>HE-EE-BE-005</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Simon 1978</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Bounded Rationality Concept</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Bounded Rationality</skos:altLabel>
        <skos:definition xml:lang="en">The bounded rationality concept holds that patients, clinicians and payers with limited information, time and computation settle for good enough options.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Satisficing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Bounded Rationality Concept</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/rational-choice"/>
        <explains rdf:resource="https://healtheconomics.wiki/concept/choice-overload"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/behavioural-economics"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/behavioural-theory"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/choice-architecture-intervention"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/decision-fatigue-concept"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/heuristics-concept"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/salience-intervention"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/bounded-rationality-concept"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/behavioural-economics"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-99770ce99818</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Behavioral Economics: behavioural economics enters health economics mainly through policy design (incentives, nudges); placed under Behavioural Economics, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
