    <!-- https://healtheconomics.wiki/concept/choice-overload -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/choice-overload">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/behavioural-economics"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q2233384"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/behavioural-economics"/>
        <skos:notation>HE-EE-BE-007</skos:notation>
        <dcterms:identifier>HE-EE-BE-007</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-09</dcterms:modified>
        <dcterms:source>Chernev et al. 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Choice Overload</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Overchoice</skos:altLabel>
        <skos:definition xml:lang="en">Choice overload is the effect in which a large or complex set of options can lead people to defer a choice or regret it, as in health insurance markets.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Decision Paralysis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Choice Overload</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/default-effect-concept"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/choice-overload"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/behavioural-economics"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-832abbc65086</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Behavioral Economics: behavioural economics enters health economics mainly through policy design (incentives, nudges); placed under Behavioural Economics, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/choice-overload"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/default-effect-concept"/>
        <dcterms:identifier>HEO-L-4c90f10d104b</dcterms:identifier>
        <linkRationale xml:lang="en">Overloaded choosers defer and so stay with the default (Johnson et al. 2012)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/choice-set -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/choice-set">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/discrete-choice-experiment"/>
        <skos:notation>HE-EE-CBA-008</skos:notation>
        <dcterms:identifier>HE-EE-CBA-008</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-21</dcterms:modified>
