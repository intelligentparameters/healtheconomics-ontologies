    <!-- https://healtheconomics.wiki/concept/implied-consent -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/implied-consent">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/consent-for-treatment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/consent-for-treatment"/>
        <skos:notation>HS-HP-HD-060</skos:notation>
        <dcterms:identifier>HS-HP-HD-060</dcterms:identifier>
        <dcterms:source>Faden &amp; Beauchamp 1986</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Implied Consent</rdfs:label>
        <skos:definition xml:lang="en">Consent inferred from a patient&apos;s actions or the circumstances of care, rather than an explicit statement, such as extending an arm for blood draw.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Inferred Consent</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Tacit Consent</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Implied Consent</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/implied-consent"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/consent-for-treatment"/>
        <dcterms:identifier>HEO-L-1431bf82d9da</dcterms:identifier>
        <linkRationale xml:lang="en">Implied consent is a form of consent to treatment.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
