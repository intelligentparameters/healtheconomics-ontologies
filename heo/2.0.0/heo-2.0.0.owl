    <!-- https://healtheconomics.wiki/concept/all-cause-mortality -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/all-cause-mortality">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/mortality-rate"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q106892235"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/mortality-rate"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/background-mortality"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/life-expectancy"/>
        <skos:notation>HE-EM-MP-001</skos:notation>
        <dcterms:identifier>HE-EM-MP-001</dcterms:identifier>
