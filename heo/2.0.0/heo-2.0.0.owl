    <!-- https://healtheconomics.wiki/concept/interoperability -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/interoperability">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-HP-DH-026</skos:notation>
        <dcterms:identifier>HS-HP-DH-026</dcterms:identifier>
        <dcterms:source>Office of the National Coordinator for Health IT</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Interoperability</rdfs:label>
        <skos:definition xml:lang="en">The ability of different healthcare information systems to exchange, interpret, and use data seamlessly, without extensive manual intervention.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Data Exchange Capability</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Seamless Data Sharing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Interoperability</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/interoperability-savings"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/health-information-exchange"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/health-information-system"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/interoperability"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-319463546690</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Digital Health: health information systems are one of the WHO health system building blocks</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/interoperability"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/interoperability-savings"/>
        <dcterms:identifier>HEO-L-96abc22b94b1</dcterms:identifier>
        <linkRationale xml:lang="en">Object definition says data exchange yields the savings</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/interoperability"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isFoundationFor"/>
