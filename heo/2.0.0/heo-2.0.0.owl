    <!-- https://healtheconomics.wiki/concept/market-share -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/market-share">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/budget-impact-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/budget-impact-analysis"/>
