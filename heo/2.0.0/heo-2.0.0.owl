    <!-- https://healtheconomics.wiki/concept/ceac -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/ceac">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/ceaf"/>
        <skos:notation>HE-EE-CEA-004</skos:notation>
        <dcterms:identifier>HE-EE-CEA-004</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</dcterms:modified>
        <dcterms:source>Fenwick, Claxton &amp; Sculpher 2001</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cost-Effectiveness Acceptability Curve (CEAC)</rdfs:label>
        <owl:versionInfo>1.0.13</owl:versionInfo>
        <skos:altLabel xml:lang="en">CEAC</skos:altLabel>
        <skos:altLabel xml:lang="en">Cost-Effectiveness Acceptability Curve</skos:altLabel>
        <skos:definition xml:lang="en">A cost-effectiveness acceptability curve (CEAC) plots, across cost-effectiveness thresholds, the probability that each option is the most cost-effective.</skos:definition>
        <skos:prefLabel xml:lang="en">Cost-Effectiveness Acceptability Curve (CEAC)</skos:prefLabel>
        <abbreviation xml:lang="en">CEAC</abbreviation>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-3"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <represents rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-acceptability"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-threshold"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/net-monetary-benefit"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/psa"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/ceac"/>
