    <!-- https://healtheconomics.wiki/concept/loss-to-follow-up -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/loss-to-follow-up">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
