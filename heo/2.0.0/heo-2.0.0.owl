    <!-- https://healtheconomics.wiki/concept/mental-health-parity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/mental-health-parity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/mental-health-policy"/>
        <skos:notation>HE-PE-MH-018</skos:notation>
        <dcterms:identifier>HE-PE-MH-018</dcterms:identifier>
        <dcterms:source>US, Mental Health Parity and Addiction Equity Act</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Mental Health Parity</rdfs:label>
        <skos:definition xml:lang="en">A policy principle, and in some places a legal requirement, that insurance coverage for mental health treatment be no more restrictive than for physical health.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Behavioural Health Parity</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Parity Law</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Mental Health Parity</skos:prefLabel>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/mental-health-service-coverage"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/day-limit"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/mental-health-parity"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <dcterms:identifier>HEO-L-2a15a1065ca2</dcterms:identifier>
        <linkRationale xml:lang="en">Parity is a health policy principle</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
