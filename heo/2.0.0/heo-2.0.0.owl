    <!-- https://healtheconomics.wiki/concept/two-way-threshold-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/two-way-threshold-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/multi-way-threshold-analysis"/>
