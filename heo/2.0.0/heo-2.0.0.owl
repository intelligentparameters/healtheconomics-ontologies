        <dcterms:identifier>HS-HP-PA-007</dcterms:identifier>
        <dcterms:source>Weimer &amp; Vining 2017</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Financial Feasibility</rdfs:label>
        <skos:definition xml:lang="en">An assessment of whether a proposed policy can be adequately funded given available resources, considering both implementation and long-term fiscal cost.</skos:definition>
