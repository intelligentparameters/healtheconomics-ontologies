    <!-- https://healtheconomics.wiki/concept/warm-up-period -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/warm-up-period">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/discrete-event-simulation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/discrete-event-simulation"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/discrete-event-simulation"/>
        <skos:notation>HE-EM-DES-016</skos:notation>
        <dcterms:identifier>HE-EM-DES-016</dcterms:identifier>
        <dcterms:source>Law &amp; Kelton 2000</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Warm-Up Period</rdfs:label>
        <skos:definition xml:lang="en">An initial portion of a discrete event simulation run excluded from results, letting the system reach a representative state before data collection begins.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Burn-In Period</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Initialisation Bias Period</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Warm-Up Period</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/warm-up-period"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/discrete-event-simulation"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-35da3d6f3424</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Modelling &gt; Discrete Event Simulation: catalogue subdomain Economic Modelling is one of the subdomains; placed under Discrete Event Simulation, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/warm-up-period"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/discrete-event-simulation"/>
        <dcterms:identifier>HEO-L-07ccefa979a6</dcterms:identifier>
        <linkRationale xml:lang="en">The warm-up is an initial portion of a DES run (subject definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
