        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Special Access Scheme</rdfs:label>
        <skos:altLabel xml:lang="en">Special Access Programme</skos:altLabel>
        <skos:definition xml:lang="en">A pathway letting patients with a serious condition access a not-yet-approved treatment, typically requiring physician application and case-specific justification.</skos:definition>
