        <skos:altLabel xml:lang="en">ITS Design</skos:altLabel>
        <skos:definition xml:lang="en">A quasi-experimental design analysing observations before and after an intervention, testing for a significant change in level or trend at that point.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Segmented Time Series</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Interrupted Time Series</skos:prefLabel>
