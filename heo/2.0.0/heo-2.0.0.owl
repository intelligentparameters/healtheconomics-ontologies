    <!-- https://healtheconomics.wiki/concept/air-embolism -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/air-embolism">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/hospital-acquired-condition"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/serious-reportable-event"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/serious-safety-event"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/hospital-acquired-condition"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/serious-reportable-event"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/serious-safety-event"/>
        <skos:notation>HS-HP-MS-001</skos:notation>
        <dcterms:identifier>HS-HP-MS-001</dcterms:identifier>
        <dcterms:source>Joint Commission, Sentinel Event Policy</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Air Embolism</rdfs:label>
        <skos:definition xml:lang="en">A serious, generally preventable safety event in which air enters a patient&apos;s bloodstream, most commonly through improper intravenous line management.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Gas Embolism</skos:hiddenLabel>
