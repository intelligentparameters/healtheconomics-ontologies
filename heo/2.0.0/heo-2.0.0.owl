        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/intention-to-treat-analysis"/>
        <dcterms:identifier>HEO-L-7c0957c55341</dcterms:identifier>
        <linkRationale xml:lang="en">Per-protocol and intention-to-treat are the standard alternative trial analysis sets</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
