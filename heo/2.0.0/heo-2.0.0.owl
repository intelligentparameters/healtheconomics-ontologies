    <!-- https://healtheconomics.wiki/concept/generic-substitution -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/generic-substitution">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-substitution"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q11880067"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/drug-substitution"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/dispensing-practice"/>
        <skos:notation>HS-DC-GC-006</skos:notation>
        <dcterms:identifier>HS-DC-GC-006</dcterms:identifier>
        <dcterms:source>Danzon 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Generic Substitution</rdfs:label>
        <skos:definition xml:lang="en">The practice of dispensing a generic drug in place of a prescribed brand-name product, typically permitted once a bioequivalent version is available.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Generic Interchange</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Generic Swap</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Generic Substitution</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/generic-penetration"/>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/generic-drug"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/generic-substitution"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-substitution"/>
        <dcterms:identifier>HEO-L-bb3792065cf2</dcterms:identifier>
        <linkRationale xml:lang="en">Generic substitution is drug substitution</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
