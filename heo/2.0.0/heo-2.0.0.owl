    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/ranking-method">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-state-valuation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-state-valuation"/>
        <skos:notation>HE-EE-HU-062</skos:notation>
        <dcterms:identifier>HE-EE-HU-062</dcterms:identifier>
        <dcterms:source>Torrance GW. Measurement of health state utilities for economic appraisal. Journal of Health Economics. 1986;5(1):1-30. doi:10.1016/0167-6296(86)90020-2.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Ranking Method</rdfs:label>
        <skos:definition xml:lang="en">A health state valuation technique in which respondents order health states from most to least preferred, without indicating the size of preference differences.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Ordinal Ranking</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Rank Ordering Method</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Ranking Method</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/ranking-method"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-state-valuation"/>
        <dcterms:identifier>HEO-L-15f5a55eabbc</dcterms:identifier>
        <linkRationale xml:lang="en">Ranking is a health state valuation technique.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/rapid-assessment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/rapid-assessment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:notation>HS-HP-HTA-165</skos:notation>
        <dcterms:identifier>HS-HP-HTA-165</dcterms:identifier>
        <dcterms:source>Khangura et al. 2012</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Rapid Assessment</rdfs:label>
        <skos:altLabel xml:lang="en">Rapid HTA</skos:altLabel>
        <skos:definition xml:lang="en">An abbreviated assessment conducted under significant time constraints, streamlining methodological steps to produce timely evidence for an urgent decision.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Abbreviated Assessment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Rapid Assessment</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/coverage-decision"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/rapid-review-hta"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/rapid-assessment"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <dcterms:identifier>HEO-L-d6210b6fcbe2</dcterms:identifier>
        <linkRationale xml:lang="en">Rapid assessment is an abbreviated HTA.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/rapid-assessment"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/coverage-decision"/>
        <dcterms:identifier>HEO-L-416f2a75ee1b</dcterms:identifier>
        <linkRationale xml:lang="en">Definition: produces timely evidence for an urgent decision; the decision it feeds is a coverage decision.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/rapid-assessment"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
