    <!-- https://healtheconomics.wiki/concept/economically-justifiable-price -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/economically-justifiable-price">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/threshold-price"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/threshold-price"/>
        <skos:notation>HE-PE-PE-051</skos:notation>
        <dcterms:identifier>HE-PE-PE-051</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>York Health Economics Consortium 2016</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Economically Justifiable Price</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:altLabel xml:lang="en">EJP</skos:altLabel>
        <skos:definition xml:lang="en">The economically justifiable price (EJP) is the top price a manufacturer can defend on cost-effectiveness grounds at a given payer&apos;s threshold.</skos:definition>
        <skos:prefLabel xml:lang="en">Economically Justifiable Price</skos:prefLabel>
        <abbreviation xml:lang="en">EJP</abbreviation>
        <informs rdf:resource="https://healtheconomics.wiki/concept/price-negotiation"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/value-based-pricing"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/economically-justifiable-price"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/threshold-price"/>
        <dcterms:identifier>HEO-L-d9062a83016a</dcterms:identifier>
        <linkRationale xml:lang="en">the EJP is the threshold price at a given payer threshold</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/economically-justifiable-price"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/price-negotiation"/>
        <dcterms:identifier>HEO-L-67b23889fdd1</dcterms:identifier>
