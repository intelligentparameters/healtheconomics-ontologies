        <dcterms:identifier>HE-ES-EA-031</dcterms:identifier>
        <dcterms:source>Higgins et al. 2011</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Quality Assessment</rdfs:label>
        <skos:definition xml:lang="en">The general process of systematically evaluating a study&apos;s methodological rigour and trustworthiness, covering design, risk of bias, and reporting completeness.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Methodological Quality Review</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Study Quality Appraisal</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Quality Assessment</skos:prefLabel>
        <produces rdf:resource="https://healtheconomics.wiki/concept/quality-score"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/evaluation-standards"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/quality-assessment-model"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/quality-assessment"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/critical-appraisal"/>
        <dcterms:identifier>HEO-L-7790bb3118d8</dcterms:identifier>
        <linkRationale xml:lang="en">Quality assessment is a form of critical appraisal.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
