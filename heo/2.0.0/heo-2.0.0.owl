    <!-- https://healtheconomics.wiki/concept/quantity-limit -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/quantity-limit">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/reimbursement-restriction"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/utilisation-management"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/reimbursement-restriction"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/utilisation-management"/>
        <skos:notation>HS-HP-HI-152</skos:notation>
        <dcterms:identifier>HS-HP-HI-152</dcterms:identifier>
        <dcterms:source>Kongstvedt 2012</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Quantity Limit</rdfs:label>
        <skos:altLabel xml:lang="en">Dispensing Limit</skos:altLabel>
        <skos:altLabel xml:lang="en">QL Protocol</skos:altLabel>
        <skos:definition xml:lang="en">A restriction on the maximum amount of a specific medication or service covered within a defined period, to encourage appropriate use.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Dispensing-Limit Rule</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Dose Quantity Cap</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Quantity Limit</skos:prefLabel>
        <abbreviation xml:lang="en">QL Protocol</abbreviation>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/overutilization"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/quantity-limit"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
