        <dcterms:identifier>HE-EE-CM-004</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Average Cost Estimation</rdfs:label>
        <skos:definition xml:lang="en">The process of estimating cost per unit of service by dividing total observed cost by units delivered, without separating fixed and variable components.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Average Costing</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Mean Cost Estimation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Average Cost Estimation</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/marginal-cost-estimation"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/average-cost"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
