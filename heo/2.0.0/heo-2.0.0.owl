        <dcterms:identifier>HEO-L-5833fb86689f</dcterms:identifier>
        <linkRationale xml:lang="en">A single-item self-rating is a form of self-reported health.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
