    <!-- https://healtheconomics.wiki/concept/market-share-rebate -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/market-share-rebate">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/rebate"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
