    <!-- https://healtheconomics.wiki/concept/incomplete-treatment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/incomplete-treatment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/coping-strategy"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/non-adherence"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/coping-strategy"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/non-adherence"/>
        <skos:notation>HS-HP-HF-042</skos:notation>
        <dcterms:identifier>HS-HP-HF-042</dcterms:identifier>
        <dcterms:source>Xu et al. 2003</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Incomplete Treatment</rdfs:label>
        <skos:definition xml:lang="en">A coping strategy in which a patient begins but does not complete a prescribed treatment course due to cost concerns.</skos:definition>
        <skos:prefLabel xml:lang="en">Incomplete Treatment</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/treatment-failure"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
