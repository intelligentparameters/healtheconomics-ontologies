        <dcterms:identifier>HE-ES-SA-037</dcterms:identifier>
        <dcterms:source>Carpenter &amp; Kenward 2013</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Copy Reference</rdfs:label>
        <skos:altLabel xml:lang="en">Copy-Reference Imputation</skos:altLabel>
        <skos:definition xml:lang="en">A missing data method, often used after treatment discontinuation, assuming a patient&apos;s future outcomes follow the trajectory observed in the reference arm.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Reference-Based Imputation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Copy Reference</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/missing-data"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/jump-to-reference"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/copy-reference"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/imputation"/>
        <dcterms:identifier>HEO-L-0bce1fb83b05</dcterms:identifier>
        <linkRationale xml:lang="en">A method is not missing data; copy reference is a reference-based imputation approach</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
