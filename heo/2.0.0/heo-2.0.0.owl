    <!-- https://healtheconomics.wiki/concept/community-based-research -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/community-based-research">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/participatory-research"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q5154595"/>
