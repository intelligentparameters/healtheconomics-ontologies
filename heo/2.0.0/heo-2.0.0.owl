    <!-- https://healtheconomics.wiki/concept/value-in-healthcare -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/value-in-healthcare">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
