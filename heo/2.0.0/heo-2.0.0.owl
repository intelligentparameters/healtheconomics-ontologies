    <!-- https://healtheconomics.wiki/concept/negative-likelihood-ratio -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/negative-likelihood-ratio">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/likelihood-ratio"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/likelihood-ratio"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/diagnostic-accuracy"/>
