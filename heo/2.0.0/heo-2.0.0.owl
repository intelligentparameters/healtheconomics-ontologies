    <!-- https://healtheconomics.wiki/concept/disconnected-network -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/disconnected-network">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-ES-ESM-013</skos:notation>
        <dcterms:identifier>HE-ES-ESM-013</dcterms:identifier>
        <dcterms:source>Dias et al. 2013</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Disconnected Network</rdfs:label>
        <skos:definition xml:lang="en">A situation where available trials do not link every treatment of interest through any chain of direct comparisons, leaving separate evidence clusters.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Split Evidence Clusters</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Unconnected Evidence Network</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Disconnected Network</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/connected-network"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/indirect-comparison"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/disconnected-network"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-0744f29d00e2</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Evidence Synthesis Methods: catalogue subdomain Evidence Synthesis is one of the subdomains</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/disconnected-network"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/connected-network"/>
        <dcterms:identifier>HEO-L-1adf68570e79</dcterms:identifier>
        <linkRationale xml:lang="en">connected and disconnected networks are the opposing NMA network states</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/disconnected-network"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#threatensValidityOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/indirect-comparison"/>
        <dcterms:identifier>HEO-L-bd893726bfa2</dcterms:identifier>
        <linkRationale xml:lang="en">without a common comparator indirect comparisons cannot be anchored, undermining their validity</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/discount -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/discount">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1047056"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/net-price"/>
        <skos:notation>HS-DC-DP-023</skos:notation>
        <dcterms:identifier>HS-DC-DP-023</dcterms:identifier>
        <dcterms:source>Carlson JJ, Sullivan SD, Garrison LP, Neumann PJ, Veenstra DL. Linking payment to health outcomes: a taxonomy and examination of performance-based reimbursement schemes. Health Policy. 2010;96(3):179-190.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Discount</rdfs:label>
        <skos:definition xml:lang="en">A reduction from a treatment&apos;s list price, negotiated between a manufacturer and a purchaser such as a payer or wholesaler.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Manufacturer Reduction</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Purchaser Price Cut</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Discount</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/rebate"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/discount"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-bac1ed40e3b1</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Drug Costs &gt; Drug Pricing: wiki topic Pricing and market access sits in Health Policy; placed under Drug Pricing, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/discount"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <dcterms:identifier>HEO-L-5a516129119a</dcterms:identifier>
        <linkRationale xml:lang="en">a discount is a price reduction within drug pricing, a component of it rather than a kind of price setting</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
