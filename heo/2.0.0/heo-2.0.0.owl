    <!-- https://healtheconomics.wiki/concept/publication-bias-assessment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/publication-bias-assessment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
