    <!-- https://healtheconomics.wiki/concept/shadow-price -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/shadow-price">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-benefit-analysis"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q3308839"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/cost-benefit-analysis"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/opportunity-cost"/>
        <skos:notation>HE-EE-CBA-046</skos:notation>
        <dcterms:identifier>HE-EE-CBA-046</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Weinstein &amp; Zeckhauser 1973</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Shadow Price</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Accounting Price</skos:altLabel>
        <skos:altLabel xml:lang="en">Implicit Price</skos:altLabel>
        <skos:definition xml:lang="en">The implicit value of a resource with no observable market price, reflecting the opportunity cost of using it in a particular way.</skos:definition>
        <skos:prefLabel xml:lang="en">Shadow Price</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/shadow-price"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-benefit-analysis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-62e11f0114b5</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Cost benefit analysis and investment appraisal in subdomain Economic Evaluation; placed under Cost-Benefit Analysis, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/shadow-price"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/opportunity-cost"/>
        <dcterms:identifier>HEO-L-cf1361292977</dcterms:identifier>
        <linkRationale xml:lang="en">A shadow price values a non-market resource at the opportunity cost of using it (subject definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/shadow-price-of-budget -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/shadow-price-of-budget">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/shadow-price"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/shadow-price"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/opportunity-cost"/>
        <skos:notation>HE-EE-CA-074</skos:notation>
        <dcterms:identifier>HE-EE-CA-074</dcterms:identifier>
        <dcterms:source>Weinstein &amp; Zeckhauser 1973</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Shadow Price of Budget</rdfs:label>
        <skos:definition xml:lang="en">The implicit value of relaxing a fixed health budget by one extra unit of currency, reflecting the health forgone elsewhere if it is not spent optimally.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Budget Shadow Price</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Marginal Value of Budget</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Shadow Price of Budget</skos:prefLabel>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-threshold"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/shadow-price-of-budget"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/shadow-price"/>
        <dcterms:identifier>HEO-L-30e347569dc5</dcterms:identifier>
        <linkRationale xml:lang="en">It is a shadow price of the budget constraint.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/shadow-price-of-budget"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/opportunity-cost"/>
        <dcterms:identifier>HEO-L-71951b8b6b19</dcterms:identifier>
        <linkRationale xml:lang="en">The subject definition says the shadow price reflects the health forgone elsewhere, i.e. opportunity cost</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/shadow-price-of-budget"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isFoundationFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-threshold"/>
        <dcterms:identifier>HEO-L-1cdee93e3457</dcterms:identifier>
        <linkRationale xml:lang="en">The shadow price of the budget is the basis of a supply-side threshold.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/shadow-price-of-health -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/shadow-price-of-health">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/shadow-price"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/shadow-price"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/opportunity-cost"/>
        <skos:notation>HE-EE-WE-020</skos:notation>
        <dcterms:identifier>HE-EE-WE-020</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Weinstein &amp; Zeckhauser 1973</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Shadow Price of Health</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">The implicit value of health gains forgone when a health budget is spent inefficiently, used as a basis for setting a cost-effectiveness threshold.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Health Opportunity Cost</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Marginal Value of Health</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Shadow Price of Health</skos:prefLabel>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-threshold"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/shadow-price-of-health"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/shadow-price"/>
        <dcterms:identifier>HEO-L-1ffd6dcbd8ee</dcterms:identifier>
        <linkRationale xml:lang="en">It is the implicit value of health with no market price.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/shadow-price-of-health"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
