        <dcterms:identifier>HE-ES-EP-021</dcterms:identifier>
        <dcterms:source>Anderson &amp; May 1991</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Incubation Period</rdfs:label>
        <skos:altLabel xml:lang="en">Incubation Time</skos:altLabel>
        <skos:definition xml:lang="en">The time interval between exposure to an infectious agent and the onset of symptomatic disease in an infected person.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Exposure-to-Symptom Interval</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Incubation Period</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/latent-period"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/incubation-period"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
