        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/piggyback-evaluation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/trial-based-analysis"/>
        <dcterms:identifier>HEO-L-44c44a7da8ae</dcterms:identifier>
        <linkRationale xml:lang="en">A piggyback evaluation is a trial-based economic evaluation by both definitions</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
