        <skos:hiddenLabel xml:lang="en">Safety of Digital Tools</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Digital Safety</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/patient-safety"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/digital-health"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
