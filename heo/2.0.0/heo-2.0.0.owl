        <skos:notation>HE-ES-ESM-046</skos:notation>
        <dcterms:identifier>HE-ES-ESM-046</dcterms:identifier>
        <dcterms:source>Rücker &amp; Schwarzer 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">P-Score</rdfs:label>
        <skos:definition xml:lang="en">A frequentist network meta-analysis measure ranking treatments by the extent one is expected to outperform every other treatment in the network.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Frequentist Ranking Probability</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Frequentist SUCRA</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">P-Score</skos:prefLabel>
        <counterpartOf rdf:resource="https://healtheconomics.wiki/concept/sucra"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-4"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
