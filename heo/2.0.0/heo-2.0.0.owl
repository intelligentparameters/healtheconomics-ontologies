        <skos:notation>HE-ES-ESM-045</skos:notation>
        <dcterms:identifier>HE-ES-ESM-045</dcterms:identifier>
        <dcterms:source>Stewart &amp; Parmar 1993</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Patient-Level Covariate</rdfs:label>
        <skos:definition xml:lang="en">A characteristic recorded for individual patients, such as age or baseline severity, examined for its effect on treatment response using patient-level data.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Individual Covariate</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Patient Characteristic</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Patient-Level Covariate</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/study-level-covariate"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/patient-heterogeneity"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/patient-level-covariate"/>
