    <!-- https://healtheconomics.wiki/concept/nominal-cost -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/nominal-cost">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <skos:notation>HE-EE-CA-062</skos:notation>
        <dcterms:identifier>HE-EE-CA-062</dcterms:identifier>
        <dcterms:source>Mankiw 2016</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Nominal Cost</rdfs:label>
        <skos:definition xml:lang="en">A cost expressed in the prices of the period in which it was actually incurred, without adjustment for inflation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Current-Price Cost</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Money-Terms Cost</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Nominal Cost</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/real-cost"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
