    <!-- https://healtheconomics.wiki/concept/break-even-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/break-even-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/threshold-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/threshold-analysis"/>
        <skos:notation>HE-EE-CEA-054</skos:notation>
        <dcterms:identifier>HE-EE-CEA-054</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Horngren, Datar &amp; Rajan 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Break-Even Analysis</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Breakeven Analysis</skos:altLabel>
        <skos:definition xml:lang="en">Break-even analysis finds the price, effect or volume at which a health technology or service becomes cost-effective, cost-neutral or self-financing.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cost-Volume Analysis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Break-Even Analysis</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/price-negotiation"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-5"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/break-even-point"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-threshold"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/fixed-cost"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/incremental-net-monetary-benefit"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/variable-cost"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/break-even-analysis"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/threshold-analysis"/>
        <dcterms:identifier>HEO-L-eded2f31154e</dcterms:identifier>
        <linkRationale xml:lang="en">Finding the value at which a conclusion changes is threshold analysis</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/break-even-analysis"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/price-negotiation"/>
