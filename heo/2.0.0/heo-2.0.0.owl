        <skos:altLabel xml:lang="en">AI in Healthcare</skos:altLabel>
        <skos:altLabel xml:lang="en">Health AI</skos:altLabel>
        <skos:definition xml:lang="en">Artificial intelligence in health is software that infers predictions or decisions from data, valued in HTA by its effect on costs and outcomes.</skos:definition>
        <skos:prefLabel xml:lang="en">Artificial Intelligence in Health</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-technology-assessment#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/predictive-analytics"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
