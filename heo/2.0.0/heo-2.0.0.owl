    <!-- https://healtheconomics.wiki/concept/equal-weights -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/equal-weights">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/parameter-input"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/parameter-input"/>
        <skos:notation>HE-EM-VI-008</skos:notation>
        <dcterms:identifier>HE-EM-VI-008</dcterms:identifier>
        <dcterms:source>Cooke 1991</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Equal Weights</rdfs:label>
        <skos:altLabel xml:lang="en">Equal Weighting</skos:altLabel>
        <skos:definition xml:lang="en">A method combining multiple experts&apos; judgements by giving each opinion identical weight in the pooled estimate, unlike performance-based weighting.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Unweighted Pooling</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Equal Weights</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/performance-weights"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/equal-weights"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/parameter-input"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-c6850f6e53dd</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: curated: expert elicitation pooling sets model inputs (Model inputs and parameters), review B</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/equal-weights"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/performance-weights"/>
        <dcterms:identifier>HEO-L-73821f74f30d</dcterms:identifier>
        <linkRationale xml:lang="en">The subject definition sets equal weighting against performance-based weighting of experts</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/equi-effective-dose -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/equi-effective-dose">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/drug-cost"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Equi-Effective Dose</rdfs:label>
        <skos:altLabel xml:lang="en">Equieffective Dose</skos:altLabel>
        <skos:definition xml:lang="en">Equi-effective dose, in PBAC cost-minimisation, is the dose of a new medicine and of its main comparator judged equally effective, used to compare costs.</skos:definition>
        <skos:prefLabel xml:lang="en">Equi-Effective Dose</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
