    <!-- https://healtheconomics.wiki/concept/loading-dose -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/loading-dose">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q6663385"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <precedes rdf:resource="https://healtheconomics.wiki/concept/maintenance-dose"/>
        <skos:notation>HE-PE-CP-007</skos:notation>
        <dcterms:identifier>HE-PE-CP-007</dcterms:identifier>
        <dcterms:source>Rowland &amp; Tozer 2010</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Loading Dose</rdfs:label>
        <skos:definition xml:lang="en">An initial, often larger than standard, dose given to rapidly reach a therapeutic drug concentration before switching to a smaller maintenance dose.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Initial Dose</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Loading Dose</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/loading-dose"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-0d630d176ed5</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Pharmacoeconomics &gt; Clinical Pharmacology: pharmacokinetic and dosing terms describe the clinical evidence behind a treatment effect</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/loading-dose"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#precedes"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/maintenance-dose"/>
        <dcterms:identifier>HEO-L-eb15ce990ff0</dcterms:identifier>
        <linkRationale xml:lang="en">The loading dose is given before switching to the maintenance dose, per both definitions; the symmetric contrast is kept on Maintenance Dose, its only link</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/loan-financing -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/loan-financing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <skos:notation>HS-HP-HF-045</skos:notation>
        <dcterms:identifier>HS-HP-HF-045</dcterms:identifier>
        <dcterms:source>Musgrave &amp; Musgrave 1989</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Loan Financing</rdfs:label>
        <skos:definition xml:lang="en">The use of borrowed funds, repaid over time with interest, to finance healthcare infrastructure or, at household level, medical expenses.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Credit-Based Financing</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Health Sector Borrowing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Loan Financing</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/bond-financing"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
