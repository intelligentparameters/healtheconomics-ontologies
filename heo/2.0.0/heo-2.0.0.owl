    <!-- https://healtheconomics.wiki/concept/mental-functioning -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/mental-functioning">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/functional-status"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/health-related-quality-of-life"/>
        <skos:notation>HE-ES-CO-042</skos:notation>
        <dcterms:identifier>HE-ES-CO-042</dcterms:identifier>
        <dcterms:source>U.S. Food and Drug Administration. Guidance for Industry: Patient-Reported Outcome Measures-Use in Medical Product Development to Support Labeling Claims. FDA; 2009.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Mental Functioning</rdfs:label>
        <skos:altLabel xml:lang="en">Psychological Functioning</skos:altLabel>
        <skos:definition xml:lang="en">A broad outcome domain covering a person&apos;s cognitive, emotional, and psychological capacities together, often assessed as a composite within health status instruments.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Mental Function Domain</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Mental Functioning</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/mental-functioning"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-59ea5b5a743f</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Clinical Outcomes: concepts with this Level 3 that the wiki places in a topic sit in Outcomes (Clinical and patient-reported outcomes)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/mental-functioning"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/functional-status"/>
        <dcterms:identifier>HEO-L-150f5d7fbaac</dcterms:identifier>
