        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/operating-budget"/>
        <dcterms:identifier>HEO-L-3d1da8d7d870</dcterms:identifier>
        <linkRationale xml:lang="en">A service line budget covers day-to-day costs and revenues, an operating budget.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/service-line-budget"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/service-line-management"/>
        <dcterms:identifier>HEO-L-7f2a9ef58250</dcterms:identifier>
        <linkRationale xml:lang="en">Each service line budget is a component of service line management</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/service-line-management -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/service-line-management">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/resource-management"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/resource-management"/>
        <skos:notation>HS-SS_HD-027</skos:notation>
        <dcterms:identifier>HS-SS_HD-027</dcterms:identifier>
        <dcterms:source>AHA, American Hospital Association</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Service Line Management</rdfs:label>
        <skos:definition xml:lang="en">An organisational approach grouping resources around specific clinical service areas, such as cardiology, rather than traditional departmental structure.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Clinical Service Management</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Service Line Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Service Line Management</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/service-line-management"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/resource-management"/>
        <dcterms:identifier>HEO-L-7b595dde42c8</dcterms:identifier>
        <linkRationale xml:lang="en">Grouping resources by clinical service is a resource management approach.</linkRationale>
