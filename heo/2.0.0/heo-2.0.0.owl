    <!-- https://healtheconomics.wiki/concept/random-sampling -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/random-sampling">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-ES-SA-248</skos:notation>
        <dcterms:identifier>HE-ES-SA-248</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</dcterms:modified>
        <dcterms:source>United Nations Statistics Division 2005</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Random Sampling</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">Random sampling selects members of a population by chance, giving each a known, non-zero probability of selection, so sample estimates can be generalised.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Probability Sampling</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Random Sampling</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/selection-bias"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/generalizability"/>
        <prerequisiteFor rdf:resource="https://healtheconomics.wiki/concept/design-effect"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/random-sampling"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
