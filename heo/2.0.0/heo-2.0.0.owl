    <!-- https://healtheconomics.wiki/concept/stop-loss -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/stop-loss">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/risk-transfer"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/risk-transfer"/>
        <skos:notation>HS-HP-HI-187</skos:notation>
        <dcterms:identifier>HS-HP-HI-187</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563?643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Stop-Loss</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A health financing risk protection arrangement that reimburses eligible individual or aggregate claims above a specified attachment point, subject to the contract’s limits and exclusions.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Excess-Loss Threshold</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Loss Cap</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Stop-Loss</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-2"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/risk-retention"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/stop-loss"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/risk-transfer"/>
        <dcterms:identifier>HEO-L-8cab1558045c</dcterms:identifier>
        <linkRationale xml:lang="en">Stop-loss shifts claims above an attachment point to another party, which is risk transfer.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/stop-loss"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/risk-retention"/>
        <dcterms:identifier>HEO-L-c2d61b114b9a</dcterms:identifier>
        <linkRationale xml:lang="en">The attachment point caps the risk the insured party retains, so stop-loss restricts risk retention.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/stop-loss-design -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/stop-loss-design">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/reinsurance-design"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/reinsurance-design"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/stop-loss-insurance"/>
        <skos:notation>HS-HP-HI-188</skos:notation>
        <dcterms:identifier>HS-HP-HI-188</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Stop-Loss Design</rdfs:label>
        <skos:definition xml:lang="en">The specific structure of a stop-loss arrangement, including the attachment point and whether coverage applies on an individual or aggregate basis.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Excess-Loss Structuring</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Loss-Cap Design</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Stop-Loss Design</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/stop-loss-design"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/reinsurance-design"/>
        <dcterms:identifier>HEO-L-99e35618ca24</dcterms:identifier>
        <linkRationale xml:lang="en">Stop-loss design sets the attachment point and coverage basis, the same features that define reinsurance design.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
