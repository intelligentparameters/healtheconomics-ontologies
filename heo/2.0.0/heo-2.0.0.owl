    <!-- https://healtheconomics.wiki/concept/soft-budget-constraint -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/soft-budget-constraint">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/budget-constraint"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/budget-constraint"/>
        <skos:notation>HE-EE-BIA-045</skos:notation>
        <dcterms:identifier>HE-EE-BIA-045</dcterms:identifier>
        <dcterms:source>Kornai 1979</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Soft Budget Constraint</rdfs:label>
        <skos:definition xml:lang="en">A situation where an organisation expects that any budget overrun will be covered by an external authority rather than facing full financial consequences.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Bailout Expectation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Soft Budget</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Soft Budget Constraint</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/moral-hazard"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/soft-budget-constraint"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/budget-constraint"/>
        <dcterms:identifier>HEO-L-a9d884adce16</dcterms:identifier>
        <linkRationale xml:lang="en">A soft budget constraint is a budget constraint that is not binding.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/soft-budget-constraint"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/moral-hazard"/>
        <dcterms:identifier>HEO-L-ecf42ac30ca6</dcterms:identifier>
        <linkRationale xml:lang="en">Expecting overruns to be covered shields the organisation from the full cost of its choices, the moral hazard mechanism.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/soft-endpoint -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/soft-endpoint">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-endpoint"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/clinical-endpoint"/>
        <skos:notation>HE-ES-CTM-088</skos:notation>
        <dcterms:identifier>HE-ES-CTM-088</dcterms:identifier>
        <dcterms:source>Friedman LM, Furberg CD, DeMets DL, Reboussin DM, Granger CB. Fundamentals of Clinical Trials. 5th ed. Springer; 2015. doi:10.1007/978-3-319-18539-2.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Soft Endpoint</rdfs:label>
        <skos:altLabel xml:lang="en">Soft Outcome</skos:altLabel>
        <skos:altLabel xml:lang="en">Subjective Endpoint</skos:altLabel>
        <skos:definition xml:lang="en">A trial outcome relying on subjective clinical judgement, such as a physician&apos;s severity assessment, unlike an objectively defined hard endpoint.</skos:definition>
        <skos:prefLabel xml:lang="en">Soft Endpoint</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/soft-endpoint"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/clinical-endpoint"/>
        <dcterms:identifier>HEO-L-041146013ba0</dcterms:identifier>
        <linkRationale xml:lang="en">A soft endpoint is a trial endpoint.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/software-validation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/software-validation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
