    <!-- https://healtheconomics.wiki/concept/imperfect-agency -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/imperfect-agency">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/principal-agent-problem"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/principal-agent-problem"/>
        <skos:notation>HE-EE-ME-027</skos:notation>
        <dcterms:identifier>HE-EE-ME-027</dcterms:identifier>
        <dcterms:source>Evans 1974</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Imperfect Agency</rdfs:label>
        <skos:definition xml:lang="en">A situation in which an agent, such as a physician, does not perfectly represent the principal&apos;s interests due to differing incentives or information.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Agency Imperfection</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Imperfect Agent</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Imperfect Agency</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/supplier-induced-demand"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/imperfect-agency"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/principal-agent-problem"/>
        <dcterms:identifier>HEO-L-dcdf20416097</dcterms:identifier>
        <linkRationale xml:lang="en">A form of the principal-agent problem.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/imperfect-agency"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
