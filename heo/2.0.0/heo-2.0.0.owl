    <!-- https://healtheconomics.wiki/concept/risk-sharing-design -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/risk-sharing-design">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/risk-sharing"/>
        <skos:notation>HS-HP-HI-172</skos:notation>
        <dcterms:identifier>HS-HP-HI-172</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Risk Sharing Design</rdfs:label>
        <skos:definition xml:lang="en">The specific structure of a risk-sharing arrangement, including the threshold at which sharing begins and the proportion of costs each party bears above it.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Risk-Sharing Structure</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Sharing Arrangement Design</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Risk Sharing Design</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/risk-corridor"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/stop-loss"/>
    </owl:NamedIndividual>
