    <!-- https://healtheconomics.wiki/concept/quality-of-death -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/quality-of-death">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
