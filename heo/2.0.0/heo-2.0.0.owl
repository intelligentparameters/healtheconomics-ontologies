    <!-- https://healtheconomics.wiki/concept/welfare-theorem -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/welfare-theorem">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/welfare-economics"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/welfare-economics"/>
        <skos:notation>HE-EE-WE-026</skos:notation>
        <dcterms:identifier>HE-EE-WE-026</dcterms:identifier>
        <dcterms:source>Arrow &amp; Debreu 1954</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Welfare Theorem</rdfs:label>
        <skos:altLabel xml:lang="en">Fundamental Theorems of Welfare</skos:altLabel>
        <skos:definition xml:lang="en">Either of two foundational results linking competitive market equilibrium to Pareto efficiency, given appropriate initial resource redistribution.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Efficiency-Equilibrium Theorem</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Welfare Theorem</skos:prefLabel>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/welfare-economics"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/welfare-theorem"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/welfare-economics"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-9719c368b8e4</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Welfare Economics: welfarism and extra-welfarism are the normative basis of cost-benefit and cost-effectiveness analysis; placed under Welfare Economics, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/welfare-theorem"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isFoundationFor"/>
