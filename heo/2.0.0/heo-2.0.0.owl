    <!-- https://healtheconomics.wiki/concept/supply-side-control -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/supply-side-control">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
