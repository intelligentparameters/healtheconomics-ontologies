    <!-- https://healtheconomics.wiki/concept/response-option-design -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/response-option-design">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
