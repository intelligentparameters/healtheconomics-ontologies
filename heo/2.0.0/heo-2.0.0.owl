        <dcterms:identifier>HEO-L-51cd41f6156a</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: curated: the period over which an investment is appraised is an evaluation choice, review B</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
