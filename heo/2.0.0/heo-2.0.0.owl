    <!-- https://healtheconomics.wiki/concept/health-system-efficiency -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/health-system-efficiency">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/efficiency"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/efficiency"/>
        <skos:notation>HS-HP-HSM-006</skos:notation>
        <dcterms:identifier>HS-HP-HSM-006</dcterms:identifier>
        <dcterms:source>World Health Organization. Everybody&apos;s Business: Strengthening Health Systems to Improve Health Outcomes-WHO&apos;s Framework for Action. WHO; 2007.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Health System Efficiency</rdfs:label>
        <skos:definition xml:lang="en">The degree to which a health system achieves maximum possible health outcomes from available resources, or a given outcome using minimum resources.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Health System Productivity</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">System Efficiency</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Health System Efficiency</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/health-system-performance"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/health-system-efficiency"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/efficiency"/>
        <dcterms:identifier>HEO-L-5b17ad992117</dcterms:identifier>
        <linkRationale xml:lang="en">Health system efficiency is efficiency applied to a system.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
