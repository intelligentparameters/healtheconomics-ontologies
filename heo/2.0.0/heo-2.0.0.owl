    <!-- https://healtheconomics.wiki/concept/incidence-rate-ratio -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/incidence-rate-ratio">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/relative-measure"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/relative-measure"/>
        <skos:notation>HE-ES-RM-011</skos:notation>
        <dcterms:identifier>HE-ES-RM-011</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-24</dcterms:modified>
        <dcterms:source>Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams &amp; Wilkins; 2008.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Incidence Rate Ratio</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Incidence Density Ratio</skos:altLabel>
        <skos:altLabel xml:lang="en">Rate Ratio</skos:altLabel>
        <skos:altLabel xml:lang="en">Relative Rate</skos:altLabel>
        <skos:definition xml:lang="en">A measure comparing the incidence rate of an outcome between two groups, accounting for differences in total person-time at risk.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Comparative Rate</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">IRR</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Incidence Rate Ratio</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/rate-difference"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/relative-risk"/>
        <counterpartOf rdf:resource="https://healtheconomics.wiki/concept/risk-ratio"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/incidence-rate-ratio"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/relative-measure"/>
