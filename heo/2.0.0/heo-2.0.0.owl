        <skos:altLabel xml:lang="en">EQ5D</skos:altLabel>
        <skos:altLabel xml:lang="en">EuroQol 5D</skos:altLabel>
        <skos:definition xml:lang="en">A generic instrument measuring health-related quality of life across five dimensions, including mobility, self-care, and pain, widely used to generate cost-utility values.</skos:definition>
        <skos:prefLabel xml:lang="en">EQ-5D</skos:prefLabel>
