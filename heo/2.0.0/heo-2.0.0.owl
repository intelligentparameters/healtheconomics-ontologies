    <!-- https://healtheconomics.wiki/concept/marginal-cost-effectiveness -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/marginal-cost-effectiveness">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <skos:notation>HE-EE-CEA-039</skos:notation>
        <dcterms:identifier>HE-EE-CEA-039</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Marginal Cost-Effectiveness</rdfs:label>
        <skos:altLabel xml:lang="en">Marginal CE</skos:altLabel>
        <skos:definition xml:lang="en">The additional cost required to produce one more unit of health effect at the margin of an intervention&apos;s current scale, distinct from its average.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Expansion Cost-Effectiveness</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Marginal Cost-Effectiveness</skos:prefLabel>
        <abbreviation xml:lang="en">Marginal CE</abbreviation>
        <informs rdf:resource="https://healtheconomics.wiki/concept/resource-allocation"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-3"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/marginal-cost-effectiveness"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-179d8b716f54</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Cost effectiveness analysis in subdomain Economic Evaluation; placed under Cost-Effectiveness Analysis, the concept named by its wiki topic</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/marginal-cost-effectiveness"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/resource-allocation"/>
        <dcterms:identifier>HEO-L-8a5a20d69c58</dcterms:identifier>
        <linkRationale xml:lang="en">A cost per extra unit of effect is a ratio, not an analysis; it informs whether to expand or contract a programme (its contrasts with ACER and ICER already exist)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/marginal-cost-estimation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/marginal-cost-estimation">
