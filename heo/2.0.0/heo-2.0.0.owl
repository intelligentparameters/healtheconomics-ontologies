    <!-- https://healtheconomics.wiki/concept/first-order-index -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/first-order-index">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/sobol-indices"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/sobol-indices"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/parameter-importance"/>
        <skos:notation>HE-EM-UA-067</skos:notation>
        <dcterms:identifier>HE-EM-UA-067</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-23</dcterms:modified>
        <dcterms:source>Sobol 2001</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">First-Order Index</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">First-Order Sensitivity Index</skos:altLabel>
        <skos:altLabel xml:lang="en">First-Order Sobol Index</skos:altLabel>
        <skos:altLabel xml:lang="en">S1</skos:altLabel>
        <skos:altLabel xml:lang="en">Sobol First-Order Index</skos:altLabel>
        <skos:definition xml:lang="en">A first-order index in variance-based sensitivity analysis is the fraction of model-output variance explained by changes in the conditional mean when one uncertain input varies on its own under the specified input distribution.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Main-Effect Sensitivity Index</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">First-Order Index</skos:prefLabel>
        <abbreviation xml:lang="en">S1</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/total-effect-index"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-10"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/first-order-index"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/sobol-indices"/>
        <dcterms:identifier>HEO-L-eb7d3a1820df</dcterms:identifier>
        <linkRationale xml:lang="en">The first-order index is one of the Sobol indices</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/first-order-index"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/parameter-importance"/>
        <dcterms:identifier>HEO-L-7e17aceb9c8c</dcterms:identifier>
        <linkRationale xml:lang="en">A first-order index apportions output variance to one input; it measures that input&apos;s importance, not variance</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
