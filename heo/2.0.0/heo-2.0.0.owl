    <!-- https://healtheconomics.wiki/concept/confidential-discount -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/confidential-discount">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/discount"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/discount"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/confidential-price"/>
        <skos:notation>HS-DC-DP-016</skos:notation>
        <dcterms:identifier>HS-DC-DP-016</dcterms:identifier>
        <dcterms:source>Carlson JJ, Sullivan SD, Garrison LP, Neumann PJ, Veenstra DL. Linking payment to health outcomes: a taxonomy and examination of performance-based reimbursement schemes. Health Policy. 2010;96(3):179-190.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Confidential Discount</rdfs:label>
        <skos:definition xml:lang="en">A price reduction negotiated privately between a manufacturer and payer, keeping a higher public list price while offering a lower net price.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Private Discount</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Undisclosed Rebate</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Confidential Discount</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/rebate"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
