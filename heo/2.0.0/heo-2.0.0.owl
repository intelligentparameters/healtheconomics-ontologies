    <!-- https://healtheconomics.wiki/concept/data-timeliness -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/data-timeliness">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
