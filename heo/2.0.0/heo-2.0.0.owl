        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Medication Reconciliation</rdfs:label>
        <skos:altLabel xml:lang="en">Med Rec</skos:altLabel>
        <skos:definition xml:lang="en">The process of creating an accurate medication list, comparing it against new orders at care transitions, and resolving discrepancies to prevent errors.</skos:definition>
