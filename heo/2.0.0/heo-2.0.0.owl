    <!-- https://healtheconomics.wiki/concept/log-rank-test -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/log-rank-test">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/hypothesis-testing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/hypothesis-testing"/>
        <skos:notation>HE-EM-SM-049</skos:notation>
        <dcterms:identifier>HE-EM-SM-049</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-24</dcterms:modified>
        <dcterms:source>Mantel 1966</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Log-Rank Test</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Mantel-Cox Test</skos:altLabel>
        <skos:definition xml:lang="en">The log-rank test is a nonparametric hypothesis test that compares the event-time distributions of two or more groups by accumulating observed-minus-expected events across distinct event times while accounting for right censoring.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Mantel-Haenszel Survival Test</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Log-Rank Test</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/wilcoxon-test"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/chi-square-distribution"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/log-rank-test"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/hypothesis-testing"/>
        <dcterms:identifier>HEO-L-9b9022f3028e</dcterms:identifier>
        <linkRationale xml:lang="en">The log-rank test is a hypothesis test</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/log-rank-test"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/wilcoxon-test"/>
        <dcterms:identifier>HEO-L-562d5f7ed382</dcterms:identifier>
        <linkRationale xml:lang="en">Log-rank weights events equally, Wilcoxon weights early events more, per the object definition</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
