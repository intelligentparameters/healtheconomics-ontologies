        <rdfs:label xml:lang="en">Submission Dossier</rdfs:label>
        <skos:definition xml:lang="en">A comprehensive document presenting clinical and economic evidence supporting a new technology, submitted to an assessment body or regulator.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Assessment Dossier</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Submission Package</skos:hiddenLabel>
