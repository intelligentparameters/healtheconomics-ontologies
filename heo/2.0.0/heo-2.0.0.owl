    <!-- https://healtheconomics.wiki/concept/calibration-of-experts -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/calibration-of-experts">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
