        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/rivalrous-consumption"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/good-characteristic"/>
        <dcterms:identifier>HEO-L-3bcf3f915e77</dcterms:identifier>
        <linkRationale xml:lang="en">Rivalry is a named good characteristic.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
