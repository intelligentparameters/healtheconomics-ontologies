    <!-- https://healtheconomics.wiki/concept/capacity-assessment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/capacity-assessment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/informed-consent"/>
        <skos:notation>HS-HP-HD-018</skos:notation>
        <dcterms:identifier>HS-HP-HD-018</dcterms:identifier>
        <dcterms:source>Appelbaum &amp; Grisso 1988</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Capacity Assessment</rdfs:label>
        <skos:altLabel xml:lang="en">Decision-Making Capacity Evaluation</skos:altLabel>
        <skos:definition xml:lang="en">A clinical evaluation of an individual&apos;s ability to understand information, appreciate consequences, and communicate a choice, to determine consent validity.</skos:definition>
