        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/risk"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/absolute-risk-reduction"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/attributable-risk"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/number-needed-to-harm"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/relative-risk"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/risk-difference"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/transition-probability"/>
        <skos:notation>HE-ES-RM-002</skos:notation>
        <dcterms:identifier>HE-ES-RM-002</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams &amp; Wilkins; 2008.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Absolute Risk</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">The probability that an individual in a defined population will experience a specific outcome over a given period, without reference to a comparison.</skos:definition>
        <skos:hiddenLabel xml:lang="en">AR</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Absolute Probability</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Event Rate</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Absolute Risk</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/hazard-rate"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/incidence-rate"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/absolute-risk"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/risk"/>
        <dcterms:identifier>HEO-L-0eed46e7046a</dcterms:identifier>
        <linkRationale xml:lang="en">Absolute risk is risk stated without a comparison group</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
