        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <dcterms:identifier>HEO-L-27637811e679</dcterms:identifier>
        <linkRationale xml:lang="en">Only link; the HST pathway is a kind of HTA for very rare conditions</linkRationale>
