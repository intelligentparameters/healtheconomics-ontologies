    <!-- https://healtheconomics.wiki/concept/crossover-trial -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/crossover-trial">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
