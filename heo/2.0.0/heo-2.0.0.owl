        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/precision-therapy"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/companion-diagnostic"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-technology"/>
        <dcterms:identifier>HEO-L-f4722afb7058</dcterms:identifier>
        <linkRationale xml:lang="en">A diagnostic test is a health technology under the object definition</linkRationale>
