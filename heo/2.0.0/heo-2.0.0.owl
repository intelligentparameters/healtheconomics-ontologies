        <dcterms:identifier>HE-EE-BIA-003</dcterms:identifier>
        <dcterms:source>Musgrave &amp; Musgrave 1989</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Budget Amendment</rdfs:label>
        <skos:altLabel xml:lang="en">Budget Revision</skos:altLabel>
        <skos:definition xml:lang="en">A formal revision to an approved budget made after the budget cycle has begun, usually to reflect unexpected cost or demand changes.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Budget Modification</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Budget Amendment</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
