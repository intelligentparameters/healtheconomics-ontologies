    <!-- https://healtheconomics.wiki/concept/corrective-action -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/corrective-action">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
