    <!-- https://healtheconomics.wiki/concept/pathway-development -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/pathway-development">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:notation>HS-HP-HTA-145</skos:notation>
        <dcterms:identifier>HS-HP-HTA-145</dcterms:identifier>
        <dcterms:source>National Institute for Health and Care Excellence. NICE technology appraisal and highly specialised technologies guidance: the manual (PMG36). Published 2022; updated 2026.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Pathway Development</rdfs:label>
        <skos:definition xml:lang="en">The process of designing a structured clinical care pathway outlining the anticipated sequence of steps for a specific condition.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Care Route Development</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Pathway Design</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Pathway Development</skos:prefLabel>
        <produces rdf:resource="https://healtheconomics.wiki/concept/clinical-pathway"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/process-mapping"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/pathway-development"/>
