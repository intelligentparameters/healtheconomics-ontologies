    <!-- https://healtheconomics.wiki/concept/reduced-consumption -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/reduced-consumption">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/coping-strategy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/coping-strategy"/>
        <skos:notation>HS-HP-HF-063</skos:notation>
        <dcterms:identifier>HS-HP-HF-063</dcterms:identifier>
        <dcterms:source>Xu et al. 2003</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Reduced Consumption</rdfs:label>
        <skos:altLabel xml:lang="en">Consumption Reduction</skos:altLabel>
        <skos:definition xml:lang="en">A coping strategy where a household cuts spending on other essentials, such as food, to cover healthcare costs, indicating financial strain.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Demand Reduction</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Reduced Consumption</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
