    <!-- https://healtheconomics.wiki/concept/disability -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/disability">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:notation>HS-HP-PHO-004</skos:notation>
        <dcterms:identifier>HS-HP-PHO-004</dcterms:identifier>
        <dcterms:source>WHO 2001</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Disability</rdfs:label>
        <skos:definition xml:lang="en">A limitation in an individual&apos;s ability to perform activities or participate in life, arising from the interaction between a health condition and personal or environmental factors.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Impairment-Based Limitation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Reduced Functioning</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Disability</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/functional-status"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/disability"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-ab023d59c7af</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Population Health Outcomes: health and functional status are outcome measures</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/disability"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/functional-status"/>
        <dcterms:identifier>HEO-L-56afdb93853c</dcterms:identifier>
        <linkRationale xml:lang="en">disability is limitation, not a measure of ability; the WHO ICF treats functioning and disability as the positive and negative aspects</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


