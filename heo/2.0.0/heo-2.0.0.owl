    <!-- https://healtheconomics.wiki/concept/per-member-per-month -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/per-member-per-month">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
