    <!-- https://healtheconomics.wiki/concept/marginal-cost -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/marginal-cost">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-principle"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-principle"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/deadweight-loss"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/marginal-cost-effectiveness"/>
        <skos:notation>HE-EE-EPR-027</skos:notation>
        <dcterms:identifier>HE-EE-EPR-027</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Varian 2014</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Marginal Cost</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">Marginal cost is the change in total economic cost caused by producing one additional unit of output at a specified level of activity and over a specified time horizon.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cost at the Margin</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Extra-Unit Cost</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Marginal Cost</skos:prefLabel>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/supply-price"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/marginal-cost"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-principle"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-0ee10f73dfa0</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Scarcity choice and opportunity cost in subdomain Economic Foundations; placed under Economic Principle, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/marginal-cost"/>
