        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:notation>HE-EE-CBA-048</skos:notation>
        <dcterms:identifier>HE-EE-CBA-048</dcterms:identifier>
        <dcterms:source>Louviere, Hensher &amp; Swait 2000</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Stated Preference</rdfs:label>
        <skos:altLabel xml:lang="en">SP</skos:altLabel>
        <skos:definition xml:lang="en">A category of valuation methods that elicits preferences by asking people directly about hypothetical choices, rather than observing actual market behaviour.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Contingent Preference Elicitation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Stated Preference</skos:prefLabel>
        <abbreviation xml:lang="en">SP</abbreviation>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/stated-preference"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-51c905bb8edd</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Cost-Benefit Analysis: the unplaced concepts here are stated preference terms; the wiki&apos;s topic Stated preference and monetary valuation sits in Outcomes</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    


