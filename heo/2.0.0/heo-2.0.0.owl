    <!-- https://healtheconomics.wiki/concept/transient-outcome -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/transient-outcome">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome"/>
        <skos:notation>HE-ES-CO-089</skos:notation>
        <dcterms:identifier>HE-ES-CO-089</dcterms:identifier>
        <dcterms:source>U.S. Food and Drug Administration. Guidance for Industry: Patient-Reported Outcome Measures-Use in Medical Product Development to Support Labeling Claims. FDA; 2009.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Transient Outcome</rdfs:label>
        <skos:definition xml:lang="en">A clinical or economic outcome that appears temporarily following treatment but does not persist, unlike a sustained outcome that continues over time.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Short-Lived Outcome</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Temporary Outcome</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Transient Outcome</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/sustained-outcome"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/transient-outcome"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome"/>
        <dcterms:identifier>HEO-L-74fa5c38a345</dcterms:identifier>
        <linkRationale xml:lang="en">Transient outcomes are mainly temporary clinical responses to treatment.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/transient-outcome"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
