    <!-- https://healtheconomics.wiki/concept/five-whys-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/five-whys-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/root-cause-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/root-cause-analysis"/>
        <skos:notation>HS-SS_HQ-007</skos:notation>
        <dcterms:identifier>HS-SS_HQ-007</dcterms:identifier>
        <dcterms:source>Ohno 1988</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Five Whys Analysis</rdfs:label>
        <skos:altLabel xml:lang="en">5 Whys</skos:altLabel>
        <skos:definition xml:lang="en">A simple, iterative root cause technique repeatedly asking why, typically five times, to drill down from a problem to its fundamental cause.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Iterative Why Technique</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Five Whys Analysis</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
