    <!-- https://healtheconomics.wiki/concept/customary-charge -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/customary-charge">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/billed-charges"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/billed-charges"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/usual-customary-reasonable"/>
        <skos:notation>HS-HP-PP-039</skos:notation>
        <dcterms:identifier>HS-HP-PP-039</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Customary Charge</rdfs:label>
        <skos:altLabel xml:lang="en">Customary Fee</skos:altLabel>
        <skos:definition xml:lang="en">The typical amount a provider bills for a service based on established pricing practice, historically used before prospective payment systems.</skos:definition>
        <skos:prefLabel xml:lang="en">Customary Charge</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
