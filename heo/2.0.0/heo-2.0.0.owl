    <!-- https://healtheconomics.wiki/concept/digital-engagement -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/digital-engagement">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-SS_DH-016</skos:notation>
        <dcterms:identifier>HS-SS_DH-016</dcterms:identifier>
        <dcterms:source>NICE, Evidence Standards Framework for Digital Health Technologies</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Digital Engagement</rdfs:label>
        <skos:definition xml:lang="en">The degree to which patients or users actively interact with and use a digital health technology, such as an app or portal.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Digital Health Engagement</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">User Interaction with Digital Tools</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Digital Engagement</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/patient-activation"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/digital-engagement"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-c24179ddedb9</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Systems Strengthening &gt; Digital Health: health system strengthening is the Health Systems subdomain</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/digital-engagement"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/patient-activation"/>
        <dcterms:identifier>HEO-L-16302abe61f6</dcterms:identifier>
