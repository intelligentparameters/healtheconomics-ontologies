    <!-- https://healtheconomics.wiki/concept/exploratory-factor-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/exploratory-factor-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/factor-analysis"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q5421350"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/factor-analysis"/>
        <skos:notation>HE-ES-SA-060</skos:notation>
        <dcterms:identifier>HE-ES-SA-060</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-23</dcterms:modified>
        <dcterms:source>Spearman 1904</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Exploratory Factor Analysis</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">EFA</skos:altLabel>
        <skos:definition xml:lang="en">Exploratory factor analysis is a latent-variable method that examines whether correlations among observed variables can be represented by a smaller, initially unspecified set of common factors.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Unsupervised Factor Extraction</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Exploratory Factor Analysis</skos:prefLabel>
        <abbreviation xml:lang="en">EFA</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/factor-loading"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/oblique-rotation"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/parallel-analysis"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/scree-plot"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/varimax-rotation"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/exploratory-factor-analysis"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/factor-analysis"/>
        <dcterms:identifier>HEO-L-1f232d381e0b</dcterms:identifier>
        <linkRationale xml:lang="en">EFA is a form of factor analysis</linkRationale>
