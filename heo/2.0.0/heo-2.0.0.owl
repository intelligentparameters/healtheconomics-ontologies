        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/principal-agent-problem"/>
        <dcterms:identifier>HEO-L-6a7208e60dbd</dcterms:identifier>
        <linkRationale xml:lang="en">The subject is the healthcare version of the principal-agent problem, as its definition states, not a formal model</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
