    <!-- https://healtheconomics.wiki/concept/coding-compliance -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/coding-compliance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/compliance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/compliance"/>
        <skos:notation>HS-HP-HSR-012</skos:notation>
        <dcterms:identifier>HS-HP-HSR-012</dcterms:identifier>
        <dcterms:source>OIG, Compliance Program Guidance</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Coding Compliance</rdfs:label>
        <skos:definition xml:lang="en">Adherence to established coding rules when assigning diagnosis and procedure codes for billing, preventing both underbilling and improper overbilling.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Billing Compliance</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Coding Adherence</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Coding Compliance</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/coding-accuracy"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/downcoding"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/upcoding"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/coding-compliance"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/compliance"/>
        <dcterms:identifier>HEO-L-3d965f70ba2c</dcterms:identifier>
        <linkRationale xml:lang="en">Coding compliance is conformity with rules (both definitions)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/coding-compliance"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/coding-accuracy"/>
        <dcterms:identifier>HEO-L-22f9610efe53</dcterms:identifier>
