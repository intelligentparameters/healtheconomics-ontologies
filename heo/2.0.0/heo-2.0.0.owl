    <!-- https://healtheconomics.wiki/concept/hierarchical-testing -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/hierarchical-testing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:notation>HE-ES-SA-078</skos:notation>
        <dcterms:identifier>HE-ES-SA-078</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-23</dcterms:modified>
        <dcterms:source>Dmitrienko, Tamhane &amp; Bretz 2009</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Hierarchical Testing</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Fixed-Sequence Testing</skos:altLabel>
        <skos:definition xml:lang="en">A multiple testing strategy organising hypotheses into a prespecified sequence, so later tests are only conducted if earlier, higher-priority tests succeed.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Sequential Test Procedure</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Hierarchical Testing</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/multiple-comparisons"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/hypothesis-testing"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/hierarchical-testing"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-0bcb2656b983</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Statistical methods in subdomain Evidence Synthesis; placed under Statistical Method, the concept named by its wiki topic</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/hierarchical-testing"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#addresses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/multiple-comparisons"/>
        <dcterms:identifier>HEO-L-915f67decc98</dcterms:identifier>
