        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/population-based-payment"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <dcterms:identifier>HEO-L-e65a15d29541</dcterms:identifier>
        <linkRationale xml:lang="en">Population-based payment is a provider payment method</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/population-coverage -->

