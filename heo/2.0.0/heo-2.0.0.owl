    <!-- https://healtheconomics.wiki/concept/age-rating -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/age-rating">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/risk-rating"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/risk-rating"/>
        <skos:notation>HS-HP-HI-005</skos:notation>
        <dcterms:identifier>HS-HP-HI-005</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
