        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/profitability-ratio"/>
        <skos:notation>HE-EE_EA-047</skos:notation>
        <dcterms:identifier>HE-EE_EA-047</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Brealey, Myers &amp; Allen 2019</dcterms:source>
