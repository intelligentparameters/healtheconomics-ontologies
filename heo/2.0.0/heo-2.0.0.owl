    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/significance-level -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/significance-level">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/hypothesis-testing"/>
        <skos:notation>HE-ES-SA-195</skos:notation>
        <dcterms:identifier>HE-ES-SA-195</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Fisher 1925</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Significance Level</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Alpha Level</skos:altLabel>
        <skos:altLabel xml:lang="en">Significance Threshold</skos:altLabel>
        <skos:definition xml:lang="en">The significance level is a prespecified upper bound on the probability that a valid statistical test rejects its null hypothesis when that hypothesis is true.</skos:definition>
        <skos:prefLabel xml:lang="en">Significance Level</skos:prefLabel>
        <benchmarkFor rdf:resource="https://healtheconomics.wiki/concept/p-value"/>
        <benchmarkFor rdf:resource="https://healtheconomics.wiki/concept/statistical-significance"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/type-i-error"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/rejection-region"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/significance-level"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-40cbbf3e2085</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Statistical methods in subdomain Evidence Synthesis; placed under Statistical Method, the concept named by its wiki topic</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/significance-level"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/hypothesis-testing"/>
        <dcterms:identifier>HEO-L-b017aa37c448</dcterms:identifier>
        <linkRationale xml:lang="en">The prespecified significance level is an element of the hypothesis test, per both definitions</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/significance-level"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#benchmarkFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/p-value"/>
        <dcterms:identifier>HEO-L-fbc4b2005b04</dcterms:identifier>
        <linkRationale xml:lang="en">The p-value is compared against the significance level.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/significance-level"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#benchmarkFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-significance"/>
        <dcterms:identifier>HEO-L-f55d652394a5</dcterms:identifier>
        <linkRationale xml:lang="en">A result is declared significant when p falls below the significance level.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/significance-level"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/type-i-error"/>
        <dcterms:identifier>HEO-L-095304c8f536</dcterms:identifier>
        <linkRationale xml:lang="en">Alpha is the upper bound on the Type I error probability, so it caps that error rate (reduces covers caps).</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/significance-level"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#setsScopeOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/rejection-region"/>
        <dcterms:identifier>HEO-L-de5f5bdb92ea</dcterms:identifier>
        <linkRationale xml:lang="en">Alpha determines the critical values that bound the rejection region.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
