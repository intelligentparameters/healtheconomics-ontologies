        <rdfs:label xml:lang="en">Key Secondary Outcome</rdfs:label>
        <skos:altLabel xml:lang="en">Key Secondary Endpoint</skos:altLabel>
        <skos:definition xml:lang="en">A secondary trial endpoint important enough to warrant formal statistical testing with control for multiplicity, unlike a merely exploratory secondary endpoint.</skos:definition>
