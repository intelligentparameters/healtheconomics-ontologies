    <!-- https://healtheconomics.wiki/concept/symptom-assessment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/symptom-assessment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
