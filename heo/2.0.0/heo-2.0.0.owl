    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/importance-sampling -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/importance-sampling">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/variance-reduction"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/variance-reduction"/>
        <skos:notation>HE-EM-UA-028</skos:notation>
        <dcterms:identifier>HE-EM-UA-028</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-24</dcterms:modified>
        <dcterms:source>Kahn &amp; Marshall 1953</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Importance Sampling</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A variance reduction technique for Monte Carlo simulation that deliberately oversamples important regions of a distribution, then reweights the samples to correct for this.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Importance-Weighted Monte Carlo</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Weighted Sampling</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Importance Sampling</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/latin-hypercube-sampling"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-10"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/monte-carlo-error"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/importance-sampling"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/variance-reduction"/>
        <dcterms:identifier>HEO-L-0a895c4ce96d</dcterms:identifier>
        <linkRationale xml:lang="en">A variance reduction technique.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
