    <!-- https://healtheconomics.wiki/concept/health-equity-metric -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/health-equity-metric">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
