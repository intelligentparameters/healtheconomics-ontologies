    <!-- https://healtheconomics.wiki/concept/compartmental-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/compartmental-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/aggregate-model"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/simulation-model"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/aggregate-model"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/simulation-model"/>
        <skos:notation>HE-EM-DM-011</skos:notation>
        <dcterms:identifier>HE-EM-DM-011</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-09</dcterms:modified>
        <dcterms:source>Chhatwal &amp; He 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Compartmental Model</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Compartment Model</skos:altLabel>
        <skos:definition xml:lang="en">A compartmental model splits a population into compartments, such as susceptible, infectious and recovered, and uses equations for the flows between them.</skos:definition>
        <skos:hiddenLabel xml:lang="en">SIR-Type Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Compartmental Model</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/markov-model"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-8"/>
