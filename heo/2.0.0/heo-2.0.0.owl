        <dcterms:identifier>HEO-L-f383ee49f119</dcterms:identifier>
        <linkRationale xml:lang="en">Panel data are longitudinal data on the same units</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
