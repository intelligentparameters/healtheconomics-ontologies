    <!-- https://healtheconomics.wiki/concept/health-equity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/health-equity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/equity"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1512929"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/equity"/>
        <skos:notation>HS-HP-HE-019</skos:notation>
        <dcterms:identifier>HS-HP-HE-019</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Whitehead 1992</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Health Equity</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Equity in Health</skos:altLabel>
        <skos:definition xml:lang="en">Health equity (equity in health) means everyone has a fair chance to reach their full health potential, free of avoidable and unfair differences in health.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Fair Health Opportunity</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Health Equity</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/health-inequity"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-policy#step-4"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/equity-weighted-analysis"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/fair-innings"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/health-equity"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/equity"/>
        <dcterms:identifier>HEO-L-c48fd9340b16</dcterms:identifier>
        <linkRationale xml:lang="en">Equity covers health, healthcare and financing; equity in health is one kind.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/health-equity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-inequity"/>
        <dcterms:identifier>HEO-L-2ff80b515f12</dcterms:identifier>
        <linkRationale xml:lang="en">Equity and inequity are opposing concepts; keep this direction of the symmetric pair.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
