    <!-- https://healtheconomics.wiki/concept/paired-comparison -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/paired-comparison">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/choice-based-method"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
