    <!-- https://healtheconomics.wiki/concept/grievance-design -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/grievance-design">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/plan-design"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/plan-design"/>
        <skos:notation>HS-HP-HI-089</skos:notation>
        <dcterms:identifier>HS-HP-HI-089</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Grievance Design</rdfs:label>
        <skos:definition xml:lang="en">The structure and procedures an insurance plan sets for enrollees to formally express dissatisfaction other than through a specific claim denial appeal.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Complaint Process</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Grievance Procedure</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Grievance Design</skos:prefLabel>
        <manages rdf:resource="https://healtheconomics.wiki/concept/complaint"/>
