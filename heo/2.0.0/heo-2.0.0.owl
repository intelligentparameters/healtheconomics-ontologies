        <uses rdf:resource="https://healtheconomics.wiki/concept/icer"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/net-monetary-benefit"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
