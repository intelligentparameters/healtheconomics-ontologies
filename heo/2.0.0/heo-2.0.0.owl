        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/living-review"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/living-guideline"/>
        <dcterms:identifier>HEO-L-edef82a5ea14</dcterms:identifier>
