    <!-- https://healtheconomics.wiki/concept/performance-dashboard -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/performance-dashboard">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
