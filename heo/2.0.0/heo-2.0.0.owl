        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/outcomes-research"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/confounding-by-indication"/>
