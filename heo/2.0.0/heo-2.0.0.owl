    <!-- https://healtheconomics.wiki/concept/common-cost-allocation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/common-cost-allocation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-allocation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
