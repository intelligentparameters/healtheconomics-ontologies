        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-2"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
