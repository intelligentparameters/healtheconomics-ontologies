    <!-- https://healtheconomics.wiki/concept/innovative-value -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/innovative-value">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
