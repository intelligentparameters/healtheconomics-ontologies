    <!-- https://healtheconomics.wiki/concept/unmeasured-confounding -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/unmeasured-confounding">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/confounding"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/confounding"/>
        <skos:notation>HE-DS-BV-039</skos:notation>
        <dcterms:identifier>HE-DS-BV-039</dcterms:identifier>
        <dcterms:source>Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams &amp; Wilkins; 2008.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Unmeasured Confounding</rdfs:label>
        <skos:altLabel xml:lang="en">Unobserved Confounding</skos:altLabel>
        <skos:definition xml:lang="en">A situation where a true confounder exists but was not recorded, preventing statistical adjustment for its distorting effect on an association.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Hidden Confounding</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Unmeasured Confounding</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/real-world-evidence"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/unmeasured-confounding"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/confounding"/>
        <dcterms:identifier>HEO-L-8bea4b494da3</dcterms:identifier>
        <linkRationale xml:lang="en">Unmeasured confounding is confounding.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/unmeasured-confounding"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#threatensValidityOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/real-world-evidence"/>
        <dcterms:identifier>HEO-L-963c5ed415fa</dcterms:identifier>
