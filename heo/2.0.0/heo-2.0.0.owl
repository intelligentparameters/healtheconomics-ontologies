    <!-- https://healtheconomics.wiki/concept/between-subject-variation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/between-subject-variation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/variance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/variance"/>
