        <skos:notation>HS-DC-DP-033</skos:notation>
        <dcterms:identifier>HS-DC-DP-033</dcterms:identifier>
        <dcterms:source>FDA, Hatch-Waxman Act</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Generic Entry Impact</rdfs:label>
        <skos:definition xml:lang="en">The effect generic competition has on a drug&apos;s market price, utilisation, and overall budget impact, typically bringing substantial price declines.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Generic Competition Impact</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Post-Patent Impact</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Generic Entry Impact</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/budget-impact-analysis"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
