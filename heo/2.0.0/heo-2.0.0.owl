        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Force of Infection</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">The rate at which susceptible individuals become infected, determined jointly by disease prevalence and the rate and probability of transmission per contact.</skos:definition>
