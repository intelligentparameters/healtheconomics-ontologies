    <!-- https://healtheconomics.wiki/concept/productivity-value -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/productivity-value">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/value-element"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/value-element"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/societal-value"/>
        <skos:notation>HS-NHS-VBH-014</skos:notation>
        <dcterms:identifier>HS-NHS-VBH-014</dcterms:identifier>
        <dcterms:source>Lakdawalla et al. 2017</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Productivity Value</rdfs:label>
        <skos:definition xml:lang="en">A component of a technology&apos;s value reflecting its effect on a patient&apos;s ability to work and contribute economically, beyond clinical improvement.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Productivity Gain Value</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Work-Contribution Value</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Productivity Value</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/productivity-value"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
