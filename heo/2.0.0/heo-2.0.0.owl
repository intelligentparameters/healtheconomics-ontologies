    <!-- https://healtheconomics.wiki/concept/attributable-cost-estimation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/attributable-cost-estimation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/economic-burden"/>
        <skos:notation>HE-EE-CM-003</skos:notation>
        <dcterms:identifier>HE-EE-CM-003</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Honeycutt et al. 2009</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Attributable Cost Estimation</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Attributable cost estimation measures the extra healthcare cost a disease or risk factor causes, against what the same patients would cost without it.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Attributable Costing</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Disease-Attributable Cost</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Attributable Cost Estimation</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/avoidable-cost-estimation"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/costs#step-3"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/cost-of-illness-study"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/attributable-fraction"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/generalized-linear-model"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/matching-design"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/attributable-cost-estimation"/>
