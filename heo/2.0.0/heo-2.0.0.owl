    <!-- https://healtheconomics.wiki/concept/ex-ante-evaluation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/ex-ante-evaluation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-evaluation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/economic-evaluation"/>
        <skos:notation>HE-EE-EM-001</skos:notation>
        <dcterms:identifier>HE-EE-EM-001</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Ex-Ante Evaluation</rdfs:label>
        <skos:definition xml:lang="en">An economic evaluation conducted before an intervention has been implemented, typically relying on modelled projections rather than observed outcome data.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Before-Implementation Evaluation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Forward-Looking Evaluation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Ex-Ante Evaluation</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/ex-post-evaluation"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/health-economic-model"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/ex-ante-evaluation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-evaluation"/>
        <dcterms:identifier>HEO-L-ecfbf2535e15</dcterms:identifier>
        <linkRationale xml:lang="en">Ex-ante evaluation is an economic evaluation</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/ex-ante-evaluation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/ex-post-evaluation"/>
        <dcterms:identifier>HEO-L-eb1a51ad87f0</dcterms:identifier>
        <linkRationale xml:lang="en">Before and after implementation are the two alternatives</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
