    <!-- https://healtheconomics.wiki/concept/screening-economics -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/screening-economics">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/prevention-economics"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/prevention-economics"/>
        <skos:notation>HE-PE-CD-056</skos:notation>
        <dcterms:identifier>HE-PE-CD-056</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Screening Economics</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Economics of Screening</skos:altLabel>
        <skos:definition xml:lang="en">The economic assessment of a screening programme’s full pathway, comparing its costs, health benefits, harms, budget implications and opportunity costs with feasible alternatives.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Early-Detection Economics</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Screening Economics</skos:prefLabel>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/screening-programme"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-7"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/screening-economics"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/prevention-economics"/>
