    <!-- https://healtheconomics.wiki/concept/development-impact-bond -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/development-impact-bond">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/results-based-financing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/results-based-financing"/>
        <skos:notation>HS-HP-HF-017</skos:notation>
        <dcterms:identifier>HS-HP-HF-017</dcterms:identifier>
        <dcterms:source>Gustafsson-Wright, Gardiner &amp; Putcha 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Development Impact Bond</rdfs:label>
        <skos:altLabel xml:lang="en">DIB</skos:altLabel>
        <skos:definition xml:lang="en">A financing mechanism where private investors fund a social programme upfront, repaid by an outcome funder only if predefined results are verified.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Outcome-Funded Bond</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Development Impact Bond</skos:prefLabel>
        <abbreviation xml:lang="en">DIB</abbreviation>
        <counterpartOf rdf:resource="https://healtheconomics.wiki/concept/social-impact-bond"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/donor-funding"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/development-impact-bond"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/results-based-financing"/>
        <dcterms:identifier>HEO-L-3b0cb29db3bf</dcterms:identifier>
        <linkRationale xml:lang="en">Outcomes-Based Payment is a manufacturer drug reimbursement deal; a DIB conditions repayment on verified results in development, i.e. results-based financing</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/development-impact-bond"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#counterpartOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/social-impact-bond"/>
        <dcterms:identifier>HEO-L-2f701708a1f7</dcterms:identifier>
        <linkRationale xml:lang="en">DIB plays the SIB role in development settings with an outcome funder in place of government</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/development-impact-bond"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/donor-funding"/>
        <dcterms:identifier>HEO-L-a3cb3560dbaa</dcterms:identifier>
        <linkRationale xml:lang="en">In a DIB the outcome funder repaying investors is usually a donor agency, unlike a government in a social impact bond</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/deviance-residual -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/deviance-residual">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/residual"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/residual"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/goodness-of-fit"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/outlier"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/model-diagnostics"/>
        <skos:notation>HE-EM-SM-016</skos:notation>
        <dcterms:identifier>HE-EM-SM-016</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-02</dcterms:modified>
        <dcterms:source>McCullagh &amp; Nelder 1989</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Deviance Residual</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Deviance Residuals</skos:altLabel>
        <skos:definition xml:lang="en">A deviance residual is a signed measure of how poorly a generalised linear or survival model fits each patient; in a GLM its squares sum to the deviance.</skos:definition>
        <skos:hiddenLabel xml:lang="en">GLM Residual</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Deviance Residual</skos:prefLabel>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/generalized-linear-model"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/deviance-residual"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/residual"/>
        <dcterms:identifier>HEO-L-00a1a97a6953</dcterms:identifier>
        <linkRationale xml:lang="en">a deviance residual is a form of residual from a fitted model</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/deviance-residual"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
