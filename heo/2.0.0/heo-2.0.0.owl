        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Resource Management</rdfs:label>
        <skos:definition xml:lang="en">The processes an organisation uses to plan, allocate, and monitor available resources, including staff and equipment, to achieve its objectives.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Asset Management</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Resource Stewardship</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Resource Management</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/operational-efficiency"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/resource-management"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
