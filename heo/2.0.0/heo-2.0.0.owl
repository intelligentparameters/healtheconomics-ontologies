    <!-- https://healtheconomics.wiki/concept/devolution -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/devolution">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/decentralization"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/decentralization"/>
        <skos:notation>HS-SS-HSG-002</skos:notation>
        <dcterms:identifier>HS-SS-HSG-002</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</dcterms:modified>
        <dcterms:source>Vrangbæk 2007</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Devolution</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:definition xml:lang="en">Devolution is the transfer of formal responsibility and power over health services from central government to elected regional or local governments.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Authority Transfer</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Subnational Autonomy</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Devolution</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/centralized-system"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/federal-system"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/devolution"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/decentralization"/>
        <dcterms:identifier>HEO-L-a981652beee4</dcterms:identifier>
        <linkRationale xml:lang="en">devolution is decentralisation to elected subnational governments</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/devolution"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/centralized-system"/>
        <dcterms:identifier>HEO-L-5127f282fc82</dcterms:identifier>
        <linkRationale xml:lang="en">devolution moves authority away from the centre, the opposite of a centralised system</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/devolution"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/federal-system"/>
        <dcterms:identifier>HEO-L-cdd413bd410a</dcterms:identifier>
        <linkRationale xml:lang="en">devolution delegates power within a state while federalism divides it constitutionally; a standard contrast</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/dfbeta -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/dfbeta">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/model-validation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/model-validation"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/influential-observation"/>
        <skos:notation>HE-EM-MV-018</skos:notation>
        <dcterms:identifier>HE-EM-MV-018</dcterms:identifier>
        <dcterms:source>Belsley, Kuh &amp; Welsch 1980</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">DFBETA</rdfs:label>
        <skos:altLabel xml:lang="en">Delta-Beta</skos:altLabel>
        <skos:definition xml:lang="en">A regression diagnostic measuring how much a coefficient would change if a particular observation were removed, identifying disproportionately influential data points.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Coefficient Change Diagnostic</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">DFBETA</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/dfbetas"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-9"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/dfbeta"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/model-validation"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-d2337b771aaa</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Model validation and calibration in subdomain Economic Modelling; placed under Model Validation, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/dfbeta"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/influential-observation"/>
        <dcterms:identifier>HEO-L-1fe6f044bc52</dcterms:identifier>
        <linkRationale xml:lang="en">DFBETA quantifies an observation&apos;s influence</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/dfbeta"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/dfbetas"/>
        <dcterms:identifier>HEO-L-579e5555ef83</dcterms:identifier>
        <linkRationale xml:lang="en">unstandardised and standardised influence diagnostics are alternative versions of the same measure</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/dfbetas -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/dfbetas">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/influential-observation"/>
