    <!-- https://healtheconomics.wiki/concept/dfle-calculation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/dfle-calculation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:notation>HE-EE-HU-015</skos:notation>
        <dcterms:identifier>HE-EE-HU-015</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Robine &amp; Ritchie 1991</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">DFLE Calculation</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Disability-Free Life Expectancy Calculation</skos:altLabel>
        <skos:definition xml:lang="en">The process of computing disability-free life expectancy using a life table combining age-specific mortality rates with age-specific disability prevalence.</skos:definition>
        <skos:hiddenLabel xml:lang="en">DFLE Estimation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">DFLE Calculation</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/outcomes#step-2"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/disability-free-expectancy"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/life-table"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/sullivan-method"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/dfle-calculation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-5f4a8d13127c</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Health utility and preference elicitation in subdomain Outcomes</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/dfle-calculation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#produces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/disability-free-expectancy"/>
        <dcterms:identifier>HEO-L-be9cc1708090</dcterms:identifier>
        <linkRationale xml:lang="en">the calculation yields disability-free life expectancy, per both definitions</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/dfle-calculation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/life-table"/>
        <dcterms:identifier>HEO-L-f7ed005c0026</dcterms:identifier>
        <linkRationale xml:lang="en">Life Table Method is a survival-estimation technique; DFLE calculation uses a life table, per its definition</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
