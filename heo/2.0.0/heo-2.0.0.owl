        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/outcomes#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/allocation-method"/>
