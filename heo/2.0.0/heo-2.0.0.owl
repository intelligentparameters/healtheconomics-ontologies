        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">OWSA</skos:altLabel>
        <skos:altLabel xml:lang="en">One-Way Sensitivity</skos:altLabel>
        <skos:altLabel xml:lang="en">Univariate Sensitivity</skos:altLabel>
        <skos:altLabel xml:lang="en">Univariate Sensitivity Analysis</skos:altLabel>
        <skos:definition xml:lang="en">One-way sensitivity analysis (OWSA) varies one model input at a time, holding the rest at base case, to show which inputs drive cost-effectiveness results.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Single-Parameter Sensitivity</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">One-Way Sensitivity Analysis</skos:prefLabel>
        <abbreviation xml:lang="en">OWSA</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/two-way-sensitivity-analysis"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-10"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/tornado-diagram"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/one-way-sensitivity-analysis"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
