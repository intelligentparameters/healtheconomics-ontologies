        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/return-to-baseline -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/return-to-baseline">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/missing-data-methods"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/missing-data-methods"/>
        <skos:notation>HE-ES-SA-184</skos:notation>
        <dcterms:identifier>HE-ES-SA-184</dcterms:identifier>
        <dcterms:source>Carpenter &amp; Kenward 2013</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Return to Baseline</rdfs:label>
        <skos:definition xml:lang="en">A missing data method assuming a patient&apos;s outcome trajectory reverts to their original pre-treatment level from the point of discontinuation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Baseline Return</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Reversion to Baseline</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Return to Baseline</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/jump-to-reference"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/return-to-baseline"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/missing-data-methods"/>
        <dcterms:identifier>HEO-L-291652e3a36e</dcterms:identifier>
        <linkRationale xml:lang="en">Return to baseline is defined as a missing data method, not a clinical outcome.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/return-to-baseline"/>
