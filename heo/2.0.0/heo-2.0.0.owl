        <skos:hiddenLabel xml:lang="en">Pain-Related Interference</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Pain Interference</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
