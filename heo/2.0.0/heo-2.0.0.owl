        <skos:altLabel xml:lang="en">KT</skos:altLabel>
        <skos:altLabel xml:lang="en">Knowledge Mobilisation</skos:altLabel>
        <skos:definition xml:lang="en">The exchange, synthesis, and application of research knowledge to improve health outcomes, moving evidence from research into practice and policy.</skos:definition>
        <skos:prefLabel xml:lang="en">Knowledge Translation</skos:prefLabel>
        <abbreviation xml:lang="en">KT</abbreviation>
