    <!-- https://healtheconomics.wiki/concept/stark-law -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/stark-law">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/regulation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/regulation"/>
        <skos:notation>HS-HP-HSR-059</skos:notation>
        <dcterms:identifier>HS-HP-HSR-059</dcterms:identifier>
        <dcterms:source>US, Stark Law (Physician Self-Referral Law)</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Stark Law</rdfs:label>
        <skos:altLabel xml:lang="en">Physician Self-Referral Law</skos:altLabel>
        <skos:definition xml:lang="en">A US federal law, the physician self-referral law, prohibiting physicians referring patients for designated health services to entities they have financial ties with.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Stark Statute</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Stark Law</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/self-referral"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/stark-law"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/regulation"/>
        <dcterms:identifier>HEO-L-a7879158e121</dcterms:identifier>
        <linkRationale xml:lang="en">Stark Law is a current US federal rule on provider conduct.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/stark-law"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/self-referral"/>
        <dcterms:identifier>HEO-L-4ab05b6dcab5</dcterms:identifier>
