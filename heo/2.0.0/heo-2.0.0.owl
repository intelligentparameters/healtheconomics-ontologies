        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Shared Savings Programme</rdfs:label>
        <skos:definition xml:lang="en">A formal value-based payment programme in which providers earn a share of savings relative to a benchmark, provided quality standards are met.</skos:definition>
