    <!-- https://healtheconomics.wiki/concept/output-maximisation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/output-maximisation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HE-EE_EA-037</skos:notation>
        <dcterms:identifier>HE-EE_EA-037</dcterms:identifier>
        <dcterms:source>Varian 2014</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Output Maximisation</rdfs:label>
        <skos:altLabel xml:lang="en">Output Maximization</skos:altLabel>
        <skos:definition xml:lang="en">An objective in production theory of achieving the greatest possible output from a given set of inputs.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Output-Oriented Efficiency</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Output Maximisation</skos:prefLabel>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/technical-efficiency"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/output-maximisation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-e4c1a606e113</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Efficiency Analysis: every concept with this Level 3 that the wiki places in a topic sits in Health Systems (Performance, productivity and quality)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/output-maximisation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isFoundationFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/technical-efficiency"/>
        <dcterms:identifier>HEO-L-eb59d7557a2b</dcterms:identifier>
        <linkRationale xml:lang="en">An objective is not an efficiency state; output-oriented technical efficiency is defined by maximising outputs from given inputs (object definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


