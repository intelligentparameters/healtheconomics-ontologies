        <rdfs:label xml:lang="en">Clinical Integration</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Clinical integration is the coordination of a patient&apos;s care across professionals, services and settings so that it runs as one continuous process.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Clinical Service Integration</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Integrated Clinical Delivery</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Clinical Integration</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/vertically-integrated"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/continuity-of-care"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/care-pathway"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/electronic-health-record"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/clinical-integration"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
