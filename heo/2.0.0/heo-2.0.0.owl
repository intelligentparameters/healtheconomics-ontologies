        <dcterms:identifier>HE-ES-CER-005</dcterms:identifier>
        <dcterms:source>FDA-NIH Biomarker Working Group 2016</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Clinical Utility</rdfs:label>
        <skos:altLabel xml:lang="en">Clinical Usefulness</skos:altLabel>
        <skos:definition xml:lang="en">The degree to which using a test, biomarker, or intervention meaningfully improves patient outcomes in actual practice, beyond mere analytical accuracy.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Practical Utility</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Clinical Utility</skos:prefLabel>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/biomarker"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
