    <!-- https://healtheconomics.wiki/concept/robust-optimisation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/robust-optimisation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/optimisation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/optimisation"/>
        <skos:notation>HE-EM-DM-086</skos:notation>
        <dcterms:identifier>HE-EM-DM-086</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Ben-Tal &amp; Nemirovski 1998</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Robust Optimisation</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Robust Optimization</skos:altLabel>
        <skos:definition xml:lang="en">An optimisation approach that selects a feasible decision to perform well under the worst parameter values in a specified uncertainty set, often requiring constraints to hold throughout that set.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Worst-Case Optimisation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Robust Optimisation</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/parameter-uncertainty"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-12"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/scenario-analysis"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/robust-optimisation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/optimisation"/>
        <dcterms:identifier>HEO-L-402a17487011</dcterms:identifier>
        <linkRationale xml:lang="en">Robust optimisation is an optimisation approach.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/robust-optimisation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#addresses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/parameter-uncertainty"/>
        <dcterms:identifier>HEO-L-feacf39a3b10</dcterms:identifier>
        <linkRationale xml:lang="en">Robust optimisation is designed for uncertain parameters.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
