    <!-- https://healtheconomics.wiki/concept/interpretation-error -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/interpretation-error">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-DS-BV-016</skos:notation>
        <dcterms:identifier>HE-DS-BV-016</dcterms:identifier>
        <dcterms:source>Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams &amp; Wilkins; 2008.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Interpretation Error</rdfs:label>
        <skos:definition xml:lang="en">A mistake arising when correctly calculated results are misunderstood or miscommunicated, such as mistaking a relative risk for an absolute risk difference.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Misinterpretation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Result Misreading</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Interpretation Error</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/analysis-error"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/evidence-based-decision-making"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/interpretation-error"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-923a68de78b9</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Bias &amp; Validity: catalogue subdomain Evidence Synthesis is one of the subdomains</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/interpretation-error"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/analysis-error"/>
        <dcterms:identifier>HEO-L-b713b9ec8110</dcterms:identifier>
        <linkRationale xml:lang="en">An interpretation error misreads correctly calculated results, unlike an error in the analysis itself</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
