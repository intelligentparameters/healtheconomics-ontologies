    <!-- https://healtheconomics.wiki/concept/inter-rater-reliability -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/inter-rater-reliability">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-assessment"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q470749"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-assessment"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/reliability-assessment"/>
        <skos:notation>HE-ES-EA-025</skos:notation>
        <dcterms:identifier>HE-ES-EA-025</dcterms:identifier>
        <dcterms:source>Landis &amp; Koch 1977</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Inter-Rater Reliability</rdfs:label>
        <skos:definition xml:lang="en">The degree of agreement between two or more independent observers assessing the same phenomenon, commonly quantified using a statistic such as Cohen&apos;s kappa.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Inter-Observer Agreement</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Inter-Rater Agreement</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Inter-Rater Reliability</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/intra-rater-reliability"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/clinician-reported-outcome"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-4"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
