    <!-- https://healtheconomics.wiki/concept/net-margin -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/net-margin">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
