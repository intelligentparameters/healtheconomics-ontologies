    <!-- https://healtheconomics.wiki/concept/disclosure-intervention -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/disclosure-intervention">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/nudge-intervention"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/nudge-intervention"/>
        <skos:notation>HE-EE-BE-014</skos:notation>
        <dcterms:identifier>HE-EE-BE-014</dcterms:identifier>
        <dcterms:source>Sunstein 2011</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Disclosure Intervention</rdfs:label>
        <skos:definition xml:lang="en">A policy requiring or encouraging the provision of information, such as nutrition labelling or price transparency, to influence decisions.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Information Disclosure</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Transparency Intervention</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Disclosure Intervention</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/information-asymmetry"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/decision-making"/>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/price-transparency"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/disclosure-intervention"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/nudge-intervention"/>
        <dcterms:identifier>HEO-L-8b37dbb040a5</dcterms:identifier>
        <linkRationale xml:lang="en">a disclosure policy is not the smallest replicable component of a programme; mandated disclosure is a standard nudge (Sunstein 2014)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/disclosure-intervention"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#addresses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/information-asymmetry"/>
        <dcterms:identifier>HEO-L-c5a1a4e37c82</dcterms:identifier>
        <linkRationale xml:lang="en">Disclosure policies target information gaps; definition cites price transparency</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
