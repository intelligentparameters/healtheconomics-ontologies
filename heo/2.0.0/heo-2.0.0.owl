    <!-- https://healtheconomics.wiki/concept/redistribution -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/redistribution">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:notation>HE-EE-EP-029</skos:notation>
        <dcterms:identifier>HE-EE-EP-029</dcterms:identifier>
        <dcterms:source>Musgrave &amp; Musgrave 1989</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Redistribution</rdfs:label>
        <skos:definition xml:lang="en">The transfer of resources across individuals or groups in a society, typically from higher to lower income populations, through mechanisms such as progressive taxation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Income Transfer</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Wealth Reallocation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Redistribution</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/equity"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/redistribution"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
