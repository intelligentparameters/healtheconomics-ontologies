    <!-- https://healtheconomics.wiki/concept/readmission -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/readmission">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/admissions"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/admissions"/>
        <skos:notation>HS-HP-HSP-004</skos:notation>
        <dcterms:identifier>HS-HP-HSP-004</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Donabedian A. Evaluating the quality of medical care. Milbank Memorial Fund Quarterly. 1966;44(3):166?206. doi:10.2307/3348969.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Readmission</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Rehospitalisation</skos:altLabel>
        <skos:definition xml:lang="en">A subsequent inpatient hospital admission after discharge from a qualifying earlier admission, counted using a specified follow-up window, eligibility rule and treatment of planned returns and transfers.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Return Admission</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Readmission</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/readmission"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/admissions"/>
        <dcterms:identifier>HEO-L-07d972f3b8f1</dcterms:identifier>
        <linkRationale xml:lang="en">A readmission is a hospital admission.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/readmission-management -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/readmission-management">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/care-management"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/care-management"/>
        <skos:notation>HS-SS_HD-023</skos:notation>
        <dcterms:identifier>HS-SS_HD-023</dcterms:identifier>
        <dcterms:source>CMS, Hospital Readmissions Reduction Program</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Readmission Management</rdfs:label>
        <skos:definition xml:lang="en">The strategies used to identify patients at high risk of hospital readmission and implement targeted interventions to prevent avoidable returns.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Rehospitalisation Reduction</skos:hiddenLabel>
