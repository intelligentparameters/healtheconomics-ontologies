    <!-- https://healtheconomics.wiki/concept/control-variates -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/control-variates">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/variance-reduction"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/variance-reduction"/>
        <skos:notation>HE-EM-UA-013</skos:notation>
        <dcterms:identifier>HE-EM-UA-013</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Owen 2013</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Control Variates</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:altLabel xml:lang="en">Control Variate Method</skos:altLabel>
        <skos:definition xml:lang="en">Control variates is a variance reduction method that corrects a Monte Carlo estimate, such as mean cost or QALYs, using a correlated output of known mean.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Variance Reduction via Controls</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Control Variates</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-10"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/correlation"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/linear-regression"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/control-variates"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/variance-reduction"/>
        <dcterms:identifier>HEO-L-7b0140736d91</dcterms:identifier>
        <linkRationale xml:lang="en">A variance reduction method</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/control-variates"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/correlation"/>
        <dcterms:identifier>HEO-L-09ffd8a517e9</dcterms:identifier>
        <linkRationale xml:lang="en">Relies on correlation with the control output</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
