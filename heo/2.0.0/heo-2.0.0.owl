        <dcterms:identifier>HE-EE-HE-002</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-09</dcterms:modified>
        <dcterms:source>Coady, Grosh &amp; Hoddinott 2004</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Categorical Targeting</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Categorical targeting makes everyone in an easily observed group, such as children or older people, eligible for a benefit without testing individual need.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Categorical Eligibility</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Group-Based Targeting</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Categorical Targeting</skos:prefLabel>
