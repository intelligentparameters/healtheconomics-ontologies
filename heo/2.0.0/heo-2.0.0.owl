    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/incidence -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/incidence">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/epidemiology"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/epidemiology"/>
        <skos:notation>HE-ES-EP-019</skos:notation>
        <dcterms:identifier>HE-ES-EP-019</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams &amp; Wilkins; 2008.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Incidence</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">The number of new cases of a disease occurring within a defined population over a specified period, unlike prevalence, which counts existing cases.</skos:definition>
        <skos:hiddenLabel xml:lang="en">New-Case Frequency</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">New-Case Rate</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Incidence</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/prevalence"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/incidence"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/epidemiology"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-4ef8f8642dbf</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Epidemiology and risk measures in subdomain Evidence Synthesis; placed under Epidemiology, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/incidence"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/prevalence"/>
        <dcterms:identifier>HEO-L-df682823e794</dcterms:identifier>
        <linkRationale xml:lang="en">Incidence&apos;s only remaining link; the symmetric reverse on Prevalence should be the one removed.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/incidence-rate -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/incidence-rate">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/incidence"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/incidence"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/incidence-rate-ratio"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/rate-difference"/>
        <skos:notation>HE-ES-EP-020</skos:notation>
        <dcterms:identifier>HE-ES-EP-020</dcterms:identifier>
        <dcterms:source>Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams &amp; Wilkins; 2008.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Incidence Rate</rdfs:label>
        <skos:altLabel xml:lang="en">Incidence Density</skos:altLabel>
        <skos:altLabel xml:lang="en">Person-Time Rate</skos:altLabel>
        <skos:definition xml:lang="en">A measure of disease frequency calculated as new cases divided by total person-time at risk observed, accounting for varying follow-up lengths.</skos:definition>
        <skos:prefLabel xml:lang="en">Incidence Rate</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-2"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
