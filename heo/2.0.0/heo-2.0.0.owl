    <!-- https://healtheconomics.wiki/concept/dual-therapy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/dual-therapy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/combination-therapy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/combination-therapy"/>
        <precedes rdf:resource="https://healtheconomics.wiki/concept/triple-therapy"/>
        <skos:notation>HE-PE-DT-018</skos:notation>
        <dcterms:identifier>HE-PE-DT-018</dcterms:identifier>
        <dcterms:source>Katzung 2017</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Dual Therapy</rdfs:label>
        <skos:altLabel xml:lang="en">Doublet Therapy</skos:altLabel>
        <skos:altLabel xml:lang="en">Two-Drug Regimen</skos:altLabel>
        <skos:definition xml:lang="en">A treatment regimen combining exactly two distinct agents, commonly used when a single agent alone does not achieve adequate disease control.</skos:definition>
        <skos:prefLabel xml:lang="en">Dual Therapy</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/dual-therapy"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/combination-therapy"/>
        <dcterms:identifier>HEO-L-ceb107d64537</dcterms:identifier>
        <linkRationale xml:lang="en">two agents together is combination therapy</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/dual-therapy"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#precedes"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/triple-therapy"/>
        <dcterms:identifier>HEO-L-56316866214d</dcterms:identifier>
