    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/baseline-risk"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/relative-risk"/>
        <dcterms:identifier>HEO-L-4d804eba2bc6</dcterms:identifier>
        <linkRationale xml:lang="en">Relative risk is the treatment-arm risk divided by the comparator (baseline) risk</linkRationale>
