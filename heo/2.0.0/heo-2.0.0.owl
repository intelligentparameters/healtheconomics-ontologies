    <!-- https://healtheconomics.wiki/concept/palliative-care-economics-oncology -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/palliative-care-economics-oncology">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
