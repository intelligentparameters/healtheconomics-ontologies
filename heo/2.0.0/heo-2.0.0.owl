        <skos:prefLabel xml:lang="en">Special Access Scheme</skos:prefLabel>
        <counterpartOf rdf:resource="https://healtheconomics.wiki/concept/expanded-access"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
