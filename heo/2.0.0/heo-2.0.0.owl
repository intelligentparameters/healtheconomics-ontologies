        <skos:notation>HS-DC-MA-009</skos:notation>
        <dcterms:identifier>HS-DC-MA-009</dcterms:identifier>
        <dcterms:source>Carlson JJ, Sullivan SD, Garrison LP, Neumann PJ, Veenstra DL. Linking payment to health outcomes: a taxonomy and examination of performance-based reimbursement schemes. Health Policy. 2010;96(3):179-190.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Free Goods</rdfs:label>
        <skos:definition xml:lang="en">Units of a treatment provided by a manufacturer at no cost, often used within a managed entry agreement to offset non-responder costs.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Free Stock</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Free-of-Charge Units</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Free Goods</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/drug-cost"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/free-goods"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/market-access"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-1cea7e66f914</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Drug Costs &gt; Market Access: concepts with this Level 3 that the wiki places in a topic sit in HTA (Reimbursement and managed access); placed under Market Access, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/free-goods"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/managed-entry-agreement"/>
        <dcterms:identifier>HEO-L-305f036c19d3</dcterms:identifier>
        <linkRationale xml:lang="en">Free goods schemes are a financial term within some managed entry agreements, per the subject definition</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/free-goods"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-cost"/>
        <dcterms:identifier>HEO-L-a11db705bcdf</dcterms:identifier>
