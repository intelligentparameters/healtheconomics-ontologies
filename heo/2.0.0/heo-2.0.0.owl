        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Flexible Spending Account</rdfs:label>
        <skos:altLabel xml:lang="en">FSA</skos:altLabel>
        <skos:definition xml:lang="en">A US tax-advantaged account letting employees set aside pre-tax income for eligible healthcare expenses, typically subject to a use-it-or-lose-it rule.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Pre-Tax Health Account</skos:hiddenLabel>
