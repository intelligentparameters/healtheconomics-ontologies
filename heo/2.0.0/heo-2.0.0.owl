    <!-- https://healtheconomics.wiki/concept/unimodal-hazard -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/unimodal-hazard">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/time-varying-hazard"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/time-varying-hazard"/>
        <skos:notation>HE-EM-SM-089</skos:notation>
        <dcterms:identifier>HE-EM-SM-089</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Collett 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Unimodal Hazard</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Hump-Shaped Hazard</skos:altLabel>
        <skos:definition xml:lang="en">A hazard function that rises to a single peak and then declines over follow-up, rather than a monotonic or bathtub pattern.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Single-Peak Hazard</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Unimodal Hazard</skos:prefLabel>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/log-logistic-distribution"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/unimodal-hazard"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/time-varying-hazard"/>
        <dcterms:identifier>HEO-L-9d82f95bad7a</dcterms:identifier>
        <linkRationale xml:lang="en">A unimodal hazard changes over time.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
