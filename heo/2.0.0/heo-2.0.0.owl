        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>WHO 2022</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Contact Tracing</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:definition xml:lang="en">Contact tracing finds and follows up people exposed to an infectious case so they can be tested, treated or quarantined before infecting others.</skos:definition>
