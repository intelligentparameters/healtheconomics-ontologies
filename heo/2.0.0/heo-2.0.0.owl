    <!-- https://healtheconomics.wiki/concept/renal-dosing-alert -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/renal-dosing-alert">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
