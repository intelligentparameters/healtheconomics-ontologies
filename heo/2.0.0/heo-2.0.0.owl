    <!-- https://healtheconomics.wiki/concept/indirect-evidence -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/indirect-evidence">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/network-meta-analysis"/>
        <skos:notation>HE-ES-ESM-028</skos:notation>
        <dcterms:identifier>HE-ES-ESM-028</dcterms:identifier>
        <dcterms:source>Dias et al. 2013</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Indirect Evidence</rdfs:label>
        <skos:definition xml:lang="en">Within network meta-analysis, evidence comparing two treatments derived through a chain of comparisons via a common comparator, not from direct trials.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Chained Evidence</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Indirect NMA Evidence</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Indirect Evidence</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/indirect-evidence"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-a7bd34dff96d</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Evidence Synthesis Methods: catalogue subdomain Evidence Synthesis is one of the subdomains</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/indirect-evidence"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/network-meta-analysis"/>
        <dcterms:identifier>HEO-L-297a13fc2d3a</dcterms:identifier>
        <linkRationale xml:lang="en">Indirect evidence is one of the two evidence sources NMA pools (object definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/indirect-treatment-comparison -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/indirect-treatment-comparison">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-ES-CER-017</skos:notation>
        <dcterms:identifier>HE-ES-CER-017</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-03</dcterms:modified>
        <dcterms:source>HTA CG 2024</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Indirect Treatment Comparison</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">ITC</skos:altLabel>
        <skos:definition xml:lang="en">Indirect treatment comparison (ITC) is the umbrella term for methods, such as NMA or MAIC, that compare treatments no trial has tested head to head.</skos:definition>
        <skos:prefLabel xml:lang="en">Indirect Treatment Comparison</skos:prefLabel>
        <abbreviation xml:lang="en">ITC</abbreviation>
        <assumes rdf:resource="https://healtheconomics.wiki/concept/transitivity"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/head-to-head-comparison"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-4"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/indirect-evidence"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/indirect-treatment-comparison"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:identifier>HEO-L-69cb96f85698</dcterms:identifier>
        <linkRationale xml:lang="en">An evidence synthesis method.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
