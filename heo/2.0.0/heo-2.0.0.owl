    <!-- https://healtheconomics.wiki/concept/population-health-management -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/population-health-management">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
