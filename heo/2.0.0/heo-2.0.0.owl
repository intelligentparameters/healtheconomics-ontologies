    <!-- https://healtheconomics.wiki/concept/market-equilibrium -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/market-equilibrium">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/equilibrium"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q3589455"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/equilibrium"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/producer-surplus"/>
        <skos:notation>HE-EE-ME-034</skos:notation>
        <dcterms:identifier>HE-EE-ME-034</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-26</dcterms:modified>
        <dcterms:source>Varian 2014</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Market Equilibrium</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">Market equilibrium is a price-and-quantity outcome at which planned demand equals planned supply for a specified good or service under the conditions of a stated market model.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Clearing Equilibrium</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Market Clearing</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Supply-Demand Equilibrium</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Market Equilibrium</skos:prefLabel>
        <benchmarkFor rdf:resource="https://healtheconomics.wiki/concept/price-distortion"/>
        <benchmarkFor rdf:resource="https://healtheconomics.wiki/concept/quantity-distortion"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/welfare-theorem"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/market-equilibrium"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/equilibrium"/>
        <dcterms:identifier>HEO-L-8a2b0f8ea062</dcterms:identifier>
        <linkRationale xml:lang="en">A market equilibrium is an equilibrium</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
