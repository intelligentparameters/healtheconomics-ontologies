    <!-- https://healtheconomics.wiki/concept/monotonic-hazard -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/monotonic-hazard">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/time-varying-hazard"/>
