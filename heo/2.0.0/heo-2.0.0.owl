    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/meta-analysis"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/funnel-plot-analysis"/>
        <dcterms:identifier>HEO-L-6dac0f11dea8</dcterms:identifier>
        <linkRationale xml:lang="en">A meta-analysis may use funnel plot analysis to check publication bias; it is an add-on check, not a constituent</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
