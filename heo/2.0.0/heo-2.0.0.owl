        <skos:altLabel xml:lang="en">FMEA</skos:altLabel>
        <skos:altLabel xml:lang="en">Failure Mode and Effects Analysis</skos:altLabel>
        <skos:definition xml:lang="en">A structured method proactively identifying and evaluating potential failure modes, along with their likely severity and detectability, to prioritise preventive action.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Failure Mode Analysis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Failure Mode Effects Analysis</skos:prefLabel>
        <abbreviation xml:lang="en">FMEA</abbreviation>
