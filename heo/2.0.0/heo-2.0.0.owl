    <!-- https://healtheconomics.wiki/concept/producer-surplus -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/producer-surplus">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/welfare-economics"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/welfare-economics"/>
        <skos:notation>HE-EE-WE-016</skos:notation>
        <dcterms:identifier>HE-EE-WE-016</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Marshall 1890</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Producer Surplus</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">The difference between the price a producer receives and the minimum they would have accepted, the net benefit they gain from a transaction.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Producer Benefit</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Supplier Surplus</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Producer Surplus</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/consumer-surplus"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/producer-surplus"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/welfare-economics"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-ae93cf0729b8</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Welfare Economics: welfarism and extra-welfarism are the normative basis of cost-benefit and cost-effectiveness analysis; placed under Welfare Economics, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/producer-surplus"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/consumer-surplus"/>
        <dcterms:identifier>HEO-L-c89c0a18d965</dcterms:identifier>
        <linkRationale xml:lang="en">Producer and consumer surplus are the paired opposing sides of total surplus.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/producer-theory -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/producer-theory">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <skos:notation>HE-EE-ME-058</skos:notation>
        <dcterms:identifier>HE-EE-ME-058</dcterms:identifier>
        <dcterms:source>Varian 2014</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Producer Theory</rdfs:label>
        <skos:definition xml:lang="en">The branch of microeconomic theory analysing how firms choose inputs and output levels to maximise profit given their costs and market conditions.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Supply-Side Theory</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Theory of the Firm</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Producer Theory</skos:prefLabel>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/expansion-path"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/producer-surplus"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/supply"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/producer-theory"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-5cb1338f0553</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Demand supply and markets in subdomain Economic Foundations</linkRationale>
