    <!-- https://healtheconomics.wiki/concept/network-referral -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/network-referral">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/referral"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
