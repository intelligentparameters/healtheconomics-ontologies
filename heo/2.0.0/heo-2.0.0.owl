    <!-- https://healtheconomics.wiki/concept/harm-rate -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/harm-rate">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/quality-indicator"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/quality-indicator"/>
        <skos:notation>HS-HP-HQ-017</skos:notation>
        <dcterms:identifier>HS-HP-HQ-017</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-24</dcterms:modified>
        <dcterms:source>Institute for Healthcare Improvement, Global Trigger Tool</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Harm Rate</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A harm rate is the frequency of a defined adverse outcome divided by the corresponding person-time at risk or exposure, with its meaning depending on whether first or recurrent events are counted.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Harm Frequency</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Patient Injury Rate</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Harm Rate</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/harm-rate"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/quality-indicator"/>
        <dcterms:identifier>HEO-L-6ad6dbfb6653</dcterms:identifier>
        <linkRationale xml:lang="en">Harm rates are patient safety indicators</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/harrell-c-index -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/harrell-c-index">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
