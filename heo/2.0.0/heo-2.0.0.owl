        <dcterms:source>White 1980</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Sandwich Estimator</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Huber-White Estimator</skos:altLabel>
        <skos:altLabel xml:lang="en">Robust Variance Estimator</skos:altLabel>
        <skos:definition xml:lang="en">A method calculating an estimator&apos;s variance that remains valid even when standard model assumptions are violated, forming the basis of robust standard errors.</skos:definition>
