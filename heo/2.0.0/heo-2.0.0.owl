        <skos:notation>HS-HP-HI-193</skos:notation>
        <dcterms:identifier>HS-HP-HI-193</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Take-Up Rate</rdfs:label>
        <skos:definition xml:lang="en">The proportion of individuals eligible for an insurance product or subsidy who actually enrol, assessing a coverage programme&apos;s effectiveness.</skos:definition>
