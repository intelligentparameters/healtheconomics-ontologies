    <!-- https://healtheconomics.wiki/concept/human-capital-approach -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/human-capital-approach">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/productivity-cost"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/productivity-value"/>
        <skos:notation>HE-EE-CBA-025</skos:notation>
        <dcterms:identifier>HE-EE-CBA-025</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-26</dcterms:modified>
        <dcterms:source>Rice 1966</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Human Capital Approach</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Human Capital Method</skos:altLabel>
        <skos:definition xml:lang="en">A way to value productivity lost to illness or premature death by applying an economic value, often based on earnings, to forgone productive time.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Human Capital Valuation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Wage-Based Productivity Valuation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Human Capital Approach</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/costs#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/economic-life-years"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/human-capital-approach"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-f2cb457a6b84</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Productivity and indirect costs in subdomain Costs</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/human-capital-approach"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/productivity-cost"/>
        <dcterms:identifier>HEO-L-f50f6d865a45</dcterms:identifier>
        <linkRationale xml:lang="en">The human capital approach values lost productive time, which is the productivity cost</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/human-capital-approach"/>
