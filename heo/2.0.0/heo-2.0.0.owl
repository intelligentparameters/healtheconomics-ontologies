    <!-- https://healtheconomics.wiki/concept/data-extraction -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/data-extraction">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
