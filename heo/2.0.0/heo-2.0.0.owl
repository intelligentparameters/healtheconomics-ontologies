        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">GLM</skos:altLabel>
        <skos:definition xml:lang="en">A modelling framework extending linear regression to non-normal outcomes, such as binary or count data, via a specified link function.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Link-Function Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Generalized Linear Model</skos:prefLabel>
        <abbreviation xml:lang="en">GLM</abbreviation>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/skewness"/>
