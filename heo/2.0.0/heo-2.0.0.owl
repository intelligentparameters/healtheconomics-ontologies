        <skos:notation>HS-DC-DP-018</skos:notation>
        <dcterms:identifier>HS-DC-DP-018</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Morgan et al. 2017</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Confidential Pricing</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Confidential pricing keeps a medicine&apos;s negotiated net price secret between manufacturer and payer, while a higher list price stays public.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Confidential Discount Arrangement</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Undisclosed Pricing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Confidential Pricing</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/price-transparency"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/confidential-price"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/confidential-discount"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/confidential-pricing"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <dcterms:identifier>HEO-L-bbb4132a00cd</dcterms:identifier>
        <linkRationale xml:lang="en">An approach to medicine pricing</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
