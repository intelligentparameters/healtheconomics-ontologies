        <skos:prefLabel xml:lang="en">Rural Access</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/health-inequality"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
