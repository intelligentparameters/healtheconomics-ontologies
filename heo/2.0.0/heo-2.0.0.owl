        <dcterms:source>Kaplan &amp; Bush 1982</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Quality of Well-Being Scale</rdfs:label>
        <skos:altLabel xml:lang="en">QWB</skos:altLabel>
        <skos:definition xml:lang="en">A generic, preference-based health status instrument combining physical, social, and mobility functioning with symptom complexes into a single index anchored between zero and one.</skos:definition>
        <skos:hiddenLabel xml:lang="en">QWB-SA</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Quality of Well-Being Scale</skos:prefLabel>
