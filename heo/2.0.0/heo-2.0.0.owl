    <!-- https://healtheconomics.wiki/concept/pro-poor-policy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/pro-poor-policy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:notation>HS-HP-HE-026</skos:notation>
        <dcterms:identifier>HS-HP-HE-026</dcterms:identifier>
        <dcterms:source>O&apos;Donnell et al. 2008</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Pro-Poor Policy</rdfs:label>
        <skos:definition xml:lang="en">A health policy designed to benefit lower-income populations disproportionately, intended to reduce inequities by directing more resources their way.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Equity-Oriented Policy</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Poverty-Targeted Policy</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Pro-Poor Policy</skos:prefLabel>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/health-equity"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/pro-poor-policy"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <dcterms:identifier>HEO-L-f9aacaf738e6</dcterms:identifier>
        <linkRationale xml:lang="en">A pro-poor policy is a health policy per its definition.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/pro-poor-policy"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#promotes"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-equity"/>
        <dcterms:identifier>HEO-L-c0c2348ea258</dcterms:identifier>
