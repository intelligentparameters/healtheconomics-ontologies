        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Stable Disease</rdfs:label>
        <skos:definition xml:lang="en">A standardised tumour response classification for a tumour that has neither shrunk enough for a partial response nor grown enough for progressive disease.</skos:definition>
