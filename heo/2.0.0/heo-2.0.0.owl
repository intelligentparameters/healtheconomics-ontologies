    <!-- https://healtheconomics.wiki/concept/pre-specified-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/pre-specified-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/clinical-trial"/>
        <skos:notation>HE-ES-SA-165</skos:notation>
        <dcterms:identifier>HE-ES-SA-165</dcterms:identifier>
        <dcterms:source>Friedman LM, Furberg CD, DeMets DL, Reboussin DM, Granger CB. Fundamentals of Clinical Trials. 5th ed. Springer; 2015. doi:10.1007/978-3-319-18539-2.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Pre-Specified Analysis</rdfs:label>
        <skos:altLabel xml:lang="en">Pre-Planned Analysis</skos:altLabel>
        <skos:definition xml:lang="en">A statistical analysis formally planned and documented, typically within a study protocol, before the study&apos;s data were collected or examined.</skos:definition>
        <skos:hiddenLabel xml:lang="en">A-Priori Analysis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Pre-Specified Analysis</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/post-hoc-analysis"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/pre-specified-analysis"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <dcterms:identifier>HEO-L-43e6ef7bc847</dcterms:identifier>
        <linkRationale xml:lang="en">A pre-specified analysis is a statistical analysis</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
