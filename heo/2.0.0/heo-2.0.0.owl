        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/parameter-input"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
