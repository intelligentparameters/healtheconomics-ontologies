    <!-- https://healtheconomics.wiki/concept/productive-efficiency -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/productive-efficiency">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/efficiency"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q7247859"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/efficiency"/>
        <skos:notation>HE-EE_EA-044</skos:notation>
        <dcterms:identifier>HE-EE_EA-044</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-30</dcterms:modified>
        <dcterms:source>Farrell MJ. The measurement of productive efficiency. Journal of the Royal Statistical Society: Series A. 1957;120(3):253?290. doi:10.2307/2343100.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Productive Efficiency</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:altLabel xml:lang="en">Production Efficiency</skos:altLabel>
        <skos:definition xml:lang="en">Producing a health output at the lowest possible cost, which needs both technical efficiency and the least-cost mix of inputs.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cost-Minimising Efficiency</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Productive Efficiency</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/allocative-efficiency"/>
        <prerequisiteFor rdf:resource="https://healtheconomics.wiki/concept/allocative-efficiency"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/productive-efficiency"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/efficiency"/>
        <dcterms:identifier>HEO-L-b3992f25d086</dcterms:identifier>
        <linkRationale xml:lang="en">Productive efficiency is a type of efficiency.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/productive-efficiency"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/allocative-efficiency"/>
        <dcterms:identifier>HEO-L-48537a4b71c1</dcterms:identifier>
        <linkRationale xml:lang="en">Productive and allocative efficiency are the two contrasting efficiency types.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
