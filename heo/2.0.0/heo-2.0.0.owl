        <owl:versionInfo>1.0.4</owl:versionInfo>
        <skos:altLabel xml:lang="en">Age Weights</skos:altLabel>
        <skos:definition xml:lang="en">Age weighting values a year of healthy life by the age at which it is lived, as in the original GBD DALY, which gave years in young adulthood most weight.</skos:definition>
        <skos:prefLabel xml:lang="en">Age Weighting</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/age-weighting"/>
