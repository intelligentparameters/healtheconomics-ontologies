    <!-- https://healtheconomics.wiki/concept/vertical-equity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/vertical-equity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/equity"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/equity"/>
        <skos:notation>HE-EE-WE-025</skos:notation>
        <dcterms:identifier>HE-EE-WE-025</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Wagstaff &amp; van Doorslaer 2000</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Vertical Equity</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Vertical equity is the principle that those in greater need should get appropriately more care, and those more able to pay should pay more.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Unequal-Treatment-of-Unequals Equity</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Vertical Fairness</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Vertical Equity</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/vertical-inequity"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-policy#step-4"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/equity-weighted-analysis"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/progressive-financing"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/vertical-equity"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/equity"/>
        <dcterms:identifier>HEO-L-5c505a4d564c</dcterms:identifier>
        <linkRationale xml:lang="en">Vertical equity is a kind of equity.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/vertical-equity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/vertical-inequity"/>
        <dcterms:identifier>HEO-L-9b73764edb38</dcterms:identifier>
        <linkRationale xml:lang="en">Vertical equity and vertical inequity are opposites.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/vertical-equity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isFoundationFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/equity-weighted-analysis"/>
        <dcterms:identifier>HEO-L-9331a30c6470</dcterms:identifier>
        <linkRationale xml:lang="en">Vertical equity underpins equity weighting.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/vertical-equity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isFoundationFor"/>
