        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/unwarranted-variation"/>
        <dcterms:identifier>HEO-L-37958f1c5482</dcterms:identifier>
        <linkRationale xml:lang="en">Protocol Deviation is a trial concept; conformity to care protocols narrows variation not explained by need.</linkRationale>
