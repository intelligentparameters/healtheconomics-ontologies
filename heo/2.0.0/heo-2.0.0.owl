    <!-- https://healtheconomics.wiki/concept/efficacy-outcome -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/efficacy-outcome">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome"/>
        <skos:notation>HE-ES-PRO-007</skos:notation>
        <dcterms:identifier>HE-ES-PRO-007</dcterms:identifier>
        <dcterms:source>Institute of Medicine. Initial National Priorities for Comparative Effectiveness Research. National Academies Press; 2009. doi:10.17226/12648.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Efficacy Outcome</rdfs:label>
        <skos:definition xml:lang="en">A clinical outcome measured under the controlled, often idealised conditions of a trial, representing the maximum potential benefit achievable.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Controlled-Condition Outcome</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Ideal-Setting Outcome</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Efficacy Outcome</skos:prefLabel>
