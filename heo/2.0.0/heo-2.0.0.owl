    <!-- https://healtheconomics.wiki/concept/value-gap -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/value-gap">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-NHS-VBH-024</skos:notation>
        <dcterms:identifier>HS-NHS-VBH-024</dcterms:identifier>
        <dcterms:source>Porter 2010</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Value Gap</rdfs:label>
        <skos:definition xml:lang="en">The difference between a technology&apos;s price and its assessed value based on formal health economic evaluation, favourable or unfavourable.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Value Shortfall</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Value Gap</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/price-negotiation"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/value-based-pricing"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/value-gap"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-3c4ae2360b79</dcterms:identifier>
