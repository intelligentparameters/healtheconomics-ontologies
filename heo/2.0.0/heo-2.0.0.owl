    <!-- https://healtheconomics.wiki/concept/minimum-effective-dose -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/minimum-effective-dose">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-PE-CP-010</skos:notation>
        <dcterms:identifier>HE-PE-CP-010</dcterms:identifier>
        <dcterms:source>Rowland &amp; Tozer 2010</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Minimum Effective Dose</rdfs:label>
        <skos:altLabel xml:lang="en">MED</skos:altLabel>
        <skos:definition xml:lang="en">The lowest drug dose that produces a clinically meaningful therapeutic effect, important for both safety and avoiding unnecessary medication cost.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Threshold Dose</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Minimum Effective Dose</skos:prefLabel>
        <abbreviation xml:lang="en">MED</abbreviation>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/minimum-effective-dose"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-3d21b4906769</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Pharmacoeconomics &gt; Clinical Pharmacology: pharmacokinetic and dosing terms describe the clinical evidence behind a treatment effect</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/minimum-essential-coverage -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/minimum-essential-coverage">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/regulatory-standards"/>
