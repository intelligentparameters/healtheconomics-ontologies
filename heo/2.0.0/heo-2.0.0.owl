        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/critical-value"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#setsScopeOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/rejection-region"/>
        <dcterms:identifier>HEO-L-4ae98e63a1eb</dcterms:identifier>
