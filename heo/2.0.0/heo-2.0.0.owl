        <skos:notation>HE-ES-CO-032</skos:notation>
        <dcterms:identifier>HE-ES-CO-032</dcterms:identifier>
        <dcterms:source>Aaronson et al. 1993</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Global Health Status</rdfs:label>
        <skos:definition xml:lang="en">A summary scale within some quality of life instruments asking patients to rate overall health with a few general questions, unlike more detailed dimension scales.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Overall QoL Scale</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Summary Health Rating</skos:hiddenLabel>
