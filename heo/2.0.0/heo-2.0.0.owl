        <dcterms:identifier>HEO-L-862f0003e6a9</dcterms:identifier>
        <linkRationale xml:lang="en">Waste is spending that adds no health gain (subject definition), a portion of health spending</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
