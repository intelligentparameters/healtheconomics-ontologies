    <!-- https://healtheconomics.wiki/concept/rating-method -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/rating-method">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
