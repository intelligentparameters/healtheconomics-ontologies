    <!-- https://healtheconomics.wiki/concept/one-time-treatment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/one-time-treatment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/treatment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/treatment"/>
        <skos:notation>HE-PE-AT-009</skos:notation>
        <dcterms:identifier>HE-PE-AT-009</dcterms:identifier>
        <dcterms:source>Jørgensen &amp; Kefalas 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">One-Time Treatment</rdfs:label>
        <skos:definition xml:lang="en">A therapy, such as certain gene or cell therapies, given only once and intended to produce a durable or permanent clinical benefit.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Durable One-Shot Treatment</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Single-Administration Therapy</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">One-Time Treatment</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/curative-model-uncertainty"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/annuity-payment"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/one-time-treatment"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/treatment"/>
        <dcterms:identifier>HEO-L-2cf3bc8668a6</dcterms:identifier>
        <linkRationale xml:lang="en">Not every one-time treatment is an EU ATMP (other one-off therapies are not); it is a kind of treatment</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
