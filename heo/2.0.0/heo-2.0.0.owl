        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/internal-validity-assessment"/>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/external-validity"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/real-world-data"/>
    </owl:NamedIndividual>
