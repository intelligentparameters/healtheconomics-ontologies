        <linkRationale xml:lang="en">Crude coverage of tracer services feeds the UHC service coverage index; one indicator does not measure UHC</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
