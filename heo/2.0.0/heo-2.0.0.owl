    <!-- https://healtheconomics.wiki/concept/choice-experiment-design -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/choice-experiment-design">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/experimental-design"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
