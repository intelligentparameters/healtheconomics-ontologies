    <!-- https://healtheconomics.wiki/concept/digital-therapeutic -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/digital-therapeutic">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
