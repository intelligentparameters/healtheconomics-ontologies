        <dcterms:identifier>HE-ES-SA-005</dcterms:identifier>
        <dcterms:source>Neyman &amp; Pearson 1933</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Alternative Hypothesis</rdfs:label>
        <skos:altLabel xml:lang="en">H1</skos:altLabel>
        <skos:definition xml:lang="en">In hypothesis testing, the specific claim tested against the null hypothesis, typically representing a genuine effect the researcher is trying to detect.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Research Hypothesis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Alternative Hypothesis</skos:prefLabel>
        <abbreviation xml:lang="en">H1</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/null-hypothesis"/>
        <prerequisiteFor rdf:resource="https://healtheconomics.wiki/concept/statistical-power"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
