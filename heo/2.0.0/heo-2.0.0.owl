    <!-- https://healtheconomics.wiki/concept/progressive-financing -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/progressive-financing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <skos:notation>HS-HP-HF-060</skos:notation>
        <dcterms:identifier>HS-HP-HF-060</dcterms:identifier>
        <dcterms:source>Musgrave &amp; Musgrave 1989</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Progressive Financing</rdfs:label>
        <skos:altLabel xml:lang="en">Progressive Health Financing</skos:altLabel>
        <skos:definition xml:lang="en">A financing arrangement where contributions rise as a proportion of income for wealthier individuals, so higher earners contribute a larger share.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Income-Related Financing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Progressive Financing</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/redistribution"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/progressive-financing"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <dcterms:identifier>HEO-L-c01371dfa581</dcterms:identifier>
        <linkRationale xml:lang="en">Progressive financing is a form of health system financing.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/progressive-financing"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/redistribution"/>
        <dcterms:identifier>HEO-L-af1b04c82557</dcterms:identifier>
        <linkRationale xml:lang="en">Progressive contributions transfer resources from richer to poorer groups.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/progressive-taxation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/progressive-taxation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/progressive-financing"/>
