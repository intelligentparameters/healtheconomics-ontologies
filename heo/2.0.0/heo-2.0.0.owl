        <skos:notation>HE-EE-HP-006</skos:notation>
        <dcterms:identifier>HE-EE-HP-006</dcterms:identifier>
        <dcterms:source>Folland, Goodman &amp; Stano 2016</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Reimbursement</rdfs:label>
        <skos:definition xml:lang="en">The payment made by a health insurer or payer to a healthcare provider for services rendered to a covered patient.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Coverage Payment</skos:hiddenLabel>
