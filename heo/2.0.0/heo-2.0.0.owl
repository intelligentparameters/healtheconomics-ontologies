    <!-- https://healtheconomics.wiki/concept/accelerated-failure-time -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/accelerated-failure-time">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/parametric-survival-model"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/survival-regression"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q4672282"/>
