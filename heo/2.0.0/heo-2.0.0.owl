    <!-- https://healtheconomics.wiki/concept/monoclonal-antibody -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/monoclonal-antibody">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
