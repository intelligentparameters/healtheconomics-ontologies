    <!-- https://healtheconomics.wiki/concept/assistive-technology-coverage -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/assistive-technology-coverage">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/crude-coverage"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/crude-coverage"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/unmet-need"/>
        <skos:notation>HS-SS_HSP-004</skos:notation>
        <dcterms:identifier>HS-SS_HSP-004</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>WHO and UNICEF 2022</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Assistive Technology Coverage</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">AT Coverage</skos:altLabel>
        <skos:definition xml:lang="en">Assistive technology coverage is how far people needing assistive products, such as wheelchairs or hearing aids, have them, and how payers fund them.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Assistive Device Access</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Assistive Technology Coverage</skos:prefLabel>
        <abbreviation xml:lang="en">AT Coverage</abbreviation>
        <informs rdf:resource="https://healtheconomics.wiki/concept/coverage-policy"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/assistive-technology-coverage"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/crude-coverage"/>
        <dcterms:identifier>HEO-L-fd3d426bb5a0</dcterms:identifier>
        <linkRationale xml:lang="en">AT coverage is the share with the product, unadjusted for quality, so a crude coverage measure rather than a quality indicator</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/assistive-technology-coverage"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/unmet-need"/>
        <dcterms:identifier>HEO-L-c76ae38bf388</dcterms:identifier>
        <linkRationale xml:lang="en">Coverage among people needing assistive products is the complement of their unmet need</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
