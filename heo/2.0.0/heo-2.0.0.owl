    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/volume-cap -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/volume-cap">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-containment"/>
