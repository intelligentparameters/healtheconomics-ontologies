    <!-- https://healtheconomics.wiki/concept/point-of-service-plan -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/point-of-service-plan">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/managed-care-model"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q7208280"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/managed-care-model"/>
        <skos:notation>HS-HP-HI-133</skos:notation>
        <dcterms:identifier>HS-HP-HI-133</dcterms:identifier>
        <dcterms:source>Kongstvedt 2012</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Point of Service Plan</rdfs:label>
        <skos:altLabel xml:lang="en">POS Plan</skos:altLabel>
        <skos:definition xml:lang="en">A managed care plan combining HMO and PPO features, requiring a primary care provider while still allowing costlier out-of-network care.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Point-of-Service Insurance</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Point of Service Plan</skos:prefLabel>
        <abbreviation xml:lang="en">POS Plan</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/health-maintenance-organization"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/provider-network"/>
    </owl:NamedIndividual>
