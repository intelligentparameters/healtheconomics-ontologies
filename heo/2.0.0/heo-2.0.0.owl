    <!-- https://healtheconomics.wiki/concept/medication-adherence -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/medication-adherence">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/adherence"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/treatment-adherence"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q67144513"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/adherence"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/treatment-adherence"/>
        <skos:notation>PP-PC-MA-001</skos:notation>
        <dcterms:identifier>PP-PC-MA-001</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Cramer et al. 2008</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Medication Adherence</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Drug Adherence</skos:altLabel>
        <skos:definition xml:lang="en">The extent to which a patient takes a prescribed medication as recommended, covering consistent daily use and appropriate long-term continuation.</skos:definition>
