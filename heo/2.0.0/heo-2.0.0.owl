        <rdfs:label xml:lang="en">Node-Splitting</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A technique testing for inconsistency in a network meta-analysis by separately estimating direct and indirect evidence for one comparison and comparing them.</skos:definition>
