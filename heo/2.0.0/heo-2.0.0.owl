        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Minimal Risk</rdfs:label>
        <skos:definition xml:lang="en">A regulatory classification indicating a study&apos;s anticipated harm probability and magnitude are no greater than those of ordinary daily life.</skos:definition>
