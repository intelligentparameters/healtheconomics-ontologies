        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/time-varying-hazard -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/time-varying-hazard">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
