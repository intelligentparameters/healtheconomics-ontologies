    <!-- https://healtheconomics.wiki/concept/parameter-importance -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/parameter-importance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:notation>HE-EM-UA-069</skos:notation>
        <dcterms:identifier>HE-EM-UA-069</dcterms:identifier>
        <dcterms:source>Saltelli et al. 2008</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Parameter Importance</rdfs:label>
        <skos:definition xml:lang="en">A measure of how much a given input parameter contributes to the overall uncertainty in a model&apos;s results, used to prioritise further scrutiny.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Input Importance</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Parameter Influence</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Parameter Importance</skos:prefLabel>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/parameter-input"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/parameter-importance"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-d1ec0e6e5571</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Modelling &gt; Uncertainty Analysis: catalogue subdomain Economic Modelling is one of the subdomains</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/parameter-importance"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isPropertyOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/parameter-input"/>
        <dcterms:identifier>HEO-L-fae96a0618cd</dcterms:identifier>
        <linkRationale xml:lang="en">A measure of an input&apos;s contribution to uncertainty describes the parameter; it is not itself a sensitivity analysis</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


