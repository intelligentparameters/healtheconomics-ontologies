    <!-- https://healtheconomics.wiki/concept/absenteeism -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/absenteeism">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q332278"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/productivity-cost"/>
        <skos:notation>HE-EE-PM-021</skos:notation>
        <dcterms:identifier>HE-EE-PM-021</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Goetzel et al. 2004</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Absenteeism</rdfs:label>
        <owl:versionInfo>1.0.3</owl:versionInfo>
        <skos:definition xml:lang="en">Time lost from work due to illness, injury, or caregiving responsibilities, resulting in a direct, measurable cost to employers through lost productivity.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Sickness Absence</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Work Absence</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Absenteeism</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/presenteeism"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/costs#step-2"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/work-productivity"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/absenteeism"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/presenteeism"/>
        <dcterms:identifier>HEO-L-68e20f4d99eb</dcterms:identifier>
        <linkRationale xml:lang="en">Absence from work versus reduced output while present; symmetric, the reverse copy (queue-r3-15) is the duplicate</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/absenteeism"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/work-productivity"/>
