        <uses rdf:resource="https://healtheconomics.wiki/concept/crossover-design"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/within-patient-analysis"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/crossover-trial"/>
