    <!-- https://healtheconomics.wiki/concept/reference-country -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/reference-country">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
