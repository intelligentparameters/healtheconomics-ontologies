        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/partnership-model"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-system-organization"/>
        <dcterms:identifier>HEO-L-3fa99769e87e</dcterms:identifier>
        <linkRationale xml:lang="en">A partnership model is a financing or delivery arrangement among stakeholders; the object is the arrangement of financing and delivery actors</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/passive-alert -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/passive-alert">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-alert"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/clinical-alert"/>
        <skos:notation>HS-HP-DH-033</skos:notation>
        <dcterms:identifier>HS-HP-DH-033</dcterms:identifier>
        <dcterms:source>Ancker et al. 2017</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Passive Alert</rdfs:label>
        <skos:altLabel xml:lang="en">Non-Interruptive Alert</skos:altLabel>
        <skos:altLabel xml:lang="en">Passive CDS Alert</skos:altLabel>
        <skos:definition xml:lang="en">A clinical alert displaying information without requiring an active response before proceeding, unlike an interruptive alert demanding acknowledgment.</skos:definition>
        <skos:prefLabel xml:lang="en">Passive Alert</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/alert-fatigue"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
