    <!-- https://healtheconomics.wiki/concept/per-protocol-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/per-protocol-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:notation>HE-ES-CTM-063</skos:notation>
        <dcterms:identifier>HE-ES-CTM-063</dcterms:identifier>
        <dcterms:source>Friedman LM, Furberg CD, DeMets DL, Reboussin DM, Granger CB. Fundamentals of Clinical Trials. 5th ed. Springer; 2015. doi:10.1007/978-3-319-18539-2.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Per-Protocol Analysis</rdfs:label>
        <skos:altLabel xml:lang="en">PP Analysis</skos:altLabel>
        <skos:definition xml:lang="en">An analysis including only trial participants who received and adhered to their assigned treatment as specified, excluding those with major protocol deviations.</skos:definition>
        <skos:hiddenLabel xml:lang="en">On-Treatment Analysis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Per-Protocol Analysis</skos:prefLabel>
        <abbreviation xml:lang="en">PP Analysis</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/intention-to-treat-analysis"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/per-protocol-population"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/per-protocol-analysis"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <dcterms:identifier>HEO-L-28f13e446a41</dcterms:identifier>
        <linkRationale xml:lang="en">Per-protocol analysis is a statistical analysis approach for trial data</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/per-protocol-analysis"/>
