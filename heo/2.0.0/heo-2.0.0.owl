    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/morris-method">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/global-sensitivity-analysis"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/screening-analysis"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q6913963"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/global-sensitivity-analysis"/>
