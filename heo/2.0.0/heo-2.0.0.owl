        <dcterms:identifier>HS-HP-HI-119</dcterms:identifier>
        <dcterms:source>US, Affordable Care Act</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Minimum Essential Coverage</rdfs:label>
        <skos:altLabel xml:lang="en">MEC</skos:altLabel>
        <skos:definition xml:lang="en">A regulatory standard defining the minimum insurance level required to satisfy an individual mandate, covering most employer, government, and marketplace plans.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Qualifying Coverage</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Minimum Essential Coverage</skos:prefLabel>
        <abbreviation xml:lang="en">MEC</abbreviation>
        <benchmarkFor rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/individual-mandate"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/minimum-essential-coverage"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/regulatory-standards"/>
        <dcterms:identifier>HEO-L-cd09aaf0d0b1</dcterms:identifier>
