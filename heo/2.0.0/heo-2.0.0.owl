    <!-- https://healtheconomics.wiki/concept/tau-squared -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/tau-squared">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/between-study-heterogeneity"/>
        <skos:notation>HE-ES-ESM-060</skos:notation>
        <dcterms:identifier>HE-ES-ESM-060</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>DerSimonian R, Laird N. Meta-analysis in clinical trials. Controlled Clinical Trials. 1986;7(3):177?188. doi:10.1016/0197-2456(86)90046-2.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Tau-Squared</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Between-Study Variance</skos:altLabel>
        <skos:altLabel xml:lang="en">Heterogeneity Variance</skos:altLabel>
        <skos:definition xml:lang="en">A statistical parameter representing the estimated variance of the true treatment effect across studies in a random effects meta-analysis.</skos:definition>
        <skos:prefLabel xml:lang="en">Tau-Squared</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-4"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/tau-squared"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-279779be33dc</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Evidence synthesis and appraisal in subdomain Evidence Synthesis</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/tau-squared"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/between-study-heterogeneity"/>
        <dcterms:identifier>HEO-L-48b59d439f19</dcterms:identifier>
        <linkRationale xml:lang="en">Tau-squared is the between-study variance in a random effects model</linkRationale>
