        <skos:notation>HS-DC-DP-097</skos:notation>
        <dcterms:identifier>HS-DC-DP-097</dcterms:identifier>
        <dcterms:source>Danzon 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Tender-Based Pricing</rdfs:label>
        <skos:definition xml:lang="en">A procurement approach in which a payer solicits competitive bids from manufacturers, typically awarding supply to the lowest qualifying bidder.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Competitive Tender Pricing</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Tendering</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Tender-Based Pricing</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/reference-based-pricing"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
