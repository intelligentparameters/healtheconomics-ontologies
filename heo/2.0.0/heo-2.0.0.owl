    <!-- https://healtheconomics.wiki/concept/budget-monitoring -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/budget-monitoring">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
