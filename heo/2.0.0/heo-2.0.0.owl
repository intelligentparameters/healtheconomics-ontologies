        <rdfs:label xml:lang="en">Confidence Interval</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">A confidence interval (CI) is a range around an estimate, such as a cost difference, built so a set share, often 95%, of such ranges hold the true value.</skos:definition>
        <skos:hiddenLabel xml:lang="en">CI Statistics</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Frequentist Interval</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Confidence Interval</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/credible-interval"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/point-estimate"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/effect-estimate"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/confidence-interval"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
