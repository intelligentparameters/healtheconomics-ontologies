        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/long-term-care-cost"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/long-term-care"/>
