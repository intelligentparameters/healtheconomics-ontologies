    <!-- https://healtheconomics.wiki/concept/chemotherapy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/chemotherapy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
