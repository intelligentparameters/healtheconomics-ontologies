        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">A decision in health economics is a choice between alternative uses of health care resources, such as funding a technology, informed by evidence.</skos:definition>
        <skos:prefLabel xml:lang="en">Decision</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-technology-assessment#step-1"/>
