    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/southeast-quadrant"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#represents"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/dominance"/>
        <dcterms:identifier>HEO-L-e6ee49402f78</dcterms:identifier>
        <linkRationale xml:lang="en">The southeast quadrant is the region of the CE plane that depicts the new option dominating (cheaper and more effective).</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/southwest-quadrant -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/southwest-quadrant">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-plane"/>
        <skos:notation>HE-EE-CEA-060</skos:notation>
        <dcterms:identifier>HE-EE-CEA-060</dcterms:identifier>
        <dcterms:source>Black 1990</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Southwest Quadrant</rdfs:label>
        <skos:altLabel xml:lang="en">SW Quadrant</skos:altLabel>
        <skos:definition xml:lang="en">The region of the cost-effectiveness plane where a new intervention is both less costly and less effective than its comparator.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Less-Costly-Less-Effective Quadrant</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Southwest Quadrant</skos:prefLabel>
        <abbreviation xml:lang="en">SW Quadrant</abbreviation>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/willingness-to-accept"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/southwest-quadrant"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-14a7fc274d3e</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Cost-Effectiveness Analysis: wiki topic Cost-effectiveness analysis sits in Economic Evaluation; placed under Cost-Effectiveness Analysis, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/southwest-quadrant"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-plane"/>
        <dcterms:identifier>HEO-L-081a7cb746c1</dcterms:identifier>
        <linkRationale xml:lang="en">One of the four quadrants of the plane (object definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/southwest-quadrant"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#setsScopeOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/willingness-to-accept"/>
        <dcterms:identifier>HEO-L-3e11d42d1b73</dcterms:identifier>
        <linkRationale xml:lang="en">In this quadrant health is given up for savings, so acceptance is judged on willingness to accept</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


