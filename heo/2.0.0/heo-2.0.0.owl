    <!-- https://healtheconomics.wiki/concept/specific-stop-loss -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/specific-stop-loss">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/stop-loss"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/stop-loss"/>
        <skos:notation>HS-HP-HI-184</skos:notation>
        <dcterms:identifier>HS-HP-HI-184</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Specific Stop-Loss</rdfs:label>
        <skos:altLabel xml:lang="en">Individual Stop-Loss</skos:altLabel>
        <skos:definition xml:lang="en">A reinsurance form protecting a self-insured employer against a single enrollee&apos;s claims exceeding a predefined threshold, unlike aggregate stop-loss.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Specific Excess Insurance</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Specific Stop-Loss</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-2"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/specific-stop-loss"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/stop-loss"/>
        <dcterms:identifier>HEO-L-f19f8064e38f</dcterms:identifier>
        <linkRationale xml:lang="en">Specific stop-loss is a form of stop-loss.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/specificity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/specificity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/diagnostic-accuracy"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/accuracy"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/likelihood-ratio"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/negative-likelihood-ratio"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/negative-predictive-value"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/positive-likelihood-ratio"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/roc-curve"/>
        <skos:notation>HE-ES-RM-041</skos:notation>
        <dcterms:identifier>HE-ES-RM-041</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Altman &amp; Bland 1994</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Specificity</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">True Negative Rate</skos:altLabel>
        <skos:definition xml:lang="en">The proportion of people without a specified target condition who test negative at a stated diagnostic threshold, calculated as true negatives divided by true negatives plus false positives.</skos:definition>
        <skos:hiddenLabel xml:lang="en">TNR</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Specificity</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/specificity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
