        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/targeted-therapy"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/precision-medicine"/>
        <dcterms:identifier>HEO-L-64650be33b90</dcterms:identifier>
        <linkRationale xml:lang="en">Targeted therapies select treatment by disease characteristics, a precision medicine approach.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
