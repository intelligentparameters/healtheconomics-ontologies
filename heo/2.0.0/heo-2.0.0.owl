    <!-- https://healtheconomics.wiki/concept/matching-design -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/matching-design">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/study-design"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/study-design"/>
        <skos:notation>HE-ES-SA-108</skos:notation>
        <dcterms:identifier>HE-ES-SA-108</dcterms:identifier>
        <dcterms:source>Rosenbaum &amp; Rubin 1983</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Matching Design</rdfs:label>
        <skos:definition xml:lang="en">A study design pairing treated individuals with similar untreated individuals on shared characteristics, to reduce confounding when estimating causal effect.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Matched Study Design</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Matched-Pairs Design</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Matching Design</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
