        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/complete-response"/>
        <dcterms:identifier>HEO-L-877d1cb493ec</dcterms:identifier>
