        <dcterms:source>McClellan et al. 2010</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Provider Payment Reform</rdfs:label>
        <skos:definition xml:lang="en">Efforts to change how providers are reimbursed, moving away from fee-for-service toward models better aligned with high-value, coordinated care.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Alternative Payment Model</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Payment Reform</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Provider Payment Reform</skos:prefLabel>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/bundled-payment"/>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/value-based-payment"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/fee-for-service"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/provider-payment-reform"/>
