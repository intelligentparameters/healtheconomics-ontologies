    <!-- https://healtheconomics.wiki/concept/primary-resistance -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/primary-resistance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/treatment-failure"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/treatment-failure"/>
        <skos:notation>HE-PE-OO-017</skos:notation>
        <dcterms:identifier>HE-PE-OO-017</dcterms:identifier>
        <dcterms:source>DeVita, Lawrence &amp; Rosenberg 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Primary Resistance</rdfs:label>
        <skos:altLabel xml:lang="en">Innate Resistance</skos:altLabel>
        <skos:altLabel xml:lang="en">Intrinsic Resistance</skos:altLabel>
        <skos:definition xml:lang="en">A situation where cancer fails to respond adequately to treatment from the outset, without ever showing an initial period of disease control.</skos:definition>
        <skos:prefLabel xml:lang="en">Primary Resistance</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/primary-resistance"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/treatment-failure"/>
        <dcterms:identifier>HEO-L-6116fdb8213f</dcterms:identifier>
        <linkRationale xml:lang="en">Primary resistance is a failure of treatment from the outset</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/primary-service-area -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/primary-service-area">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
