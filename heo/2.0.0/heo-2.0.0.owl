    <!-- https://healtheconomics.wiki/concept/copas-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/copas-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/publication-bias-assessment"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/selection-model"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/publication-bias-assessment"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/selection-model"/>
        <skos:notation>HE-ES-ESM-009</skos:notation>
        <dcterms:identifier>HE-ES-ESM-009</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Carpenter et al. 2009</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Copas Model</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Copas Selection Model</skos:altLabel>
        <skos:definition xml:lang="en">The Copas model is a selection model for publication bias in meta-analysis that re-estimates the pooled effect under assumed rates of non-publication.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Publication Bias Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Copas Model</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/trim-and-fill"/>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/meta-analysis"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-4"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/maximum-likelihood-estimation"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/random-effects-model"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/copas-model"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/publication-bias-assessment"/>
        <dcterms:identifier>HEO-L-d6e987db537d</dcterms:identifier>
