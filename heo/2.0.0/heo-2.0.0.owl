        <skos:notation>HS-HP-SS-024</skos:notation>
        <dcterms:identifier>HS-HP-SS-024</dcterms:identifier>
        <dcterms:source>Rogers 2003</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Opinion Leader</rdfs:label>
        <skos:altLabel xml:lang="en">KOL</skos:altLabel>
        <skos:altLabel xml:lang="en">Thought Leader</skos:altLabel>
        <skos:definition xml:lang="en">An individual whose views carry particular influence over peers&apos; attitudes and practices, often leveraged within implementation strategies to promote adoption.</skos:definition>
        <skos:prefLabel xml:lang="en">Opinion Leader</skos:prefLabel>
        <abbreviation xml:lang="en">KOL</abbreviation>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/diffusion-of-innovation"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/opinion-leader"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
