    <!-- https://healtheconomics.wiki/concept/transitional-care -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/transitional-care">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/coordinated-care-model"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/coordinated-care-model"/>
