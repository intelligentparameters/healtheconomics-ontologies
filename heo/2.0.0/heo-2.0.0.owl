    <!-- https://healtheconomics.wiki/concept/external-validity-of-valuation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/external-validity-of-valuation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:notation>HE-EE-CBA-022</skos:notation>
        <dcterms:identifier>HE-EE-CBA-022</dcterms:identifier>
        <dcterms:source>Carson et al. 2001</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">External Validity of Valuation</rdfs:label>
        <skos:definition xml:lang="en">The degree to which a value estimate from stated preference or experimental conditions accurately predicts behaviour or values in the real world.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Predictive Validity of Valuation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Valuation External Validity</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">External Validity of Valuation</skos:prefLabel>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/stated-preference"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/external-validity-of-valuation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-8fef619bbb06</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Cost-Benefit Analysis: the unplaced concepts here are stated preference terms; the wiki&apos;s topic Stated preference and monetary valuation sits in Outcomes</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/external-validity-of-valuation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isPropertyOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/stated-preference"/>
        <dcterms:identifier>HEO-L-a546fe84ac84</dcterms:identifier>
        <linkRationale xml:lang="en">It is a property of stated preference estimates</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/externality -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/externality">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q275372"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <skos:notation>HE-EE-ME-023</skos:notation>
        <dcterms:identifier>HE-EE-ME-023</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Pigou 1920</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Externality</rdfs:label>
        <owl:versionInfo>1.0.11</owl:versionInfo>
        <skos:altLabel xml:lang="en">Third-Party Effect</skos:altLabel>
        <skos:definition xml:lang="en">An externality is a cost or benefit, such as antimicrobial resistance or herd immunity, that falls on third parties and is ignored by the person deciding.</skos:definition>
        <skos:prefLabel xml:lang="en">Externality</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/market-failure"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/tragedy-of-the-commons"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/externality"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-bc4de60849a8</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Market failure and information in subdomain Economic Foundations</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/externality"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/market-failure"/>
        <dcterms:identifier>HEO-L-0e86423e5bdf</dcterms:identifier>
