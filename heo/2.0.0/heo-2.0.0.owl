    <!-- https://healtheconomics.wiki/concept/prognostic-biomarker -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/prognostic-biomarker">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/biomarker"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/biomarker"/>
        <skos:notation>HE-PE-TI-026</skos:notation>
        <dcterms:identifier>HE-PE-TI-026</dcterms:identifier>
        <dcterms:source>FDA-NIH Biomarker Working Group 2016</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Prognostic Biomarker</rdfs:label>
        <skos:definition xml:lang="en">A biological indicator predicting a disease&apos;s likely course independent of treatment received, unlike a predictive biomarker indicating response to a particular treatment.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Outcome-Predicting Marker</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Prognosis Marker</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Prognostic Biomarker</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/prognostic-biomarker"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/biomarker"/>
        <dcterms:identifier>HEO-L-521d4f9241f9</dcterms:identifier>
        <linkRationale xml:lang="en">A prognostic biomarker is a biomarker.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/prognostic-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/prognostic-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/risk-prediction-model"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/risk-prediction-model"/>
        <skos:notation>HS-SS_DH-056</skos:notation>
        <dcterms:identifier>HS-SS_DH-056</dcterms:identifier>
        <dcterms:source>FDA-NIH Biomarker Working Group 2016</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Prognostic Model</rdfs:label>
        <skos:altLabel xml:lang="en">Outcome Prediction Model</skos:altLabel>
        <skos:definition xml:lang="en">A statistical or computational model predicting a patient&apos;s likely future clinical course, such as disease progression or survival probability.</skos:definition>
