    <!-- https://healtheconomics.wiki/concept/adoption-curve -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/adoption-curve">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/budget-impact-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/budget-impact-analysis"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/budget-impact"/>
        <skos:notation>HS-HP-SS-002</skos:notation>
        <dcterms:identifier>HS-HP-SS-002</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Dunn et al. 2012</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Health Technology Adoption Curve</rdfs:label>
        <owl:versionInfo>1.0.5</owl:versionInfo>
        <skos:altLabel xml:lang="en">Diffusion Curve</skos:altLabel>
        <skos:definition xml:lang="en">A health technology adoption curve shows how use of a new medicine or device grows over time, usually S-shaped: slow, then rapid, then levelling off.</skos:definition>
        <skos:hiddenLabel xml:lang="en">S-Curve</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Health Technology Adoption Curve</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/budget-impact-analysis"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-6"/>
        <represents rdf:resource="https://healtheconomics.wiki/concept/diffusion"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/adoption-curve"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/budget-impact-analysis"/>
