    <!-- https://healtheconomics.wiki/concept/risk-classification -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/risk-classification">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/risk-stratification"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q2154749"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/risk-stratification"/>
        <skos:notation>HS-HP-HI-163</skos:notation>
        <dcterms:identifier>HS-HP-HI-163</dcterms:identifier>
        <dcterms:source>Ellis 2008</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Risk Classification</rdfs:label>
        <skos:definition xml:lang="en">The process of categorising individuals by expected healthcare costs or risk level, used as an input to pricing or risk adjustment.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Risk Categorisation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Risk Grouping</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Risk Classification</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/risk-adjustment"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/risk-score"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/risk-classification"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/risk-stratification"/>
        <dcterms:identifier>HEO-L-6736a68fab98</dcterms:identifier>
        <linkRationale xml:lang="en">Risk classification groups individuals by risk level, a form of risk stratification.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
