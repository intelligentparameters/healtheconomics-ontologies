        <skos:notation>HE-PE-CD-053</skos:notation>
        <dcterms:identifier>HE-PE-CD-053</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Rehabilitation Economics</rdfs:label>
        <skos:altLabel xml:lang="en">Rehab Economics</skos:altLabel>
        <skos:definition xml:lang="en">The application of health economic evaluation to services restoring function after illness, injury, or surgery, covering physical, occupational, and speech therapy.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Restorative Care Economics</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Rehabilitation Economics</skos:prefLabel>
        <abbreviation xml:lang="en">Rehab Economics</abbreviation>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/rehabilitation"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
