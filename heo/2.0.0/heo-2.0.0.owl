        <owl:versionInfo>1.5.27</owl:versionInfo>
        <skos:altLabel xml:lang="en">CCA</skos:altLabel>
        <skos:definition xml:lang="en">Cost-consequence analysis sets out the costs and each separate outcome of healthcare options side by side, without combining them into one result.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Disaggregated Cost-Outcome Analysis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cost-Consequence Analysis</skos:prefLabel>
        <abbreviation xml:lang="en">CCA</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/cost-benefit-analysis"/>
