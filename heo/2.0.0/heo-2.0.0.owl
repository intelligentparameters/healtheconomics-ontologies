    <!-- https://healtheconomics.wiki/concept/communality -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/communality">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:notation>HE-ES-SA-030</skos:notation>
        <dcterms:identifier>HE-ES-SA-030</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-09</dcterms:modified>
        <dcterms:source>SAS Institute 2011</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Communality</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Communality is the proportion of an observed variable&apos;s variance explained by the common factors in a factor analysis, the complement of its uniqueness.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Common Variance</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Shared Variance Proportion</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Communality</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/uniqueness"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/communality"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-c18d7e0a327c</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Statistical methods in subdomain Evidence Synthesis; placed under Statistical Method, the concept named by its wiki topic</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/communality"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/uniqueness"/>
        <dcterms:identifier>HEO-L-dfb1042d4c62</dcterms:identifier>
        <linkRationale xml:lang="en">Communality and uniqueness are complements (subject definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
