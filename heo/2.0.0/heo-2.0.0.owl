    <!-- https://healtheconomics.wiki/concept/healthcare-policy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/healthcare-policy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
