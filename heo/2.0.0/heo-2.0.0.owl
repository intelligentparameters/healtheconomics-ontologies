        <dcterms:identifier>HE-ES-CO-070</dcterms:identifier>
        <dcterms:source>Lorig &amp; Holman 2003</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Self-Management</rdfs:label>
        <skos:definition xml:lang="en">A patient&apos;s active participation in the ongoing tasks needed to manage a chronic condition, including monitoring symptoms and adhering to treatment.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Patient-Led Care</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Self-Care</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Self-Management</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
