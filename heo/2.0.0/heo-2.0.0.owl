    <!-- https://healtheconomics.wiki/concept/short-physical-performance-battery -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/short-physical-performance-battery">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/performance-outcome"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <skos:related rdf:resource="https://healtheconomics.wiki/concept/frailty"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/performance-outcome"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/physical-function"/>
        <skos:notation>HE-ES-CO-111</skos:notation>
        <dcterms:identifier>HE-ES-CO-111</dcterms:identifier>
        <dcterms:source>Guralnik et al. 1994</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Short Physical Performance Battery</rdfs:label>
        <skos:definition xml:lang="en">Short Physical Performance Battery (SPPB) is a timed test of balance, gait speed and chair stands in older people, scored 0 to 12, used in trials.</skos:definition>
        <skos:hiddenLabel xml:lang="en">SPPB</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Short Physical Performance Battery</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
