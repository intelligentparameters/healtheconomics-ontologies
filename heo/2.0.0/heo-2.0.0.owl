    <!-- https://healtheconomics.wiki/concept/case-mix -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/case-mix">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q2388100"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/risk-adjusted-measure"/>
        <skos:notation>HS-HP-PP-020</skos:notation>
        <dcterms:identifier>HS-HP-PP-020</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Busse et al. 2011</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Case Mix</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Casemix</skos:altLabel>
        <skos:definition xml:lang="en">Case mix is the composition of a provider&apos;s patients by diagnosis, procedure, severity and expected resource use, usually measured with DRGs or HRGs.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Patient Population Mix</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Case Mix</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/resource-use"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/activity-based-funding"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/benchmarking"/>
