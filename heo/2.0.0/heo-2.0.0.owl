        <skos:notation>HS-HP-HI-196</skos:notation>
        <dcterms:identifier>HS-HP-HI-196</dcterms:identifier>
        <dcterms:source>Kongstvedt 2012</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Tiered Network</rdfs:label>
        <skos:altLabel xml:lang="en">Tiered Provider Network</skos:altLabel>
        <skos:definition xml:lang="en">A plan design categorising in-network providers into tiers by cost or quality, with lower cost-sharing for preferred-tier providers.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Layered Network</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Tiered Network</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/tiered-network"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/provider-network"/>
        <dcterms:identifier>HEO-L-27315fd505b0</dcterms:identifier>
        <linkRationale xml:lang="en">A tiered network is a provider network whose providers are grouped into cost-sharing tiers.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/tiered-pricing -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/tiered-pricing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/differential-pricing"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q835678"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/differential-pricing"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:notation>HS-DC-DP-101</skos:notation>
        <dcterms:identifier>HS-DC-DP-101</dcterms:identifier>
        <dcterms:source>Danzon 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Tiered Pricing</rdfs:label>
        <skos:altLabel xml:lang="en">Price Tiering</skos:altLabel>
        <skos:definition xml:lang="en">A pricing strategy charging different prices for the same product across markets, typically calibrated to differences in ability to pay.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Graduated Pricing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Tiered Pricing</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/tiered-pricing"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/differential-pricing"/>
        <dcterms:identifier>HEO-L-0c0052b034bb</dcterms:identifier>
        <linkRationale xml:lang="en">Pricing the same product by ability to pay is differential pricing.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/tiered-pricing"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
