    <!-- https://healtheconomics.wiki/concept/gaussian-process -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/gaussian-process">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:notation>HE-EM-VI-020</skos:notation>
        <dcterms:identifier>HE-EM-VI-020</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Rasmussen &amp; Williams 2006</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Gaussian Process</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A flexible statistical framework modelling an unknown function by treating any finite set of its values as jointly normally distributed.</skos:definition>
        <skos:hiddenLabel xml:lang="en">GP</skos:hiddenLabel>
