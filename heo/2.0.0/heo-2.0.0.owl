        <dcterms:identifier>HE-ES-ESM-044</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-03</dcterms:modified>
        <dcterms:source>Deeks et al. 2024</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Pairwise Meta-Analysis</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Pairwise meta-analysis is the statistical pooling of trials of the same two treatments, such as head-to-head RCTs, into one estimate of relative effect.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Direct Meta-Analysis</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Standard Meta-Analysis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Pairwise Meta-Analysis</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/indirect-comparison"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/network-meta-analysis"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-4"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/direct-evidence"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/fixed-effect-model"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/random-effects-model"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/pairwise-meta-analysis"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
