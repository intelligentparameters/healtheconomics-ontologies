    <!-- https://healtheconomics.wiki/concept/historical-control -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/historical-control">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/external-control-arm"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/external-control-arm"/>
        <skos:notation>HE-ES-CTM-109</skos:notation>
        <dcterms:identifier>HE-ES-CTM-109</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</dcterms:modified>
        <dcterms:source>ICH E10 2000</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Historical Control</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">Historical control is a comparison group of past patients, from earlier trials or registries, used instead of or alongside a concurrently randomised group.</skos:definition>
        <skos:prefLabel xml:lang="en">Historical Control</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/concurrent-control"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/confounding"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/selection-bias"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/historical-control"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/external-control-arm"/>
        <dcterms:identifier>HEO-L-172289005b28</dcterms:identifier>
        <linkRationale xml:lang="en">Definition of external control arm names historical cohorts.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/historical-control"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/concurrent-control"/>
        <dcterms:identifier>HEO-L-8259bea6b1ab</dcterms:identifier>
        <linkRationale xml:lang="en">Historical control is a comparison group; its alternative is a concurrent control, not a trial design.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/historical-control"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
