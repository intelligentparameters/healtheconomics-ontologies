    <!-- https://healtheconomics.wiki/concept/reinsurance -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/reinsurance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/risk-sharing"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/risk-transfer"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q476118"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/risk-sharing"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/risk-transfer"/>
        <skos:notation>HS-HP-HI-157</skos:notation>
        <dcterms:identifier>HS-HP-HI-157</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Reinsurance</rdfs:label>
        <skos:definition xml:lang="en">An arrangement in which an insurer transfers a portion of its financial risk to another insurer in exchange for a premium.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Insurer-of-Insurers</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Stop-Loss Cover</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Reinsurance</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
