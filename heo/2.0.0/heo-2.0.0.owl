        <skos:hiddenLabel xml:lang="en">Demand-Capacity Balancing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Capacity Management</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/capacity-planning"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/demand-management"/>
        <manages rdf:resource="https://healtheconomics.wiki/concept/capacity"/>
        <manages rdf:resource="https://healtheconomics.wiki/concept/patient-flow"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/waiting-time"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/demand-forecasting"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/queuing-model"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/capacity-management"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
