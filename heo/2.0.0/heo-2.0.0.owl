    <!-- https://healtheconomics.wiki/concept/public-choice-theory -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/public-choice-theory">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q674530"/>
