        <dcterms:source>Sherman et al. 2016</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Real-World Value</rdfs:label>
        <skos:definition xml:lang="en">An assessment of a technology&apos;s actual benefit and cost-effectiveness observed under routine clinical practice, unlike trial-based efficacy value estimates.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Observed Value in Practice</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Routine-Practice Value</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Real-World Value</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/efficacy"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/value-based-assessment"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
