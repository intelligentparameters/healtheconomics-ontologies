    <!-- https://healtheconomics.wiki/concept/pharmacodynamics -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/pharmacodynamics">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q725307"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-PE-CP-012</skos:notation>
        <dcterms:identifier>HE-PE-CP-012</dcterms:identifier>
        <dcterms:source>Rowland &amp; Tozer 2010</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Pharmacodynamics</rdfs:label>
        <skos:altLabel xml:lang="en">PD</skos:altLabel>
        <skos:definition xml:lang="en">The study of a drug&apos;s biochemical and physiological effects on the body, including mechanism of action and dose-response relationship.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Drug Action Study</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Pharmacodynamics</skos:prefLabel>
        <abbreviation xml:lang="en">PD</abbreviation>
