        <dcterms:identifier>HEO-L-e844e606f032</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Clinical and patient reported outcomes in subdomain Outcomes</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/disease-control-rate"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
