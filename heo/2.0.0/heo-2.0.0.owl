    <!-- https://healtheconomics.wiki/concept/slope-index-of-inequality -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/slope-index-of-inequality">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
