    <!-- https://healtheconomics.wiki/concept/hyperbolic-discounting -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/hyperbolic-discounting">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/time-preference"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q5957248"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/time-preference"/>
        <skos:notation>HE-EE-DC-010</skos:notation>
        <dcterms:identifier>HE-EE-DC-010</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-03</dcterms:modified>
        <dcterms:source>Frederick et al. 2002</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Hyperbolic Discounting</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Hyperbolic discounting is time preference in which the discount rate falls as delay grows, so plans made for later are often reversed when the time comes.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Hyperbolic Time Preference</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Present-Biased Discounting</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Hyperbolic Discounting</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/exponential-discounting"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/self-control-concept"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/hyperbolic-discounting"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/time-preference"/>
        <dcterms:identifier>HEO-L-880c87779d7f</dcterms:identifier>
        <linkRationale xml:lang="en">Hyperbolic discounting is a form of time preference.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
