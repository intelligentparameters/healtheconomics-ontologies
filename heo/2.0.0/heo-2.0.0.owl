    <!-- https://healtheconomics.wiki/concept/overhead-cost -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/overhead-cost">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/cost-structure"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/operating-cost"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/administrative-cost-ratio"/>
        <skos:notation>HE-EE-CA-065</skos:notation>
        <dcterms:identifier>HE-EE-CA-065</dcterms:identifier>
        <dcterms:source>Horngren, Datar &amp; Rajan 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Overhead Cost</rdfs:label>
        <skos:altLabel xml:lang="en">Overhead Expense</skos:altLabel>
        <skos:definition xml:lang="en">A cost that supports an organisation&apos;s overall operations but cannot be directly attributed to a specific service or department, such as administration.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Indirect Overhead</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Overhead Cost</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/overhead-cost"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-d122e8bf13d4</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Cost Analysis: cost analysis is costing; most concepts with this Level 3 that the wiki places in a topic sit in Costs</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/overhead-cost"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
