        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:notation>HE-EM-MS-003</skos:notation>
        <dcterms:identifier>HE-EM-MS-003</dcterms:identifier>
        <dcterms:source>Barton, Bryan &amp; Robinson 2004</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Individual-Level Model</rdfs:label>
        <skos:definition xml:lang="en">A decision-analytic model tracking simulated patients one at a time rather than representing a population using aggregate cohort proportions.</skos:definition>
        <skos:prefLabel xml:lang="en">Individual-Level Model</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/individual-level-model"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-352fc9c2e73e</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Modelling &gt; Microsimulation: catalogue subdomain Economic Modelling is one of the subdomains</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/individual-mandate -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/individual-mandate">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/insurance-mandate"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/insurance-mandate"/>
        <skos:notation>HS-HP-HI-102</skos:notation>
        <dcterms:identifier>HS-HP-HI-102</dcterms:identifier>
        <dcterms:source>US, Affordable Care Act</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Individual Mandate</rdfs:label>
        <skos:definition xml:lang="en">A legal requirement that individuals maintain a minimum level of insurance coverage or face a financial penalty, to prevent adverse selection.</skos:definition>
        <skos:prefLabel xml:lang="en">Individual Mandate</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/free-rider-problem-in-insurance"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/adverse-selection"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/death-spiral"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/individual-mandate"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/insurance-mandate"/>
        <dcterms:identifier>HEO-L-12f20541538b</dcterms:identifier>
        <linkRationale xml:lang="en">An insurance mandate.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/individual-mandate"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#addresses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/free-rider-problem-in-insurance"/>
        <dcterms:identifier>HEO-L-a05dc7f52e52</dcterms:identifier>
        <linkRationale xml:lang="en">Recognised insurance-policy problem; the mandate is the classic remedy and uninsured free riders generate unpaid emergency care.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
