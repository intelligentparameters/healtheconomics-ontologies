    <!-- https://healtheconomics.wiki/concept/exchangeable-correlation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/exchangeable-correlation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/working-correlation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/working-correlation"/>
        <skos:notation>HE-ES-SA-059</skos:notation>
        <dcterms:identifier>HE-ES-SA-059</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Liang &amp; Zeger 1986</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Exchangeable Correlation</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Compound Symmetry</skos:altLabel>
        <skos:altLabel xml:lang="en">Exchangeable Working Correlation</skos:altLabel>
        <skos:definition xml:lang="en">A correlation structure for repeated measures assuming any two observations within the same cluster are equally correlated, regardless of their timing or order.</skos:definition>
        <skos:prefLabel xml:lang="en">Exchangeable Correlation</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/intraclass-correlation"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/exchangeable-correlation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/working-correlation"/>
        <dcterms:identifier>HEO-L-4deab31716ce</dcterms:identifier>
        <linkRationale xml:lang="en">Exchangeable is one working correlation structure in GEE</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/exchangeable-correlation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/intraclass-correlation"/>
        <dcterms:identifier>HEO-L-97d3e3a0f0a5</dcterms:identifier>
        <linkRationale xml:lang="en">The exchangeable structure has a single common within-cluster correlation, the ICC</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/excludability -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/excludability">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/good-characteristic"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q779983"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/good-characteristic"/>
        <skos:notation>HE-EE-ME-021</skos:notation>
        <dcterms:identifier>HE-EE-ME-021</dcterms:identifier>
        <dcterms:source>Musgrave 1959</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Excludability</rdfs:label>
        <skos:definition xml:lang="en">A characteristic of a good describing whether it is possible to prevent those who have not paid for it from consuming it.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Excludable Property</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Exclusion Feasibility</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Excludability</skos:prefLabel>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/free-rider-problem"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/club-goods"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/economic-good"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/public-good"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/excludability"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/good-characteristic"/>
        <dcterms:identifier>HEO-L-0c6e736c96d1</dcterms:identifier>
        <linkRationale xml:lang="en">Excludability is one characteristic used to classify goods</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/excludability"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isFoundationFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/free-rider-problem"/>
        <dcterms:identifier>HEO-L-d09dc283dccd</dcterms:identifier>
