        <dcterms:source>Briggs, Claxton &amp; Sculpher 2006</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Dirichlet Distribution</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">The Dirichlet distribution is a multivariate distribution for proportions that sum to one, used for uncertain transition probabilities from a model state.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Dirichlet Prior</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Multivariate Proportion Distribution</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Dirichlet Distribution</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-10"/>
