    <!-- https://healtheconomics.wiki/concept/common-pool-resources -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/common-pool-resources">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-good"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/non-excludable-goods"/>
