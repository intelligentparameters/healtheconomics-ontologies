        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/number-needed-to-harm"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/transition-probability"/>
        <skos:notation>HS-HP-HQ-001</skos:notation>
        <dcterms:identifier>HS-HP-HQ-001</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>ICH E2A 1994</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Adverse Event Rate</rdfs:label>
        <owl:versionInfo>1.0.5</owl:versionInfo>
        <skos:altLabel xml:lang="en">AE Rate</skos:altLabel>
        <skos:definition xml:lang="en">Adverse event rate (AE rate) is the count of adverse events, or of patients with one, divided by the patients or person-time at risk in a stated period.</skos:definition>
        <skos:hiddenLabel xml:lang="en">AE Frequency</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Adverse Event Rate</skos:prefLabel>
        <abbreviation xml:lang="en">AE Rate</abbreviation>
        <informs rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
