    <!-- https://healtheconomics.wiki/concept/primary-data-collection -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/primary-data-collection">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
