        <dcterms:identifier>HEO-L-0484a65b43f8</dcterms:identifier>
        <linkRationale xml:lang="en">A freeze contains costs</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
