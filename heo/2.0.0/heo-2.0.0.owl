    <!-- https://healtheconomics.wiki/concept/rate-setting -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/rate-setting">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
