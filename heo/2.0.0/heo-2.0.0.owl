        <skos:altLabel xml:lang="en">Magnitude Scaling</skos:altLabel>
        <skos:definition xml:lang="en">A psychophysical scaling method in which respondents assign numbers to stimuli reflecting their perceived relative magnitude compared to a reference stimulus.</skos:definition>
