    <!-- https://healtheconomics.wiki/concept/solo-practice -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/solo-practice">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
