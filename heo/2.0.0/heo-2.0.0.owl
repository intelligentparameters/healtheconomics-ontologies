    <!-- https://healtheconomics.wiki/concept/alteration-of-consent -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/alteration-of-consent">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/informed-consent"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/informed-consent"/>
        <skos:notation>HS-HP-HSG-002</skos:notation>
        <dcterms:identifier>HS-HP-HSG-002</dcterms:identifier>
        <dcterms:source>National Commission, Belmont Report 1979</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Alteration of Consent</rdfs:label>
        <skos:definition xml:lang="en">A modification to the standard consent process, such as omitting information, permitted under specific conditions where it would not harm participant welfare.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Consent Alteration</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Modified Consent</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Alteration of Consent</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/waiver-of-consent"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/alteration-of-consent"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/informed-consent"/>
        <dcterms:identifier>HEO-L-dc7884fcbbd0</dcterms:identifier>
        <linkRationale xml:lang="en">An altered consent process is still a form of informed consent</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/alteration-of-consent"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/waiver-of-consent"/>
        <dcterms:identifier>HEO-L-88eed78f17d2</dcterms:identifier>
        <linkRationale xml:lang="en">Alteration is permitted under minimal-risk conditions; it modifies consent elements rather than waiving consent.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/alternative-hypothesis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/alternative-hypothesis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
