        <dcterms:identifier>HEO-L-46f7ab2dc8d5</dcterms:identifier>
        <linkRationale xml:lang="en">ALE is life expectancy free of ADL dependency, a disability-free expectancy</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
