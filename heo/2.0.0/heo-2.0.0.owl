    <!-- https://healtheconomics.wiki/concept/respite-care -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/respite-care">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
