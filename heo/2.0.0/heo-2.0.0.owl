    <!-- https://healtheconomics.wiki/concept/nephrotoxicity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/nephrotoxicity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/adverse-drug-reaction"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/adverse-drug-reaction"/>
        <skos:notation>HE-PE-CP-011</skos:notation>
        <dcterms:identifier>HE-PE-CP-011</dcterms:identifier>
        <dcterms:source>FDA-NIH Biomarker Working Group 2016</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Nephrotoxicity</rdfs:label>
        <skos:altLabel xml:lang="en">Kidney Toxicity</skos:altLabel>
        <skos:altLabel xml:lang="en">Renal Toxicity</skos:altLabel>
        <skos:definition xml:lang="en">An adverse effect in which a drug or treatment damages the kidneys, potentially impairing their normal filtering function.</skos:definition>
        <skos:prefLabel xml:lang="en">Nephrotoxicity</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/chronic-kidney-disease"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/nephrotoxicity"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/adverse-drug-reaction"/>
        <dcterms:identifier>HEO-L-c38093eaece2</dcterms:identifier>
        <linkRationale xml:lang="en">A noxious drug response damaging the kidneys</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/nephrotoxicity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/chronic-kidney-disease"/>
        <dcterms:identifier>HEO-L-ddf73cb232d4</dcterms:identifier>
        <skos:editorialNote xml:lang="en">suggested source, not yet checked: Perazella 2009</skos:editorialNote>
        <linkRationale xml:lang="en">Nephrotoxicity is an adverse drug effect (kidney damage) that causes kidney disease, not an exposure-type risk factor</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/nested-loop -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/nested-loop">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/monte-carlo-simulation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/monte-carlo-simulation"/>
        <skos:notation>HE-EM-UA-044</skos:notation>
        <dcterms:identifier>HE-EM-UA-044</dcterms:identifier>
        <dcterms:source>Briggs A, Claxton K, Sculpher M. Decision Modelling for Health Economic Evaluation. Oxford University Press; 2006. doi:10.1093/oso/9780198526629.001.0001.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Nested Loop</rdfs:label>
        <skos:altLabel xml:lang="en">Nested Monte Carlo</skos:altLabel>
        <skos:altLabel xml:lang="en">Two-Level Simulation</skos:altLabel>
        <skos:definition xml:lang="en">A simulation structure in which one inner simulation runs repeatedly within each iteration of an outer simulation, used to separate sources of uncertainty.</skos:definition>
        <skos:prefLabel xml:lang="en">Nested Loop</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/nested-loop"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/monte-carlo-simulation"/>
        <dcterms:identifier>HEO-L-c60392457d76</dcterms:identifier>
        <linkRationale xml:lang="en">A nested (two-level) simulation is a kind of Monte Carlo simulation, per the subject definition</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/net-benefit -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/net-benefit">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/expected-net-benefit"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/probability-of-cost-effectiveness"/>
        <skos:notation>HE-ES-CER-021</skos:notation>
        <dcterms:identifier>HE-ES-CER-021</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-30</dcterms:modified>
        <dcterms:source>Stinnett &amp; Mullahy 1998</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Net Benefit</rdfs:label>
        <owl:versionInfo>1.0.3</owl:versionInfo>
        <skos:definition xml:lang="en">Net benefit places health gains and costs on one scale by valuing health at a cost-effectiveness threshold, or directly in money, and subtracting costs.</skos:definition>
        <skos:hiddenLabel xml:lang="en">NB</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Net Benefit</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/icer"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/net-benefit"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-6f36479f79de</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: curated: review B: net monetary or health benefit is a core cost-effectiveness decision rule; the wiki topic Causal inference is itself a misfiling</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/net-benefit"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/expected-net-benefit"/>
        <dcterms:identifier>HEO-L-86d380520cf7</dcterms:identifier>
        <linkRationale xml:lang="en">Expected net benefit is the mean of net benefit across PSA draws</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/net-benefit"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/probability-of-cost-effectiveness"/>
        <dcterms:identifier>HEO-L-b8a08e9fe4ee</dcterms:identifier>
        <linkRationale xml:lang="en">Probability of cost-effectiveness is the share of simulations where net benefit is highest</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/net-benefit"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/icer"/>
        <dcterms:identifier>HEO-L-eb243278771d</dcterms:identifier>
        <linkRationale xml:lang="en">Net benefit avoids the ratio problems of the ICER (Stinnett and Mullahy 1998)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/net-benefit-approach -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/net-benefit-approach">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/decision-rule"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/decision-rule"/>
        <skos:notation>HE-EE-CBA-035</skos:notation>
        <dcterms:identifier>HE-EE-CBA-035</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-03</dcterms:modified>
        <dcterms:source>Stinnett &amp; Mullahy 1998</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Net Benefit Approach</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">NB Framework</skos:altLabel>
        <skos:definition xml:lang="en">The net benefit approach is a cost-effectiveness decision framework that ranks options by net benefit at a stated threshold instead of by ratios.</skos:definition>
        <skos:prefLabel xml:lang="en">Net Benefit Approach</skos:prefLabel>
        <abbreviation xml:lang="en">NB Framework</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/icer"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-threshold"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/expected-net-benefit"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/incremental-net-benefit"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/net-health-benefit"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/net-monetary-benefit"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/net-benefit-approach"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/decision-rule"/>
        <dcterms:identifier>HEO-L-c7086203a4b3</dcterms:identifier>
        <linkRationale xml:lang="en">The decision rule definition names net benefit as one such explicit criterion</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/net-benefit-approach"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/icer"/>
        <dcterms:identifier>HEO-L-3517940d0b2f</dcterms:identifier>
