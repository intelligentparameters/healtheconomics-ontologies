    <!-- https://healtheconomics.wiki/concept/efficiency-index -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/efficiency-index">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/efficiency"/>
        <skos:notation>HS-NHS-PM-008</skos:notation>
        <dcterms:identifier>HS-NHS-PM-008</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Charnes, Cooper &amp; Rhodes 1978</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Efficiency Index</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">An efficiency index is a specified numerical measure that compares a unit’s resource use and valued output with a defined benchmark or estimated production frontier.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Efficiency Score</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Relative Efficiency Measure</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Efficiency Index</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/efficiency-index"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-f2176bcb072a</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Performance productivity and quality in subdomain Health Systems</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/efficiency-index"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/efficiency"/>
        <dcterms:identifier>HEO-L-26a654583c03</dcterms:identifier>
        <linkRationale xml:lang="en">An efficiency index quantifies efficiency against a benchmark (subject definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
