    <!-- https://healtheconomics.wiki/concept/supplementary-protection-certificate -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/supplementary-protection-certificate">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
