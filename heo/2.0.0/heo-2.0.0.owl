    <!-- https://healtheconomics.wiki/concept/value-element -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/value-element">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/value-framework"/>
        <skos:notation>HS-NHS-VBH-023</skos:notation>
        <dcterms:identifier>HS-NHS-VBH-023</dcterms:identifier>
        <dcterms:source>Lakdawalla et al. 2017</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Value Element</rdfs:label>
        <skos:definition xml:lang="en">A specific, distinct component contributing to a technology&apos;s overall value, such as clinical benefit, caregiver burden effect, or real option value.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Value Component</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Value Dimension</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Value Element</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
