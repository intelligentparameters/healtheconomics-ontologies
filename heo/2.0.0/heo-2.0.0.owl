    <!-- https://healtheconomics.wiki/concept/capital-cost -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/capital-cost">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/fixed-cost"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
