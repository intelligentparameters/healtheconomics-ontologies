        <dcterms:identifier>HE-EM-DM-108</dcterms:identifier>
        <dcterms:source>HealthEconomics.wiki subdomain page https://healtheconomics.wiki/subdomain/economic-modelling (read 16 Oct 2026)</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
