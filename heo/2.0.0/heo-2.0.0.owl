    <!-- https://healtheconomics.wiki/concept/resource-measurement -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/resource-measurement">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/resource-use"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/micro-costing"/>
        <skos:notation>HE-EE-RM-003</skos:notation>
        <dcterms:identifier>HE-EE-RM-003</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Resource Measurement</rdfs:label>
        <skos:altLabel xml:lang="en">Resource Quantification</skos:altLabel>
        <skos:definition xml:lang="en">The process of quantifying the physical amount of a resource consumed in delivering a health intervention, such as staff hours or bed-days.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Utilisation Measurement</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Resource Measurement</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/resource-measurement"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-12a77d447e48</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Resource Measurement: measuring resource use is the first step of costing</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/resource-measurement"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
