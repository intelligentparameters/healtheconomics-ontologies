        <partOf rdf:resource="https://healtheconomics.wiki/concept/model-scope"/>
        <skos:notation>HE-EE-CEA-066</skos:notation>
        <dcterms:identifier>HE-EE-CEA-066</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015. | NICE. Health Technology Evaluations: The Manual (PMG36). | CADTH. Guidelines for the Economic Evaluation of Health Technologies: Canada. 4th ed. | PBAC. Guidelines for Preparing a Submission, Section 3A.2. | Zorginstituut Nederland. Guideline for Economic Evaluations in Healthcare. 2024.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Time Horizon</rdfs:label>
        <owl:versionInfo>1.5.22</owl:versionInfo>
        <skos:altLabel xml:lang="en">Analytic Horizon</skos:altLabel>
        <skos:definition xml:lang="en">The span of time over which an economic evaluation captures relevant differences in costs and outcomes among the options being compared.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Analytic Horizon Decision</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Evaluation Period</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Horizon Choice</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Time Horizon</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/delayed-outcome"/>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/extrapolation"/>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/future-cost"/>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/long-term-outcome"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/time-horizon"/>
