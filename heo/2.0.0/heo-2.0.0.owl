        <skos:prefLabel xml:lang="en">Healthcare Perspective</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/healthcare-sector-perspective"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/limited-societal-perspective"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/societal-perspective"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
