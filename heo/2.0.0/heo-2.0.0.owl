    <!-- https://healtheconomics.wiki/concept/signal-detection -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/signal-detection">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
