    <!-- https://healtheconomics.wiki/concept/pharmaceutical-benefits-scheme -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/pharmaceutical-benefits-scheme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
