        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/resource-use"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/risk-adjustment"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/case-complexity"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
