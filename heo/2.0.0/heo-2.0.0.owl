    <!-- https://healtheconomics.wiki/concept/passive-purchasing -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/passive-purchasing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/purchasing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/purchasing"/>
        <skos:notation>HS-HP-HF-050</skos:notation>
        <dcterms:identifier>HS-HP-HF-050</dcterms:identifier>
        <dcterms:source>WHO, Health Financing for Universal Coverage</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Passive Purchasing</rdfs:label>
        <skos:definition xml:lang="en">A financing approach in which a payer simply reimburses whatever services are provided, without negotiating price or monitoring quality.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Budget-Following Purchasing</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Passive Reimbursement</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Passive Purchasing</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/strategic-purchasing"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/passive-purchasing"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/purchasing"/>
        <dcterms:identifier>HEO-L-2c553052a2ef</dcterms:identifier>
        <linkRationale xml:lang="en">Passive purchasing is a kind of purchasing, contrasted with strategic purchasing</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/passive-purchasing"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/strategic-purchasing"/>
