    <!-- https://healtheconomics.wiki/concept/perfect-agent -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/perfect-agent">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/principal-agent-model"/>
        <skos:notation>HE-EE-ME-049</skos:notation>
        <dcterms:identifier>HE-EE-ME-049</dcterms:identifier>
        <dcterms:source>Arrow 1963</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Perfect Agent</rdfs:label>
        <skos:altLabel xml:lang="en">Perfect Agency</skos:altLabel>
        <skos:definition xml:lang="en">A theoretical benchmark in which an agent, such as a physician, decides exactly as the principal would if they held the same information.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Ideal Agent</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Perfect Agent</skos:prefLabel>
        <benchmarkFor rdf:resource="https://healtheconomics.wiki/concept/principal-agent-problem-in-healthcare"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/supplier-induced-demand"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/perfect-agent"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
