    <!-- https://healtheconomics.wiki/concept/productivity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/productivity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q2111958"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-NHS-PM-016</skos:notation>
        <dcterms:identifier>HS-NHS-PM-016</dcterms:identifier>
        <dcterms:source>Charnes, Cooper &amp; Rhodes 1978</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Productivity</rdfs:label>
        <skos:definition xml:lang="en">A measure of output produced relative to inputs consumed, assessing how efficiently a provider converts resources into patient care.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Economic Output Rate</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Output per Worker</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Productivity</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/baumol-effect"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/productivity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
