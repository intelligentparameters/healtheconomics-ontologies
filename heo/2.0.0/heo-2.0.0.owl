    <!-- https://healtheconomics.wiki/concept/best-practice-identification -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/best-practice-identification">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-system-performance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
