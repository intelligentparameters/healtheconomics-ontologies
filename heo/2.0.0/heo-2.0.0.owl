    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/patient-assistance-programme -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/patient-assistance-programme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/patient-access-programme"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/patient-access-programme"/>
        <skos:notation>HS-DC-MA-019</skos:notation>
        <dcterms:identifier>HS-DC-MA-019</dcterms:identifier>
        <dcterms:source>Carlson JJ, Sullivan SD, Garrison LP, Neumann PJ, Veenstra DL. Linking payment to health outcomes: a taxonomy and examination of performance-based reimbursement schemes. Health Policy. 2010;96(3):179-190.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Patient Assistance Programme</rdfs:label>
        <skos:definition xml:lang="en">A manufacturer-sponsored programme providing free or discounted medication to eligible patients who cannot otherwise afford treatment, based on income or insurance status.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Copay Assistance Programme</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Manufacturer Assistance Programme</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Patient Assistance Programme</skos:prefLabel>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/patient-access"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/out-of-pocket-cost"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/patient-assistance-programme"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/patient-access-programme"/>
        <dcterms:identifier>HEO-L-7b39f17211ef</dcterms:identifier>
        <linkRationale xml:lang="en">A manufacturer assistance programme is a patient access programme</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/patient-assistance-programme"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#promotes"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/patient-access"/>
        <dcterms:identifier>HEO-L-2e8462945c93</dcterms:identifier>
        <linkRationale xml:lang="en">Free or discounted medicine helps patients obtain treatment</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
