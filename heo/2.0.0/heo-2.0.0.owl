        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/reinsurance"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/risk-sharing"/>
        <dcterms:identifier>HEO-L-42f38c022918</dcterms:identifier>
        <linkRationale xml:lang="en">The risk sharing definition names insurer and reinsurer as an example.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
