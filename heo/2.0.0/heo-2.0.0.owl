        <dcterms:identifier>HS-SS_IC-008</dcterms:identifier>
        <dcterms:source>Von Korff &amp; Tiemens 2000</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Tiered Care</rdfs:label>
        <skos:definition xml:lang="en">A delivery model organising services into distinct levels of intensity, matching patients to the tier appropriate for their current clinical needs.</skos:definition>
