    <!-- https://healtheconomics.wiki/concept/centralized-system -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/centralized-system">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
