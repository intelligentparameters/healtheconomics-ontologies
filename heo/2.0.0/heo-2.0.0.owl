    <!-- https://healtheconomics.wiki/concept/tarone-ware-test -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/tarone-ware-test">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/weighted-log-rank"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/weighted-log-rank"/>
        <skos:notation>HE-EM-SM-085</skos:notation>
        <dcterms:identifier>HE-EM-SM-085</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Tarone &amp; Ware 1977</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Tarone-Ware Test</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Tarone-Ware Statistic</skos:altLabel>
        <skos:definition xml:lang="en">A test comparing survival distributions using a weighting scheme between the log-rank and Peto tests, a compromise depending on when treatment differences emerge.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Tarone-Ware Weighting</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Tarone-Ware Test</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/log-rank-test"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/wilcoxon-test"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/tarone-ware-test"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/weighted-log-rank"/>
        <dcterms:identifier>HEO-L-c7a178329779</dcterms:identifier>
        <linkRationale xml:lang="en">Tarone-Ware is one weighted log-rank test.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/tarone-ware-test"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/log-rank-test"/>
        <dcterms:identifier>HEO-L-27fd19578b8d</dcterms:identifier>
        <linkRationale xml:lang="en">Tarone-Ware weighting is an alternative to the unweighted log-rank test.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
