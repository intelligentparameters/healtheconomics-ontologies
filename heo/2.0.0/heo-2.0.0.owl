    <!-- https://healtheconomics.wiki/concept/impoverishing-health-expenditure -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/impoverishing-health-expenditure">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
