    <!-- https://healtheconomics.wiki/concept/type-i-error -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/type-i-error">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/hypothesis-testing"/>
        <skos:notation>HE-ES-SA-224</skos:notation>
        <dcterms:identifier>HE-ES-SA-224</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Neyman &amp; Pearson 1933</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Type I Error</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Alpha Error</skos:altLabel>
        <skos:altLabel xml:lang="en">False Positive Error</skos:altLabel>
        <skos:definition xml:lang="en">In hypothesis testing, the error of incorrectly rejecting a true null hypothesis, concluding a genuine effect exists when it does not.</skos:definition>
        <skos:prefLabel xml:lang="en">Type I Error</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/type-ii-error"/>
