    <!-- https://healtheconomics.wiki/concept/disease-surveillance -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/disease-surveillance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
