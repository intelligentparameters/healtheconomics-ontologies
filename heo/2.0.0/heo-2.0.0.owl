        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">PRO-CTCAE</rdfs:label>
        <skos:altLabel xml:lang="en">Patient-Reported CTCAE</skos:altLabel>
        <skos:definition xml:lang="en">A patient-reported system complementing the clinician-reported Common Terminology Criteria for Adverse Events, letting patients report symptom frequency, severity, and interference directly.</skos:definition>
