    <!-- https://healtheconomics.wiki/concept/magnitude-estimation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/magnitude-estimation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
