        <skos:altLabel xml:lang="en">Para IV Certification</skos:altLabel>
        <skos:definition xml:lang="en">A patent certification filed by a generic manufacturer asserting a listed patent is invalid or not infringed, initiating a process affecting generic entry timing.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Patent Paragraph IV</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Paragraph Iv Certification</skos:prefLabel>
        <abbreviation xml:lang="en">Para IV Certification</abbreviation>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
