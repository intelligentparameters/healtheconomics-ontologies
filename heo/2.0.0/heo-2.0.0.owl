        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Probability-to-Rate Conversion</rdfs:label>
        <skos:definition xml:lang="en">The mathematical transformation converting a probability of an event over a discrete time interval into its corresponding continuous-time hazard rate.</skos:definition>
