    <!-- https://healtheconomics.wiki/concept/consent-capacity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/consent-capacity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/informed-consent"/>
        <skos:notation>HS-HP-HD-030</skos:notation>
        <dcterms:identifier>HS-HP-HD-030</dcterms:identifier>
        <dcterms:source>Appelbaum &amp; Grisso 1988</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Consent Capacity</rdfs:label>
        <skos:altLabel xml:lang="en">Capacity to Consent</skos:altLabel>
        <skos:definition xml:lang="en">An individual&apos;s clinical ability to understand information, appreciate consequences, and communicate a choice, the foundational requirement for valid consent.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Decision-Making Capacity</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Consent Capacity</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/competence"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
