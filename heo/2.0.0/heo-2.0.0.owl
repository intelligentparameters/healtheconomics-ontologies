        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/informed-consent-for-research"/>
        <dcterms:identifier>HEO-L-193f00213baa</dcterms:identifier>
