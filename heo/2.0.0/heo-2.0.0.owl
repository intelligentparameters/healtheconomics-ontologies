        <dcterms:identifier>HEO-L-6fbce0242c09</dcterms:identifier>
        <linkRationale xml:lang="en">Fixed effects estimation is a panel regression approach</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
