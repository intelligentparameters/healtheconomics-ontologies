        <rdfs:label xml:lang="en">Net Price</rdfs:label>
        <skos:definition xml:lang="en">The actual price a manufacturer realises for a treatment after all rebates and discounts, distinct from its publicly listed gross price.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Discounted Transaction Price</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Post-Rebate Price</skos:hiddenLabel>
