    <!-- https://healtheconomics.wiki/concept/interpretability-assessment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/interpretability-assessment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-assessment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-assessment"/>
        <skos:notation>HE-ES-EA-024</skos:notation>
        <dcterms:identifier>HE-ES-EA-024</dcterms:identifier>
        <dcterms:source>Guyatt et al. 2002</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Interpretability Assessment</rdfs:label>
        <skos:definition xml:lang="en">An evaluation of whether an outcome measure&apos;s numerical scores can be meaningfully understood in terms of real-world clinical significance.</skos:definition>
