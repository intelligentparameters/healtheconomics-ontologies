    <!-- https://healtheconomics.wiki/concept/minimally-invasive-surgery -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/minimally-invasive-surgery">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/surgical-therapy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/surgical-therapy"/>
        <skos:notation>HE-PE-AT-008</skos:notation>
        <dcterms:identifier>HE-PE-AT-008</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Minimally Invasive Surgery</rdfs:label>
        <skos:altLabel xml:lang="en">MIS</skos:altLabel>
        <skos:definition xml:lang="en">Surgical techniques using smaller incisions and specialised instruments to reduce tissue damage compared with traditional open surgery, often shortening recovery.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Keyhole Surgery</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Minimally Invasive Surgery</skos:prefLabel>
        <abbreviation xml:lang="en">MIS</abbreviation>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/length-of-stay"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
