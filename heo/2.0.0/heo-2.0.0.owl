        <skos:prefLabel xml:lang="en">Quality of Life Response</skos:prefLabel>
        <abbreviation xml:lang="en">QoL Response</abbreviation>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/minimal-clinically-important-difference"/>
    </owl:NamedIndividual>
