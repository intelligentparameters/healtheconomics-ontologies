    <!-- https://healtheconomics.wiki/concept/economic-evaluation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/economic-evaluation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-economics"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q18391886"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-economics"/>
        <skos:notation>HE-EE-CEA-023</skos:notation>
        <dcterms:identifier>HE-EE-CEA-023</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Drummond MF et al. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. 2015. https://global.oup.com/academic/product/methods-for-the-economic-evaluation-of-health-care-programmes-9780199665884 | Husereau D et al. CHEERS 2022. https://doi.org/10.1136/bmj-2021-067975 | NICE. Health technology evaluations: the manual—Economic evaluation. https://www.nice.org.uk/process/pmg36/chapter/economic-evaluation-2 | WHO. Economic Evaluation and Analysis. https://www.who.int/teams/health-financing-and-economics/economic-analysis</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Economic Evaluation</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/subdomain/economic-evaluation"/>
        <owl:versionInfo>1.4.60</owl:versionInfo>
        <skos:definition xml:lang="en">Economic evaluation, often called health economic evaluation, compares the costs and outcomes of healthcare options to judge which offers the best value.</skos:definition>
        <skos:editorialNote xml:lang="en">In HEO this concept is the wiki subdomain Economic Evaluation, directly under Health Economics. Concepts in that subdomain with no is-type-of parent are classified under it or under a concept within it.</skos:editorialNote>
        <skos:hiddenLabel xml:lang="en">Cost-Outcome Analysis</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Health Economic Appraisal</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Economic Evaluation</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-1"/>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/value-for-money"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/decision"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/economic-evidence"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/deterministic-analysis"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/discounting"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/exponential-discounting"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/friction-cost-method"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/gross-costing"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/health-economic-model"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/human-capital-approach"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/economic-evaluation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
