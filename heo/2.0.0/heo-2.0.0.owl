        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">NICE Threshold</rdfs:label>
        <skos:altLabel xml:lang="en">NICE Cost-Effectiveness Threshold</skos:altLabel>
        <skos:altLabel xml:lang="en">NICE QALY Threshold</skos:altLabel>
        <skos:definition xml:lang="en">The NICE threshold is the £25,000 to £35,000 per QALY gained range NICE committees use to judge whether an ICER is an effective use of NHS resources.</skos:definition>
        <skos:prefLabel xml:lang="en">NICE Threshold</skos:prefLabel>
        <benchmarkFor rdf:resource="https://healtheconomics.wiki/concept/icer"/>
        <instanceOf rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-threshold"/>
