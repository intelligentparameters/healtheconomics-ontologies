    <!-- https://healtheconomics.wiki/concept/line-item-budget -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/line-item-budget">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <skos:notation>HS-HP-PP-062</skos:notation>
        <dcterms:identifier>HS-HP-PP-062</dcterms:identifier>
        <dcterms:source>Musgrave &amp; Musgrave 1989</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Line-Item Budget</rdfs:label>
        <skos:altLabel xml:lang="en">Line-Item Budgeting</skos:altLabel>
        <skos:altLabel xml:lang="en">Object-of-Expenditure Budget</skos:altLabel>
        <skos:definition xml:lang="en">A budget format specifying allocated spending for each individual expense category, such as salaries and supplies, rather than by programme.</skos:definition>
        <skos:prefLabel xml:lang="en">Line-Item Budget</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/programme-budgeting"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/line-item-budget"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-59d13a115c45</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Provider Payment: wiki topic Provider payment sits in Health Systems; placed under Provider Payment, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/line-item-budget"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/programme-budgeting"/>
        <dcterms:identifier>HEO-L-4cadca09c283</dcterms:identifier>
        <linkRationale xml:lang="en">A line-item budget is a format set by expense category rather than by programme, per both definitions; not every line-item budget is an operating budget (capital budgets can be line-item)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


