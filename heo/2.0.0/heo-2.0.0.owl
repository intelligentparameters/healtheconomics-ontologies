    <!-- https://healtheconomics.wiki/concept/patient-family-perspective -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/patient-family-perspective">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/perspective"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/perspective"/>
        <skos:notation>HE-EE-EPR-035</skos:notation>
        <dcterms:identifier>HE-EE-EPR-035</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Patient Family Perspective</rdfs:label>
        <skos:altLabel xml:lang="en">Patient-and-Family Perspective</skos:altLabel>
        <skos:definition xml:lang="en">An analytic viewpoint including costs and outcomes experienced by a patient&apos;s family, such as informal caregiving time and lost income, alongside the patient&apos;s own.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Carer Perspective</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Patient Family Perspective</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/patient-perspective"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/societal-perspective"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
