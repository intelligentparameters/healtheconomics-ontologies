    <!-- https://healtheconomics.wiki/concept/behavioural-economics -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/behavioural-economics">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:notation>HE-EE-BE-044</skos:notation>
        <dcterms:identifier>HE-EE-BE-044</dcterms:identifier>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Behavioural Economics</rdfs:label>
        <skos:altLabel xml:lang="en">Behavioral Economics</skos:altLabel>
        <skos:definition xml:lang="en">The study of how psychological, cognitive and social factors cause economic decisions to depart from the predictions of standard rational-choice theory.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Psychology of Economic Decisions</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Behavioural Economics</skos:prefLabel>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/active-choice"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/boost-intervention"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/choice-architecture-intervention"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/default-intervention"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/nudge-intervention"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/remembered-utility"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/salience-intervention"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/simplification-intervention"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/social-norm-intervention"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/behavioural-economics"/>
