    <!-- https://healtheconomics.wiki/concept/level-of-evidence -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/level-of-evidence">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-assessment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-assessment"/>
        <skos:notation>HE-ES-EA-027</skos:notation>
        <dcterms:identifier>HE-ES-EA-027</dcterms:identifier>
        <dcterms:source>Guyatt GH, Oxman AD, Vist GE, et al. GRADE: an emerging consensus on rating quality of evidence and strength of recommendations. BMJ. 2008;336:924-926. doi:10.1136/bmj.39489.470347.AD.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Level of Evidence</rdfs:label>
        <skos:definition xml:lang="en">A classification ranking a study design&apos;s strength based on its susceptibility to bias, placing randomised trials above case reports or opinion.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Evidence Hierarchy</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Evidence Hierarchy Rank</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Evidence Level</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Hierarchy of Evidence</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Level of Evidence</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/strength-of-evidence"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/study-design"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/level-of-evidence"/>
