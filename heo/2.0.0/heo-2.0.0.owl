        <informs rdf:resource="https://healtheconomics.wiki/concept/coverage-decision"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/price-volume-agreement"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/budget-impact"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/budget-impact-model"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/drug-cost"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/eligible-population"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/uptake-rate"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
