    <!-- https://healtheconomics.wiki/concept/floor-effect -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/floor-effect">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/measurement-error"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q132169"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/measurement-error"/>
        <skos:notation>HE-EE-HU-026</skos:notation>
        <dcterms:identifier>HE-EE-HU-026</dcterms:identifier>
        <dcterms:source>McHorney &amp; Tarlov 1995</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Floor Effect</rdfs:label>
        <skos:definition xml:lang="en">A measurement limitation in which many respondents score at or near the worst possible value, leaving an instrument unable to detect further deterioration.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Bottom-End Clustering</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Floor Limitation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Floor Effect</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/outcome-measure"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/floor-effect"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/measurement-error"/>
        <dcterms:identifier>HEO-L-2ee248c7021f</dcterms:identifier>
        <linkRationale xml:lang="en">Matches Ceiling Effect typing; truncated scores misstate true values</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/floor-effect"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#threatensValidityOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/outcome-measure"/>
        <dcterms:identifier>HEO-L-c2fb4de53338</dcterms:identifier>
        <linkRationale xml:lang="en">Floor effects limit an outcome measure ability to detect change</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


