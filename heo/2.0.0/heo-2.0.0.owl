        <dcterms:identifier>HEO-L-7926be73dc0c</dcterms:identifier>
        <linkRationale xml:lang="en">BAT is an existing active treatment used as comparator, not placebo.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
