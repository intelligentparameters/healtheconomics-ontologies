        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Level</rdfs:label>
        <skos:definition xml:lang="en">A specific value an attribute can take within a discrete choice experiment, such as a waiting time of two weeks versus six.</skos:definition>
