    <!-- https://healtheconomics.wiki/concept/stroke-centre -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/stroke-centre">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/healthcare-facility"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/healthcare-facility"/>
        <skos:notation>HS-HP-HD-107</skos:notation>
        <dcterms:identifier>HS-HP-HD-107</dcterms:identifier>
        <dcterms:source>AHA, American Hospital Association</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Stroke Centre</rdfs:label>
        <skos:definition xml:lang="en">A specialist facility or unit equipped for rapid, specialised stroke treatment, often certified according to established stroke care quality standards.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Acute Stroke Facility</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Stroke Unit</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Stroke Centre</skos:prefLabel>
        <performs rdf:resource="https://healtheconomics.wiki/concept/emergency-care"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/stroke-centre"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/healthcare-facility"/>
        <dcterms:identifier>HEO-L-2c40082eb8aa</dcterms:identifier>
        <linkRationale xml:lang="en">A stroke centre is a facility or unit, not a delivery approach; it is a kind of healthcare facility.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
