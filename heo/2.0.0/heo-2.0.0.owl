        <produces rdf:resource="https://healtheconomics.wiki/concept/variance-covariance-matrix"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
