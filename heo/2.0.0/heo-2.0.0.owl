    <!-- https://healtheconomics.wiki/concept/demand -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/demand">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/equilibrium-price"/>
        <skos:notation>HE-EE-ME-014</skos:notation>
        <dcterms:identifier>HE-EE-ME-014</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-02</dcterms:modified>
        <dcterms:source>Varian 2014</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Demand</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Demand is the schedule of quantities of a good or service, such as health care, that people are willing and able to buy at each price over a given period.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Purchase Willingness</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Demand</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/supply"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/market-equilibrium"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/demand"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-8b891f785a20</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Policy Analysis: catalogue group Health Policy is one of the subdomains</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/demand"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/equilibrium-price"/>
        <dcterms:identifier>HEO-L-2e0e031d54ce</dcterms:identifier>
        <linkRationale xml:lang="en">Equilibrium price is where quantity demanded equals quantity supplied, so the demand schedule is an input</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
