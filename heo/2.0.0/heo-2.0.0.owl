        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/transition-probability"/>
        <skos:notation>HE-EM-MM-005</skos:notation>
        <dcterms:identifier>HE-EM-MM-005</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-03</dcterms:modified>
        <dcterms:source>Sonnenberg &amp; Beck 1993</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cycle Length</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Time Step</skos:altLabel>
        <skos:definition xml:lang="en">Cycle length is the duration of one cycle in a Markov or other discrete-time state-transition model, such as a month or a year, set before the model runs.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cycle Duration</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Cycle-Length Choice</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Iteration Interval</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Simulation Step</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Time-Step Length</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Time-Step Selection</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cycle Length</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-3"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/cycle"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/discrete-model"/>
        <prerequisiteFor rdf:resource="https://healtheconomics.wiki/concept/half-cycle-correction"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/tunnel-state"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cycle-length"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/markov-model"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-86f3a32f0bac</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Markov and state transition models in subdomain Economic Modelling; placed under Markov Model, the concept named by its catalogue Level 3</linkRationale>
