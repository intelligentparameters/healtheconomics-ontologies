    <!-- https://healtheconomics.wiki/concept/cost-shifting -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cost-shifting">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-HP-EXP-003</skos:notation>
        <dcterms:identifier>HS-HP-EXP-003</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</dcterms:modified>
        <dcterms:source>Frakt 2011</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cost Shifting</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Cost shifting is the transfer of health care costs from one payer or sector to another, as when hospitals raise private prices after public payment cuts.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cost Transfer</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Cross-Payer Shifting</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cost Shifting</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/private-insurance-premium"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cost-shifting"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-2bee8b730466</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health Expenditure: spending is part of health financing (Health financing and insurance)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cost-shifting"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/private-insurance-premium"/>
        <dcterms:identifier>HEO-L-dc9a50a11cd1</dcterms:identifier>
        <linkRationale xml:lang="en">Cost shifting does not cause unpaid care; definition says it raises private prices, feeding premiums</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/cost-standardization -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cost-standardization">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-adjustment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cost-adjustment"/>
        <skos:notation>HE-EE-CM-010</skos:notation>
        <dcterms:identifier>HE-EE-CM-010</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cost Standardization</rdfs:label>
        <skos:altLabel xml:lang="en">Cost Standardisation</skos:altLabel>
        <skos:definition xml:lang="en">The process of adjusting cost estimates so they are expressed in comparable terms, such as a common currency or price year, across studies.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Comparable Costing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cost Standardization</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/cost-conversion"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cost-standardization"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-adjustment"/>
        <dcterms:identifier>HEO-L-34de8ed119d8</dcterms:identifier>
        <linkRationale xml:lang="en">Standardising to a common currency or price year is a cost adjustment</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cost-standardization"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-conversion"/>
        <dcterms:identifier>HEO-L-00008d7fd6ae</dcterms:identifier>
        <linkRationale xml:lang="en">relatedTo retired; standardisation applies currency and price-year conversion</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/cost-structure -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cost-structure">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:notation>HE-EM-DM-015</skos:notation>
        <dcterms:identifier>HE-EM-DM-015</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cost Structure</rdfs:label>
        <skos:definition xml:lang="en">The composition of an organisation&apos;s or intervention&apos;s total costs across categories, such as fixed and variable, or direct and indirect.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cost Composition</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Cost Mix</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cost Structure</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/economies-of-scale"/>
