    <!-- https://healtheconomics.wiki/concept/effect-modification -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/effect-modification">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/epidemiology"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/epidemiology"/>
        <skos:notation>HE-ES-EP-011</skos:notation>
        <dcterms:identifier>HE-ES-EP-011</dcterms:identifier>
        <dcterms:source>Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams &amp; Wilkins; 2008.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Effect Modification</rdfs:label>
        <skos:altLabel xml:lang="en">Effect Measure Modification</skos:altLabel>
        <skos:altLabel xml:lang="en">Moderation</skos:altLabel>
        <skos:definition xml:lang="en">A situation where an exposure&apos;s effect on an outcome genuinely differs across levels of a third variable, unlike confounding, which is a bias.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Measure-Dependent Effect</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Statistical Interaction</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Effect Modification</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/interaction"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/effect-modification"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/epidemiology"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-d4ee0548dad3</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Epidemiology: catalogue subdomain Evidence Synthesis is one of the subdomains; placed under Epidemiology, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/effect-modification"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/interaction"/>
        <dcterms:identifier>HEO-L-4f7418b9186b</dcterms:identifier>
        <linkRationale xml:lang="en">effect modification and interaction are distinguished in epidemiology (VanderWeele 2009)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
