    <!-- https://healtheconomics.wiki/concept/cost-centre-budget -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cost-centre-budget">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
