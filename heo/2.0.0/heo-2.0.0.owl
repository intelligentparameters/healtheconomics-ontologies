    <!-- https://healtheconomics.wiki/concept/main-effect -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/main-effect">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/parameter-importance"/>
        <skos:notation>HE-EM-UA-051</skos:notation>
        <dcterms:identifier>HE-EM-UA-051</dcterms:identifier>
        <dcterms:source>Saltelli et al. 2008</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Main Effect</rdfs:label>
        <skos:definition xml:lang="en">The portion of output variance attributable to a single input parameter considered on its own, distinguished from its interaction effects with others.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Marginal Effect Term</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Principal Effect</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Main Effect</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/interaction-effect"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-10"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/main-effect"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-2517016e7874</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Uncertainty and sensitivity analysis in subdomain Economic Modelling</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/main-effect"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/parameter-importance"/>
        <dcterms:identifier>HEO-L-1ad83e8a2925</dcterms:identifier>
        <linkRationale xml:lang="en">A main effect is the variance share from one input; it measures that input&apos;s importance, not variance</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
