    <!-- https://healtheconomics.wiki/concept/healthcare-perspective -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/healthcare-perspective">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/perspective"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/perspective"/>
        <skos:notation>HE-EE-CEA-033</skos:notation>
        <dcterms:identifier>HE-EE-CEA-033</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Healthcare Perspective</rdfs:label>
        <skos:altLabel xml:lang="en">Health System Perspective</skos:altLabel>
        <skos:definition xml:lang="en">An analytic viewpoint including only costs and outcomes falling on the healthcare payer or provider, excluding broader costs such as productivity loss.</skos:definition>
