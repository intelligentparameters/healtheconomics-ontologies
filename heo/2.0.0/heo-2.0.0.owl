    <!-- https://healtheconomics.wiki/concept/regression-to-mean -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/regression-to-mean">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-ES-SA-178</skos:notation>
        <dcterms:identifier>HE-ES-SA-178</dcterms:identifier>
        <dcterms:source>Galton 1886</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Regression to Mean</rdfs:label>
        <skos:altLabel xml:lang="en">RTM</skos:altLabel>
        <skos:definition xml:lang="en">The phenomenon whereby an extreme initial measurement tends to be followed by one closer to average, simply from natural random variation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Mean Reversion Artefact</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Regression to Mean</skos:prefLabel>
        <abbreviation xml:lang="en">RTM</abbreviation>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/before-and-after-study"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/regression-to-mean"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-e9231eb29c7d</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Statistical Analysis: catalogue subdomain Evidence Synthesis is one of the subdomains</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/regression-to-mean"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#threatensValidityOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/before-and-after-study"/>
