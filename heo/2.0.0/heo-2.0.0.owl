    <!-- https://healtheconomics.wiki/concept/effectiveness-evaluation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/effectiveness-evaluation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/comparative-effectiveness-research"/>
