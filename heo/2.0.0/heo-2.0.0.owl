    <!-- https://healtheconomics.wiki/concept/linear-pool -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/linear-pool">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/value-of-information"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/value-of-information"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/expert-elicitation"/>
        <skos:notation>HE-EM-VI-018</skos:notation>
        <dcterms:identifier>HE-EM-VI-018</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-24</dcterms:modified>
        <dcterms:source>Cooke 1991</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Linear Pool</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Linear Opinion Pool</skos:altLabel>
        <skos:definition xml:lang="en">A method combining multiple experts&apos; probability distributions by taking a weighted arithmetic average, producing a single pooled distribution.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Weighted Linear Aggregation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Linear Pool</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/logarithmic-pool"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-11"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/prior-distribution"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/linear-pool"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/value-of-information"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-af92bf0e1367</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Value of information in subdomain Economic Modelling; placed under Value of Information, the concept named by its wiki topic</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/linear-pool"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/expert-elicitation"/>
        <dcterms:identifier>HEO-L-24fe3f368fb0</dcterms:identifier>
        <linkRationale xml:lang="en">Mathematical pooling of experts is one step of an elicitation exercise, not a kind of elicitation process</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/linear-pool"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/logarithmic-pool"/>
        <dcterms:identifier>HEO-L-90e616bbf650</dcterms:identifier>
        <linkRationale xml:lang="en">Arithmetic versus geometric weighted averaging are the two standard alternative pooling rules</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/linear-pool"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#produces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/prior-distribution"/>
