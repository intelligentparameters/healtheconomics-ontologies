    <!-- https://healtheconomics.wiki/concept/coverage-deepening -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/coverage-deepening">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/coverage-expansion"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/coverage-expansion"/>
        <skos:notation>HS_SS_HS-003</skos:notation>
        <dcterms:identifier>HS_SS_HS-003</dcterms:identifier>
        <dcterms:source>WHO, Health Financing for Universal Coverage</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Coverage Deepening</rdfs:label>
        <skos:definition xml:lang="en">An expansion in the range of services covered or depth of financial protection provided by a scheme, distinct from population breadth.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Depth Expansion</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Service-Range Expansion</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Coverage Deepening</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/universal-health-coverage"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/coverage-deepening"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/coverage-expansion"/>
        <dcterms:identifier>HEO-L-0cd30d7f6336</dcterms:identifier>
        <linkRationale xml:lang="en">Coverage expansion includes adding services or cutting cost sharing</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/coverage-deepening"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
