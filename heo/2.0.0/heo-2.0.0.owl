    <!-- https://healtheconomics.wiki/concept/economic-choice -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/economic-choice">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/decision-making"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/decision-making"/>
        <skos:notation>HE-EE-EPR-007</skos:notation>
        <dcterms:identifier>HE-EE-EPR-007</dcterms:identifier>
        <dcterms:source>Varian 2014</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Economic Choice</rdfs:label>
        <skos:definition xml:lang="en">A decision made among competing alternatives under scarcity, guided by the relative costs and benefits of each option.</skos:definition>
