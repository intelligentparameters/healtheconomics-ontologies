        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/threshold-analysis"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/two-way-sensitivity-analysis"/>
        <skos:notation>HE-EM-UA-079</skos:notation>
        <dcterms:identifier>HE-EM-UA-079</dcterms:identifier>
        <dcterms:source>Briggs A, Claxton K, Sculpher M. Decision Modelling for Health Economic Evaluation. Oxford University Press; 2006. doi:10.1093/oso/9780198526629.001.0001.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Two-Way Threshold Analysis</rdfs:label>
        <skos:definition xml:lang="en">A threshold analysis technique identifying the combinations of two parameter values at which a model&apos;s decision conclusion would switch to another outcome.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Bivariate Threshold Analysis</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Two-Parameter Threshold</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Two-Way Threshold Analysis</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
