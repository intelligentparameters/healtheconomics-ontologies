    <!-- https://healtheconomics.wiki/concept/consolidation-therapy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/consolidation-therapy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/treatment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/treatment"/>
        <precedes rdf:resource="https://healtheconomics.wiki/concept/maintenance-therapy"/>
        <skos:notation>HE-PE-DT-007</skos:notation>
        <dcterms:identifier>HE-PE-DT-007</dcterms:identifier>
        <dcterms:source>DeVita, Lawrence &amp; Rosenberg 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Consolidation Therapy</rdfs:label>
        <skos:altLabel xml:lang="en">Consolidation Treatment</skos:altLabel>
        <skos:definition xml:lang="en">A treatment given after successful induction therapy has reduced disease burden, intended to eliminate remaining disease and reduce relapse risk.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Post-Induction Therapy</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Consolidation Therapy</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/recurrence"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/consolidation-therapy"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/treatment"/>
        <dcterms:identifier>HEO-L-e6209e26499e</dcterms:identifier>
        <linkRationale xml:lang="en">Consolidation therapy is a treatment phase given after induction (subject definition); Treatment is the broader concept</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/consolidation-therapy"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#precedes"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/maintenance-therapy"/>
        <dcterms:identifier>HEO-L-466ba8e2d35a</dcterms:identifier>
        <linkRationale xml:lang="en">Induction, consolidation, maintenance is the standard sequence; consolidation aims to cut relapse risk.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/consolidation-therapy"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/recurrence"/>
        <dcterms:identifier>HEO-L-9be78642910d</dcterms:identifier>
