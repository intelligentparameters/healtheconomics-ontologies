        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Coordinated Care</skos:altLabel>
        <skos:definition xml:lang="en">Care coordination is the deliberate organisation of care among a patient&apos;s providers and the patient, sharing information for appropriate, efficient care.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Care Orchestration</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Care Coordination</skos:prefLabel>
