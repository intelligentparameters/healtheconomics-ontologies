    <!-- https://healtheconomics.wiki/concept/health-inequality -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/health-inequality">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:notation>HS-HP-HE-021</skos:notation>
        <dcterms:identifier>HS-HP-HE-021</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Arcaya et al. 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Health Inequality</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Health Inequalities</skos:altLabel>
        <skos:definition xml:lang="en">Health inequality is a measurable difference in health between individuals or groups, described without judging whether the difference is unfair.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Health Status Difference</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Health Inequality</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-policy#step-4"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/population-health"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/health-inequality"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-ab59dbe13c6b</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Equity and inequality in subdomain Health Policy</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/health-inequality"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isPropertyOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/population-health"/>
        <dcterms:identifier>HEO-L-c372ba35fa8d</dcterms:identifier>
        <linkRationale xml:lang="en">Inequality describes the distribution component of population health.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/health-inequity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/health-inequity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-inequality"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q112220443"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-inequality"/>
        <skos:notation>HS-HP-HE-022</skos:notation>
        <dcterms:identifier>HS-HP-HE-022</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Whitehead 1992</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Health Inequity</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Health Inequities</skos:altLabel>
        <skos:definition xml:lang="en">Health inequity is a difference in health judged avoidable, unfair and unjust, often arising from social or economic disadvantage rather than biology.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Unfair Health Difference</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Health Inequity</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-policy#step-4"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/health-inequity"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-inequality"/>
        <dcterms:identifier>HEO-L-160b1b0105c8</dcterms:identifier>
        <linkRationale xml:lang="en">Every inequity is a measurable health difference that is also judged unfair, so a type of inequality.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/health-information-block -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/health-information-block">
