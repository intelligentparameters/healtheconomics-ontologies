    <!-- https://healtheconomics.wiki/concept/maximin-criterion -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/maximin-criterion">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/egalitarian-welfare"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/egalitarian-welfare"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/rawlsian-justice"/>
        <skos:notation>HE-EE-WE-014</skos:notation>
        <dcterms:identifier>HE-EE-WE-014</dcterms:identifier>
        <dcterms:source>Rawls 1971</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Maximin Criterion</rdfs:label>
        <skos:altLabel xml:lang="en">Maximin Rule</skos:altLabel>
        <skos:altLabel xml:lang="en">Rawlsian Criterion</skos:altLabel>
        <skos:definition xml:lang="en">A social welfare decision rule judging an allocation by the wellbeing of the worst-off group, seeking to maximise that minimum level.</skos:definition>
        <skos:prefLabel xml:lang="en">Maximin Criterion</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/maximin-criterion"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/egalitarian-welfare"/>
        <dcterms:identifier>HEO-L-7f38cd6cb3fa</dcterms:identifier>
        <linkRationale xml:lang="en">Maximin is the extreme egalitarian rule, giving absolute priority to the worst-off; the approach does not require it</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/maximin-criterion"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/rawlsian-justice"/>
        <dcterms:identifier>HEO-L-f51bc3bf3078</dcterms:identifier>
        <linkRationale xml:lang="en">Maximin is the decision principle of Rawls&apos; theory, more precise than the whole field of distributive justice</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/maximum-likelihood-estimation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/maximum-likelihood-estimation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1045555"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:notation>HE-ES-SA-109</skos:notation>
        <dcterms:identifier>HE-ES-SA-109</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Fisher 1922</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Maximum Likelihood Estimation</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">MLE</skos:altLabel>
        <skos:definition xml:lang="en">A method estimating a model&apos;s parameters by finding the values that make the observed data most probable.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Likelihood Maximisation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Maximum Likelihood Estimation</skos:prefLabel>
        <abbreviation xml:lang="en">MLE</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/method-of-moments"/>
