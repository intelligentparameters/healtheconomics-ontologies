    <!-- https://healtheconomics.wiki/concept/technology-withdrawal -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/technology-withdrawal">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/horizon-scanning"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/horizon-scanning"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/technology-lifecycle"/>
        <skos:notation>HS-HP-HS-024</skos:notation>
        <dcterms:identifier>HS-HP-HS-024</dcterms:identifier>
        <dcterms:source>Elshaug et al. 2012</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Technology Withdrawal</rdfs:label>
        <skos:definition xml:lang="en">The formal removal of a technology from the market or routine use, whether from regulatory safety concerns or commercial reasons.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Device Withdrawal</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Technology Removal</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Technology Withdrawal</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
