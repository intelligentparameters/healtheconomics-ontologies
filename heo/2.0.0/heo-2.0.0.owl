    <!-- https://healtheconomics.wiki/concept/comparator -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/comparator">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/intervention"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/intervention"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/decision-problem"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/economic-evaluation"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/icer"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/incremental-cost"/>
        <skos:notation>HE-EE-CEA-006</skos:notation>
        <dcterms:identifier>HE-EE-CEA-006</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Comparator</rdfs:label>
        <owl:versionInfo>1.0.19</owl:versionInfo>
        <skos:definition xml:lang="en">A comparator is the alternative, such as current practice or another treatment, against which a new health intervention is compared in economic evaluation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Control Intervention</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Reference Arm</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Comparator</skos:prefLabel>
        <benchmarkFor rdf:resource="https://healtheconomics.wiki/concept/added-therapeutic-value"/>
        <benchmarkFor rdf:resource="https://healtheconomics.wiki/concept/asmr-rating"/>
        <benchmarkFor rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-3"/>
        <counterpartOf rdf:resource="https://healtheconomics.wiki/concept/control-arm"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/comparator"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/intervention"/>
        <dcterms:identifier>HEO-L-2573f904d856</dcterms:identifier>
        <linkRationale xml:lang="en">A comparator is current practice or another treatment, i.e. an intervention</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/comparator"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
