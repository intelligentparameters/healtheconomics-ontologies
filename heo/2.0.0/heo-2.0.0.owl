    <!-- https://healtheconomics.wiki/concept/outcomes-based-contract -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/outcomes-based-contract">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/performance-based-agreement"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/risk-sharing-scheme"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/performance-based-agreement"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/risk-sharing-scheme"/>
        <skos:notation>HS-DC-MA-017</skos:notation>
        <dcterms:identifier>HS-DC-MA-017</dcterms:identifier>
        <dcterms:source>Carlson JJ, Sullivan SD, Garrison LP, Neumann PJ, Veenstra DL. Linking payment to health outcomes: a taxonomy and examination of performance-based reimbursement schemes. Health Policy. 2010;96(3):179-190.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Outcomes-Based Contract</rdfs:label>
        <skos:altLabel xml:lang="en">Value-Based Contract</skos:altLabel>
        <skos:definition xml:lang="en">A formal agreement in which some or all of a treatment&apos;s payment is contingent on it achieving predefined clinical outcomes in practice.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Results-Based Agreement</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Outcomes-Based Contract</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/outcomes-based-contract"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/performance-based-agreement"/>
        <dcterms:identifier>HEO-L-6283fe8dda37</dcterms:identifier>
        <linkRationale xml:lang="en">An outcomes-based contract makes payment contingent on clinical outcomes, one kind of performance-based agreement</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/outcomes-based-contract"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/risk-sharing-scheme"/>
        <dcterms:identifier>HEO-L-18bf3a6fb2c3</dcterms:identifier>
        <linkRationale xml:lang="en">Outcomes-based contracts are performance-based risk-sharing arrangements</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/outcomes-based-payment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/outcomes-based-payment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcomes-based-contract"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/outcomes-based-contract"/>
        <skos:notation>HE-PE-AT-010</skos:notation>
        <dcterms:identifier>HE-PE-AT-010</dcterms:identifier>
        <dcterms:source>Carlson JJ, Sullivan SD, Garrison LP, Neumann PJ, Veenstra DL. Linking payment to health outcomes: a taxonomy and examination of performance-based reimbursement schemes. Health Policy. 2010;96(3):179-190.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Outcomes-Based Payment</rdfs:label>
        <skos:definition xml:lang="en">A reimbursement arrangement in which some or all of a manufacturer&apos;s payment depends on the treatment achieving a predefined clinical outcome in actual practice.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Pay-for-Outcomes</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Results-Based Payment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Outcomes-Based Payment</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/outcomes-based-payment"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/outcomes-based-contract"/>
        <dcterms:identifier>HEO-L-4088df732ee1</dcterms:identifier>
        <linkRationale xml:lang="en">An outcomes-based payment is the payment arrangement of an outcomes-based contract</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/outcomes-research -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/outcomes-research">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-services-research"/>
