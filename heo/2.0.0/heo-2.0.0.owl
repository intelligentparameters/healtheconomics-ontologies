    <!-- https://healtheconomics.wiki/concept/life-years-gained -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/life-years-gained">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/incremental-effectiveness"/>
