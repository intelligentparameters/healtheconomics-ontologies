        <dcterms:identifier>HE-EE-BE-028</dcterms:identifier>
        <dcterms:source>Oettingen 2000</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Mental Contrasting</rdfs:label>
        <skos:definition xml:lang="en">A self-regulation technique in which a person compares a desired future outcome against the present reality blocking it.</skos:definition>
