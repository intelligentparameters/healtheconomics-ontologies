        <skos:hiddenLabel xml:lang="en">Physician-Patient Agency Problem</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Principal-Agent Problem in Healthcare</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/supplier-induced-demand"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/principal-agent-problem-in-healthcare"/>
