    <!-- https://healtheconomics.wiki/concept/delayed-outcome -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/delayed-outcome">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/long-term-outcome"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/long-term-outcome"/>
        <skos:notation>HE-ES-CO-018</skos:notation>
        <dcterms:identifier>HE-ES-CO-018</dcterms:identifier>
        <dcterms:source>U.S. Food and Drug Administration. Guidance for Industry: Patient-Reported Outcome Measures-Use in Medical Product Development to Support Labeling Claims. FDA; 2009.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Delayed Outcome</rdfs:label>
        <skos:definition xml:lang="en">A clinical or economic outcome that manifests only after a substantial period following treatment, such as a late-occurring side effect.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Deferred Outcome</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Lagged Outcome</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Delayed Outcome</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/delayed-outcome"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/long-term-outcome"/>
        <dcterms:identifier>HEO-L-971567ca9598</dcterms:identifier>
        <linkRationale xml:lang="en">Subject covers clinical or economic outcomes, so not all are clinical; both are outcomes seen after a long period</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/deliberative-process -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/deliberative-process">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/decision-making"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/decision-making"/>
        <skos:notation>HS-HP-HTA-061</skos:notation>
        <dcterms:identifier>HS-HP-HTA-061</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</dcterms:modified>
        <dcterms:source>Oortwijn et al. 2022</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Deliberative Process</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:definition xml:lang="en">A deliberative process is structured group discussion where experts and stakeholders weigh evidence and values to guide HTA or priority-setting decisions.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Deliberation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Reasoned Deliberation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Deliberative Process</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/mcda-in-hta"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/coverage-decision"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/priority-setting"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/panel-decision"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/decision-criteria"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/deliberative-process"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/decision-making"/>
        <dcterms:identifier>HEO-L-f04a6aadb8c0</dcterms:identifier>
        <linkRationale xml:lang="en">A deliberative process is a structured way of reaching decisions, a kind of decision making rather than a part</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
