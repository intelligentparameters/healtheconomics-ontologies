    <!-- https://healtheconomics.wiki/concept/budget-approval -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/budget-approval">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/budget-impact-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/budget-impact-analysis"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/budget-cycle"/>
        <precedes rdf:resource="https://healtheconomics.wiki/concept/budget-execution"/>
        <skos:notation>HE-EE-BIA-004</skos:notation>
        <dcterms:identifier>HE-EE-BIA-004</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Musgrave &amp; Musgrave 1989</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Budget Approval</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">The authorised decision to allocate or permit specified spending for a defined health purpose, budget holder and period, often with explicit conditions.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Budget Authorisation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Budget Sign-Off</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Budget Approval</skos:prefLabel>
