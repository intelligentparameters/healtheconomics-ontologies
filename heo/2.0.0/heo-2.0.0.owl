    <!-- https://healtheconomics.wiki/concept/objective-response-rate -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/objective-response-rate">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/tumour-response"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/disease-control-rate"/>
        <skos:notation>HE-PE-OO-013</skos:notation>
        <dcterms:identifier>HE-PE-OO-013</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Eisenhauer et al. 2009</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Objective Response Rate</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">ORR</skos:altLabel>
        <skos:altLabel xml:lang="en">Overall Response Rate</skos:altLabel>
        <skos:definition xml:lang="en">Objective response rate is the proportion of participants in a prespecified analysis population who achieve a complete or partial tumor response according to defined response criteria during the assessment period, with any confirmation requirement stated.</skos:definition>
        <skos:prefLabel xml:lang="en">Objective Response Rate</skos:prefLabel>
        <abbreviation xml:lang="en">ORR</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/outcomes#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/objective-response-rate"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
