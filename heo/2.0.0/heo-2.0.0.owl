    <!-- https://healtheconomics.wiki/concept/access-negotiation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/access-negotiation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/market-access"/>
        <skos:notation>HS-DC-DP-002</skos:notation>
        <dcterms:identifier>HS-DC-DP-002</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
