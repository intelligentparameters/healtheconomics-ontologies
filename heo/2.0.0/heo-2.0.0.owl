    <!-- https://healtheconomics.wiki/concept/targeted-screening -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/targeted-screening">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/screening"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/screening"/>
        <skos:notation>HS-SS-GH-028</skos:notation>
        <dcterms:identifier>HS-SS-GH-028</dcterms:identifier>
        <dcterms:source>Wilson &amp; Jungner 1968</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Targeted Screening</rdfs:label>
        <skos:altLabel xml:lang="en">High-Risk Screening</skos:altLabel>
        <skos:altLabel xml:lang="en">Selective Screening</skos:altLabel>
        <skos:definition xml:lang="en">A screening approach offering testing specifically to individuals identified as higher risk for a condition, rather than an entire general population.</skos:definition>
        <skos:prefLabel xml:lang="en">Targeted Screening</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/risk-stratification"/>
    </owl:NamedIndividual>
    <owl:Axiom>
