        <skos:altLabel xml:lang="en">CMO</skos:altLabel>
        <skos:altLabel xml:lang="en">Comfort Measures Only</skos:altLabel>
        <skos:definition xml:lang="en">A treatment approach focused entirely on relieving symptoms and maximising quality of life, without pursuing curative or life-prolonging treatment.</skos:definition>
        <skos:hiddenLabel xml:lang="en">End-of-Life Symptom Relief</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Symptom-Focused Care</skos:hiddenLabel>
