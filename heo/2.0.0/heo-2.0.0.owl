    <!-- https://healtheconomics.wiki/concept/middle-income-country -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/middle-income-country">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
