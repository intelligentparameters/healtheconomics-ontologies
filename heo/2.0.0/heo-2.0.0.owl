    <!-- https://healtheconomics.wiki/concept/loss-aversion-concept -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/loss-aversion-concept">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/behavioural-economics"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/behavioural-economics"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/behavioural-theory"/>
        <skos:notation>HE-EE-BE-026</skos:notation>
        <dcterms:identifier>HE-EE-BE-026</dcterms:identifier>
        <dcterms:source>Kahneman &amp; Tversky 1979</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Loss Aversion Concept</rdfs:label>
        <skos:definition xml:lang="en">The principle that losses are weighted more heavily in decision-making than equivalent gains, a core part of prospect theory.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Asymmetric Value Perception</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Loss Aversion</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Loss Aversion Concept</skos:prefLabel>
        <explains rdf:resource="https://healtheconomics.wiki/concept/framing-concept"/>
        <explains rdf:resource="https://healtheconomics.wiki/concept/status-quo-bias-concept"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/endowment-effect-concept"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/loss-aversion-concept"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/behavioural-economics"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-e483d7261a79</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Behavioral Economics: behavioural economics enters health economics mainly through policy design (incentives, nudges); placed under Behavioural Economics, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/loss-aversion-concept"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/behavioural-theory"/>
        <dcterms:identifier>HEO-L-4ba20eb933d0</dcterms:identifier>
        <linkRationale xml:lang="en">Loss aversion is a principle within behavioural theory, not itself a theory</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/loss-aversion-concept"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#explains"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/framing-concept"/>
        <dcterms:identifier>HEO-L-639595f2fe54</dcterms:identifier>
        <linkRationale xml:lang="en">Loss aversion accounts for why gain versus loss framing changes choices; explains is more precise than a causal contribution</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/loss-aversion-concept"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#explains"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/status-quo-bias-concept"/>
        <dcterms:identifier>HEO-L-c50be660143e</dcterms:identifier>
        <linkRationale xml:lang="en">Loss aversion accounts for status quo bias, since leaving the status quo is coded as a loss (Kahneman et al. 1991)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/loss-aversion-concept"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isFoundationFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/endowment-effect-concept"/>
        <dcterms:identifier>HEO-L-b91cd604ed8c</dcterms:identifier>
        <linkRationale xml:lang="en">Loss aversion is the standard basis of the endowment effect (Kahneman et al. 1990)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/loss-of-response -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/loss-of-response">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome"/>
        <skos:notation>HE-ES-CO-039</skos:notation>
        <dcterms:identifier>HE-ES-CO-039</dcterms:identifier>
        <dcterms:source>Baccarani et al. 2013</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Loss of Response</rdfs:label>
        <skos:altLabel xml:lang="en">Secondary Failure</skos:altLabel>
        <skos:altLabel xml:lang="en">Secondary Non-Response</skos:altLabel>
        <skos:definition xml:lang="en">A clinical outcome indicating a patient who previously achieved a favourable response later experiences a return of disease activity or decline in response.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Acquired Failure</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Late Failure</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Treatment Escape</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Loss of Response</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/durable-response"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/loss-of-response"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome"/>
        <dcterms:identifier>HEO-L-364f99b918ab</dcterms:identifier>
        <linkRationale xml:lang="en">Loss of response is a clinical outcome, per the subject definition</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/loss-of-response"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/durable-response"/>
        <dcterms:identifier>HEO-L-04cf0dac96f7</dcterms:identifier>
        <linkRationale xml:lang="en">Losing a response versus sustaining it are opposing response courses</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
