        <skos:altLabel xml:lang="en">DUR</skos:altLabel>
        <skos:definition xml:lang="en">A structured process evaluating prescribing and medication use patterns to identify inappropriate prescribing, interactions, or non-adherence, prospectively or retrospectively.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Medication Use Review</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Drug Utilisation Review</skos:prefLabel>
        <abbreviation xml:lang="en">DUR</abbreviation>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/drug-interaction"/>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/medication-adherence"/>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/off-label-use"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
