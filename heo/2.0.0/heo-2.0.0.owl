        <skos:altLabel xml:lang="en">Agent-Based Simulation</skos:altLabel>
        <skos:definition xml:lang="en">An agent-based model (ABM) simulates individuals as agents that follow rules and interact, so outcomes such as infections, costs and QALYs emerge.</skos:definition>
        <skos:prefLabel xml:lang="en">Agent-Based Model</skos:prefLabel>
        <abbreviation xml:lang="en">ABM</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/aggregate-model"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/compartmental-model"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/microsimulation"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-7"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/calibration"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/monte-carlo-simulation"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/agent-based-model"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
