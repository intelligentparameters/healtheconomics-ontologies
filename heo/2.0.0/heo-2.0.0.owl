    <!-- https://healtheconomics.wiki/concept/leverage-point -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/leverage-point">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:notation>HE-ES-SA-102</skos:notation>
        <dcterms:identifier>HE-ES-SA-102</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Belsley, Kuh &amp; Welsch 1980</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Leverage Point</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">An observation with an unusual combination of predictor values, distinct from the bulk of the data, capable of disproportionately influencing a regression model.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Leverage Observation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Unusual Predictor Point</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Leverage Point</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/influential-observation"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/regression-analysis"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/leverage-point"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
