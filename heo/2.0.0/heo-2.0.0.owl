    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/external-validity-assessment"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#evaluates"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/external-validity"/>
        <dcterms:identifier>HEO-L-3877d51e1faf</dcterms:identifier>
        <linkRationale xml:lang="en">Assessment is a testing process that appraises external validity; evaluates fits a process better than measures</linkRationale>
