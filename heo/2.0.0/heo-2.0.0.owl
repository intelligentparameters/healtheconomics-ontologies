    <!-- https://healtheconomics.wiki/concept/break-even-point -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/break-even-point">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-benefit-analysis"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q626990"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/cost-benefit-analysis"/>
        <skos:notation>HE-EE-CBA-006</skos:notation>
        <dcterms:identifier>HE-EE-CBA-006</dcterms:identifier>
        <dcterms:source>Horngren, Datar &amp; Rajan 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Break-Even Point</rdfs:label>
        <skos:altLabel xml:lang="en">Breakeven Point</skos:altLabel>
        <skos:definition xml:lang="en">The level of output or activity at which total revenue equals total cost, so an organisation neither gains nor loses money.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Zero-Profit Point</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Break-Even Point</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/budget-planning"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-5"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/break-even-point"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-benefit-analysis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-673a486e5a80</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Cost benefit analysis and investment appraisal in subdomain Economic Evaluation; placed under Cost-Benefit Analysis, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/break-even-point"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/budget-planning"/>
        <dcterms:identifier>HEO-L-7737c72d6f94</dcterms:identifier>
        <linkRationale xml:lang="en">The break-even point gives the activity level at which income covers cost; budget planning forecasts activity costs and income</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


