    <!-- https://healtheconomics.wiki/concept/processing-error -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/processing-error">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/non-sampling-error"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/non-sampling-error"/>
        <skos:notation>HE-DS-BV-024</skos:notation>
        <dcterms:identifier>HE-DS-BV-024</dcterms:identifier>
        <dcterms:source>Groves et al. 2009</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Processing Error</rdfs:label>
        <skos:definition xml:lang="en">A mistake introduced while handling, cleaning, or transforming data after collection but before analysis, such as an incorrect data merge.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Coding-and-Entry Error</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Data-Handling Error</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Processing Error</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/data-quality"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/processing-error"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/non-sampling-error"/>
        <dcterms:identifier>HEO-L-71eb2fc518e1</dcterms:identifier>
        <linkRationale xml:lang="en">Processing error arises after collection, outside measurement; it is a non-sampling error (total survey error framework).</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/processing-error"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/data-quality"/>
        <dcterms:identifier>HEO-L-31359d3c413d</dcterms:identifier>
