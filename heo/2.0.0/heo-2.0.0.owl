    <!-- https://healtheconomics.wiki/concept/public-provision -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/public-provision">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:notation>HE-EE-EP-028</skos:notation>
        <dcterms:identifier>HE-EE-EP-028</dcterms:identifier>
        <dcterms:source>Musgrave &amp; Musgrave 1989</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Public Provision</rdfs:label>
        <skos:altLabel xml:lang="en">State Provision</skos:altLabel>
        <skos:definition xml:lang="en">The direct delivery of a good or service by government entities rather than by private organisations.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Government Delivery</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Public Provision</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/private-system"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/public-provision"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-68c0442dc31a</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Economic Policy: taxes, subsidies and other economic policy instruments are policy choices</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/public-provision"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/private-system"/>
        <dcterms:identifier>HEO-L-c8e119ccce72</dcterms:identifier>
        <linkRationale xml:lang="en">Direct government delivery is the alternative to predominantly private delivery.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
