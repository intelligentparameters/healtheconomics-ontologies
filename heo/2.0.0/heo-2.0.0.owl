    <!-- https://healtheconomics.wiki/concept/acceptability -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/acceptability">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/access-to-care"/>
        <skos:notation>HS-HP-HE-001</skos:notation>
        <dcterms:identifier>HS-HP-HE-001</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Penchansky R, Thomas JW. The concept of access: definition and relationship to consumer satisfaction. Medical Care. 1981;19(2):127?140. doi:10.1097/00005650-198102000-00001.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Acceptability of Healthcare</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Acceptability is the dimension of access concerned with whether people find health services culturally, socially and personally appropriate enough to use.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cultural Fit</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Patient-Provider Fit</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Acceptability of Healthcare</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/service-utilisation"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-policy#step-4"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/acceptability"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-d8141f53a477</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Equity and inequality in subdomain Health Policy</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/acceptability"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/access-to-care"/>
        <dcterms:identifier>HEO-L-35babeb4a5d0</dcterms:identifier>
        <linkRationale xml:lang="en">Acceptability is one of the dimensions of access (Penchansky and Thomas 1981); object definition lists it</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
