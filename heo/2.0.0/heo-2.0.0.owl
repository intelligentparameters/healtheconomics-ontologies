    <!-- https://healtheconomics.wiki/concept/efficiency -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/efficiency">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q615445"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HE-EE_EA-016</skos:notation>
        <dcterms:identifier>HE-EE_EA-016</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Farrell MJ. The measurement of productive efficiency. Journal of the Royal Statistical Society: Series A. 1957;120(3):253?290. doi:10.2307/2343100.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Efficiency</rdfs:label>
        <owl:versionInfo>1.0.18</owl:versionInfo>
        <skos:definition xml:lang="en">Efficiency is getting the most health or other valued outcomes from scarce healthcare resources, avoiding waste and allocating them to their best uses.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Productive Resource Use</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Value from Resources</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Efficiency</skos:prefLabel>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/equity-efficiency-trade-off"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/efficiency"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-31bd4bc61fc6</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Efficiency Analysis: every concept with this Level 3 that the wiki places in a topic sits in Health Systems (Performance, productivity and quality)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/efficiency"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isFoundationFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/equity-efficiency-trade-off"/>
        <dcterms:identifier>HEO-L-d8c321934944</dcterms:identifier>
        <linkRationale xml:lang="en">Efficiency is the basic idea the trade-off is built on; health given up for fairness is lost efficiency</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/efficiency-evaluation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/efficiency-evaluation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
