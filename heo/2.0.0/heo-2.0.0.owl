        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Safety Profile</rdfs:label>
        <skos:definition xml:lang="en">The overall characterisation of a drug&apos;s potential adverse effects, type, frequency, and severity, established through trial data and post-market surveillance.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Adverse Effect Profile</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Tolerability Profile</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Safety Profile</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/benefit-risk-assessment"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/medicinal-product"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
