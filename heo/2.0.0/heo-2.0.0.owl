        <skos:notation>HS-HP-SS-016</skos:notation>
        <dcterms:identifier>HS-HP-SS-016</dcterms:identifier>
        <dcterms:source>Lewin 1951</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Force Field Analysis</rdfs:label>
        <skos:definition xml:lang="en">A structured technique analysing a proposed change by identifying forces supporting it and forces resisting it, guiding change strategy.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Driving-Restraining Analysis</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Force Field Diagram</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Force Field Analysis</skos:prefLabel>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/barrier-to-implementation"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/implementation-strategy"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/force-field-analysis"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
