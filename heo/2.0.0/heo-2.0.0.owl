        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Biosimilar pricing is how a biosimilar&apos;s price to health systems is set against its reference biologic, through discounts, tenders and funding rules.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Biosimilar Discounting</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Biosimilar Price Strategy</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Biosimilar Pricing</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/biosimilar-uptake"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/price-erosion"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/biosimilar-pricing"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <dcterms:identifier>HEO-L-cb8fb3e923a2</dcterms:identifier>
        <linkRationale xml:lang="en">Biosimilar pricing is drug pricing for a product class</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
