    <!-- https://healtheconomics.wiki/concept/regression-discontinuity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/regression-discontinuity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
