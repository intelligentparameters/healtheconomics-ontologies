        <dcterms:identifier>HEO-L-1dc85519e7ea</dcterms:identifier>
        <linkRationale xml:lang="en">Replacement by newer technology is the decline stage of the technology lifecycle (object definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
