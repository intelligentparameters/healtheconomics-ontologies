    <!-- https://healtheconomics.wiki/concept/rate-difference -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/rate-difference">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/absolute-measure"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/absolute-measure"/>
        <skos:notation>HE-ES-RM-031</skos:notation>
        <dcterms:identifier>HE-ES-RM-031</dcterms:identifier>
        <dcterms:source>Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams &amp; Wilkins; 2008.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Rate Difference</rdfs:label>
        <skos:altLabel xml:lang="en">Excess Rate</skos:altLabel>
        <skos:definition xml:lang="en">The absolute difference between the incidence rates in two groups, giving a direct measure of the excess rate of disease from an exposure.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Additive Rate Contrast</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Rate Difference</skos:prefLabel>
        <counterpartOf rdf:resource="https://healtheconomics.wiki/concept/risk-difference"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-2"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/rate-difference"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/absolute-measure"/>
        <dcterms:identifier>HEO-L-b97d326d4599</dcterms:identifier>
        <linkRationale xml:lang="en">A rate difference is an absolute effect measure.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/rate-difference"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#counterpartOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/risk-difference"/>
        <dcterms:identifier>HEO-L-fa31650d665b</dcterms:identifier>
