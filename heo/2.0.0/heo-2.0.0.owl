    <!-- https://healtheconomics.wiki/concept/scoping-review-hta -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/scoping-review-hta">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/evidence-gap"/>
        <skos:notation>HE-ES-ESM-052</skos:notation>
        <dcterms:identifier>HE-ES-ESM-052</dcterms:identifier>
        <dcterms:source>Arksey &amp; O&apos;Malley 2005</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Scoping Review HTA</rdfs:label>
        <skos:definition xml:lang="en">A review mapping the extent and nature of research in a given area, often to identify gaps or judge whether a full review is warranted.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Evidence Mapping</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Scoping Review</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Scoping Review HTA</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/systematic-review"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/scoping-review-hta"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:identifier>HEO-L-22d6668e09eb</dcterms:identifier>
        <linkRationale xml:lang="en">A scoping review is one form of evidence synthesis that maps and integrates findings across studies.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/scoping-review-hta"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-gap"/>
        <dcterms:identifier>HEO-L-1121e94ad4db</dcterms:identifier>
        <linkRationale xml:lang="en">A scoping review maps research to identify gaps, per its definition</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/scoping-review-hta"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/systematic-review"/>
        <dcterms:identifier>HEO-L-e0a75bb565f2</dcterms:identifier>
        <linkRationale xml:lang="en">A scoping review maps the evidence broadly, while a systematic review answers a defined question comprehensively.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
