    <!-- https://healtheconomics.wiki/concept/outcome-quality -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/outcome-quality">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <skos:notation>HS-HP-HQ-028</skos:notation>
        <dcterms:identifier>HS-HP-HQ-028</dcterms:identifier>
        <dcterms:source>Donabedian A. Evaluating the quality of medical care. Milbank Memorial Fund Quarterly. 1966;44(3):166-206. doi:10.2307/3348969.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Outcome Quality</rdfs:label>
        <skos:definition xml:lang="en">A healthcare quality dimension focused on actual care results, such as survival or functional status, unlike structural or process quality.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Outcome Dimension of Quality</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Results Quality</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Outcome Quality</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/process-quality"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/structural-quality"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/outcome-quality"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <dcterms:identifier>HEO-L-46cd91adc87a</dcterms:identifier>
        <linkRationale xml:lang="en">Outcome quality is quality of care judged by results</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
