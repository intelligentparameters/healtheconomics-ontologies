    <!-- https://healtheconomics.wiki/concept/broad-network -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/broad-network">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/provider-network"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/provider-network"/>
        <skos:notation>HS-HP-HI-026</skos:notation>
        <dcterms:identifier>HS-HP-HI-026</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Broad Network</rdfs:label>
        <skos:altLabel xml:lang="en">Broad Provider Network</skos:altLabel>
        <skos:definition xml:lang="en">An insurance plan design including a large number of contracted providers, offering enrollees greater choice than a narrower network plan.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Wide Network</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Broad Network</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/closed-panel"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/narrow-network"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/private-insurance-premium"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
