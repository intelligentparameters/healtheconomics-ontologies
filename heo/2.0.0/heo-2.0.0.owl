        <rdfs:label xml:lang="en">Curve Fitting</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:definition xml:lang="en">Curve fitting is estimating a mathematical function&apos;s parameters to match observed data, as when survival curves are fitted to trial data and extrapolated.</skos:definition>
