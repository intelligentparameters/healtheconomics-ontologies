        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/local-sensitivity-analysis"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/deterministic-sensitivity-analysis"/>
        <dcterms:identifier>HEO-L-d2e6dabc9ae9</dcterms:identifier>
        <linkRationale xml:lang="en">Varying parameters around a fixed base case is deterministic</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
