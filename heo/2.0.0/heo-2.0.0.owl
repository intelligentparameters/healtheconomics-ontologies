        <dcterms:identifier>HS-SS_DH-061</dcterms:identifier>
        <dcterms:source>Ellis 2008</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Risk Analytics</rdfs:label>
        <skos:definition xml:lang="en">The application of data analysis to identify and quantify an individual&apos;s or population&apos;s risk of a specific future health outcome.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Predictive Risk Analysis</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Risk Data Analytics</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Risk Analytics</skos:prefLabel>
