        <skos:hiddenLabel xml:lang="en">Node-Split Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Node-Splitting</skos:prefLabel>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/inconsistency"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-4"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/indirect-comparison"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
