        <dcterms:source>CDC, National Healthcare Safety Network</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">CLABSI Rate</rdfs:label>
