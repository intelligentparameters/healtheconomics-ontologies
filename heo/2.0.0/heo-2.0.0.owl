        <skos:notation>HE-EE-CA-079</skos:notation>
        <dcterms:identifier>HE-EE-CA-079</dcterms:identifier>
        <dcterms:source>Varian 2014</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Sunk Cost</rdfs:label>
        <skos:altLabel xml:lang="en">Retrospective Cost</skos:altLabel>
        <skos:definition xml:lang="en">A cost that has already been incurred and cannot be recovered regardless of future decisions.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Unrecoverable Cost</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Sunk Cost</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
