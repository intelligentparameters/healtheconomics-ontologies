    <!-- https://healtheconomics.wiki/concept/evergreening -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/evergreening">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q5417260"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:notation>HS-DC-IP-002</skos:notation>
        <dcterms:identifier>HS-DC-IP-002</dcterms:identifier>
        <dcterms:source>Feldman 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Evergreening</rdfs:label>
        <skos:definition xml:lang="en">A strategy extending a product&apos;s effective market exclusivity beyond its original patent term, often through patents on minor formulation or indication changes.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Exclusivity Extension</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Lifecycle Patent Extension</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Evergreening</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/market-exclusivity"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/patent"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/evergreening"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-a02a530d3ec2</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Drug Costs &gt; Intellectual Property: wiki topic Pricing and market access sits in Health Policy</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/evergreening"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/market-exclusivity"/>
        <dcterms:identifier>HEO-L-6af5935c5d19</dcterms:identifier>
        <linkRationale xml:lang="en">Evergreening extends effective exclusivity (subject definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/evergreening"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
