    <!-- https://healtheconomics.wiki/concept/subscription-pricing -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/subscription-pricing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/managed-entry-agreement"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/managed-entry-agreement"/>
        <skos:notation>HS-DC-DP-094</skos:notation>
        <dcterms:identifier>HS-DC-DP-094</dcterms:identifier>
        <dcterms:source>Trusheim et al. 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Subscription Pricing</rdfs:label>
        <skos:altLabel xml:lang="en">Subscription Model</skos:altLabel>
        <skos:definition xml:lang="en">A payment model in which a payer pays a fixed periodic fee for essentially unlimited treatment access, rather than paying per unit or patient.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Netflix Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Subscription Pricing</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/volume-based-pricing"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/subscription-pricing"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <dcterms:identifier>HEO-L-af667aef5d9d</dcterms:identifier>
        <linkRationale xml:lang="en">Subscription pricing is one way of setting medicine payments.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/subscription-pricing"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/managed-entry-agreement"/>
        <dcterms:identifier>HEO-L-024ef07a44f6</dcterms:identifier>
        <linkRationale xml:lang="en">Payer subscription deals, such as the NHS antimicrobial subscription, are agreements setting market entry terms.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/subscription-pricing"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/volume-based-pricing"/>
        <dcterms:identifier>HEO-L-085c7516e499</dcterms:identifier>
        <linkRationale xml:lang="en">Subscription pricing delinks payment from units used, the opposite of volume-based pricing; it is not defined against cost-based pricing.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/subsequent-generic-entry -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/subsequent-generic-entry">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:notation>HS-DC-DP-095</skos:notation>
        <dcterms:identifier>HS-DC-DP-095</dcterms:identifier>
        <dcterms:source>FDA, Hatch-Waxman Act</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Subsequent Generic Entry</rdfs:label>
        <skos:definition xml:lang="en">The entry of additional generic competitors following the first, typically bringing further price declines as competition among manufacturers intensifies.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Later Generic Entry</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Multiple Generic Entry</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Subsequent Generic Entry</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/first-generic-entry"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/price-erosion"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/subsequent-generic-entry"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-a4db1cae037b</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Drug Costs &gt; Drug Pricing: wiki topic Pricing and market access sits in Health Policy; placed under Drug Pricing, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/subsequent-generic-entry"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/first-generic-entry"/>
        <dcterms:identifier>HEO-L-9ed542fa80a4</dcterms:identifier>
        <linkRationale xml:lang="en">First and subsequent generic entry are contrasting stages of generic competition.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/subsequent-generic-entry"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/price-erosion"/>
        <dcterms:identifier>HEO-L-5f3d4081fcdb</dcterms:identifier>
        <linkRationale xml:lang="en">Additional generic competitors drive further price declines, per the definition.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/subsidy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/subsidy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/government-intervention"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q193219"/>
