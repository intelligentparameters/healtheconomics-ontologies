        <dcterms:identifier>HEO-L-b3ab1f26eceb</dcterms:identifier>
        <linkRationale xml:lang="en">Progressive taxation is one progressive financing arrangement.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
