        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/incidence-rate"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/incidence"/>
        <dcterms:identifier>HEO-L-8007c6e8356e</dcterms:identifier>
        <linkRationale xml:lang="en">A rate measure of incidence.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/incidence-rate"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/incidence-rate-ratio"/>
        <dcterms:identifier>HEO-L-ad4326168b1d</dcterms:identifier>
