        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Impoverishing Expenditure Measure</rdfs:label>
        <skos:definition xml:lang="en">A quantitative indicator assessing the extent to which out-of-pocket healthcare spending pushes households below, or further below, a poverty line.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Impoverishment Indicator</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Poverty Impact Measure</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Impoverishing Expenditure Measure</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
