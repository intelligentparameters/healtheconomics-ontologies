    <!-- https://healtheconomics.wiki/concept/proportion-of-days-covered -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/proportion-of-days-covered">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/adherence-outcome"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/adherence-outcome"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/medication-adherence"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/star-rating"/>
        <skos:notation>PP-PC-MA-005</skos:notation>
        <dcterms:identifier>PP-PC-MA-005</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Raebel et al. 2013</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Proportion of Days Covered</rdfs:label>
        <owl:versionInfo>1.0.4</owl:versionInfo>
        <skos:altLabel xml:lang="en">PDC</skos:altLabel>
        <skos:definition xml:lang="en">The proportion of days covered (PDC) is the share of days in a period on which pharmacy refill records show a patient had medicine, each day counted once.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Days-Covered Ratio</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Proportion of Days Covered</skos:prefLabel>
        <abbreviation xml:lang="en">PDC</abbreviation>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/pharmacy-data"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/proportion-of-days-covered"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/adherence-outcome"/>
        <dcterms:identifier>HEO-L-eab5eb4e8728</dcterms:identifier>
        <linkRationale xml:lang="en">PDC is an adherence outcome measure.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
