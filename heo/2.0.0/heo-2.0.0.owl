    <!-- https://healtheconomics.wiki/concept/pragmatic-trial-design -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/pragmatic-trial-design">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-trial-design"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/clinical-trial-design"/>
        <skos:notation>HE-ES-CTM-069</skos:notation>
        <dcterms:identifier>HE-ES-CTM-069</dcterms:identifier>
        <dcterms:source>Schwartz &amp; Lellouch 1967</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Pragmatic Trial Design</rdfs:label>
        <skos:definition xml:lang="en">A trial design evaluating a treatment under conditions resembling routine practice, using broad eligibility and standard care settings, unlike an explanatory design.</skos:definition>
        <skos:hiddenLabel xml:lang="en">PRECIS-Guided Design</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Pragmatic Study Protocol</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Pragmatic Trial Design</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/explanatory-trial"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
