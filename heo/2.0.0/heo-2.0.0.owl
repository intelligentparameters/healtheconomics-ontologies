    <!-- https://healtheconomics.wiki/concept/platform-trial -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/platform-trial">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/adaptive-trial-design"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/master-protocol"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q111181669"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/adaptive-trial-design"/>
