    <!-- https://healtheconomics.wiki/concept/random-effects-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/random-effects-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/mixed-effects-model"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1826427"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/mixed-effects-model"/>
        <skos:notation>HE-ES-ESM-049</skos:notation>
        <dcterms:identifier>HE-ES-ESM-049</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>DerSimonian R, Laird N. Meta-analysis in clinical trials. Controlled Clinical Trials. 1986;7(3):177?188. doi:10.1016/0197-2456(86)90046-2.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Random Effects Model</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A random effects model represents variation in a parameter across defined units or settings by treating their unit-specific effects as draws from a shared distribution.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Exchangeable-Effects Model</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">REM</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Random Effects</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Random Effects Synthesis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Random Effects Model</skos:prefLabel>
        <assumes rdf:resource="https://healtheconomics.wiki/concept/between-study-heterogeneity"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-4"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/prediction-interval"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/tau-squared"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/random-effects-model"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/mixed-effects-model"/>
        <dcterms:identifier>HEO-L-d2298dc735d9</dcterms:identifier>
        <linkRationale xml:lang="en">A random effects model combines a fixed mean with probability-modelled unit effects, so it is a kind of mixed effects model</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/random-effects-model"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#assumes"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/between-study-heterogeneity"/>
        <dcterms:identifier>HEO-L-33fdf700e4e7</dcterms:identifier>
        <linkRationale xml:lang="en">Random effects models allow true effects to vary between studies.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
