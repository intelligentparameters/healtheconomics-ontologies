    <!-- https://healtheconomics.wiki/concept/adverse-selection -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/adverse-selection">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/market-failure"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q380037"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/market-failure"/>
        <skos:notation>HE-EE-ME-001</skos:notation>
        <dcterms:identifier>HE-EE-ME-001</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Akerlof 1970</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Adverse Selection</rdfs:label>
        <owl:versionInfo>1.0.13</owl:versionInfo>
        <skos:altLabel xml:lang="en">Anti-Selection</skos:altLabel>
        <skos:altLabel xml:lang="en">Negative Selection</skos:altLabel>
        <skos:definition xml:lang="en">Adverse selection occurs when people who know they are higher risk buy more health or life insurance, which can raise premiums and drive out lower risks.</skos:definition>
        <skos:prefLabel xml:lang="en">Adverse Selection</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/cream-skimming"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/moral-hazard"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/death-spiral"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/risk-selection"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/adverse-selection"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
