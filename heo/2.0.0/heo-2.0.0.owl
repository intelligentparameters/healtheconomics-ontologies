    <!-- https://healtheconomics.wiki/concept/patient-centred-care -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/patient-centred-care">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-HP-HD-081</skos:notation>
        <dcterms:identifier>HS-HP-HD-081</dcterms:identifier>
        <dcterms:source>Institute of Medicine, Crossing the Quality Chasm</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Patient-Centred Care</rdfs:label>
        <skos:altLabel xml:lang="en">Patient-Centred Model</skos:altLabel>
        <skos:definition xml:lang="en">A care model respectful of and responsive to individual patient preferences, needs, and values, guiding all clinical decisions accordingly.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Patient-Focused Care</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Patient-Focused Model</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Person-Centred Care</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Person-Centred Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Patient-Centred Care</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/shared-decision-making"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/patient-centred-care"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-3215059c7684</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Healthcare Delivery: organisation and delivery of care is the Health Systems subdomain (Organisation and governance)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/patient-centred-care"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/shared-decision-making"/>
        <dcterms:identifier>HEO-L-cea9d71baba8</dcterms:identifier>
        <linkRationale xml:lang="en">Patient-centred care relies on shared decision making</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
