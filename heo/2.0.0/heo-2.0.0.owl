    <!-- https://healtheconomics.wiki/concept/common-random-numbers -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/common-random-numbers">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/variance-reduction"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/variance-reduction"/>
        <skos:notation>HE-EM-UA-011</skos:notation>
        <dcterms:identifier>HE-EM-UA-011</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-09</dcterms:modified>
        <dcterms:source>Stout &amp; Goldie 2008</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Common Random Numbers</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">CRN</skos:altLabel>
        <skos:altLabel xml:lang="en">Correlated Sampling</skos:altLabel>
        <skos:definition xml:lang="en">Common random numbers (CRN) is a simulation method that runs competing strategies on the same random draws, so their estimated difference is less noisy.</skos:definition>
        <skos:prefLabel xml:lang="en">Common Random Numbers</skos:prefLabel>
        <abbreviation xml:lang="en">CRN</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-10"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/random-number-generation"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/seed-value"/>
