    <!-- https://healtheconomics.wiki/concept/digital-adherence -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/digital-adherence">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/adherence"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/adherence"/>
        <skos:notation>HS-SS_DH-013</skos:notation>
        <dcterms:identifier>HS-SS_DH-013</dcterms:identifier>
        <dcterms:source>NICE, Evidence Standards Framework for Digital Health Technologies</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Digital Adherence</rdfs:label>
        <skos:definition xml:lang="en">The degree to which patients engage with and consistently use a digital health technology, such as an app or monitoring device, as intended.</skos:definition>
        <skos:hiddenLabel xml:lang="en">App Engagement Adherence</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Digital Health Adherence</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Digital Adherence</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/digital-value-assessment"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/digital-adherence"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/adherence"/>
        <dcterms:identifier>HEO-L-3381273ed100</dcterms:identifier>
        <linkRationale xml:lang="en">digital adherence is adherence to use of a digital technology as intended</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/digital-adherence"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/digital-value-assessment"/>
        <dcterms:identifier>HEO-L-92cb5a124bd1</dcterms:identifier>
