        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/mean-absolute-error"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/mean-squared-error"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/root-mean-square-error"/>
        <skos:notation>HE-ES-SA-162</skos:notation>
        <dcterms:identifier>HE-ES-SA-162</dcterms:identifier>
        <dcterms:source>Hastie, Tibshirani &amp; Friedman 2009</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Prediction Error</rdfs:label>
        <skos:definition xml:lang="en">The difference between a value predicted by a statistical model and the value that is actually observed.</skos:definition>
