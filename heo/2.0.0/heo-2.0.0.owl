    <!-- https://healtheconomics.wiki/concept/therapeutic-class -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/therapeutic-class">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-classification"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/drug-classification"/>
        <skos:notation>HE-PE-DC-006</skos:notation>
        <dcterms:identifier>HE-PE-DC-006</dcterms:identifier>
        <dcterms:source>WHO ATC/DDD Index</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Therapeutic Class</rdfs:label>
        <skos:definition xml:lang="en">A grouping of medications sharing a similar mechanism of action or used to treat the same condition, such as statins or beta-blockers.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Drug Class</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Medication Class</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Therapeutic Class</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/therapeutic-class"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-classification"/>
        <dcterms:identifier>HEO-L-cd467af92a67</dcterms:identifier>
        <linkRationale xml:lang="en">A therapeutic class is a drug classification.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/therapeutic-competition -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/therapeutic-competition">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:notation>HS-DC-DP-098</skos:notation>
        <dcterms:identifier>HS-DC-DP-098</dcterms:identifier>
        <dcterms:source>Danzon 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Therapeutic Competition</rdfs:label>
        <skos:definition xml:lang="en">The competitive pressure exerted on a drug&apos;s pricing and market position by other treatments available for the same condition.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Treatment Competition</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Within-Class Competition</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Therapeutic Competition</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/price-erosion"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/competition-based-pricing"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/therapeutic-competition"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-39f7d5b92c4f</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Drug Costs &gt; Drug Pricing: wiki topic Pricing and market access sits in Health Policy; placed under Drug Pricing, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/therapeutic-competition"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/price-erosion"/>
        <dcterms:identifier>HEO-L-65d4c03cc91b</dcterms:identifier>
        <linkRationale xml:lang="en">Competition from rival treatments for the same condition drives a drug price down over time, the mechanism behind price erosion</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/therapeutic-competition"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isFoundationFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/competition-based-pricing"/>
        <dcterms:identifier>HEO-L-55132f8141fb</dcterms:identifier>
        <linkRationale xml:lang="en">Competitive pressure is not a theory; pricing from rival treatments for the same condition is built on it.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/therapeutic-goal -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/therapeutic-goal">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-PE-DT-046</skos:notation>
        <dcterms:identifier>HE-PE-DT-046</dcterms:identifier>
        <dcterms:source>Katzung 2017</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Therapeutic Goal</rdfs:label>
        <skos:altLabel xml:lang="en">Treatment Goal</skos:altLabel>
        <skos:definition xml:lang="en">The specific clinical outcome a treatment strategy is intended to achieve, such as cure, symptom control, stabilisation, or preventing complications.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Therapy Target</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Treatment Objective</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Therapeutic Goal</skos:prefLabel>
        <benchmarkFor rdf:resource="https://healtheconomics.wiki/concept/treatment-success"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/treatment-pathway"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/treatment-selection"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/therapeutic-goal"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-d540742120fe</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Pharmacoeconomics &gt; Drug Therapy: dosing and treatment-line terms describe the clinical evidence and treatment pathways that models use</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/therapeutic-goal"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#benchmarkFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/treatment-success"/>
        <dcterms:identifier>HEO-L-f6cdf520cbac</dcterms:identifier>
        <linkRationale xml:lang="en">The intended outcome guides the choice of treatment and is the standard success is judged against.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/therapeutic-goal"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
