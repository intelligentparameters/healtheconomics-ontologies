        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/quarantine"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/healthcare-associated-infection"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
