        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Unrestricted Listing</rdfs:label>
        <skos:altLabel xml:lang="en">General Listing</skos:altLabel>
        <skos:definition xml:lang="en">The inclusion of a treatment on a formulary without limitations on patient eligibility or prior authorisation, following a positive value finding.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Open Formulary Listing</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Open Listing</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Standard Listing</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Unrestricted Reimbursement</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Unrestricted Listing</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/unrestricted-listing"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/reimbursement-decision"/>
        <dcterms:identifier>HEO-L-50de5883c878</dcterms:identifier>
        <linkRationale xml:lang="en">A listing is a reimbursement decision.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/unstructured-correlation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/unstructured-correlation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/working-correlation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/working-correlation"/>
        <skos:notation>HE-ES-SA-230</skos:notation>
        <dcterms:identifier>HE-ES-SA-230</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Liang &amp; Zeger 1986</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Unstructured Correlation</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Unstructured Working Correlation</skos:altLabel>
        <skos:definition xml:lang="en">A correlation structure for repeated measures allowing the correlation between every pair of time points to be estimated freely and independently.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Unstructured Covariance</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Unstructured Correlation</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/exchangeable-correlation"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/unstructured-correlation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/working-correlation"/>
        <dcterms:identifier>HEO-L-b84864b05f3b</dcterms:identifier>
        <linkRationale xml:lang="en">Unstructured is one working correlation structure for repeated measures, not part of the data</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/unstructured-correlation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/exchangeable-correlation"/>
        <dcterms:identifier>HEO-L-be85580389e0</dcterms:identifier>
        <linkRationale xml:lang="en">Unstructured and exchangeable are alternative correlation structures.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/unwarranted-variation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/unwarranted-variation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-practice-variation"/>
