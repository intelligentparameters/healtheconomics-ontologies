    <!-- https://healtheconomics.wiki/concept/multinomial-logit-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/multinomial-logit-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
