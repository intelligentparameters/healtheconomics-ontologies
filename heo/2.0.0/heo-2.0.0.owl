    <!-- https://healtheconomics.wiki/concept/expanded-access -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/expanded-access">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/early-access-scheme"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q407954"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/early-access-scheme"/>
        <skos:notation>HS-DC-MA-007</skos:notation>
        <dcterms:identifier>HS-DC-MA-007</dcterms:identifier>
        <dcterms:source>FDA, Expanded Access Program</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Expanded Access</rdfs:label>
        <skos:altLabel xml:lang="en">Pre-Approval Access</skos:altLabel>
        <skos:definition xml:lang="en">A regulatory pathway, sometimes called compassionate use, letting patients with a serious condition receive an investigational treatment outside a trial.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Investigational Access Pathway</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Expanded Access</skos:prefLabel>
        <counterpartOf rdf:resource="https://healtheconomics.wiki/concept/named-patient-programme"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/expanded-access"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/early-access-scheme"/>
        <dcterms:identifier>HEO-L-fec7560e9e10</dcterms:identifier>
        <linkRationale xml:lang="en">Expanded access is a scheme for pre-authorisation access</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
