    <!-- https://healtheconomics.wiki/concept/inflation-adjustment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/inflation-adjustment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
