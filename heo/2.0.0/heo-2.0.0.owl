        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Intervention Perspective</rdfs:label>
        <skos:definition xml:lang="en">An analytic viewpoint defined by the specific intervention being studied, including all costs and outcomes directly attributable to it regardless of who bears them.</skos:definition>
