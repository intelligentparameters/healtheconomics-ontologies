    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/treatment-selection -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/treatment-selection">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/decision-making"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/decision-making"/>
        <skos:notation>HE-PE-DT-059</skos:notation>
        <dcterms:identifier>HE-PE-DT-059</dcterms:identifier>
        <dcterms:source>Katzung 2017</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Treatment Selection</rdfs:label>
        <skos:definition xml:lang="en">The clinical decision-making process of choosing among available treatment options, informed by disease characteristics, patient preferences, and comparative evidence.</skos:definition>
        <skos:prefLabel xml:lang="en">Treatment Selection</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/treatment-algorithm"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-selection"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/decision-making"/>
        <dcterms:identifier>HEO-L-f0b2e15e5cf8</dcterms:identifier>
        <linkRationale xml:lang="en">Choosing a treatment is the clinical kind of health care decision making</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-selection"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/treatment-algorithm"/>
        <dcterms:identifier>HEO-L-7b516cd7c77f</dcterms:identifier>
        <linkRationale xml:lang="en">Treatment selection follows a treatment algorithm.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/treatment-sequence -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/treatment-sequence">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/treatment-pathway"/>
        <skos:notation>HE-PE-DT-060</skos:notation>
        <dcterms:identifier>HE-PE-DT-060</dcterms:identifier>
        <dcterms:source>DeVita, Lawrence &amp; Rosenberg 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Treatment Sequence</rdfs:label>
        <skos:altLabel xml:lang="en">Treatment Sequencing</skos:altLabel>
        <skos:definition xml:lang="en">The specific ordered series of treatments a patient receives over time as they progress through different lines of therapy.</skos:definition>
        <skos:prefLabel xml:lang="en">Treatment Sequence</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
