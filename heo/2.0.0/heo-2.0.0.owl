    <!-- https://healtheconomics.wiki/concept/secondary-prevention -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/secondary-prevention">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/disease-prevention"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/disease-prevention"/>
        <skos:notation>HE-PE-CVP-003</skos:notation>
        <dcterms:identifier>HE-PE-CVP-003</dcterms:identifier>
        <dcterms:source>Last 2001</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Secondary Prevention</rdfs:label>
        <skos:definition xml:lang="en">Preventive intervention aimed at detecting and treating disease early, before significant harm, unlike primary prevention&apos;s aim of stopping onset entirely.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Early Detection Prevention</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Secondary Prophylaxis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Secondary Prevention</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/tertiary-prevention"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/secondary-prevention"/>
