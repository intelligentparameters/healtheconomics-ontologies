    <!-- https://healtheconomics.wiki/concept/study-level-covariate -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/study-level-covariate">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-ES-ESM-056</skos:notation>
        <dcterms:identifier>HE-ES-ESM-056</dcterms:identifier>
        <dcterms:source>Dias et al. 2013</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Study-Level Covariate</rdfs:label>
        <skos:altLabel xml:lang="en">Trial-Level Covariate</skos:altLabel>
        <skos:definition xml:lang="en">A characteristic recorded at the level of an entire study, such as average patient age, used in meta-regression to explain heterogeneity.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Aggregate Covariate</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Study-Level Covariate</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/between-study-heterogeneity"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/study-level-covariate"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-e74fbe1a32a7</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Evidence Synthesis Methods: catalogue subdomain Evidence Synthesis is one of the subdomains</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/study-level-covariate"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/between-study-heterogeneity"/>
        <dcterms:identifier>HEO-L-ddf266194d96</dcterms:identifier>
        <linkRationale xml:lang="en">Differences in study-level characteristics are a source of between-study heterogeneity that meta-regression uses them to explain</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/study-selection -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/study-selection">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/systematic-review"/>
        <precedes rdf:resource="https://healtheconomics.wiki/concept/data-extraction"/>
        <skos:notation>HE-ES-ESM-055</skos:notation>
        <dcterms:identifier>HE-ES-ESM-055</dcterms:identifier>
        <dcterms:source>Higgins et al. 2011</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Study Selection</rdfs:label>
        <skos:definition xml:lang="en">The process of applying predefined inclusion and exclusion criteria to identified studies, determining which are included in a systematic review.</skos:definition>
