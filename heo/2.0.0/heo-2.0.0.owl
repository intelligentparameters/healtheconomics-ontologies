    <!-- https://healtheconomics.wiki/concept/cohens-d -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cohens-d">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/standardised-mean-difference"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/standardised-mean-difference"/>
        <skos:notation>HE-ES-SA-028</skos:notation>
        <dcterms:identifier>HE-ES-SA-028</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Cohen 1988</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cohen&apos;s d</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Cohen d</skos:altLabel>
        <skos:definition xml:lang="en">Cohen&apos;s d is a standardised effect size: the difference between two group means divided by their pooled standard deviation, used to compare studies.</skos:definition>
        <skos:prefLabel xml:lang="en">Cohen&apos;s d</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/hedges-g"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/standardised-response-mean"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cohens-d"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/standardised-mean-difference"/>
        <dcterms:identifier>HEO-L-5a4cb8130bfd</dcterms:identifier>
        <linkRationale xml:lang="en">Cohen&apos;s d is a mean difference divided by the pooled standard deviation, a form of SMD</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
