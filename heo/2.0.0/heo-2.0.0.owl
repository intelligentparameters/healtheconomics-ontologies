    <!-- https://healtheconomics.wiki/concept/model-validation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/model-validation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
