    <!-- https://healtheconomics.wiki/concept/lifecycle-pricing -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/lifecycle-pricing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/lifecycle-management"/>
        <skos:notation>HS-DC-DP-049</skos:notation>
        <dcterms:identifier>HS-DC-DP-049</dcterms:identifier>
        <dcterms:source>DiMasi JA, Grabowski HG, Hansen RW. Innovation in the pharmaceutical industry: new estimates of R&amp;D costs. Journal of Health Economics. 2016;47:20-33. doi:10.1016/j.jhealeco.2016.01.012.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Lifecycle Pricing</rdfs:label>
        <skos:definition xml:lang="en">The strategy governing how a treatment&apos;s price is managed over its entire market life, from launch through patent expiry and generic competition.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Life-Cycle Pricing Strategy</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Lifecycle Price Management</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Lifecycle Pricing</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
