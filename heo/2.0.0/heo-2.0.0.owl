    <!-- https://healtheconomics.wiki/concept/proportional-hazards-assumption -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/proportional-hazards-assumption">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:notation>HE-EM-SM-068</skos:notation>
        <dcterms:identifier>HE-EM-SM-068</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Cox 1972</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Proportional Hazards Assumption</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">PH Assumption</skos:altLabel>
        <skos:definition xml:lang="en">The Cox model assumption that the hazard ratio between two groups stays constant over follow-up, even as the absolute hazard rate changes.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Constant Hazard Ratio Assumption</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Proportional Hazards Assumption</skos:prefLabel>
        <abbreviation xml:lang="en">PH Assumption</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/time-dependency"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/proportional-hazards-assumption"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-e0e6b2d4e8f4</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Survival analysis and extrapolation in subdomain Economic Modelling</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/proportional-hazards-assumption"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/time-dependency"/>
        <dcterms:identifier>HEO-L-fab7dc395763</dcterms:identifier>
        <linkRationale xml:lang="en">The PH assumption is the opposite of a time-dependent hazard ratio.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/proportional-shortfall -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/proportional-shortfall">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-utility-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/cost-utility-analysis"/>
        <skos:notation>HE-EE-CUA-009</skos:notation>
        <dcterms:identifier>HE-EE-CUA-009</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Nord &amp; Johansen 2014</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Proportional Shortfall</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Proportional QALY Shortfall</skos:altLabel>
        <skos:definition xml:lang="en">A measure of disease severity calculated as the proportion, rather than absolute number, of expected quality-adjusted life years lost to a condition.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Relative Shortfall</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Proportional Shortfall</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-4"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/severity-modifier"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/proportional-shortfall"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-utility-analysis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-5a16f5981f36</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Cost utility analysis in subdomain Economic Evaluation; placed under Cost-Utility Analysis, the concept named by its wiki topic</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/proportional-shortfall"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#setsScopeOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/severity-modifier"/>
        <dcterms:identifier>HEO-L-839698599f29</dcterms:identifier>
        <linkRationale xml:lang="en">Shortfall is not an input to the 1.2 or 1.7 weight; it decides whether the modifier applies (NICE PMG36)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/proprietary-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/proprietary-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-economic-model"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-economic-model"/>
        <skos:notation>HE-EM-MV-063</skos:notation>
        <dcterms:identifier>HE-EM-MV-063</dcterms:identifier>
        <dcterms:source>Eddy DM, Hollingworth W, Caro JJ, et al. Model transparency and validation: a report of the ISPOR-SMDM Modeling Good Research Practices Task Force-7. Value in Health. 2012;15(6):843-850. doi:10.1016/j.jval.2012.04.012.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Proprietary Model</rdfs:label>
        <skos:definition xml:lang="en">A model whose underlying code, structure, or key assumptions are kept confidential by the organisation that developed it, typically for commercial reasons.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Closed-Source Model</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Commercial Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Proprietary Model</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/model-transparency"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/proprietary-model"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-economic-model"/>
        <dcterms:identifier>HEO-L-40a56aaeb730</dcterms:identifier>
        <linkRationale xml:lang="en">A proprietary model is a health economic model.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/proprietary-model"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/model-transparency"/>
        <dcterms:identifier>HEO-L-83fe6ce3bd42</dcterms:identifier>
        <linkRationale xml:lang="en">Confidential code lowers model transparency.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
