        <skos:notation>HS-DC-DP-083</skos:notation>
        <dcterms:identifier>HS-DC-DP-083</dcterms:identifier>
        <dcterms:source>CMS, Medicaid Drug Rebate Program</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Rebate</rdfs:label>
        <skos:definition xml:lang="en">A retrospective payment from a manufacturer to a payer, typically a percentage of price or based on utilisation volume, reducing true net cost.</skos:definition>
