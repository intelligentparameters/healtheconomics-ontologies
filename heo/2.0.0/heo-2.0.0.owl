        <skos:altLabel xml:lang="en">GSD</skos:altLabel>
        <skos:definition xml:lang="en">A group sequential design is a trial design with prespecified interim analyses and stopping boundaries that permit early decisions while controlling the relevant overall error rates.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Sequential Trial</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Sequential Trial Design</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Group Sequential Design</skos:prefLabel>
        <abbreviation xml:lang="en">GSD</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/stopping-rule"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/group-sequential-design"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/adaptive-trial-design"/>
        <dcterms:identifier>HEO-L-d3b913aae288</dcterms:identifier>
        <linkRationale xml:lang="en">Group sequential designs are adaptive designs (FDA 2019)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
