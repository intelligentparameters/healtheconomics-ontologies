    <!-- https://healtheconomics.wiki/concept/growth-curve-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/growth-curve-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/trajectory-analysis"/>
