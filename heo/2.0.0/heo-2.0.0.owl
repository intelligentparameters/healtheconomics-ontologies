    <!-- https://healtheconomics.wiki/concept/average-cost -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/average-cost">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/unit-cost"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q945621"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/unit-cost"/>
        <skos:notation>HE-EE-CA-004</skos:notation>
        <dcterms:identifier>HE-EE-CA-004</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Greenlaw et al. 2022</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Average Cost</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Cost per Patient</skos:altLabel>
        <skos:altLabel xml:lang="en">Per Patient Cost</skos:altLabel>
        <skos:definition xml:lang="en">Average cost is total cost divided by the number of units produced, such as patients treated or bed days, giving the cost per unit of a health service.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cost per Unit</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Mean Cost</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Per-Case Cost</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Average Cost</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/incremental-cost"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/marginal-cost"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/diseconomies-of-scale"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/economies-of-scale"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/average-cost"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/unit-cost"/>
        <dcterms:identifier>HEO-L-7539d8b7216b</dcterms:identifier>
        <linkRationale xml:lang="en">Average cost is a cost per unit</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
