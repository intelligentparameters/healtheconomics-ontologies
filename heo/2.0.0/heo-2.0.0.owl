        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/clinical-waste"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/operational-waste"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
