        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Co-insurance</skos:altLabel>
        <skos:definition xml:lang="en">Coinsurance is the percentage of the allowed cost of a covered health service that an insured patient pays, usually after the deductible has been met.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Percentage Cost-Sharing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Coinsurance</skos:prefLabel>
