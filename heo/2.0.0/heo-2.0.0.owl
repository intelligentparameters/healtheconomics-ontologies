    <!-- https://healtheconomics.wiki/concept/drug-utilisation-review -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/drug-utilisation-review">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-audit"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q65066344"/>
