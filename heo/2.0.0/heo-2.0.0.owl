        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/grandfathered-plan"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <dcterms:identifier>HEO-L-56334c6b00a9</dcterms:identifier>
        <linkRationale xml:lang="en">A grandfathered plan is health insurance</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
