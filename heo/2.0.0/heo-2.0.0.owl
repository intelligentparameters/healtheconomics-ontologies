    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/self-control-concept -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/self-control-concept">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/behavioural-economics"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/behavioural-economics"/>
        <skos:notation>HE-EE-BE-035</skos:notation>
        <dcterms:identifier>HE-EE-BE-035</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Thaler &amp; Shefrin 1981</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Self-Control Concept</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Self-Control</skos:altLabel>
        <skos:altLabel xml:lang="en">Willpower Concept</skos:altLabel>
        <skos:definition xml:lang="en">The management of conflict between immediate incentives or effort and longer-term goals, especially when the timing of a choice changes what a person prefers to do.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Impulse Regulation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Self-Regulation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Willpower</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Self-Control Concept</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/present-bias-concept"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/self-control-concept"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/behavioural-economics"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-873d42a4da90</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Behavioral Economics: behavioural economics enters health economics mainly through policy design (incentives, nudges); placed under Behavioural Economics, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/self-control-concept"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#addresses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/present-bias-concept"/>
        <dcterms:identifier>HEO-L-f02874839845</dcterms:identifier>
        <linkRationale xml:lang="en">Self-control is the management of the conflict that present bias creates, so it deals with present bias rather than opposing it.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/self-efficacy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/self-efficacy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/patient-activation"/>
        <skos:notation>HE-ES-CO-069</skos:notation>
        <dcterms:identifier>HE-ES-CO-069</dcterms:identifier>
        <dcterms:source>Bandura 1977</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Self-Efficacy</rdfs:label>
        <skos:definition xml:lang="en">An individual&apos;s belief in their own capacity to successfully perform actions needed to manage a specific situation, such as a chronic condition.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Confidence to Act</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Perceived Capability</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Self-Efficacy</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/behaviour-change"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/self-management"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/self-efficacy"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-bb97efc96ad2</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Clinical Outcomes: concepts with this Level 3 that the wiki places in a topic sit in Outcomes (Clinical and patient-reported outcomes)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/self-efficacy"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/patient-activation"/>
        <dcterms:identifier>HEO-L-45d07b597489</dcterms:identifier>
        <linkRationale xml:lang="en">Object definition, confidence in self-management is one component of patient activation</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
