    <!-- https://healtheconomics.wiki/concept/self-funded-plan -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/self-funded-plan">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/self-insurance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/self-insurance"/>
        <skos:notation>HS-HP-HI-175</skos:notation>
        <dcterms:identifier>HS-HP-HI-175</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Self-Funded Plan</rdfs:label>
        <skos:altLabel xml:lang="en">Self-Funded Health Plan</skos:altLabel>
        <skos:definition xml:lang="en">An arrangement where an employer itself assumes financial risk for employee healthcare claims, rather than purchasing a fully insured policy.</skos:definition>
        <skos:hiddenLabel xml:lang="en">ASO Arrangement</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Self-Funded Plan</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/stop-loss-insurance"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/self-funded-plan"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/self-insurance"/>
        <dcterms:identifier>HEO-L-17192447a9e5</dcterms:identifier>
        <linkRationale xml:lang="en">An employer retaining claims risk is a form of self-insurance.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/self-funded-plan"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/stop-loss-insurance"/>
        <dcterms:identifier>HEO-L-79cb52655d12</dcterms:identifier>
        <linkRationale xml:lang="en">Self-funded employers buy stop-loss insurance against high claims.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


