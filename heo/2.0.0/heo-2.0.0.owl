        <dcterms:identifier>HEO-L-91d99c71c304</dcterms:identifier>
        <linkRationale xml:lang="en">Medicaid DSH payments to hospitals continue to my knowledge; a hospital payment is provider payment, not a whole financing system</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
