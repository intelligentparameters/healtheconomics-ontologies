        <skos:definition xml:lang="en">A flexible probability distribution capable of a monotonically increasing or decreasing hazard rate depending on its shape parameter.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Weibull Density</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Weibull Distribution</skos:prefLabel>
