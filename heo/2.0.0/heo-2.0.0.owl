    <!-- https://healtheconomics.wiki/concept/horizontal-inequity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/horizontal-inequity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-inequity"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-inequity"/>
        <skos:notation>HE-EE-HE-007</skos:notation>
        <dcterms:identifier>HE-EE-HE-007</dcterms:identifier>
        <dcterms:source>Wagstaff &amp; van Doorslaer 2000</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Horizontal Inequity</rdfs:label>
        <skos:definition xml:lang="en">A violation of the principle that individuals with equal healthcare need should receive equal treatment, regardless of income or other irrelevant characteristics.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Equity Violation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Unequal Treatment for Equal Need</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Horizontal Inequity</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/vertical-inequity"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/horizontal-inequity"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-inequity"/>
        <dcterms:identifier>HEO-L-4fc0047bd36a</dcterms:identifier>
        <linkRationale xml:lang="en">Unequal treatment for equal need is a form of inequity</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/horizontal-inequity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/vertical-inequity"/>
        <dcterms:identifier>HEO-L-3ed55fbeb172</dcterms:identifier>
