    <!-- https://healtheconomics.wiki/concept/extended-dominance -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/extended-dominance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/dominance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/dominance"/>
        <skos:notation>HE-EE-CEA-029</skos:notation>
        <dcterms:identifier>HE-EE-CEA-029</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Extended Dominance</rdfs:label>
        <owl:versionInfo>1.0.13</owl:versionInfo>
        <skos:definition xml:lang="en">Extended dominance excludes an option in cost-effectiveness analysis when a blend of a less and a more effective option gives its health gain for less.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Combination Dominance</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Non-Simple Dominance</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Extended Dominance</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/strict-dominance"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-frontier"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/extended-dominance"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/dominance"/>
        <dcterms:identifier>HEO-L-38af26b2739a</dcterms:identifier>
        <linkRationale xml:lang="en">The object definition covers both rules</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
