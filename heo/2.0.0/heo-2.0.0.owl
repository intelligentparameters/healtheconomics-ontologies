        <skos:altLabel xml:lang="en">Age-Based Rating</skos:altLabel>
        <skos:definition xml:lang="en">Age rating is setting health insurance premiums by the buyer&apos;s age, as expected costs rise with age; some laws cap it, such as the US 3:1 adult limit.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Age-Banded Pricing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Age Rating</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/community-rating"/>
        <modifies rdf:resource="https://healtheconomics.wiki/concept/premium"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
