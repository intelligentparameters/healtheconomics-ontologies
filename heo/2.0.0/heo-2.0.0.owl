    <!-- https://healtheconomics.wiki/concept/studentized-residual -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/studentized-residual">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/standardised-residual"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/standardised-residual"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/outlier"/>
        <skos:notation>HE-ES-SA-208</skos:notation>
        <dcterms:identifier>HE-ES-SA-208</dcterms:identifier>
        <dcterms:source>Cook &amp; Weisberg 1982</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Studentized Residual</rdfs:label>
        <skos:altLabel xml:lang="en">Jackknife Residual</skos:altLabel>
        <skos:altLabel xml:lang="en">Studentised Residual</skos:altLabel>
        <skos:definition xml:lang="en">A standardised residual excluding an observation&apos;s own contribution to the model fit, a more robust diagnostic for identifying influential data points.</skos:definition>
        <skos:prefLabel xml:lang="en">Studentized Residual</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/studentized-residual"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/standardised-residual"/>
        <dcterms:identifier>HEO-L-3127749762da</dcterms:identifier>
        <linkRationale xml:lang="en">An externally studentised residual is a standardised residual that leaves out the observation itself.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/studentized-residual"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
