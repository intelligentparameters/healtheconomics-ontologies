    <!-- https://healtheconomics.wiki/concept/surplus -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/surplus">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <skos:notation>HS-HP-HF-076</skos:notation>
        <dcterms:identifier>HS-HP-HF-076</dcterms:identifier>
        <dcterms:source>Musgrave &amp; Musgrave 1989</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Surplus</rdfs:label>
        <skos:definition xml:lang="en">An excess of revenue over spending within a budget period, representing funds that can be saved, reinvested, or returned.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Net Benefit to Society</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Welfare Gain</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Surplus</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/deficit"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/surplus"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-bd1901bccbe0</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health Financing: wiki topic Health financing and insurance sits in Health Systems; placed under Health System Financing, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/surplus"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/deficit"/>
        <dcterms:identifier>HEO-L-74a22694a982</dcterms:identifier>
        <linkRationale xml:lang="en">Subject definition is a budget surplus, not a welfare economics term; a deficit is its opposite</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


