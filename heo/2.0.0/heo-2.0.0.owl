        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Randomization</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Random Allocation</skos:altLabel>
        <skos:altLabel xml:lang="en">Randomisation</skos:altLabel>
        <skos:definition xml:lang="en">The process of assigning trial participants to treatment groups by chance, producing groups comparable on both known and unknown influencing factors.</skos:definition>
        <skos:prefLabel xml:lang="en">Randomization</skos:prefLabel>
        <assumes rdf:resource="https://healtheconomics.wiki/concept/equipoise"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/minimisation"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-1"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/confounding"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/randomization"/>
