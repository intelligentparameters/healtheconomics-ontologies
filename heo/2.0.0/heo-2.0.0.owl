    <!-- https://healtheconomics.wiki/concept/professional-development -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/professional-development">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
