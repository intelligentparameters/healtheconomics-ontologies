        <dcterms:identifier>HE-EE-CBA-029</dcterms:identifier>
        <dcterms:source>Brealey, Myers &amp; Allen 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Investment Horizon</rdfs:label>
        <skos:altLabel xml:lang="en">Investment Time Horizon</skos:altLabel>
        <skos:definition xml:lang="en">The length of time over which an investment&apos;s costs and returns are expected to be realised and evaluated.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Payback Horizon</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Investment Horizon</skos:prefLabel>
