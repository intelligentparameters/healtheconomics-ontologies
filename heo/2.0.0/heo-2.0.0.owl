    <!-- https://healtheconomics.wiki/concept/reference-product -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/reference-product">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/biologic"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/biologic"/>
        <skos:notation>HS-DC-GC-008</skos:notation>
        <dcterms:identifier>HS-DC-GC-008</dcterms:identifier>
        <dcterms:source>FDA, Biologics Price Competition and Innovation Act 2009</dcterms:source>
