    <!-- https://healtheconomics.wiki/concept/habit-formation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/habit-formation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/behavioural-economics"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
