    <!-- https://healtheconomics.wiki/concept/quality-based-incentive -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/quality-based-incentive">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-system-performance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-system-performance"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/pay-for-performance"/>
        <skos:notation>HS-NHS-HSP-014</skos:notation>
        <dcterms:identifier>HS-NHS-HSP-014</dcterms:identifier>
        <dcterms:source>Carlson JJ, Sullivan SD, Garrison LP, Neumann PJ, Veenstra DL. Linking payment to health outcomes: a taxonomy and examination of performance-based reimbursement schemes. Health Policy. 2010;96(3):179-190.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Quality-Based Incentive</rdfs:label>
        <skos:definition xml:lang="en">A financial reward provided to a provider for achieving specific, predefined quality performance targets under value-based payment arrangements.</skos:definition>
        <skos:hiddenLabel xml:lang="en">P4P Incentive</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Quality Bonus Payment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Quality-Based Incentive</skos:prefLabel>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/quality-improvement"/>
