    <!-- https://healtheconomics.wiki/concept/hale-calculation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/hale-calculation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:notation>HE-EE-HU-029</skos:notation>
        <dcterms:identifier>HE-EE-HU-029</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Robine &amp; Ritchie 1991</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Hale Calculation</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Health-Adjusted Life Expectancy Calculation</skos:altLabel>
        <skos:definition xml:lang="en">The process of computing health-adjusted life expectancy, combining mortality data with health state prevalence and severity weights into one summary measure.</skos:definition>
        <skos:hiddenLabel xml:lang="en">HALE Computation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Hale Calculation</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/outcomes#step-2"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/health-expectancy"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/healthy-life-expectancy"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/disability-weight"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/sullivan-method"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/hale-calculation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-94bdbc63c141</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Health utility and preference elicitation in subdomain Outcomes</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/hale-calculation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#produces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-expectancy"/>
        <dcterms:identifier>HEO-L-1a89a716ed53</dcterms:identifier>
        <linkRationale xml:lang="en">The calculation is a process whose output is HALE, a health expectancy</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
