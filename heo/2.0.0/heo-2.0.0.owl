    <!-- https://healtheconomics.wiki/concept/effective-coverage -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/effective-coverage">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/quality-indicator"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/quality-indicator"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/universal-health-coverage"/>
        <skos:notation>HS-SS_HSP-024</skos:notation>
        <dcterms:identifier>HS-SS_HSP-024</dcterms:identifier>
        <dcterms:source>Tanahashi 1978</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Effective Coverage</rdfs:label>
        <skos:definition xml:lang="en">A measure of the proportion of a target population that both received an intervention and experienced the health gain it is intended to produce.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Effective Reach</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Outcome-Weighted Coverage</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Effective Coverage</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/effective-coverage"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/quality-indicator"/>
        <dcterms:identifier>HEO-L-0c1ab76dff28</dcterms:identifier>
        <linkRationale xml:lang="en">effective coverage is a quality-adjusted coverage indicator</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/effective-coverage"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/universal-health-coverage"/>
