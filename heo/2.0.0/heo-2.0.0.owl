        <skos:altLabel xml:lang="en">Behavioral Health Carve-Out</skos:altLabel>
        <skos:altLabel xml:lang="en">Mental Health Carve-Out</skos:altLabel>
        <skos:definition xml:lang="en">A behavioural health carve-out is an insurance arrangement that finances and manages mental health and substance use services under a separate contract.</skos:definition>
        <skos:prefLabel xml:lang="en">Behavioural Health Carve-Out</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/integrated-care"/>
