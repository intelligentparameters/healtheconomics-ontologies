    <!-- https://healtheconomics.wiki/concept/pairwise-deletion -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/pairwise-deletion">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/available-case-analysis"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/missing-data-methods"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/available-case-analysis"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/missing-data-methods"/>
        <skos:notation>HE-ES-SA-147</skos:notation>
        <dcterms:identifier>HE-ES-SA-147</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Rubin 1976</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Pairwise Deletion</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Available-Case Analysis</skos:altLabel>
        <skos:definition xml:lang="en">A missing data method in which each specific calculation uses all observations with complete data for that particular pair of variables.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Pairwise Case Exclusion</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Pairwise Deletion</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/missing-data"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/listwise-deletion"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
