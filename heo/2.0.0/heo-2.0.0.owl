    <!-- https://healtheconomics.wiki/concept/supplier-induced-demand -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/supplier-induced-demand">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q7644482"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HE-EE-ME-069</skos:notation>
        <dcterms:identifier>HE-EE-ME-069</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Evans 1974</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Supplier-Induced Demand</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Provider-Induced Demand</skos:altLabel>
        <skos:altLabel xml:lang="en">SID</skos:altLabel>
        <skos:definition xml:lang="en">The phenomenon in which providers, using their informational advantage, influence the quantity or type of care demanded beyond what informed patients would choose.</skos:definition>
        <skos:prefLabel xml:lang="en">Supplier-Induced Demand</skos:prefLabel>
        <abbreviation xml:lang="en">SID</abbreviation>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/clinical-practice-variation"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/demand"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/supplier-induced-demand"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-155d998eaf55</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Market Economics: demand, supply, agency and moral hazard describe how health care markets are organised and paid for</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/supplier-induced-demand"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/clinical-practice-variation"/>
        <dcterms:identifier>HEO-L-e0adeaa3955f</dcterms:identifier>
        <linkRationale xml:lang="en">Supplier inducement is a recognised driver of unwarranted practice variation.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/supplier-induced-demand"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/demand"/>
        <dcterms:identifier>HEO-L-6aa938dc38ad</dcterms:identifier>
        <linkRationale xml:lang="en">Supplier-induced demand shifts the demand for care, per its definition.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/supply -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/supply">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q542869"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
