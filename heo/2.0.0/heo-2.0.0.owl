    <!-- https://healtheconomics.wiki/concept/monopoly-pricing -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/monopoly-pricing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <skos:notation>HE-EE-ME-041</skos:notation>
        <dcterms:identifier>HE-EE-ME-041</dcterms:identifier>
        <dcterms:source>Varian 2014</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Monopoly Pricing</rdfs:label>
        <skos:altLabel xml:lang="en">Monopolist Pricing</skos:altLabel>
        <skos:definition xml:lang="en">The pricing behaviour of a firm with monopoly power, setting price above marginal cost to maximise profit and reduce quantity supplied.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Single-Seller Pricing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Monopoly Pricing</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/deadweight-loss"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
