        <dcterms:identifier>HEO-L-33f5de172f61</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Budget impact analysis in subdomain Economic Evaluation; placed under Budget Impact Analysis, the concept named by its wiki topic</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/budget-impact"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
