        <skos:notation>HE-EE-BE-021</skos:notation>
        <dcterms:identifier>HE-EE-BE-021</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Lally et al. 2010</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Habit Formation</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">The development of a cue-linked tendency to perform a behaviour more automatically through repetition in a recurring context.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Automatic Behaviour Formation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Habit Building</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Habit Formation</skos:prefLabel>
