        <dcterms:identifier>HEO-L-112bbfaa470f</dcterms:identifier>
        <linkRationale xml:lang="en">The Part D coverage gap was a feature of the standard benefit structure, an element of benefit design</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
