    <!-- https://healtheconomics.wiki/concept/correlation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/correlation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q186290"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:notation>HE-EM-UA-015</skos:notation>
        <dcterms:identifier>HE-EM-UA-015</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Bewick et al. 2003</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Correlation</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:definition xml:lang="en">Correlation is how strongly two variables move together or in opposite directions, such as costs and QALYs, without showing that one causes the other.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Co-Movement</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Statistical Association</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Correlation</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/psa"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-10"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/correlation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-ca09da5930b9</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Uncertainty and sensitivity analysis in subdomain Economic Modelling</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/correlation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/psa"/>
        <dcterms:identifier>HEO-L-69a7b57cdc52</dcterms:identifier>
        <linkRationale xml:lang="en">Parameter correlations must be reflected in PSA sampling</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/correlation-coefficient -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/correlation-coefficient">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/effect-size"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q3433612"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/effect-size"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/convergent-validity"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/correlation"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/criterion-validity"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/discriminant-validity"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/correlation-matrix"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/variance-covariance-matrix"/>
        <skos:notation>HE-ES-SA-038</skos:notation>
        <dcterms:identifier>HE-ES-SA-038</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Mukaka 2012</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Correlation Coefficient</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:definition xml:lang="en">A correlation coefficient is a statistic from -1 to +1 giving the direction and strength of association between paired variables, such as costs and QALYs.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Association Coefficient</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Pearson r</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Correlation Coefficient</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/psa"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/correlation-coefficient"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/effect-size"/>
        <dcterms:identifier>HEO-L-6e5517882142</dcterms:identifier>
        <linkRationale xml:lang="en">A correlation coefficient is itself an effect-size index (Cohen 1988), not a measure of effect size</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/correlation-coefficient"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/convergent-validity"/>
        <dcterms:identifier>HEO-L-abd7b76ddfbd</dcterms:identifier>
        <linkRationale xml:lang="en">Convergent validity is assessed by correlations with related measures (object definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/correlation-coefficient"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/correlation"/>
        <dcterms:identifier>HEO-L-9d945613a0a3</dcterms:identifier>
        <linkRationale xml:lang="en">A coefficient is the statistic that quantifies correlation, not a kind of correlation</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/correlation-coefficient"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/criterion-validity"/>
        <dcterms:identifier>HEO-L-e8af42ca6492</dcterms:identifier>
        <linkRationale xml:lang="en">Criterion validity is commonly assessed by correlating scores with a gold standard</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/correlation-coefficient"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/discriminant-validity"/>
