        <dcterms:identifier>HEO-L-7bb3b426f0f4</dcterms:identifier>
        <linkRationale xml:lang="en">A semi-fixed cost is a cost category.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
