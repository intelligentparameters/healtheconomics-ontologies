    <!-- https://healtheconomics.wiki/concept/factor-mapping -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/factor-mapping">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
