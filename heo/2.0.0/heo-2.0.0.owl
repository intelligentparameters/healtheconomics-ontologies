        <rdfs:label xml:lang="en">Per Member Per Month</rdfs:label>
        <skos:altLabel xml:lang="en">PMPM</skos:altLabel>
        <skos:definition xml:lang="en">A standard unit expressing a capitated payment as the fixed monthly amount received per enrolled member, regardless of services actually used.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Capitated Monthly Payment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Per Member Per Month</skos:prefLabel>
        <abbreviation xml:lang="en">PMPM</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-3"/>
