        <skos:hiddenLabel xml:lang="en">Regulatory Action</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Sanction</skos:prefLabel>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/compliance"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
