    <!-- https://healtheconomics.wiki/concept/rate-band -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/rate-band">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/regulatory-standards"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/regulatory-standards"/>
        <skos:notation>HS-HP-HI-154</skos:notation>
        <dcterms:identifier>HS-HP-HI-154</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Rate Band</rdfs:label>
        <skos:definition xml:lang="en">A regulatory range within which an insurer may vary premiums by a specific rating factor, such as age, limiting maximum variation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Premium Band</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Rating Tier</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Rate Band</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/age-rating"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/premium-setting"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/rate-band"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/regulatory-standards"/>
        <dcterms:identifier>HEO-L-4ac218bbe495</dcterms:identifier>
        <linkRationale xml:lang="en">Definition: a regulatory range limiting premium variation; backbone parent.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
