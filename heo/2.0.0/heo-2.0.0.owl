        <partOf rdf:resource="https://healtheconomics.wiki/concept/drug-development"/>
        <skos:notation>HE-PE-DD-002</skos:notation>
        <dcterms:identifier>HE-PE-DD-002</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>FDA mass balance guidance 2024</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
