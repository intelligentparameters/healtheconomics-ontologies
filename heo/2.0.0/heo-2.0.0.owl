        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Negative Feedback</rdfs:label>
        <skos:altLabel xml:lang="en">Balancing Loop</skos:altLabel>
        <skos:definition xml:lang="en">A causal relationship in which a change in one variable triggers effects that counteract or dampen the original change, stabilising the system.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Self-Correcting Loop</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Negative Feedback</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/positive-feedback"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/causal-loop-diagram"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
