    <!-- https://healtheconomics.wiki/concept/process-measure -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/process-measure">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/quality-indicator"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/quality-indicator"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/process-quality"/>
        <skos:notation>HS-NHS-HQ-059</skos:notation>
        <dcterms:identifier>HS-NHS-HQ-059</dcterms:identifier>
        <dcterms:source>Donabedian A. Evaluating the quality of medical care. Milbank Memorial Fund Quarterly. 1966;44(3):166-206. doi:10.2307/3348969.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Process Measure</rdfs:label>
        <skos:altLabel xml:lang="en">Process-of-Care Measure</skos:altLabel>
        <skos:definition xml:lang="en">A metric assessing whether appropriate, evidence-based care processes were actually followed, unlike measures of resources available or outcomes achieved.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Care-Process Metric</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Process Measure</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/outcome-measure"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/structure-measure"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/process-measure"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/quality-indicator"/>
        <dcterms:identifier>HEO-L-efb81d502ad9</dcterms:identifier>
        <linkRationale xml:lang="en">A process measure is a quality indicator in the process domain.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/process-measure"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/process-quality"/>
        <dcterms:identifier>HEO-L-06f3a8b791d9</dcterms:identifier>
        <linkRationale xml:lang="en">Process measures quantify process quality (both definitions)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/process-measure"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
