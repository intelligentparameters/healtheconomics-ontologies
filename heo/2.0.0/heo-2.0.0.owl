        <uses rdf:resource="https://healtheconomics.wiki/concept/washout-period"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/within-patient-analysis"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
