    <!-- https://healtheconomics.wiki/concept/propensity-score-matching -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/propensity-score-matching">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/matching-design"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q7250160"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/matching-design"/>
        <skos:notation>HE-ES-RWE-010</skos:notation>
        <dcterms:identifier>HE-ES-RWE-010</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Rosenbaum &amp; Rubin 1983</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Propensity Score Matching</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">PSM</skos:altLabel>
        <skos:definition xml:lang="en">Propensity score matching is an observational study design method that pairs treated and untreated individuals with similar probabilities of treatment given measured baseline characteristics to estimate a treatment contrast in the population retained by the matches.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Matched-Cohort PS Analysis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Propensity Score Matching</skos:prefLabel>
        <abbreviation xml:lang="en">PSM</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-5"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/confounding"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/propensity-score"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/propensity-score-matching"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/matching-design"/>
        <dcterms:identifier>HEO-L-6d844d093402</dcterms:identifier>
        <linkRationale xml:lang="en">PSM is a matching design.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
