        <dcterms:source>Nelson 1970</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Search Good</rdfs:label>
        <skos:definition xml:lang="en">A good whose quality can be assessed by the consumer before purchase, unlike an experience good evaluated only after consumption.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Inspection Good</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Search Product</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Search Good</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
