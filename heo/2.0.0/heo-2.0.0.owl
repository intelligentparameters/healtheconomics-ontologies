    <!-- https://healtheconomics.wiki/concept/incremental-net-benefit -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/incremental-net-benefit">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/net-benefit"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/net-benefit"/>
        <skos:notation>HE-EE-CBA-027</skos:notation>
        <dcterms:identifier>HE-EE-CBA-027</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Stinnett &amp; Mullahy 1998</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Incremental Net Benefit</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">INB</skos:altLabel>
        <skos:definition xml:lang="en">The difference in expected net benefit between two competing interventions, found by converting the incremental health effect into money and subtracting incremental cost.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Incremental Net-Benefit Statistic</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Incremental Net Benefit</skos:prefLabel>
        <abbreviation xml:lang="en">INB</abbreviation>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/incremental-net-benefit"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/net-benefit"/>
        <dcterms:identifier>HEO-L-7133836453af</dcterms:identifier>
        <linkRationale xml:lang="en">Incremental net benefit is net benefit.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/incremental-net-monetary-benefit -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/incremental-net-monetary-benefit">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/incremental-net-benefit"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
