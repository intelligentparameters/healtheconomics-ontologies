        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/risk-of-bias-assessment"/>
        <dcterms:identifier>HEO-L-186f5b8ea256</dcterms:identifier>
        <linkRationale xml:lang="en">Definition says quality scores are discouraged in favour of risk of bias judgements.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/quality-standard -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/quality-standard">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:notation>HS-HP-HTA-164</skos:notation>
        <dcterms:identifier>HS-HP-HTA-164</dcterms:identifier>
        <dcterms:source>National Institute for Health and Care Excellence. NICE technology appraisal and highly specialised technologies guidance: the manual (PMG36). Published 2022; updated 2026.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Quality Standard</rdfs:label>
        <skos:definition xml:lang="en">A concise set of specific, measurable statements describing high-priority quality improvement areas, typically derived from evidence-based guidelines.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Care Standard</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Quality Benchmark</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Quality Standard</skos:prefLabel>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/quality-improvement"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/quality-standard"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-0f1adb6ac88c</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health Technology Assessment: HTA concepts belong to the HTA subdomain</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/quality-standard"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#promotes"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/quality-improvement"/>
        <dcterms:identifier>HEO-L-704b4c25e66a</dcterms:identifier>
        <linkRationale xml:lang="en">Quality standards are derived from guidelines but are not guidelines (NICE); they describe priority improvement areas.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/quality-uncertainty -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/quality-uncertainty">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/information-asymmetry"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/information-asymmetry"/>
        <skos:notation>HE-EE-ME-060</skos:notation>
        <dcterms:identifier>HE-EE-ME-060</dcterms:identifier>
        <dcterms:source>Akerlof 1970</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Quality Uncertainty</rdfs:label>
        <skos:definition xml:lang="en">A condition in which buyers cannot reliably judge a good&apos;s quality before purchase, risking markets dominated by lower-quality offerings.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Hidden-Quality Problem</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Lemons Problem</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Quality Uncertainty</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/adverse-selection"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/market-failure"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/quality-uncertainty"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/information-asymmetry"/>
        <dcterms:identifier>HEO-L-d60e2f39911b</dcterms:identifier>
        <linkRationale xml:lang="en">Quality uncertainty is a form of information asymmetry.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/quality-uncertainty"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/adverse-selection"/>
        <dcterms:identifier>HEO-L-80a3ba4dda15</dcterms:identifier>
        <linkRationale xml:lang="en">Quality uncertainty drives adverse selection (Akerlof 1970).</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/quality-uncertainty"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/market-failure"/>
        <dcterms:identifier>HEO-L-93b2086ab741</dcterms:identifier>
        <linkRationale xml:lang="en">Quality uncertainty causes market failure.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/quantitative-synthesis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/quantitative-synthesis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-ES-ESM-048</skos:notation>
        <dcterms:identifier>HE-ES-ESM-048</dcterms:identifier>
        <dcterms:source>DerSimonian R, Laird N. Meta-analysis in clinical trials. Controlled Clinical Trials. 1986;7(3):177-188. doi:10.1016/0197-2456(86)90046-2.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Quantitative Synthesis</rdfs:label>
        <skos:definition xml:lang="en">The statistical combination of numerical results from multiple studies into a single pooled estimate, unlike a descriptive narrative synthesis.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Statistical Pooling of Studies</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Statistical Synthesis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Quantitative Synthesis</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/narrative-synthesis"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/quantitative-synthesis"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:identifier>HEO-L-6444e9064d3c</dcterms:identifier>
        <linkRationale xml:lang="en">Quantitative synthesis is evidence synthesis.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/quantitative-synthesis"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/narrative-synthesis"/>
        <dcterms:identifier>HEO-L-95002fd37e4a</dcterms:identifier>
        <linkRationale xml:lang="en">Quantitative and narrative synthesis are alternatives.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/quantity-distortion -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/quantity-distortion">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <skos:notation>HE-EE-ME-061</skos:notation>
        <dcterms:identifier>HE-EE-ME-061</dcterms:identifier>
        <dcterms:source>Varian 2014</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Quantity Distortion</rdfs:label>
        <skos:definition xml:lang="en">A deviation of the quantity produced or consumed from the level that would prevail under efficient conditions, often caused by price controls or insurance.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Output Distortion</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Quantity Misallocation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Quantity Distortion</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/price-distortion"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/deadweight-loss"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/quantity-distortion"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-fc8139dfcf63</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Market failure and information in subdomain Economic Foundations</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/quantity-distortion"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/price-distortion"/>
        <dcterms:identifier>HEO-L-f866a5c0fed9</dcterms:identifier>
        <linkRationale xml:lang="en">Quantity and price distortion are paired alternatives.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/quantity-distortion"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
