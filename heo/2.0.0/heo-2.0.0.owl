    <!-- https://healtheconomics.wiki/concept/volume-growth -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/volume-growth">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/healthcare-cost-growth"/>
        <skos:notation>HE-EE-CA-088</skos:notation>
        <dcterms:identifier>HE-EE-CA-088</dcterms:identifier>
        <dcterms:source>Newhouse 1992</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Volume Growth</rdfs:label>
        <skos:definition xml:lang="en">The component of rising healthcare expenditure attributable to an increase in the number of services delivered, rather than price or intensity.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Activity Growth</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Utilisation Growth</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Volume Growth</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/intensity-growth"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/volume-growth"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-8a9606de13d3</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Cost Analysis: cost analysis is costing; most concepts with this Level 3 that the wiki places in a topic sit in Costs</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/volume-growth"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/healthcare-cost-growth"/>
        <dcterms:identifier>HEO-L-2f57f8673339</dcterms:identifier>
        <linkRationale xml:lang="en">Subject definition, the volume component of rising expenditure</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
