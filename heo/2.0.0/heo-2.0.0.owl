        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Evidence Implementation</rdfs:label>
        <skos:definition xml:lang="en">The systematic process of translating research findings into actual routine practice, addressing the gap between what works and what is done.</skos:definition>
