        <skos:definition xml:lang="en">A health state is a defined level of health, such as an EQ-5D profile or a state in a Markov model, to which a utility value and costs are attached.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Described State Profile</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">EQ-5D State</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Health State</skos:prefLabel>
        <represents rdf:resource="https://healtheconomics.wiki/concept/health-status"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
