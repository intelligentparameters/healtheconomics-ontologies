        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/branch"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/decision-tree"/>
        <skos:notation>HE-EM-DM-102</skos:notation>
        <dcterms:identifier>HE-EM-DM-102</dcterms:identifier>
        <dcterms:source>Weinstein &amp; Fineberg 1980</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Terminal Node</rdfs:label>
        <skos:altLabel xml:lang="en">End Node</skos:altLabel>
        <skos:altLabel xml:lang="en">Leaf Node</skos:altLabel>
        <skos:definition xml:lang="en">The endpoint of a branch within a decision tree, where no further events are attached and final cost and outcome values are recorded.</skos:definition>
        <skos:prefLabel xml:lang="en">Terminal Node</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/chance-node"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
