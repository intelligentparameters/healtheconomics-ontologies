    <!-- https://healtheconomics.wiki/concept/ego-depletion-concept -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/ego-depletion-concept">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/behavioural-theory"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/behavioural-theory"/>
        <skos:notation>HE-EE-BE-015</skos:notation>
        <dcterms:identifier>HE-EE-BE-015</dcterms:identifier>
        <dcterms:source>Baumeister et al. 1998</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Ego Depletion Concept</rdfs:label>
        <skos:altLabel xml:lang="en">Ego Depletion Theory</skos:altLabel>
        <skos:definition xml:lang="en">A theory that self-control draws on a limited psychological resource that depletes with repeated use, reducing further self-regulation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Self-Control Depletion</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Ego Depletion Concept</skos:prefLabel>
        <explains rdf:resource="https://healtheconomics.wiki/concept/self-control-concept"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/ego-depletion-concept"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/behavioural-theory"/>
        <dcterms:identifier>HEO-L-5d831d9c6a05</dcterms:identifier>
        <linkRationale xml:lang="en">Ego depletion is a theory of self-regulation, a behavioural theory</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/ego-depletion-concept"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#explains"/>
