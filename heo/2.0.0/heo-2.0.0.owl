        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Symptom Burden</rdfs:label>
        <skos:definition xml:lang="en">A measure of a disease&apos;s overall symptom impact on a patient, covering both the number and severity of symptoms experienced.</skos:definition>
