    <!-- https://healtheconomics.wiki/concept/pain-intensity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/pain-intensity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
