    <!-- https://healtheconomics.wiki/concept/pareto-frontier -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/pareto-frontier">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HE-EE_EA-039</skos:notation>
        <dcterms:identifier>HE-EE_EA-039</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Pareto 1906</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Pareto Frontier</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Pareto Front</skos:altLabel>
        <skos:definition xml:lang="en">The set of feasible options that are not dominated by another option that is at least as good on every specified objective and strictly better on at least one.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Optimal Trade-Off Curve</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Pareto Frontier</skos:prefLabel>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/efficiency-frontier"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/pareto-frontier"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-db7934832b22</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Efficiency Analysis: every concept with this Level 3 that the wiki places in a topic sits in Health Systems (Performance, productivity and quality)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/pareto-frontier"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isFoundationFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/efficiency-frontier"/>
        <dcterms:identifier>HEO-L-b82355304707</dcterms:identifier>
        <linkRationale xml:lang="en">The CEA efficiency frontier also drops extendedly dominated options, so not every Pareto frontier is one; non-dominance underlies it</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/pareto-improvement -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/pareto-improvement">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/welfare-economics"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/welfare-economics"/>
        <skos:notation>HE-EE_EA-040</skos:notation>
        <dcterms:identifier>HE-EE_EA-040</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-03</dcterms:modified>
        <dcterms:source>Feldman 1998</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Pareto Improvement</rdfs:label>
        <owl:versionInfo>1.0.3</owl:versionInfo>
        <skos:definition xml:lang="en">A Pareto improvement is a change, such as a reallocation of a health budget, that makes at least one person better off and nobody worse off.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Pareto-Improving Change</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Welfare-Increasing Move</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Pareto Improvement</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/kaldor-hicks-efficiency"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/allocative-efficiency"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/pareto-efficiency"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/pareto-improvement"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/welfare-economics"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-68f9dad38a54</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: curated: review B: welfare economics criterion, not health system performance</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/pareto-improvement"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/kaldor-hicks-efficiency"/>
        <dcterms:identifier>HEO-L-dcbf0d0172d7</dcterms:identifier>
