        <skos:altLabel xml:lang="en">F Distribution</skos:altLabel>
        <skos:altLabel xml:lang="en">Variance-Ratio Distribution</skos:altLabel>
        <skos:definition xml:lang="en">A continuous probability distribution arising from the ratio of two independent chi-square variables divided by their degrees of freedom, underlying analysis of variance.</skos:definition>
        <skos:prefLabel xml:lang="en">F-Distribution</skos:prefLabel>
