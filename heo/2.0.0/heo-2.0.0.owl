    <!-- https://healtheconomics.wiki/concept/catastrophic-expenditure-measure -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/catastrophic-expenditure-measure">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/financial-hardship-measure"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/financial-hardship-measure"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/catastrophic-health-expenditure"/>
        <skos:notation>HS-HP-HF-007</skos:notation>
        <dcterms:identifier>HS-HP-HF-007</dcterms:identifier>
        <dcterms:source>Xu et al. 2003</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Catastrophic Expenditure Measure</rdfs:label>
        <skos:altLabel xml:lang="en">CHE Measure</skos:altLabel>
        <skos:definition xml:lang="en">A quantitative indicator assessing whether household out-of-pocket healthcare spending exceeds a defined threshold share of income or consumption capacity.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Catastrophic-Spending Indicator</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Catastrophic Expenditure Measure</skos:prefLabel>
        <abbreviation xml:lang="en">CHE Measure</abbreviation>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/catastrophic-expenditure-measure"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/financial-hardship-measure"/>
        <dcterms:identifier>HEO-L-154578e8eb4f</dcterms:identifier>
        <linkRationale xml:lang="en">Catastrophic spending tracks financial burden, not care quality; the object definition names catastrophic expenditure</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
