    <!-- https://healtheconomics.wiki/concept/search-good -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/search-good">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-good"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
