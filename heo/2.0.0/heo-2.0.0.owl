        <dcterms:identifier>HEO-L-365dca7fbdda</dcterms:identifier>
        <linkRationale xml:lang="en">Half-cycle correction adjusts within a cycle</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
