        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/proxy-means-test"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/exclusion-error"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/inclusion-error"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
