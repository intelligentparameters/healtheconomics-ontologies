        <dcterms:identifier>HE-EE-EPR-009</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Employer Perspective</rdfs:label>
        <skos:definition xml:lang="en">An analytic viewpoint including only costs and outcomes relevant to an employer, such as premium contributions and productivity losses from absenteeism.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Employer Cost Perspective</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Employer Viewpoint</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Employer Perspective</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/payer-perspective"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/productivity-cost"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/employer-perspective"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/perspective"/>
        <dcterms:identifier>HEO-L-3539a31bddeb</dcterms:identifier>
        <linkRationale xml:lang="en">One analytic perspective</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
