        <rdfs:label xml:lang="en">League Table</rdfs:label>
        <skos:definition xml:lang="en">A table from a network meta-analysis displaying every treatment&apos;s estimated relative effect against every other treatment, organised for pairwise lookup.</skos:definition>
        <skos:prefLabel xml:lang="en">League Table</skos:prefLabel>
        <represents rdf:resource="https://healtheconomics.wiki/concept/treatment-effect"/>
