        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">CDx</skos:altLabel>
        <skos:definition xml:lang="en">A companion diagnostic (CDx) is a test that identifies patients a specific drug is likely to help or harm, so the drug and test are assessed together.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Companion Test</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Companion Diagnostic</skos:prefLabel>
        <abbreviation xml:lang="en">CDx</abbreviation>
