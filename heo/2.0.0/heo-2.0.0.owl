    <!-- https://healtheconomics.wiki/concept/budget-constraint -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/budget-constraint">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/resource-constraint"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/resource-constraint"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/constrained-optimisation"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/consumer-choice"/>
        <skos:notation>HE-EE-BIA-005</skos:notation>
        <dcterms:identifier>HE-EE-BIA-005</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Greenlaw et al. 2022</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Budget Constraint</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Budget constraint is the limit that a fixed budget and given costs place on what can be bought, so funding one health programme means forgoing another.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Fiscal Constraint</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Spending Limit</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Budget Constraint</skos:prefLabel>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-threshold"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/displacement"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/opportunity-cost"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/shadow-price-of-budget"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-6"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/budget-allocation"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/budget-constraint"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/resource-constraint"/>
        <dcterms:identifier>HEO-L-15a7e012fb1b</dcterms:identifier>
        <linkRationale xml:lang="en">Resource constraint covers budget, staff and facilities, so a budget constraint is the narrower kind.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/budget-constraint"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/constrained-optimisation"/>
        <dcterms:identifier>HEO-L-0bcbc4fa7c34</dcterms:identifier>
