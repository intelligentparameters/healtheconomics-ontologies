    <!-- https://healtheconomics.wiki/concept/decision-uncertainty -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/decision-uncertainty">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/value-of-information"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/value-of-information"/>
        <skos:notation>HE-EM-VI-005</skos:notation>
        <dcterms:identifier>HE-EM-VI-005</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</dcterms:modified>
        <dcterms:source>Fenwick et al. 2020</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Decision Uncertainty</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Decision uncertainty is the probability that the option preferred on current evidence is not the best, given uncertainty in costs and health effects.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Decision Risk</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Probability of Wrong Decision</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Decision Uncertainty</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/expected-loss"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/opportunity-loss"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/decision"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/decision-uncertainty"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/value-of-information"/>
