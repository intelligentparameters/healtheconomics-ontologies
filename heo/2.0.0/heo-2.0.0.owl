    <!-- https://healtheconomics.wiki/concept/stigma-barrier -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/stigma-barrier">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/access-barrier"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/access-barrier"/>
        <skos:notation>HS-HP-HE-031</skos:notation>
        <dcterms:identifier>HS-HP-HE-031</dcterms:identifier>
        <dcterms:source>Goffman 1963</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Stigma Barrier</rdfs:label>
        <skos:definition xml:lang="en">An obstacle to healthcare arising from fear of social judgement or discrimination, most commonly discussed for mental health or substance use.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Fear of Judgement</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Stigma-Related Barrier</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Stigma Barrier</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/treatment-gap"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/acceptability"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/stigma-barrier"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/access-barrier"/>
        <dcterms:identifier>HEO-L-4fd9bb9da7d8</dcterms:identifier>
        <linkRationale xml:lang="en">Stigma is an access barrier.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
