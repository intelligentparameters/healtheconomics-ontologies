    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/framing-concept -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/framing-concept">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cognitive-bias-concept"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cognitive-bias-concept"/>
        <skos:notation>HE-EE-BE-018</skos:notation>
        <dcterms:identifier>HE-EE-BE-018</dcterms:identifier>
        <dcterms:source>Tversky &amp; Kahneman 1981</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Framing Concept</rdfs:label>
        <skos:altLabel xml:lang="en">Framing Effect</skos:altLabel>
        <skos:definition xml:lang="en">The principle that decisions can be swayed by how choices are presented, such as gains versus losses, even when options are equivalent.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Presentation Bias</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Framing Concept</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/framing-concept"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cognitive-bias-concept"/>
        <dcterms:identifier>HEO-L-2a4667766c0b</dcterms:identifier>
        <linkRationale xml:lang="en">Framing is a cognitive bias</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/framing-intervention -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/framing-intervention">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/behaviour-change-technique"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/nudge-intervention"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/behaviour-change-technique"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/nudge-intervention"/>
        <skos:notation>HE-EE-BE-019</skos:notation>
        <dcterms:identifier>HE-EE-BE-019</dcterms:identifier>
        <dcterms:source>Tversky &amp; Kahneman 1981</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Framing Intervention</rdfs:label>
        <skos:definition xml:lang="en">The deliberate use of framing effects in intervention design, typically presenting information in terms of losses rather than gains, to influence decisions.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Loss-Gain Framing</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Message Framing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Framing Intervention</skos:prefLabel>
        <assumes rdf:resource="https://healtheconomics.wiki/concept/loss-aversion-concept"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/framing-concept"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/framing-intervention"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/behaviour-change-technique"/>
        <dcterms:identifier>HEO-L-c2f3101267f6</dcterms:identifier>
        <linkRationale xml:lang="en">Framing is a behaviour change technique</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/framing-intervention"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/nudge-intervention"/>
        <dcterms:identifier>HEO-L-e5a942124735</dcterms:identifier>
        <linkRationale xml:lang="en">Framing is a standard nudge; loss-framed messages rest on loss aversion</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
