    <!-- https://healtheconomics.wiki/concept/preference-weight -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/preference-weight">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-state-utility-value"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-state-utility-value"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/value-set"/>
        <skos:notation>HE-EE-HU-056</skos:notation>
        <dcterms:identifier>HE-EE-HU-056</dcterms:identifier>
        <dcterms:source>Brazier et al. 2007</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Preference Weight</rdfs:label>
        <skos:definition xml:lang="en">A numerical value reflecting the relative desirability a population or individual assigns to a particular health state or outcome.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Preference Coefficient</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Valuation Weight</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Preference Weight</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/outcomes#step-2"/>
