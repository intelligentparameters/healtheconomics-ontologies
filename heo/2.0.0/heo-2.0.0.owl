    <!-- https://healtheconomics.wiki/concept/qaly-calculation-method -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/qaly-calculation-method">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/cost-utility-analysis"/>
        <skos:notation>HE-EE-QALY-006</skos:notation>
        <dcterms:identifier>HE-EE-QALY-006</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Weinstein &amp; Stason 1977</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">QALY Calculation Method</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">The process of computing quality-adjusted life years by multiplying time spent in a health state by its utility value, then summing across states.</skos:definition>
        <skos:hiddenLabel xml:lang="en">QALY Derivation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">QALY Estimation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">QALY Calculation Method</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/outcomes#step-3"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/qaly"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/health-state-utility-value"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/trapezoidal-rule"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/qaly-calculation-method"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-8692a78fbb4c</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic QALYs, DALYs and summary measures in subdomain Outcomes</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/qaly-calculation-method"/>
