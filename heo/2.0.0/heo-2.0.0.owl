    <!-- https://healtheconomics.wiki/concept/market-structure -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/market-structure">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
