        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/customary-charge"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/relative-value-unit"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/resource-based-relative-value"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
