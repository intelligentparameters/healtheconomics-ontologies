        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Default Intervention</rdfs:label>
        <skos:definition xml:lang="en">A policy tool establishing a pre-selected option that applies automatically unless an individual opts out.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Default Option Policy</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Opt-Out Default</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Default Intervention</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
