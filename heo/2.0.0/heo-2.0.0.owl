        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/welfare-economics"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/net-benefit"/>
        <skos:notation>HE-EE-WE-008</skos:notation>
        <dcterms:identifier>HE-EE-WE-008</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Hicks 1939</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Equivalent Variation</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Equivalent variation (EV) is the income change, made instead of a price, health or policy change, that leaves a person as well off as that change would.</skos:definition>
        <skos:hiddenLabel xml:lang="en">EV</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Equivalent Variation</skos:prefLabel>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
