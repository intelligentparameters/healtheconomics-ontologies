        <skos:altLabel xml:lang="en">Healthcare Spending</skos:altLabel>
        <skos:definition xml:lang="en">The total resources devoted to healthcare goods and services within a defined population and period, from all funding sources.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Total Health Outlay</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Health Spending</skos:prefLabel>
