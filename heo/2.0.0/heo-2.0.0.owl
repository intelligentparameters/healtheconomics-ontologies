    <!-- https://healtheconomics.wiki/concept/informed-consent-for-research -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/informed-consent-for-research">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/informed-consent"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/informed-consent"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/human-subjects-protection"/>
        <skos:notation>HS-HP-HSG-017</skos:notation>
        <dcterms:identifier>HS-HP-HSG-017</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-24</dcterms:modified>
        <dcterms:source>Faden &amp; Beauchamp 1986</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Informed Consent for Research</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A voluntary, informed and ongoing agreement to participate in specified research after an understandable explanation and opportunity to decide freely.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Research Participation Consent</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Study Consent Process</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Informed Consent for Research</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/therapeutic-misconception"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/informed-consent-for-research"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/informed-consent"/>
        <dcterms:identifier>HEO-L-0c2cf5a21499</dcterms:identifier>
        <linkRationale xml:lang="en">relatedTo retired; consent to research participation is one form of informed consent</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
