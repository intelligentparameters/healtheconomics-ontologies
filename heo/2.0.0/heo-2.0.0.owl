    <!-- https://healtheconomics.wiki/concept/time-preference -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/time-preference">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/discounting"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q186412"/>
