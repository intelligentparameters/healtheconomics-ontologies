        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/subgroup-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/subgroup-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/heterogeneity-analysis"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q7631152"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/heterogeneity-analysis"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/heterogeneous-treatment-effect"/>
        <skos:notation>HE-EM-MP-040</skos:notation>
        <dcterms:identifier>HE-EM-MP-040</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Briggs A, Claxton K, Sculpher M. Decision Modelling for Health Economic Evaluation. Oxford University Press; 2006. doi:10.1093/oso/9780198526629.001.0001.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Subgroup Analysis</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">An analysis that estimates and compares an association or intervention effect across defined categories of participants, with treatment-effect differences assessed through an interaction on a specified scale.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Subgroup Assessment</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Subpopulation Analysis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Subgroup Analysis</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-4"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/subgroup-cost-effectiveness"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/patient-level-covariate"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/subgroup-analysis"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/heterogeneity-analysis"/>
        <dcterms:identifier>HEO-L-403acb6121f1</dcterms:identifier>
        <linkRationale xml:lang="en">Subgroup analysis examines how results vary across subgroups, a heterogeneity analysis.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/subgroup-analysis"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/heterogeneous-treatment-effect"/>
        <dcterms:identifier>HEO-L-03f4c9a67348</dcterms:identifier>
        <linkRationale xml:lang="en">second check: Circular removal; HEO-L-58ca708625d0 removes the synonym Treatment Effect Heterogeneity citing this link, leaving subgroup analysis with no heterogeneity link</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/subgroup-analysis"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#produces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/subgroup-cost-effectiveness"/>
        <dcterms:identifier>HEO-L-ad048bcbd302</dcterms:identifier>
        <linkRationale xml:lang="en">Running the economic analysis by subgroup yields subgroup ICERs.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/subgroup-analysis"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/patient-level-covariate"/>
        <dcterms:identifier>HEO-L-d37e79917140</dcterms:identifier>
