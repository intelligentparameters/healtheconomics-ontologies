        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">RVU</skos:altLabel>
        <skos:definition xml:lang="en">A relative value unit is a standardized weight assigned to a covered service component to represent its relative resource use within the US Medicare Physician Fee Schedule.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Service Value Unit</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Relative Value Unit</skos:prefLabel>
        <abbreviation xml:lang="en">RVU</abbreviation>
