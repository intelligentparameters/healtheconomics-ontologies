    <!-- https://healtheconomics.wiki/concept/cholesky-decomposition -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cholesky-decomposition">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
