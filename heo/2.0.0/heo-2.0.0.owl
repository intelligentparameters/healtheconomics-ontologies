    <!-- https://healtheconomics.wiki/concept/active-choice -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/active-choice">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/choice-architecture-intervention"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/choice-architecture-intervention"/>
        <skos:notation>HE-EE-BE-042</skos:notation>
        <dcterms:identifier>HE-EE-BE-042</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-03</dcterms:modified>
        <dcterms:source>Keller et al. 2011</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Active Choice</rdfs:label>
        <owl:versionInfo>1.0.3</owl:versionInfo>
        <skos:definition xml:lang="en">Active choice is a choice architecture design that asks people to state a decision, such as on organ donation or vaccination, instead of setting a default.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Forced Choice</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Mandated Choice</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Active Choice</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/default-intervention"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/active-choice"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/choice-architecture-intervention"/>
        <dcterms:identifier>HEO-L-230b42c63d2a</dcterms:identifier>
        <linkRationale xml:lang="en">Active choice changes how options are presented, a choice architecture design</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/active-choice"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/default-intervention"/>
        <dcterms:identifier>HEO-L-5a888f493309</dcterms:identifier>
        <linkRationale xml:lang="en">Asking for a stated decision versus presetting an opt-out option (subject definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
