    <!-- https://healtheconomics.wiki/concept/net-promoter-score -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/net-promoter-score">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1839591"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/patient-satisfaction"/>
        <skos:notation>HS-HP-HQ-026</skos:notation>
        <dcterms:identifier>HS-HP-HQ-026</dcterms:identifier>
        <dcterms:source>Reichheld 2003</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Net Promoter Score</rdfs:label>
        <skos:altLabel xml:lang="en">NPS</skos:altLabel>
        <skos:definition xml:lang="en">A customer loyalty metric based on likelihood to recommend, adapted in healthcare to measure patient satisfaction and provider recommendation likelihood.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Patient Recommendation Score</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Net Promoter Score</skos:prefLabel>
        <abbreviation xml:lang="en">NPS</abbreviation>
