    <!-- https://healtheconomics.wiki/concept/healthy-life-expectancy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/healthy-life-expectancy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
