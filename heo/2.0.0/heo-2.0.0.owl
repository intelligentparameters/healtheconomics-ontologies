        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-692e7c887f39</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Evidence Synthesis Methods: catalogue subdomain Evidence Synthesis is one of the subdomains</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/transitivity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isFoundationFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/consistency"/>
        <dcterms:identifier>HEO-L-1a14aecb901d</dcterms:identifier>
        <linkRationale xml:lang="en">Transitivity is the assumption on which consistency of direct and indirect evidence rests (Dias et al. 2018).</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/transmission-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/transmission-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/dynamic-model"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/simulation-model"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/dynamic-model"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/simulation-model"/>
        <skos:notation>HE-EM-DM-105</skos:notation>
        <dcterms:identifier>HE-EM-DM-105</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-10-06</dcterms:modified>
        <dcterms:source>Kermack &amp; McKendrick 1927</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Transmission Model</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A model explicitly representing how an infectious disease spreads through a population by tracking interaction between infectious and susceptible individuals.</skos:definition>
        <skos:prefLabel xml:lang="en">Transmission Model</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-8"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/compartmental-model"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/generation-time"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/incubation-period"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/latent-period"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/transmission-probability"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/transmission-model"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/dynamic-model"/>
        <dcterms:identifier>HEO-L-18535070ac21</dcterms:identifier>
        <linkRationale xml:lang="en">Transmission models track changing interaction between infectious and susceptible people, a dynamic model.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/transmission-model"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
