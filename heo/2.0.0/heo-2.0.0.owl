        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Lifetime Horizon</rdfs:label>
        <skos:altLabel xml:lang="en">Lifetime Time Horizon</skos:altLabel>
        <skos:definition xml:lang="en">A time horizon for an economic evaluation extending over the remaining expected lifespan of the population studied, rather than a shorter follow-up period.</skos:definition>
