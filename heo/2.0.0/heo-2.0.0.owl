        <rdfs:label xml:lang="en">Health Profile</rdfs:label>
        <skos:definition xml:lang="en">A set of scores across multiple distinct health dimensions reported separately for a person or population, rather than combined into one index.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Dimensional Health Score</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Multi-Dimensional Health Measure</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Health Profile</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
