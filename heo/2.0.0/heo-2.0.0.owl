    <!-- https://healtheconomics.wiki/concept/output-based-financing -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/output-based-financing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/results-based-financing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/results-based-financing"/>
        <skos:notation>HS-HP-HF-049</skos:notation>
        <dcterms:identifier>HS-HP-HF-049</dcterms:identifier>
        <dcterms:source>WHO, Health Financing for Universal Coverage</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Output-Based Financing</rdfs:label>
        <skos:definition xml:lang="en">A financing approach tying payments to providers or programmes to the volume or type of services delivered, rather than a fixed budget.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Output-Linked Financing</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Volume-Based Financing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Output-Based Financing</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/performance-based-financing"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/output-based-financing"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/results-based-financing"/>
        <dcterms:identifier>HEO-L-72a948a77390</dcterms:identifier>
        <linkRationale xml:lang="en">Output-based payments for delivered services are a form of results-based financing</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/output-based-financing"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/performance-based-financing"/>
        <dcterms:identifier>HEO-L-9a8107f9e42d</dcterms:identifier>
        <linkRationale xml:lang="en">Output-based pays for volume delivered, performance-based for targets achieved</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/output-interface -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/output-interface">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
