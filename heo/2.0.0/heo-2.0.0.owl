    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/downcoding -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/downcoding">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-HP-HSR-028</skos:notation>
        <dcterms:identifier>HS-HP-HSR-028</dcterms:identifier>
        <dcterms:source>AHIMA, Clinical Documentation Improvement guidance</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Downcoding</rdfs:label>
        <skos:altLabel xml:lang="en">Under-Coding</skos:altLabel>
        <skos:definition xml:lang="en">The practice of assigning a lower-level, less specific code than the clinical documentation actually supports, whether from error or ambiguity.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Low-Level Code Assignment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Downcoding</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/upcoding"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/drg-assignment"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/downcoding"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-66558717da74</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health System Regulation: compliance, audit and accreditation govern how providers work (Organisation and governance)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/downcoding"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/upcoding"/>
        <dcterms:identifier>HEO-L-e7949c6e179e</dcterms:identifier>
        <linkRationale xml:lang="en">under- versus over-coding are opposites</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/downcoding"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#threatensValidityOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drg-assignment"/>
        <dcterms:identifier>HEO-L-5c8afbf9bb14</dcterms:identifier>
        <linkRationale xml:lang="en">under-coding misassigns stays to lower DRGs</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/downside-risk -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/downside-risk">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <skos:notation>HS-HP-PP-042</skos:notation>
        <dcterms:identifier>HS-HP-PP-042</dcterms:identifier>
        <dcterms:source>Carlson JJ, Sullivan SD, Garrison LP, Neumann PJ, Veenstra DL. Linking payment to health outcomes: a taxonomy and examination of performance-based reimbursement schemes. Health Policy. 2010;96(3):179-190.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Downside Risk</rdfs:label>
        <skos:definition xml:lang="en">A feature of a value-based arrangement in which a provider is financially responsible for spending exceeding a benchmark, unlike an upside-only arrangement.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Financial Downside</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Two-Sided Risk</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Downside Risk</skos:prefLabel>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/risk-sharing"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/value-based-payment"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/downside-risk"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-372c8c340d68</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Provider Payment: wiki topic Provider payment sits in Health Systems; placed under Provider Payment, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/downside-risk"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isPropertyOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/risk-sharing"/>
        <dcterms:identifier>HEO-L-9f6aa76d5c4f</dcterms:identifier>
        <linkRationale xml:lang="en">downside risk is a feature of a risk-sharing arrangement, per its definition, not an arrangement itself</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/downside-risk"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isPropertyOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/value-based-payment"/>
        <dcterms:identifier>HEO-L-6c6606a11bb2</dcterms:identifier>
        <linkRationale xml:lang="en">Two-sided risk is a feature of value-based arrangements; stop-loss caps the provider exposure.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/draft-recommendation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/draft-recommendation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/recommendation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/recommendation"/>
        <precedes rdf:resource="https://healtheconomics.wiki/concept/guidance-publication"/>
