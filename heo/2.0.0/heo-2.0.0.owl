    <!-- https://healtheconomics.wiki/concept/conflict-of-interest -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/conflict-of-interest">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <riskFactorFor rdf:resource="https://healtheconomics.wiki/concept/bias"/>
        <skos:notation>HS-HP-HSG-034</skos:notation>
        <dcterms:identifier>HS-HP-HSG-034</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</dcterms:modified>
        <dcterms:source>Institute of Medicine 2009</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Conflict of Interest</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">Conflict of interest is a situation where a secondary interest, such as a manufacturer&apos;s payment, risks unduly swaying judgement in research, care or HTA.</skos:definition>
        <skos:prefLabel xml:lang="en">Conflict of Interest</skos:prefLabel>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/conflict-of-interest"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
