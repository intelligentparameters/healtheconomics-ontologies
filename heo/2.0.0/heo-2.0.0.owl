        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/failure-to-rescue"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/mortality-measure"/>
        <dcterms:identifier>HEO-L-127c9566c37f</dcterms:identifier>
        <linkRationale xml:lang="en">Death after a complication is a mortality measure</linkRationale>
