    <!-- https://healtheconomics.wiki/concept/pearson-correlation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/pearson-correlation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/correlation-coefficient"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/correlation-coefficient"/>
        <skos:notation>HE-ES-SA-155</skos:notation>
        <dcterms:identifier>HE-ES-SA-155</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Pearson 1896</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Pearson Correlation</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Linear Correlation Coefficient</skos:altLabel>
        <skos:altLabel xml:lang="en">Pearson Product-Moment</skos:altLabel>
        <skos:definition xml:lang="en">A measure quantifying the strength and direction of the linear relationship between two continuous variables, ranging from negative one to positive one.</skos:definition>
        <skos:prefLabel xml:lang="en">Pearson Correlation</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/spearman-correlation"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/pearson-correlation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/correlation-coefficient"/>
        <dcterms:identifier>HEO-L-a8e755aabf7e</dcterms:identifier>
