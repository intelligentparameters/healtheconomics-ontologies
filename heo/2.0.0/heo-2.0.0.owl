        <skos:notation>PP-PP-PR-001</skos:notation>
        <dcterms:identifier>PP-PP-PR-001</dcterms:identifier>
        <dcterms:source>FDA, Code of Federal Regulations Title 21</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Black Box Warning</rdfs:label>
        <skos:altLabel xml:lang="en">Boxed Warning</skos:altLabel>
        <skos:altLabel xml:lang="en">FDA Boxed Warning</skos:altLabel>
        <skos:definition xml:lang="en">The most serious US drug warning type, displayed prominently in a bordered box on prescribing information, highlighting significant serious risk.</skos:definition>
        <skos:prefLabel xml:lang="en">Black Box Warning</skos:prefLabel>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/patient-safety"/>
