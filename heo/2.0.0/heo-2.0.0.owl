    <!-- https://healtheconomics.wiki/concept/secondary-attack-rate -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/secondary-attack-rate">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/attack-rate"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q137603985"/>
