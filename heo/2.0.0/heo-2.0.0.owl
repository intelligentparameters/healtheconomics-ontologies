    <!-- https://healtheconomics.wiki/concept/curative-model-uncertainty -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/curative-model-uncertainty">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/structural-uncertainty"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/structural-uncertainty"/>
        <skos:notation>HE-PE-AT-004</skos:notation>
        <dcterms:identifier>HE-PE-AT-004</dcterms:identifier>
        <dcterms:source>Jørgensen &amp; Kefalas 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Curative Model Uncertainty</rdfs:label>
        <skos:definition xml:lang="en">The uncertainty surrounding a model&apos;s assumption about how long a one-time treatment&apos;s curative effect will last, given trial follow-up far shorter than the modelled lifetime.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Curative-Effect Uncertainty</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Cure-Duration Uncertainty</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Curative Model Uncertainty</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/curative-model-uncertainty"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/structural-uncertainty"/>
        <dcterms:identifier>HEO-L-e75410113ff6</dcterms:identifier>
        <linkRationale xml:lang="en">Duration of cure is a modelling assumption about extrapolation structure</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/curative-therapy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/curative-therapy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
