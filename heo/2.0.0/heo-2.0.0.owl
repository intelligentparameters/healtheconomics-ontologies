    <!-- https://healtheconomics.wiki/concept/productivity-cost -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/productivity-cost">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/indirect-cost"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/indirect-cost"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/societal-cost"/>
        <skos:notation>HS-DC-HC-015</skos:notation>
        <dcterms:identifier>HS-DC-HC-015</dcterms:identifier>
        <dcterms:source>Rice 1966</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Productivity Cost</rdfs:label>
        <skos:definition xml:lang="en">The economic value of lost work output from illness or death, estimated using the human capital or friction cost approach.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Foregone-Output Cost</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Indirect Work Loss</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Productivity Cost</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/productivity-cost"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/indirect-cost"/>
        <dcterms:identifier>HEO-L-56b7faa6a13a</dcterms:identifier>
        <linkRationale xml:lang="en">Productivity cost is the standard example of indirect cost per the object definition.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/productivity-cost"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
