        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/regressive-financing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/regressive-financing"/>
        <skos:notation>HE-EE-EP-030</skos:notation>
        <dcterms:identifier>HE-EE-EP-030</dcterms:identifier>
        <dcterms:source>Musgrave &amp; Musgrave 1989</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Regressive Taxation</rdfs:label>
        <skos:altLabel xml:lang="en">Regressive Tax</skos:altLabel>
        <skos:definition xml:lang="en">A tax structure in which the rate falls as the taxable amount rises, so lower earners pay a larger share of income than higher earners.</skos:definition>
        <skos:prefLabel xml:lang="en">Regressive Taxation</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/progressive-taxation"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/regressive-taxation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/regressive-financing"/>
        <dcterms:identifier>HEO-L-b3dd175f9ef0</dcterms:identifier>
        <linkRationale xml:lang="en">A regressive tax is a financing arrangement whose contributions fall as a share of income.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/regressive-taxation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/progressive-taxation"/>
        <dcterms:identifier>HEO-L-691ec23ae979</dcterms:identifier>
        <linkRationale xml:lang="en">Regressive and progressive taxation are opposite rate structures by income.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/regulated-pricing -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/regulated-pricing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:notation>HS-DC-DP-089</skos:notation>
        <dcterms:identifier>HS-DC-DP-089</dcterms:identifier>
        <dcterms:source>Danzon 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Regulated Pricing</rdfs:label>
        <skos:definition xml:lang="en">A pricing environment where government directly sets, negotiates, or constrains manufacturer prices, unlike a free pricing environment without direct control.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Administered Pricing Environment</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Controlled Pricing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Regulated Pricing</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/external-reference-pricing"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/price-control"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/regulated-pricing"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <dcterms:identifier>HEO-L-4d9f9830ef64</dcterms:identifier>
        <linkRationale xml:lang="en">Regulated pricing is a government-controlled way of setting medicine prices.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/regulated-pricing"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/external-reference-pricing"/>
        <dcterms:identifier>HEO-L-52a22d69fef9</dcterms:identifier>
        <linkRationale xml:lang="en">Regulated pricing systems commonly benchmark domestic prices on other countries via external reference pricing.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/regulated-pricing"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/price-control"/>
        <dcterms:identifier>HEO-L-9b6d4214278c</dcterms:identifier>
