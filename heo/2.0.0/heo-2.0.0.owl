    <!-- https://healtheconomics.wiki/concept/drug-drug-interaction -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/drug-drug-interaction">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-interaction"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/drug-interaction"/>
        <skos:notation>PP-PC-MS-006</skos:notation>
        <dcterms:identifier>PP-PC-MS-006</dcterms:identifier>
        <dcterms:source>Rowland &amp; Tozer 2010</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Drug-Drug Interaction</rdfs:label>
        <skos:altLabel xml:lang="en">DDI</skos:altLabel>
        <skos:definition xml:lang="en">An alteration in a drug&apos;s effect caused by another medication present at the same time, increasing or decreasing effect or adverse risk.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Medication Interaction</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Drug-Drug Interaction</skos:prefLabel>
        <abbreviation xml:lang="en">DDI</abbreviation>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/adverse-event"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/drug-drug-interaction"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-interaction"/>
        <dcterms:identifier>HEO-L-8cc35a47bc69</dcterms:identifier>
        <linkRationale xml:lang="en">a drug-drug interaction is a drug interaction</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/drug-drug-interaction"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/adverse-event"/>
        <dcterms:identifier>HEO-L-87161ef90fa5</dcterms:identifier>
        <linkRationale xml:lang="en">interactions cause adverse events</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/drug-evaluation-committee -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/drug-evaluation-committee">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
