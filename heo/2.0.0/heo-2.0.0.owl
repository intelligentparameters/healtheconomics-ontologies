    <!-- https://healtheconomics.wiki/concept/radical-innovation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/radical-innovation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/innovation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/innovation"/>
        <skos:notation>HE-PE-TI-027</skos:notation>
        <dcterms:identifier>HE-PE-TI-027</dcterms:identifier>
        <dcterms:source>Christensen, Raynor &amp; McDonald 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Radical Innovation</rdfs:label>
        <skos:altLabel xml:lang="en">Step Change</skos:altLabel>
        <skos:definition xml:lang="en">An innovation introducing a fundamentally new approach or capability, a significant departure from existing solutions rather than an incremental improvement.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Breakthrough</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Breakthrough Innovation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Discontinuous Improvement</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Disruptive Breakthrough</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Radical Innovation</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/radical-innovation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/innovation"/>
        <dcterms:identifier>HEO-L-dc8c05e674b4</dcterms:identifier>
        <linkRationale xml:lang="en">Radical innovation is innovation.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


