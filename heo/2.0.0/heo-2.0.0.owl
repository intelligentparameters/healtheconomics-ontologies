        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/response-error"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/measurement-error"/>
        <dcterms:identifier>HEO-L-27c4413c0024</dcterms:identifier>
        <linkRationale xml:lang="en">A wrong recorded answer is a discrepancy between recorded and true value.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
