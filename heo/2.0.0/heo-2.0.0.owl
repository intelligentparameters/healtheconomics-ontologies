        <skos:prefLabel xml:lang="en">Semi-Fixed Cost</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/semi-variable-cost"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/variable-cost"/>
