    <!-- https://healtheconomics.wiki/concept/digital-interoperability -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/digital-interoperability">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/interoperability"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/interoperability"/>
        <skos:notation>HS-SS_DH-021</skos:notation>
        <dcterms:identifier>HS-SS_DH-021</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</dcterms:modified>
        <dcterms:source>HIMSS 2025</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Digital Interoperability</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:definition xml:lang="en">Digital interoperability is the ability of different digital health systems to exchange data and use it with a shared meaning, without manual re-entry.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Health Data Interoperability</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">System Interoperability</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Digital Interoperability</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/care-coordination"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/interoperability-savings"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/interoperability-standards"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/digital-interoperability"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/interoperability"/>
        <dcterms:identifier>HEO-L-abf73e7df703</dcterms:identifier>
        <linkRationale xml:lang="en">digital interoperability is interoperability between digital health systems</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
