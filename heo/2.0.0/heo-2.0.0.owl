    <!-- https://healtheconomics.wiki/concept/mild-cognitive-impairment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/mild-cognitive-impairment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cognitive-decline"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cognitive-decline"/>
        <precedes rdf:resource="https://healtheconomics.wiki/concept/alzheimer-disease"/>
        <skos:notation>HE-PE-NR-010</skos:notation>
        <dcterms:identifier>HE-PE-NR-010</dcterms:identifier>
        <dcterms:source>Petersen 2004</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Mild Cognitive Impairment</rdfs:label>
        <skos:altLabel xml:lang="en">MCI</skos:altLabel>
        <skos:definition xml:lang="en">A clinical state involving noticeable cognitive decline beyond what is expected for age, but not severe enough to significantly impair daily independent functioning.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Pre-Dementia Impairment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Mild Cognitive Impairment</skos:prefLabel>
        <abbreviation xml:lang="en">MCI</abbreviation>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/mild-cognitive-impairment"/>
