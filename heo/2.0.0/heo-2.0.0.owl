    <!-- https://healtheconomics.wiki/concept/agency-relationship -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/agency-relationship">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <skos:notation>HE-EE-ME-003</skos:notation>
        <dcterms:identifier>HE-EE-ME-003</dcterms:identifier>
        <dcterms:source>Jensen &amp; Meckling 1976</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Principal-Agent Relationship</rdfs:label>
        <skos:altLabel xml:lang="en">Agency Relationship</skos:altLabel>
        <skos:definition xml:lang="en">An arrangement in which one party, the agent, acts on behalf of another, the principal, whose interests may diverge due to differing incentives or information.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Agency Arrangement</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Principal-Agent Relationship</skos:prefLabel>
        <assumes rdf:resource="https://healtheconomics.wiki/concept/information-asymmetry"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/contract-theory"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/mechanism-design"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/principal-agent-problem"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/supplier-induced-demand"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/agency-relationship"/>
