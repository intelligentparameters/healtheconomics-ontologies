    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/black-box-warning"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#promotes"/>
