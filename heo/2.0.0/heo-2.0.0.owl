    <!-- https://healtheconomics.wiki/concept/access-barrier -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/access-barrier">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:notation>HS-HP-HE-002</skos:notation>
        <dcterms:identifier>HS-HP-HE-002</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Penchansky R, Thomas JW. The concept of access: definition and relationship to consumer satisfaction. Medical Care. 1981;19(2):127?140. doi:10.1097/00005650-198102000-00001.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Access Barrier</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Barrier to Access</skos:altLabel>
        <skos:altLabel xml:lang="en">Barrier to Health Care Access</skos:altLabel>
        <skos:altLabel xml:lang="en">Barrier to Healthcare Access</skos:altLabel>
        <skos:definition xml:lang="en">An access barrier is any obstacle, such as cost, distance, waiting lists or discrimination, that prevents or delays a person obtaining needed healthcare.</skos:definition>
        <skos:prefLabel xml:lang="en">Access Barrier</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/health-inequality"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/unmet-need"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-policy#step-4"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/access-to-care"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/accessibility"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/treatment-access"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
