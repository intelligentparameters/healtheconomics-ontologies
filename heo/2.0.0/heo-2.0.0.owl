    <!-- https://healtheconomics.wiki/concept/excess-hazard -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/excess-hazard">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/excess-mortality"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/relative-survival"/>
        <skos:notation>HE-EM-SM-017</skos:notation>
        <dcterms:identifier>HE-EM-SM-017</dcterms:identifier>
        <dcterms:source>Latimer 2013</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Excess Hazard</rdfs:label>
        <skos:definition xml:lang="en">The additional death risk attributable specifically to the disease studied, the difference between total observed hazard and the background hazard in a comparable population.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Disease-Specific Hazard</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Net Hazard</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Excess Hazard</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-5"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/excess-hazard"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-45dae97a65d8</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Survival analysis and extrapolation in subdomain Economic Modelling</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/excess-hazard"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/excess-mortality"/>
        <dcterms:identifier>HEO-L-2d195b6f480d</dcterms:identifier>
        <linkRationale xml:lang="en">Excess hazard is the hazard-scale metric of excess mortality (both definitions); generic link retired</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/excess-hazard"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/relative-survival"/>
        <dcterms:identifier>HEO-L-9f64db3f93c5</dcterms:identifier>
        <linkRationale xml:lang="en">Relative survival equals the exponential of minus the cumulative excess hazard (Dickman et al. 2004)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/excess-mortality -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/excess-mortality">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/mortality"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q98840270"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/mortality"/>
        <skos:notation>HE-EM-MP-013</skos:notation>
        <dcterms:identifier>HE-EM-MP-013</dcterms:identifier>
        <dcterms:source>Chiang 1984</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Excess Mortality</rdfs:label>
        <skos:altLabel xml:lang="en">Attributable Mortality</skos:altLabel>
        <skos:definition xml:lang="en">The additional death risk attributable to a specific condition, the difference between an affected population&apos;s observed mortality and that of a comparable unaffected group.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Excess Deaths</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Excess Mortality</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/excess-mortality"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/mortality"/>
        <dcterms:identifier>HEO-L-9c1917617f4d</dcterms:identifier>
        <linkRationale xml:lang="en">Only link; excess mortality is the part of mortality attributable to the condition, a kind of mortality; generic link retired</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


