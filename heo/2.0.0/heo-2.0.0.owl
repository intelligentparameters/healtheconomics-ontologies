        <skos:altLabel xml:lang="en">Health Service Planning</skos:altLabel>
        <skos:altLabel xml:lang="en">Health System Planning</skos:altLabel>
        <skos:definition xml:lang="en">The process of assessing a population&apos;s healthcare needs and planning health system infrastructure, workforce, and services development to meet them.</skos:definition>
        <skos:prefLabel xml:lang="en">Health Planning</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
