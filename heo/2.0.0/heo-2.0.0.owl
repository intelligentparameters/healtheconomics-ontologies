    <!-- https://healtheconomics.wiki/concept/ethical-review -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/ethical-review">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/human-subjects-protection"/>
        <skos:notation>HS-HP-HTA-079</skos:notation>
        <dcterms:identifier>HS-HP-HTA-079</dcterms:identifier>
        <dcterms:source>National Commission, Belmont Report 1979</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Ethical Review</rdfs:label>
        <skos:altLabel xml:lang="en">Ethics Review</skos:altLabel>
        <skos:definition xml:lang="en">A formal evaluation of the ethical acceptability of a proposed research study or health policy, conducted by a dedicated committee.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Ethical Appraisal</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Ethical Review</skos:prefLabel>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/informed-consent"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
