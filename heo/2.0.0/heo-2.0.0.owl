    <!-- https://healtheconomics.wiki/concept/exposure -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/exposure">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/epidemiology"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/epidemiology"/>
        <precedes rdf:resource="https://healtheconomics.wiki/concept/health-outcome"/>
        <skos:notation>HE-ES-EP-015</skos:notation>
        <dcterms:identifier>HE-ES-EP-015</dcterms:identifier>
        <dcterms:source>Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams &amp; Wilkins; 2008.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Exposure</rdfs:label>
        <skos:definition xml:lang="en">A factor, such as a behaviour, treatment, or environmental agent, whose relationship to a health outcome is being studied.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Risk Determinant</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Study Factor</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Exposure</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/exposure"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/epidemiology"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-36328323c3ca</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Epidemiology: catalogue subdomain Evidence Synthesis is one of the subdomains; placed under Epidemiology, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/exposure"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#precedes"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-outcome"/>
        <dcterms:identifier>HEO-L-384dbe142b19</dcterms:identifier>
