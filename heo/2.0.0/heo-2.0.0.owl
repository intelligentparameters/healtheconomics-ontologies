    <!-- https://healtheconomics.wiki/concept/structured-expert-judgment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/structured-expert-judgment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
