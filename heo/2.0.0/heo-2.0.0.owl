        <dcterms:identifier>HE-ES-EA-051</dcterms:identifier>
        <dcterms:source>Mokkink et al. 2010</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Structural Validity (Measurement Instrument)</rdfs:label>
        <skos:definition xml:lang="en">Structural validity of a measurement instrument is how far a health questionnaire&apos;s scores reflect the dimensions of the construct it is meant to measure.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Dimensional Validity</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Factorial Validity</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Internal Structure Validity</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Structural Validity (Measurement Instrument)</skos:prefLabel>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/prom"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
