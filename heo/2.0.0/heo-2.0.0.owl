    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/non-preferred-tier">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/formulary"/>
        <skos:notation>HS-HP-HI-125</skos:notation>
        <dcterms:identifier>HS-HP-HI-125</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Non-Preferred Tier</rdfs:label>
        <skos:definition xml:lang="en">A formulary or network category with the highest cost-sharing in a tiered design, applied to options an insurer wishes to discourage.</skos:definition>
        <skos:hiddenLabel xml:lang="en">High Cost-Share Tier</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Non-Formulary Tier</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Non-Preferred Tier</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/preferred-tier"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/cost-sharing"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/non-preferred-tier"/>
