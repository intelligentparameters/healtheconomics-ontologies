        <skos:notation>CS-LA-MO-002</skos:notation>
        <dcterms:identifier>CS-LA-MO-002</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-24</dcterms:modified>
        <dcterms:source>Golub GH, Van Loan CF. Matrix Computations. 4th ed. Johns Hopkins University Press; 2013.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Matrix Multiplication</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Matrix Product</skos:altLabel>
        <skos:definition xml:lang="en">Matrix multiplication combines two organised sets of quantities so that the rows of the first matrix are matched with the columns of the second.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Matrix Dot Product</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Matrix Multiplication</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-12"/>
        <prerequisiteFor rdf:resource="https://healtheconomics.wiki/concept/matrix-inversion"/>
        <prerequisiteFor rdf:resource="https://healtheconomics.wiki/concept/transition-matrix"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/matrix-multiplication"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/matrix-algebra"/>
        <dcterms:identifier>HEO-L-3f5f81be4a21</dcterms:identifier>
        <linkRationale xml:lang="en">Multiplication is a matrix algebra operation</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
