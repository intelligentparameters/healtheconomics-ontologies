    <!-- https://healtheconomics.wiki/concept/multi-attribute-utility -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/multi-attribute-utility">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
