    <!-- https://healtheconomics.wiki/concept/evidence-synthesis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/evidence-synthesis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-economics"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-economics"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/evidence-assessment"/>
        <skos:notation>HS-HP-HTA-083</skos:notation>
        <dcterms:identifier>HS-HP-HTA-083</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Dias et al. 2013</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Evidence Synthesis</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/subdomain/evidence-synthesis"/>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Research Synthesis</skos:altLabel>
        <skos:definition xml:lang="en">The structured integration and appraisal of findings from multiple studies to answer a defined question while accounting for comparability, bias and uncertainty.</skos:definition>
        <skos:editorialNote xml:lang="en">In HEO this concept is the wiki subdomain Evidence Synthesis, directly under Health Economics. Concepts in that subdomain with no is-type-of parent are classified under it or under a concept within it.</skos:editorialNote>
        <skos:hiddenLabel xml:lang="en">Evidence Combination</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Evidence Synthesis</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-technology-assessment#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/evidence-base"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-economics"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-3881c06ece7b</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: the wiki subdomain Evidence Synthesis (https://healtheconomics.wiki/subdomain/evidence-synthesis)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-assessment"/>
        <dcterms:identifier>HEO-L-f85c49cf06f8</dcterms:identifier>
        <linkRationale xml:lang="en">Synthesis is a stage of evidence assessment (object definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
