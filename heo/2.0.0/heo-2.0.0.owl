    <!-- https://healtheconomics.wiki/concept/mental-health-service-coverage -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/mental-health-service-coverage">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-system-performance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-system-performance"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/access-to-care"/>
        <skos:notation>HS-SS_HSP-040</skos:notation>
        <dcterms:identifier>HS-SS_HSP-040</dcterms:identifier>
        <dcterms:source>WHO, UHC Service Coverage Index</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Mental Health Service Coverage</rdfs:label>
        <skos:definition xml:lang="en">A measure of the extent to which a population has access to needed mental health diagnosis and treatment services.</skos:definition>
