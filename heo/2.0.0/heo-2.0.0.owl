        <skos:hiddenLabel xml:lang="en">Semiparametric Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Semi-Parametric Analysis</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/non-parametric-methods"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/parametric-methods"/>
