        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/out-of-pocket-payment"/>
        <dcterms:identifier>HEO-L-fc6037d572b2</dcterms:identifier>
