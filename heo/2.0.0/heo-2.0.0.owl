    <!-- https://healtheconomics.wiki/concept/asymptotic-normality -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/asymptotic-normality">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:notation>HE-ES-SA-007</skos:notation>
        <dcterms:identifier>HE-ES-SA-007</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Fisher 1922</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Asymptotic Normality</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Asymptotic normality means an estimator&apos;s sampling distribution is approximately normal in large samples, the basis of Wald confidence intervals.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Asymptotic Gaussianity</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Large-Sample Normality</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Asymptotic Normality</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/bootstrapping"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/maximum-likelihood-estimation"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/asymptotic-normality"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-d58f28d5f3a0</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Statistical methods in subdomain Evidence Synthesis; placed under Statistical Method, the concept named by its wiki topic</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/asymptotic-normality"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/bootstrapping"/>
        <dcterms:identifier>HEO-L-2520e28a28e6</dcterms:identifier>
        <linkRationale xml:lang="en">Wald intervals from asymptotic normality versus bootstrap intervals are alternative bases for uncertainty</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
