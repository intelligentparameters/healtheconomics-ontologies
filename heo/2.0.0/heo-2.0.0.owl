    <!-- https://healtheconomics.wiki/concept/allocation-concealment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/allocation-concealment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/randomization"/>
        <precedes rdf:resource="https://healtheconomics.wiki/concept/blinding"/>
        <skos:notation>HE-ES-CTM-004</skos:notation>
        <dcterms:identifier>HE-ES-CTM-004</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Hopewell et al. 2025</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Allocation Concealment</rdfs:label>
        <owl:versionInfo>1.0.4</owl:versionInfo>
        <skos:altLabel xml:lang="en">Concealed Allocation</skos:altLabel>
        <skos:altLabel xml:lang="en">Concealment of Allocation</skos:altLabel>
        <skos:definition xml:lang="en">Allocation concealment hides the next assignment in a randomised trial from recruiters until allocation, protecting the treatment effects that inform HTA.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Allocation Masking</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Allocation Concealment</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-1"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/selection-bias"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/allocation-concealment"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
