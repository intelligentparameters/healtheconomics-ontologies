    <!-- https://healtheconomics.wiki/concept/volume-rebate -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/volume-rebate">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/rebate"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/volume-based-pricing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/rebate"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/volume-based-pricing"/>
        <skos:notation>HS-DC-DP-107</skos:notation>
        <dcterms:identifier>HS-DC-DP-107</dcterms:identifier>
        <dcterms:source>Carlson JJ, Sullivan SD, Garrison LP, Neumann PJ, Veenstra DL. Linking payment to health outcomes: a taxonomy and examination of performance-based reimbursement schemes. Health Policy. 2010;96(3):179-190.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Volume Rebate</rdfs:label>
        <skos:altLabel xml:lang="en">Volume-Based Rebate</skos:altLabel>
        <skos:definition xml:lang="en">A rebate payment that increases in proportion to the total quantity of a treatment utilised, tied directly to overall uptake.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Quantity Rebate</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Volume Rebate</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/volume-rebate"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/rebate"/>
        <dcterms:identifier>HEO-L-463a7d9b2f3e</dcterms:identifier>
        <linkRationale xml:lang="en">A volume rebate is a rebate.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
