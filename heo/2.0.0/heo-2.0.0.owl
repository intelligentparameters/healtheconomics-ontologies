    <!-- https://healtheconomics.wiki/concept/near-miss-rate -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/near-miss-rate">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
