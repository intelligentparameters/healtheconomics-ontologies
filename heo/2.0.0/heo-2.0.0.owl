        <dcterms:identifier>HEO-L-714440849026</dcterms:identifier>
        <linkRationale xml:lang="en">double programming is a model QA technique</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/double-programming"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#evaluates"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/internal-validity"/>
