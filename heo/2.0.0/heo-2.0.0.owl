        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/blinding"/>
        <skos:notation>HE-ES-CTM-028</skos:notation>
        <dcterms:identifier>HE-ES-CTM-028</dcterms:identifier>
        <dcterms:source>Friedman LM, Furberg CD, DeMets DL, Reboussin DM, Granger CB. Fundamentals of Clinical Trials. 5th ed. Springer; 2015. doi:10.1007/978-3-319-18539-2.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Double Blind</rdfs:label>
        <skos:altLabel xml:lang="en">Double-Blind Design</skos:altLabel>
        <skos:altLabel xml:lang="en">Double-Masked</skos:altLabel>
        <skos:definition xml:lang="en">A trial design in which neither participants nor those administering treatment and assessing outcomes know a given participant&apos;s treatment assignment.</skos:definition>
        <skos:prefLabel xml:lang="en">Double Blind</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/open-label-study"/>
