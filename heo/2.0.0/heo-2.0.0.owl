    <!-- https://healtheconomics.wiki/concept/full-societal-perspective -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/full-societal-perspective">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/societal-perspective"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
