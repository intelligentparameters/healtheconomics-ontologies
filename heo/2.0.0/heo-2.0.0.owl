        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/time-dependency"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isPropertyOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/time-varying-covariate"/>
        <dcterms:identifier>HEO-L-757c29d24c1b</dcterms:identifier>
        <linkRationale xml:lang="en">A time-varying covariate is an input whose value depends on time, the property described.</linkRationale>
