        <dcterms:identifier>HS-DC-DP-013</dcterms:identifier>
        <dcterms:source>Carlson JJ, Sullivan SD, Garrison LP, Neumann PJ, Veenstra DL. Linking payment to health outcomes: a taxonomy and examination of performance-based reimbursement schemes. Health Policy. 2010;96(3):179-190.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Commercial Access Agreement</rdfs:label>
        <skos:altLabel xml:lang="en">Commercial Arrangement</skos:altLabel>
        <skos:definition xml:lang="en">A negotiated arrangement between a manufacturer and payer establishing the price and conditions, sometimes outcomes-based, under which a treatment is made available.</skos:definition>
