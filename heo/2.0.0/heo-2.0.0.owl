    <!-- https://healtheconomics.wiki/concept/stepped-care -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/stepped-care">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/integrated-care"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/integrated-care"/>
        <skos:notation>HS-SS_IC-006</skos:notation>
        <dcterms:identifier>HS-SS_IC-006</dcterms:identifier>
        <dcterms:source>Von Korff &amp; Tiemens 2000</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Stepped Care</rdfs:label>
        <skos:altLabel xml:lang="en">Stepped-Care Model</skos:altLabel>
        <skos:definition xml:lang="en">A delivery model beginning with lower-intensity treatment and progressively escalating only if the initial approach proves insufficient, commonly in mental health.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Graduated Care</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Stepped Care</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/tiered-care"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/step-up-therapy"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/stepped-care"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/integrated-care"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-a94ed4ee84e5</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Systems Strengthening &gt; Integrated Care: health system strengthening is the Health Systems subdomain; placed under Integrated Care, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/stepped-care"/>
