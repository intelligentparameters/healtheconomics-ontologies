        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/confidential-pricing"/>
        <dcterms:identifier>HEO-L-5733e8b4e595</dcterms:identifier>
        <linkRationale xml:lang="en">An SPA keeps the effective price confidential behind a published price; PBS SPAs are current.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
