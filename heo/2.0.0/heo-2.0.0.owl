        <owl:versionInfo>1.0.6</owl:versionInfo>
        <skos:altLabel xml:lang="en">Medical Insurance</skos:altLabel>
        <skos:definition xml:lang="en">Health insurance is a financing arrangement that pools prepaid contributions and covers specified healthcare costs when insured members need care, thereby sharing financial risk across the insured population.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Health Coverage</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Health Insurance</skos:prefLabel>
