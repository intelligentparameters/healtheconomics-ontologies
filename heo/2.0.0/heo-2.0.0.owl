    <!-- https://healtheconomics.wiki/concept/flexible-pricing-scheme -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/flexible-pricing-scheme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/managed-entry-agreement"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/managed-entry-agreement"/>
        <skos:notation>HS-DC-DP-031</skos:notation>
        <dcterms:identifier>HS-DC-DP-031</dcterms:identifier>
        <dcterms:source>Carlson JJ, Sullivan SD, Garrison LP, Neumann PJ, Veenstra DL. Linking payment to health outcomes: a taxonomy and examination of performance-based reimbursement schemes. Health Policy. 2010;96(3):179-190.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Flexible Pricing Scheme</rdfs:label>
        <skos:definition xml:lang="en">A pricing arrangement allowing a treatment&apos;s effective price to vary over time or circumstances, such as patient response, rather than staying fixed.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Adaptive Pricing</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Flexible Pricing Arrangement</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Flexible Pricing Scheme</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/price-revision"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/flexible-pricing-scheme"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <dcterms:identifier>HEO-L-be00383c7448</dcterms:identifier>
        <linkRationale xml:lang="en">A pricing scheme is a form of drug pricing</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
