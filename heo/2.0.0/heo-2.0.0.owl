    <!-- https://healtheconomics.wiki/concept/coverage-error -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/coverage-error">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/non-sampling-error"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/non-sampling-error"/>
        <skos:notation>HE-DS-BV-009</skos:notation>
        <dcterms:identifier>HE-DS-BV-009</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</dcterms:modified>
        <dcterms:source>Mohorko et al. 2013</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Coverage Error</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:definition xml:lang="en">Coverage error arises when the sampling frame of a health survey or register misses part of the target population or includes people outside it.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Coverage Bias</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Frame Error</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Coverage Error</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/sampling-error"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/selection-bias"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/coverage-error"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/non-sampling-error"/>
        <dcterms:identifier>HEO-L-896fe98014bf</dcterms:identifier>
        <linkRationale xml:lang="en">Object definition lists coverage error as a non-sampling error</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/coverage-error"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/sampling-error"/>
        <dcterms:identifier>HEO-L-19a8f56bdf43</dcterms:identifier>
        <linkRationale xml:lang="en">Coverage error is a non-sampling error, contrasting with sampling error</linkRationale>
