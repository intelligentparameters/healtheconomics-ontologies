        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">VIF</skos:altLabel>
        <skos:definition xml:lang="en">A regression diagnostic quantifying how much an estimated coefficient&apos;s variance is inflated by correlation with other predictors, higher values meaning worse multicollinearity.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Collinearity Diagnostic</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Variance Inflation Factor</skos:prefLabel>
        <abbreviation xml:lang="en">VIF</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
