    <!-- https://healtheconomics.wiki/concept/length-of-stay-review -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/length-of-stay-review">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
