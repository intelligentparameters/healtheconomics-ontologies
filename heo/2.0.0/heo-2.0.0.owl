        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/discounting"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-74294829915e</dcterms:identifier>
