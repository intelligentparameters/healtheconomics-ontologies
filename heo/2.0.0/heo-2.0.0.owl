    <!-- https://healtheconomics.wiki/concept/instrumental-activities-of-daily-living -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/instrumental-activities-of-daily-living">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/functional-independence"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/functional-status"/>
        <skos:notation>HS-HP-PHO-011</skos:notation>
        <dcterms:identifier>HS-HP-PHO-011</dcterms:identifier>
        <dcterms:source>Lawton &amp; Brody 1969</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Instrumental Activities of Daily Living</rdfs:label>
        <skos:altLabel xml:lang="en">IADL</skos:altLabel>
        <skos:definition xml:lang="en">Activities required for independent living beyond basic self-care, such as managing finances and using transport, distinct from basic activities of daily living.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Complex Daily Activities</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Instrumental Activities of Daily Living</skos:prefLabel>
        <abbreviation xml:lang="en">IADL</abbreviation>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
