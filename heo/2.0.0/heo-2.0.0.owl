    <!-- https://healtheconomics.wiki/concept/least-squares-approximation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/least-squares-approximation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:notation>CS-NA-AP-001</skos:notation>
        <dcterms:identifier>CS-NA-AP-001</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Golub GH, Van Loan CF. Matrix Computations. 4th ed. Johns Hopkins University Press; 2013.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Least Squares Approximation</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">Least squares approximation estimates the coefficients of a chosen model by minimizing the sum of squared residuals between observed or target values and the corresponding model values.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Least Squares</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Ordinary Least Squares</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Least Squares Approximation</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-12"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/least-squares-approximation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <dcterms:identifier>HEO-L-c46f7d207a32</dcterms:identifier>
        <linkRationale xml:lang="en">An estimation method</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/leave-one-out -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/leave-one-out">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/k-fold-cross-validation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/k-fold-cross-validation"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/predictive-accuracy"/>
        <skos:notation>HE-ES-SA-101</skos:notation>
        <dcterms:identifier>HE-ES-SA-101</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-12-17</dcterms:modified>
        <dcterms:source>Stone 1974</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Leave-One-Out</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A cross-validation form repeatedly refitting a model using all but one observation, using that observation to test accuracy, until each has served once.</skos:definition>
        <skos:prefLabel xml:lang="en">Leave-One-Out</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/leave-one-out"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/k-fold-cross-validation"/>
        <dcterms:identifier>HEO-L-fd2f48a7cdb7</dcterms:identifier>
        <linkRationale xml:lang="en">K equals n</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/leave-one-out"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/predictive-accuracy"/>
