        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:altLabel xml:lang="en">Statistical Pooling</skos:altLabel>
        <skos:definition xml:lang="en">Data pooling is the statistical combining of results from several studies into one summary estimate, usually weighting each study by its precision.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Study Pooling</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Data Pooling</skos:prefLabel>
