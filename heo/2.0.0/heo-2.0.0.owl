        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/biosimilar-substitution"/>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/drug-substitution"/>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/generic-substitution"/>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/switching"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/interchangeability"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
