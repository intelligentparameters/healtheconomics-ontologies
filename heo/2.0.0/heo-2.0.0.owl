    <!-- https://healtheconomics.wiki/concept/publication-bias -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/publication-bias">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/reporting-bias"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/reporting-bias"/>
        <skos:notation>HE-ES-ESM-047</skos:notation>
        <dcterms:identifier>HE-ES-ESM-047</dcterms:identifier>
        <dcterms:source>Sterne, Gavaghan &amp; Egger 2000</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Publication Bias</rdfs:label>
        <skos:definition xml:lang="en">A systematic distortion in published evidence arising because studies with significant or favourable results are more likely to be published.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Positive-Result Bias</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Small-Study Effect</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Publication Bias</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/small-study-effects"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/meta-analysis"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/publication-bias"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/reporting-bias"/>
        <dcterms:identifier>HEO-L-5f4322c4bb80</dcterms:identifier>
        <linkRationale xml:lang="en">Publication bias is a form of reporting bias.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/publication-bias"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/small-study-effects"/>
        <dcterms:identifier>HEO-L-36cdc93eca30</dcterms:identifier>
        <linkRationale xml:lang="en">Publication bias is one cause of small study effects, not the reverse (HEO 1.1.0 review B)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
