    <!-- https://healtheconomics.wiki/concept/budget-cap -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/budget-cap">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/budget-constraint"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/budget-constraint"/>
        <skos:notation>HS-DC-DP-009</skos:notation>
        <dcterms:identifier>HS-DC-DP-009</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Braendle &amp; Colombier 2020</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Budget Cap</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Budget Ceiling</skos:altLabel>
        <skos:altLabel xml:lang="en">Global Cap</skos:altLabel>
        <skos:altLabel xml:lang="en">Sector Cap</skos:altLabel>
        <skos:altLabel xml:lang="en">Spending Cap</skos:altLabel>
        <skos:definition xml:lang="en">Budget cap is a preset ceiling on what a payer will spend on a sector, provider or medicines bill, enforced by fixed budgets, tariff cuts or rebates.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Aggregate Spending Cap</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Payer Spending Limit</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Programme Spending Cap</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Reimbursement Cap</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Sector Spending Limit</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Sectoral Ceiling</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Total Expenditure Ceiling</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Budget Cap</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/volume-cap"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/clawback"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/fixed-budget"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/budget-cap"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/budget-constraint"/>
        <dcterms:identifier>HEO-L-58883997fa31</dcterms:identifier>
        <linkRationale xml:lang="en">A cap is a budget limit on what can be bought</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/budget-cap"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
