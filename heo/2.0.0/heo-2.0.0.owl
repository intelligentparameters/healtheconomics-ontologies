    <!-- https://healtheconomics.wiki/concept/common-cause-variation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/common-cause-variation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/variation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/variation"/>
        <skos:notation>HS-NHS-HQ-018</skos:notation>
        <dcterms:identifier>HS-NHS-HQ-018</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-09</dcterms:modified>
        <dcterms:source>Shewhart 1931</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Common Cause Variation</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Common cause variation is the routine variation a stable process produces from many small chance causes, predictable within limits from past data.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Inherent Variation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Random Variation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Common Cause Variation</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/special-cause-variation"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/statistical-process-control"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/common-cause-variation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/variation"/>
        <dcterms:identifier>HEO-L-44a611fae79f</dcterms:identifier>
        <linkRationale xml:lang="en">A form of variation</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
