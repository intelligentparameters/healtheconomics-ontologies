        <dcterms:identifier>HS-HP-HE-039</dcterms:identifier>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Poverty</rdfs:label>
        <skos:definition xml:lang="en">A state of lacking the material resources needed to meet basic needs, measured against an income or consumption threshold and strongly associated with worse health.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Economic Deprivation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Material Hardship</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Poverty</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/health-inequality"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/impoverishment"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
