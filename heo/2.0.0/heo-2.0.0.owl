    <!-- https://healtheconomics.wiki/concept/integrated-system -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/integrated-system">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-system-organization"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-system-organization"/>
        <skos:notation>HS-HP-HSM-013</skos:notation>
        <dcterms:identifier>HS-HP-HSM-013</dcterms:identifier>
        <dcterms:source>World Health Organization. Everybody&apos;s Business: Strengthening Health Systems to Improve Health Outcomes-WHO&apos;s Framework for Action. WHO; 2007.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Integrated System</rdfs:label>
        <skos:definition xml:lang="en">A health system model in which financing, delivery, and often insurance functions are unified within a single organisation rather than separate entities.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Integrated Health Model</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Unified Health System</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Integrated System</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/integrated-system"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-system-organization"/>
        <dcterms:identifier>HEO-L-c3db77cb52e2</dcterms:identifier>
        <linkRationale xml:lang="en">A model of system organisation</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


