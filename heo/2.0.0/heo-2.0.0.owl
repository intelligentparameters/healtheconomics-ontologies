    <!-- https://healtheconomics.wiki/concept/generalized-cost-effectiveness -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/generalized-cost-effectiveness">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <skos:notation>HE-EE-CEA-032</skos:notation>
        <dcterms:identifier>HE-EE-CEA-032</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-23</dcterms:modified>
        <dcterms:source>Tan-Torres Edejer et al. 2003</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Generalized Cost-Effectiveness</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">GCEA</skos:altLabel>
        <skos:altLabel xml:lang="en">Sectoral Cost-Effectiveness</skos:altLabel>
        <skos:definition xml:lang="en">A form of cost-effectiveness analysis comparing a broad set of interventions against a common null counterfactual rather than against current practice.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Sector-Wide Cost-Effectiveness</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">System-Level Cost-Effectiveness</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">WHO-CHOICE Analysis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Generalized Cost-Effectiveness</skos:prefLabel>
        <abbreviation xml:lang="en">GCEA</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/fully-incremental-analysis"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/priority-setting"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/average-cost-effectiveness-ratio"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/generalized-cost-effectiveness"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <dcterms:identifier>HEO-L-0803a914cd8f</dcterms:identifier>
        <linkRationale xml:lang="en">GCEA is a form of CEA</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/generalized-cost-effectiveness"/>
