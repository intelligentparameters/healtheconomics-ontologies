    <!-- https://healtheconomics.wiki/concept/patient-cap -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/patient-cap">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/managed-entry-agreement"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/volume-control"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/managed-entry-agreement"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/volume-control"/>
        <skos:notation>HS-DC-MA-020</skos:notation>
        <dcterms:identifier>HS-DC-MA-020</dcterms:identifier>
        <dcterms:source>Carlson JJ, Sullivan SD, Garrison LP, Neumann PJ, Veenstra DL. Linking payment to health outcomes: a taxonomy and examination of performance-based reimbursement schemes. Health Policy. 2010;96(3):179-190.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Patient Cap</rdfs:label>
        <skos:definition xml:lang="en">A limit on the number of patients for whom a payer will reimburse a specific treatment within a defined period.</skos:definition>
        <skos:prefLabel xml:lang="en">Patient Cap</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/budget-impact"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
