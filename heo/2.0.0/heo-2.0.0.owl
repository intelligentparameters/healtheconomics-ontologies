    <!-- https://healtheconomics.wiki/concept/probability-distribution -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/probability-distribution">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
