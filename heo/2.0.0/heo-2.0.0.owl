    <!-- https://healtheconomics.wiki/concept/stochastic-simulation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/stochastic-simulation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
