    <!-- https://healtheconomics.wiki/concept/personal-health-record -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/personal-health-record">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/digital-health"/>
