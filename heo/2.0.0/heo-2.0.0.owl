        <skos:notation>HS-NHS-HSP-007</skos:notation>
        <dcterms:identifier>HS-NHS-HSP-007</dcterms:identifier>
        <dcterms:source>Donabedian A. Evaluating the quality of medical care. Milbank Memorial Fund Quarterly. 1966;44(3):166-206. doi:10.2307/3348969.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Gap Analysis</rdfs:label>
        <skos:altLabel xml:lang="en">Gap Assessment</skos:altLabel>
        <skos:definition xml:lang="en">A structured comparison between current performance and a desired level, used to identify areas requiring targeted improvement effort.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Performance Shortfall Review</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Gap Analysis</skos:prefLabel>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/quality-gap"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/performance-standards"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/gap-analysis"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-system-performance"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-6e1448ff242f</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; NHS Productivity &gt; Health System Performance: wiki topic Performance, productivity and quality sits in Health Systems; placed under Health System Performance, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/gap-analysis"/>
