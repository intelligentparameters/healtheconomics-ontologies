        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Treatment Withdrawal</rdfs:label>
        <skos:definition xml:lang="en">The discontinuation of a treatment already being provided, such as stopping ventilation, when it no longer matches the patient&apos;s goals of care.</skos:definition>
        <skos:prefLabel xml:lang="en">Treatment Withdrawal</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
