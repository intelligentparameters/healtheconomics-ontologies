        <dcterms:source>Cowen &amp; Helfand 1990</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Practice Settings</rdfs:label>
        <skos:definition xml:lang="en">The range of distinct physical and organisational environments in which a healthcare profession&apos;s members deliver services, such as community or hospital settings.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Care Settings</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Clinical Settings</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Practice Settings</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/practice-settings"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-a308d916a6e7</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Pharmacy Practice &gt; Pharmacy History &gt; Practice Settings: pharmacy services are part of health care delivery</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/practice-settings"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-system"/>
        <dcterms:identifier>HEO-L-771691222e4f</dcterms:identifier>
