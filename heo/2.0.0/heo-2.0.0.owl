    <!-- https://healtheconomics.wiki/concept/sensitivity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/sensitivity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/diagnostic-accuracy"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/accuracy"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/likelihood-ratio"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/negative-likelihood-ratio"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/positive-likelihood-ratio"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/positive-predictive-value"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/roc-curve"/>
        <skos:notation>HE-ES-RM-040</skos:notation>
        <dcterms:identifier>HE-ES-RM-040</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Altman &amp; Bland 1994</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Sensitivity</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Recall</skos:altLabel>
        <skos:altLabel xml:lang="en">True Positive Rate</skos:altLabel>
        <skos:definition xml:lang="en">The proportion of people with a specified target condition who test positive at a stated diagnostic threshold, calculated as true positives divided by true positives plus false negatives.</skos:definition>
        <skos:prefLabel xml:lang="en">Sensitivity</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/specificity"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/sensitivity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-071f5ab9fdcc</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Epidemiology and risk measures in subdomain Evidence Synthesis</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/sensitivity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/diagnostic-accuracy"/>
        <dcterms:identifier>HEO-L-ca515d559869</dcterms:identifier>
        <linkRationale xml:lang="en">Sensitivity is a metric that quantifies one side of diagnostic accuracy (object definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/sensitivity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/accuracy"/>
        <dcterms:identifier>HEO-L-608374d3417f</dcterms:identifier>
        <linkRationale xml:lang="en">Accuracy equals sensitivity times prevalence plus specificity times one minus prevalence</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/sensitivity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/likelihood-ratio"/>
        <dcterms:identifier>HEO-L-02a2858502c1</dcterms:identifier>
        <linkRationale xml:lang="en">LR+ equals sensitivity over one minus specificity</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/sensitivity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/negative-likelihood-ratio"/>
        <dcterms:identifier>HEO-L-03e53cd4c4f4</dcterms:identifier>
