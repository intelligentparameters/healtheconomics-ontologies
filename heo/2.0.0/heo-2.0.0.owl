    <!-- https://healtheconomics.wiki/concept/pre-test-probability -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/pre-test-probability">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/prior-probability"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/prior-probability"/>
        <precedes rdf:resource="https://healtheconomics.wiki/concept/post-test-probability"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/post-test-probability"/>
        <skos:notation>HE-ES-RM-026</skos:notation>
        <dcterms:identifier>HE-ES-RM-026</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Sackett et al. 1991</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Pre-Test Probability</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">The estimated probability that a patient has a condition before a diagnostic test result is known, based on prevalence and clinical presentation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Baseline Risk of Condition</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Prior Diagnostic Probability</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Pre-Test Probability</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/pre-test-probability"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/prior-probability"/>
        <dcterms:identifier>HEO-L-92d507875768</dcterms:identifier>
        <linkRationale xml:lang="en">It is the prior in diagnostic Bayes; combined with the likelihood ratio it gives the post-test probability.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/pre-test-probability"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#precedes"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/post-test-probability"/>
        <dcterms:identifier>HEO-L-1d8a902b1367</dcterms:identifier>
