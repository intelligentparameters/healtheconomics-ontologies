    <!-- https://healtheconomics.wiki/concept/contamination -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/contamination">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/protocol-deviation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/protocol-deviation"/>
        <skos:notation>HE-ES-CTM-108</skos:notation>
        <dcterms:identifier>HE-ES-CTM-108</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</dcterms:modified>
        <dcterms:source>Magill et al. 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Contamination</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">Contamination occurs when trial participants receive the other arm&apos;s intervention, usually controls getting the new one, diluting the measured effect.</skos:definition>
        <skos:prefLabel xml:lang="en">Contamination</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/bias"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/statistical-power"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/randomised-controlled-trial"/>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/trial-based-analysis"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/contamination"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/protocol-deviation"/>
        <dcterms:identifier>HEO-L-dbb3c70e8cf5</dcterms:identifier>
        <linkRationale xml:lang="en">Receiving the other arm intervention departs from the protocol</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/contamination"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/bias"/>
        <dcterms:identifier>HEO-L-ffec06c523bf</dcterms:identifier>
        <linkRationale xml:lang="en">Dilution biases the effect towards the null</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
