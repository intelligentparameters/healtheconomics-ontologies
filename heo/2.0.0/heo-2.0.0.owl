    <!-- https://healtheconomics.wiki/concept/bottom-up-costing -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/bottom-up-costing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <skos:notation>HE-EE-CM-006</skos:notation>
        <dcterms:identifier>HE-EE-CM-006</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Špacírová et al. 2020</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Bottom-Up Costing</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Patient-Level Costing</skos:altLabel>
        <skos:definition xml:lang="en">Bottom-up costing estimates the cost of care by recording each patient&apos;s use of resources and multiplying every item by its unit cost.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Ingredient-Based Costing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Bottom-Up Costing</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/top-down-costing"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/costs#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/resource-use"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/unit-cost"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/bottom-up-costing"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-b8e6681966ac</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Costing methods in subdomain Costs</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
