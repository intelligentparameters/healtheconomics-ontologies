    <!-- https://healtheconomics.wiki/concept/fee-for-service -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/fee-for-service">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/unbundled-payment"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q5441151"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/unbundled-payment"/>
        <skos:notation>HS-HP-PP-051</skos:notation>
        <dcterms:identifier>HS-HP-PP-051</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Folland, Goodman &amp; Stano 2016</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Fee-for-Service</rdfs:label>
        <owl:versionInfo>1.0.6</owl:versionInfo>
        <skos:altLabel xml:lang="en">FFS</skos:altLabel>
        <skos:definition xml:lang="en">Fee-for-service is a provider-payment method in which each eligible health-care service generates a separate payment according to an applicable fee or contract.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Per-Service Payment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Fee-for-Service</skos:prefLabel>
        <abbreviation xml:lang="en">FFS</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/per-diem"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/fee-schedule"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/fee-for-service"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <dcterms:identifier>HEO-L-5c95dcebaea7</dcterms:identifier>
        <linkRationale xml:lang="en">FFS is a provider payment method</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
