        <skos:altLabel xml:lang="en">Very Low Certainty Evidence</skos:altLabel>
        <skos:definition xml:lang="en">Within GRADE, the lowest certainty rating, indicating the true effect is likely substantially different from the reported estimate, from very weak studies.</skos:definition>
        <skos:hiddenLabel xml:lang="en">GRADE Very Low</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Very Low-Quality Evidence</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
