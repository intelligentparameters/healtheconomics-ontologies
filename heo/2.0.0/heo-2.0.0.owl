        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/unwarranted-variation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/clinical-practice-variation"/>
        <dcterms:identifier>HEO-L-7e759a1d3f5e</dcterms:identifier>
        <linkRationale xml:lang="en">Unwarranted variation is one kind of clinical practice variation.</linkRationale>
