    <!-- https://healtheconomics.wiki/concept/between-study-heterogeneity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/between-study-heterogeneity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-ES-ESM-004</skos:notation>
        <dcterms:identifier>HE-ES-ESM-004</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Higgins et al. 2003</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Between-Study Heterogeneity</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Between-study heterogeneity is variation in effects across trials in a meta-analysis beyond chance, so one pooled effect may not fit every HTA setting.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Heterogeneity</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Inter-Study Variation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Study Heterogeneity</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Between-Study Heterogeneity</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/decision-uncertainty"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-4"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/meta-analysis"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/fixed-effect-model"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/between-study-heterogeneity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-b02f47565252</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Evidence synthesis and appraisal in subdomain Evidence Synthesis</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/between-study-heterogeneity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/decision-uncertainty"/>
        <dcterms:identifier>HEO-L-efaf13174481</dcterms:identifier>
        <linkRationale xml:lang="en">Heterogeneity widens uncertainty in the pooled effect</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
