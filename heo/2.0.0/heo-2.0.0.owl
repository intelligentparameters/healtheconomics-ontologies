    <!-- https://healtheconomics.wiki/concept/lifetime-horizon -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/lifetime-horizon">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
