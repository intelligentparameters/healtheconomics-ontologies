        <skos:altLabel xml:lang="en">Elementary Effects Method</skos:altLabel>
        <skos:altLabel xml:lang="en">Morris Screening</skos:altLabel>
        <skos:definition xml:lang="en">A global sensitivity-screening method that samples one-input-at-a-time elementary effects across multiple model-input settings to identify influential or varying inputs.</skos:definition>
        <skos:prefLabel xml:lang="en">Morris Method</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/one-way-sensitivity-analysis"/>
