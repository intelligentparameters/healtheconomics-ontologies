    <!-- https://healtheconomics.wiki/concept/compliance -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/compliance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>PP-PC-AS-002</skos:notation>
        <dcterms:identifier>PP-PC-AS-002</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Vrijens et al. 2012; HHS OIG 2023</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Compliance</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Compliance is conformity with a requirement: a patient following a prescribed regimen (now often termed adherence) or a provider meeting legal rules.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Conformance</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Rule Adherence</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Compliance</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/adherence"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/compliance"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-39866e635ece</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Pharmacy Practice &gt; Pharmaceutical Care &gt; Adherence Support: pharmacy services are part of health care delivery</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/compliance"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/adherence"/>
        <dcterms:identifier>HEO-L-1b826196ef06</dcterms:identifier>
