        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/dependent-censoring"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/missing-data"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/right-censoring"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/loss-to-follow-up"/>
