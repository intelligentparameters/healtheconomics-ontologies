    <!-- https://healtheconomics.wiki/concept/price-revision -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/price-revision">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:notation>HS-DC-DP-074</skos:notation>
        <dcterms:identifier>HS-DC-DP-074</dcterms:identifier>
        <dcterms:source>Danzon 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Price Revision</rdfs:label>
        <skos:definition xml:lang="en">A formal change to a drug&apos;s established price, whether up or down, typically following periodic review or renegotiation with a payer.</skos:definition>
