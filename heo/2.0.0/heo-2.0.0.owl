        <dcterms:identifier>HS-HP-HQ-043</dcterms:identifier>
        <dcterms:source>CDC, National Healthcare Safety Network</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">SSI Rate</rdfs:label>
        <skos:altLabel xml:lang="en">Surgical Site Infection Rate</skos:altLabel>
        <skos:definition xml:lang="en">A measure of the frequency of surgical site infections following a procedure within a facility, a surgical infection prevention indicator.</skos:definition>
