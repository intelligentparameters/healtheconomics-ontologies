    <!-- https://healtheconomics.wiki/concept/choice-architecture-intervention -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/choice-architecture-intervention">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/behaviour-change-intervention"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/behaviour-change-intervention"/>
        <skos:notation>HE-EE-BE-006</skos:notation>
        <dcterms:identifier>HE-EE-BE-006</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-09</dcterms:modified>
        <dcterms:source>Hollands et al. 2013</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Choice Architecture Intervention</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">A choice architecture intervention changes how health options are set out, such as defaults, order or placement, to shift choices without removing options.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Choice Architecture</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Nudge Design</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Choice Architecture Intervention</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/incentive-intervention"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/choice-overload"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/choice-architecture-intervention"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/behaviour-change-intervention"/>
        <dcterms:identifier>HEO-L-ca1f0970f6d1</dcterms:identifier>
        <linkRationale xml:lang="en">Choice architecture changes aim to change health behaviour (both definitions)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/choice-architecture-intervention"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/incentive-intervention"/>
        <dcterms:identifier>HEO-L-c1b39b9450db</dcterms:identifier>
        <linkRationale xml:lang="en">Nudges change presentation without changing incentives, unlike incentive interventions (Thaler and Sunstein 2008)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
