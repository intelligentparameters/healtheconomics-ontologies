        <dcterms:identifier>HEO-L-2f0f18438574</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: curated: review B: need for help with daily activities is a functional status outcome</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
