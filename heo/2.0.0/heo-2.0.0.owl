    <!-- https://healtheconomics.wiki/concept/coverage-decision -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/coverage-decision">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/decision"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/decision"/>
        <skos:notation>HS-HP-HTA-053</skos:notation>
        <dcterms:identifier>HS-HP-HTA-053</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</dcterms:modified>
        <dcterms:source>Fontrier et al. 2022</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Coverage Decision</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:altLabel xml:lang="en">Coverage Determination</skos:altLabel>
        <skos:altLabel xml:lang="en">Funding Decision</skos:altLabel>
        <skos:definition xml:lang="en">A coverage decision is a payer&apos;s or HTA body&apos;s formal ruling on whether a health technology will be funded, for which patients and on what conditions.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Payer Coverage Ruling</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Coverage Decision</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-technology-assessment#step-1"/>
