    <!-- https://healtheconomics.wiki/concept/individual-market -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/individual-market">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/health-insurance-market"/>
        <skos:notation>HS-HP-HI-103</skos:notation>
        <dcterms:identifier>HS-HP-HI-103</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Individual Market</rdfs:label>
        <skos:definition xml:lang="en">The insurance market segment where coverage is purchased directly by individual consumers rather than through an employer or other group.</skos:definition>
        <skos:prefLabel xml:lang="en">Individual Market</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/individual-market"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
