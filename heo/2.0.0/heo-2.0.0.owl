    <!-- https://healtheconomics.wiki/concept/indirect-benefit -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/indirect-benefit">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-HP-HSG-016</skos:notation>
        <dcterms:identifier>HS-HP-HSG-016</dcterms:identifier>
        <dcterms:source>National Commission, Belmont Report 1979</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Indirect Benefit</rdfs:label>
        <skos:definition xml:lang="en">A potential positive outcome resulting from a study that does not directly benefit the individual participant, such as knowledge helping future patients.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Non-Personal Benefit</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Societal Research Benefit</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Indirect Benefit</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/direct-benefit"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/informed-consent-for-research"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/indirect-benefit"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-d1a2927a6331</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health System Governance: organisation and delivery of care is the Health Systems subdomain (Organisation and governance)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/indirect-benefit"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/direct-benefit"/>
        <dcterms:identifier>HEO-L-d7f183f6fd8c</dcterms:identifier>
        <linkRationale xml:lang="en">Direct versus indirect participant benefit.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/indirect-benefit"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
