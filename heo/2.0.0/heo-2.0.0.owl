    <!-- https://healtheconomics.wiki/concept/return-on-investment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/return-on-investment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-benefit-analysis"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q939134"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/cost-benefit-analysis"/>
        <skos:notation>HE-EE-CBA-043</skos:notation>
        <dcterms:identifier>HE-EE-CBA-043</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Brealey, Myers &amp; Allen 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
