    <!-- https://healtheconomics.wiki/concept/capital-budget -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/capital-budget">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/budget-constraint"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/budget-constraint"/>
        <skos:notation>HE-EE-BIA-024</skos:notation>
        <dcterms:identifier>HE-EE-BIA-024</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>HM Treasury 2026 (Consolidated Budgeting Guidance 2026 to 2027)</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Capital Budget</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Capital Expenditure Budget</skos:altLabel>
        <skos:definition xml:lang="en">Capital Budget is a health system&apos;s spending limit for long-lived assets such as hospitals, equipment and IT, kept apart from day-to-day running costs.</skos:definition>
        <skos:hiddenLabel xml:lang="en">CapEx Budget</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Capital Budget</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/operating-budget"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
