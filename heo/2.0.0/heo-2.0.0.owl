    <!-- https://healtheconomics.wiki/concept/deterministic-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/deterministic-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q622381"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:notation>HE-EM-DM-020</skos:notation>
        <dcterms:identifier>HE-EM-DM-020</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</dcterms:modified>
        <dcterms:source>Krijkamp et al. 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Deterministic Model</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:definition xml:lang="en">A deterministic model is a health economic model with no random elements, so the same inputs always give the same costs, QALYs and ICER.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Fixed-Parameter Model</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Point-Estimate Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Deterministic Model</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/stochastic-model"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/deterministic-model"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-3053209621ed</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Model types and structures in subdomain Economic Modelling</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/deterministic-model"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/stochastic-model"/>
        <dcterms:identifier>HEO-L-f59d494cd5bb</dcterms:identifier>
        <linkRationale xml:lang="en">No random elements versus random inputs</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
