    <!-- https://healtheconomics.wiki/concept/displacement -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/displacement">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/opportunity-cost"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/opportunity-cost"/>
        <skos:notation>HE-EE-BIA-030</skos:notation>
        <dcterms:identifier>HE-EE-BIA-030</dcterms:identifier>
        <dcterms:source>Claxton et al. 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Displacement</rdfs:label>
        <skos:altLabel xml:lang="en">Displacement Effect</skos:altLabel>
        <skos:definition xml:lang="en">The loss of health benefit elsewhere in a health system that results from allocating resources to a new treatment.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Forgone Health</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Health Opportunity Loss</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Displacement</skos:prefLabel>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-threshold"/>
