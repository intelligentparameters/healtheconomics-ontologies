    <!-- https://healtheconomics.wiki/concept/stop-loss-insurance -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/stop-loss-insurance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/reinsurance"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q114363407"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/reinsurance"/>
        <skos:notation>HS-HP-HI-189</skos:notation>
        <dcterms:identifier>HS-HP-HI-189</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Stop-Loss Insurance</rdfs:label>
        <skos:definition xml:lang="en">A reinsurance type purchased by self-insured employers to protect against unexpectedly high claims costs, from a single case or aggregate total.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Excess Loss Insurance</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Loss-Cap Cover</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Stop-Loss Insurance</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/stop-loss-insurance"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/reinsurance"/>
        <dcterms:identifier>HEO-L-87b4815e58a9</dcterms:identifier>
        <linkRationale xml:lang="en">The definition states stop-loss insurance is a reinsurance type bought by self-insured employers.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/stop-loss-provision -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/stop-loss-provision">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/stop-loss"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/stop-loss"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/stop-loss-insurance"/>
        <skos:notation>HS-HP-PP-096</skos:notation>
        <dcterms:identifier>HS-HP-PP-096</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Stop-Loss Provision</rdfs:label>
        <skos:definition xml:lang="en">A contractual clause within a risk-sharing arrangement limiting a provider&apos;s maximum financial exposure to unexpectedly high claims costs.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Excess-Loss Provision</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Loss-Limit Clause</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Stop-Loss Provision</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/downside-risk"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/stop-loss-provision"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/stop-loss"/>
        <dcterms:identifier>HEO-L-548ccd973154</dcterms:identifier>
        <linkRationale xml:lang="en">A contractual stop-loss reimbursing claims above an attachment point; also caps Downside Risk (see that row).</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/stop-loss-provision"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
