    <!-- https://healtheconomics.wiki/concept/practice-style-variation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/practice-style-variation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-practice-variation"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/unwarranted-variation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/clinical-practice-variation"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/unwarranted-variation"/>
        <skos:notation>HS-HP-HD-086</skos:notation>
        <dcterms:identifier>HS-HP-HD-086</dcterms:identifier>
        <dcterms:source>Wennberg &amp; Gittelsohn 1973</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Practice Style Variation</rdfs:label>
        <skos:definition xml:lang="en">Differences in clinical decision-making and treatment intensity across physicians or regions treating clinically similar patients, unexplained by need or preference.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Physician Practice Style</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Provider Style Difference</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Practice Style Variation</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/small-area-variation"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/practice-style-variation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/clinical-practice-variation"/>
        <dcterms:identifier>HEO-L-5fac94dfbe55</dcterms:identifier>
        <linkRationale xml:lang="en">Practice style variation is variation in care between clinicians</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
