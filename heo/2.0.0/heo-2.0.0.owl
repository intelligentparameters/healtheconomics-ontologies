    <!-- https://healtheconomics.wiki/concept/social-impact-bond -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/social-impact-bond">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/performance-based-financing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/performance-based-financing"/>
        <skos:notation>HS-HP-HF-072</skos:notation>
        <dcterms:identifier>HS-HP-HF-072</dcterms:identifier>
        <dcterms:source>Gustafsson-Wright, Gardiner &amp; Putcha 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Social Impact Bond</rdfs:label>
        <skos:altLabel xml:lang="en">Pay-for-Success Bond</skos:altLabel>
        <skos:altLabel xml:lang="en">SIB</skos:altLabel>
        <skos:definition xml:lang="en">A financing mechanism where private investors fund a social programme upfront, repaid by government or a donor only if verified results are achieved.</skos:definition>
        <skos:prefLabel xml:lang="en">Social Impact Bond</skos:prefLabel>
        <abbreviation xml:lang="en">SIB</abbreviation>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
