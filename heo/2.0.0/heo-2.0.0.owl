        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/readmission-management"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/care-management"/>
        <dcterms:identifier>HEO-L-1097a419242c</dcterms:identifier>
        <linkRationale xml:lang="en">Readmission management is targeted care management.</linkRationale>
