    <!-- https://healtheconomics.wiki/concept/interruptive-alert -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/interruptive-alert">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-alert"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/clinical-alert"/>
        <skos:notation>HS-HP-DH-029</skos:notation>
        <dcterms:identifier>HS-HP-DH-029</dcterms:identifier>
        <dcterms:source>Ancker et al. 2017</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Interruptive Alert</rdfs:label>
        <skos:altLabel xml:lang="en">Active Alert</skos:altLabel>
        <skos:definition xml:lang="en">A clinical alert requiring a provider to actively respond before proceeding, unlike a passive alert displayed without requiring immediate response.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Hard-Stop Alert</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Interruptive Alert</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/passive-alert"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/alert-fatigue"/>
