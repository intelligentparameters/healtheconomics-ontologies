    <!-- https://healtheconomics.wiki/concept/transdisciplinary-care -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/transdisciplinary-care">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/coordinated-care-model"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/team-based-care"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/coordinated-care-model"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/team-based-care"/>
        <skos:notation>HS-SS_IC-009</skos:notation>
        <dcterms:identifier>HS-SS_IC-009</dcterms:identifier>
        <dcterms:source>AHA, American Hospital Association</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Transdisciplinary Care</rdfs:label>
        <skos:definition xml:lang="en">A delivery model in which providers from different disciplines collaborate so closely that traditional boundaries blur, jointly developing a unified approach.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Boundary-Blurring Care</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Cross-Disciplinary Care</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Transdisciplinary Care</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/multidisciplinary-care"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/transdisciplinary-care"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/coordinated-care-model"/>
        <dcterms:identifier>HEO-L-9d689bcee817</dcterms:identifier>
        <linkRationale xml:lang="en">Transdisciplinary care deliberately organises care across disciplines, a coordinated care model.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/transdisciplinary-care"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/team-based-care"/>
        <dcterms:identifier>HEO-L-dff257534d5e</dcterms:identifier>
        <linkRationale xml:lang="en">Transdisciplinary care is delivered by a team sharing responsibility, a form of team-based care.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/transdisciplinary-care"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
