        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/primary-data-collection"/>
        <skos:notation>HE-ES-ES-027</skos:notation>
        <dcterms:identifier>HE-ES-ES-027</dcterms:identifier>
        <dcterms:source>Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams &amp; Wilkins; 2008.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Health Examination</rdfs:label>
        <skos:definition xml:lang="en">A data collection method involving direct physical examination or clinical testing of survey participants, unlike self-reported health information alone.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Examination Survey</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Physical Examination Survey</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Health Examination</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/self-reported-health"/>
