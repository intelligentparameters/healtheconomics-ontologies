    <!-- https://healtheconomics.wiki/concept/drug-tolerance -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/drug-tolerance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1425425"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-PE-DT-017</skos:notation>
        <dcterms:identifier>HE-PE-DT-017</dcterms:identifier>
        <dcterms:source>Rowland &amp; Tozer 2010</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Drug Tolerance</rdfs:label>
        <skos:altLabel xml:lang="en">Acquired Tolerance</skos:altLabel>
        <skos:altLabel xml:lang="en">Pharmacological Tolerance</skos:altLabel>
        <skos:definition xml:lang="en">A physiological adaptation in which a patient needs progressively higher doses over time to achieve the effect a lower dose once produced.</skos:definition>
        <skos:prefLabel xml:lang="en">Drug Tolerance</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/drug-resistance"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/loss-of-response"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/drug-tolerance"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-86489f7173fa</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Pharmacoeconomics &gt; Drug Therapy: dosing and treatment-line terms describe the clinical evidence and treatment pathways that models use</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/drug-tolerance"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-resistance"/>
        <dcterms:identifier>HEO-L-fedf49d9ef01</dcterms:identifier>
        <linkRationale xml:lang="en">tolerance is not a kind of the study of drug effects; host adaptation needing higher doses is the standard contrast with pathogen or tumour resistance</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/drug-tolerance"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/loss-of-response"/>
        <dcterms:identifier>HEO-L-b01cf8ea5953</dcterms:identifier>
        <linkRationale xml:lang="en">Needing higher doses for the same effect is one cause of waning response.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
