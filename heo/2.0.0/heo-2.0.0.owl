    <!-- https://healtheconomics.wiki/concept/diagnostic-accuracy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/diagnostic-accuracy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/accuracy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/accuracy"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/diagnostic-efficacy-hierarchy"/>
        <skos:notation>HE-ES-SA-050</skos:notation>
        <dcterms:identifier>HE-ES-SA-050</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-02</dcterms:modified>
        <dcterms:source>Bossuyt et al. 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Diagnostic Accuracy</rdfs:label>
        <owl:versionInfo>1.0.3</owl:versionInfo>
        <skos:altLabel xml:lang="en">Test Accuracy</skos:altLabel>
        <skos:definition xml:lang="en">Diagnostic accuracy is how well a test agrees with a reference standard in detecting a target condition, usually reported as sensitivity and specificity.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Diagnostic Correctness</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Diagnostic Accuracy</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/decision-curve-analysis"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/diagnostic-safety"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/ai-diagnostic-value"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/diagnostic-accuracy"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/accuracy"/>
        <dcterms:identifier>HEO-L-da4b1fca698c</dcterms:identifier>
        <linkRationale xml:lang="en">diagnostic accuracy is classification accuracy of a test against a reference standard</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
