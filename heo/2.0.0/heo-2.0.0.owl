        <skos:prefLabel xml:lang="en">Validity Assessment</skos:prefLabel>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/construct-validity"/>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/content-validity"/>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/measurement-property"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
