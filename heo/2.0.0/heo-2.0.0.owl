        <dcterms:identifier>HE-HF-FM-001</dcterms:identifier>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Financial Management</rdfs:label>
        <skos:definition xml:lang="en">In health economics, the planning, recording, control and reporting of a healthcare organisation&apos;s financial resources, providing the accounts and metrics used to assess financial performance and sustainability.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Accounting</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Healthcare Financial Management</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Financial Management</skos:prefLabel>
        <produces rdf:resource="https://healtheconomics.wiki/concept/financial-statement"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/cash-budget"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/financial-ratio"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/internal-rate-of-return"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/operating-budget"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/payback-period"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/financial-management"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/resource-management"/>
        <dcterms:identifier>HEO-L-116b1dd30b1a</dcterms:identifier>
        <linkRationale xml:lang="en">Financial management is management of the financial resource</linkRationale>
