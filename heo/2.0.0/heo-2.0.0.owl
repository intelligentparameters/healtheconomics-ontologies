        <dcterms:identifier>HS-HP-HSR-019</dcterms:identifier>
        <dcterms:source>HHS OIG, Corporate Integrity Agreements</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Corporate Integrity Agreement</rdfs:label>
        <skos:altLabel xml:lang="en">CIA</skos:altLabel>
        <skos:definition xml:lang="en">A binding agreement between a healthcare organisation and a government oversight agency requiring compliance measures and ongoing monitoring, typically after enforcement.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Integrity Agreement</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Corporate Integrity Agreement</skos:prefLabel>
        <abbreviation xml:lang="en">CIA</abbreviation>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/compliance"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/compliance-programme"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/corporate-integrity-agreement"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
