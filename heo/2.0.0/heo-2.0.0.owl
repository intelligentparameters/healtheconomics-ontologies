    <!-- https://healtheconomics.wiki/concept/run-length -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/run-length">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:notation>HE-EM-UA-057</skos:notation>
        <dcterms:identifier>HE-EM-UA-057</dcterms:identifier>
        <dcterms:source>Law &amp; Kelton 2000</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Run Length</rdfs:label>
        <skos:definition xml:lang="en">The number of iterations, or amount of simulated time, for which a simulation model runs before its results are recorded and analysed.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Iteration Count</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Simulation Length</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Run Length</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/convergence"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/discrete-event-simulation"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/monte-carlo-simulation"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/psa"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/run-length"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
