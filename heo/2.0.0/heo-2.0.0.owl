        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Club Good</skos:altLabel>
        <skos:altLabel xml:lang="en">Toll Good</skos:altLabel>
        <skos:altLabel xml:lang="en">Toll Goods</skos:altLabel>
        <skos:definition xml:lang="en">Club goods are excludable goods a group can share without rivalry until congestion sets in, so users can be charged and membership limited.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Congestible Good</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Excludable Non-Rival Goods</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Club Goods</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/common-pool-resources"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/public-good"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/club-goods"/>
