    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#prefLabel"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#scopeNote -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#scopeNote"/>
    


    <!-- http://xmlns.com/foaf/0.1/homepage -->

    <owl:AnnotationProperty rdf:about="http://xmlns.com/foaf/0.1/homepage"/>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#abbreviation -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#abbreviation">
        <rdfs:label xml:lang="en">abbreviation</rdfs:label>
        <skos:definition xml:lang="en">An acronym or short form of the concept&apos;s preferred name. Every abbreviation is also an alternative label.</skos:definition>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#altLabel"/>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#addresses -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#addresses">
        <rdfs:comment xml:lang="en">Descriptive link for people to read (no inference).</rdfs:comment>
        <rdfs:label xml:lang="en">Addresses</rdfs:label>
        <skos:definition xml:lang="en">Subject is a method, design feature, policy or theoretical solution designed to deal with the problem that is Object, without necessarily removing it. For example, Imputation addresses Missing Data.</skos:definition>
        <skos:example xml:lang="en">Listwise Deletion Addresses Missing Data</skos:example>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Navigation"/>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#applicationUse -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#applicationUse">
        <rdfs:label xml:lang="en">application use</rdfs:label>
        <skos:definition xml:lang="en">What applications may use this link type for: navigation (shown and followed by people), learning (drives learning order and activities) or formal inference (used by an OWL reasoner).</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#assumes -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#assumes">
        <rdfs:comment xml:lang="en">Descriptive link for people to read (no inference).</rdfs:comment>
        <rdfs:label xml:lang="en">Assumes</rdfs:label>
        <skos:definition xml:lang="en">Subject, a method or model, rests on the assumption or property that is Object. For example, Exponential Distribution assumes Constant Hazard.</skos:definition>
        <skos:example xml:lang="en">Indirect Comparison Assumes Consistency</skos:example>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Learning"/>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Navigation"/>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#benchmarkFor -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#benchmarkFor">
        <rdfs:comment xml:lang="en">Descriptive link for people to read (no inference).</rdfs:comment>
        <rdfs:label xml:lang="en">Benchmark for</rdfs:label>
        <skos:definition xml:lang="en">Subject is the reference value or standard against which Object is judged. For example, Cost-Effectiveness Threshold is the benchmark for the ICER.</skos:definition>
        <skos:example xml:lang="en">Market Equilibrium Benchmark for Price Distortion</skos:example>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Navigation"/>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#contrastsWith -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#contrastsWith">
        <rdfs:comment xml:lang="en">Descriptive link for people to read (no inference).</rdfs:comment>
        <rdfs:label xml:lang="en">Contrasts with</rdfs:label>
        <skos:definition xml:lang="en">Subject and Object are opposing or mutually-alternative concepts. Sub-property of skos:related.</skos:definition>
        <skos:example xml:lang="en">Health Depreciation Contrasts with Health Investment</skos:example>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Navigation"/>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#contributesTo -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#contributesTo">
        <rdfs:comment xml:lang="en">Descriptive link for people to read (no inference). Aligned in intent to ro:causally_contributes_to.</rdfs:comment>
        <rdfs:label xml:lang="en">Contributes to</rdfs:label>
        <skos:definition xml:lang="en">Subject causally contributes to Object (a partial cause or driver).</skos:definition>
        <skos:example xml:lang="en">Health System Strengthening Contributes to Health System Performance</skos:example>
        <skos:scopeNote xml:lang="en">A conceptual association between meanings, not a measured effect in any population or setting. Actual effects, and the evidence for them, are described in RHEO and in the sources on the concept pages.</skos:scopeNote>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Navigation"/>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#coreConceptIn -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#coreConceptIn">
        <rdfs:label xml:lang="en">core concept in</rdfs:label>
        <skos:definition xml:lang="en">The concept is a core (must-learn) concept in this step of a learning pathway&apos;s framework.</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#counterpartOf -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#counterpartOf">
        <rdfs:comment xml:lang="en">Descriptive link for people to read (no inference).</rdfs:comment>
        <rdfs:label xml:lang="en">Counterpart of</rdfs:label>
        <skos:definition xml:lang="en">Subject plays the same role as Object in a different framework, paradigm or jurisdiction. Symmetric. For example, P-score is the counterpart of SUCRA.</skos:definition>
        <skos:example xml:lang="en">Governance Block Counterpart of Stewardship</skos:example>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Navigation"/>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#dependsOn -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#dependsOn">
        <rdfs:comment xml:lang="en">Descriptive link for people to read (no inference). Aligned in intent to ro:depends_on.</rdfs:comment>
        <rdfs:label xml:lang="en">Depends on</rdfs:label>
        <skos:definition xml:lang="en">Subject functionally/logically depends on Object; Object must hold for Subject. (Absorbs former requires.)</skos:definition>
        <skos:example xml:lang="en">Network Meta-Analysis Depends on Connected Network</skos:example>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Learning"/>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Navigation"/>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#evaluates -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#evaluates">
        <rdfs:comment xml:lang="en">Descriptive link for people to read (no inference).</rdfs:comment>
        <rdfs:label xml:lang="en">Evaluates</rdfs:label>
        <skos:definition xml:lang="en">Subject appraises or assesses Object (e.g. HTA evaluates Health Technology).</skos:definition>
        <skos:example xml:lang="en">Hypertension Control Rate Evaluates Hypertension Management</skos:example>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Navigation"/>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#explains -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#explains">
        <rdfs:comment xml:lang="en">Descriptive link for people to read (no inference).</rdfs:comment>
        <rdfs:label xml:lang="en">Explains</rdfs:label>
        <skos:definition xml:lang="en">Subject is a theory, hypothesis or theorem that accounts for why the phenomenon, behaviour or pattern that is Object occurs. For example, Target Income Hypothesis explains Supplier-Induced Demand.</skos:definition>
        <skos:example xml:lang="en">Information Economics Explains Adverse Selection</skos:example>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Navigation"/>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#informs -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#informs">
        <rdfs:comment xml:lang="en">Descriptive link for people to read (no inference).</rdfs:comment>
        <rdfs:label xml:lang="en">Informs</rdfs:label>
        <skos:definition xml:lang="en">Subject provides information input to the decision/process Object (epistemic). (Absorbs former supports.)</skos:definition>
        <skos:example xml:lang="en">Economic Evaluation Informs Health Technology Assessment</skos:example>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Navigation"/>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#instanceOf -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#instanceOf">
        <rdfs:comment xml:lang="en">Descriptive link for people to read (no inference). Aligned in intent to rdf:type.</rdfs:comment>
        <rdfs:label xml:lang="en">Instance of</rdfs:label>
        <skos:definition xml:lang="en">Subject is a particular individual that is a member of the class Object. Genuine individuals only.</skos:definition>
        <skos:example xml:lang="en">HIPAA Instance of Privacy Standards</skos:example>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Navigation"/>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#isFoundationFor -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#isFoundationFor">
        <rdfs:comment xml:lang="en">Descriptive link for people to read (no inference).</rdfs:comment>
        <rdfs:label xml:lang="en">Is foundation for</rdfs:label>
        <skos:definition xml:lang="en">Subject is a basic idea on which Object is built. For example, Scarcity is the foundation for Opportunity Cost.</skos:definition>
        <skos:example xml:lang="en">Mean Squared Error Is foundation for Bias-Variance Tradeoff</skos:example>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Learning"/>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Navigation"/>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#isPropertyOf -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#isPropertyOf">
        <rdfs:comment xml:lang="en">Descriptive link for people to read (no inference).</rdfs:comment>
        <rdfs:label xml:lang="en">Is a property of</rdfs:label>
        <skos:definition xml:lang="en">Subject is a characteristic that describes or classifies Object. For example, Excludability is a property of an Economic Good.</skos:definition>
        <skos:example xml:lang="en">Level of Detail Is a property of Model Structure</skos:example>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Navigation"/>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#linkRationale -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#linkRationale">
        <rdfs:label xml:lang="en">link rationale</rdfs:label>
        <skos:definition xml:lang="en">Why the link holds, in one short line a reviewer can check.</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#linkReviewDate -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#linkReviewDate">
        <rdfs:label xml:lang="en">link review date</rdfs:label>
        <skos:definition xml:lang="en">When this link was last reviewed.</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#linkReviewStatus -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#linkReviewStatus">
        <rdfs:label xml:lang="en">link review status</rdfs:label>
        <skos:definition xml:lang="en">Review status of this link, separate from the review of the two concepts it joins: unreviewed (not yet checked on its own), machine-reviewed (checked by an AI-assisted review against the link type&apos;s definition and both concepts&apos; definitions, awaiting curator sign-off), curator-approved (checked and approved by a named curator).</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#linkReviewer -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#linkReviewer">
        <rdfs:label xml:lang="en">link reviewer</rdfs:label>
        <skos:definition xml:lang="en">Who reviewed this link.</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#manages -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#manages">
        <rdfs:comment xml:lang="en">Descriptive link for people to read (no inference).</rdfs:comment>
        <rdfs:label xml:lang="en">Manages</rdfs:label>
        <skos:definition xml:lang="en">Subject is an activity, role, organisation or system that administers, organises or controls Object. For example, Waiting List Management manages Waiting List.</skos:definition>
        <skos:example xml:lang="en">FDA Manages Investigational Device Exemption</skos:example>
        <skos:scopeNote xml:lang="en">A conceptual association between meanings, not a measured effect in any population or setting. Actual effects, and the evidence for them, are described in RHEO and in the sources on the concept pages.</skos:scopeNote>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Navigation"/>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#modifies -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#modifies">
        <rdfs:comment xml:lang="en">Descriptive link for people to read (no inference).</rdfs:comment>
        <rdfs:label xml:lang="en">Modifies</rdfs:label>
        <skos:definition xml:lang="en">Subject is a rule, criterion, factor or weight that adjusts the value of Object, or changes when Object applies, while Object keeps its own meaning. For example, Severity Modifier modifies Cost-Effectiveness Threshold.</skos:definition>
        <skos:example xml:lang="en">Paediatric Exclusivity Modifies First Generic Entry</skos:example>
        <skos:scopeNote xml:lang="en">A conceptual association between meanings, not a measured effect in any population or setting. Actual effects, and the evidence for them, are described in RHEO and in the sources on the concept pages.</skos:scopeNote>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Navigation"/>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#optionalConceptIn -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#optionalConceptIn">
        <rdfs:label xml:lang="en">optional concept in</rdfs:label>
        <skos:definition xml:lang="en">The concept is an optional concept in this step of a learning pathway&apos;s framework.</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#performs -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#performs">
        <rdfs:comment xml:lang="en">Descriptive link for people to read (no inference).</rdfs:comment>
        <rdfs:label xml:lang="en">Performs</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000057"/>
        <skos:definition xml:lang="en">Subject, an organisation, facility or role, carries out or delivers the activity or service that is Object. For example, Third-Party Administrator performs Claims Processing.</skos:definition>
        <skos:example xml:lang="en">Hospital HTA Unit Performs Mini-HTA</skos:example>
        <skos:scopeNote xml:lang="en">A conceptual association, not a claim about a particular organisation. It records that carrying out the object is part of what the subject concept means. What actual organisations or people did is described in RHEO.</skos:scopeNote>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Navigation"/>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#prerequisiteFor -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#prerequisiteFor">
        <rdfs:comment xml:lang="en">Descriptive link for people to read (no inference).</rdfs:comment>
        <rdfs:label xml:lang="en">Prerequisite for</rdfs:label>
        <skos:definition xml:lang="en">Subject must be understood before Object can be understood or applied. A learning dependency, not a calculation input. For example, Discounting is a prerequisite for Net Present Value.</skos:definition>
        <skos:example xml:lang="en">Joint Probability Prerequisite for Bayes Theorem</skos:example>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Learning"/>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Navigation"/>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#produces -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#produces">
        <rdfs:comment xml:lang="en">Descriptive link for people to read (no inference).</rdfs:comment>
        <rdfs:label xml:lang="en">Produces</rdfs:label>
        <skos:definition xml:lang="en">Subject, a process or method, yields Object as its output. For example, Price Negotiation produces Negotiated Pricing.</skos:definition>
        <skos:example xml:lang="en">Indicator Development Produces Quality Indicator</skos:example>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Navigation"/>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#promotes -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#promotes">
        <rdfs:comment xml:lang="en">Descriptive link for people to read (no inference).</rdfs:comment>
        <rdfs:label xml:lang="en">Promotes</rdfs:label>
        <skos:definition xml:lang="en">Subject is a reward, policy, standard or organisation designed to encourage Object (intended, unlike contributesTo). For example, Orphan Exclusivity promotes Orphan Drug.</skos:definition>
        <skos:example xml:lang="en">HIQA Promotes Patient Safety</skos:example>
        <skos:scopeNote xml:lang="en">A conceptual association between meanings, not a measured effect in any population or setting. Actual effects, and the evidence for them, are described in RHEO and in the sources on the concept pages.</skos:scopeNote>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Navigation"/>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#reduces -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#reduces">
        <rdfs:comment xml:lang="en">Descriptive link for people to read (no inference).</rdfs:comment>
        <rdfs:label xml:lang="en">Reduces</rdfs:label>
        <skos:definition xml:lang="en">Subject lowers, caps or restricts the amount, frequency or use of Object. The negative counterpart of contributesTo. For example, Premium Subsidy reduces Premium.</skos:definition>
        <skos:example xml:lang="en">Health Information Block Reduces Interoperability</skos:example>
        <skos:scopeNote xml:lang="en">A conceptual association between meanings, not a measured effect in any population or setting. Actual effects, and the evidence for them, are described in RHEO and in the sources on the concept pages.</skos:scopeNote>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Navigation"/>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#represents -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#represents">
        <rdfs:comment xml:lang="en">Descriptive link for people to read (no inference).</rdfs:comment>
        <rdfs:label xml:lang="en">Represents</rdfs:label>
        <skos:definition xml:lang="en">Subject is a model, diagram, chart, symbol, model state or statistical distribution that stands for, depicts or reproduces Object in an analysis or its presentation. For example, State Transition Diagram represents Markov Model.</skos:definition>
        <skos:example xml:lang="en">Logic Model Represents Causal Pathway</skos:example>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Navigation"/>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#reviewStatus -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#reviewStatus">
        <rdfs:label xml:lang="en">review status</rdfs:label>
        <skos:definition xml:lang="en">Whether the concept&apos;s page has been reviewed and verified by a named expert on HealthEconomics.wiki.</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#setsScopeOf -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#setsScopeOf">
        <rdfs:comment xml:lang="en">Descriptive link for people to read (no inference).</rdfs:comment>
        <rdfs:label xml:lang="en">Sets the scope of</rdfs:label>
        <skos:definition xml:lang="en">Subject determines what falls inside Object, or the conditions under which Object applies. For example, Perspective sets the scope of Cost (which costs are counted).</skos:definition>
        <skos:example xml:lang="en">Market Structure Sets the scope of Cost Shifting</skos:example>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Navigation"/>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#threatensValidityOf -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#threatensValidityOf">
        <rdfs:comment xml:lang="en">Descriptive link for people to read (no inference).</rdfs:comment>
        <rdfs:label xml:lang="en">Threatens validity of</rdfs:label>
        <skos:definition xml:lang="en">Subject is a bias, error or measurement problem that undermines the accuracy or validity of Object. For example, Confounder threatens validity of Causal Inference.</skos:definition>
        <skos:example xml:lang="en">Misclassification Threatens validity of Real-World Evidence</skos:example>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Navigation"/>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#uses -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#uses">
        <rdfs:comment xml:lang="en">Descriptive link for people to read (no inference).</rdfs:comment>
        <rdfs:label xml:lang="en">Uses</rdfs:label>
        <skos:definition xml:lang="en">Subject employs Object as a technique, model, or input.</skos:definition>
        <skos:example xml:lang="en">Health in All Policies Uses Intersectoral Action</skos:example>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Navigation"/>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#verifiedBy -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#verifiedBy">
        <rdfs:label xml:lang="en">verified by</rdfs:label>
        <skos:definition xml:lang="en">The expert who last verified the concept&apos;s page.</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2004/02/skos/core#broader -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2004/02/skos/core#broader"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#exactMatch -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2004/02/skos/core#exactMatch"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#hasTopConcept -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2004/02/skos/core#hasTopConcept"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#inScheme -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2004/02/skos/core#inScheme"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#narrower -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2004/02/skos/core#narrower"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#related -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2004/02/skos/core#related"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#topConceptOf -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2004/02/skos/core#topConceptOf"/>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#calculatedFrom -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#calculatedFrom">
        <owl:inverseOf rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <rdfs:label xml:lang="en">Calculated from</rdfs:label>
        <skos:definition xml:lang="en">Inverse of &apos;Used to calculate&apos;.</skos:definition>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#FormalInference"/>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Navigation"/>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#classifiedUnder -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#classifiedUnder">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <rdfs:label xml:lang="en">classified under</rdfs:label>
        <skos:definition xml:lang="en">Places a concept in the subject structure of HealthEconomics.wiki (Health Economics, its subdomains and the concepts under them) when the concept has no is-type-of parent. It is a placement for finding and browsing, not a claim that the concept is a type of the concept it sits under.</skos:definition>
        <skos:example xml:lang="en">Literature Search classified under Evidence Synthesis</skos:example>
        <skos:scopeNote xml:lang="en">Placement comes from the wiki&apos;s live topic pages and, for concepts no topic lists, from the catalogue Level 1, 2 and 3 fields through a published mapping table. Each heo:classifiedUnder link is also stated as skos:broader, so SKOS tools that do not reason still show one tree. To read only is-type-of links, take the skos:broader links that are not also heo:classifiedUnder links.</skos:scopeNote>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Navigation"/>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#follows -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#follows">
        <owl:inverseOf rdf:resource="https://healtheconomics.wiki/ontologies/heo#precedes"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label xml:lang="en">Follows</rdfs:label>
        <skos:definition xml:lang="en">Inverse of &apos;Precedes&apos;.</skos:definition>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#FormalInference"/>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Navigation"/>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#hasPart -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#hasPart">
        <owl:inverseOf rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <rdfs:label xml:lang="en">Has part</rdfs:label>
        <skos:definition xml:lang="en">Inverse of &apos;Part of&apos;.</skos:definition>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#FormalInference"/>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Navigation"/>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#hasRiskFactor -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#hasRiskFactor">
        <owl:inverseOf rdf:resource="https://healtheconomics.wiki/ontologies/heo#riskFactorFor"/>
        <rdfs:label xml:lang="en">Has risk factor</rdfs:label>
        <skos:definition xml:lang="en">Inverse of &apos;Risk factor for&apos;.</skos:definition>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#FormalInference"/>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Navigation"/>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#isTypeOf -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#isTypeOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <rdfs:label xml:lang="en">is type of</rdfs:label>
        <skos:definition xml:lang="en">The subject concept is a kind of the object concept (the wiki&apos;s is type of link). Every heo:isTypeOf link is also stated as skos:broader.</skos:definition>
        <skos:example xml:lang="en">Logistic Regression is type of Generalized Linear Model</skos:example>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#FormalInference"/>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Navigation"/>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#measuredBy -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#measuredBy">
        <owl:inverseOf rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <rdfs:label xml:lang="en">Measured by</rdfs:label>
        <skos:definition xml:lang="en">Inverse of &apos;Measures&apos;.</skos:definition>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#FormalInference"/>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Navigation"/>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#measures -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#measures">
        <rdfs:comment xml:lang="en">Object property with inverse heo:measuredBy.</rdfs:comment>
        <rdfs:label xml:lang="en">Measures</rdfs:label>
        <skos:definition xml:lang="en">Subject quantifies or assesses the construct/quantity Object.</skos:definition>
        <skos:example xml:lang="en">Interaction Effect Measures Interaction</skos:example>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#FormalInference"/>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Navigation"/>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#partOf -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#partOf">
        <rdfs:comment xml:lang="en">Aligned in intent to ro:part_of. Object property with inverse heo:hasPart.</rdfs:comment>
        <rdfs:label xml:lang="en">Part of</rdfs:label>
        <skos:definition xml:lang="en">Subject is a component/constituent of Object.</skos:definition>
        <skos:example xml:lang="en">Levels of Care Part of Health System</skos:example>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#FormalInference"/>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Navigation"/>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#precedes -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#precedes">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:comment xml:lang="en">Aligned in intent to ro:precedes. Object property with inverse heo:follows. Transitive.</rdfs:comment>
        <rdfs:label xml:lang="en">Precedes</rdfs:label>
        <skos:definition xml:lang="en">Subject occurs before Object in a temporal or care sequence.</skos:definition>
        <skos:example xml:lang="en">Literature Search Precedes Study Selection</skos:example>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#FormalInference"/>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Navigation"/>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#riskFactorFor -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#riskFactorFor">
        <rdfs:comment xml:lang="en">Object property with inverse heo:hasRiskFactor.</rdfs:comment>
        <rdfs:label xml:lang="en">Risk factor for</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000001"/>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000003"/>
        <skos:definition xml:lang="en">Subject raises the probability of the outcome/disease Object.</skos:definition>
        <skos:example xml:lang="en">Contraindication Risk factor for Adverse Event</skos:example>
        <skos:scopeNote xml:lang="en">A conceptual association, not an estimate of risk in any population. Read &apos;Heart Failure risk factor for Readmission&apos; as a recognised association in the literature. It records that the literature treats the subject as a recognised risk factor for the object. Actual exposures, outcomes and estimated effects are described in RHEO.</skos:scopeNote>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#FormalInference"/>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Navigation"/>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#treatedBy -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#treatedBy">
        <owl:inverseOf rdf:resource="https://healtheconomics.wiki/ontologies/heo#treats"/>
        <rdfs:label xml:lang="en">Treated by</rdfs:label>
        <skos:definition xml:lang="en">Inverse of &apos;Treats&apos;.</skos:definition>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#FormalInference"/>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Navigation"/>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#treats -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#treats">
        <rdfs:comment xml:lang="en">Object property with inverse heo:treatedBy.</rdfs:comment>
        <rdfs:label xml:lang="en">Treats</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000001"/>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000003"/>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000029"/>
        <skos:definition xml:lang="en">Subject is used to treat the condition Object.</skos:definition>
        <skos:example xml:lang="en">Monoclonal Antibody Treats Rheumatoid Arthritis</skos:example>
        <skos:scopeNote xml:lang="en">A conceptual association, not a claim about a particular patient or provider. Read &apos;Cardiac Resynchronization treats Heart Failure&apos; as: treating heart failure is part of what the concept Cardiac Resynchronization means. The concept itself treats no one; actual patients, devices and episodes of care are described in RHEO.</skos:scopeNote>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#FormalInference"/>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Navigation"/>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heo#usedToCalculate -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heo#usedToCalculate">
        <rdfs:comment xml:lang="en">Object property with inverse heo:calculatedFrom.</rdfs:comment>
        <rdfs:label xml:lang="en">Used to calculate</rdfs:label>
        <skos:definition xml:lang="en">Subject is an input from which Object is computed.</skos:definition>
        <skos:example xml:lang="en">Health Price Index Used to calculate Real Cost</skos:example>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#FormalInference"/>
        <applicationUse rdf:resource="https://healtheconomics.wiki/ontologies/heo#Navigation"/>
    </owl:ObjectProperty>
    


