    <!-- https://healtheconomics.wiki/concept/patient-activation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/patient-activation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:notation>HE-ES-CO-053</skos:notation>
        <dcterms:identifier>HE-ES-CO-053</dcterms:identifier>
        <dcterms:source>Hibbard et al. 2004</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Patient Activation</rdfs:label>
        <skos:definition xml:lang="en">A measure of a patient&apos;s knowledge, skill, and confidence in managing their own health and healthcare, captured using a standardised questionnaire.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Activation Level</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Patient Empowerment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Patient Activation</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/self-management"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/patient-activation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-9192d83cb544</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Clinical Outcomes: concepts with this Level 3 that the wiki places in a topic sit in Outcomes (Clinical and patient-reported outcomes)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/patient-activation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/self-management"/>
        <dcterms:identifier>HEO-L-2081ae2c1ed0</dcterms:identifier>
        <linkRationale xml:lang="en">Activated patients engage more in self-management (Hibbard et al. 2004)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
