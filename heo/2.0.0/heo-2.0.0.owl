    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/optimized-recommendation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/optimized-recommendation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/positive-recommendation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/positive-recommendation"/>
        <skos:notation>HS-HP-HTA-137</skos:notation>
        <dcterms:identifier>HS-HP-HTA-137</dcterms:identifier>
        <dcterms:source>National Institute for Health and Care Excellence. NICE technology appraisal and highly specialised technologies guidance: the manual (PMG36). Published 2022; updated 2026.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Optimized Recommendation</rdfs:label>
        <skos:altLabel xml:lang="en">Optimised Recommendation</skos:altLabel>
        <skos:definition xml:lang="en">A decision recommending a technology for funding only within a narrower patient subgroup than its full licensed population, typically the most cost-effective subgroup.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Restricted Positive Recommendation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Optimized Recommendation</skos:prefLabel>
        <counterpartOf rdf:resource="https://healtheconomics.wiki/concept/restricted-listing"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/subgroup-analysis"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/optimized-recommendation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/positive-recommendation"/>
        <dcterms:identifier>HEO-L-99f014917a90</dcterms:identifier>
        <linkRationale xml:lang="en">An optimised recommendation recommends funding, restricted to a subgroup</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
