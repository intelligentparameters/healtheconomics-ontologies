    <!-- https://healtheconomics.wiki/concept/equity-efficiency-trade-off -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/equity-efficiency-trade-off">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/opportunity-cost"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/trade-off"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/opportunity-cost"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/trade-off"/>
        <skos:notation>HE-EE-WE-051</skos:notation>
        <dcterms:identifier>HE-EE-WE-051</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-03</dcterms:modified>
        <dcterms:source>Cookson et al. 2017</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Equity-Efficiency Trade-off</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:altLabel xml:lang="en">Efficiency-Equity Trade-off</skos:altLabel>
        <skos:altLabel xml:lang="en">Equity and Efficiency Trade-off</skos:altLabel>
        <skos:altLabel xml:lang="en">Equity-Efficiency Tradeoff</skos:altLabel>
        <skos:definition xml:lang="en">The equity-efficiency trade-off is the total health given up for a fairer distribution when the option that maximises health is not the fairest one.</skos:definition>
        <skos:prefLabel xml:lang="en">Equity-Efficiency Trade-off</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-policy#step-4"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/equity-efficiency-trade-off"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/opportunity-cost"/>
        <dcterms:identifier>HEO-L-082c2fd5bf98</dcterms:identifier>
        <linkRationale xml:lang="en">The trade-off is the health given up for fairness, an opportunity cost</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/equity-efficiency-trade-off"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/trade-off"/>
        <dcterms:identifier>HEO-L-020c1b835083</dcterms:identifier>
        <linkRationale xml:lang="en">Gaining equity at the cost of total health is a trade-off</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/equity-gap -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/equity-gap">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-inequity"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-inequity"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/health-equity"/>
        <skos:notation>HS-SS-EQ-002</skos:notation>
        <dcterms:identifier>HS-SS-EQ-002</dcterms:identifier>
        <dcterms:source>Whitehead 1992</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Equity Gap</rdfs:label>
        <skos:definition xml:lang="en">The observed difference in health outcomes, access, or financing burden between population subgroups that is considered unfair or avoidable.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Avoidable Disparity</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Fairness Gap</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Equity Gap</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/equity-gap"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-inequity"/>
        <dcterms:identifier>HEO-L-614f81bec479</dcterms:identifier>
        <linkRationale xml:lang="en">An equity gap is a difference judged unfair or avoidable, which is health inequity; inequality is defined without that judgement</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/equity-gap"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-equity"/>
        <dcterms:identifier>HEO-L-192c653e54c8</dcterms:identifier>
        <linkRationale xml:lang="en">The size of an unfair gap quantifies distance from health equity</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/equity-weighted-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/equity-weighted-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
