        <skos:altLabel xml:lang="en">Co-Primary Endpoint</skos:altLabel>
        <skos:altLabel xml:lang="en">Coprimary Outcome</skos:altLabel>
        <skos:definition xml:lang="en">A co-primary outcome is one of two or more primary outcomes in a trial, each of which must show a significant treatment effect for the trial to succeed.</skos:definition>
        <skos:prefLabel xml:lang="en">Co-Primary Outcome</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/composite-endpoint"/>
