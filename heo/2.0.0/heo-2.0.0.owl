    <!-- https://healtheconomics.wiki/concept/short-term-outcome -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/short-term-outcome">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcome-measure"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/outcome-measure"/>
        <skos:notation>HE-ES-PRO-025</skos:notation>
        <dcterms:identifier>HE-ES-PRO-025</dcterms:identifier>
        <dcterms:source>U.S. Food and Drug Administration. Guidance for Industry: Patient-Reported Outcome Measures-Use in Medical Product Development to Support Labeling Claims. FDA; 2009.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Short-Term Outcome</rdfs:label>
        <skos:altLabel xml:lang="en">Immediate Outcome</skos:altLabel>
        <skos:definition xml:lang="en">A clinical or economic outcome observed within a relatively brief period after treatment starts, unlike a long-term outcome requiring extended follow-up.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Early Outcome</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Near-Term Outcome</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Proximal Outcome</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Short-Run Outcome</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Short-Term Outcome</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/long-term-outcome"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/short-term-outcome"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/outcome-measure"/>
        <dcterms:identifier>HEO-L-08ec6337be38</dcterms:identifier>
        <linkRationale xml:lang="en">A short-term outcome is an outcome measured at an early time point.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/short-term-outcome"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/long-term-outcome"/>
        <dcterms:identifier>HEO-L-46934d2b1e18</dcterms:identifier>
