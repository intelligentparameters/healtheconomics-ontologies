        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Autoregressive Correlation</rdfs:label>
        <owl:versionInfo>1.0.3</owl:versionInfo>
        <skos:altLabel xml:lang="en">AR Correlation Structure</skos:altLabel>
        <skos:definition xml:lang="en">Autoregressive correlation is a structure for repeated measures in which correlation falls by a constant factor with each time step between measurements.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Autoregressive Structure</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Autoregressive Correlation</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/exchangeable-correlation"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/unstructured-correlation"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/autoregressive-correlation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/working-correlation"/>
        <dcterms:identifier>HEO-L-a3445b0ec9d1</dcterms:identifier>
        <linkRationale xml:lang="en">AR(1) is a working correlation structure</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
