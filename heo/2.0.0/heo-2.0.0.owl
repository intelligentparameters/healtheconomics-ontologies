    <!-- https://healtheconomics.wiki/concept/funnel-plot -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/funnel-plot">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/small-study-effects"/>
        <skos:notation>HE-ES-ESM-023</skos:notation>
        <dcterms:identifier>HE-ES-ESM-023</dcterms:identifier>
        <dcterms:source>Light &amp; Pillemer 1984</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Funnel Plot</rdfs:label>
        <skos:definition xml:lang="en">A scatter plot assessing potential publication bias by plotting each study&apos;s effect estimate against its precision, expecting symmetry if unbiased.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Funnel Diagram</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Precision-Effect Plot</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Funnel Plot</skos:prefLabel>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/publication-bias"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/funnel-plot"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-f141ea665120</dcterms:identifier>
