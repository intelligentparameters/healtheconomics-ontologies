    <!-- https://healtheconomics.wiki/concept/social-norm-intervention -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/social-norm-intervention">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/nudge-intervention"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/nudge-intervention"/>
        <skos:notation>HE-EE-BE-037</skos:notation>
        <dcterms:identifier>HE-EE-BE-037</dcterms:identifier>
        <dcterms:source>Cialdini &amp; Goldstein 2004</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Social Norm Intervention</rdfs:label>
        <skos:definition xml:lang="en">An intervention that tells people about the behaviour or attitudes of others to influence their own behaviour.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Normative Feedback</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Social Norms Nudge</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Social Norm Intervention</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/social-norm-intervention"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/nudge-intervention"/>
        <dcterms:identifier>HEO-L-b5549e668995</dcterms:identifier>
        <linkRationale xml:lang="en">Social norm messages alter behaviour without restricting options, a nudge.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/social-norms-concept -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/social-norms-concept">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/behavioural-economics"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/behavioural-economics"/>
        <skos:notation>HE-EE-BE-038</skos:notation>
        <dcterms:identifier>HE-EE-BE-038</dcterms:identifier>
        <dcterms:source>Cialdini &amp; Goldstein 2004</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Social Norms Concept</rdfs:label>
        <skos:altLabel xml:lang="en">Social Norms</skos:altLabel>
        <skos:definition xml:lang="en">A theory that behaviour is shaped by perceived descriptive norms, what others actually do, and injunctive norms, what others approve of.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Descriptive Norms</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Social Norms Concept</skos:prefLabel>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/social-norm-intervention"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
