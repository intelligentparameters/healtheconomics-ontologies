    <!-- https://healtheconomics.wiki/concept/cost-sharing-agreement -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cost-sharing-agreement">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/managed-entry-agreement"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/managed-entry-agreement"/>
        <skos:notation>HS-DC-MA-004</skos:notation>
        <dcterms:identifier>HS-DC-MA-004</dcterms:identifier>
        <dcterms:source>Carlson JJ, Sullivan SD, Garrison LP, Neumann PJ, Veenstra DL. Linking payment to health outcomes: a taxonomy and examination of performance-based reimbursement schemes. Health Policy. 2010;96(3):179-190.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cost Sharing Agreement</rdfs:label>
        <skos:altLabel xml:lang="en">Cost-Sharing Agreement</skos:altLabel>
        <skos:definition xml:lang="en">An arrangement dividing a treatment&apos;s cost burden between payer and manufacturer according to a predefined formula, managing affordability within a fixed budget.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Payer-Manufacturer Cost Split</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cost Sharing Agreement</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/budget-impact"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cost-sharing-agreement"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/managed-entry-agreement"/>
        <dcterms:identifier>HEO-L-702d9c4cff0e</dcterms:identifier>
        <linkRationale xml:lang="en">A financial-based managed entry agreement dividing cost by formula</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cost-sharing-agreement"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/budget-impact"/>
        <dcterms:identifier>HEO-L-d8d8cd882ab1</dcterms:identifier>
