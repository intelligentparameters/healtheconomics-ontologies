        <skos:altLabel xml:lang="en">MCDA</skos:altLabel>
        <skos:definition xml:lang="en">Multi-criteria decision analysis is a family of structured methods that compares alternatives across multiple explicit criteria and incorporates judgments about the trade-offs among them.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Multi-Criteria Analysis HTA</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Multi-Criteria Appraisal</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Multi-Criteria Decision Analysis</skos:prefLabel>
