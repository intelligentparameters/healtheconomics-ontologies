        <dcterms:identifier>HE-PE-CP-004</dcterms:identifier>
        <dcterms:source>Rowland &amp; Tozer 2010</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Drug Metabolism</rdfs:label>
        <skos:altLabel xml:lang="en">Biotransformation</skos:altLabel>
        <skos:definition xml:lang="en">The biochemical process by which the body chemically alters a drug, typically via liver enzymes, into forms more easily eliminated.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Metabolic Processing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Drug Metabolism</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/drug-clearance"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/hepatotoxicity"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/drug-metabolism"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-b45b76cf8b30</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Pharmacoeconomics &gt; Clinical Pharmacology: pharmacokinetic and dosing terms describe the clinical evidence behind a treatment effect</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/drug-metabolism"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
