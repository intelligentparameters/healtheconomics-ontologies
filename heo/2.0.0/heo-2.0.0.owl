    <!-- https://healtheconomics.wiki/concept/value-based-assessment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/value-based-assessment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/value-assessment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/value-assessment"/>
        <skos:notation>HS-NHS-VBH-030</skos:notation>
        <dcterms:identifier>HS-NHS-VBH-030</dcterms:identifier>
        <dcterms:source>Porter 2010</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Value-Based Assessment</rdfs:label>
        <skos:definition xml:lang="en">An evaluation approach explicitly centring the relationship between a technology&apos;s outcomes and cost, potentially incorporating multiple value dimensions.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Multi-Dimensional Value Assessment</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Value-Based Appraisal</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Value-Based Assessment</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/multi-criteria-decision-analysis"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/value-framework"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/value-based-assessment"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/value-assessment"/>
        <dcterms:identifier>HEO-L-a4888e6d696e</dcterms:identifier>
        <linkRationale xml:lang="en">Value-based assessment is a value assessment.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/value-based-assessment"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/multi-criteria-decision-analysis"/>
        <dcterms:identifier>HEO-L-31369e76aad5</dcterms:identifier>
        <linkRationale xml:lang="en">MCDA is a standard way to combine multiple value dimensions.</linkRationale>
