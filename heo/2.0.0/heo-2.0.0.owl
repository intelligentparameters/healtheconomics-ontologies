    <!-- https://healtheconomics.wiki/concept/cost-effective-intervention -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cost-effective-intervention">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/intervention"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/intervention"/>
        <skos:notation>HE-EE-CEA-007</skos:notation>
        <dcterms:identifier>HE-EE-CEA-007</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cost-Effective Intervention</rdfs:label>
        <skos:definition xml:lang="en">An intervention whose additional cost relative to its comparator is acceptable given its additional health benefit, judged against a cost-effectiveness threshold.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Efficient Intervention</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Good-Value Intervention</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cost-Effective Intervention</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cost-effective-intervention"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/intervention"/>
        <dcterms:identifier>HEO-L-84087ebf1269</dcterms:identifier>
        <linkRationale xml:lang="en">An intervention</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/cost-effectiveness -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cost-effectiveness">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/efficiency"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/efficiency"/>
