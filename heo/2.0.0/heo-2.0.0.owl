    <!-- https://healtheconomics.wiki/concept/development-assistance-for-health -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/development-assistance-for-health">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/donor-funding"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/donor-funding"/>
        <skos:notation>HS-SS-GH-004</skos:notation>
        <dcterms:identifier>HS-SS-GH-004</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</dcterms:modified>
        <dcterms:source>Ravishankar et al. 2009</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Development Assistance for Health</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:altLabel xml:lang="en">DAH</skos:altLabel>
        <skos:altLabel xml:lang="en">Health Aid</skos:altLabel>
        <skos:definition xml:lang="en">Development assistance for health (DAH) is the grants, loans and in-kind aid for health that development agencies give to low- and middle-income countries.</skos:definition>
        <skos:prefLabel xml:lang="en">Development Assistance for Health</skos:prefLabel>
        <abbreviation xml:lang="en">DAH</abbreviation>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/fiscal-space"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/population-health"/>
