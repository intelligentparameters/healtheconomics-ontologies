        <dcterms:identifier>HS-HP-HD-033</dcterms:identifier>
        <dcterms:source>AHA, American Hospital Association</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Day Surgery</rdfs:label>
        <skos:altLabel xml:lang="en">Ambulatory Surgery</skos:altLabel>
        <skos:altLabel xml:lang="en">Day-Case Surgery</skos:altLabel>
        <skos:altLabel xml:lang="en">Outpatient Surgery</skos:altLabel>
