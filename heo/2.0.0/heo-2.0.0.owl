    <!-- https://healtheconomics.wiki/concept/flexible-budget -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/flexible-budget">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/operating-budget"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/operating-budget"/>
        <skos:notation>HE-EE-BIA-034</skos:notation>
        <dcterms:identifier>HE-EE-BIA-034</dcterms:identifier>
        <dcterms:source>Horngren, Datar &amp; Rajan 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Flexible Budget</rdfs:label>
        <skos:altLabel xml:lang="en">Variable Budget</skos:altLabel>
        <skos:definition xml:lang="en">A budget that adjusts automatically according to actual levels of activity or service volume, rather than staying fixed.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Activity-Adjusted Budget</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Flexible Budget</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/flexible-budget"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/operating-budget"/>
        <dcterms:identifier>HEO-L-37b099d8e9c0</dcterms:identifier>
        <linkRationale xml:lang="en">Flexible budgets are operating budgets restated for actual activity</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/flexible-parametric-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/flexible-parametric-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/parametric-survival-model"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/parametric-survival-model"/>
        <skos:notation>HE-EM-SM-023</skos:notation>
        <dcterms:identifier>HE-EM-SM-023</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-23</dcterms:modified>
        <dcterms:source>Royston &amp; Parmar 2002</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Flexible Parametric Model</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A flexible parametric model is a fully specified regression model that represents a transformed survival function with smooth functions of time, commonly restricted cubic splines, so complex hazards and time-varying effects can be estimated and extrapolated.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Flexible Hazard Model</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Spline-Based Survival Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Flexible Parametric Model</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/exponential-model"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/piecewise-model"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/restricted-cubic-spline"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/flexible-parametric-model"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/parametric-survival-model"/>
        <dcterms:identifier>HEO-L-a4c17dcb12f5</dcterms:identifier>
        <linkRationale xml:lang="en">A flexible parametric model is a parametric survival model</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/flexible-parametric-model"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/exponential-model"/>
        <dcterms:identifier>HEO-L-829462ab8b05</dcterms:identifier>
        <linkRationale xml:lang="en">Flexible splines versus a constant-hazard model are alternative extrapolation choices</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
