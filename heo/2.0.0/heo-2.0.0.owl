        <informs rdf:resource="https://healtheconomics.wiki/concept/resource-allocation"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/benefit-cost-ratio"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/net-benefit"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/return-on-investment"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/benefit-transfer"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/net-present-value"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/present-value"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/shadow-price"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/willingness-to-pay"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
