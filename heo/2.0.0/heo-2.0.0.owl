        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/unit-cost"/>
        <skos:notation>HE-EE-CM-007</skos:notation>
        <dcterms:identifier>HE-EE-CM-007</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-09</dcterms:modified>
        <dcterms:source>Mogyorosy &amp; Smith 2005</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Common Cost Allocation</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Common cost allocation is the division of a cost shared by several health services, such as overheads or a joint input, among them by a chosen rule.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Joint Cost Allocation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Shared Cost Allocation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Common Cost Allocation</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/joint-cost"/>
