    <!-- https://healtheconomics.wiki/concept/best-interest-standard -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/best-interest-standard">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/ethical-standards"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/ethical-standards"/>
        <skos:notation>HS-HP-HD-014</skos:notation>
        <dcterms:identifier>HS-HP-HD-014</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Mental Capacity Act 2005; Paquette and Ross 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Best Interest Standard</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Best Interests Principle</skos:altLabel>
        <skos:definition xml:lang="en">The best interest standard requires healthcare decisions for a patient lacking capacity, such as a young child, to be those that best serve their welfare.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Patient Best-Interest Test</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Best Interest Standard</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/substituted-judgment"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/best-interest-standard"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/ethical-standards"/>
        <dcterms:identifier>HEO-L-a3d4f7a02115</dcterms:identifier>
        <linkRationale xml:lang="en">A principle of professional conduct</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
