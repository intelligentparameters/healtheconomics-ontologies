    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/disinvestment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/disinvestment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/resource-allocation"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q5282250"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/resource-allocation"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/resource-reallocation"/>
        <precedes rdf:resource="https://healtheconomics.wiki/concept/reinvestment"/>
        <skos:notation>HS-HP-HF-019</skos:notation>
        <dcterms:identifier>HS-HP-HF-019</dcterms:identifier>
        <dcterms:source>Elshaug et al. 2012</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Disinvestment</rdfs:label>
        <skos:definition xml:lang="en">The deliberate withdrawal of funding from a healthcare service or technology found to provide low value or since superseded by a better alternative.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Divestment</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Funding Withdrawal</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Disinvestment</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/technological-imperative"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/low-value-care"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/obsolete-technology"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/disinvestment-framework"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/disinvestment"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/resource-allocation"/>
        <dcterms:identifier>HEO-L-68294c81f8ed</dcterms:identifier>
        <linkRationale xml:lang="en">withdrawing funding from low-value care reallocates resources</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/disinvestment"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/resource-reallocation"/>
        <dcterms:identifier>HEO-L-e1be2cfb99a5</dcterms:identifier>
        <linkRationale xml:lang="en">Disinvestment from low-value care is the withdrawal half of reallocation, not its opposite.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/disinvestment"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#precedes"/>
