        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome-assessment"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q7144954"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome-assessment"/>
