        <rdfs:label xml:lang="en">Medical Underwriting</rdfs:label>
        <skos:definition xml:lang="en">A practice where an insurer assesses an applicant&apos;s health status to determine coverage and pricing, historically used before regulatory reforms restricted it.</skos:definition>
