    <!-- https://healtheconomics.wiki/concept/research-risk -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/research-risk">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/risk"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/risk"/>
        <skos:notation>HS-HP-HSG-029</skos:notation>
        <dcterms:identifier>HS-HP-HSG-029</dcterms:identifier>
        <dcterms:source>National Commission, Belmont Report 1979</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Research Risk</rdfs:label>
        <skos:definition xml:lang="en">The potential for physical, psychological, social, or economic harm a participant may experience from taking part in a study.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Participant Risk</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Study Risk</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Research Risk</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/informed-consent-for-research"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/research-risk"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/risk"/>
        <dcterms:identifier>HEO-L-93c092f41c12</dcterms:identifier>
        <linkRationale xml:lang="en">Research risk is a risk of harm to participants.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/research-risk"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/informed-consent-for-research"/>
        <dcterms:identifier>HEO-L-ca870aba2445</dcterms:identifier>
