    <!-- https://healtheconomics.wiki/concept/convenience-outcome -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/convenience-outcome">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcome-measure"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/outcome-measure"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/treatment-satisfaction"/>
        <skos:notation>HE-ES-CO-014</skos:notation>
        <dcterms:identifier>HE-ES-CO-014</dcterms:identifier>
        <dcterms:source>U.S. Food and Drug Administration. Guidance for Industry: Patient-Reported Outcome Measures-Use in Medical Product Development to Support Labeling Claims. FDA; 2009.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Convenience Outcome</rdfs:label>
        <skos:definition xml:lang="en">A clinical outcome measure capturing the ease or burden of a treatment&apos;s administration, such as dosing frequency, distinct from its clinical efficacy.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Administration-Burden Outcome</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Convenience Endpoint</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Convenience Outcome</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/convenience-outcome"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/outcome-measure"/>
        <dcterms:identifier>HEO-L-4a5cf887b48e</dcterms:identifier>
        <linkRationale xml:lang="en">Ease of administration is not how a patient feels, functions or survives (the Clinical Outcome definition); it is an outcome measure</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/convenience-outcome"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/treatment-satisfaction"/>
        <dcterms:identifier>HEO-L-73bbeab47190</dcterms:identifier>
        <linkRationale xml:lang="en">Treatment Satisfaction definition lists convenience as a component.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/convergence -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/convergence">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:notation>HE-EM-UA-014</skos:notation>
        <dcterms:identifier>HE-EM-UA-014</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Gelman &amp; Rubin 1992</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Convergence</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:definition xml:lang="en">Convergence is the point at which an MCMC run or other iterative simulation settles on a stable result as the number of iterations increases.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Algorithm Settling</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Iterative Stabilisation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Convergence</skos:prefLabel>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/markov-chain-monte-carlo"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-10"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/convergence"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-fdeff56cac1d</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Uncertainty and sensitivity analysis in subdomain Economic Modelling</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/convergence"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isPropertyOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/markov-chain-monte-carlo"/>
        <dcterms:identifier>HEO-L-1e6084b9ce3d</dcterms:identifier>
        <linkRationale xml:lang="en">Convergence is a characteristic of an MCMC run, not a component (subject definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/convergence-assessment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/convergence-assessment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/model-validation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/model-validation"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/markov-chain-monte-carlo"/>
        <skos:notation>HE-EM-MV-012</skos:notation>
        <dcterms:identifier>HE-EM-MV-012</dcterms:identifier>
        <dcterms:source>Gelman &amp; Rubin 1992</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Convergence Assessment</rdfs:label>
        <skos:altLabel xml:lang="en">Convergence Diagnostics</skos:altLabel>
        <skos:definition xml:lang="en">An evaluation of whether an iterative algorithm, such as a Markov chain Monte Carlo simulation, has run enough iterations to produce stable results.</skos:definition>
        <skos:hiddenLabel xml:lang="en">MCMC Diagnostics</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Convergence Assessment</skos:prefLabel>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/convergence"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/model-validation"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/convergence-assessment"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/model-validation"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-48a560302632</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Modelling &gt; Model Validation: catalogue subdomain Economic Modelling is one of the subdomains; placed under Model Validation, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
