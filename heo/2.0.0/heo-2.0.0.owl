        <skos:notation>HE-EM-SM-054</skos:notation>
        <dcterms:identifier>HE-EM-SM-054</dcterms:identifier>
        <dcterms:source>Collett 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Monotonic Hazard</rdfs:label>
        <skos:altLabel xml:lang="en">Monotone Hazard</skos:altLabel>
        <skos:definition xml:lang="en">A hazard function that either consistently rises or consistently falls over the entire modelled period, without reversing direction.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Increasing-or-Decreasing Hazard</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Monotonic Hazard</skos:prefLabel>
