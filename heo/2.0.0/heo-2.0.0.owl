    <!-- https://healtheconomics.wiki/concept/factor-prioritisation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/factor-prioritisation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/global-sensitivity-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
