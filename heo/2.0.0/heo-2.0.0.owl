        <rdfs:label xml:lang="en">Case Fatality Rate</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">CFR</skos:altLabel>
        <skos:altLabel xml:lang="en">Case Fatality Ratio</skos:altLabel>
        <skos:definition xml:lang="en">Case fatality rate (CFR) is the proportion of people diagnosed with a disease who die of it within a defined period, a measure of severity.</skos:definition>
        <skos:prefLabel xml:lang="en">Case Fatality Rate</skos:prefLabel>
        <abbreviation xml:lang="en">CFR</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/cause-specific-mortality"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/mortality-rate"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/case-fatality-rate"/>
