    <!-- https://healtheconomics.wiki/concept/regulation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/regulation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/government-intervention"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/government-intervention"/>
        <skos:notation>HE-EE-EP-031</skos:notation>
        <dcterms:identifier>HE-EE-EP-031</dcterms:identifier>
        <dcterms:source>Stigler 1971</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Regulation</rdfs:label>
        <skos:definition xml:lang="en">Government-imposed rules governing the conduct of private actors, intended to correct market failures such as information asymmetry, externalities, or market power.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Rule-Making</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Statutory Oversight</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Regulation</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/regulatory-cost"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/regulation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/government-intervention"/>
        <dcterms:identifier>HEO-L-8be51607f0fa</dcterms:identifier>
        <linkRationale xml:lang="en">Regulation is a form of government action to correct market failure.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/regulation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/regulatory-cost"/>
        <dcterms:identifier>HEO-L-a0952b059d29</dcterms:identifier>
        <linkRationale xml:lang="en">Regulation imposes the compliance costs that make up regulatory cost; a cost is not a component of rules</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/regulatory-agency -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/regulatory-agency">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
