    <!-- https://healtheconomics.wiki/concept/agent-based-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/agent-based-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/simulation-model"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q392811"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
