    <!-- https://healtheconomics.wiki/concept/gross-to-net -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/gross-to-net">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/net-price"/>
        <skos:notation>HS-DC-DP-037</skos:notation>
        <dcterms:identifier>HS-DC-DP-037</dcterms:identifier>
        <dcterms:source>CMS, Medicaid Drug Rebate Program</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Gross-to-Net</rdfs:label>
        <skos:definition xml:lang="en">The overall reduction from a drug&apos;s publicly listed gross price to the actual net price realised after rebates and discounts.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Gross-Net Reduction</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">List-to-Net Reduction</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Gross-to-Net</skos:prefLabel>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
