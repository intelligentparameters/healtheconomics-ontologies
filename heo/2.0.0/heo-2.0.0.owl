        <dcterms:identifier>HEO-L-28f959604f39</dcterms:identifier>
        <linkRationale xml:lang="en">Accuracy equals sensitivity times prevalence plus specificity times one minus prevalence</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
