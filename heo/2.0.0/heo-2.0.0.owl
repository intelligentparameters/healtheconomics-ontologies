    <!-- https://healtheconomics.wiki/concept/group-sequential-design -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/group-sequential-design">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/adaptive-trial-design"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/sequential-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/adaptive-trial-design"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/sequential-analysis"/>
        <skos:notation>HE-ES-CTM-037</skos:notation>
        <dcterms:identifier>HE-ES-CTM-037</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-24</dcterms:modified>
