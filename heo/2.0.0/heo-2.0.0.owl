    <!-- https://healtheconomics.wiki/concept/runge-kutta-method -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/runge-kutta-method">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/numerical-method"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q725944"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/numerical-method"/>
        <skos:notation>CS-DE-NOM-002</skos:notation>
        <dcterms:identifier>CS-DE-NOM-002</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Butcher JC. Numerical Methods for Ordinary Differential Equations. 3rd ed. Wiley; 2016. doi:10.1002/9781119121534.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Runge-Kutta Method</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">RK Method</skos:altLabel>
        <skos:altLabel xml:lang="en">Runge-Kutta Integration</skos:altLabel>
        <skos:definition xml:lang="en">A Runge-Kutta method is a one-step numerical scheme for approximating the solution of an ordinary differential equation by combining several derivative evaluations within each integration step.</skos:definition>
        <skos:prefLabel xml:lang="en">Runge-Kutta Method</skos:prefLabel>
        <abbreviation xml:lang="en">RK Method</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/euler-method"/>
