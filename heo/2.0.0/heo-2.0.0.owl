        <skos:definition xml:lang="en">An event with the potential to cause patient harm that did not actually result in injury, through intervention or chance.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Averted Incident</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Error Interception</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Near-Miss Interception</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Near Miss</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/adverse-event"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/patient-safety"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/near-miss"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
