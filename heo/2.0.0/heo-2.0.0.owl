    <!-- https://healtheconomics.wiki/concept/evidence-generation-plan -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/evidence-generation-plan">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/real-world-evidence"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/real-world-evidence"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/conditional-coverage"/>
        <skos:notation>HE-ES-RWE-004</skos:notation>
        <dcterms:identifier>HE-ES-RWE-004</dcterms:identifier>
        <dcterms:source>Makady et al. 2017</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Evidence Generation Plan</rdfs:label>
        <skos:definition xml:lang="en">A prospectively developed strategy outlining what further clinical or real-world evidence will be collected after a technology&apos;s initial approval or reimbursement.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Evidence Development Plan</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Post-Approval Evidence Plan</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Evidence Generation Plan</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/decision-uncertainty"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/evidence-generation-plan"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/real-world-evidence"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-775f32bbc9c5</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Real-World Evidence: catalogue subdomain Evidence Synthesis is one of the subdomains; placed under Real-World Evidence, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/evidence-generation-plan"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/conditional-coverage"/>
        <dcterms:identifier>HEO-L-7f46d04014bd</dcterms:identifier>
        <linkRationale xml:lang="en">The plan for further evidence is an element of a conditional coverage decision (both definitions)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/evidence-generation-plan"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#addresses"/>
