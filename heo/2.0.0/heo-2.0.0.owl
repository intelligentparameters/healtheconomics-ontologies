        <dcterms:identifier>HS-NHS-HSP-001</dcterms:identifier>
        <dcterms:source>Donabedian A. Evaluating the quality of medical care. Milbank Memorial Fund Quarterly. 1966;44(3):166-206. doi:10.2307/3348969.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Patient Acuity</rdfs:label>
        <skos:definition xml:lang="en">A measure of the severity or intensity of a patient&apos;s condition, used to determine the level of care and resources required.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Care Intensity Level</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Patient Severity Level</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Patient Acuity</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/resource-use"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/acuity"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/severity-of-illness"/>
        <dcterms:identifier>HEO-L-a678e5f82be0</dcterms:identifier>
        <linkRationale xml:lang="en">Acuity is a measure of how severe the condition is</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
