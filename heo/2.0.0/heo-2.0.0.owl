    <!-- https://healtheconomics.wiki/concept/strategic-purchasing -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/strategic-purchasing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/purchasing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/purchasing"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <skos:notation>HS-HP-HF-075</skos:notation>
        <dcterms:identifier>HS-HP-HF-075</dcterms:identifier>
        <dcterms:source>WHO, Health Financing for Universal Coverage</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Strategic Purchasing</rdfs:label>
        <skos:altLabel xml:lang="en">Active Purchasing</skos:altLabel>
        <skos:altLabel xml:lang="en">Strategic Commissioning</skos:altLabel>
        <skos:definition xml:lang="en">A financing approach where a payer actively negotiates prices, selects high-performing providers, and designs incentivising payment mechanisms, unlike passive purchasing.</skos:definition>
        <skos:prefLabel xml:lang="en">Strategic Purchasing</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/strategic-purchasing"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/purchasing"/>
        <dcterms:identifier>HEO-L-bb8c41461f5e</dcterms:identifier>
        <linkRationale xml:lang="en">Strategic purchasing is the active form of allocating pooled funds to providers, so a kind of purchasing.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
