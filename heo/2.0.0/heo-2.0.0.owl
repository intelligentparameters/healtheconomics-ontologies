        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Health Promotion</rdfs:label>
        <skos:definition xml:lang="en">The process of enabling people to increase control over, and improve, their own health, addressing the broader social and environmental conditions that shape it.</skos:definition>
