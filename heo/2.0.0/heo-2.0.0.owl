    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/screening-theory"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#explains"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/screening-in-insurance"/>
        <dcterms:identifier>HEO-L-36dd34232525</dcterms:identifier>
