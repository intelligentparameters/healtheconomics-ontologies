        <dcterms:identifier>HEO-L-c7dab81b724d</dcterms:identifier>
        <linkRationale xml:lang="en">A secondary endpoint is a trial outcome measure.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
