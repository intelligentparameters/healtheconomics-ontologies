        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/weak-recommendation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/recommendation"/>
        <dcterms:identifier>HEO-L-76a64ddc84a3</dcterms:identifier>
        <linkRationale xml:lang="en">A weak recommendation is a recommendation.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
