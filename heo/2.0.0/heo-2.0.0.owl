    <!-- https://healtheconomics.wiki/concept/submission-preparation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/submission-preparation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
