    <!-- https://healtheconomics.wiki/concept/biosimilar-substitution -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/biosimilar-substitution">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/automatic-substitution"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/automatic-substitution"/>
        <skos:notation>PP-PC-FM-001</skos:notation>
        <dcterms:identifier>PP-PC-FM-001</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>EMA and HMA 2023 (EMA/627319/2022)</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Biosimilar Substitution</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Biosimilar substitution is dispensing a biosimilar instead of a prescribed reference biologic without consulting the prescriber, where rules allow.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Biosimilar Interchange</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Biosimilar Switching</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Biosimilar Substitution</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/therapeutic-interchange"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/biosimilar-uptake"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/reference-product"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/biosimilar-substitution"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/automatic-substitution"/>
        <dcterms:identifier>HEO-L-eb2b6350fb5d</dcterms:identifier>
        <linkRationale xml:lang="en">Both definitions: dispensing a lower-cost equivalent without consulting the prescriber</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
