    <!-- https://healtheconomics.wiki/concept/volume-discount -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/volume-discount">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/discount"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/volume-based-pricing"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q55022336"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/discount"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/volume-based-pricing"/>
        <skos:notation>HS-DC-DP-106</skos:notation>
        <dcterms:identifier>HS-DC-DP-106</dcterms:identifier>
        <dcterms:source>Carlson JJ, Sullivan SD, Garrison LP, Neumann PJ, Veenstra DL. Linking payment to health outcomes: a taxonomy and examination of performance-based reimbursement schemes. Health Policy. 2010;96(3):179-190.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Volume Discount</rdfs:label>
        <skos:altLabel xml:lang="en">Bulk Discount</skos:altLabel>
        <skos:altLabel xml:lang="en">Quantity Discount</skos:altLabel>
        <skos:definition xml:lang="en">A price reduction offered based on the quantity of a product purchased, with larger volumes typically qualifying for a greater discount.</skos:definition>
        <skos:prefLabel xml:lang="en">Volume Discount</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/volume-rebate"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
