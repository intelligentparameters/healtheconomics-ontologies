        <owl:versionInfo>1.0.3</owl:versionInfo>
        <skos:altLabel xml:lang="en">YLD</skos:altLabel>
        <skos:definition xml:lang="en">Years lived with disability (YLDs) measure non-fatal health loss, usually as prevalence times disability weight; adding years of life lost gives the DALY.</skos:definition>
        <skos:hiddenLabel xml:lang="en">YLD Calculation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Years Lived with Disability</skos:prefLabel>
        <abbreviation xml:lang="en">YLD</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/years-of-life-lost"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/outcomes#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/years-lived-with-disability"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
