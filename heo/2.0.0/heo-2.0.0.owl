    <!-- https://healtheconomics.wiki/concept/symptomatic-response -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/symptomatic-response">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/symptomatic-outcome"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/treatment-response"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/symptomatic-outcome"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/treatment-response"/>
        <skos:notation>HE-ES-CO-086</skos:notation>
        <dcterms:identifier>HE-ES-CO-086</dcterms:identifier>
        <dcterms:source>U.S. Food and Drug Administration. Guidance for Industry: Patient-Reported Outcome Measures-Use in Medical Product Development to Support Labeling Claims. FDA; 2009.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Symptomatic Response</rdfs:label>
        <skos:altLabel xml:lang="en">Symptom Response</skos:altLabel>
        <skos:definition xml:lang="en">A measure indicating a clinically meaningful improvement in disease-related symptoms following treatment, defined using an established threshold for the relevant measure.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Symptom Improvement</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Symptomatic Response</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/symptomatic-response"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/symptomatic-outcome"/>
        <dcterms:identifier>HEO-L-6f43f1748c1c</dcterms:identifier>
        <linkRationale xml:lang="en">A symptom responder measure is a kind of symptomatic outcome, per both definitions</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/symptomatic-response"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/treatment-response"/>
        <dcterms:identifier>HEO-L-50afee2232ba</dcterms:identifier>
        <linkRationale xml:lang="en">Symptomatic response is a treatment response defined on symptoms.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/symptomatic-treatment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/symptomatic-treatment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/supportive-therapy"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q621558"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/supportive-therapy"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/palliative-care"/>
        <skos:notation>HE-PE-TI-032</skos:notation>
        <dcterms:identifier>HE-PE-TI-032</dcterms:identifier>
        <dcterms:source>Katzung 2017</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Symptomatic Treatment</rdfs:label>
        <skos:definition xml:lang="en">Treatment aimed at relieving a condition&apos;s symptoms without addressing its underlying cause, commonly used when no curative treatment is available.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Comfort-Oriented Treatment</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Symptom-Directed Treatment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Symptomatic Treatment</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/curative-therapy"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/symptomatic-treatment"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/supportive-therapy"/>
        <dcterms:identifier>HEO-L-10a58d4b9d0a</dcterms:identifier>
        <linkRationale xml:lang="en">Supportive therapy manages the symptoms of a condition or its treatment, so symptom-relieving treatment is a kind of it.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/symptomatic-treatment"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/palliative-care"/>
        <dcterms:identifier>HEO-L-06324f493636</dcterms:identifier>
        <linkRationale xml:lang="en">The object definition says palliative care relieves symptoms; symptomatic treatment is its core component</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/symptomatic-treatment"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/curative-therapy"/>
        <dcterms:identifier>HEO-L-7eac88fbe864</dcterms:identifier>
        <linkRationale xml:lang="en">Symptomatic and curative treatment are opposing treatment aims.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/synthetic-control -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/synthetic-control">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:notation>HE-ES-SA-211</skos:notation>
        <dcterms:identifier>HE-ES-SA-211</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Abadie &amp; Gardeazabal 2003</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Synthetic Control</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A quasi-experimental method constructing a weighted combination of untreated units to serve as a comparison group resembling a treated unit before intervention.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Data-Derived Control</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Synthetic Comparator</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Synthetic Control</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/randomised-controlled-trial"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/real-world-data"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/synthetic-control"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-7af857d54511</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Statistical methods in subdomain Evidence Synthesis; placed under Statistical Method, the concept named by its wiki topic</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/synthetic-control"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/randomised-controlled-trial"/>
        <dcterms:identifier>HEO-L-81d76b349960</dcterms:identifier>
        <linkRationale xml:lang="en">Synthetic control is a non-randomised alternative to an RCT for causal comparison.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/synthetic-control"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/real-world-data"/>
        <dcterms:identifier>HEO-L-71e28779e502</dcterms:identifier>
        <linkRationale xml:lang="en">Synthetic controls are built from routinely collected or observational data on untreated units.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/synthetic-data -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/synthetic-data">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-source"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-source"/>
        <skos:notation>HE-ES-ES-042</skos:notation>
        <dcterms:identifier>HE-ES-ES-042</dcterms:identifier>
        <dcterms:source>Rankin et al. 2020</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Synthetic Data</rdfs:label>
        <skos:definition xml:lang="en">Artificially generated data statistically mimicking real data&apos;s properties without containing actual information from any real individual, protecting patient privacy.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Artificial Data</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Generated Data</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Synthetic Data</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/privacy-protection"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/synthetic-data"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-source"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-3fc7c4772e34</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Evidence Sources: catalogue subdomain Evidence Synthesis is one of the subdomains; placed under Evidence Source, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/synthetic-data"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/privacy-protection"/>
        <dcterms:identifier>HEO-L-8f06caffbd06</dcterms:identifier>
        <linkRationale xml:lang="en">Synthetic data protects privacy by holding no real records (subject definition); data, not a safeguard</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


