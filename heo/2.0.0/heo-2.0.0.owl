        <owl:versionInfo>1.0.3</owl:versionInfo>
        <skos:altLabel xml:lang="en">Continuous-Time Model</skos:altLabel>
        <skos:definition xml:lang="en">A continuous model is a decision model run in continuous time rather than fixed cycles, so health events can occur at any moment, governed by rates.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Differential-Equation Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Continuous Model</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/discrete-model"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/hazard-rate"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/numerical-integration"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/continuous-model"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/model-structure"/>
        <dcterms:identifier>HEO-L-8addf62bcf9a</dcterms:identifier>
        <linkRationale xml:lang="en">Continuous time is a structural choice of model type</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
