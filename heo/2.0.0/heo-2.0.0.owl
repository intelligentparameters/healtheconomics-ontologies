    <!-- https://healtheconomics.wiki/concept/trust-fund -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/trust-fund">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <skos:notation>HS-HP-HF-079</skos:notation>
        <dcterms:identifier>HS-HP-HF-079</dcterms:identifier>
        <dcterms:source>Musgrave &amp; Musgrave 1989</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Trust Fund</rdfs:label>
        <skos:definition xml:lang="en">A dedicated financial account established to hold and manage funds designated for a specific purpose, such as national health insurance.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Pooled Fund</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Ring-Fenced Fund</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Trust Fund</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/earmarked-taxation"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/trust-fund"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
