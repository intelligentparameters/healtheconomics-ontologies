    <!-- https://healtheconomics.wiki/concept/function-transfer -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/function-transfer">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/benefit-transfer"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/benefit-transfer"/>
        <skos:notation>HE-EE-CBA-023</skos:notation>
        <dcterms:identifier>HE-EE-CBA-023</dcterms:identifier>
        <dcterms:source>Loomis 1992</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Function Transfer</rdfs:label>
        <skos:definition xml:lang="en">A form of benefit transfer in which an entire estimated value function, rather than a single point value, is applied to a new context.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Benefit-Function Approach</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Value Surface Transfer</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Function Transfer</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/unit-value-transfer"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/function-transfer"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/benefit-transfer"/>
        <dcterms:identifier>HEO-L-ad15cf853a07</dcterms:identifier>
        <linkRationale xml:lang="en">Function transfer is a form of benefit transfer</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/function-transfer"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/unit-value-transfer"/>
        <dcterms:identifier>HEO-L-ce40ed006d61</dcterms:identifier>
        <linkRationale xml:lang="en">Definition: whole value function rather than a single point value</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/functional-decline -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/functional-decline">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome"/>
        <skos:notation>HE-PE-NR-007</skos:notation>
        <dcterms:identifier>HE-PE-NR-007</dcterms:identifier>
        <dcterms:source>WHO 2001</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Functional Decline</rdfs:label>
        <skos:altLabel xml:lang="en">Decline in Function</skos:altLabel>
        <skos:definition xml:lang="en">A reduction in ability to perform daily activities independently, often linked to ageing, chronic disease progression, or an acute health event.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Functional Deterioration</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Functional Decline</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/functional-independence"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/functional-decline"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome"/>
        <dcterms:identifier>HEO-L-e6d4ae538187</dcterms:identifier>
        <linkRationale xml:lang="en">Functional decline is a clinical outcome</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/functional-decline"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/functional-independence"/>
        <dcterms:identifier>HEO-L-39cc642e9261</dcterms:identifier>
        <linkRationale xml:lang="en">Decline is a loss of independence, not an opposing concept</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/functional-independence -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/functional-independence">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/functional-status"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/functional-status"/>
        <skos:notation>HE-PE-CD-018</skos:notation>
        <dcterms:identifier>HE-PE-CD-018</dcterms:identifier>
        <dcterms:source>WHO 2001</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Functional Independence</rdfs:label>
        <skos:definition xml:lang="en">An individual&apos;s capacity to perform daily activities without assistance from others, commonly assessed using standardised functional status instruments.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Independent Functioning</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Self-Care Capacity</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Functional Independence</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/dependency"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
