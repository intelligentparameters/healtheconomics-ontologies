        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/market-equilibrium"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/producer-surplus"/>
        <dcterms:identifier>HEO-L-fdcf0e091a81</dcterms:identifier>
