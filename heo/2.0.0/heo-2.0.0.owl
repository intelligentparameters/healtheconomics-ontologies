        <dcterms:identifier>HS-HP-PP-031</dcterms:identifier>
        <dcterms:source>CMS, National Correct Coding Initiative</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Correct Coding Initiative</rdfs:label>
        <skos:altLabel xml:lang="en">CCI</skos:altLabel>
        <skos:definition xml:lang="en">A US Medicare programme identifying and preventing inappropriate payment for services that should not be billed together, based on coding conventions.</skos:definition>
        <skos:hiddenLabel xml:lang="en">NCCI Edits</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Correct Coding Initiative</skos:prefLabel>
