    <!-- https://healtheconomics.wiki/concept/patent-extension -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/patent-extension">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-development"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/drug-development"/>
        <skos:notation>HE-PE-DD-035</skos:notation>
        <dcterms:identifier>HE-PE-DD-035</dcterms:identifier>
        <dcterms:source>FDA, Hatch-Waxman Act</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Patent Extension</rdfs:label>
        <skos:altLabel xml:lang="en">Patent Term Extension</skos:altLabel>
        <skos:definition xml:lang="en">An additional period of patent protection compensating a manufacturer for time lost during regulatory approval, delaying generic competition and price reductions.</skos:definition>
        <skos:hiddenLabel xml:lang="en">SPC</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Patent Extension</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/market-exclusivity"/>
