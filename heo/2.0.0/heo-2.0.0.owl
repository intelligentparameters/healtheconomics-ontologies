    <!-- https://healtheconomics.wiki/concept/multidisciplinary-care -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/multidisciplinary-care">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/integrated-care"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/integrated-care"/>
        <skos:notation>HS-SS_IC-004</skos:notation>
        <dcterms:identifier>HS-SS_IC-004</dcterms:identifier>
        <dcterms:source>AHA, American Hospital Association</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Multidisciplinary Care</rdfs:label>
        <skos:altLabel xml:lang="en">MDT Care</skos:altLabel>
        <skos:altLabel xml:lang="en">Multidisciplinary Team Care</skos:altLabel>
        <skos:definition xml:lang="en">A delivery model in which providers from multiple disciplines each contribute specific expertise, typically working somewhat independently within their own specialisation.</skos:definition>
        <skos:prefLabel xml:lang="en">Multidisciplinary Care</skos:prefLabel>
        <abbreviation xml:lang="en">MDT Care</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/team-based-care"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/multidisciplinary-care"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/integrated-care"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-d4bde84d2039</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Systems Strengthening &gt; Integrated Care: health system strengthening is the Health Systems subdomain; placed under Integrated Care, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/multidisciplinary-care"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
