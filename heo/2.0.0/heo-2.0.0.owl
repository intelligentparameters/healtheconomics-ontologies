        <rdfs:label xml:lang="en">Secondary Endpoint</rdfs:label>
        <skos:altLabel xml:lang="en">Secondary Outcome</skos:altLabel>
        <skos:definition xml:lang="en">An outcome measure assessed within a trial that provides supportive evidence about a treatment&apos;s effects, alongside the trial&apos;s primary endpoint.</skos:definition>
