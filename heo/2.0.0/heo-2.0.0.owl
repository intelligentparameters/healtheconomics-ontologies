    <!-- https://healtheconomics.wiki/concept/private-discount-rate -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/private-discount-rate">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/discount-rate"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/discount-rate"/>
        <skos:notation>HE-EE-DC-012</skos:notation>
        <dcterms:identifier>HE-EE-DC-012</dcterms:identifier>
        <dcterms:source>Claxton et al. 2011</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Private Discount Rate</rdfs:label>
        <skos:altLabel xml:lang="en">Individual Discount Rate</skos:altLabel>
        <skos:definition xml:lang="en">The rate at which an individual personally discounts future costs and benefits, typically higher than the social discount rate used in policy evaluation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Market Discount Rate</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Private Discount Rate</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/social-discount-rate"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/private-discount-rate"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/discount-rate"/>
        <dcterms:identifier>HEO-L-ad8288fd7924</dcterms:identifier>
        <linkRationale xml:lang="en">A private discount rate is a discount rate applied by an individual.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
