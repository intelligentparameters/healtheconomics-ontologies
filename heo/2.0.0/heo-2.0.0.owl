        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-system-organization"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-system-organization"/>
        <skos:notation>HS-HP-HSM-005</skos:notation>
        <dcterms:identifier>HS-HP-HSM-005</dcterms:identifier>
        <dcterms:source>World Health Organization. Everybody&apos;s Business: Strengthening Health Systems to Improve Health Outcomes-WHO&apos;s Framework for Action. WHO; 2007.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Fragmented System</rdfs:label>
        <skos:definition xml:lang="en">A health system characterised by poor coordination across its financing, regulatory, and delivery components, often resulting in gaps or duplication.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Siloed System</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Uncoordinated Health System</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Fragmented System</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/integrated-system"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/fragmented-system"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-system-organization"/>
        <dcterms:identifier>HEO-L-6d7e7fd808e3</dcterms:identifier>
        <linkRationale xml:lang="en">Fragmentation is a form of health system organisation</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/fragmented-system"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/integrated-system"/>
        <dcterms:identifier>HEO-L-351412485965</dcterms:identifier>
        <linkRationale xml:lang="en">Fragmented and integrated systems are opposing models</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/frailty -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/frailty">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/geriatric-economics"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/geriatric-economics"/>
        <riskFactorFor rdf:resource="https://healtheconomics.wiki/concept/functional-decline"/>
        <skos:notation>HE-PE-NR-006</skos:notation>
        <dcterms:identifier>HE-PE-NR-006</dcterms:identifier>
        <dcterms:source>Fried et al. 2001</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Frailty</rdfs:label>
        <skos:definition xml:lang="en">A clinical syndrome of decreased physiological reserve and increased vulnerability to adverse outcomes following relatively minor stressors, commonly assessed with standardised criteria.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Physiological Vulnerability</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Reduced Physiological Reserve</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Frailty</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/dependency"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/frailty"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/geriatric-economics"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-6239d0d2825b</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: curated: review B: disease or clinical specialty term; a disease is not an evidence synthesis method; classify under its disease-area economics concept</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/frailty"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#riskFactorFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/functional-decline"/>
        <dcterms:identifier>HEO-L-345c600256d9</dcterms:identifier>
        <skos:editorialNote xml:lang="en">suggested source, not yet checked: Fried et al. 2001</skos:editorialNote>
        <linkRationale xml:lang="en">The frailty phenotype predicted worsening mobility and ADL disability</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/frailty"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/dependency"/>
        <dcterms:identifier>HEO-L-db8deafe6ed3</dcterms:identifier>
        <linkRationale xml:lang="en">Reduced physiological reserve leads to needing help with daily activities.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/frailty-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/frailty-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/random-effects-model"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/survival-regression"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/random-effects-model"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/survival-regression"/>
        <skos:notation>HE-EM-SM-025</skos:notation>
        <dcterms:identifier>HE-EM-SM-025</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-23</dcterms:modified>
        <dcterms:source>Vaupel, Manton &amp; Stallard 1979</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Frailty Model</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A survival model incorporating an unobserved random effect, called frailty, to represent risk heterogeneity not captured by observed covariates.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Random-Effect Survival Model</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Unobserved Heterogeneity Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Frailty Model</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-5"/>
        <represents rdf:resource="https://healtheconomics.wiki/concept/patient-heterogeneity"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/frailty-model"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/random-effects-model"/>
        <dcterms:identifier>HEO-L-963c0ec859bc</dcterms:identifier>
        <linkRationale xml:lang="en">Frailty is a random effect in a survival model</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/frailty-model"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/survival-regression"/>
        <dcterms:identifier>HEO-L-b357b41797ea</dcterms:identifier>
        <linkRationale xml:lang="en">A frailty model is a survival regression model with a random effect, not survival analysis as a whole</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/frailty-model"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#represents"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/patient-heterogeneity"/>
        <dcterms:identifier>HEO-L-7041b101416d</dcterms:identifier>
        <linkRationale xml:lang="en">The frailty term represents unobserved risk heterogeneity (subject definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
