    <!-- https://healtheconomics.wiki/concept/ceaf -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/ceaf">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <skos:notation>HE-EE-CEA-005</skos:notation>
        <dcterms:identifier>HE-EE-CEA-005</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</dcterms:modified>
        <dcterms:source>NICE PMG36 (2022, updated 2026)</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cost-Effectiveness Acceptability Frontier</rdfs:label>
        <owl:versionInfo>1.0.3</owl:versionInfo>
        <skos:altLabel xml:lang="en">CEAF</skos:altLabel>
        <skos:definition xml:lang="en">The cost-effectiveness acceptability frontier (CEAF) plots the chance the option with the highest expected net benefit is cost-effective, by threshold.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Acceptability Frontier</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cost-Effectiveness Acceptability Frontier</skos:prefLabel>
        <abbreviation xml:lang="en">CEAF</abbreviation>
        <assumes rdf:resource="https://healtheconomics.wiki/concept/decision-rule"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-3"/>
        <represents rdf:resource="https://healtheconomics.wiki/concept/decision-uncertainty"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/ceaf"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-1a4b0a66a942</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Cost effectiveness analysis in subdomain Economic Evaluation; placed under Cost-Effectiveness Analysis, the concept named by its wiki topic</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/ceaf"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#assumes"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/decision-rule"/>
        <dcterms:identifier>HEO-L-64f6490e78e5</dcterms:identifier>
        <linkRationale xml:lang="en">The CEAF rests on choosing the option with highest expected net benefit (Fenwick et al. 2001)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/ceaf"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <dcterms:identifier>HEO-L-03856c374c3c</dcterms:identifier>
        <linkRationale xml:lang="en">The CEAF presents uncertainty for the adoption decision in HTA (Fenwick et al. 2001)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/ceaf"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#represents"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/decision-uncertainty"/>
        <dcterms:identifier>HEO-L-589f2ef77022</dcterms:identifier>
        <linkRationale xml:lang="en">The CEAF is a plot depicting the probability the optimal option is cost-effective, so represents fits a chart</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
