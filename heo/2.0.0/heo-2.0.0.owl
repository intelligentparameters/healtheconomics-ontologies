    <!-- https://healtheconomics.wiki/concept/trim-and-fill -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/trim-and-fill">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-ES-ESM-064</skos:notation>
        <dcterms:identifier>HE-ES-ESM-064</dcterms:identifier>
        <dcterms:source>Duval &amp; Tweedie 2000</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Trim And Fill</rdfs:label>
        <skos:altLabel xml:lang="en">Duval-Tweedie Method</skos:altLabel>
        <skos:altLabel xml:lang="en">Trim-and-Fill Method</skos:altLabel>
        <skos:definition xml:lang="en">A method detecting and adjusting for potential publication bias by imputing hypothetical missing studies that would restore funnel plot symmetry.</skos:definition>
        <skos:prefLabel xml:lang="en">Trim And Fill</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/publication-bias"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/funnel-plot"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/trim-and-fill"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-dec798630a6f</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Evidence Synthesis Methods: catalogue subdomain Evidence Synthesis is one of the subdomains</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/trim-and-fill"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#addresses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/publication-bias"/>
        <dcterms:identifier>HEO-L-b8f7dc4c7c0a</dcterms:identifier>
        <linkRationale xml:lang="en">Trim and fill adjusts for suspected publication bias rather than measuring it</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/trim-and-fill"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/funnel-plot"/>
        <dcterms:identifier>HEO-L-0a96f8bc3c68</dcterms:identifier>
