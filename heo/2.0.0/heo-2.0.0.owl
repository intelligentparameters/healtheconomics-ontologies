        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Efficiency Evaluation</rdfs:label>
        <skos:altLabel xml:lang="en">Efficiency Assessment</skos:altLabel>
