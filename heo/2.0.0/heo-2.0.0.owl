        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-technology-assessment#step-1"/>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/transparency"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/accountability-for-reasonableness"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
