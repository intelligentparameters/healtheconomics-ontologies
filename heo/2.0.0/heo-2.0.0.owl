        <rdfs:label xml:lang="en">Code Status</rdfs:label>
        <skos:altLabel xml:lang="en">Resuscitation Status</skos:altLabel>
        <skos:definition xml:lang="en">A documented designation specifying which resuscitation and life-sustaining interventions should be attempted in the event of cardiac or respiratory arrest.</skos:definition>
