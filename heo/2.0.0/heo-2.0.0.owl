        <skos:altLabel xml:lang="en">Outpatient Care</skos:altLabel>
        <skos:definition xml:lang="en">Ambulatory care is health care without an overnight hospital stay, such as GP, outpatient and day-case care, counted apart from inpatient care spending.</skos:definition>
