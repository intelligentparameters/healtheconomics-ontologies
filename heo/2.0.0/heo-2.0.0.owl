    <!-- https://healtheconomics.wiki/concept/delayed-care -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/delayed-care">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
