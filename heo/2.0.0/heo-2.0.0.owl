    <!-- https://healtheconomics.wiki/concept/run-in-period -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/run-in-period">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/randomised-controlled-trial"/>
        <precedes rdf:resource="https://healtheconomics.wiki/concept/randomization"/>
        <skos:notation>HE-ES-CTM-079</skos:notation>
        <dcterms:identifier>HE-ES-CTM-079</dcterms:identifier>
        <dcterms:source>Friedman LM, Furberg CD, DeMets DL, Reboussin DM, Granger CB. Fundamentals of Clinical Trials. 5th ed. Springer; 2015. doi:10.1007/978-3-319-18539-2.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Run-In Period</rdfs:label>
        <skos:altLabel xml:lang="en">Lead-In Period</skos:altLabel>
        <skos:definition xml:lang="en">An initial trial phase, before randomisation, during which all participants receive a common intervention, used to exclude likely non-adherent or non-responsive individuals.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Pre-Randomisation Phase</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Run-In Period</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/washout-period"/>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/adherence"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/run-in-period"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-a5de1c7e3e86</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Clinical Trial Methods: catalogue subdomain Evidence Synthesis is one of the subdomains</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/run-in-period"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
