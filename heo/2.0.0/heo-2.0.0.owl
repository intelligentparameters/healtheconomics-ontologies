    <!-- https://healtheconomics.wiki/concept/sentinel-event -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/sentinel-event">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/adverse-event"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q7451343"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/adverse-event"/>
        <precedes rdf:resource="https://healtheconomics.wiki/concept/root-cause-analysis"/>
        <skos:notation>HS-NHS-HQ-071</skos:notation>
        <dcterms:identifier>HS-NHS-HQ-071</dcterms:identifier>
        <dcterms:source>Joint Commission, Sentinel Event Policy</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Sentinel Event</rdfs:label>
        <skos:definition xml:lang="en">An unexpected occurrence involving death or serious injury unrelated to a patient&apos;s underlying illness, occurring within a healthcare organisation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Sentinel Incident</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Serious Incident</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Sentinel Event</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/never-event"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/sentinel-event"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/adverse-event"/>
        <dcterms:identifier>HEO-L-4277dbff6048</dcterms:identifier>
        <linkRationale xml:lang="en">A sentinel event causes serious injury from care, an adverse event.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/sentinel-event"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#precedes"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/root-cause-analysis"/>
        <dcterms:identifier>HEO-L-51f2b6f59686</dcterms:identifier>
        <linkRationale xml:lang="en">A sentinel event triggers a root cause analysis.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/sentinel-event"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/never-event"/>
        <dcterms:identifier>HEO-L-d511dcf958bc</dcterms:identifier>
        <linkRationale xml:lang="en">Sentinel events (Joint Commission) and never events (preventable list) are distinct categories.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/sentinel-event-rate -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/sentinel-event-rate">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcome-quality-indicator"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/outcome-quality-indicator"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/sentinel-event"/>
        <skos:notation>HS-HP-HQ-041</skos:notation>
        <dcterms:identifier>HS-HP-HQ-041</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Joint Commission, Sentinel Event Policy</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Sentinel Event Rate</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">SE Rate</skos:altLabel>
        <skos:definition xml:lang="en">A sentinel event rate is the number of events meeting a specified serious patient-safety definition divided by a clearly defined population, activity, or exposure denominator during a stated period, usually expressed per a standard number of opportunities.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Sentinel Event Frequency</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Sentinel Event Rate</skos:prefLabel>
        <abbreviation xml:lang="en">SE Rate</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/sentinel-event-rate"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/outcome-quality-indicator"/>
        <dcterms:identifier>HEO-L-c3b0ae94c04f</dcterms:identifier>
        <linkRationale xml:lang="en">Patient Safety Indicator is defined as a claims-based complication flag; an event rate of serious harms is an outcome quality indicator.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/sentinel-event-rate"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/sentinel-event"/>
        <dcterms:identifier>HEO-L-91f79c2dadb2</dcterms:identifier>
        <linkRationale xml:lang="en">The rate quantifies how often sentinel events occur, per its definition</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/separating-equilibrium -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/separating-equilibrium">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/equilibrium"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/equilibrium"/>
        <skos:notation>HE-EE-ME-066</skos:notation>
        <dcterms:identifier>HE-EE-ME-066</dcterms:identifier>
        <dcterms:source>Spence 1973</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Separating Equilibrium</rdfs:label>
        <skos:definition xml:lang="en">A market outcome in which different risk types choose different options, revealing their true type to the other party in the transaction.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Self-Selection Equilibrium</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Separating Outcome</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Separating Equilibrium</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/separating-equilibrium"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/equilibrium"/>
        <dcterms:identifier>HEO-L-d5777e9f6bf1</dcterms:identifier>
        <linkRationale xml:lang="en">Market Equilibrium is defined as demand equals supply at a price; a separating outcome is a broader equilibrium, matching Pooling Equilibrium.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


