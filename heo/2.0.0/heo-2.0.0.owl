    <!-- https://healtheconomics.wiki/concept/penalty -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/penalty">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
