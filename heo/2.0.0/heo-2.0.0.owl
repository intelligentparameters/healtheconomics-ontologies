    <!-- https://healtheconomics.wiki/concept/patient-days -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/patient-days">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
