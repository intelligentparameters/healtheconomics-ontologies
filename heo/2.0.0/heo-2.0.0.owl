    <!-- https://healtheconomics.wiki/concept/potentially-inappropriate-medication -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/potentially-inappropriate-medication">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/medication-safety"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/medication-safety"/>
        <riskFactorFor rdf:resource="https://healtheconomics.wiki/concept/adverse-drug-reaction"/>
        <skos:notation>PP-PC-MS-010</skos:notation>
        <dcterms:identifier>PP-PC-MS-010</dcterms:identifier>
        <dcterms:source>Beers 1997</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Potentially Inappropriate Medication</rdfs:label>
        <skos:altLabel xml:lang="en">PIM</skos:altLabel>
        <skos:definition xml:lang="en">A medication generally considered to pose an unfavourable risk-benefit balance for a specific population, most commonly older adults, per expert criteria.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Inappropriate Prescribing Flag</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Potentially Inappropriate Medication</skos:prefLabel>
        <abbreviation xml:lang="en">PIM</abbreviation>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/potentially-inappropriate-medication"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/medication-safety"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-cb542948df35</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Pharmacy Practice &gt; Pharmaceutical Care &gt; Medication Safety: pharmacy services are part of health care delivery; placed under Medication Safety, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/potentially-inappropriate-medication"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#riskFactorFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/adverse-drug-reaction"/>
        <dcterms:identifier>HEO-L-9eeb9d9c38de</dcterms:identifier>
        <linkRationale xml:lang="en">A PIM is a medicine with an unfavourable risk-benefit balance, so it raises the risk of adverse reactions; it is not a kind of safety</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/potentially-preventable-event -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/potentially-preventable-event">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/quality-indicator"/>
        <skos:notation>HS-NHS-HQ-057</skos:notation>
        <dcterms:identifier>HS-NHS-HQ-057</dcterms:identifier>
        <dcterms:source>Kohn, Corrigan &amp; Donaldson 2000</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Potentially Preventable Event</rdfs:label>
        <skos:altLabel xml:lang="en">PPE</skos:altLabel>
        <skos:definition xml:lang="en">An adverse outcome, such as a readmission, that could plausibly have been avoided through appropriate care, unlike a disease&apos;s natural progression.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Avoidable Adverse Event</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Potentially Preventable Event</skos:prefLabel>
        <abbreviation xml:lang="en">PPE</abbreviation>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/potentially-preventable-event"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-b859450e58a6</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; NHS Productivity &gt; Healthcare Quality: wiki topic Performance, productivity and quality sits in Health Systems; placed under Quality of Care, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/potentially-preventable-event"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/quality-indicator"/>
        <dcterms:identifier>HEO-L-d6eb8311631c</dcterms:identifier>
        <linkRationale xml:lang="en">The event is an outcome; counts of such events are the inputs to quality indicators such as preventable readmission rates</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/poverty -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/poverty">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/social-determinants-of-health"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
