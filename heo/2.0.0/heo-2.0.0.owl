        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Self-Rated Health</rdfs:label>
        <skos:altLabel xml:lang="en">SRH</skos:altLabel>
        <skos:definition xml:lang="en">A single-item measure asking individuals to rate their own overall health, shown to independently predict future mortality and healthcare use.</skos:definition>
