        <uses rdf:resource="https://healtheconomics.wiki/concept/electronic-health-record"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/passive-alert"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
