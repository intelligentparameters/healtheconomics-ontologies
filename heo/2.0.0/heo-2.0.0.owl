    <!-- https://healtheconomics.wiki/concept/attachment-point -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/attachment-point">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/reinsurance-design"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/stop-loss"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/stop-loss-design"/>
        <skos:notation>HS-HP-HI-014</skos:notation>
        <dcterms:identifier>HS-HP-HI-014</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>NAIC 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Attachment Point</rdfs:label>
        <owl:versionInfo>1.0.4</owl:versionInfo>
        <skos:definition xml:lang="en">An attachment point is the claims level at which stop-loss insurance or health reinsurance starts to pay, per person (specific) or per group (aggregate).</skos:definition>
        <skos:hiddenLabel xml:lang="en">Retention Level</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Stop-Loss Threshold</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Attachment Point</skos:prefLabel>
        <counterpartOf rdf:resource="https://healtheconomics.wiki/concept/deductible"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/stop-loss-insurance"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/stop-loss-provision"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
