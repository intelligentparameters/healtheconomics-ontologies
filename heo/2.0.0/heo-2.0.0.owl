    <!-- https://healtheconomics.wiki/concept/model-simplification -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/model-simplification">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:notation>HE-EM-DM-065</skos:notation>
        <dcterms:identifier>HE-EM-DM-065</dcterms:identifier>
        <dcterms:source>Roberts et al. 2012</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Model Simplification</rdfs:label>
        <skos:definition xml:lang="en">The deliberate exclusion of real-world detail from a model&apos;s structure to keep it tractable, transparent, and focused on the decision question.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Model Reduction</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Simplifying Assumption Set</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Model Simplification</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/structural-uncertainty"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/level-of-detail"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/model-simplification"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-b7c2f5836d19</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Modelling &gt; Decision Modelling: catalogue subdomain Economic Modelling is one of the subdomains</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/model-simplification"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/structural-uncertainty"/>
        <dcterms:identifier>HEO-L-251c60edfe0f</dcterms:identifier>
        <linkRationale xml:lang="en">Simplifying assumptions are a recognised source of structural uncertainty.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/model-simplification"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/level-of-detail"/>
        <dcterms:identifier>HEO-L-d1de83c2c8c0</dcterms:identifier>
        <linkRationale xml:lang="en">Simplification excludes real-world detail per its definition; it is not the opposite of extending a model to a new question</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/model-structure -->

