    <!-- https://healtheconomics.wiki/concept/exclusion-list -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/exclusion-list">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
