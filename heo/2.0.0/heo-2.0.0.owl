        <skos:definition xml:lang="en">A treatment using stem cells, capable of developing into various specialised cell types, to repair or replace damaged tissue.</skos:definition>
        <skos:hiddenLabel xml:lang="en">SCT</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Stem Cell Therapy</skos:prefLabel>
