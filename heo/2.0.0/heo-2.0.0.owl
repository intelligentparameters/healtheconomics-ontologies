    <!-- https://healtheconomics.wiki/concept/critical-value -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/critical-value">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/hypothesis-testing"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/confidence-interval"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/statistical-power"/>
        <skos:notation>HE-ES-SA-041</skos:notation>
        <dcterms:identifier>HE-ES-SA-041</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Neyman &amp; Pearson 1933</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Critical Value</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A critical value is a cutoff on a test statistic&apos;s reference distribution that defines a rejection boundary for a specified hypothesis test and error level.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Rejection Threshold</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Significance Cutoff</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Critical Value</skos:prefLabel>
        <benchmarkFor rdf:resource="https://healtheconomics.wiki/concept/test-statistic"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/rejection-region"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/critical-value"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-6e91c94a97b1</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Statistical methods in subdomain Evidence Synthesis; placed under Statistical Method, the concept named by its wiki topic</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/critical-value"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/hypothesis-testing"/>
        <dcterms:identifier>HEO-L-3cc92d6af009</dcterms:identifier>
        <linkRationale xml:lang="en">The critical value sets the rejection boundary, an element of the test (subject definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/critical-value"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/confidence-interval"/>
        <dcterms:identifier>HEO-L-2fbb148e7fec</dcterms:identifier>
        <linkRationale xml:lang="en">A CI is the estimate plus or minus the critical value times the standard error</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/critical-value"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-power"/>
        <dcterms:identifier>HEO-L-6efbec3cdb6a</dcterms:identifier>
        <linkRationale xml:lang="en">Power calculations use the critical value of the test statistic</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/critical-value"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#benchmarkFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/test-statistic"/>
        <dcterms:identifier>HEO-L-d9515969d058</dcterms:identifier>
        <linkRationale xml:lang="en">The critical value is the cutoff the test statistic is judged against.</linkRationale>
