        <dcterms:identifier>HEO-L-dd7652352e9f</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Clinical and patient reported outcomes in subdomain Outcomes</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/objective-response-rate"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/tumour-response"/>
        <dcterms:identifier>HEO-L-9d62f1903340</dcterms:identifier>
        <linkRationale xml:lang="en">ORR is the proportion with complete or partial tumour response; the same-pair isTypeOf link is the one that misreads</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
