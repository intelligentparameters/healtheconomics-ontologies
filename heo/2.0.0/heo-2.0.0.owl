        <skos:altLabel xml:lang="en">Consistency Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Heterogeneity assessment evaluates the nature, extent, and possible causes of differences in effects or outcomes across studies, populations, or settings.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cross-Study Consistency Check</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Heterogeneity Testing</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Homogeneity Assessment</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">I-Squared Assessment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Heterogeneity Assessment</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-4"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/chi-square-distribution"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/degrees-of-freedom"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/i-squared"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
