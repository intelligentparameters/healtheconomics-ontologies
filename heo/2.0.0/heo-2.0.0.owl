    <!-- https://healtheconomics.wiki/concept/stratified-randomization -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/stratified-randomization">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/randomization"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/randomization"/>
        <skos:notation>HE-ES-CTM-090</skos:notation>
        <dcterms:identifier>HE-ES-CTM-090</dcterms:identifier>
        <dcterms:source>Friedman LM, Furberg CD, DeMets DL, Reboussin DM, Granger CB. Fundamentals of Clinical Trials. 5th ed. Springer; 2015. doi:10.1007/978-3-319-18539-2.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Stratified Randomization</rdfs:label>
        <skos:altLabel xml:lang="en">Stratified Random Allocation</skos:altLabel>
        <skos:definition xml:lang="en">A randomisation technique first dividing participants into strata based on an outcome-influencing characteristic, then randomising separately within each stratum.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Stratum Randomisation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Stratified Randomization</skos:prefLabel>
        <counterpartOf rdf:resource="https://healtheconomics.wiki/concept/stratified-sampling"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/block-randomization"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/stratified-sampling"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/stratified-randomization"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
