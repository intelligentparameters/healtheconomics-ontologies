    <!-- https://healtheconomics.wiki/concept/attrition -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/attrition">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-ES-CTM-005</skos:notation>
        <dcterms:identifier>HE-ES-CTM-005</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Higgins et al. 2011</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Attrition</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Attrition is the loss of participants from a trial or cohort study before follow-up ends, leaving outcome, cost and QALY data incomplete and open to bias.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Participant Dropout</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Sample Loss</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Attrition</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/bias"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/missing-data"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/data-completeness"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/clinical-trial"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/attrition"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-0cccd2cea895</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Clinical Trial Methods: catalogue subdomain Evidence Synthesis is one of the subdomains</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
