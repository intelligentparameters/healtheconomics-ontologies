    <!-- https://healtheconomics.wiki/concept/informed-consent -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/informed-consent">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/human-subjects-protection"/>
        <skos:notation>HE-ES-CTM-044</skos:notation>
        <dcterms:identifier>HE-ES-CTM-044</dcterms:identifier>
        <dcterms:source>Faden &amp; Beauchamp 1986</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Informed Consent</rdfs:label>
        <skos:definition xml:lang="en">The process by which a potential participant is given enough information about a study to make a voluntary, informed decision to join.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Consent to Participate</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Voluntary Consent</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Informed Consent</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/informed-refusal"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/waiver-of-consent"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/informed-consent"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-80adcff76a65</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Clinical Trial Methods: catalogue subdomain Evidence Synthesis is one of the subdomains</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/informed-consent"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/human-subjects-protection"/>
        <dcterms:identifier>HEO-L-815b6575ebf2</dcterms:identifier>
        <linkRationale xml:lang="en">Informed consent is a core mechanism within the human subjects protection system</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
