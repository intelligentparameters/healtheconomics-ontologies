    <!-- https://healtheconomics.wiki/concept/good-death -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/good-death">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:notation>HE-PE-CD-020</skos:notation>
        <dcterms:identifier>HE-PE-CD-020</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Good Death</rdfs:label>
        <skos:altLabel xml:lang="en">Death with Dignity</skos:altLabel>
        <skos:definition xml:lang="en">A palliative care concept describing an end-of-life experience characterised by comfort, dignity, and alignment with a patient&apos;s personal wishes.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Dignified Death</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Dignified Dying</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">End-of-Life Autonomy</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Quality End-of-Life</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Good Death</skos:prefLabel>
        <benchmarkFor rdf:resource="https://healtheconomics.wiki/concept/quality-of-death"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/good-death"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-7e590e565dbd</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: curated: review B: end-of-life experience is an outcome (or Palliative Care Economics), not evidence synthesis</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/good-death"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#benchmarkFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/quality-of-death"/>
        <dcterms:identifier>HEO-L-518fa762e9b9</dcterms:identifier>
        <linkRationale xml:lang="en">Good death sets out the ideal experience of dying (comfort dignity wishes) against which the quality of a death is judged</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/goodness-of-fit -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/goodness-of-fit">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
