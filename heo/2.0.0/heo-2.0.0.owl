    <!-- https://healtheconomics.wiki/concept/peto-test -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/peto-test">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/weighted-log-rank"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/weighted-log-rank"/>
        <skos:notation>HE-EM-SM-065</skos:notation>
        <dcterms:identifier>HE-EM-SM-065</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Peto &amp; Peto 1972</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Peto Test</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">The Peto test is a weighted log-rank test comparing survival between groups, weighting each event time by pooled survival so earlier events count more.</skos:definition>
        <skos:prefLabel xml:lang="en">Peto Test</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/log-rank-test"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/peto-test"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/weighted-log-rank"/>
        <dcterms:identifier>HEO-L-691befaf9469</dcterms:identifier>
        <linkRationale xml:lang="en">The Peto-Peto test is a weighted log-rank test</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
