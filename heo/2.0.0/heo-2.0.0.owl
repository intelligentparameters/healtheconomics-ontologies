        <skos:notation>HE-ES-EP-037</skos:notation>
        <dcterms:identifier>HE-ES-EP-037</dcterms:identifier>
        <dcterms:source>Anderson &amp; May 1991</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Reproduction Number</rdfs:label>
        <skos:altLabel xml:lang="en">R Number</skos:altLabel>
        <skos:definition xml:lang="en">A general term for the average number of secondary infections one infected individual produces, covering both the basic and effective reproduction numbers.</skos:definition>
