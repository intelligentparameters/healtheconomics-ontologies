        <skos:notation>HS-HP-HTA-019</skos:notation>
        <dcterms:identifier>HS-HP-HTA-019</dcterms:identifier>
        <dcterms:source>National Institute for Health and Care Excellence. NICE technology appraisal and highly specialised technologies guidance: the manual (PMG36). Published 2022; updated 2026.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Assessment Element</rdfs:label>
        <skos:definition xml:lang="en">A specific, defined component of an assessment framework, such as clinical effectiveness or budget impact, evaluated separately before synthesis.</skos:definition>
