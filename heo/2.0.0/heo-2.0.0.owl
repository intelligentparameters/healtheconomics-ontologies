    <!-- https://healtheconomics.wiki/concept/innovation-assessment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/innovation-assessment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/value-assessment"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Innovation Assessment</rdfs:label>
        <skos:definition xml:lang="en">An evaluation of how far a new technology advances on the existing standard of care, informing whether its novelty justifies additional cost.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Innovation Evaluation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Innovation Assessment</skos:prefLabel>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/innovation"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/innovation-premium"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/innovation-criterion"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/innovation-assessment"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-4917c75f3eea</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Innovation Assessment: assessing new technologies is health technology assessment</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/innovation-assessment"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/value-assessment"/>
