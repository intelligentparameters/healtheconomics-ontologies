    <!-- https://healtheconomics.wiki/concept/differential-discounting -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/differential-discounting">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/discounting"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/discounting"/>
        <skos:notation>HE-EE-DC-002</skos:notation>
        <dcterms:identifier>HE-EE-DC-002</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-03</dcterms:modified>
        <dcterms:source>Brouwer et al. 2005</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Differential Discounting</rdfs:label>
        <owl:versionInfo>1.0.3</owl:versionInfo>
        <skos:altLabel xml:lang="en">Differential Discount Rates</skos:altLabel>
        <skos:definition xml:lang="en">Differential discounting applies a lower annual discount rate to future health effects, such as QALYs, than to future costs in an economic evaluation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Split-Rate Discounting</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Differential Discounting</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/discount-rate"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/discounting-costs"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/discounting-health"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/differential-discounting"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/discounting"/>
        <dcterms:identifier>HEO-L-4eb73f037316</dcterms:identifier>
        <linkRationale xml:lang="en">Differential discounting is a kind of discounting with separate rates for costs and effects</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
