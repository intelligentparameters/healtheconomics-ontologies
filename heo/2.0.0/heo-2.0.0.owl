    <!-- https://healtheconomics.wiki/concept/simulation-method -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/simulation-method">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/numerical-method"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q7663879"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/numerical-method"/>
        <skos:notation>HE-EM-UA-065</skos:notation>
        <dcterms:identifier>HE-EM-UA-065</dcterms:identifier>
        <dcterms:source>Briggs A, Claxton K, Sculpher M. Decision Modelling for Health Economic Evaluation. Oxford University Press; 2006. doi:10.1093/oso/9780198526629.001.0001.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Simulation Method</rdfs:label>
        <skos:definition xml:lang="en">A general approach to estimating a model&apos;s results by repeatedly running it computationally, rather than solving for results using closed-form equations.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Computational Simulation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Simulation Approach</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Simulation Method</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-10"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/simulation-method"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/numerical-method"/>
        <dcterms:identifier>HEO-L-eed801b1fd2e</dcterms:identifier>
        <linkRationale xml:lang="en">Repeated computational runs instead of closed-form solution is a numerical method; Statistical Method is defined as analysing data.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/simulation-model -->

