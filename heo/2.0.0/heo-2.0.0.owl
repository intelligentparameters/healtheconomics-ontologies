    <!-- https://healtheconomics.wiki/concept/real-option-value -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/real-option-value">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/value-element"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/value-element"/>
        <skos:notation>HS-HP-HTA-169</skos:notation>
        <dcterms:identifier>HS-HP-HTA-169</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Lakdawalla et al. 2017</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Real Option Value</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A component of a technology&apos;s value reflecting the benefit of extending life sufficiently to allow a patient to benefit from future medical advances.</skos:definition>
