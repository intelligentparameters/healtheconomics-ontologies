    <!-- https://healtheconomics.wiki/concept/step-down-therapy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/step-down-therapy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/treatment-de-escalation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/treatment-de-escalation"/>
        <skos:notation>HE-PE-DT-041</skos:notation>
        <dcterms:identifier>HE-PE-DT-041</dcterms:identifier>
        <dcterms:source>Katzung 2017</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Step-Down Therapy</rdfs:label>
        <skos:altLabel xml:lang="en">De-escalation Therapy</skos:altLabel>
        <skos:definition xml:lang="en">A treatment strategy beginning with a more intensive medication or dose and progressively reducing intensity once adequate control is achieved.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Dose Reduction Strategy</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Step-Down Therapy</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/step-up-therapy"/>
