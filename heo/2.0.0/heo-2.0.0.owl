        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Data Quality</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:definition xml:lang="en">Data quality is the fitness of data for a specific use in health research or HTA, judged by completeness, accuracy, consistency, timeliness and relevance.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Data Fitness</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Data Integrity</skos:hiddenLabel>
