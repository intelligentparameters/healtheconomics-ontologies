    <!-- https://healtheconomics.wiki/concept/test-retest-reliability -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/test-retest-reliability">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/reliability-assessment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/reliability-assessment"/>
        <skos:notation>HE-ES-EA-040</skos:notation>
        <dcterms:identifier>HE-ES-EA-040</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Landis &amp; Koch 1977</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Test-Retest Reliability</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">The degree of agreement between scores from the same instrument given to the same people on two separate occasions, when no real change is expected.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Temporal Reliability</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Test-Retest Stability</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Test-Retest Reliability</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-4"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/test-retest-reliability"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/reliability-assessment"/>
        <dcterms:identifier>HEO-L-f99cc5b5c4a8</dcterms:identifier>
        <linkRationale xml:lang="en">Reliability assessment explicitly covers test-retest reliability.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


