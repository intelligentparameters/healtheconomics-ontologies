    <!-- https://healtheconomics.wiki/concept/surgical-safety -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/surgical-safety">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/patient-safety"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/patient-safety"/>
        <skos:notation>HS-NHS-HQ-080</skos:notation>
        <dcterms:identifier>HS-NHS-HQ-080</dcterms:identifier>
        <dcterms:source>Haynes et al. 2009</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Surgical Safety</rdfs:label>
        <skos:definition xml:lang="en">A patient safety dimension focused on preventing harm during surgery, covering structured checklists, antibiotic timing, and surgical team communication.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Perioperative Safety</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Safe Surgery</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Surgical Safety</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/retained-foreign-object"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/wrong-site-surgery"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/surgical-safety"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/patient-safety"/>
        <dcterms:identifier>HEO-L-e945330d7516</dcterms:identifier>
        <linkRationale xml:lang="en">Surgical safety is a dimension of patient safety.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
