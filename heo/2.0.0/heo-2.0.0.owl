        <dcterms:source>Groves et al. 2009</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Non-Sampling Error</rdfs:label>
        <skos:definition xml:lang="en">Any source of error not arising from the specific sample studied, including measurement, coverage, and non-response error, unlike sampling error alone.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Coverage-and-Response Error</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Systematic Survey Error</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Non-Sampling Error</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/sampling-error"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
