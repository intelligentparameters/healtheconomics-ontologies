        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/matching-design"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/study-design"/>
        <dcterms:identifier>HEO-L-21402387c103</dcterms:identifier>
        <linkRationale xml:lang="en">Matching is a study design choice</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/matching-method -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/matching-method">
