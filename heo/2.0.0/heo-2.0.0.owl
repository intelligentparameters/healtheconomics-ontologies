        <dcterms:identifier>HEO-L-a0d20426b9aa</dcterms:identifier>
        <linkRationale xml:lang="en">Haematologic response is a treatment response</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
