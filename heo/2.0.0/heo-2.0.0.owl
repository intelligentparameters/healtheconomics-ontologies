    <!-- https://healtheconomics.wiki/concept/major-molecular-response -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/major-molecular-response">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/major-response"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/molecular-response"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/major-response"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/molecular-response"/>
        <skos:notation>HE-ES-CO-040</skos:notation>
        <dcterms:identifier>HE-ES-CO-040</dcterms:identifier>
        <dcterms:source>Baccarani et al. 2013</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Major Molecular Response</rdfs:label>
        <skos:altLabel xml:lang="en">MMR</skos:altLabel>
        <skos:definition xml:lang="en">A response threshold in chronic myeloid leukaemia representing a substantial reduction in detectable disease-associated genetic material, linked to low progression risk.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Three-Log Reduction</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Major Molecular Response</skos:prefLabel>
        <abbreviation xml:lang="en">MMR</abbreviation>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
