        <dcterms:identifier>HEO-L-b1c12a2eaad6</dcterms:identifier>
        <linkRationale xml:lang="en">Withdrawing treatment is stopping it before planned completion.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
