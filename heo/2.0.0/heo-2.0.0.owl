    <!-- https://healtheconomics.wiki/concept/first-generic-entry -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/first-generic-entry">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:notation>HS-DC-DP-030</skos:notation>
        <dcterms:identifier>HS-DC-DP-030</dcterms:identifier>
        <dcterms:source>FDA, Hatch-Waxman Act</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">First Generic Entry</rdfs:label>
        <skos:definition xml:lang="en">The introduction of the first generic competitor after a brand-name drug&apos;s patent and exclusivity expire, typically bringing a substantial initial price cut.</skos:definition>
        <skos:hiddenLabel xml:lang="en">First Generic Launch</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Generic Market Entry</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">First Generic Entry</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/price-erosion"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
