    <!-- https://healtheconomics.wiki/concept/tiered-alert -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/tiered-alert">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-alert"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-decision-support"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
