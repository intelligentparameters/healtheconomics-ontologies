    <!-- https://healtheconomics.wiki/concept/orphan-disease -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/orphan-disease">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:notation>HE-PE-RR-005</skos:notation>
        <dcterms:identifier>HE-PE-RR-005</dcterms:identifier>
        <dcterms:source>FDA, Orphan Drug Act</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Orphan Disease</rdfs:label>
        <skos:altLabel xml:lang="en">Rare Condition</skos:altLabel>
        <skos:altLabel xml:lang="en">Rare Disorder</skos:altLabel>
        <skos:definition xml:lang="en">A disease affecting a very small number of people, below a specified population threshold, historically receiving limited treatment development investment.</skos:definition>
        <skos:prefLabel xml:lang="en">Orphan Disease</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/small-population-challenge"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
