    <!-- https://healtheconomics.wiki/concept/emergency-exception -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/emergency-exception">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-HP-HD-042</skos:notation>
        <dcterms:identifier>HS-HP-HD-042</dcterms:identifier>
        <dcterms:source>Faden &amp; Beauchamp 1986</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Emergency Exception</rdfs:label>
        <skos:definition xml:lang="en">An exception to standard consent requirements, permitting providers to treat a patient facing an immediate, life-threatening emergency without prior consent.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Emergency Consent Exception</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Implied Emergency Consent</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Emergency Exception</skos:prefLabel>
        <counterpartOf rdf:resource="https://healtheconomics.wiki/concept/emergency-research-waiver"/>
        <modifies rdf:resource="https://healtheconomics.wiki/concept/informed-consent"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/emergency-exception"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-696f99177372</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Healthcare Delivery: organisation and delivery of care is the Health Systems subdomain (Organisation and governance)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/emergency-exception"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#counterpartOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/emergency-research-waiver"/>
        <dcterms:identifier>HEO-L-cc83d8fb80a9</dcterms:identifier>
