        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Condition Payment</rdfs:label>
        <skos:definition xml:lang="en">A payment arrangement in which a fixed amount covers a specific medical condition&apos;s treatment over a defined period, regardless of individual services required.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Condition-Based Payment</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Per-Condition Bundle</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Condition Payment</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/fee-for-service"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/condition-payment"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
