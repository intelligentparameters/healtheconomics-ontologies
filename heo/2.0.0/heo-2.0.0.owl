        <dcterms:identifier>HS-NHS-VBH-020</dcterms:identifier>
        <dcterms:source>ISPOR, Global Health Technology Assessment Roadmap</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Value Demonstration</rdfs:label>
        <skos:definition xml:lang="en">The process of generating and presenting evidence establishing a technology&apos;s clinical and economic value, spanning trial results, real-world evidence, and modelling.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Demonstrating Value</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Value Evidence Generation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Value Demonstration</skos:prefLabel>
        <produces rdf:resource="https://healtheconomics.wiki/concept/value-dossier"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
