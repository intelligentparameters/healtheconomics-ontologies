    <!-- https://healtheconomics.wiki/concept/large-group-market -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/large-group-market">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/group-market"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/group-market"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/health-insurance-market"/>
        <skos:notation>HS-HP-HI-107</skos:notation>
        <dcterms:identifier>HS-HP-HI-107</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Large Group Market</rdfs:label>
        <skos:definition xml:lang="en">The insurance market segment serving employers above a defined size threshold, often with greater flexibility in plan design and pricing.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Large Employer Market</skos:hiddenLabel>
