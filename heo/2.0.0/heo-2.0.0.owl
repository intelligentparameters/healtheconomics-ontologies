    <!-- https://healtheconomics.wiki/concept/informed-refusal -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/informed-refusal">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-HP-HD-061</skos:notation>
        <dcterms:identifier>HS-HP-HD-061</dcterms:identifier>
        <dcterms:source>Faden &amp; Beauchamp 1986</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Informed Refusal</rdfs:label>
        <skos:definition xml:lang="en">A patient&apos;s decision to decline recommended treatment after being given sufficient information about its risks, benefits, and alternatives.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Informed Declination</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Treatment Refusal</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Informed Refusal</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
