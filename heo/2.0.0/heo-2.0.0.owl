    <!-- https://healtheconomics.wiki/concept/value-of-statistical-life-year -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/value-of-statistical-life-year">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
