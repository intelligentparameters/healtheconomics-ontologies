        <skos:hiddenLabel xml:lang="en">Therapeutic Class Pricing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Internal Reference Pricing</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/external-reference-pricing"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
