        <skos:altLabel xml:lang="en">Biosimilar Penetration</skos:altLabel>
        <skos:definition xml:lang="en">The rate at which a biosimilar is adopted into clinical use after market entry, influenced by pricing, physician familiarity, and payer policy.</skos:definition>
        <skos:prefLabel xml:lang="en">Biosimilar Uptake</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
