    <!-- https://healtheconomics.wiki/concept/regulatory-capture -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/regulatory-capture">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/government-failure"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/government-failure"/>
        <skos:notation>HS-HP-PSE-003</skos:notation>
        <dcterms:identifier>HS-HP-PSE-003</dcterms:identifier>
        <dcterms:source>Stigler 1971</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Regulatory Capture</rdfs:label>
        <skos:altLabel xml:lang="en">Agency Capture</skos:altLabel>
        <skos:definition xml:lang="en">A phenomenon where a regulatory agency created to serve the public interest comes to be dominated by the interests of the industry it regulates.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Captured Regulator</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Regulatory Capture</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/regulatory-capture"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/government-failure"/>
        <dcterms:identifier>HEO-L-8b85318061a6</dcterms:identifier>
        <linkRationale xml:lang="en">Capture of a regulator by industry is a classic form of government failure (Stigler 1971)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


