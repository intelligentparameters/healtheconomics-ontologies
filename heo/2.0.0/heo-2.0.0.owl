    <!-- https://healtheconomics.wiki/concept/individual-patient-simulation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/individual-patient-simulation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/microsimulation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/microsimulation"/>
        <skos:notation>HE-EM-MS-001</skos:notation>
        <dcterms:identifier>HE-EM-MS-001</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-23</dcterms:modified>
        <dcterms:source>Barton, Bryan &amp; Robinson 2004</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Individual Patient Simulation</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">IPS</skos:altLabel>
        <skos:altLabel xml:lang="en">Individual-Based Simulation</skos:altLabel>
        <skos:altLabel xml:lang="en">Individual-Level Simulation</skos:altLabel>
        <skos:altLabel xml:lang="en">Patient-Level Microsimulation</skos:altLabel>
        <skos:altLabel xml:lang="en">Patient-Level Simulation</skos:altLabel>
        <skos:definition xml:lang="en">Individual patient simulation is a modelling approach that generates separate patient histories under specified rules and aggregates their costs and health outcomes for a target population.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Individual Patient Modeling</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Individual Patient Modelling</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Individual Patient Simulation</skos:prefLabel>
        <abbreviation xml:lang="en">IPS</abbreviation>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/patient-heterogeneity"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-7"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/monte-carlo-simulation"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/individual-patient-simulation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/microsimulation"/>
        <dcterms:identifier>HEO-L-2dd711e9f99d</dcterms:identifier>
        <linkRationale xml:lang="en">Simulating patients one at a time is microsimulation (object definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
