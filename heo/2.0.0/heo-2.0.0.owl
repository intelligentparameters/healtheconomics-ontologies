    <!-- https://healtheconomics.wiki/concept/threshold-approach -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/threshold-approach">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/decision-rule"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/decision-rule"/>
        <skos:notation>HE-EE-CEA-065</skos:notation>
        <dcterms:identifier>HE-EE-CEA-065</dcterms:identifier>
        <dcterms:source>Claxton et al. 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Threshold Approach</rdfs:label>
        <skos:definition xml:lang="en">A decision-making method that classifies an intervention as cost-effective or not based on whether its ICER falls below a predetermined threshold.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cost-Effectiveness Cut-Off Rule</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Threshold Decision Rule</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Threshold Approach</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-3"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-threshold"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/icer"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/threshold-approach"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/decision-rule"/>
        <dcterms:identifier>HEO-L-a554b0d94ea5</dcterms:identifier>
        <linkRationale xml:lang="en">The threshold approach is an explicit decision rule.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
