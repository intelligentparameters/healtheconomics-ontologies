    <!-- https://healtheconomics.wiki/concept/technical-efficiency -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/technical-efficiency">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/efficiency"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/efficiency"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/productive-efficiency"/>
        <skos:notation>HE-EE_EA-054</skos:notation>
        <dcterms:identifier>HE-EE_EA-054</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Farrell MJ. The measurement of productive efficiency. Journal of the Royal Statistical Society: Series A. 1957;120(3):253?290. doi:10.2307/2343100.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Technical Efficiency</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">Technical efficiency is the extent to which a unit produces its chosen outputs with the minimum feasible inputs, or maximizes those outputs from given inputs, under a specified production technology.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Best-Practice Efficiency</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Input-Output Efficiency</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Technical Efficiency</skos:prefLabel>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/technical-efficiency"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/efficiency"/>
        <dcterms:identifier>HEO-L-5ab5874f2b65</dcterms:identifier>
        <linkRationale xml:lang="en">Technical efficiency is one kind of efficiency.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/technical-efficiency"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/productive-efficiency"/>
        <dcterms:identifier>HEO-L-817838dd9253</dcterms:identifier>
        <linkRationale xml:lang="en">Productive efficiency needs technical efficiency plus the least-cost input mix (object definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/technical-efficiency-measure -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/technical-efficiency-measure">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/performance-measure"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/performance-measure"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/technical-efficiency"/>
        <skos:notation>HE-EE_EA-055</skos:notation>
        <dcterms:identifier>HE-EE_EA-055</dcterms:identifier>
        <dcterms:source>Farrell MJ. The measurement of productive efficiency. Journal of the Royal Statistical Society: Series A. 1957;120(3):253-290. doi:10.2307/2343100.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Technical Efficiency Measure</rdfs:label>
        <skos:definition xml:lang="en">A quantitative indicator of how closely a provider&apos;s actual input-output performance approaches the maximum achievable, benchmarked against an estimated production frontier.</skos:definition>
        <skos:hiddenLabel xml:lang="en">DEA Score</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Frontier Efficiency Score</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Technical Efficiency Measure</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/data-envelopment-analysis"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/technical-efficiency-measure"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/performance-measure"/>
        <dcterms:identifier>HEO-L-c5ca937eecd3</dcterms:identifier>
        <linkRationale xml:lang="en">A technical efficiency score is a quantified provider performance metric.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/technical-efficiency-measure"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
