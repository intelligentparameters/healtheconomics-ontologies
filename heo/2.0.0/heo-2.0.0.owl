    <!-- https://healtheconomics.wiki/concept/static-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/static-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-economic-model"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-economic-model"/>
        <skos:notation>HE-EM-DM-095</skos:notation>
        <dcterms:identifier>HE-EM-DM-095</dcterms:identifier>
        <dcterms:source>Briggs A, Claxton K, Sculpher M. Decision Modelling for Health Economic Evaluation. Oxford University Press; 2006. doi:10.1093/oso/9780198526629.001.0001.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Static Model</rdfs:label>
        <skos:altLabel xml:lang="en">Static Modelling</skos:altLabel>
        <skos:definition xml:lang="en">A model representing costs and outcomes at a single point in time, or that ignores how one individual&apos;s risk depends on others.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Time-Invariant Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Static Model</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/dynamic-transmission-model"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/static-model"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-economic-model"/>
        <dcterms:identifier>HEO-L-f2aa9d474ed2</dcterms:identifier>
        <linkRationale xml:lang="en">A static model is a health economic model.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/static-model"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/dynamic-transmission-model"/>
        <dcterms:identifier>HEO-L-d9716108ebb6</dcterms:identifier>
