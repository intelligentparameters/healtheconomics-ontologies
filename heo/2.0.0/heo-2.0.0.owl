    <!-- https://healtheconomics.wiki/concept/cost-effectiveness-acceptability -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cost-effectiveness-acceptability">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/decision-uncertainty"/>
        <skos:notation>HE-EE-CEA-009</skos:notation>
        <dcterms:identifier>HE-EE-CEA-009</dcterms:identifier>
        <dcterms:source>Fenwick, Claxton &amp; Sculpher 2001</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cost-Effectiveness Acceptability</rdfs:label>
        <skos:altLabel xml:lang="en">CE Acceptability</skos:altLabel>
        <skos:definition xml:lang="en">The probability that an intervention offers good value for money at a given willingness-to-pay threshold, accounting for uncertainty in the cost and effect estimates.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Acceptability Probability</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cost-Effectiveness Acceptability</skos:prefLabel>
        <abbreviation xml:lang="en">CE Acceptability</abbreviation>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-acceptability"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-9cf51eaed2f4</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Cost-Effectiveness Analysis: wiki topic Cost-effectiveness analysis sits in Economic Evaluation; placed under Cost-Effectiveness Analysis, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-acceptability"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
