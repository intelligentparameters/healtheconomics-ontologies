    <!-- https://healtheconomics.wiki/concept/consent-for-treatment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/consent-for-treatment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-HP-HD-031</skos:notation>
        <dcterms:identifier>HS-HP-HD-031</dcterms:identifier>
        <dcterms:source>Faden &amp; Beauchamp 1986</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Consent for Treatment</rdfs:label>
        <skos:definition xml:lang="en">The process by which a patient agrees to a proposed intervention after being given sufficient information to make an informed decision.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Clinical Consent</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Treatment Consent</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Consent for Treatment</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/informed-consent-for-research"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/consent-for-treatment"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-8fd94fd96fd2</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Healthcare Delivery: organisation and delivery of care is the Health Systems subdomain (Organisation and governance)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/consent-for-treatment"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
