    <!-- https://healtheconomics.wiki/concept/activity-based-costing -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/activity-based-costing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-allocation"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/micro-costing"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q754331"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cost-allocation"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/micro-costing"/>
        <skos:notation>HE-EE-CM-001</skos:notation>
        <dcterms:identifier>HE-EE-CM-001</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-03</dcterms:modified>
        <dcterms:source>Mogyorosy &amp; Smith 2005</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Activity-Based Costing</rdfs:label>
        <owl:versionInfo>1.0.4</owl:versionInfo>
        <skos:altLabel xml:lang="en">ABC</skos:altLabel>
        <skos:definition xml:lang="en">Activity-based costing (ABC) is a method that assigns resource costs to activities, then to patients or services in proportion to the activities they use.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Activity Costing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Activity-Based Costing</skos:prefLabel>
        <abbreviation xml:lang="en">ABC</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/top-down-costing"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/costs#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/cost-driver"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/activity-based-costing"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-allocation"/>
        <dcterms:identifier>HEO-L-17522b306a7f</dcterms:identifier>
        <linkRationale xml:lang="en">ABC assigns overheads to services through activities, a cost allocation rule</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
