    <!-- https://healtheconomics.wiki/concept/disease-burden -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/disease-burden">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q5282120"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HS-HP-PHO-005</skos:notation>
        <dcterms:identifier>HS-HP-PHO-005</dcterms:identifier>
        <dcterms:source>Murray &amp; Lopez 1996</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Disease Burden</rdfs:label>
        <skos:definition xml:lang="en">The total impact of a disease on a population, covering mortality, morbidity, and costs, commonly quantified using disability-adjusted life years.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Population Disease Impact</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Total Disease Impact</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Disease Burden</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/priority-setting"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/disease-burden"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-fa2397e18e46</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Population Health Outcomes: burden, comorbidity and multimorbidity are epidemiology; most concepts with this Level 3 that the wiki places in a topic sit in Evidence Synthesis</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/disease-burden"/>
