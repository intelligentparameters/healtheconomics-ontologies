    <!-- https://healtheconomics.wiki/concept/diagnostic-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/diagnostic-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/risk-prediction-model"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/risk-prediction-model"/>
        <skos:notation>HS-SS_DH-012</skos:notation>
        <dcterms:identifier>HS-SS_DH-012</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</dcterms:modified>
        <dcterms:source>Collins et al. 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Diagnostic Model</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:definition xml:lang="en">A diagnostic model is a multivariable prediction model estimating the probability a condition is present now, to guide testing, referral and treatment.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Diagnosis Prediction Model</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Diagnostic Classifier</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Diagnostic Model</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/prognostic-model"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/referral"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/logistic-regression"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/diagnostic-model"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/risk-prediction-model"/>
        <dcterms:identifier>HEO-L-ce7226ee572d</dcterms:identifier>
        <linkRationale xml:lang="en">TRIPOD (Collins et al. 2015) treats diagnostic and prognostic models as multivariable risk prediction models</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
