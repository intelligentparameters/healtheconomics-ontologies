    <!-- https://healtheconomics.wiki/concept/contingent-valuation-method -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/contingent-valuation-method">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/stated-preference"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q643736"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/stated-preference"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/willingness-to-pay"/>
        <skos:notation>HE-EE-CBA-013</skos:notation>
        <dcterms:identifier>HE-EE-CBA-013</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Mitchell &amp; Carson 1989</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Contingent Valuation Method</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">CVM</skos:altLabel>
        <skos:definition xml:lang="en">The contingent valuation method elicits a monetary value for a specified nonmarket health-related change by asking people what they would pay or accept in a carefully described hypothetical scenario.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Stated-Preference Valuation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Contingent Valuation Method</skos:prefLabel>
        <abbreviation xml:lang="en">CVM</abbreviation>
        <assumes rdf:resource="https://healtheconomics.wiki/concept/consequentiality"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/outcomes#step-4"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/contingent-valuation-method"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/stated-preference"/>
        <dcterms:identifier>HEO-L-f74c803995df</dcterms:identifier>
        <linkRationale xml:lang="en">A stated preference method</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/contingent-valuation-method"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/willingness-to-pay"/>
