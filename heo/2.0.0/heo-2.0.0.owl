    <!-- https://healtheconomics.wiki/concept/market-failure -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/market-failure">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q622657"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <skos:notation>HE-EE-ME-035</skos:notation>
        <dcterms:identifier>HE-EE-ME-035</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Arrow 1963</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Market Failure</rdfs:label>
        <owl:versionInfo>1.0.12</owl:versionInfo>
        <skos:definition xml:lang="en">Market failure occurs when markets do not allocate resources efficiently, as in health care through externalities, unequal information or insurance gaps.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Allocation Failure</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Market Imperfection</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Market Inefficiency</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Market Failure</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/allocative-distortion"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/deadweight-loss"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/government-intervention"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/market-failure"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-352c7dc89880</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Market failure and information in subdomain Economic Foundations</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/market-failure"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/allocative-distortion"/>
        <dcterms:identifier>HEO-L-9976fe88f3cb</dcterms:identifier>
        <linkRationale xml:lang="en">Distortion can stem from market failure, regulation or mispricing, so it is an effect of market failure, not a kind of it</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/market-failure"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/deadweight-loss"/>
        <dcterms:identifier>HEO-L-adcbbd4a09dd</dcterms:identifier>
        <linkRationale xml:lang="en">Inefficient allocation produces deadweight loss</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/market-failure"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#setsScopeOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/government-intervention"/>
        <dcterms:identifier>HEO-L-401b2b400661</dcterms:identifier>
