        <skos:hiddenLabel xml:lang="en">Ratio Measurement</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Ratio Scaling</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/interval-scaling"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
