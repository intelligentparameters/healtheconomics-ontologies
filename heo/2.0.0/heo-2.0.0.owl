    <!-- https://healtheconomics.wiki/concept/key-secondary-outcome -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/key-secondary-outcome">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
