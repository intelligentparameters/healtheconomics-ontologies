    <!-- https://healtheconomics.wiki/concept/factor-rotation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/factor-rotation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/exploratory-factor-analysis"/>
        <skos:notation>HE-ES-SA-063</skos:notation>
        <dcterms:identifier>HE-ES-SA-063</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-23</dcterms:modified>
        <dcterms:source>Kaiser 1958</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Factor Rotation</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Factor Rotations</skos:altLabel>
        <skos:definition xml:lang="en">Factor rotation transforms an extracted factor solution to make its loading pattern easier to interpret while preserving the model-implied common covariance under an equivalent transformation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Oblique Factor Rotation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Orthogonal Factor Rotation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Promax Rotation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Factor Rotation</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/factor-loading"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/factor-rotation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-b3b4d4824248</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Statistical methods in subdomain Evidence Synthesis; placed under Statistical Method, the concept named by its wiki topic</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/factor-rotation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/exploratory-factor-analysis"/>
        <dcterms:identifier>HEO-L-ecd9e8676bdf</dcterms:identifier>
        <linkRationale xml:lang="en">Rotation is a step of exploratory factor analysis after extraction (subject definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
