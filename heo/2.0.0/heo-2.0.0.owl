        <skos:altLabel xml:lang="en">Between-Person Variability</skos:altLabel>
        <skos:altLabel xml:lang="en">Inter-Individual Variation</skos:altLabel>
        <skos:definition xml:lang="en">Between-subject variation is how much costs or outcomes differ from one patient to another, as opposed to variation in one person&apos;s repeated measurements.</skos:definition>
        <skos:prefLabel xml:lang="en">Between-Subject Variation</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/parameter-uncertainty"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/within-subject-variation"/>
