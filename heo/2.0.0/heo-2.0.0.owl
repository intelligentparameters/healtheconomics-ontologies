    <!-- https://healtheconomics.wiki/concept/prospective-evaluation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/prospective-evaluation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-evaluation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/economic-evaluation"/>
        <skos:notation>HE-EE-EM-010</skos:notation>
        <dcterms:identifier>HE-EE-EM-010</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Prospective Evaluation</rdfs:label>
        <skos:definition xml:lang="en">An economic evaluation in which cost and outcome data are collected forward in time from the study&apos;s start, unlike a retrospective evaluation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Concurrent Evaluation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Forward Evaluation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Prospective Evaluation</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/retrospective-evaluation"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/prospective-data"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/prospective-evaluation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-evaluation"/>
        <dcterms:identifier>HEO-L-4c40284077c7</dcterms:identifier>
        <linkRationale xml:lang="en">Defined as an economic evaluation with forward data collection, so a kind of economic evaluation</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
