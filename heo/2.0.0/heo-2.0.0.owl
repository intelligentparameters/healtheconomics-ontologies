    <!-- https://healtheconomics.wiki/concept/spearman-correlation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/spearman-correlation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/correlation"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/non-parametric-methods"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/correlation"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/non-parametric-methods"/>
        <skos:notation>HE-ES-SA-198</skos:notation>
        <dcterms:identifier>HE-ES-SA-198</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Spearman 1904</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Spearman Correlation</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Spearman Rank Correlation</skos:altLabel>
        <skos:altLabel xml:lang="en">Spearman&apos;s Rho</skos:altLabel>
        <skos:definition xml:lang="en">A non-parametric measure of the monotonic relationship between two ranked variables, calculated from data ranks rather than raw values.</skos:definition>
        <skos:prefLabel xml:lang="en">Spearman Correlation</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/spearman-correlation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/correlation"/>
        <dcterms:identifier>HEO-L-93d3e6a77a8f</dcterms:identifier>
        <linkRationale xml:lang="en">Spearman is a correlation coefficient.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/spearman-correlation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/non-parametric-methods"/>
