    <!-- https://healtheconomics.wiki/concept/cost-driver -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cost-driver">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q973302"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/cost-function"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/unit-cost"/>
        <skos:notation>HE-EE-CA-021</skos:notation>
        <dcterms:identifier>HE-EE-CA-021</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</dcterms:modified>
        <dcterms:source>Mogyorosy &amp; Smith 2005</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cost Driver</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">A cost driver is a factor that causes a health service&apos;s costs to change over a period, such as patient visits, bed-days, staff time or case mix.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cost Determinant</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Spending Driver</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cost Driver</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/healthcare-cost-growth"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cost-driver"/>
