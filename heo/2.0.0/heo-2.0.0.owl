        <dcterms:identifier>CS-LA-MO-004</dcterms:identifier>
        <dcterms:source>Golub GH, Van Loan CF. Matrix Computations. 4th ed. Johns Hopkins University Press; 2013.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Determinant</rdfs:label>
        <skos:altLabel xml:lang="en">Det</skos:altLabel>
        <skos:definition xml:lang="en">A scalar value calculated from a square matrix that indicates properties including invertibility, scaling and the independence of its rows or columns.</skos:definition>
