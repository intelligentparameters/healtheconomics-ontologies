    <!-- https://healtheconomics.wiki/concept/intensity-growth -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/intensity-growth">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/healthcare-cost-growth"/>
        <skos:notation>HE-EE-CA-056</skos:notation>
        <dcterms:identifier>HE-EE-CA-056</dcterms:identifier>
        <dcterms:source>Newhouse 1992</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Intensity Growth</rdfs:label>
        <skos:definition xml:lang="en">An increase in the sophistication or resource intensity of care delivered per episode of illness, independent of changes in patient numbers.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Per-Episode Intensification</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Rising Care Intensity</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Intensity Growth</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
