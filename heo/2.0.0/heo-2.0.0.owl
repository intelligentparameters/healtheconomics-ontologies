    <!-- https://healtheconomics.wiki/concept/budget-allocation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/budget-allocation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/resource-allocation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/resource-allocation"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/budget-cycle"/>
        <skos:notation>HS-HP-HF-005</skos:notation>
        <dcterms:identifier>HS-HP-HF-005</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Mitton &amp; Donaldson 2004; Penno et al. 2013; Crown et al. 2017</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Budget Allocation</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Budget allocation is the division of a fixed health budget between areas or programmes, using needs-based formulae, priority setting or optimisation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Budget Distribution</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Fund Allocation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Budget Allocation</skos:prefLabel>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/constrained-optimisation"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/healthcare-budget"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/pbma"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/budget-allocation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/resource-allocation"/>
        <dcterms:identifier>HEO-L-59adab6279a1</dcterms:identifier>
        <linkRationale xml:lang="en">Budget allocation is resource allocation of a fixed budget</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
