        <skos:notation>HE-EE-CEA-050</skos:notation>
        <dcterms:identifier>HE-EE-CEA-050</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Patient Perspective</rdfs:label>
        <skos:definition xml:lang="en">An analytic viewpoint including only costs and outcomes directly experienced by the patient, such as out-of-pocket expenses and personal time costs.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Patient Viewpoint</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Patient-Level Perspective</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Patient Perspective</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/payer-perspective"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/societal-perspective"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/patient-perspective"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
