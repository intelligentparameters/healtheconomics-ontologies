    <!-- https://healtheconomics.wiki/concept/nominal-scale -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/nominal-scale">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/categorical-data"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/measurement-scale-type"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/categorical-data"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/measurement-scale-type"/>
        <skos:notation>HE-EE-HU-102</skos:notation>
        <dcterms:identifier>HE-EE-HU-102</dcterms:identifier>
        <dcterms:source>Stevens 1946</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Nominal Scale</rdfs:label>
        <skos:definition xml:lang="en">Nominal scale is a level of measurement whose numbers only name categories, such as trial arm or EQ-5D dimension, so counts are valid but averages are not.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Nominal Level of Measurement</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Nominal Measurement</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Nominal Variable</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Nominal Scale</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/ordinal-scaling"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/contingency-table"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/nominal-scale"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/categorical-data"/>
        <dcterms:identifier>HEO-L-898e560fac93</dcterms:identifier>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
