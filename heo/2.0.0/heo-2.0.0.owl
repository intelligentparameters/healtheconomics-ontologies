        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/government-failure"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/regulatory-capture"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/rent-seeking"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
