    <!-- https://healtheconomics.wiki/concept/budget-justification -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/budget-justification">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
