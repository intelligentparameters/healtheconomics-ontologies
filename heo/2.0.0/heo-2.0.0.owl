    <!-- https://healtheconomics.wiki/concept/simulated-annealing -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/simulated-annealing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/numerical-optimisation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/numerical-optimisation"/>
        <skos:notation>HE-EM-DM-090</skos:notation>
        <dcterms:identifier>HE-EM-DM-090</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Kirkpatrick, Gelatt &amp; Vecchi 1983</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Simulated Annealing</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">An optimisation technique modelled on slowly cooling metal, occasionally accepting worse solutions during search to avoid becoming trapped in a poor local solution.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Annealing Optimisation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">SA Optimisation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Simulated Annealing</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-12"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/simulated-annealing"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/numerical-optimisation"/>
        <dcterms:identifier>HEO-L-d9f4ad80df7f</dcterms:identifier>
        <linkRationale xml:lang="en">Simulated annealing is an iterative computational optimisation method.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/simulated-treatment-comparison -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/simulated-treatment-comparison">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/indirect-treatment-comparison"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/indirect-treatment-comparison"/>
        <skos:notation>HE-ES-CER-025</skos:notation>
        <dcterms:identifier>HE-ES-CER-025</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Caro &amp; Ishak 2010</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Simulated Treatment Comparison</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">STC</skos:altLabel>
        <skos:definition xml:lang="en">A method comparing treatments from separate trials by fitting a regression model to one trial&apos;s data to predict outcomes for the other&apos;s population.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Simulated Comparison</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Simulated Treatment Comparison</skos:prefLabel>
        <abbreviation xml:lang="en">STC</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/regression-analysis"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/simulated-treatment-comparison"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/indirect-treatment-comparison"/>
        <dcterms:identifier>HEO-L-6bc02ff8e721</dcterms:identifier>
        <linkRationale xml:lang="en">STC is one of the umbrella indirect treatment comparison methods.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/simulated-treatment-comparison"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/regression-analysis"/>
        <dcterms:identifier>HEO-L-60668ec5f958</dcterms:identifier>
        <linkRationale xml:lang="en">STC fits a regression model to one trial&apos;s data.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
