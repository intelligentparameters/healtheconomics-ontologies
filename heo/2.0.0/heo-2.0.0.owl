        <skos:notation>HE-PE-TI-012</skos:notation>
        <dcterms:identifier>HE-PE-TI-012</dcterms:identifier>
        <dcterms:source>DiMasi JA, Grabowski HG, Hansen RW. Innovation in the pharmaceutical industry: new estimates of R&amp;D costs. Journal of Health Economics. 2016;47:20-33. doi:10.1016/j.jhealeco.2016.01.012.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">First-in-Class</rdfs:label>
        <skos:definition xml:lang="en">A designation for a treatment introducing an entirely novel mechanism of action not previously available for a given condition.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Novel Mechanism Drug</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Pioneer Drug</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">First-in-Class</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
