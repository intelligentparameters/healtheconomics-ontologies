    <!-- https://healtheconomics.wiki/concept/indirect-comparison -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/indirect-comparison">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/indirect-treatment-comparison"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/indirect-treatment-comparison"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/network-meta-analysis"/>
        <skos:notation>HE-ES-ESM-027</skos:notation>
        <dcterms:identifier>HE-ES-ESM-027</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-26</dcterms:modified>
        <dcterms:source>Bucher et al. 1997</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Indirect Comparison</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A method estimating the relative effect of two treatments never studied against each other directly, using their separate effects versus a shared comparator.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Anchored Comparison</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Bucher Method</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Indirect Comparison</skos:prefLabel>
        <assumes rdf:resource="https://healtheconomics.wiki/concept/connected-network"/>
        <assumes rdf:resource="https://healtheconomics.wiki/concept/consistency"/>
        <assumes rdf:resource="https://healtheconomics.wiki/concept/transitivity"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-4"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/indirect-evidence"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/common-comparator"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/treatment-network"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/indirect-comparison"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/indirect-treatment-comparison"/>
        <dcterms:identifier>HEO-L-b9509eacbb88</dcterms:identifier>
        <linkRationale xml:lang="en">An ITC method.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/indirect-comparison"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/network-meta-analysis"/>
        <dcterms:identifier>HEO-L-e52f925febf5</dcterms:identifier>
        <linkRationale xml:lang="en">NMA pools direct and indirect evidence, so the indirect comparison is a component (object definition)</linkRationale>
