    <!-- https://healtheconomics.wiki/concept/constant-hazard -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/constant-hazard">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/hazard-rate"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/hazard-rate"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/transition-probability"/>
        <skos:notation>HE-EM-SM-007</skos:notation>
        <dcterms:identifier>HE-EM-SM-007</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Latimer 2013</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Constant Hazard</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Constant hazard is the survival modelling assumption that the event rate among people still at risk stays the same over time, giving exponential survival.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Flat Hazard</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Time-Invariant Hazard</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Constant Hazard</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/time-varying-hazard"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/constant-hazard"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/hazard-rate"/>
        <dcterms:identifier>HEO-L-1bc59b0a4ae8</dcterms:identifier>
        <linkRationale xml:lang="en">A constant hazard rate is a hazard rate</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/constant-hazard"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/transition-probability"/>
        <dcterms:identifier>HEO-L-e75811d793dd</dcterms:identifier>
        <linkRationale xml:lang="en">A constant rate r gives a cycle probability p = 1 - exp(-rt)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/constant-hazard"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/time-varying-hazard"/>
        <dcterms:identifier>HEO-L-4d51bc6ca624</dcterms:identifier>
        <linkRationale xml:lang="en">Object definition contrasts it with constant hazard; symmetric pair kept on this side (reverse in r3-19 is the duplicate)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


