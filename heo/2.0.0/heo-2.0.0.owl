    <!-- https://healtheconomics.wiki/concept/paediatric-exclusivity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/paediatric-exclusivity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
