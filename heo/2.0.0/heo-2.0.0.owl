    <!-- https://healtheconomics.wiki/concept/active-ingredient -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/active-ingredient">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-classification"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/drug-classification"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/anatomical-therapeutic-chemical"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/medicinal-product"/>
        <skos:notation>HE-PE-DC-001</skos:notation>
        <dcterms:identifier>HE-PE-DC-001</dcterms:identifier>
        <dcterms:source>FDA, Code of Federal Regulations Title 21</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Active Ingredient</rdfs:label>
        <skos:altLabel xml:lang="en">API</skos:altLabel>
        <skos:altLabel xml:lang="en">Active Pharmaceutical Ingredient</skos:altLabel>
        <skos:definition xml:lang="en">The specific component of a pharmaceutical product responsible for its intended therapeutic effect, unlike inactive ingredients included for stability or ease of use.</skos:definition>
        <skos:prefLabel xml:lang="en">Active Ingredient</skos:prefLabel>
        <abbreviation xml:lang="en">API</abbreviation>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
