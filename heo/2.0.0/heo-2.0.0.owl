    <!-- https://healtheconomics.wiki/concept/headroom-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/headroom-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
