    <!-- https://healtheconomics.wiki/concept/additive-scale -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/additive-scale">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/interaction"/>
        <skos:notation>HE-ES-RM-004</skos:notation>
        <dcterms:identifier>HE-ES-RM-004</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Knol et al. 2011</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Additive Interaction Scale</rdfs:label>
        <owl:versionInfo>1.0.4</owl:versionInfo>
        <skos:definition xml:lang="en">The additive interaction scale judges two exposures to interact when their joint risk difference departs from the sum of their separate risk differences.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Additive Interaction</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Risk-Difference Interaction</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Additive Interaction Scale</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/multiplicative-scale"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/subgroup-cost-effectiveness"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-2"/>
        <prerequisiteFor rdf:resource="https://healtheconomics.wiki/concept/scale-dependence"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/absolute-risk"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/relative-risk"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/risk-difference"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/additive-scale"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
