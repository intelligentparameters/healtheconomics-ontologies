        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/response-error"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/non-response-error"/>
        <dcterms:identifier>HEO-L-ae9df869c312</dcterms:identifier>
        <linkRationale xml:lang="en">Response and non-response error are the two alternative respondent-side survey errors.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
