        <skos:altLabel xml:lang="en">Cross-Sectoral Action</skos:altLabel>
        <skos:altLabel xml:lang="en">Multisectoral Action</skos:altLabel>
        <skos:definition xml:lang="en">Coordinated action across multiple government sectors, such as health and education, working toward a shared health objective outside sole health control.</skos:definition>
        <skos:prefLabel xml:lang="en">Intersectoral Action</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
