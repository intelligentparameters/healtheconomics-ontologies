    <!-- https://healtheconomics.wiki/concept/sheffield-elicitation-framework -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/sheffield-elicitation-framework">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/structured-expert-judgment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/structured-expert-judgment"/>
        <skos:notation>HE-EM-VI-031</skos:notation>
        <dcterms:identifier>HE-EM-VI-031</dcterms:identifier>
        <dcterms:source>O&apos;Hagan et al. 2006</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Sheffield Elicitation Framework</rdfs:label>
        <skos:altLabel xml:lang="en">SHELF</skos:altLabel>
        <skos:definition xml:lang="en">A structured protocol eliciting probability distributions from a group of experts, combining individual assessment with facilitated group discussion toward a consensus.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Sheffield Elicitation Protocol</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Sheffield Elicitation Framework</skos:prefLabel>
        <abbreviation xml:lang="en">SHELF</abbreviation>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
