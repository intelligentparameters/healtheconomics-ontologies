    <!-- https://healtheconomics.wiki/concept/euler-method -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/euler-method">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/numerical-method"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/runge-kutta-method"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/numerical-method"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/runge-kutta-method"/>
        <skos:notation>CS-DE-NOM-001</skos:notation>
        <dcterms:identifier>CS-DE-NOM-001</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-23</dcterms:modified>
        <dcterms:source>Butcher JC. Numerical Methods for Ordinary Differential Equations. 3rd ed. Wiley; 2016. doi:10.1002/9781119121534.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Euler Method</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Explicit Euler Scheme</skos:altLabel>
        <skos:altLabel xml:lang="en">Forward Euler</skos:altLabel>
        <skos:definition xml:lang="en">The Euler method is a first-order numerical procedure that approximates the solution of an initial-value ordinary differential equation by advancing from the current value along the derivative over discrete steps.</skos:definition>
        <skos:prefLabel xml:lang="en">Euler Method</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-12"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/euler-method"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/numerical-method"/>
        <dcterms:identifier>HEO-L-c7c67df9fe27</dcterms:identifier>
        <linkRationale xml:lang="en">Euler is a numerical method for ODEs</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
