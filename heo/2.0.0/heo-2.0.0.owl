    <!-- https://healtheconomics.wiki/concept/futile-care -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/futile-care">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/low-value-care"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/low-value-care"/>
        <skos:notation>HS-HP-HD-049</skos:notation>
        <dcterms:identifier>HS-HP-HD-049</dcterms:identifier>
        <dcterms:source>Schneiderman, Jecker &amp; Jonsen 1990</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Futile Care</rdfs:label>
        <skos:altLabel xml:lang="en">Clinical Futility</skos:altLabel>
        <skos:altLabel xml:lang="en">Medical Futility</skos:altLabel>
        <skos:altLabel xml:lang="en">Non-Beneficial Treatment</skos:altLabel>
        <skos:definition xml:lang="en">Medical treatment judged unlikely to produce meaningful clinical benefit despite continuing to be administered, raising ethical and resource concerns.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Futility of Care</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Treatment Futility</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Futile Care</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/end-of-life-cost"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/futile-care"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/low-value-care"/>
        <dcterms:identifier>HEO-L-66d0a94f984d</dcterms:identifier>
        <linkRationale xml:lang="en">Futile care gives little benefit for its cost</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
