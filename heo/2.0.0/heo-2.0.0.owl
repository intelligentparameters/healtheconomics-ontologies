    <!-- https://healtheconomics.wiki/concept/stem-cell-therapy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/stem-cell-therapy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
