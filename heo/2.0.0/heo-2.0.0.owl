    <!-- https://healtheconomics.wiki/concept/hypothetical-bias -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/hypothetical-bias">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/bias"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/bias"/>
        <skos:notation>HE-EE-CBA-026</skos:notation>
        <dcterms:identifier>HE-EE-CBA-026</dcterms:identifier>
        <dcterms:source>Murphy et al. 2005</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Hypothetical Bias</rdfs:label>
        <skos:definition xml:lang="en">The tendency for willingness-to-pay values stated in a hypothetical survey to overstate what respondents would actually pay in a real transaction.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Stated-Preference Bias</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">WTP Overstatement</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Hypothetical Bias</skos:prefLabel>
