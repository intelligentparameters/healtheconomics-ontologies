    <!-- https://healtheconomics.wiki/concept/risk-corridor -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/risk-corridor">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/risk-sharing"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q120567829"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/risk-sharing"/>
        <skos:notation>HS-HP-PP-092</skos:notation>
        <dcterms:identifier>HS-HP-PP-092</dcterms:identifier>
        <dcterms:source>US, Affordable Care Act</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Risk Corridor</rdfs:label>
        <skos:definition xml:lang="en">A risk-sharing mechanism where government shares in an insurer&apos;s unexpectedly high losses or profits relative to a projected target, stabilising a new market.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Loss Corridor</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Risk-Sharing Corridor</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Risk Corridor</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/reinsurance"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/risk-equalization"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-3"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/risk-corridor"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/risk-sharing"/>
        <dcterms:identifier>HEO-L-c044b48f0f70</dcterms:identifier>
        <linkRationale xml:lang="en">Government and insurer share losses or gains, a risk-sharing arrangement.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/risk-corridor"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/reinsurance"/>
        <dcterms:identifier>HEO-L-08c4375470e4</dcterms:identifier>
        <linkRationale xml:lang="en">Corridors and reinsurance are alternative premium stabilisation mechanisms.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
