    <!-- https://healtheconomics.wiki/concept/economic-foundations -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/economic-foundations">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-economics"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-economics"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/health-economics"/>
        <skos:notation>HE-FD-EF-001</skos:notation>
        <dcterms:identifier>HE-FD-EF-001</dcterms:identifier>
        <dcterms:source>Gillespie 2014; Begg 2013; Samuelson 1947; Arrow 1963; Grossman 1972</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Economic Foundations</rdfs:label>
        <skos:altLabel xml:lang="en">Economic Theory</skos:altLabel>
        <skos:altLabel xml:lang="en">Foundations of Economics</skos:altLabel>
        <skos:definition xml:lang="en">Economic foundations is the area of health economics that covers the economic theory health economists rely on, from scarcity, opportunity cost, demand, supply and elasticity to markets and market failure, welfare economics and the demand for health and health capital.</skos:definition>
        <skos:editorialNote xml:lang="en">In HEO this concept is the wiki subdomain Economic Foundations, directly under Health Economics. Concepts in that subdomain with no is-type-of parent are classified under it or under a concept within it.</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Economic Foundations</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-economics"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-d0a2dada4368</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: the wiki subdomain Economic Foundations (option, no subdomain page yet)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-economics"/>
        <dcterms:identifier>HEO-L-c4cac4ec1a6f</dcterms:identifier>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/economic-good -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/economic-good">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q28877"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <skos:notation>HE-EE-ME-081</skos:notation>
        <dcterms:identifier>HE-EE-ME-081</dcterms:identifier>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Economic Good</rdfs:label>
        <skos:definition xml:lang="en">In health economics, any scarce good or service that commands a price and is subject to allocation choices, classified by rivalry, excludability and how consumers come to know its quality.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Economic Commodity</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Priced Good</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Economic Good</skos:prefLabel>
        <prerequisiteFor rdf:resource="https://healtheconomics.wiki/concept/welfare-economics"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/economic-good"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-b56ca55926b0</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Scarcity choice and opportunity cost in subdomain Economic Foundations</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/economic-good"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#prerequisiteFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/welfare-economics"/>
        <dcterms:identifier>HEO-L-bc6907cf7838</dcterms:identifier>
        <linkRationale xml:lang="en">Welfare economics judges the allocation of scarce goods, so the idea of an economic good must be understood first</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/economic-incentive -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/economic-incentive">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-principle"/>
