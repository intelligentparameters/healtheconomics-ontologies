    <!-- https://healtheconomics.wiki/concept/intravenous-administration -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/intravenous-administration">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
