    <!-- https://healtheconomics.wiki/concept/rare-disease-economics -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/rare-disease-economics">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-evaluation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-evaluation"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/health-economics"/>
        <skos:notation>HE-PE-RR-009</skos:notation>
        <dcterms:identifier>HE-PE-RR-009</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Rare Disease Economics</rdfs:label>
        <skos:definition xml:lang="en">The application of health economic evaluation to conditions affecting a small population share, adapting standard methods for limited natural history data and small trials.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Economics of Rare Diseases</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Rare Condition Economics</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Rare Disease Economics</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/small-population-challenge"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/natural-history-study"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/rare-disease-economics"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-evaluation"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-f373dddeb49b</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: curated: disease-area economics is a wiki topic in Economic Evaluation (Disease-area economics); a field within health economics (partOf), not a type of it</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/rare-disease-economics"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-economics"/>
        <dcterms:identifier>HEO-L-4f842ef15a3d</dcterms:identifier>
        <dcterms:replaces>HEO-L-e630d8e9e385</dcterms:replaces>
        <skos:editorialNote xml:lang="en">replaces link HEO-L-e630d8e9e385 (is type of Health Economics), kept in the link records as superseded</skos:editorialNote>
        <linkRationale xml:lang="en">A disease-area economics is a field within health economics, so part of replaces is type of (HEO 1.2.0 review)</linkRationale>
