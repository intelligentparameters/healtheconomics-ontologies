    <!-- https://healtheconomics.wiki/concept/steady-state -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/steady-state">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/markov-model"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
