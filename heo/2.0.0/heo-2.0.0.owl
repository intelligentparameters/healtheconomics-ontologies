        <dcterms:identifier>HE-EE-CRE-003</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-09</dcterms:modified>
        <dcterms:source>Ostrom 2009</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Common Pool Resources</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Commons</skos:altLabel>
        <skos:definition xml:lang="en">Common pool resources are goods where one user&apos;s use leaves less for others and excluding users is difficult or costly.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Common-Pool Goods</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Common Pool Resources</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/public-good"/>
