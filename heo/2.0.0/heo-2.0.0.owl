        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/ex-post-moral-hazard -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/ex-post-moral-hazard">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/moral-hazard"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/moral-hazard"/>
        <skos:notation>HE-EE-HI-002</skos:notation>
        <dcterms:identifier>HE-EE-HI-002</dcterms:identifier>
        <dcterms:source>Pauly 1968</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Ex Post Moral Hazard</rdfs:label>
        <skos:definition xml:lang="en">An increase in healthcare utilisation occurring after an insured event because insurance reduces the marginal price the patient faces for care.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Post-Loss Moral Hazard</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Utilisation Moral Hazard</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Ex Post Moral Hazard</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/ex-post-moral-hazard"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/moral-hazard"/>
        <dcterms:identifier>HEO-L-a22d5d71da4e</dcterms:identifier>
        <linkRationale xml:lang="en">Ex post moral hazard is a kind of moral hazard</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/exceptional-funding -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/exceptional-funding">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/coverage-decision"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/coverage-decision"/>
        <skos:notation>HS-HP-HTA-085</skos:notation>
        <dcterms:identifier>HS-HP-HTA-085</dcterms:identifier>
        <dcterms:source>National Institute for Health and Care Excellence. NICE technology appraisal and highly specialised technologies guidance: the manual (PMG36). Published 2022; updated 2026.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Exceptional Funding</rdfs:label>
        <skos:definition xml:lang="en">A mechanism allowing an individual patient to receive funding for a treatment not otherwise covered, when their circumstances are genuinely exceptional.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Exceptional Case Funding</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Individual Exception Funding</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Exceptional Funding</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/access-to-care"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/exceptional-funding"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/coverage-decision"/>
        <dcterms:identifier>HEO-L-758e1bc0138d</dcterms:identifier>
        <linkRationale xml:lang="en">An exceptional funding ruling is a coverage decision for one patient</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/exceptional-funding"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/access-to-care"/>
        <dcterms:identifier>HEO-L-05034f92a3fd</dcterms:identifier>
        <linkRationale xml:lang="en">Definition: lets an individual receive an otherwise uncovered treatment.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/excess-days -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/excess-days">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/operational-efficiency"/>
        <skos:notation>HS-NHS-PM-009</skos:notation>
        <dcterms:identifier>HS-NHS-PM-009</dcterms:identifier>
        <dcterms:source>World Health Organization. Everybody&apos;s Business: Strengthening Health Systems to Improve Health Outcomes-WHO&apos;s Framework for Action. WHO; 2007.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Excess Days</rdfs:label>
        <skos:altLabel xml:lang="en">Excess Bed Days</skos:altLabel>
        <skos:definition xml:lang="en">The number of hospital days a patient spends beyond what would typically be expected for their diagnosis, an inefficiency indicator.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Additional Inpatient Days</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Excess Days</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/hospitalization-cost"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/excess-days"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-51bb9168a071</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; NHS Productivity &gt; Productivity Measurement: wiki topic Performance, productivity and quality sits in Health Systems</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/excess-days"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/operational-efficiency"/>
        <dcterms:identifier>HEO-L-e388e47bbb94</dcterms:identifier>
        <linkRationale xml:lang="en">Excess days indicate operational inefficiency (subject definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/excess-days"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
