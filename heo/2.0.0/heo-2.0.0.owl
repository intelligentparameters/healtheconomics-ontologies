    <!-- https://healtheconomics.wiki/concept/reproduction-number -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/reproduction-number">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/epidemiology"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q97204337"/>
