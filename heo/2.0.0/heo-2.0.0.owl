    <!-- https://healtheconomics.wiki/concept/negative-study -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/negative-study">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
