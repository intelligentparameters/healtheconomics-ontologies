    <!-- https://healtheconomics.wiki/concept/poverty-line -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/poverty-line">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
