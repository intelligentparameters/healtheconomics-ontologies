    <!-- https://healtheconomics.wiki/concept/confidential-price -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/confidential-price">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/net-price"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/net-price"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/drug-cost"/>
        <skos:notation>HS-DC-DP-017</skos:notation>
        <dcterms:identifier>HS-DC-DP-017</dcterms:identifier>
        <dcterms:source>Carlson JJ, Sullivan SD, Garrison LP, Neumann PJ, Veenstra DL. Linking payment to health outcomes: a taxonomy and examination of performance-based reimbursement schemes. Health Policy. 2010;96(3):179-190.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Confidential Price</rdfs:label>
        <skos:definition xml:lang="en">The actual net price paid for a treatment following a confidential discount, differing from and typically lower than the publicly disclosed list price.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Actual Net Price</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Net Transaction Price</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Confidential Price</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
