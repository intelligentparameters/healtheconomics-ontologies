    <!-- https://healtheconomics.wiki/concept/stopping-rule -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/stopping-rule">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
