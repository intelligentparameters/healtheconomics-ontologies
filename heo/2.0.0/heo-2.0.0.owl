        <dcterms:identifier>HEO-L-951c5889c71c</dcterms:identifier>
        <linkRationale xml:lang="en">Distance is an access barrier</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
