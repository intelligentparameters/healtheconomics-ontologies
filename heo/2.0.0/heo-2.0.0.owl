    <!-- https://healtheconomics.wiki/concept/effect-size-estimation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/effect-size-estimation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:notation>HE-ES-SA-056</skos:notation>
        <dcterms:identifier>HE-ES-SA-056</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Cohen 1988</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Effect Size Estimation</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">The statistical process of calculating a quantitative measure of a treatment effect&apos;s magnitude, often standardised to allow comparison across differing measurement scales.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Effect Quantification</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Estimating Effect Magnitude</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Effect Size Estimation</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/effect-size"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/effect-size-estimation"/>
