    <!-- https://healtheconomics.wiki/concept/model-averaging -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/model-averaging">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:notation>HE-EM-UA-036</skos:notation>
        <dcterms:identifier>HE-EM-UA-036</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Hoeting et al. 1999</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Model Averaging</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A statistical technique combining predictions from several plausible candidate models, weighted by their relative statistical support, rather than relying on one selected model.</skos:definition>
        <skos:hiddenLabel xml:lang="en">BMA</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Ensemble Averaging</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Model Averaging</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/structural-uncertainty"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/model-selection"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-10"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/model-averaging"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <dcterms:identifier>HEO-L-bca31294a85c</dcterms:identifier>
        <linkRationale xml:lang="en">A statistical technique for combining model predictions</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/model-averaging"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#addresses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/structural-uncertainty"/>
        <dcterms:identifier>HEO-L-a7fa689d8e28</dcterms:identifier>
