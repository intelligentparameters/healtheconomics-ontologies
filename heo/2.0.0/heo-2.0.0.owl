    <!-- https://healtheconomics.wiki/concept/social-value-criterion -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/social-value-criterion">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/decision-criteria"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/decision-criteria"/>
        <skos:notation>HS-HP-HTA-199</skos:notation>
        <dcterms:identifier>HS-HP-HTA-199</dcterms:identifier>
        <dcterms:source>Daniels &amp; Sabin 1997</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Social Value Criterion</rdfs:label>
        <skos:definition xml:lang="en">A standard reflecting society&apos;s broader values and priorities, such as fairness, used to inform a decision beyond pure cost-effectiveness.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Social Priority Criterion</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Societal Value Criterion</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Social Value Criterion</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/priority-setting"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/social-value-criterion"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/decision-criteria"/>
        <dcterms:identifier>HEO-L-90d1eb8eca8d</dcterms:identifier>
        <linkRationale xml:lang="en">A standard used in funding decisions beyond cost-effectiveness is one of the Decision Criteria.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
