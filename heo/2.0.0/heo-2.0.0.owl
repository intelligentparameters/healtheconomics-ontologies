    <!-- https://healtheconomics.wiki/concept/crossover-design -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/crossover-design">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/study-design"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
