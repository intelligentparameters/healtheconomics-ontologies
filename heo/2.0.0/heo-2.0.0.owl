    <!-- https://healtheconomics.wiki/concept/interoperability-savings -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/interoperability-savings">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-savings"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cost-savings"/>
        <skos:notation>HS-HP-DH-027</skos:notation>
        <dcterms:identifier>HS-HP-DH-027</dcterms:identifier>
        <dcterms:source>Office of the National Coordinator for Health IT</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Interoperability Savings</rdfs:label>
        <skos:definition xml:lang="en">The cost savings and efficiency gains achieved when healthcare information systems can seamlessly exchange data, avoiding duplication and administrative burden.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Data-Exchange Savings</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Interoperability Benefits</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Interoperability Savings</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/interoperability-savings"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-savings"/>
        <dcterms:identifier>HEO-L-f2ad4f4de63d</dcterms:identifier>
        <linkRationale xml:lang="en">Only link; savings from data exchange are a kind of cost saving, not a part of digital health</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


