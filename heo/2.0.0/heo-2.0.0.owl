        <dcterms:source>Sonnenberg FA, Beck JR. Markov models in medical decision making: a practical guide. Medical Decision Making. 1993;13(4):322?338. doi:10.1177/0272989X9301300409.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Time Dependency</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Time-Dependence</skos:altLabel>
        <skos:definition xml:lang="en">The property of a risk, effect, cost, utility or other model input changing according to a specified time scale, such as attained age or time since an event.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Temporal Dependence</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Time Dependency</skos:prefLabel>
