        <informs rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/comparative-evidence"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/relative-effectiveness"/>
