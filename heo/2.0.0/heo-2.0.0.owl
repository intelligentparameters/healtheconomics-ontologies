    <!-- https://healtheconomics.wiki/concept/partial-correlation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/partial-correlation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/correlation-coefficient"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q2998010"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/correlation-coefficient"/>
        <skos:notation>HE-ES-SA-153</skos:notation>
        <dcterms:identifier>HE-ES-SA-153</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Yule 1907</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Partial Correlation</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A measure of the relationship between two variables after statistically controlling for the influence of one or more additional variables.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Adjusted Correlation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Controlled Correlation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Partial Correlation</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/confounding"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/partial-correlation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/correlation-coefficient"/>
        <dcterms:identifier>HEO-L-d9a4647a5827</dcterms:identifier>
        <linkRationale xml:lang="en">A partial correlation is a correlation coefficient after controlling for other variables</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/partial-correlation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#addresses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/confounding"/>
        <dcterms:identifier>HEO-L-dd65d3eb3c18</dcterms:identifier>
        <linkRationale xml:lang="en">Partial (rank) correlation coefficients are a standard global sensitivity measure; controlling for third variables removes their confounding.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/partial-economic-evaluation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/partial-economic-evaluation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-evaluation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/economic-evaluation"/>
        <skos:notation>HE-EE-EM-007</skos:notation>
        <dcterms:identifier>HE-EE-EM-007</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Partial Economic Evaluation</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A study examining either the costs or the outcomes of an intervention, or both without comparison to an alternative, short of a full economic evaluation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Incomplete Economic Evaluation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Partial Evaluation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Partial Economic Evaluation</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/partial-economic-evaluation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-evaluation"/>
        <dcterms:identifier>HEO-L-5bf892a37e81</dcterms:identifier>
        <linkRationale xml:lang="en">Drummond et al. 2015 classify partial evaluations within economic evaluation</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


