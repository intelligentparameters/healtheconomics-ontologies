    <!-- https://healtheconomics.wiki/concept/study-design -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/study-design">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-ES-CTM-091</skos:notation>
        <dcterms:identifier>HE-ES-CTM-091</dcterms:identifier>
        <dcterms:source>Friedman LM, Furberg CD, DeMets DL, Reboussin DM, Granger CB. Fundamentals of Clinical Trials. 5th ed. Springer; 2015. doi:10.1007/978-3-319-18539-2.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Study Design</rdfs:label>
        <skos:altLabel xml:lang="en">Research Design</skos:altLabel>
        <skos:definition xml:lang="en">The overall plan and structure of a research investigation, covering decisions such as randomisation, participant selection, and outcome measurement.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Investigation Design</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Study Design</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/quality-of-evidence"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
