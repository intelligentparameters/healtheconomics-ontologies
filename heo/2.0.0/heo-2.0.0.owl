    <!-- https://healtheconomics.wiki/concept/random-parameter-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/random-parameter-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/random-effects-model"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/random-effects-model"/>
        <skos:notation>HE-EE-CBA-042</skos:notation>
        <dcterms:identifier>HE-EE-CBA-042</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Train 2009</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Random Parameter Model</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Random Coefficient Model</skos:altLabel>
        <skos:definition xml:lang="en">A discrete choice model that lets preference parameters vary randomly across individuals according to a specified distribution, rather than assuming identical preferences.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Heterogeneous-Parameter Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Random Parameter Model</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/outcomes#step-4"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/random-parameter-model"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/random-effects-model"/>
        <dcterms:identifier>HEO-L-60ca1d3ca65d</dcterms:identifier>
        <linkRationale xml:lang="en">Random parameter (mixed logit) models are random effects models.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
