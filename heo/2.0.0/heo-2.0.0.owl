    <!-- https://healtheconomics.wiki/concept/cognitive-bias-concept -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cognitive-bias-concept">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/bias"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/bias"/>
        <skos:notation>HE-EE-BE-008</skos:notation>
        <dcterms:identifier>HE-EE-BE-008</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-09</dcterms:modified>
        <dcterms:source>Tversky &amp; Kahneman 1974</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cognitive Bias Concept</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">The cognitive bias concept is systematic error in judgement, often from mental shortcuts, that skews how patients, clinicians and experts weigh evidence.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cognitive Bias</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Judgement Bias</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cognitive Bias Concept</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/random-error"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/interpretation-error"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cognitive-bias-concept"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/bias"/>
        <dcterms:identifier>HEO-L-80ea0d420b09</dcterms:identifier>
        <linkRationale xml:lang="en">Cognitive bias is systematic error in judgement, a kind of bias</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cognitive-bias-concept"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
