    <!-- https://healtheconomics.wiki/concept/technical-verification -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/technical-verification">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
