    <!-- https://healtheconomics.wiki/concept/data-mining -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/data-mining">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/data-analytics"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/data-analytics"/>
        <skos:notation>HE-ES-SA-043</skos:notation>
        <dcterms:identifier>HE-ES-SA-043</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</dcterms:modified>
        <dcterms:source>Fayyad et al. 1996</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Data Mining</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:definition xml:lang="en">Data mining is the computational search of large health datasets, such as claims or patient records, for patterns that were not specified in advance.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Knowledge Discovery</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Pattern Mining</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Data Mining</skos:prefLabel>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/big-data"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/classification-methods"/>
