    <!-- https://healtheconomics.wiki/concept/discrete-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/discrete-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-economic-model"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-economic-model"/>
        <skos:notation>HE-EM-DM-022</skos:notation>
        <dcterms:identifier>HE-EM-DM-022</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Briggs A, Claxton K, Sculpher M. Decision Modelling for Health Economic Evaluation. Oxford University Press; 2006. doi:10.1093/oso/9780198526629.001.0001.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Discrete Model</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A discrete model represents at least one aspect of a system through distinct states, events, or time steps, allowing changes to be analysed as transitions among those elements rather than solely as continuously varying quantities.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Discrete-Time Model</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Fixed-Step Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Discrete Model</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/discrete-model"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-economic-model"/>
        <dcterms:identifier>HEO-L-ac275e5b1949</dcterms:identifier>
        <linkRationale xml:lang="en">a discrete model is a kind of model; Model Structure is the organisation of a model, not a model</linkRationale>
