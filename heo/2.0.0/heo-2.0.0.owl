    <!-- https://healtheconomics.wiki/concept/artificial-intelligence-in-health -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/artificial-intelligence-in-health">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/digital-health"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-technology"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/digital-health"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-technology"/>
        <skos:notation>HS-SS_DH-001</skos:notation>
        <dcterms:identifier>HS-SS_DH-001</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>European Parliament and Council 2024; NICE PMG48 2025</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
