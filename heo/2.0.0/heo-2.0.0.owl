    <!-- https://healtheconomics.wiki/concept/kurtosis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/kurtosis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/descriptive-statistics"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q287251"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/descriptive-statistics"/>
        <skos:notation>HE-ES-SA-094</skos:notation>
        <dcterms:identifier>HE-ES-SA-094</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Pearson 1895</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Kurtosis</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Tailedness</skos:altLabel>
        <skos:definition xml:lang="en">A measure describing a distribution&apos;s tail shape relative to a normal distribution, higher values indicating heavier tails and more extreme outliers.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Peakedness</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Kurtosis</skos:prefLabel>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/probability-distribution"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
