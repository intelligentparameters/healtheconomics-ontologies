        <skos:altLabel xml:lang="en">Distribution-Based MCID</skos:altLabel>
        <skos:definition xml:lang="en">A distribution-based MID is a minimal important difference estimated from score spread or instrument reliability, such as half a standard deviation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Statistical MID Method</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Distribution-Based MID</skos:prefLabel>
