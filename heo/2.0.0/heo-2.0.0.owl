    <!-- https://healtheconomics.wiki/concept/lean-healthcare -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/lean-healthcare">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/lean-methodology"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/lean-methodology"/>
        <skos:notation>HS-NHS-HQ-038</skos:notation>
        <dcterms:identifier>HS-NHS-HQ-038</dcterms:identifier>
        <dcterms:source>Rother &amp; Shook 1999</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Lean Healthcare</rdfs:label>
        <skos:definition xml:lang="en">The application of lean management principles, from manufacturing, to healthcare process improvement, systematically identifying and eliminating waste in care delivery.</skos:definition>
        <skos:prefLabel xml:lang="en">Lean Healthcare</skos:prefLabel>
