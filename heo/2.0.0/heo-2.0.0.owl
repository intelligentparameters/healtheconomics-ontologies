    <!-- https://healtheconomics.wiki/concept/cause-and-effect-diagram -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cause-and-effect-diagram">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-HP-SS-007</skos:notation>
        <dcterms:identifier>HS-HP-SS-007</dcterms:identifier>
        <dcterms:source>Ishikawa 1968</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cause and Effect Diagram</rdfs:label>
        <skos:altLabel xml:lang="en">Fishbone Diagram</skos:altLabel>
        <skos:altLabel xml:lang="en">Ishikawa Diagram</skos:altLabel>
        <skos:definition xml:lang="en">A visual quality improvement tool, also called a fishbone diagram, systematically identifying potential root causes of a specific problem.</skos:definition>
        <skos:prefLabel xml:lang="en">Cause and Effect Diagram</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/root-cause-analysis"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cause-and-effect-diagram"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-4309b64760a3</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Systems Strengthening: organisation and delivery of care is the Health Systems subdomain (Organisation and governance)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cause-and-effect-diagram"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/root-cause-analysis"/>
        <dcterms:identifier>HEO-L-e4e8a4d6a697</dcterms:identifier>
