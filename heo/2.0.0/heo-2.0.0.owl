        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Causal inference estimates what would happen to health outcomes or costs if a treatment or policy changed, using data, study design and stated assumptions.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Causal Analysis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Causal Inference</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/correlation"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-5"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/attributable-risk"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/transportability"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/average-treatment-effect"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/treatment-effect"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/difference-in-differences"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/instrumental-variable-analysis"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/mediation-analysis"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/propensity-score"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/randomised-controlled-trial"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/real-world-data"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/regression-discontinuity"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/target-trial-emulation"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/causal-inference"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/comparative-effectiveness-research"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-ef76fa12dc6e</dcterms:identifier>
