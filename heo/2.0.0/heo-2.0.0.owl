    <!-- https://healtheconomics.wiki/concept/background-mortality -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/background-mortality">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/all-cause-mortality"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/all-cause-mortality"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/cure-fraction"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/relative-survival"/>
        <skos:notation>HE-EM-MP-003</skos:notation>
        <dcterms:identifier>HE-EM-MP-003</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Rutherford et al. 2020</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Background Mortality</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Background Hazard</skos:altLabel>
        <skos:definition xml:lang="en">Background mortality is the death rate a model&apos;s patients would face without the disease, usually taken from general population life tables by age and sex.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Baseline Population Hazard</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">General-Population Hazard</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Background Mortality</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/excess-mortality"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/life-table"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/background-mortality"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/all-cause-mortality"/>
        <dcterms:identifier>HEO-L-df444714821d</dcterms:identifier>
        <linkRationale xml:lang="en">Background mortality is general-population all-cause mortality, a kind of it rather than a component</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/background-mortality"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cure-fraction"/>
