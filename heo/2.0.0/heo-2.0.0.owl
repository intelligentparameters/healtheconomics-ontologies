        <skos:altLabel xml:lang="en">HDHP</skos:altLabel>
        <skos:definition xml:lang="en">A plan with a deductible above a regulatory minimum threshold, giving lower premiums but requiring a larger upfront share of routine costs.</skos:definition>
        <skos:hiddenLabel xml:lang="en">High-Deductible Plan</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">High Deductible Health Plan</skos:prefLabel>
