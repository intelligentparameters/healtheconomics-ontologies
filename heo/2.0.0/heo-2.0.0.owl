    <!-- https://healtheconomics.wiki/concept/specialty-tier -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/specialty-tier">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/formulary"/>
        <skos:notation>HS-HP-HI-182</skos:notation>
        <dcterms:identifier>HS-HP-HI-182</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Specialty Tier</rdfs:label>
        <skos:altLabel xml:lang="en">Specialty Formulary Tier</skos:altLabel>
        <skos:definition xml:lang="en">A formulary category for high-cost specialty medications, typically biologics, usually carrying the highest patient cost-sharing of any tier.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Biologics Tier</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Specialty Tier</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/generic-tier"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/specialty-tier"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-6e58211b56cf</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health Insurance: wiki topic Health financing and insurance sits in Health Systems; placed under Health Insurance, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/specialty-tier"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/formulary"/>
        <dcterms:identifier>HEO-L-96529c02c578</dcterms:identifier>
        <linkRationale xml:lang="en">The object definition says formularies are organised into tiers</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/specialty-tier"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/generic-tier"/>
        <dcterms:identifier>HEO-L-d1b3f97dfef5</dcterms:identifier>
