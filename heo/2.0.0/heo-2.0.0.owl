        <dcterms:identifier>HEO-L-53c7934bd258</dcterms:identifier>
        <linkRationale xml:lang="en">A trust fund is an account that pools money, a component of health system financing rather than a kind of it.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
