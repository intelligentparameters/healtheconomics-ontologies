        <dcterms:identifier>HEO-L-0876193c6a8d</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Budget Impact Analysis: wiki topic Budget impact analysis sits in Economic Evaluation; placed under Budget Impact Analysis, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/fixed-budget"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/flexible-budget"/>
        <dcterms:identifier>HEO-L-2f0573680fd6</dcterms:identifier>
        <linkRationale xml:lang="en">Fixed and flexible budgets are opposing budget types; kept on this side of the pair</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
