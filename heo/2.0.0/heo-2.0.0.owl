    <!-- https://healtheconomics.wiki/concept/budget-variance -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/budget-variance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/budget-impact-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/budget-impact-analysis"/>
        <skos:notation>HE-EE-BIA-023</skos:notation>
        <dcterms:identifier>HE-EE-BIA-023</dcterms:identifier>
        <dcterms:source>Horngren, Datar &amp; Rajan 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Budget Variance</rdfs:label>
        <skos:definition xml:lang="en">The difference between budgeted and actual spending or revenue over a given period.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Budget Deviation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Spending Variance</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Budget Variance</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/budget-amendment"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
