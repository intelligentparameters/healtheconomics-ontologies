    <!-- https://healtheconomics.wiki/concept/demand-inducement -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/demand-inducement">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HE-EE-ME-017</skos:notation>
        <dcterms:identifier>HE-EE-ME-017</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</dcterms:modified>
        <dcterms:source>Johnson 2014</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Demand Inducement</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:altLabel xml:lang="en">Induced Demand</skos:altLabel>
        <skos:altLabel xml:lang="en">Physician-Induced Demand</skos:altLabel>
        <skos:definition xml:lang="en">Demand inducement is a provider&apos;s use of an information advantage to shift a patient&apos;s demand for care away from the patient&apos;s best interests.</skos:definition>
        <skos:prefLabel xml:lang="en">Demand Inducement</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/moral-hazard"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/supplier-induced-demand"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/demand-inducement"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-6d4d862c41e6</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Market Economics: demand, supply, agency and moral hazard describe how health care markets are organised and paid for</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/demand-inducement"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/moral-hazard"/>
        <dcterms:identifier>HEO-L-b5bef4bb4556</dcterms:identifier>
        <linkRationale xml:lang="en">Provider-driven versus insurance-driven increases in use</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
