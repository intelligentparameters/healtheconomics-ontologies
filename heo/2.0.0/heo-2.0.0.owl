    <!-- https://healtheconomics.wiki/concept/royston-parmar-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/royston-parmar-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/flexible-parametric-model"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/spline-model"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/flexible-parametric-model"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/spline-model"/>
        <skos:notation>HE-EM-SM-075</skos:notation>
        <dcterms:identifier>HE-EM-SM-075</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
