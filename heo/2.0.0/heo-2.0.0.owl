    <!-- https://healtheconomics.wiki/concept/wrong-site-surgery -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/wrong-site-surgery">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/never-event"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
