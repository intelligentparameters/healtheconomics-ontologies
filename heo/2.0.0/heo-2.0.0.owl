    <!-- https://healtheconomics.wiki/concept/stochastic-programming -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/stochastic-programming">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/optimisation"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q7617831"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/optimisation"/>
        <skos:notation>HE-EM-DM-097</skos:notation>
        <dcterms:identifier>HE-EM-DM-097</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Birge &amp; Louveaux 1997</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Stochastic Programming</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">An optimisation framework incorporating parameter uncertainty directly into the process, seeking a solution that performs well across possible parameter values.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Optimisation under Uncertainty</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Recourse Programming</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Stochastic Programming</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/parameter-uncertainty"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/robust-optimisation"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-12"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/stochastic-programming"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/optimisation"/>
        <dcterms:identifier>HEO-L-ab5a2046d2d6</dcterms:identifier>
        <linkRationale xml:lang="en">Stochastic programming is optimisation under uncertainty.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/stochastic-programming"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#addresses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/parameter-uncertainty"/>
        <dcterms:identifier>HEO-L-3af9adde7241</dcterms:identifier>
        <linkRationale xml:lang="en">Parameter uncertainty is the problem stochastic programming deals with, not a tool it employs.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
