    <!-- https://healtheconomics.wiki/concept/uniqueness -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/uniqueness">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/variance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/variance"/>
        <skos:notation>HE-ES-SA-229</skos:notation>
        <dcterms:identifier>HE-ES-SA-229</dcterms:identifier>
        <dcterms:source>Spearman 1904</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Uniqueness</rdfs:label>
        <skos:altLabel xml:lang="en">Unique Variance</skos:altLabel>
        <skos:definition xml:lang="en">In factor analysis, the proportion of an observed variable&apos;s total variance not explained by the underlying common factors, including error.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Specific Variance</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Uniqueness</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/uniqueness"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/variance"/>
        <dcterms:identifier>HEO-L-ab5377ace17d</dcterms:identifier>
        <linkRationale xml:lang="en">Uniqueness is the unique variance of an observed variable not explained by common factors (subject definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/unit-cost -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/unit-cost">
