    <!-- https://healtheconomics.wiki/concept/integrated-care -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/integrated-care">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
