    <!-- https://healtheconomics.wiki/concept/efficacy-effectiveness-gap -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/efficacy-effectiveness-gap">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/comparative-effectiveness-research"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/comparative-effectiveness-research"/>
        <skos:notation>HE-ES-CER-013</skos:notation>
        <dcterms:identifier>HE-ES-CER-013</dcterms:identifier>
        <dcterms:source>Singal, Higgins &amp; Waljee 2014</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Efficacy-Effectiveness Gap</rdfs:label>
        <skos:definition xml:lang="en">The observed difference between a treatment&apos;s trial-demonstrated benefit and its actual benefit once used in routine clinical practice.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Efficacy-Effectiveness Difference</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Trial-to-Practice Gap</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Efficacy-Effectiveness Gap</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/applicability-assessment"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/efficacy-effectiveness-gap"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/comparative-effectiveness-research"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-ccdcd962257d</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Comparative Effectiveness Research: catalogue subdomain Evidence Synthesis is one of the subdomains; placed under Comparative Effectiveness Research, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/efficacy-effectiveness-gap"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/applicability-assessment"/>
        <dcterms:identifier>HEO-L-3f2fe4a2e58f</dcterms:identifier>
        <linkRationale xml:lang="en">The gap shows how far trial benefit carries into routine care; applicability assessment judges fit to the decision care setting</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


