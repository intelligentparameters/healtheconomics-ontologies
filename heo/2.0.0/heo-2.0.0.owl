    <!-- https://healtheconomics.wiki/concept/available-case-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/available-case-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/missing-data-methods"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/missing-data-methods"/>
        <skos:notation>HE-ES-SA-009</skos:notation>
        <dcterms:identifier>HE-ES-SA-009</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Faria et al. 2014</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Available Case Analysis</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">ACA</skos:altLabel>
        <skos:definition xml:lang="en">Available case analysis is a missing data method estimating each quantity from everyone with data for it, so costs and QALYs may use different patients.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Complete-Pairs Analysis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Available Case Analysis</skos:prefLabel>
        <abbreviation xml:lang="en">ACA</abbreviation>
        <assumes rdf:resource="https://healtheconomics.wiki/concept/missing-completely-at-random"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/listwise-deletion"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/multiple-imputation"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/available-case-analysis"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/missing-data-methods"/>
        <dcterms:identifier>HEO-L-117931c494a5</dcterms:identifier>
        <linkRationale xml:lang="en">A missing data method</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
