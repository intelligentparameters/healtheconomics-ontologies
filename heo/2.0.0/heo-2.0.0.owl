    <!-- https://healtheconomics.wiki/concept/option-value -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/option-value">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/welfare-economics"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/welfare-economics"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/willingness-to-pay"/>
        <skos:notation>HE-EE-WE-050</skos:notation>
        <dcterms:identifier>HE-EE-WE-050</dcterms:identifier>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Option Value</rdfs:label>
        <skos:definition xml:lang="en">In health economics, the value people place on preserving the option to use a service or technology in future, even when they do not use it now.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Preservation Value</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Value of Optionality</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Option Value</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/cost-benefit-analysis"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/option-value"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/welfare-economics"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-6a3cf1653ac2</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Welfare Economics: welfarism and extra-welfarism are the normative basis of cost-benefit and cost-effectiveness analysis; placed under Welfare Economics, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/option-value"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/willingness-to-pay"/>
        <dcterms:identifier>HEO-L-d6d96507f18e</dcterms:identifier>
        <linkRationale xml:lang="en">Option value is a component of a non-user&apos;s willingness to pay to keep a service available (Weisbrod 1964)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/option-value"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-benefit-analysis"/>
        <dcterms:identifier>HEO-L-125635d80167</dcterms:identifier>
        <linkRationale xml:lang="en">Weisbrod option value is elicited by stated-preference WTP surveys and counted in CBA.</linkRationale>
