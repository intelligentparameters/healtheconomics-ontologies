        <skos:prefLabel xml:lang="en">Minimum Value</skos:prefLabel>
        <abbreviation xml:lang="en">MV Standard</abbreviation>
        <benchmarkFor rdf:resource="https://healtheconomics.wiki/concept/actuarial-value"/>
