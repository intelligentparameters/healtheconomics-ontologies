        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/proportional-shortfall"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/severity-modifier"/>
    </owl:NamedIndividual>
