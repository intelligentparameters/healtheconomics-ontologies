    <!-- https://healtheconomics.wiki/concept/stochastic-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/stochastic-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-economic-model"/>
