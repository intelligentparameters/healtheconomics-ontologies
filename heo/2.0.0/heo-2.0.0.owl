        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/matching-method"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/stated-preference"/>
        <skos:notation>HE-EE-HU-091</skos:notation>
        <dcterms:identifier>HE-EE-HU-091</dcterms:identifier>
        <dcterms:source>Nord 1995</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Person Trade-Off</rdfs:label>
        <skos:definition xml:lang="en">Person trade-off (PTO) is a valuation method asking how many people helped one way equal a set number helped another, giving social values for health care.</skos:definition>
        <skos:hiddenLabel xml:lang="en">PTO</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Person Trade-Off</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/standard-gamble"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/time-trade-off"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/priority-setting"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/disability-weight"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
