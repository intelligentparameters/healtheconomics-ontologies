    <!-- https://healtheconomics.wiki/concept/jump-to-reference -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/jump-to-reference">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
