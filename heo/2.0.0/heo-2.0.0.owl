    <!-- https://healtheconomics.wiki/concept/statistical-method -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/statistical-method">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
