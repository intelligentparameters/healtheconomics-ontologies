    <!-- https://healtheconomics.wiki/concept/bargaining-theory -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/bargaining-theory">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/game-theory-health"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q6987443"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/game-theory-health"/>
        <skos:notation>HE-EE-ME-005</skos:notation>
        <dcterms:identifier>HE-EE-ME-005</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
