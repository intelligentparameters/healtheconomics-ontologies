    <!-- https://healtheconomics.wiki/concept/stratified-log-rank -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/stratified-log-rank">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/log-rank-test"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/log-rank-test"/>
        <skos:notation>HE-EM-SM-082</skos:notation>
        <dcterms:identifier>HE-EM-SM-082</dcterms:identifier>
        <dcterms:source>Mantel 1966</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Stratified Log-Rank</rdfs:label>
        <skos:definition xml:lang="en">A variant of the log-rank test accounting for stratifying variables, comparing survival within each stratum before combining into an overall statistic.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Adjusted Log-Rank</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Stratum-Adjusted Test</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Stratified Log-Rank</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/confounding"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-5"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/stratified-log-rank"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/log-rank-test"/>
        <dcterms:identifier>HEO-L-8e8ffc2b4afd</dcterms:identifier>
        <linkRationale xml:lang="en">A stratified log-rank test is a variant of the log-rank test.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/stratified-log-rank"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#addresses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/confounding"/>
        <dcterms:identifier>HEO-L-4b705ebe17e2</dcterms:identifier>
        <linkRationale xml:lang="en">Stratifying adjusts the comparison for a factor that would otherwise distort it.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/stratified-medicine -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/stratified-medicine">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/precision-medicine"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/precision-medicine"/>
        <skos:notation>HE-PE-TI-031</skos:notation>
        <dcterms:identifier>HE-PE-TI-031</dcterms:identifier>
        <dcterms:source>Hamburg &amp; Collins 2010</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Stratified Medicine</rdfs:label>
        <skos:definition xml:lang="en">An approach grouping patients into subpopulations by shared characteristics likely to influence treatment response, allowing more targeted treatment decisions.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Stratified Therapy</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Subgroup-Targeted Medicine</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Stratified Medicine</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/biomarker"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/companion-diagnostic"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/stratified-medicine"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/precision-medicine"/>
        <dcterms:identifier>HEO-L-4a2dd9e6ba97</dcterms:identifier>
        <linkRationale xml:lang="en">Grouping patients by characteristics to target treatment is a form of precision medicine.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
