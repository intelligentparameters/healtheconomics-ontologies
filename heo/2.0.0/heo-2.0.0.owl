    <!-- https://healtheconomics.wiki/concept/data-completeness -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/data-completeness">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-source"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q84761134"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-source"/>
