        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/crowding-out -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/crowding-out">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1071788"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:notation>HE-EE-EP-009</skos:notation>
        <dcterms:identifier>HE-EE-EP-009</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</dcterms:modified>
        <dcterms:source>Cutler &amp; Gruber 1996</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Crowding Out</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:altLabel xml:lang="en">Crowd Out</skos:altLabel>
        <skos:definition xml:lang="en">Crowding out occurs when public spending or intervention displaces private activity that would have happened anyway, reducing the programme&apos;s net effect.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Public-Private Displacement</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Crowding Out</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/private-health-insurance"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/crowding-out"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-a6234221511d</dcterms:identifier>
