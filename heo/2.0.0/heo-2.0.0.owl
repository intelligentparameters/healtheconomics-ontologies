    <!-- https://healtheconomics.wiki/concept/willingness-to-pay-threshold -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/willingness-to-pay-threshold">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-threshold"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-threshold"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/decision-rule"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/incremental-net-monetary-benefit"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/net-monetary-benefit"/>
        <skos:notation>HE-EE-CEA-069</skos:notation>
        <dcterms:identifier>HE-EE-CEA-069</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Claxton et al. 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Willingness-to-Pay Threshold</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">WTP Threshold</skos:altLabel>
        <skos:definition xml:lang="en">A willingness-to-pay threshold is the cost per QALY below which a treatment counts as good value; strictly, the most society would pay for one extra QALY.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cost-Effectiveness Willingness-to-Pay</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Willingness-to-Pay Threshold</skos:prefLabel>
        <abbreviation xml:lang="en">WTP Threshold</abbreviation>
        <benchmarkFor rdf:resource="https://healtheconomics.wiki/concept/icer"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
