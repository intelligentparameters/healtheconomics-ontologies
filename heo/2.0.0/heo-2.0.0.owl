    <!-- https://healtheconomics.wiki/concept/health-price-index -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/health-price-index">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/price-growth"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/real-cost"/>
        <skos:notation>HE-EE-CA-047</skos:notation>
        <dcterms:identifier>HE-EE-CA-047</dcterms:identifier>
        <dcterms:source>Bureau of Labor Statistics</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Health Price Index</rdfs:label>
        <skos:altLabel xml:lang="en">Healthcare Price Index</skos:altLabel>
        <skos:altLabel xml:lang="en">Medical Price Index</skos:altLabel>
        <skos:definition xml:lang="en">A measure tracking changes over time in the prices of healthcare goods and services specifically, unlike the general consumer price index.</skos:definition>
        <skos:prefLabel xml:lang="en">Health Price Index</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/health-price-index"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/costs"/>
