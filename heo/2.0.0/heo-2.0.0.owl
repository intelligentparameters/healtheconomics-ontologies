    <!-- https://healtheconomics.wiki/concept/disutility -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/disutility">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/utility"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/utility"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/health-state-utility-value"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/qaly"/>
        <skos:notation>HE-EE-HU-021</skos:notation>
        <dcterms:identifier>HE-EE-HU-021</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-02</dcterms:modified>
        <dcterms:source>Ara &amp; Wailoo 2011</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Disutility</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Utility Loss</skos:altLabel>
        <skos:definition xml:lang="en">Disutility is the loss of utility caused by a health state, adverse event or treatment, measured from a stated baseline and used to reduce QALYs.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Negative Utility</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Disutility</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/outcomes#step-2"/>
        <counterpartOf rdf:resource="https://healtheconomics.wiki/concept/disability-weight"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/disutility"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/utility"/>
        <dcterms:identifier>HEO-L-cdb440f7861d</dcterms:identifier>
        <linkRationale xml:lang="en">a disutility is a utility value expressed as a decrement on the same preference scale</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/disutility"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-state-utility-value"/>
        <dcterms:identifier>HEO-L-bc146a6d48a2</dcterms:identifier>
        <linkRationale xml:lang="en">A state utility is a baseline utility minus the disutility</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/disutility"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/qaly"/>
        <dcterms:identifier>HEO-L-910e7d4c5686</dcterms:identifier>
        <linkRationale xml:lang="en">Disutilities are subtracted from utilities before weighting time to give QALYs</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/disutility"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#counterpartOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/disability-weight"/>
        <dcterms:identifier>HEO-L-9f1a83160b21</dcterms:identifier>
        <linkRationale xml:lang="en">disutility (QALY framework) and disability weight (DALY framework) both rate health loss; counterparts, not opposites</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


