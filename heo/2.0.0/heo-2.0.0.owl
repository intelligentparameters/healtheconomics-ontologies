        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Health Disparity</rdfs:label>
        <skos:altLabel xml:lang="en">Health Disparities</skos:altLabel>
        <skos:definition xml:lang="en">A difference in health outcomes or access between population groups, particularly one closely linked to social or economic disadvantage.</skos:definition>
