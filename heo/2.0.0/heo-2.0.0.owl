        <skos:altLabel xml:lang="en">Cohort Markov Model</skos:altLabel>
        <skos:definition xml:lang="en">A Markov model tracking a hypothetical cohort collectively as proportions across health states over cycles, rather than simulating each patient separately.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Aggregate Markov Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Markov Cohort Model</skos:prefLabel>
