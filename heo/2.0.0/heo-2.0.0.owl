    <!-- https://healtheconomics.wiki/concept/switching -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/switching">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/medication-safety"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/medication-safety"/>
        <skos:notation>PP-PC-MS-014</skos:notation>
        <dcterms:identifier>PP-PC-MS-014</dcterms:identifier>
        <dcterms:source>Danzon 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Switching</rdfs:label>
        <skos:definition xml:lang="en">A general term for a change from one medication to another, whether for clinical reasons or non-clinical reasons such as a formulary change.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Product Change</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Therapy Change</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Switching</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/medication-persistence"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/switching"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/medication-safety"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-efe1d9c7bca4</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Pharmacy Practice &gt; Pharmaceutical Care &gt; Medication Safety: pharmacy services are part of health care delivery; placed under Medication Safety, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/switching"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/medication-persistence"/>
        <dcterms:identifier>HEO-L-31ae1e9283e6</dcterms:identifier>
        <linkRationale xml:lang="en">Switching is a change of medicine, not a payer control technique; persistence on a medicine ends at discontinuation or switch.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/swot-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/swot-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-HP-SS-030</skos:notation>
