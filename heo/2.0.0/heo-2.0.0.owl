        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/law-of-large-numbers"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isFoundationFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/monte-carlo-simulation"/>
