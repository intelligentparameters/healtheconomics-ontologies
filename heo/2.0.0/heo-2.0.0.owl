        <uses rdf:resource="https://healtheconomics.wiki/concept/value-of-statistical-life"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/willingness-to-pay"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/benefit-transfer"/>
