    <!-- https://healtheconomics.wiki/concept/deterministic-sensitivity-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/deterministic-sensitivity-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/deterministic-analysis"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/sensitivity-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/deterministic-analysis"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/sensitivity-analysis"/>
        <skos:notation>HE-EM-UA-017</skos:notation>
        <dcterms:identifier>HE-EM-UA-017</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</dcterms:modified>
        <dcterms:source>Briggs et al. 2012</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Deterministic Sensitivity Analysis</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:altLabel xml:lang="en">DSA</skos:altLabel>
        <skos:definition xml:lang="en">Deterministic sensitivity analysis (DSA) reruns a health economic model with chosen inputs set to fixed values to see how results and decisions change.</skos:definition>
        <skos:prefLabel xml:lang="en">Deterministic Sensitivity Analysis</skos:prefLabel>
        <abbreviation xml:lang="en">DSA</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/psa"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-10"/>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/icer"/>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/parameter-uncertainty"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/base-case"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/deterministic-sensitivity-analysis"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/deterministic-analysis"/>
        <dcterms:identifier>HEO-L-370e4b42f6c6</dcterms:identifier>
        <linkRationale xml:lang="en">DSA fixes chosen inputs at single values, which is the defining feature of a deterministic analysis</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/deterministic-sensitivity-analysis"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/sensitivity-analysis"/>
        <dcterms:identifier>HEO-L-9e6a4ec5ff2f</dcterms:identifier>
        <linkRationale xml:lang="en">DSA varies inputs one or more at a time, a kind of sensitivity analysis by both definitions</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
