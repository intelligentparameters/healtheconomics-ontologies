        <evaluates rdf:resource="https://healtheconomics.wiki/concept/added-value"/>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/clinical-utility"/>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/health-technology"/>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/safety"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/coverage-decision"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/decision"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/evidence-based-decision-making"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/asmr-rating"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/draft-recommendation"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/guidance-document"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/hta-report"/>
