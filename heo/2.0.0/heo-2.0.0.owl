    <!-- https://healtheconomics.wiki/concept/futility-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/futility-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/interim-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/interim-analysis"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/group-sequential-design"/>
        <skos:notation>HE-ES-CTM-036</skos:notation>
        <dcterms:identifier>HE-ES-CTM-036</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-24</dcterms:modified>
        <dcterms:source>Friedman LM, Furberg CD, DeMets DL, Reboussin DM, Granger CB. Fundamentals of Clinical Trials. 5th ed. Springer; 2015. doi:10.1007/978-3-319-18539-2.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Futility Analysis</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A futility analysis assesses interim trial evidence against a prespecified rule to judge whether continuing is sufficiently likely to meet the study&apos;s final objective.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Futility Stopping Analysis</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Interim Futility Check</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Futility Analysis</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/futility-analysis"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/interim-analysis"/>
        <dcterms:identifier>HEO-L-d44b779256db</dcterms:identifier>
        <linkRationale xml:lang="en">A futility analysis is an interim analysis</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/futility-analysis"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/group-sequential-design"/>
        <dcterms:identifier>HEO-L-768ad77d5f57</dcterms:identifier>
