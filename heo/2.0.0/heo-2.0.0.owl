        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">ASMR</skos:altLabel>
        <skos:altLabel xml:lang="en">Amelioration du Service Medical Rendu</skos:altLabel>
        <skos:definition xml:lang="en">The ASMR rating is the French HAS grade, from major (I) to none (V), of how much a medicine improves on existing treatments, used to frame its price.</skos:definition>
        <skos:prefLabel xml:lang="en">ASMR Rating</skos:prefLabel>
        <abbreviation xml:lang="en">ASMR</abbreviation>
