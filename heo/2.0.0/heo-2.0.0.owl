    <!-- https://healtheconomics.wiki/concept/molecular-response -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/molecular-response">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-response"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/clinical-response"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/minimal-residual-disease"/>
        <skos:notation>HE-ES-CO-045</skos:notation>
        <dcterms:identifier>HE-ES-CO-045</dcterms:identifier>
        <dcterms:source>Baccarani et al. 2013</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Molecular Response</rdfs:label>
        <skos:altLabel xml:lang="en">MR</skos:altLabel>
        <skos:definition xml:lang="en">A response measure using highly sensitive laboratory techniques detecting very small quantities of disease-associated genetic material, more precise than hematologic or cytogenetic criteria.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Molecular-Level Response</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Molecular Response</skos:prefLabel>
        <abbreviation xml:lang="en">MR</abbreviation>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
