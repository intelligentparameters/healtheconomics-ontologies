    <!-- https://healtheconomics.wiki/concept/case-fatality-rate -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/case-fatality-rate">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/absolute-risk"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/absolute-risk"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/severity-of-disease"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/transition-probability"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/years-of-life-lost"/>
        <skos:notation>HS-HP-PHO-002</skos:notation>
        <dcterms:identifier>HS-HP-PHO-002</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>CDC Principles of Epidemiology (3rd ed., 2006) Lesson 3</dcterms:source>
