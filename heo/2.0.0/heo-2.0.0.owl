        <skos:altLabel xml:lang="en">Product Limit Estimator</skos:altLabel>
        <skos:definition xml:lang="en">The Kaplan–Meier estimator calculates a non-parametric estimate of the survival function when follow-up can be right-censored.</skos:definition>
        <skos:prefLabel xml:lang="en">Kaplan-Meier Estimator</skos:prefLabel>
        <abbreviation xml:lang="en">KM Estimator</abbreviation>
