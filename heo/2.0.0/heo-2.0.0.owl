    <!-- https://healtheconomics.wiki/concept/data-envelopment-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/data-envelopment-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q647974"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/scale-efficiency"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/technical-efficiency"/>
        <skos:notation>HS-NHS-PM-005</skos:notation>
        <dcterms:identifier>HS-NHS-PM-005</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</dcterms:modified>
        <dcterms:source>Hollingsworth 2016</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Data Envelopment Analysis</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:altLabel xml:lang="en">DEA</skos:altLabel>
        <skos:definition xml:lang="en">Data envelopment analysis (DEA) is a linear programming method that scores hospitals and other health care units on technical efficiency against peers.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Frontier Efficiency Method</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Data Envelopment Analysis</skos:prefLabel>
        <abbreviation xml:lang="en">DEA</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/stochastic-frontier-analysis"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-5"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/efficiency-index"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/linear-programming"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/data-envelopment-analysis"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-efbb6db780d4</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Performance productivity and quality in subdomain Health Systems</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/data-envelopment-analysis"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/scale-efficiency"/>
        <dcterms:identifier>HEO-L-3eeb0bfaa697</dcterms:identifier>
        <linkRationale xml:lang="en">DEA scores under constant and variable returns to scale give scale efficiency</linkRationale>
