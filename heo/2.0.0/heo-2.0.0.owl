    <!-- https://healtheconomics.wiki/concept/modified-rankin-scale -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/modified-rankin-scale">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
