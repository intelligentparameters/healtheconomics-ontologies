    <!-- https://healtheconomics.wiki/concept/competing-risks -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/competing-risks">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/parameter-input"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/parameter-input"/>
        <skos:notation>HE-EM-MP-006</skos:notation>
        <dcterms:identifier>HE-EM-MP-006</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-09</dcterms:modified>
        <dcterms:source>Austin et al. 2016</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Competing Risks</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Competing risks are events that each end a patient&apos;s time at risk, such as cardiovascular and other-cause death, so the first to occur rules out the rest.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Competing-Risk Events</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Multiple-Event Risk</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Competing Risks</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/dependent-censoring"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-4"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/cause-specific-survival"/>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/kaplan-meier-estimator"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/cumulative-incidence"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/hazard-rate"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/competing-risks"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/parameter-input"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-b45c474e8a20</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Model inputs and parameters in subdomain Economic Modelling; placed under Parameter Input, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/competing-risks"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/dependent-censoring"/>
        <dcterms:identifier>HEO-L-78515bf1a8d7</dcterms:identifier>
        <linkRationale xml:lang="en">Censoring competing events at their occurrence is censoring linked to event risk</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/competing-risks"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#threatensValidityOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cause-specific-survival"/>
        <dcterms:identifier>HEO-L-0b3b8b8946fc</dcterms:identifier>
        <linkRationale xml:lang="en">Cause-specific survival treats competing deaths as censoring, so it does not give a real-world probability</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/competing-risks"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#threatensValidityOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/kaplan-meier-estimator"/>
