    <!-- https://healtheconomics.wiki/concept/purchasing-power-adjustment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/purchasing-power-adjustment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-conversion"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/currency-conversion"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cost-conversion"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/currency-conversion"/>
        <skos:notation>HE-EE-CA-068</skos:notation>
        <dcterms:identifier>HE-EE-CA-068</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Purchasing Power Adjustment</rdfs:label>
        <skos:altLabel xml:lang="en">PPP Adjustment</skos:altLabel>
        <skos:definition xml:lang="en">The conversion of cost data across countries using purchasing power parity rather than market exchange rates, to reflect actual local costs.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cross-Country Cost Adjustment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Purchasing Power Adjustment</skos:prefLabel>
        <abbreviation xml:lang="en">PPP Adjustment</abbreviation>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/purchasing-power-parity"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/purchasing-power-adjustment"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-conversion"/>
        <dcterms:identifier>HEO-L-31c17e9c30d6</dcterms:identifier>
        <linkRationale xml:lang="en">Definition: PPP conversion rather than market exchange rates</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
