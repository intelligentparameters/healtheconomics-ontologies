    <!-- https://healtheconomics.wiki/concept/cost-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cost-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
