    <!-- https://healtheconomics.wiki/concept/private-sector-perspective -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/private-sector-perspective">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/perspective"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/perspective"/>
        <skos:notation>HE-EE-EPR-037</skos:notation>
        <dcterms:identifier>HE-EE-EPR-037</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Private Sector Perspective</rdfs:label>
        <skos:definition xml:lang="en">An analytic viewpoint including only costs and outcomes relevant to private organisations, such as insurers or employers, excluding costs borne by public payers.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Commercial Viewpoint</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Industry Standpoint</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Private Sector Perspective</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/public-sector-perspective"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/societal-perspective"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/private-sector-perspective"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/perspective"/>
        <dcterms:identifier>HEO-L-c9bc824b6e0d</dcterms:identifier>
        <linkRationale xml:lang="en">A private sector perspective is a perspective.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/private-sector-perspective"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/public-sector-perspective"/>
        <dcterms:identifier>HEO-L-a1c314f89932</dcterms:identifier>
        <linkRationale xml:lang="en">Private and public sector perspectives are alternative analytic viewpoints.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/private-sector-perspective"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/societal-perspective"/>
        <dcterms:identifier>HEO-L-b1a173563fb7</dcterms:identifier>
        <linkRationale xml:lang="en">The private sector perspective excludes costs the societal perspective counts; opposing viewpoints.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/private-system -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/private-system">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-system"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-system"/>
        <skos:notation>HS-HP-HSM-017</skos:notation>
        <dcterms:identifier>HS-HP-HSM-017</dcterms:identifier>
        <dcterms:source>World Health Organization. Everybody&apos;s Business: Strengthening Health Systems to Improve Health Outcomes-WHO&apos;s Framework for Action. WHO; 2007.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Private System</rdfs:label>
        <skos:altLabel xml:lang="en">Private Health System</skos:altLabel>
        <skos:definition xml:lang="en">A health system model in which financing and delivery are predominantly provided through private sector organisations, for-profit or non-profit.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Market-Based System</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Private System</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/private-system"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-system"/>
        <dcterms:identifier>HEO-L-1a165a7cf7b2</dcterms:identifier>
        <linkRationale xml:lang="en">A private system is one model of health system, a kind rather than a component</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/privatization -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/privatization">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:notation>HE-EE-EP-026</skos:notation>
        <dcterms:identifier>HE-EE-EP-026</dcterms:identifier>
        <dcterms:source>Musgrave &amp; Musgrave 1989</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Privatization</rdfs:label>
        <skos:altLabel xml:lang="en">Denationalisation</skos:altLabel>
        <skos:definition xml:lang="en">The transfer of ownership or operational control of an asset or service from government to private entities.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Private Transfer</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Privatization</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/private-system"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/privatization"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <dcterms:identifier>HEO-L-c5aa2494c131</dcterms:identifier>
        <linkRationale xml:lang="en">In health, privatisation is a policy choice about ownership of services.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/privatization"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/private-system"/>
        <dcterms:identifier>HEO-L-7a391d53b67d</dcterms:identifier>
        <linkRationale xml:lang="en">Privatisation shifts financing and delivery towards a private system.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
