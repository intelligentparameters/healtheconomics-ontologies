    <!-- https://healtheconomics.wiki/concept/strong-recommendation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/strong-recommendation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/recommendation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/recommendation"/>
        <skos:notation>HE-ES-EA-039</skos:notation>
        <dcterms:identifier>HE-ES-EA-039</dcterms:identifier>
        <dcterms:source>Guyatt GH, Oxman AD, Vist GE, et al. GRADE: an emerging consensus on rating quality of evidence and strength of recommendations. BMJ. 2008;336:924-926. doi:10.1136/bmj.39489.470347.AD.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Strong Recommendation</rdfs:label>
        <skos:definition xml:lang="en">Within GRADE, a recommendation indicating benefits clearly outweigh harms with high confidence, such that most patients would choose to follow it.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Grade 1 Recommendation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Strong Guideline Recommendation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Strong Recommendation</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/weak-recommendation"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/strong-recommendation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/recommendation"/>
        <dcterms:identifier>HEO-L-7223cd19bba7</dcterms:identifier>
        <linkRationale xml:lang="en">A strong recommendation is a recommendation issued with high confidence.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/strong-recommendation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/weak-recommendation"/>
        <dcterms:identifier>HEO-L-a5b40ba552e0</dcterms:identifier>
        <linkRationale xml:lang="en">GRADE recommendations are either strong or weak (conditional), opposing categories.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
