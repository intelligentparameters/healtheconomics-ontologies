        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Verbal Consent</rdfs:label>
        <skos:altLabel xml:lang="en">Oral Consent</skos:altLabel>
        <skos:definition xml:lang="en">A form of express consent in which a patient orally agrees to treatment, documented in the record, unlike formal written consent.</skos:definition>
