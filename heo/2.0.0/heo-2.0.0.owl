    <!-- https://healtheconomics.wiki/concept/health-profile -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/health-profile">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
