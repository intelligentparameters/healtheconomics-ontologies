    <!-- https://healtheconomics.wiki/concept/disruptive-innovation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/disruptive-innovation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/innovation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/innovation"/>
        <skos:notation>HE-PE-TI-011</skos:notation>
        <dcterms:identifier>HE-PE-TI-011</dcterms:identifier>
        <dcterms:source>Christensen, Raynor &amp; McDonald 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Disruptive Innovation</rdfs:label>
        <skos:altLabel xml:lang="en">Disruptive Technology</skos:altLabel>
        <skos:definition xml:lang="en">An innovation creating a new market by initially serving an overlooked segment with a simpler or cheaper offering, eventually displacing established competitors.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Displacing Innovation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Market-Disrupting Innovation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Disruptive Innovation</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/radical-innovation"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/disruptive-innovation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/innovation"/>
        <dcterms:identifier>HEO-L-1d6552cac10e</dcterms:identifier>
        <linkRationale xml:lang="en">disruptive innovation is a kind of innovation</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/disruptive-innovation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
