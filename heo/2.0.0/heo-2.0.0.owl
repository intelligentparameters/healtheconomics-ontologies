        <skos:notation>HE-EE-ME-022</skos:notation>
        <dcterms:identifier>HE-EE-ME-022</dcterms:identifier>
        <dcterms:source>Nelson 1970</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Experience Good</rdfs:label>
        <skos:definition xml:lang="en">A good whose quality can only be judged by the consumer after purchase and use, unlike a search good assessed beforehand.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Experience Product</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Post-Purchase-Assessed Good</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Experience Good</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/search-good"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/information-asymmetry"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/experience-good"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-good"/>
        <dcterms:identifier>HEO-L-a6d3944be688</dcterms:identifier>
        <linkRationale xml:lang="en">Classified by how quality is known (object definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/experience-good"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/search-good"/>
        <dcterms:identifier>HEO-L-01937e88b462</dcterms:identifier>
