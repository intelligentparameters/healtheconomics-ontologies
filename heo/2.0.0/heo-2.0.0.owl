    <!-- https://healtheconomics.wiki/concept/secondary-research -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/secondary-research">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-source"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/evidence-source"/>
        <skos:notation>HE-ES-ES-047</skos:notation>
        <dcterms:identifier>HE-ES-ES-047</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</dcterms:modified>
