    <!-- https://healtheconomics.wiki/concept/run-chart-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/run-chart-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-system-performance"/>
