        <dcterms:identifier>HE-ES-CO-062</dcterms:identifier>
        <dcterms:source>WHOQOL Group 1995</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Quality of Life Response</rdfs:label>
        <skos:altLabel xml:lang="en">QoL Response</skos:altLabel>
        <skos:definition xml:lang="en">A measure indicating a clinically meaningful improvement in quality of life following treatment, defined using an established minimal important difference threshold.</skos:definition>
