        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/patient-cap"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/managed-entry-agreement"/>
        <dcterms:identifier>HEO-L-b4bfa8b1d386</dcterms:identifier>
        <linkRationale xml:lang="en">A cap on reimbursed patients is a payer-side financial agreement, not patient cost sharing</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/patient-cap"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/volume-control"/>
        <dcterms:identifier>HEO-L-dcffdab2c237</dcterms:identifier>
