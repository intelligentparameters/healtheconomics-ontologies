    <!-- https://healtheconomics.wiki/concept/incremental-innovation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/incremental-innovation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/innovation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/innovation"/>
        <skos:notation>HE-PE-TI-017</skos:notation>
        <dcterms:identifier>HE-PE-TI-017</dcterms:identifier>
        <dcterms:source>Christensen, Raynor &amp; McDonald 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Incremental Innovation</rdfs:label>
        <skos:definition xml:lang="en">An innovation making gradual, often modest improvements to an existing product or technology, unlike a radical or disruptive innovation.</skos:definition>
        <skos:prefLabel xml:lang="en">Incremental Innovation</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/disruptive-innovation"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/radical-innovation"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/moving-target-problem"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
