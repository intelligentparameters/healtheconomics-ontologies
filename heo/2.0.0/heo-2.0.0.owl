    <!-- https://healtheconomics.wiki/concept/commercial-access-agreement -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/commercial-access-agreement">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
