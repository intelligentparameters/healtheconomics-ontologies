    <!-- https://healtheconomics.wiki/concept/social-discount-rate -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/social-discount-rate">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/discount-rate"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q7551053"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/discount-rate"/>
        <skos:notation>HE-EE-DC-013</skos:notation>
        <dcterms:identifier>HE-EE-DC-013</dcterms:identifier>
        <dcterms:source>HM Treasury Green Book 2022</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Social Discount Rate</rdfs:label>
        <skos:altLabel xml:lang="en">Societal Discount Rate</skos:altLabel>
        <skos:definition xml:lang="en">The rate at which government or society as a whole is considered to discount future costs and benefits, used in public sector evaluation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Social Time Preference Rate</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Social Discount Rate</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/social-discount-rate"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/discount-rate"/>
        <dcterms:identifier>HEO-L-c7d99ac1b4f3</dcterms:identifier>
        <linkRationale xml:lang="en">The social discount rate is a discount rate.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/social-epidemiology -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/social-epidemiology">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
