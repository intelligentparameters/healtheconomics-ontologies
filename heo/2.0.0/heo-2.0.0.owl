    <!-- https://healtheconomics.wiki/concept/fixed-budget -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/fixed-budget">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/budget-impact-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/budget-impact-analysis"/>
        <skos:notation>HE-EE-BIA-033</skos:notation>
        <dcterms:identifier>HE-EE-BIA-033</dcterms:identifier>
        <dcterms:source>Horngren, Datar &amp; Rajan 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Fixed Budget</rdfs:label>
        <skos:altLabel xml:lang="en">Static Budget</skos:altLabel>
        <skos:definition xml:lang="en">A budget set at a specific level regardless of changes in activity or service volume during the period.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Fixed Allocation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Fixed Budget</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/flexible-budget"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/fixed-budget"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
