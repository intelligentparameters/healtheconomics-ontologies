    <!-- https://healtheconomics.wiki/concept/area-under-curve -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/area-under-curve">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/criterion-validity"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/discrimination"/>
        <skos:notation>HE-ES-SA-006</skos:notation>
        <dcterms:identifier>HE-ES-SA-006</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Hanley &amp; McNeil 1982</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Area Under Curve</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">AUC</skos:altLabel>
        <skos:altLabel xml:lang="en">AUROC</skos:altLabel>
        <skos:altLabel xml:lang="en">C-Statistic</skos:altLabel>
        <skos:definition xml:lang="en">Area under the curve (AUC), or C-statistic, is the probability a test or risk model scores a random case above a random non-case (0.5 chance, 1 perfect).</skos:definition>
        <skos:prefLabel xml:lang="en">Area Under Curve</skos:prefLabel>
        <abbreviation xml:lang="en">AUC</abbreviation>
        <abbreviation xml:lang="en">AUROC</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/decision-curve-analysis"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/area-under-curve"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
