    <!-- https://healtheconomics.wiki/concept/cream-skimming -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cream-skimming">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/risk-selection"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q123169142"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/risk-selection"/>
        <skos:notation>HS-HP-HI-059</skos:notation>
        <dcterms:identifier>HS-HP-HI-059</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Ellis 2008</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cream Skimming</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Cherry Picking</skos:altLabel>
        <skos:definition xml:lang="en">Cream skimming is when an insurer or provider attracts people expected to cost less than it is paid for them and deters those expected to cost more.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Favourable Risk Selection</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cream Skimming</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-2"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/risk-pooling"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/benefit-design"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cream-skimming"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/risk-selection"/>
        <dcterms:identifier>HEO-L-13a76afaa693</dcterms:identifier>
        <linkRationale xml:lang="en">Attracting low-cost enrollees is risk selection</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cream-skimming"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
