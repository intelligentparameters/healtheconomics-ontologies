        <skos:hiddenLabel xml:lang="en">Symptom Load</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Symptom Burden</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/quality-of-life"/>
