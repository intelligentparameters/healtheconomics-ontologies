    <!-- https://healtheconomics.wiki/concept/quality-score -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/quality-score">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
