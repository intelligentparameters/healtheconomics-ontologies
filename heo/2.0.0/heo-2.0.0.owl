        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Saltelli et al. 2008</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Interaction Effect</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A difference in one variable’s effect across levels of another variable, defined on a specified outcome and measurement scale.</skos:definition>
        <skos:prefLabel xml:lang="en">Interaction Effect</skos:prefLabel>
