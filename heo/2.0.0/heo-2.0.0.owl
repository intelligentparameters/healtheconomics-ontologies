    <!-- https://healtheconomics.wiki/concept/margin-management -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/margin-management">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-system-performance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-system-performance"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/financial-management"/>
        <skos:notation>HS-SS_HSP-039</skos:notation>
        <dcterms:identifier>HS-SS_HSP-039</dcterms:identifier>
        <dcterms:source>Horngren, Datar &amp; Rajan 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Margin Management</rdfs:label>
        <skos:definition xml:lang="en">The financial strategies an organisation uses to manage the difference between revenue and expenses, ensuring adequate resources to sustain operations.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Margin Control</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Profitability Management</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Margin Management</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/operating-margin"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/net-margin"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/margin-management"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
