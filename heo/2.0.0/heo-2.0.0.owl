        <dcterms:identifier>HE-EE-QALY-002</dcterms:identifier>
        <dcterms:source>Williams 1997</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Fair Innings</rdfs:label>
        <skos:definition xml:lang="en">An ethical argument holding that people who die young have been deprived of a fair share of a normal lifespan, deserving greater priority.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Fair Lifespan Principle</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Fair-Share Lifespan</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Fair Innings</skos:prefLabel>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/equity-weighted-analysis"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/fair-innings"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/distributive-justice"/>
        <dcterms:identifier>HEO-L-0c38e72b72a9</dcterms:identifier>
        <linkRationale xml:lang="en">Fair innings is an argument about fair shares of lifetime health</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/fair-innings"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isFoundationFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/equity-weighted-analysis"/>
        <dcterms:identifier>HEO-L-723802300114</dcterms:identifier>
