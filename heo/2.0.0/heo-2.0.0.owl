    <!-- https://healtheconomics.wiki/concept/traceable-cost -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/traceable-cost">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/direct-cost"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/direct-cost"/>
        <skos:notation>HE-EE-CA-084</skos:notation>
        <dcterms:identifier>HE-EE-CA-084</dcterms:identifier>
        <dcterms:source>Horngren, Datar &amp; Rajan 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Traceable Cost</rdfs:label>
        <skos:definition xml:lang="en">A cost that can be directly attributed to a particular department, product, or service line without relying on an allocation method.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Assignable Cost</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Directly Attributable Cost</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Traceable Cost</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/overhead-cost"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/traceable-cost"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/direct-cost"/>
        <dcterms:identifier>HEO-L-78bce8a0dec6</dcterms:identifier>
        <linkRationale xml:lang="en">The direct cost definition includes a cost traced to a service.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/traceable-cost"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/overhead-cost"/>
        <dcterms:identifier>HEO-L-d30d0c2e43f2</dcterms:identifier>
        <linkRationale xml:lang="en">Indirect Cost here means productivity loss; the accounting opposite of a traceable cost is an overhead that cannot be directly attributed.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


