    <!-- https://healtheconomics.wiki/concept/choosing-wisely -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/choosing-wisely">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/horizon-scanning"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q23021796"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/horizon-scanning"/>
        <skos:notation>HS-HP-HS-001</skos:notation>
        <dcterms:identifier>HS-HP-HS-001</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-09</dcterms:modified>
        <dcterms:source>Born &amp; Levinson 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Choosing Wisely</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Choosing Wisely is a clinician-led campaign in which specialty societies list overused tests and treatments that doctors and patients should question.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Low-Value Care Reduction</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Overuse Reduction Initiative</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Choosing Wisely</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/overutilization"/>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/low-value-care"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/disinvestment"/>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/appropriate-care"/>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/shared-decision-making"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/choosing-wisely"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/horizon-scanning"/>
