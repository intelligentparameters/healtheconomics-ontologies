    <!-- https://healtheconomics.wiki/concept/variance-covariance-matrix -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/variance-covariance-matrix">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/parameter-input"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/parameter-input"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/correlation-matrix"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/standard-error"/>
        <skos:notation>HE-EM-MP-046</skos:notation>
        <dcterms:identifier>HE-EM-MP-046</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Pearson 1896</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Variance-Covariance Matrix</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Covariance Matrix</skos:altLabel>
        <skos:altLabel xml:lang="en">Dispersion Matrix</skos:altLabel>
        <skos:definition xml:lang="en">A symmetric array of variances and pairwise covariances that describes the scale and joint movement of a set of random quantities or estimates.</skos:definition>
        <skos:prefLabel xml:lang="en">Variance-Covariance Matrix</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-4"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
