        <rdfs:label xml:lang="en">Convergent Validity</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Convergent validity is evidence that a health measure correlates, as predicted in advance, with other measures of the same or a closely related construct.</skos:definition>
