    <!-- https://healtheconomics.wiki/concept/access-policy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/access-policy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q112795396"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:notation>HS-HP-HE-003</skos:notation>
        <dcterms:identifier>HS-HP-HE-003</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Penchansky R, Thomas JW. The concept of access: definition and relationship to consumer satisfaction. Medical Care. 1981;19(2):127?140. doi:10.1097/00005650-198102000-00001.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Access Policy</rdfs:label>
        <owl:versionInfo>1.0.3</owl:versionInfo>
        <skos:definition xml:lang="en">Access policy is the set of government or health system measures, such as coverage, user charges and waiting time rules, that shape access to healthcare.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Health Care Access Policy</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Healthcare Access Policy</skos:hiddenLabel>
