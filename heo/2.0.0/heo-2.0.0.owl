        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:notation>HS-HP-HS-009</skos:notation>
        <dcterms:identifier>HS-HP-HS-009</dcterms:identifier>
        <dcterms:source>Douw &amp; Vondeling 2006</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Horizon Scanning</rdfs:label>
        <skos:altLabel xml:lang="en">EAAS</skos:altLabel>
        <skos:altLabel xml:lang="en">Early Awareness System</skos:altLabel>
        <skos:altLabel xml:lang="en">Early Awareness and Alert System</skos:altLabel>
        <skos:altLabel xml:lang="en">Early Warning System</skos:altLabel>
        <skos:definition xml:lang="en">A systematic process identifying, tracking, and prioritising emerging technologies likely to significantly affect a health system, before market entry.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Emerging Technology Monitoring</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Emerging-Tech Surveillance</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Technology Watch</skos:hiddenLabel>
