        <skos:altLabel xml:lang="en">Within Estimator</skos:altLabel>
        <skos:definition xml:lang="en">A panel data modelling approach estimating a separate intercept for each individual or group, controlling for all its time-invariant characteristics.</skos:definition>
        <skos:prefLabel xml:lang="en">Fixed Effects</skos:prefLabel>
