    <!-- https://healtheconomics.wiki/concept/choice-theory -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/choice-theory">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-principle"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-principle"/>
        <skos:notation>HE-EE-EPR-003</skos:notation>
        <dcterms:identifier>HE-EE-EPR-003</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-09</dcterms:modified>
        <dcterms:source>Osborne &amp; Rubinstein 2023</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Choice Theory</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Choice theory is the economic theory of how people choose among options given preferences and limited resources, underpinning demand and health valuation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Consumer Preference Theory</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Rational Choice Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Choice Theory</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/behavioural-economics"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/bounded-rationality-concept"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/revealed-preference"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/welfare-economics"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/budget-constraint"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/expected-utility"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/utility-function"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/choice-theory"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-principle"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-4814fb26cb99</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Scarcity choice and opportunity cost in subdomain Economic Foundations; placed under Economic Principle, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/choice-theory"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/behavioural-economics"/>
        <dcterms:identifier>HEO-L-c48fb9c9d592</dcterms:identifier>
        <linkRationale xml:lang="en">Behavioural economics studies departures from rational choice predictions (object definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/choice-theory"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/bounded-rationality-concept"/>
