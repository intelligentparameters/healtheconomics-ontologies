    <!-- https://healtheconomics.wiki/concept/scenario-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/scenario-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/sensitivity-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/sensitivity-analysis"/>
        <skos:notation>HE-EM-UA-059</skos:notation>
        <dcterms:identifier>HE-EM-UA-059</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</dcterms:modified>
        <dcterms:source>Steuten et al. 2026</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Scenario Analysis</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:definition xml:lang="en">Scenario analysis re-runs a health economic model under alternative assumptions, such as another survival extrapolation, to see if the decision changes.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Scenario Testing</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">What-If Analysis</skos:hiddenLabel>
