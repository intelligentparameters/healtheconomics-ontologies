    <!-- https://healtheconomics.wiki/concept/subcutaneous-administration -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/subcutaneous-administration">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/route-of-administration"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/route-of-administration"/>
        <skos:notation>HE-PE-DF-008</skos:notation>
        <dcterms:identifier>HE-PE-DF-008</dcterms:identifier>
        <dcterms:source>Rowland &amp; Tozer 2010</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Subcutaneous Administration</rdfs:label>
        <skos:altLabel xml:lang="en">SC Administration</skos:altLabel>
        <skos:definition xml:lang="en">A route of drug administration involving injection into the fatty tissue beneath the skin, often suitable for patient self-administration at home.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Subcutaneous Injection</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Subcutaneous Administration</skos:prefLabel>
        <abbreviation xml:lang="en">SC Administration</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/intravenous-administration"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/administration-cost"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/subcutaneous-administration"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/route-of-administration"/>
        <dcterms:identifier>HEO-L-e10c9a531462</dcterms:identifier>
        <linkRationale xml:lang="en">Subcutaneous administration is a route of administration.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/subcutaneous-administration"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/intravenous-administration"/>
        <dcterms:identifier>HEO-L-00e94546cfce</dcterms:identifier>
        <linkRationale xml:lang="en">Subcutaneous and intravenous are alternative injection routes.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/subcutaneous-administration"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/administration-cost"/>
        <dcterms:identifier>HEO-L-598cc673c19f</dcterms:identifier>
