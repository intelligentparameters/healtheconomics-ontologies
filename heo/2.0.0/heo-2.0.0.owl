    <!-- https://healtheconomics.wiki/concept/star-rating -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/star-rating">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
