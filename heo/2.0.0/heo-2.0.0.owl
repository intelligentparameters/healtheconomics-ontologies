        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-assessment"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/reliability-assessment"/>
        <skos:notation>HE-ES-EA-026</skos:notation>
        <dcterms:identifier>HE-ES-EA-026</dcterms:identifier>
        <dcterms:source>Landis &amp; Koch 1977</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Intra-Rater Reliability</rdfs:label>
        <skos:altLabel xml:lang="en">Intra-Observer Agreement</skos:altLabel>
        <skos:altLabel xml:lang="en">Within-Rater Reliability</skos:altLabel>
        <skos:definition xml:lang="en">The degree of agreement between repeated assessments made by the same rater evaluating the same phenomenon on separate occasions.</skos:definition>
        <skos:prefLabel xml:lang="en">Intra-Rater Reliability</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-4"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
