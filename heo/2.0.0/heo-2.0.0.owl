    <!-- https://healtheconomics.wiki/concept/market-access -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/market-access">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
