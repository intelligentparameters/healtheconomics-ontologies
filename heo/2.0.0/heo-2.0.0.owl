    <!-- https://healtheconomics.wiki/concept/matching-adjusted-indirect-comparison -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/matching-adjusted-indirect-comparison">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/indirect-treatment-comparison"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/indirect-treatment-comparison"/>
        <skos:notation>HE-ES-CER-020</skos:notation>
        <dcterms:identifier>HE-ES-CER-020</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-24</dcterms:modified>
        <dcterms:source>Signorovitch et al. 2010</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Matching-Adjusted Indirect Comparison</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">MAIC</skos:altLabel>
        <skos:definition xml:lang="en">A method comparing treatments from separate trials with different populations by reweighting one trial&apos;s patient data to match the other trial&apos;s reported characteristics.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Weighted Indirect Comparison</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Matching-Adjusted Indirect Comparison</skos:prefLabel>
        <abbreviation xml:lang="en">MAIC</abbreviation>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/disconnected-network"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/network-meta-analysis"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/simulated-treatment-comparison"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/propensity-score"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/matching-adjusted-indirect-comparison"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/indirect-treatment-comparison"/>
        <dcterms:identifier>HEO-L-b4f0facd829f</dcterms:identifier>
        <linkRationale xml:lang="en">The ITC definition names MAIC as one of its methods</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/matching-adjusted-indirect-comparison"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#addresses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/disconnected-network"/>
        <dcterms:identifier>HEO-L-6ab9dfc7f56a</dcterms:identifier>
        <linkRationale xml:lang="en">Unanchored population-adjusted comparisons such as MAIC are the usual response when no common comparator links the treatments.</linkRationale>
