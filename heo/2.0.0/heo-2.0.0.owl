    <!-- https://healtheconomics.wiki/concept/hard-budget-constraint -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/hard-budget-constraint">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/budget-constraint"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/budget-constraint"/>
        <skos:notation>HE-EE-BIA-035</skos:notation>
        <dcterms:identifier>HE-EE-BIA-035</dcterms:identifier>
        <dcterms:source>Kornai 1986</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Hard Budget Constraint</rdfs:label>
        <skos:definition xml:lang="en">A binding spending limit an organisation cannot exceed without genuine financial consequences, such as insolvency or service cuts.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Binding Budget Constraint</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Fixed Budget Limit</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Hard Budget Constraint</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/soft-budget-constraint"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/hard-budget-constraint"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/budget-constraint"/>
        <dcterms:identifier>HEO-L-548153251e4f</dcterms:identifier>
        <linkRationale xml:lang="en">A hard budget constraint is a budget constraint</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
