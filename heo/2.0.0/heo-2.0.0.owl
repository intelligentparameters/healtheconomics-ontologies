    <!-- https://healtheconomics.wiki/concept/throughput-efficiency -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/throughput-efficiency">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/efficiency"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/efficiency"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/patient-flow"/>
        <skos:notation>HS-SS_HSP-062</skos:notation>
        <dcterms:identifier>HS-SS_HSP-062</dcterms:identifier>
        <dcterms:source>Law &amp; Kelton 2000</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Throughput Efficiency</rdfs:label>
        <skos:definition xml:lang="en">A measure of how effectively a process moves patients through their care journey relative to the time and resources consumed.</skos:definition>
