    <!-- https://healtheconomics.wiki/concept/partitioned-survival-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/partitioned-survival-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-economic-model"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
