        <dcterms:source>Fetter et al. 1980</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Observed-to-Expected Ratio</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">O/E Ratio</skos:altLabel>
        <skos:altLabel xml:lang="en">Observed-Expected Ratio</skos:altLabel>
        <skos:definition xml:lang="en">A measure comparing a provider&apos;s actual observed outcomes against statistically expected numbers given patient severity, above one meaning worse than expected.</skos:definition>
        <skos:prefLabel xml:lang="en">Observed-to-Expected Ratio</skos:prefLabel>
        <abbreviation xml:lang="en">O/E Ratio</abbreviation>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/case-mix-adjustment"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/observed-to-expected-ratio"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/risk-adjusted-measure"/>
        <dcterms:identifier>HEO-L-4b5445855a82</dcterms:identifier>
        <linkRationale xml:lang="en">A ratio of observed to severity-expected outcomes is a risk-adjusted measure, not the adjustment process</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/observed-to-expected-ratio"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/case-mix-adjustment"/>
        <dcterms:identifier>HEO-L-708776f40afd</dcterms:identifier>
        <skos:editorialNote xml:lang="en">suggested source, not yet checked: Iezzoni 2013</skos:editorialNote>
        <linkRationale xml:lang="en">Loop resolved; the expected count comes from a case-mix (risk) adjustment model</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/observer-reported-outcome -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/observer-reported-outcome">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome-assessment"/>
