        <skos:hiddenLabel xml:lang="en">Textual Synthesis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Narrative Synthesis</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/meta-analysis"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/narrative-review"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
