    <!-- https://healtheconomics.wiki/concept/trust-in-healthcare -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/trust-in-healthcare">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HE-EE-ME-073</skos:notation>
        <dcterms:identifier>HE-EE-ME-073</dcterms:identifier>
        <dcterms:source>Mechanic 1996</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Trust in Healthcare</rdfs:label>
        <skos:definition xml:lang="en">The confidence patients place in providers and institutions to act competently and in the patient&apos;s best interest despite information asymmetry.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Healthcare Trust</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Patient Trust</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Trust in Healthcare</skos:prefLabel>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/agency-relationship"/>
