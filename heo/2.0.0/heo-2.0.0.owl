        <abbreviation xml:lang="en">TOX</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/time-without-symptoms-of-progression"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
