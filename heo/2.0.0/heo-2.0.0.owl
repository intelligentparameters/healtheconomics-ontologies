    <!-- https://healtheconomics.wiki/concept/mixed-effects-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/mixed-effects-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1501135"/>
