        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/tax"/>
        <skos:notation>HS-HP-HF-022</skos:notation>
        <dcterms:identifier>HS-HP-HF-022</dcterms:identifier>
        <dcterms:source>Musgrave &amp; Musgrave 1989</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Earmarked Taxation</rdfs:label>
        <skos:altLabel xml:lang="en">Hypothecated Tax</skos:altLabel>
        <skos:definition xml:lang="en">A tax whose revenue is legally designated for a specific purpose, such as healthcare, rather than a government&apos;s general revenue fund.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Dedicated Health Tax</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Earmarked Taxation</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/general-taxation"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/earmarked-taxation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <dcterms:identifier>HEO-L-4c79d2d32e0b</dcterms:identifier>
        <linkRationale xml:lang="en">an earmarked tax is a health financing mechanism</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
