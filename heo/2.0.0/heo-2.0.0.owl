    <!-- https://healtheconomics.wiki/concept/grade -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/grade">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-assessment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-assessment"/>
        <skos:notation>HE-ES-EA-020</skos:notation>
        <dcterms:identifier>HE-ES-EA-020</dcterms:identifier>
        <dcterms:source>Guyatt GH, Oxman AD, Vist GE, et al. GRADE: an emerging consensus on rating quality of evidence and strength of recommendations. BMJ. 2008;336:924-926. doi:10.1136/bmj.39489.470347.AD.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">GRADE</rdfs:label>
        <skos:altLabel xml:lang="en">Grading of Recommendations Assessment Development and Evaluation</skos:altLabel>
        <skos:definition xml:lang="en">An abbreviation for the Grading of Recommendations Assessment, Development and Evaluation framework, a widely adopted system for rating evidence certainty.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Evidence Certainty Framework</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">GRADE</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/level-of-evidence"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/recommendation"/>
        <instanceOf rdf:resource="https://healtheconomics.wiki/concept/evidence-grading"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/certainty-of-evidence"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/grade"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
