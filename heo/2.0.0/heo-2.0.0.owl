    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/population-attributable-risk -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/population-attributable-risk">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/attributable-risk"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/attributable-risk"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/attributable-fraction"/>
        <skos:notation>HE-ES-RM-021</skos:notation>
        <dcterms:identifier>HE-ES-RM-021</dcterms:identifier>
        <dcterms:source>Levin 1953</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Population Attributable Risk</rdfs:label>
        <skos:altLabel xml:lang="en">PAR</skos:altLabel>
        <skos:definition xml:lang="en">The reduction in disease incidence within a population that would result from eliminating a harmful exposure entirely, expressed as an absolute rate.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Population Excess Risk</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Population Attributable Risk</skos:prefLabel>
        <abbreviation xml:lang="en">PAR</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-2"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/population-attributable-risk"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/attributable-risk"/>
        <dcterms:identifier>HEO-L-59b5f197e525</dcterms:identifier>
        <linkRationale xml:lang="en">PAR is the population form of attributable risk</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/population-attributable-risk"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/attributable-fraction"/>
        <dcterms:identifier>HEO-L-752fec628bef</dcterms:identifier>
        <linkRationale xml:lang="en">PAF equals PAR divided by total incidence</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/population-based-payment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/population-based-payment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
