    <!-- https://healtheconomics.wiki/concept/pre-commitment-intervention -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/pre-commitment-intervention">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/behaviour-change-intervention"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/behaviour-change-intervention"/>
        <skos:notation>HE-EE-BE-030</skos:notation>
        <dcterms:identifier>HE-EE-BE-030</dcterms:identifier>
        <dcterms:source>Thaler &amp; Shefrin 1981</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Pre-Commitment Intervention</rdfs:label>
        <skos:altLabel xml:lang="en">Commitment Device</skos:altLabel>
        <skos:altLabel xml:lang="en">Commitment Intervention</skos:altLabel>
        <skos:definition xml:lang="en">A mechanism allowing a person to voluntarily restrict future choices in advance to support a desired long-term behaviour.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Self-Binding Device</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Self-Binding Mechanism</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Ulysses Contract</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Pre-Commitment Intervention</skos:prefLabel>
        <assumes rdf:resource="https://healtheconomics.wiki/concept/hyperbolic-discounting"/>
        <assumes rdf:resource="https://healtheconomics.wiki/concept/present-bias-concept"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/self-control-concept"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/present-bias-concept"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/pre-commitment-intervention"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/behaviour-change-intervention"/>
        <dcterms:identifier>HEO-L-7062a42fd4d4</dcterms:identifier>
        <linkRationale xml:lang="en">Restricting future options does not meet the nudge definition, which forbids no options; Commitment Intervention contrastsWith Nudge Intervention</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
