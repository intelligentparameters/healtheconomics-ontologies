    <!-- https://healtheconomics.wiki/concept/condition-index -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/condition-index">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/collinearity-diagnostics"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/collinearity-diagnostics"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/multicollinearity"/>
        <skos:notation>HE-ES-SA-032</skos:notation>
        <dcterms:identifier>HE-ES-SA-032</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-23</dcterms:modified>
        <dcterms:source>Belsley, Kuh &amp; Welsch 1980</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Condition Index</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Condition Indices</skos:altLabel>
        <skos:definition xml:lang="en">A condition index is the ratio of the largest singular value of a scaled regression design matrix to another singular value, used to assess near-linear dependence among predictors.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Collinearity Condition Index</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Conditioning Index</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Condition Index</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/eigenvalue"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/condition-index"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/collinearity-diagnostics"/>
        <dcterms:identifier>HEO-L-778b581e9695</dcterms:identifier>
        <linkRationale xml:lang="en">A regression check for near-linear dependence</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/condition-index"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/multicollinearity"/>
        <dcterms:identifier>HEO-L-a4bf23405758</dcterms:identifier>
        <linkRationale xml:lang="en">Large condition indices are the standard diagnostic of multicollinearity (Belsley et al. 1980)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
