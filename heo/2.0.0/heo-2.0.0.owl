    <!-- https://healtheconomics.wiki/concept/prevalence-ratio -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/prevalence-ratio">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/relative-measure"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/relative-measure"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/population-attributable-fraction"/>
        <skos:notation>HE-ES-RM-028</skos:notation>
        <dcterms:identifier>HE-ES-RM-028</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Tamhane et al. 2016</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Prevalence Ratio</rdfs:label>
        <owl:versionInfo>1.0.4</owl:versionInfo>
        <skos:definition xml:lang="en">The prevalence ratio (PR) is the prevalence of a condition in an exposed group divided by that in an unexposed group, used to compare disease burden.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Comparative Prevalence</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Relative Prevalence</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Prevalence Ratio</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/odds-ratio"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/prevalence-ratio"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/relative-measure"/>
        <dcterms:identifier>HEO-L-5626cc6adf77</dcterms:identifier>
        <linkRationale xml:lang="en">A prevalence ratio is a relative measure</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/prevalence-ratio"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/population-attributable-fraction"/>
        <dcterms:identifier>HEO-L-249eb9ef02b1</dcterms:identifier>
        <linkRationale xml:lang="en">In cross-sectional data the prevalence ratio stands in for RR in the PAF formula</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
