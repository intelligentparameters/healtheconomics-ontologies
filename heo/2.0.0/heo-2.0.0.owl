        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Cox-Snell Residuals</skos:altLabel>
        <skos:definition xml:lang="en">A Cox-Snell residual is a survival model&apos;s fitted cumulative hazard at a patient&apos;s observed time, used to check overall fit against a unit exponential.</skos:definition>
        <skos:prefLabel xml:lang="en">Cox-Snell Residual</skos:prefLabel>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/parametric-survival-model"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/model-selection"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cox-snell-residual"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/residual"/>
        <dcterms:identifier>HEO-L-8cd545871e8b</dcterms:identifier>
        <linkRationale xml:lang="en">A Cox-Snell residual is a model residual</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cox-snell-residual"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/goodness-of-fit"/>
        <dcterms:identifier>HEO-L-27742720480c</dcterms:identifier>
        <linkRationale xml:lang="en">Cox-Snell residuals are checked against a unit exponential to judge overall fit</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cox-snell-residual"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/deviance-residual"/>
        <dcterms:identifier>HEO-L-d8161e83b4f5</dcterms:identifier>
        <linkRationale xml:lang="en">The Cox model deviance residual is computed from the martingale residual, which is the event indicator minus the Cox-Snell residual</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cox-snell-residual"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/martingale-residual"/>
        <dcterms:identifier>HEO-L-6e74ebe69fac</dcterms:identifier>
        <linkRationale xml:lang="en">Martingale residual equals the event indicator minus the Cox-Snell residual (Collett 2015)</linkRationale>
