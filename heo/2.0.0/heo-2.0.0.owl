    <!-- https://healtheconomics.wiki/concept/case-control-design -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/case-control-design">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/observational-study"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/observational-study"/>
        <skos:notation>HE-ES-CTM-012</skos:notation>
        <dcterms:identifier>HE-ES-CTM-012</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Vandenbroucke et al. 2007; NICE ECD9 (2022, updated 2025)</dcterms:source>
