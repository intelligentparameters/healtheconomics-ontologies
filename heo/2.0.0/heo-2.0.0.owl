    <!-- https://healtheconomics.wiki/concept/evidence-update -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/evidence-update">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:notation>HS-HP-HTA-084</skos:notation>
        <dcterms:identifier>HS-HP-HTA-084</dcterms:identifier>
        <dcterms:source>Higgins et al. 2011</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Evidence Update</rdfs:label>
        <skos:definition xml:lang="en">A revision to a previously completed assessment or guideline incorporating newly available evidence that has emerged since it was conducted.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Assessment Update</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Guideline Refresh</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Evidence Update</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
