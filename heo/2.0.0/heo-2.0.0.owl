        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/comparative-effectiveness-research"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/effectiveness-study"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/relative-effectiveness"/>
        <skos:notation>HE-ES-RWE-002</skos:notation>
        <dcterms:identifier>HE-ES-RWE-002</dcterms:identifier>
        <dcterms:source>Institute of Medicine. Initial National Priorities for Comparative Effectiveness Research. National Academies Press; 2009. doi:10.17226/12648.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Comparative Effectiveness Study</rdfs:label>
        <skos:definition xml:lang="en">A research study directly comparing the real-world benefits and harms of two or more alternative interventions for a clinical condition.</skos:definition>
        <skos:hiddenLabel xml:lang="en">CE Study</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Head-to-Head Study</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Comparative Effectiveness Study</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
