    <!-- https://healtheconomics.wiki/concept/posterior-odds -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/posterior-odds">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-ES-RM-024</skos:notation>
        <dcterms:identifier>HE-ES-RM-024</dcterms:identifier>
        <dcterms:source>Bayes 1763</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Posterior Odds</rdfs:label>
        <skos:definition xml:lang="en">The updated odds that a hypothesis is true after incorporating new evidence, found by multiplying prior odds by the likelihood ratio.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Post-Data Odds</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Updated Odds</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Posterior Odds</skos:prefLabel>
        <counterpartOf rdf:resource="https://healtheconomics.wiki/concept/posterior-probability"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-2"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/likelihood-ratio"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/posterior-odds"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-c55cd4edfa2f</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Epidemiology and risk measures in subdomain Evidence Synthesis</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/posterior-odds"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#counterpartOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/posterior-probability"/>
        <dcterms:identifier>HEO-L-a66ea0994a3d</dcterms:identifier>
        <linkRationale xml:lang="en">Posterior odds and posterior probability express the same updated belief on different scales</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
