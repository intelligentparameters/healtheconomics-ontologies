    <!-- https://healtheconomics.wiki/concept/specialty-access -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/specialty-access">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/access-to-care"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/access-to-care"/>
        <skos:notation>HS-HP-HE-030</skos:notation>
        <dcterms:identifier>HS-HP-HE-030</dcterms:identifier>
        <dcterms:source>Penchansky R, Thomas JW. The concept of access: definition and relationship to consumer satisfaction. Medical Care. 1981;19(2):127-140. doi:10.1097/00005650-198102000-00001.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Specialty Access</rdfs:label>
        <skos:altLabel xml:lang="en">Access to Specialists</skos:altLabel>
        <skos:definition xml:lang="en">A healthcare access dimension concerning patients&apos; ability to obtain care from specialist providers, often more limited in supply than primary care.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Specialty Care Access</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Specialty Access</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/specialty-access"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/access-to-care"/>
        <dcterms:identifier>HEO-L-a8065370ede1</dcterms:identifier>
        <linkRationale xml:lang="en">Specialty access is one dimension of access to care.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/specialty-drug -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/specialty-drug">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/formulary-management"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/formulary-management"/>
        <skos:notation>PP-PC-FM-009</skos:notation>
        <dcterms:identifier>PP-PC-FM-009</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Specialty Drug</rdfs:label>
        <skos:altLabel xml:lang="en">Specialty Medication</skos:altLabel>
        <skos:definition xml:lang="en">A category of typically high-cost medications treating complex or rare conditions, often requiring special handling and reimbursed at a distinct, higher tier.</skos:definition>
        <skos:hiddenLabel xml:lang="en">High-Cost Drug</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Specialty Drug</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/specialty-pharmacy"/>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/specialty-tier"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/specialty-drug"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/formulary-management"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-e6e5f616f2f7</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Pharmacy Practice &gt; Pharmaceutical Care &gt; Formulary Management: formulary listing is a reimbursement decision (Reimbursement and managed access); placed under Formulary Management, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/specialty-drug"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#setsScopeOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/specialty-pharmacy"/>
        <dcterms:identifier>HEO-L-5080b75077c8</dcterms:identifier>
        <linkRationale xml:lang="en">The specialty drug category defines what specialty pharmacies dispense.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/specialty-drug"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#setsScopeOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/specialty-tier"/>
        <dcterms:identifier>HEO-L-f9355e4ea6e0</dcterms:identifier>
        <linkRationale xml:lang="en">Specialty drug status determines what falls in the specialty tier.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/specialty-hospital -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/specialty-hospital">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/healthcare-facility"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/healthcare-facility"/>
        <skos:notation>HS-HP-HD-106</skos:notation>
        <dcterms:identifier>HS-HP-HD-106</dcterms:identifier>
        <dcterms:source>AHA, American Hospital Association</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Specialty Hospital</rdfs:label>
        <skos:altLabel xml:lang="en">Specialised Hospital</skos:altLabel>
        <skos:definition xml:lang="en">A hospital focused on treating a specific condition type or procedure category, such as orthopaedic or cardiac surgery, unlike a general hospital.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Focused-Factory Hospital</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Specialty Hospital</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/community-hospital"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/specialty-hospital"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/healthcare-facility"/>
        <dcterms:identifier>HEO-L-fb859f131c93</dcterms:identifier>
        <linkRationale xml:lang="en">A specialty hospital is a healthcare facility.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/specialty-hospital"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/community-hospital"/>
        <dcterms:identifier>HEO-L-ba9267c45740</dcterms:identifier>
        <linkRationale xml:lang="en">A specialty hospital contrasts with a general community hospital.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/specialty-pharmacy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/specialty-pharmacy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/pharmacy-practice"/>
        <skos:notation>PP-PC-FM-010</skos:notation>
        <dcterms:identifier>PP-PC-FM-010</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Specialty Pharmacy</rdfs:label>
        <skos:definition xml:lang="en">A pharmacy service focused on dispensing and managing high-cost, complex medications requiring specialised handling, education, and monitoring.</skos:definition>
        <skos:hiddenLabel xml:lang="en">High-Cost Drug Pharmacy</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Specialised Pharmacy</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Specialty Pharmacy</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/dispensing-practice"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/specialty-pharmacy"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-ca4ded6c4a80</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: curated: review B: a dispensing service is care delivery, not formulary management</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/specialty-pharmacy"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/pharmacy-practice"/>
        <dcterms:identifier>HEO-L-edb1bc0846c7</dcterms:identifier>
        <linkRationale xml:lang="en">A pharmacy service within pharmacy practice, as for mail-order pharmacy</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/specialty-pharmacy"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/dispensing-practice"/>
        <dcterms:identifier>HEO-L-a87b13dda981</dcterms:identifier>
