    <!-- https://healtheconomics.wiki/concept/elastic-demand -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/elastic-demand">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/demand"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/demand"/>
        <skos:notation>HE-EE-ME-019</skos:notation>
        <dcterms:identifier>HE-EE-ME-019</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Varian 2014</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Elastic Demand</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A condition in which quantity demanded changes proportionally more than a given price change, indicating consumers are relatively sensitive to price.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Price-Sensitive Demand</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Responsive Demand</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Elastic Demand</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/inelastic-demand"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/elastic-demand"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/demand"/>
        <dcterms:identifier>HEO-L-5f54e965658b</dcterms:identifier>
        <linkRationale xml:lang="en">Elastic demand is demand whose responsiveness exceeds unity; it is a kind of demand, not a kind of elasticity measure</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/elastic-demand"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/inelastic-demand"/>
        <dcterms:identifier>HEO-L-82943549e820</dcterms:identifier>
        <linkRationale xml:lang="en">Elastic and inelastic demand are opposite cases; reverse link is in queue-r3-11, keep one direction at merge</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/elasticity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/elasticity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <skos:notation>HE-EE-ME-074</skos:notation>
        <dcterms:identifier>HE-EE-ME-074</dcterms:identifier>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Elasticity</rdfs:label>
        <skos:definition xml:lang="en">A measure of how strongly one economic quantity responds to a change in another, such as the responsiveness of quantity demanded to a change in price or income.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Economic Sensitivity</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Responsiveness Measure</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Elasticity</skos:prefLabel>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/demand"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/elasticity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-d2b0b37be59f</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Demand supply and markets in subdomain Economic Foundations</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/elasticity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isPropertyOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/demand"/>
        <dcterms:identifier>HEO-L-f51eb7d20673</dcterms:identifier>
        <linkRationale xml:lang="en">Elasticity is a characteristic describing how demand responds to price or income</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/electronic-health-record -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/electronic-health-record">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
