    <!-- https://healtheconomics.wiki/concept/expected-value -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/expected-value">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/mean"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q200125"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/mean"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/icer"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/variance"/>
        <skos:notation>HE-EM-DM-033</skos:notation>
        <dcterms:identifier>HE-EM-DM-033</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-03</dcterms:modified>
