        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cost-containment"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/volume-control"/>
        <skos:notation>HS-DC-DP-105</skos:notation>
        <dcterms:identifier>HS-DC-DP-105</dcterms:identifier>
        <dcterms:source>Musgrave &amp; Musgrave 1989</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Volume Cap</rdfs:label>
        <skos:definition xml:lang="en">A predetermined upper limit on the total quantity of a treatment a payer will reimburse within a defined period.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Quantity Cap</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Volume Ceiling</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Volume Cap</skos:prefLabel>
