    <!-- https://healtheconomics.wiki/concept/interrupted-time-series -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/interrupted-time-series">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/quasi-experimental-design"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/time-series-design"/>
