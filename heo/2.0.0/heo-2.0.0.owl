        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/variation"/>
        <skos:notation>HS-HP-HD-103</skos:notation>
        <dcterms:identifier>HS-HP-HD-103</dcterms:identifier>
        <dcterms:source>Wennberg &amp; Gittelsohn 1973</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Small Area Variation</rdfs:label>
        <skos:definition xml:lang="en">The phenomenon in which healthcare utilisation rates for the same condition differ substantially across small geographic areas, unexplained by population health need.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Geographic Variation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Regional Variation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Small Area Variation</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/warranted-variation"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/small-area-variation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/variation"/>
        <dcterms:identifier>HEO-L-e309d75f7e30</dcterms:identifier>
        <linkRationale xml:lang="en">Small area variation is differences across places, a form of variation.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/small-area-variation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/warranted-variation"/>
        <dcterms:identifier>HEO-L-a7c66591e8bb</dcterms:identifier>
        <linkRationale xml:lang="en">Variation unexplained by need contrasts with variation reflecting illness or preference.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/small-group-market -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/small-group-market">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:notation>HS-HP-HI-180</skos:notation>
        <dcterms:identifier>HS-HP-HI-180</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Small Group Market</rdfs:label>
        <skos:definition xml:lang="en">The insurance market segment serving employers below a defined size threshold, typically with specific protections such as guaranteed issue and limited rate variation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">SHOP Market</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Small Employer Market</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Small Group Market</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/individual-market"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/small-group-market"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-38206dae9122</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health Insurance: wiki topic Health financing and insurance sits in Health Systems; placed under Health Insurance, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/small-group-market"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <dcterms:identifier>HEO-L-a45cd0d2f038</dcterms:identifier>
        <linkRationale xml:lang="en">The small group market is one segment of the health insurance market (subject definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/small-group-market"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
