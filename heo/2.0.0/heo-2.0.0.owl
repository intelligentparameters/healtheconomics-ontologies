        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/hazard-rate"/>
        <dcterms:identifier>HEO-L-0eb4a1da482a</dcterms:identifier>
