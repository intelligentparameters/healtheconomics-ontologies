        <dcterms:identifier>HE-EM-DM-067</dcterms:identifier>
        <dcterms:source>Roberts et al. 2012</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Natural History Structure</rdfs:label>
        <skos:definition xml:lang="en">The representation within a model of how a disease progresses over time without intervention, including the timing of key clinical milestones.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Disease Course Model</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Natural History Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Natural History Structure</skos:prefLabel>
        <represents rdf:resource="https://healtheconomics.wiki/concept/disease-pathway"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
