    <!-- https://healtheconomics.wiki/concept/drug-interaction -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/drug-interaction">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q718753"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-PE-DT-015</skos:notation>
        <dcterms:identifier>HE-PE-DT-015</dcterms:identifier>
        <dcterms:source>Rowland &amp; Tozer 2010</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Drug Interaction</rdfs:label>
        <skos:definition xml:lang="en">An alteration in a drug&apos;s effect caused by another substance present at the same time, such as another medication, food, or supplement.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Concomitant Drug Effect</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Medicine Co-Effect</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Drug Interaction</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/adverse-drug-event"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/drug-interaction"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-5ed6af4e97a5</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Pharmacoeconomics &gt; Drug Therapy: dosing and treatment-line terms describe the clinical evidence and treatment pathways that models use</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/drug-interaction"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/adverse-drug-event"/>
        <dcterms:identifier>HEO-L-827d1e26b03c</dcterms:identifier>
        <linkRationale xml:lang="en">Interactions can cause harm from medicines; the interaction itself is not a pharmacovigilance activity</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


