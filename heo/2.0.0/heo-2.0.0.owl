    <!-- https://healtheconomics.wiki/concept/dominated-alternative -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/dominated-alternative">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <skos:notation>HE-EE-CEA-022</skos:notation>
        <dcterms:identifier>HE-EE-CEA-022</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Dominated Alternative</rdfs:label>
        <skos:altLabel xml:lang="en">Dominated Option</skos:altLabel>
        <skos:definition xml:lang="en">An intervention that is both more costly and less effective than another option, or a combination of options, and so should not be selected.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Inferior Alternative</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Dominated Alternative</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/non-dominated-alternative"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/dominated-alternative"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-2b41be1a758d</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Cost-Effectiveness Analysis: wiki topic Cost-effectiveness analysis sits in Economic Evaluation; placed under Cost-Effectiveness Analysis, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/dominated-alternative"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/non-dominated-alternative"/>
        <dcterms:identifier>HEO-L-c1836474c03b</dcterms:identifier>
        <linkRationale xml:lang="en">dominated and non-dominated options are the opposing frontier states</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


