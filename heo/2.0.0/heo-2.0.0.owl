    <!-- https://healtheconomics.wiki/concept/reinvestment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/reinvestment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:notation>HE-EE-EP-032</skos:notation>
        <dcterms:identifier>HE-EE-EP-032</dcterms:identifier>
        <dcterms:source>Brealey, Myers &amp; Allen 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Reinvestment</rdfs:label>
        <skos:definition xml:lang="en">The use of funds generated by an investment, such as returns or savings, to fund further investment rather than distributing them elsewhere.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Reallocation of Savings</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Savings Redirection</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Reinvestment</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/disinvestment"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/reinvestment"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-e07ab4b3576f</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Economic Policy: taxes, subsidies and other economic policy instruments are policy choices</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/reinvestment"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/disinvestment"/>
        <dcterms:identifier>HEO-L-64ff919674a2</dcterms:identifier>
        <linkRationale xml:lang="en">Reinvestment funds further activity while disinvestment withdraws funding; opposing resource moves.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/rejection-region -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/rejection-region">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/hypothesis-testing"/>
        <skos:notation>HE-ES-SA-179</skos:notation>
        <dcterms:identifier>HE-ES-SA-179</dcterms:identifier>
        <dcterms:source>Neyman &amp; Pearson 1933</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Rejection Region</rdfs:label>
        <skos:altLabel xml:lang="en">Critical Region</skos:altLabel>
        <skos:definition xml:lang="en">In hypothesis testing, the range of test statistic values for which the null hypothesis would be rejected in favour of the alternative.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Reject Zone</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Rejection Region</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/rejection-region"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-120cfd8fae89</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Statistical Analysis: catalogue subdomain Evidence Synthesis is one of the subdomains</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/rejection-region"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/hypothesis-testing"/>
        <dcterms:identifier>HEO-L-17622106876a</dcterms:identifier>
        <linkRationale xml:lang="en">The rejection region is a component of a hypothesis test, not a kind of hypothesis testing.</linkRationale>
