    <!-- https://healtheconomics.wiki/concept/contraindication -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/contraindication">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1848900"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <riskFactorFor rdf:resource="https://healtheconomics.wiki/concept/adverse-event"/>
        <skos:notation>HE-PE-DT-008</skos:notation>
        <dcterms:identifier>HE-PE-DT-008</dcterms:identifier>
        <dcterms:source>Katzung 2017</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Contraindication</rdfs:label>
        <skos:definition xml:lang="en">A specific patient condition or characteristic making a particular treatment inadvisable or potentially harmful for them to receive.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Do-Not-Use Condition</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Treatment Exclusion Criterion</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Contraindication</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/indication"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/treatment-selection"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/contraindication"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-49b7c827a613</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Pharmacoeconomics &gt; Drug Therapy: dosing and treatment-line terms describe the clinical evidence and treatment pathways that models use</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/contraindication"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#riskFactorFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/adverse-event"/>
        <dcterms:identifier>HEO-L-1ce5a17b0573</dcterms:identifier>
        <skos:editorialNote xml:lang="en">suggested source, not yet checked: European Commission 2009, Guideline on Summary of Product Characteristics rev 2 (s4.3)</skos:editorialNote>
        <linkRationale xml:lang="en">A contraindication is a situation where a medicine must not be given for safety reasons, i.e. raised harm risk</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
