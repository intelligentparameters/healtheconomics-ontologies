    <!-- https://healtheconomics.wiki/concept/deficit-reduction -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/deficit-reduction">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
