    <!-- https://healtheconomics.wiki/concept/akaike-information-criterion -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/akaike-information-criterion">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/model-validation"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1662573"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/model-validation"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/goodness-of-fit"/>
        <skos:notation>HE-EM-MV-002</skos:notation>
        <dcterms:identifier>HE-EM-MV-002</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Akaike 1974</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Akaike Information Criterion</rdfs:label>
        <owl:versionInfo>1.0.3</owl:versionInfo>
        <skos:altLabel xml:lang="en">AIC</skos:altLabel>
        <skos:altLabel xml:lang="en">Akaike Criterion</skos:altLabel>
        <skos:definition xml:lang="en">Akaike information criterion (AIC) is a statistic ranking models fitted to the same data, such as survival curves in HTA, by fit penalised per parameter.</skos:definition>
        <skos:prefLabel xml:lang="en">Akaike Information Criterion</skos:prefLabel>
        <abbreviation xml:lang="en">AIC</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/bayesian-information-criterion"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/likelihood-ratio-test"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-9"/>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/parametric-survival-model"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/model-selection"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/maximum-likelihood-estimation"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/akaike-information-criterion"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/model-validation"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-0866c4fd8048</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Model validation and calibration in subdomain Economic Modelling; placed under Model Validation, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/akaike-information-criterion"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
