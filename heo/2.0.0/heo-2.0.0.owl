    <!-- https://healtheconomics.wiki/concept/plausibility-assessment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/plausibility-assessment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/model-validation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/model-validation"/>
        <skos:notation>HE-EM-MV-059</skos:notation>
        <dcterms:identifier>HE-EM-MV-059</dcterms:identifier>
        <dcterms:source>Eddy DM, Hollingworth W, Caro JJ, et al. Model transparency and validation: a report of the ISPOR-SMDM Modeling Good Research Practices Task Force-7. Value in Health. 2012;15(6):843-850. doi:10.1016/j.jval.2012.04.012.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Plausibility Assessment</rdfs:label>
        <skos:definition xml:lang="en">An evaluation of whether a model&apos;s assumptions, structure, or results are reasonable given existing clinical and scientific knowledge, even without formal statistical testing.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Plausibility Check</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Sense-Check</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Plausibility Assessment</skos:prefLabel>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/clinical-plausibility"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
