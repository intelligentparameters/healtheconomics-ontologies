        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Extra Billing</skos:altLabel>
        <skos:definition xml:lang="en">Balance billing is a provider billing a patient for the gap between its full charge and the insurer&apos;s allowed amount, on top of normal cost sharing.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Provider Balance Charge</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Balance Billing</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/balance-billing-protection"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/out-of-pocket-cost"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/patient-responsibility"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/balance-billing"/>
