    <!-- https://healtheconomics.wiki/concept/cost-minimisation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cost-minimisation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-minimisation-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cost-minimisation-analysis"/>
        <skos:notation>HE-EE_EA-011</skos:notation>
        <dcterms:identifier>HE-EE_EA-011</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-21</dcterms:modified>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cost Minimisation</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Cost Minimization</skos:altLabel>
        <skos:definition xml:lang="en">An approach to selecting among interventions already shown to produce equivalent outcomes, in which the choice reduces to the lowest-cost option.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Least-Cost Selection</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cost Minimisation</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/output-maximisation"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cost-minimisation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-minimisation-analysis"/>
        <dcterms:identifier>HEO-L-6fc1edea485a</dcterms:identifier>
        <linkRationale xml:lang="en">Lowest-cost choice among equivalent options</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cost-minimisation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/output-maximisation"/>
        <dcterms:identifier>HEO-L-0c0d9fab9deb</dcterms:identifier>
        <linkRationale xml:lang="en">Dual objectives in production theory; symmetric pair kept on this side (reverse in r3-14 is the duplicate)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/cost-minimisation-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cost-minimisation-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-evaluation"/>
