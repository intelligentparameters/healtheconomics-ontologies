    <!-- https://healtheconomics.wiki/concept/value-based-healthcare -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/value-based-healthcare">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:notation>HS-NHS-VBH-031</skos:notation>
        <dcterms:identifier>HS-NHS-VBH-031</dcterms:identifier>
        <dcterms:source>Porter 2010</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Value-Based Healthcare</rdfs:label>
        <skos:altLabel xml:lang="en">VBHC</skos:altLabel>
        <skos:altLabel xml:lang="en">Value-Based Care</skos:altLabel>
        <skos:definition xml:lang="en">A framework organising delivery and payment around maximising health outcomes achieved for patients relative to cost, rather than service volume.</skos:definition>
        <skos:prefLabel xml:lang="en">Value-Based Healthcare</skos:prefLabel>
        <abbreviation xml:lang="en">VBHC</abbreviation>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/value-based-purchasing"/>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/high-value-care"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/value-based-healthcare"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <dcterms:identifier>HEO-L-ad14ff06a09a</dcterms:identifier>
        <linkRationale xml:lang="en">Value-based healthcare is a policy framework for organising delivery and payment.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/value-based-healthcare"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isFoundationFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/value-based-purchasing"/>
        <dcterms:identifier>HEO-L-5a4e9a582547</dcterms:identifier>
        <linkRationale xml:lang="en">Value-based purchasing builds on value-based healthcare.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
