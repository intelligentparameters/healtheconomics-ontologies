    <!-- https://healtheconomics.wiki/concept/opt-out-option -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/opt-out-option">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/choice-set"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/discrete-choice-experiment"/>
        <skos:notation>HE-EE-CBA-037</skos:notation>
        <dcterms:identifier>HE-EE-CBA-037</dcterms:identifier>
        <dcterms:source>Louviere, Hensher &amp; Swait 2000</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Opt-Out Option</rdfs:label>
        <skos:definition xml:lang="en">An alternative in a discrete choice experiment letting respondents select neither presented option, representing a choice to keep current circumstances.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Presumed Consent</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Opt-Out Option</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/status-quo-option"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/opt-out-option"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-c62cdc2ada97</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Cost-Benefit Analysis: the unplaced concepts here are stated preference terms; the wiki&apos;s topic Stated preference and monetary valuation sits in Outcomes</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/opt-out-option"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/choice-set"/>
        <dcterms:identifier>HEO-L-b465c3943891</dcterms:identifier>
        <linkRationale xml:lang="en">An opt-out is one alternative within a DCE choice set</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/opt-out-option"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/discrete-choice-experiment"/>
        <dcterms:identifier>HEO-L-8f0668806dcd</dcterms:identifier>
        <linkRationale xml:lang="en">An opt-out option is a design element of a DCE choice set, not a nudge or choice architecture intervention</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/opt-out-option"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
