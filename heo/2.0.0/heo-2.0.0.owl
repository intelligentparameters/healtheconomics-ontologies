        <dcterms:identifier>HE-EE_EA-031</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-24</dcterms:modified>
        <dcterms:source>Brealey, Myers &amp; Allen 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Liquidity Ratio</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A liquidity ratio is a financial measure comparing an organisation’s readily available or current assets with its near-term obligations to assess its capacity to meet payments as they fall due.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cash Position Ratio</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Short-Term Liquidity Measure</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Liquidity Ratio</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-4"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/liquidity-ratio"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/financial-ratio"/>
        <dcterms:identifier>HEO-L-98a0d297b19f</dcterms:identifier>
        <linkRationale xml:lang="en">A liquidity ratio is a financial statement ratio assessing liquidity, per the object definition</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
