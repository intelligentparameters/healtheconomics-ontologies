        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">External Validity Assessment</rdfs:label>
        <skos:definition xml:lang="en">The formal process of testing whether a model&apos;s predictions match independent, real-world data not used in its original construction.</skos:definition>
        <skos:hiddenLabel xml:lang="en">External Validation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Independent-Data Validation</skos:hiddenLabel>
