        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/sheffield-elicitation-framework"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/structured-expert-judgment"/>
        <dcterms:identifier>HEO-L-c2fe0276c41c</dcterms:identifier>
        <skos:editorialNote xml:lang="en">suggested source, not yet checked: O&apos;Hagan et al. 2006</skos:editorialNote>
        <linkRationale xml:lang="en">Loop resolved; SHELF is one structured protocol for expert judgement, so a subtype</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


