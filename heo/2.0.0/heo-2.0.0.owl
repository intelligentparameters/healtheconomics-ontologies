    <!-- https://healtheconomics.wiki/concept/discriminant-validity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/discriminant-validity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/construct-validity"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q168554"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/construct-validity"/>
        <skos:notation>HE-ES-EA-012</skos:notation>
        <dcterms:identifier>HE-ES-EA-012</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-02</dcterms:modified>
        <dcterms:source>Campbell &amp; Fiske 1959</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Discriminant Validity</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Divergent Validity</skos:altLabel>
        <skos:definition xml:lang="en">Discriminant validity is evidence that a health measure correlates less with measures of other constructs than with its own, as predicted in advance.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Discriminant Construct Validity</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Discriminant Validity</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-4"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/discriminant-validity"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/construct-validity"/>
        <dcterms:identifier>HEO-L-6f7fb82d4d3c</dcterms:identifier>
        <linkRationale xml:lang="en">discriminant validity is a form of construct validity</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/discrimination -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/discrimination">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
