        <skos:altLabel xml:lang="en">SWOT</skos:altLabel>
        <skos:altLabel xml:lang="en">Strengths-Weaknesses-Opportunities-Threats</skos:altLabel>
        <skos:definition xml:lang="en">A strategic planning framework structuring an evaluation of internal strengths and weaknesses alongside external opportunities and threats.</skos:definition>
        <skos:prefLabel xml:lang="en">SWOT Analysis</skos:prefLabel>
        <abbreviation xml:lang="en">SWOT</abbreviation>
        <informs rdf:resource="https://healtheconomics.wiki/concept/health-system-strengthening"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/market-access-strategy"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/swot-analysis"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-a3a560995c1f</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Systems Strengthening: organisation and delivery of care is the Health Systems subdomain (Organisation and governance)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/swot-analysis"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
