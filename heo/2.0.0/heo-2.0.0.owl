    <!-- https://healtheconomics.wiki/concept/overall-survival -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/overall-survival">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/relative-survival"/>
        <skos:notation>HE-PE-OO-014</skos:notation>
        <dcterms:identifier>HE-PE-OO-014</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Latimer 2013</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Overall Survival</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">OS</skos:altLabel>
        <skos:definition xml:lang="en">Overall survival is the time from a prespecified origin, such as randomization, diagnosis, or treatment initiation, until death from any cause, with participants not known to have died censored at their last date known alive.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Total Survival</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Overall Survival</skos:prefLabel>
        <abbreviation xml:lang="en">OS</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/progression-free-survival"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/outcomes#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/overall-survival"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome"/>
        <dcterms:identifier>HEO-L-88b30d7d9098</dcterms:identifier>
        <linkRationale xml:lang="en">Survival is a clinical outcome (object definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/overall-survival"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/relative-survival"/>
        <dcterms:identifier>HEO-L-a04002d78f9b</dcterms:identifier>
        <linkRationale xml:lang="en">Relative survival is observed all-cause survival divided by expected survival</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
