    <!-- https://healtheconomics.wiki/concept/responder-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/responder-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/treatment-response"/>
        <skos:notation>HE-ES-SA-183</skos:notation>
        <dcterms:identifier>HE-ES-SA-183</dcterms:identifier>
        <dcterms:source>Jaeschke, Singer &amp; Guyatt 1989</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Responder Analysis</rdfs:label>
        <skos:definition xml:lang="en">An analysis classifying each patient as a responder or non-responder based on a predefined improvement threshold, reporting the responder proportion.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Responder-Based Analysis</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Response Rate Analysis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Responder Analysis</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/responder-definition"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/responder-analysis"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-056e8f249601</dcterms:identifier>
