        <dcterms:identifier>HEO-L-b870c3b12fab</dcterms:identifier>
        <linkRationale xml:lang="en">Surrogate data on trial effects are clinical evidence.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
