    <!-- https://healtheconomics.wiki/concept/optimal-sample-size -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/optimal-sample-size">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/value-of-information"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/value-of-information"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/optimal-study-design"/>
        <skos:notation>HE-EM-VI-007</skos:notation>
        <dcterms:identifier>HE-EM-VI-007</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Ades, Lu &amp; Claxton 2004</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Optimal Sample Size</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A study sample size selected to meet a stated design objective, such as adequate power or precision, or to maximise the expected value of information after accounting for research costs and decision delays.</skos:definition>
        <skos:hiddenLabel xml:lang="en">ENBS-Based Sample Size</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Efficient Sample Size Choice</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Optimal Sample Size</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-11"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/optimal-sample-size"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/value-of-information"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-18c0a96a5958</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Value of information in subdomain Economic Modelling; placed under Value of Information, the concept named by its wiki topic</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/optimal-sample-size"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/optimal-study-design"/>
        <dcterms:identifier>HEO-L-be7b5ab7413b</dcterms:identifier>
        <linkRationale xml:lang="en">The object definition lists sample size among the characteristics that make up the optimal design</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/optimal-study-design -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/optimal-study-design">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/study-design"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/study-design"/>
        <skos:notation>HE-EM-VI-023</skos:notation>
        <dcterms:identifier>HE-EM-VI-023</dcterms:identifier>
        <dcterms:source>Ades, Lu &amp; Claxton 2004</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Optimal Study Design</rdfs:label>
        <skos:definition xml:lang="en">The combination of research characteristics, such as sample size and follow-up duration, that maximises the expected net benefit of sampling for a budget.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Efficient Research Design</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Study Design Optimisation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">VOI-Optimal Design</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Optimal Study Design</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/research-prioritisation"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/optimal-study-design"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/study-design"/>
        <dcterms:identifier>HEO-L-97acc285b9f5</dcterms:identifier>
        <linkRationale xml:lang="en">Optimal study design is a study design chosen by value of information</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/optimal-study-design"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/research-prioritisation"/>
        <dcterms:identifier>HEO-L-7b18ded479dd</dcterms:identifier>
        <linkRationale xml:lang="en">Expected net benefit of sampling identifies which research is worth funding</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
