    <!-- https://healtheconomics.wiki/concept/absolute-measure -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/absolute-measure">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/effect-size"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/effect-size"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/treatment-effect"/>
        <skos:notation>HE-ES-RM-001</skos:notation>
        <dcterms:identifier>HE-ES-RM-001</dcterms:identifier>
        <dcterms:source>Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams &amp; Wilkins; 2008.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Absolute Effect Measure</rdfs:label>
        <skos:definition xml:lang="en">A measure of effect expressed as the actual difference between two groups, such as absolute risk reduction, rather than as a ratio.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Absolute Difference</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Arithmetic Effect Difference</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Absolute Effect Measure</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/relative-measure"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/absolute-measure"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/effect-size"/>
        <dcterms:identifier>HEO-L-0dfdb2c6b88a</dcterms:identifier>
        <linkRationale xml:lang="en">A difference measure such as ARR is one way of expressing effect size</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/absolute-measure"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
