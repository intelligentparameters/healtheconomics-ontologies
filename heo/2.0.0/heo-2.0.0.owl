        <dcterms:identifier>HS-NHS-HQ-072</dcterms:identifier>
        <dcterms:source>National Quality Forum, Serious Reportable Events</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Serious Reportable Event</rdfs:label>
        <skos:altLabel xml:lang="en">SRE</skos:altLabel>
        <skos:definition xml:lang="en">A formally catalogued category of serious, largely preventable safety events, such as wrong-site surgery, identified for standardised public reporting.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Reportable Safety Event</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Serious Reportable Event</skos:prefLabel>
        <abbreviation xml:lang="en">SRE</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/sentinel-event"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/serious-reportable-event"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/adverse-event"/>
        <dcterms:identifier>HEO-L-5801173cf856</dcterms:identifier>
        <linkRationale xml:lang="en">A serious reportable event is an injury caused by care, an adverse event.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
