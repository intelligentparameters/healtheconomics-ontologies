    <!-- https://healtheconomics.wiki/concept/externality-correction -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/externality-correction">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-policy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/economic-policy"/>
        <skos:notation>HE-EE-WE-009</skos:notation>
        <dcterms:identifier>HE-EE-WE-009</dcterms:identifier>
        <dcterms:source>Pigou 1920</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Externality Correction</rdfs:label>
        <skos:definition xml:lang="en">A policy intervention, such as a Pigouvian tax or subsidy, intended to align private incentives with the true social cost or benefit of an activity.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Corrective Intervention</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Externality Internalisation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Externality Correction</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/externality"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/externality-correction"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-policy"/>
        <dcterms:identifier>HEO-L-6107690db92d</dcterms:identifier>
        <linkRationale xml:lang="en">A Pigouvian tax or subsidy is an economic policy for any externality, not specifically a health policy</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/externality-correction"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/externality"/>
        <dcterms:identifier>HEO-L-4ad9c67acfd7</dcterms:identifier>
        <linkRationale xml:lang="en">The correction internalises the external cost</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


