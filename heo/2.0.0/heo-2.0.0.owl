    <!-- https://healtheconomics.wiki/concept/administrative-censoring -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/administrative-censoring">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/right-censoring"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/right-censoring"/>
        <skos:notation>HE-ES-CTM-003</skos:notation>
        <dcterms:identifier>HE-ES-CTM-003</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Kalbfleisch &amp; Prentice 2002</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Administrative Censoring</rdfs:label>
        <owl:versionInfo>1.0.7</owl:versionInfo>
        <skos:definition xml:lang="en">Administrative censoring is right censoring that occurs when a trial&apos;s planned end of follow-up or data cut-off arrives before a patient has the event.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Administrative Right Censoring</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">End-of-Study Censoring</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Administrative Censoring</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/dependent-censoring"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/administrative-censoring"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/right-censoring"/>
        <dcterms:identifier>HEO-L-e7c3f43e8247</dcterms:identifier>
        <linkRationale xml:lang="en">Follow-up ends before the event (subject definition)</linkRationale>
