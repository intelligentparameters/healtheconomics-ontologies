    <!-- https://healtheconomics.wiki/concept/minor-consent -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/minor-consent">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
