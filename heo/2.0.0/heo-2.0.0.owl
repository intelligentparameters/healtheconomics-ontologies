    <!-- https://healtheconomics.wiki/concept/pregnant-women-research -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/pregnant-women-research">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
