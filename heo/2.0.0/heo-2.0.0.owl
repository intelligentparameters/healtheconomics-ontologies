    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/horizontally-integrated -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/horizontally-integrated">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/integrated-care"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/integrated-care"/>
        <skos:notation>HS-HP-IC-020</skos:notation>
        <dcterms:identifier>HS-HP-IC-020</dcterms:identifier>
        <dcterms:source>Kongstvedt 2012</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Horizontally Integrated</rdfs:label>
        <skos:altLabel xml:lang="en">Horizontal Integration</skos:altLabel>
        <skos:definition xml:lang="en">A structure in which multiple organisations providing the same service type, such as several hospitals, combine under common ownership.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Same-Level Integration</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Horizontally Integrated</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/vertically-integrated"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/horizontally-integrated"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/integrated-care"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-596c0453ca90</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Integrated Care: organisation and delivery of care is the Health Systems subdomain (Organisation and governance); placed under Integrated Care, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/horizontally-integrated"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
