    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/assignment-of-benefits -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/assignment-of-benefits">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:notation>HS-HP-HI-013</skos:notation>
        <dcterms:identifier>HS-HP-HI-013</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Assignment of Benefits</rdfs:label>
        <skos:altLabel xml:lang="en">AOB</skos:altLabel>
        <skos:altLabel xml:lang="en">Benefits Assignment</skos:altLabel>
        <skos:definition xml:lang="en">An arrangement in which a patient authorises their insurer to pay a provider directly for covered services, rather than reimbursing the patient.</skos:definition>
        <skos:prefLabel xml:lang="en">Assignment of Benefits</skos:prefLabel>
        <abbreviation xml:lang="en">AOB</abbreviation>
        <modifies rdf:resource="https://healtheconomics.wiki/concept/reimbursement"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/assignment-of-benefits"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-3b3e3e5d489f</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health Insurance: wiki topic Health financing and insurance sits in Health Systems; placed under Health Insurance, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/assignment-of-benefits"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#modifies"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/reimbursement"/>
        <dcterms:identifier>HEO-L-8f16a7189704</dcterms:identifier>
        <linkRationale xml:lang="en">Assignment redirects the insurer reimbursement to the provider instead of the patient; it gives no information to provider payment</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


