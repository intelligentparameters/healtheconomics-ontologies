    <!-- https://healtheconomics.wiki/concept/deficit -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/deficit">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <skos:notation>HS-HP-HF-014</skos:notation>
        <dcterms:identifier>HS-HP-HF-014</dcterms:identifier>
        <dcterms:source>Musgrave &amp; Musgrave 1989</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Deficit</rdfs:label>
        <skos:definition xml:lang="en">A shortfall occurring when spending exceeds available revenue within a budget period, requiring borrowing, reserve depletion, or subsequent cuts.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Fiscal Shortfall</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Spending Shortfall</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Deficit</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/fiscal-sustainability"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/deficit"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-289d6c0205ec</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health Financing: wiki topic Health financing and insurance sits in Health Systems; placed under Health System Financing, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/deficit"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/fiscal-sustainability"/>
        <dcterms:identifier>HEO-L-b9d4f817f68a</dcterms:identifier>
        <linkRationale xml:lang="en">Spending above revenue requires borrowing or cuts, weakening sustainability</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
