    <!-- https://healtheconomics.wiki/concept/dose-capping -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/dose-capping">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/managed-entry-agreement"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/treatment-capping"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/managed-entry-agreement"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/treatment-capping"/>
        <skos:notation>HS-DC-DP-024</skos:notation>
        <dcterms:identifier>HS-DC-DP-024</dcterms:identifier>
        <dcterms:source>Carlson JJ, Sullivan SD, Garrison LP, Neumann PJ, Veenstra DL. Linking payment to health outcomes: a taxonomy and examination of performance-based reimbursement schemes. Health Policy. 2010;96(3):179-190.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Dose Capping</rdfs:label>
        <skos:altLabel xml:lang="en">Dose Cap</skos:altLabel>
        <skos:definition xml:lang="en">A pricing arrangement limiting total payment owed for a treatment regardless of actual dose administered, often used for weight-based dosing.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Payment Cap</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Dose Capping</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/drug-cost"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/dose-capping"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/managed-entry-agreement"/>
        <dcterms:identifier>HEO-L-66204e89648f</dcterms:identifier>
        <linkRationale xml:lang="en">dose capping is a managed entry arrangement on price</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/dose-capping"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/treatment-capping"/>
        <dcterms:identifier>HEO-L-b18be5772a8b</dcterms:identifier>
        <linkRationale xml:lang="en">Treatment Capping covers limits by dose, per its definition</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/dose-capping"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-cost"/>
        <dcterms:identifier>HEO-L-eb92112daad4</dcterms:identifier>
        <linkRationale xml:lang="en">capping payment regardless of dose lowers drug cost to the payer</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/dose-delay -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/dose-delay">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-PE-DT-010</skos:notation>
        <dcterms:identifier>HE-PE-DT-010</dcterms:identifier>
        <dcterms:source>DeVita, Lawrence &amp; Rosenberg 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Dose Delay</rdfs:label>
        <skos:definition xml:lang="en">A postponement of a scheduled treatment dose, typically due to toxicity, patient scheduling constraints, or other clinical considerations.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Delayed Dosing</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Treatment Postponement</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Dose Delay</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/dose-reduction"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/dose-intensity"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/dose-delay"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-f37691885227</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Pharmacoeconomics &gt; Drug Therapy: dosing and treatment-line terms describe the clinical evidence and treatment pathways that models use</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/dose-delay"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/dose-reduction"/>
        <dcterms:identifier>HEO-L-516daa268ae3</dcterms:identifier>
        <linkRationale xml:lang="en">delaying and reducing doses are alternative toxicity responses</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/dose-delay"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/dose-intensity"/>
        <dcterms:identifier>HEO-L-bf04ebecde15</dcterms:identifier>
        <linkRationale xml:lang="en">delays lengthen the interval, lowering dose per unit time</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/dose-escalation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/dose-escalation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-development"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/drug-development"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/dose-finding"/>
        <skos:notation>HE-PE-DD-013</skos:notation>
        <dcterms:identifier>HE-PE-DD-013</dcterms:identifier>
        <dcterms:source>Le Tourneau, Lee &amp; Siu 2009</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Dose Escalation</rdfs:label>
        <skos:definition xml:lang="en">A structured early-phase process progressively increasing an investigational treatment&apos;s dose across successive small groups to identify the maximum tolerated dose.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Dose-Escalation Study</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Escalation Phase</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Dose Escalation</skos:prefLabel>
        <produces rdf:resource="https://healtheconomics.wiki/concept/maximum-tolerated-dose"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/recommended-phase-2-dose"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/dose-limiting-toxicity"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/dose-escalation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-development"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-0486378eb2db</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Pharmacoeconomics &gt; Drug Development: wiki topic Drug development and regulation sits in Health Policy; placed under Drug Development, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/dose-escalation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/dose-finding"/>
        <dcterms:identifier>HEO-L-64ea728668f7</dcterms:identifier>
        <linkRationale xml:lang="en">Escalation across cohorts is the stage of dose finding that locates the maximum tolerated dose</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/dose-escalation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#produces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/maximum-tolerated-dose"/>
        <dcterms:identifier>HEO-L-eebebee9aa0a</dcterms:identifier>
        <linkRationale xml:lang="en">escalation is the process whose output is the MTD, per its definition; not a causal driver</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/dose-escalation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#produces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/recommended-phase-2-dose"/>
        <dcterms:identifier>HEO-L-72162403ff7b</dcterms:identifier>
        <linkRationale xml:lang="en">phase I escalation yields the recommended phase 2 dose</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/dose-escalation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/dose-limiting-toxicity"/>
        <dcterms:identifier>HEO-L-502bbc381e5a</dcterms:identifier>
