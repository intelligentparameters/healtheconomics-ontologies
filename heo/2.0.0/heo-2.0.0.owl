    <!-- https://healtheconomics.wiki/concept/production-possibility-frontier -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/production-possibility-frontier">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q376791"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <skos:notation>HE-EE_EA-043</skos:notation>
        <dcterms:identifier>HE-EE_EA-043</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Varian 2014</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Production Possibility Frontier</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">PPF</skos:altLabel>
        <skos:altLabel xml:lang="en">Production Possibility Curve</skos:altLabel>
        <skos:definition xml:lang="en">A graph showing the maximum combinations of two goods or outcomes producible given a fixed set of resources and existing technology.</skos:definition>
        <skos:prefLabel xml:lang="en">Production Possibility Frontier</skos:prefLabel>
        <abbreviation xml:lang="en">PPF</abbreviation>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/allocative-efficiency"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/productive-efficiency"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/production-possibility-frontier"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-44c879d269db</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Scarcity choice and opportunity cost in subdomain Economic Foundations</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/production-possibility-frontier"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isFoundationFor"/>
