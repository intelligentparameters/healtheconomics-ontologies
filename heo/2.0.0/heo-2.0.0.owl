        <measures rdf:resource="https://healtheconomics.wiki/concept/resource-use"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/cost-analysis"/>
        <precedes rdf:resource="https://healtheconomics.wiki/concept/cost-valuation"/>
        <skos:notation>HE-EE-RM-001</skos:notation>
        <dcterms:identifier>HE-EE-RM-001</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</dcterms:modified>
        <dcterms:source>Špacírová et al. 2020</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cost Measurement</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Cost measurement is the step in economic evaluation that counts the resources each alternative uses, such as GP visits or bed-days, before they are valued.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cost Quantification</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Resource Costing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cost Measurement</skos:prefLabel>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cost-measurement"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/resource-measurement"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-4093a1cdcfb6</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Resource Measurement: measuring resource use is the first step of costing; placed under Resource Measurement, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cost-measurement"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
