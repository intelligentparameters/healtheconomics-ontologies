    <!-- https://healtheconomics.wiki/concept/equitable-access -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/equitable-access">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/access-to-care"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/access-to-care"/>
        <skos:notation>HS-HP-HE-013</skos:notation>
        <dcterms:identifier>HS-HP-HE-013</dcterms:identifier>
        <dcterms:source>Whitehead 1992</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Equitable Access</rdfs:label>
        <skos:altLabel xml:lang="en">Equitable Healthcare Access</skos:altLabel>
        <skos:definition xml:lang="en">A state where individuals have a fair opportunity to obtain needed healthcare regardless of income, geography, or ethnicity irrelevant to clinical need.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Fair Access</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Equitable Access</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/health-equity"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/equitable-access"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/access-to-care"/>
        <dcterms:identifier>HEO-L-e32e4fbb3ba5</dcterms:identifier>
        <linkRationale xml:lang="en">Equitable access is access to care distributed fairly</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/equitable-access"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-equity"/>
        <dcterms:identifier>HEO-L-87fe3671b060</dcterms:identifier>
        <linkRationale xml:lang="en">Fair access to needed care is one driver of health equity</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/equity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/equity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q2346517"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:notation>HE-EE-WE-007</skos:notation>
        <dcterms:identifier>HE-EE-WE-007</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Whitehead 1992</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Equity</rdfs:label>
        <owl:versionInfo>1.0.21</owl:versionInfo>
        <skos:definition xml:lang="en">Equity is fairness in how health, healthcare and its financing are distributed: equal treatment for equal need, and appropriately more for greater need.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Distributional Fairness</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Fairness Principle</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Equity</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/efficiency"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/health-inequity"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/equity-criterion"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/equity-efficiency-trade-off"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/equity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-2d19df38ae4f</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: curated: the wiki topic Equity and inequality sits in Health Policy, review B</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/equity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/efficiency"/>
        <dcterms:identifier>HEO-L-75c3eb1683d1</dcterms:identifier>
        <linkRationale xml:lang="en">Equity and efficiency are the two standard competing objectives in health economics</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
