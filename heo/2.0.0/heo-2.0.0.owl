        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/feedback-intervention"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/implementation-strategy"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/quality-improvement"/>
        <skos:notation>HS-HP-SS-004</skos:notation>
        <dcterms:identifier>HS-HP-SS-004</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Ivers et al. 2026</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Audit and Feedback</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">A&amp;F</skos:altLabel>
        <skos:definition xml:lang="en">Audit and feedback (A&amp;F) is a quality improvement strategy that measures clinicians&apos; practice against a target and returns the results to prompt change.</skos:definition>
