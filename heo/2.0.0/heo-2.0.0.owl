    <!-- https://healtheconomics.wiki/concept/transaction-cost -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/transaction-cost">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q877496"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <skos:notation>HS-HP-CRE-001</skos:notation>
        <dcterms:identifier>HS-HP-CRE-001</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-03</dcterms:modified>
        <dcterms:source>Marini &amp; Street 2006</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Transaction Cost</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">A transaction cost is the cost of finding, negotiating, monitoring and enforcing an exchange, such as a health service contract, beyond the price paid.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Exchange Cost</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Transacting Cost</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Transaction Cost</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/market-failure"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/transaction-cost"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <dcterms:identifier>HEO-L-eece0b20c1e2</dcterms:identifier>
        <linkRationale xml:lang="en">A transaction cost is a resource cost of exchange, so it is a kind of cost.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/transaction-cost"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/market-failure"/>
        <dcterms:identifier>HEO-L-a451bb9dced0</dcterms:identifier>
        <linkRationale xml:lang="en">Coase: costs of finding, negotiating and enforcing exchanges can stop efficient markets forming.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/transcription-error -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/transcription-error">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-DS-BV-038</skos:notation>
        <dcterms:identifier>HE-DS-BV-038</dcterms:identifier>
        <dcterms:source>Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams &amp; Wilkins; 2008.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Transcription Error</rdfs:label>
        <skos:altLabel xml:lang="en">Data Entry Error</skos:altLabel>
        <skos:definition xml:lang="en">A mistake introduced when data are copied or transferred from one format or source to another, such as paper to electronic record.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Copying Error</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Input Error</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Keying Error</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Recording Error</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Transcription Error</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/measurement-error"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/data-accuracy"/>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/data-quality"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/transcription-error"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-c8e1860b696f</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Bias &amp; Validity: catalogue subdomain Evidence Synthesis is one of the subdomains</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/transcription-error"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/measurement-error"/>
        <dcterms:identifier>HEO-L-c0f494e3400c</dcterms:identifier>
        <linkRationale xml:lang="en">Copying errors create a gap between the recorded and true value, which is measurement error by definition.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/transcription-error"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#threatensValidityOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/data-accuracy"/>
        <dcterms:identifier>HEO-L-8ec6b749b73c</dcterms:identifier>
        <linkRationale xml:lang="en">Copying errors make recorded values wrong; coding accuracy is accuracy of one kind of recorded data.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/transcription-error"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#threatensValidityOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/data-quality"/>
        <dcterms:identifier>HEO-L-3a2817e316d8</dcterms:identifier>
