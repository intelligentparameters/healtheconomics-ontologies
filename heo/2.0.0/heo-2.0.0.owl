    <!-- https://healtheconomics.wiki/concept/tender-based-pricing -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/tender-based-pricing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
