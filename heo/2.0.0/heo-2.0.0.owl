    <!-- https://healtheconomics.wiki/concept/early-access-scheme -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/early-access-scheme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-development"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/drug-development"/>
        <skos:notation>HS-DC-DP-028</skos:notation>
        <dcterms:identifier>HS-DC-DP-028</dcterms:identifier>
        <dcterms:source>MHRA, Early Access to Medicines Scheme</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Early Access Scheme</rdfs:label>
        <skos:altLabel xml:lang="en">Early Access Programme</skos:altLabel>
        <skos:definition xml:lang="en">A regulatory programme letting patients with a life-threatening condition access a promising unlicensed medicine before full marketing authorisation, based on preliminary evidence.</skos:definition>
        <skos:hiddenLabel xml:lang="en">EAMS</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Pre-Approval Access Scheme</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Early Access Scheme</skos:prefLabel>
        <counterpartOf rdf:resource="https://healtheconomics.wiki/concept/special-access-scheme"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/early-access-scheme"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-development"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-371bb1d8f3b7</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: curated: review B: early access is a regulatory scheme, not drug pricing</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/early-access-scheme"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#counterpartOf"/>
