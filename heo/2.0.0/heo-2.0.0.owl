    <!-- https://healtheconomics.wiki/concept/ethical-feasibility -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/ethical-feasibility">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
