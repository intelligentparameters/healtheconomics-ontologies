        <skos:altLabel xml:lang="en">Area-Under-Curve Model</skos:altLabel>
        <skos:altLabel xml:lang="en">PartSA Model</skos:altLabel>
        <skos:definition xml:lang="en">A partitioned survival model is a cancer economic model that uses PFS and OS curves to split a cohort into progression-free, progressed and dead states.</skos:definition>
        <skos:prefLabel xml:lang="en">Partitioned Survival Model</skos:prefLabel>
        <abbreviation xml:lang="en">PartSA Model</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/state-transition-model"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-6"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/area-under-curve-approach"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/extrapolation"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/health-state-utility-value"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/overall-survival"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/parametric-survival-model"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/progression-free-survival"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/survival-analysis"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/partitioned-survival-model"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
