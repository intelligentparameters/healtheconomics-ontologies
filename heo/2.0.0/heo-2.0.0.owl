    <!-- https://healtheconomics.wiki/concept/coding-accuracy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/coding-accuracy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/data-accuracy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/data-accuracy"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/coding-compliance"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/revenue-management-hospital"/>
        <skos:notation>HS-HP-HSR-011</skos:notation>
        <dcterms:identifier>HS-HP-HSR-011</dcterms:identifier>
        <dcterms:source>OIG, Compliance Program Guidance</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Coding Accuracy</rdfs:label>
        <skos:definition xml:lang="en">The degree to which diagnosis and procedure codes assigned to a patient encounter correctly reflect the clinical care actually documented.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Code-Assignment Accuracy</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Coding Correctness</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Coding Accuracy</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/coding-accuracy"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/data-accuracy"/>
        <dcterms:identifier>HEO-L-07154a1842a7</dcterms:identifier>
        <linkRationale xml:lang="en">Copying errors make recorded values wrong; coding accuracy is accuracy of one kind of recorded data.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/coding-accuracy"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/coding-compliance"/>
        <dcterms:identifier>HEO-L-9e28c70c6871</dcterms:identifier>
        <linkRationale xml:lang="en">Accurate coding is one component of coding compliance; accuracy is not an instrument</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
