    <!-- https://healtheconomics.wiki/concept/cost-outlier -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cost-outlier">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <skos:notation>HS-HP-PP-034</skos:notation>
        <dcterms:identifier>HS-HP-PP-034</dcterms:identifier>
        <dcterms:source>Fetter et al. 1980</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cost Outlier</rdfs:label>
        <skos:definition xml:lang="en">A case whose actual treatment cost substantially exceeds what standard diagnosis-related group payment would expect, triggering additional supplemental payment.</skos:definition>
        <skos:hiddenLabel xml:lang="en">High-Cost Case</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Outlier Case</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cost Outlier</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/day-outlier"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/outlier-payment"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cost-outlier"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
