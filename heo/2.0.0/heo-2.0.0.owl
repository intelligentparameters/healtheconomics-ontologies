        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/geographic-access"/>
        <skos:notation>HS-HP-HE-027</skos:notation>
        <dcterms:identifier>HS-HP-HE-027</dcterms:identifier>
        <dcterms:source>Penchansky R, Thomas JW. The concept of access: definition and relationship to consumer satisfaction. Medical Care. 1981;19(2):127-140. doi:10.1097/00005650-198102000-00001.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Rural Access</rdfs:label>
        <skos:altLabel xml:lang="en">Rural Healthcare Access</skos:altLabel>
        <skos:definition xml:lang="en">A healthcare access dimension concerning the particular challenges of obtaining care in rural or remote areas, often greater distances and thinner supply.</skos:definition>
