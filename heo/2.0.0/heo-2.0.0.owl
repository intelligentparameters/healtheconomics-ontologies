    <!-- https://healtheconomics.wiki/concept/allowed-amount -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/allowed-amount">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
