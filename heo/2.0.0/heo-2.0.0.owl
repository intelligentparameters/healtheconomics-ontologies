    <!-- https://healtheconomics.wiki/concept/prime-designation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/prime-designation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
