    <!-- https://healtheconomics.wiki/concept/transferability -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/transferability">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/generalizability"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/generalizability"/>
        <skos:notation>HE-ES-EA-041</skos:notation>
        <dcterms:identifier>HE-ES-EA-041</dcterms:identifier>
        <dcterms:source>Welte et al. 2004</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Transferability</rdfs:label>
        <skos:definition xml:lang="en">The extent to which research findings generated in one setting or population can be validly applied to inform decisions elsewhere.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cross-Setting Applicability</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Portability of Findings</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Transferability</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/adaptation"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/contextualization"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/transferability"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/generalizability"/>
        <dcterms:identifier>HEO-L-c5dc0a405421</dcterms:identifier>
        <linkRationale xml:lang="en">Transferability is generalisability of findings to another setting or population.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/transferability"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/adaptation"/>
        <dcterms:identifier>HEO-L-31f9a5a96a1d</dcterms:identifier>
        <linkRationale xml:lang="en">How far findings transfer determines whether and how an evaluation is adapted to a new setting.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/transferability"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/contextualization"/>
        <dcterms:identifier>HEO-L-d7f6bf9d05f9</dcterms:identifier>
        <linkRationale xml:lang="en">Transferability judgements feed the interpretation of external evidence for a local decision.</linkRationale>
