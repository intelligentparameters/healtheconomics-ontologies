        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A near miss rate is the number of events meeting a specified near-miss definition relative to a matching population or set of opportunities during a stated period, expressed on an explicit scale.</skos:definition>
