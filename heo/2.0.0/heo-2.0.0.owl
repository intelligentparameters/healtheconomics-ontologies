        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Casemix Weight</skos:altLabel>
        <skos:definition xml:lang="en">A numerical value assigned to a payment classification, such as a diagnosis-related group, reflecting its expected resource intensity relative to average.</skos:definition>
