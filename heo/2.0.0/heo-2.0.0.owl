    <!-- https://healtheconomics.wiki/concept/cure-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cure-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
