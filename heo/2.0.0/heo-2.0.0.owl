        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Sonnenberg FA, Beck JR. Markov models in medical decision making: a practical guide. Medical Decision Making. 1993;13(4):322?338. doi:10.1177/0272989X9301300409.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Time-Inhomogeneous Model</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Non-Stationary Model</skos:altLabel>
        <skos:definition xml:lang="en">A Markov model in which transition probabilities are allowed to vary over the time horizon, such as mortality risk rising with age.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Time-Varying Markov Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Time-Inhomogeneous Model</skos:prefLabel>
