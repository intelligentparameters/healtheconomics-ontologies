    <!-- https://healtheconomics.wiki/concept/mcda-in-hta -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/mcda-in-hta">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/multi-criteria-decision-analysis"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/value-framework"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/multi-criteria-decision-analysis"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/value-framework"/>
        <skos:notation>HS-HP-HTA-127</skos:notation>
        <dcterms:identifier>HS-HP-HTA-127</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-03</dcterms:modified>
        <dcterms:source>Thokala et al. 2016</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">MCDA in HTA</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">MCDA in HTA uses multi-criteria decision analysis to appraise health technologies on explicit, often weighted, criteria such as health gain and severity.</skos:definition>
        <skos:hiddenLabel xml:lang="en">MCDA Appraisal</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Multi-Criteria HTA</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">MCDA in HTA</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/priority-setting"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-technology-assessment#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/discrete-choice-experiment"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/mcda-in-hta"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/multi-criteria-decision-analysis"/>
        <dcterms:identifier>HEO-L-758d4a527379</dcterms:identifier>
        <linkRationale xml:lang="en">It is MCDA applied in HTA</linkRationale>
