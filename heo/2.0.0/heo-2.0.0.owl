    <!-- https://healtheconomics.wiki/concept/smart-device-health -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/smart-device-health">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
