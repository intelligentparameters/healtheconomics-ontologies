    <!-- https://healtheconomics.wiki/concept/paragraph-iv-certification -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/paragraph-iv-certification">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
