        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/differential-discounting"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/discount-rate"/>
        <dcterms:identifier>HEO-L-d58fae2a6224</dcterms:identifier>
        <linkRationale xml:lang="en">differential discounting applies a discount rate, with a lower one for health</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
