        <skos:notation>HS-SS_HSP-005</skos:notation>
        <dcterms:identifier>HS-SS_HSP-005</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Bohm et al. 2021</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Balanced Scorecard</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">BSC</skos:altLabel>
        <skos:definition xml:lang="en">The balanced scorecard (BSC) is a management tool linking a health care organisation&apos;s financial, patient, process and staff measures to its strategy.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Kaplan-Norton Scorecard</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Balanced Scorecard</skos:prefLabel>
        <abbreviation xml:lang="en">BSC</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/composite-measure"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/benchmarking"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/performance-measure"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/balanced-scorecard"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-system-performance"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-b301269447ff</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health System Performance: wiki topic Performance, productivity and quality sits in Health Systems; placed under Health System Performance, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/balanced-scorecard"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-system-performance"/>
        <dcterms:identifier>HEO-L-911363e01bd3</dcterms:identifier>
        <linkRationale xml:lang="en">A balanced scorecard is a set of performance measures linked to strategy; it quantifies performance</linkRationale>
