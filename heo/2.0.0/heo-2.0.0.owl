    <!-- https://healtheconomics.wiki/concept/cure-rate-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cure-rate-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cure-model"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cure-model"/>
        <skos:notation>HE-EM-SM-014</skos:notation>
        <dcterms:identifier>HE-EM-SM-014</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-03</dcterms:modified>
        <dcterms:source>Latimer &amp; Rutherford 2024</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cure Rate Model</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">A cure rate model is a survival model that estimates the cure fraction and survival of uncured patients, used in HTA to extrapolate long-term survival.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Bounded Cumulative Hazard Model</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Cure-Rate Survival Model</skos:hiddenLabel>
