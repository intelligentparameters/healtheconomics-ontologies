    <!-- https://healtheconomics.wiki/concept/active-surveillance -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/active-surveillance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/treatment-pathway"/>
        <skos:notation>HE-PE-OO-002</skos:notation>
        <dcterms:identifier>HE-PE-OO-002</dcterms:identifier>
        <dcterms:source>DeVita, Lawrence &amp; Rosenberg 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Active Surveillance</rdfs:label>
        <skos:definition xml:lang="en">A management strategy for slow-growing cancers, most notably some prostate cancer cases, involving close monitoring rather than immediate definitive treatment.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Expectant Monitoring</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Structured Monitoring</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Active Surveillance</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/radiation-therapy"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/surgical-therapy"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/watchful-waiting"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/active-surveillance"/>
