        <dcterms:identifier>HE-ES-RM-023</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Altman &amp; Bland 1994</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Positive Predictive Value</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">PPV</skos:altLabel>
        <skos:definition xml:lang="en">The probability that an individual with a positive diagnostic test result truly has the condition being tested for.</skos:definition>
        <skos:hiddenLabel xml:lang="en">True-Positive Share</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Positive Predictive Value</skos:prefLabel>
        <abbreviation xml:lang="en">PPV</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/positive-predictive-value"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/diagnostic-accuracy"/>
        <dcterms:identifier>HEO-L-616551bb4284</dcterms:identifier>
        <linkRationale xml:lang="en">PPV is a standard measure of a test diagnostic accuracy</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/positive-recommendation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/positive-recommendation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
