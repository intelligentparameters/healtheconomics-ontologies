        <dcterms:identifier>HS-HP-HI-088</dcterms:identifier>
        <dcterms:source>US, Affordable Care Act</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Grandfathered Plan</rdfs:label>
        <skos:altLabel xml:lang="en">Grandfathered Health Plan</skos:altLabel>
        <skos:definition xml:lang="en">A health insurance plan predating a major regulatory reform, exempt from certain new requirements as long as it avoids significant coverage changes.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Legacy Plan</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Grandfathered Plan</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/qualified-health-plan"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
