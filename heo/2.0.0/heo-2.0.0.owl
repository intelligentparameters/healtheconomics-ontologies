    <!-- https://healtheconomics.wiki/concept/budget-control -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/budget-control">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/budget-cycle"/>
        <skos:notation>HS-HP-HF-006</skos:notation>
        <dcterms:identifier>HS-HP-HF-006</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Comité d&apos;alerte 2025</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Budget Control</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Budget control is the in-year monitoring of health spending against an approved budget, tracing variances to price or volume and acting to stay within it.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Budget Adherence</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Spending Oversight</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Budget Control</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/cost-containment"/>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/budget-variance"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/budget-overrun"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/cost-variance"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/variance-analysis"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/budget-control"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-961f0c48711d</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health Financing: wiki topic Health financing and insurance sits in Health Systems; placed under Health System Financing, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/budget-control"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/budget-cycle"/>
        <dcterms:identifier>HEO-L-412f8ac6c8f6</dcterms:identifier>
