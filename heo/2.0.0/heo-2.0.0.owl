    <!-- https://healtheconomics.wiki/concept/reproducible-computing -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/reproducible-computing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/reproducibility"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/reproducibility"/>
        <skos:notation>CS-SC-RP-001</skos:notation>
        <dcterms:identifier>CS-SC-RP-001</dcterms:identifier>
        <dcterms:source>Wilson G, Aruliah DA, Brown CT, et al. Best practices for scientific computing. PLOS Biology. 2014;12(1):e1001745. doi:10.1371/journal.pbio.1001745.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Reproducible Computing</rdfs:label>
        <skos:altLabel xml:lang="en">Computational Reproducibility</skos:altLabel>
        <skos:definition xml:lang="en">A computational approach that enables analyses to be repeated and produce consistent results using the same data, methods and software environment.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Reproducible Analysis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Reproducible Computing</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/reproducibility"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/model-code"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/reproducible-computing"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/reproducibility"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-09b7ca7ec57b</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Computer Science &gt; Scientific Computing &gt; Reproducibility: computational methods enter health economics through modelling (Mathematical and computational methods); placed under Reproducibility, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/reproducible-computing"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
