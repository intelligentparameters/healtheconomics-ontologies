        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Califf 2018; NICE PMG36 (2022, updated 2026) section 4.8</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Biomarker</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Biological Marker</skos:altLabel>
        <skos:definition xml:lang="en">A biomarker is a measured biological characteristic, such as a gene or protein, signalling disease or treatment response; HTA may tie treatment to it.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Molecular Marker</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Biomarker</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome-assessment"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/treatment-selection"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/biomarker"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-70baeca82a5e</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: curated: review B: biomarkers belong with surrogate and biomarker endpoints (Outcomes), not HTA</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/biomarker"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
