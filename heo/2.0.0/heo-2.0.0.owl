        <skos:notation>HS-DC-DP-005</skos:notation>
        <dcterms:identifier>HS-DC-DP-005</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>MedPAC 2025</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Average Sales Price</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Average sales price (ASP) is a manufacturer&apos;s average US price for a drug in a quarter, net of most discounts and rebates; it sets Medicare Part B payment.</skos:definition>
        <skos:hiddenLabel xml:lang="en">ASP Benchmark</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Medicare Net Price</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Average Sales Price</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/list-price"/>
