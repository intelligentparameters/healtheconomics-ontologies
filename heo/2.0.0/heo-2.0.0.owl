        <uses rdf:resource="https://healtheconomics.wiki/concept/cubic-spline"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/maximum-likelihood-estimation"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/parametric-survival-model"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/regression-analysis"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
