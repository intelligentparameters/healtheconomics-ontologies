    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/pro-rich-bias -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/pro-rich-bias">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:notation>HE-EE-HE-012</skos:notation>
        <dcterms:identifier>HE-EE-HE-012</dcterms:identifier>
        <dcterms:source>O&apos;Donnell et al. 2008</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Pro-Rich Bias</rdfs:label>
        <skos:definition xml:lang="en">A pattern in which the benefits of a healthcare subsidy or programme disproportionately accrue to wealthier groups relative to their share of need.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Pro-Rich Distribution</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Regressive Benefit Bias</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Pro-Rich Bias</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/health-inequity"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/pro-rich-bias"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-8a0da722f9df</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Health Equity: wiki topic Equity and inequality sits in Health Policy</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/pro-rich-bias"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-inequity"/>
        <dcterms:identifier>HEO-L-9f7ecb85297e</dcterms:identifier>
        <linkRationale xml:lang="en">Benefits skewed to the rich widen avoidable, unfair health differences.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


