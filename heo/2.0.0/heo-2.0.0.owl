    <!-- https://healtheconomics.wiki/concept/surrogate-decision-maker -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/surrogate-decision-maker">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-HP-HD-110</skos:notation>
        <dcterms:identifier>HS-HP-HD-110</dcterms:identifier>
        <dcterms:source>Appelbaum &amp; Grisso 1988</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Surrogate Decision-Maker</rdfs:label>
        <skos:altLabel xml:lang="en">Substitute Decision-Maker</skos:altLabel>
        <skos:definition xml:lang="en">An individual authorised to make healthcare decisions on behalf of a patient lacking the capacity to make their own.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Patient Representative</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Surrogate Decision-Maker</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/best-interest-standard"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/substituted-judgment"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/surrogate-decision-maker"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-6f044c0e1387</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Healthcare Delivery: organisation and delivery of care is the Health Systems subdomain (Organisation and governance)</linkRationale>
