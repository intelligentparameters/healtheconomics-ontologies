    <!-- https://healtheconomics.wiki/concept/healthcare-cost-growth -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/healthcare-cost-growth">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <skos:notation>HE-EE-CA-048</skos:notation>
        <dcterms:identifier>HE-EE-CA-048</dcterms:identifier>
        <dcterms:source>Newhouse 1992</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Healthcare Cost Growth</rdfs:label>
        <skos:altLabel xml:lang="en">Healthcare Spending Growth</skos:altLabel>
        <skos:definition xml:lang="en">The rate at which total healthcare expenditure rises over time, commonly broken down into population growth, ageing, price inflation, and treatment intensity.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Health Cost Inflation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Healthcare Cost Growth</skos:prefLabel>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/health-spending"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/healthcare-cost-growth"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-05557f187d4b</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Cost Analysis: cost analysis is costing; most concepts with this Level 3 that the wiki places in a topic sit in Costs</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/healthcare-cost-growth"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isPropertyOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-spending"/>
        <dcterms:identifier>HEO-L-5db2278e037d</dcterms:identifier>
        <linkRationale xml:lang="en">Cost growth is the rate of change of health spending, a characteristic of it, not a measuring instrument</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
