        <dcterms:identifier>HEO-L-555efa318ea6</dcterms:identifier>
        <linkRationale xml:lang="en">It is one provision within a plan&apos;s deductible and cost-sharing structure</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
