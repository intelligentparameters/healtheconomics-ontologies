    <!-- https://healtheconomics.wiki/concept/horizontal-equity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/horizontal-equity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/equity"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/equity"/>
        <skos:notation>HE-EE-WE-011</skos:notation>
        <dcterms:identifier>HE-EE-WE-011</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Wagstaff &amp; van Doorslaer 2000</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Horizontal Equity</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Horizontal equity is equal treatment of equals in health care: equal care for people in equal need and equal payments from those with equal ability to pay.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Equal Treatment for Equal Need</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Like-for-Like Equity</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Horizontal Equity</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/horizontal-inequity"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/vertical-equity"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-policy#step-4"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/equitable-access"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/horizontal-equity"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/equity"/>
        <dcterms:identifier>HEO-L-5e53099c8ae8</dcterms:identifier>
        <linkRationale xml:lang="en">Horizontal equity is one form of equity.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/horizontal-equity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/horizontal-inequity"/>
        <dcterms:identifier>HEO-L-65290147763a</dcterms:identifier>
        <linkRationale xml:lang="en">The principle versus its violation.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
