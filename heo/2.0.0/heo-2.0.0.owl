        <dcterms:identifier>HE-PE-DT-019</dcterms:identifier>
        <dcterms:source>Katzung 2017</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Empiric Therapy</rdfs:label>
        <skos:altLabel xml:lang="en">Empirical Therapy</skos:altLabel>
        <skos:definition xml:lang="en">Treatment started based on clinical judgement and the most likely diagnosis before definitive confirmation, common when delaying treatment could be harmful.</skos:definition>
