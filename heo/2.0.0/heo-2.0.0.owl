        <skos:altLabel xml:lang="en">Review of Reviews</skos:altLabel>
        <skos:definition xml:lang="en">A systematic review summarising evidence from multiple existing systematic reviews addressing related questions, rather than synthesising individual primary studies.</skos:definition>
        <skos:prefLabel xml:lang="en">Umbrella Review</skos:prefLabel>
