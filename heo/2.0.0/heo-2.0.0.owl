    <!-- https://healtheconomics.wiki/concept/enbs-calculation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/enbs-calculation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/value-of-information"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/value-of-information"/>
        <skos:notation>HE-EM-VI-026</skos:notation>
        <dcterms:identifier>HE-EM-VI-026</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Claxton &amp; Posnett 1996</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">ENBS Calculation</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">The process of computing the expected net benefit of sampling, the expected value of sample information from a study minus its expected cost.</skos:definition>
        <skos:hiddenLabel xml:lang="en">ENBS Computation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Net Sampling Benefit</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">ENBS Calculation</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/sample-size-calculation"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-11"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/evsi"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/enbs-calculation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/value-of-information"/>
        <dcterms:identifier>HEO-L-c3183ee8eda5</dcterms:identifier>
        <linkRationale xml:lang="en">Computing ENBS is one form of value of information analysis</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/enbs-calculation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/sample-size-calculation"/>
        <dcterms:identifier>HEO-L-b3301094c595</dcterms:identifier>
        <linkRationale xml:lang="en">ENBS-based study sizing is the decision-analytic alternative to power-based sample size calculation</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/enbs-calculation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evsi"/>
        <dcterms:identifier>HEO-L-9c4ada317930</dcterms:identifier>
        <linkRationale xml:lang="en">ENBS is EVSI minus the expected cost of the study, so EVSI is a direct input</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


