        <produces rdf:resource="https://healtheconomics.wiki/concept/hazard-rate"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/probability-to-rate-conversion"/>
