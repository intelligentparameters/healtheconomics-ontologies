    <!-- https://healtheconomics.wiki/concept/tolerance -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/tolerance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/multicollinearity"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/variance-inflation-factor"/>
        <skos:notation>HE-ES-SA-219</skos:notation>
        <dcterms:identifier>HE-ES-SA-219</dcterms:identifier>
        <dcterms:source>Belsley, Kuh &amp; Welsch 1980</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Tolerance</rdfs:label>
        <skos:definition xml:lang="en">A regression diagnostic, one minus a predictor&apos;s coefficient of determination against all other predictors, detecting multicollinearity, lower values meaning more collinearity.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Drug Habituation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Reduced Drug Response</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Tolerance</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/tolerance"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-0c599649583f</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Statistical Analysis: catalogue subdomain Evidence Synthesis is one of the subdomains</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/tolerance"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/multicollinearity"/>
        <dcterms:identifier>HEO-L-ab6de5be6fbf</dcterms:identifier>
        <linkRationale xml:lang="en">The definition is the regression tolerance statistic, which detects multicollinearity, not drug tolerance or pharmacodynamics.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/tolerance"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/variance-inflation-factor"/>
        <dcterms:identifier>HEO-L-5c05101fe44d</dcterms:identifier>
