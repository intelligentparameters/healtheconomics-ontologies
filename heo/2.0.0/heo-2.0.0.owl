    <!-- https://healtheconomics.wiki/concept/waiting-time -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/waiting-time">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/timely-access"/>
        <skos:notation>HS-HP-HSC-010</skos:notation>
        <dcterms:identifier>HS-HP-HSC-010</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Waiting Time</rdfs:label>
        <skos:altLabel xml:lang="en">Wait Time</skos:altLabel>
        <skos:definition xml:lang="en">The interval between a patient&apos;s referral for a service and the point at which they actually receive it, a responsiveness indicator.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Time to Treatment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Waiting Time</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/waiting-time"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-818cef516464</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health System Capacity: organisation and delivery of care is the Health Systems subdomain (Organisation and governance)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/waiting-time"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/timely-access"/>
        <dcterms:identifier>HEO-L-f6e4d78762ee</dcterms:identifier>
