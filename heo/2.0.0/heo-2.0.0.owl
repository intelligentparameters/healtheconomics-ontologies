    <!-- https://healtheconomics.wiki/concept/regional-perspective -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/regional-perspective">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/perspective"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/perspective"/>
        <skos:notation>HE-EE-EPR-041</skos:notation>
        <dcterms:identifier>HE-EE-EPR-041</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Regional Perspective</rdfs:label>
        <skos:altLabel xml:lang="en">Local Perspective</skos:altLabel>
        <skos:definition xml:lang="en">An analytic viewpoint considering costs and outcomes relevant to a defined geographic region within a country, rather than the health system as a whole.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Devolved Perspective</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Local Health Authority Perspective</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Regional Viewpoint</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Sub-National Perspective</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Regional Perspective</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/healthcare-sector-perspective"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/regional-perspective"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/perspective"/>
        <dcterms:identifier>HEO-L-87c4025541b4</dcterms:identifier>
        <linkRationale xml:lang="en">A regional perspective is a perspective.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/regional-perspective"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/healthcare-sector-perspective"/>
        <dcterms:identifier>HEO-L-7b68e5bc0313</dcterms:identifier>
