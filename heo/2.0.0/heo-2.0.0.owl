    <!-- https://healtheconomics.wiki/concept/health-economic-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/health-economic-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:notation>HE-EM-DM-041</skos:notation>
        <dcterms:identifier>HE-EM-DM-041</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Caro et al. 2012</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Health Economic Model</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Decision-Analytic Model</skos:altLabel>
        <skos:altLabel xml:lang="en">Health Economics Model</skos:altLabel>
        <skos:definition xml:lang="en">A health economic model, or decision model, is a mathematical framework combining evidence to estimate the costs and health outcomes of healthcare options.</skos:definition>
