        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cumulative-hazard"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cumulative-incidence"/>
        <dcterms:identifier>HEO-L-f388fec06679</dcterms:identifier>
