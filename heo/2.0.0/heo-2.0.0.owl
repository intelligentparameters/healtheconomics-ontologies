    <!-- https://healtheconomics.wiki/concept/price-transparency -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/price-transparency">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:notation>HS-DC-DP-077</skos:notation>
        <dcterms:identifier>HS-DC-DP-077</dcterms:identifier>
        <dcterms:source>Danzon 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Price Transparency</rdfs:label>
        <skos:altLabel xml:lang="en">Pricing Transparency</skos:altLabel>
        <skos:definition xml:lang="en">The degree to which actual prices paid for healthcare goods and services, including negotiated discounts, are made publicly available rather than kept confidential.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Open Pricing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Price Transparency</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/confidential-price"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/price-transparency"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
