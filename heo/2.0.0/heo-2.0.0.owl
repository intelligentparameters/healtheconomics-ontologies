        <dcterms:identifier>HEO-L-d800f9518021</dcterms:identifier>
        <linkRationale xml:lang="en">A Paragraph IV certification disputes patent validity or infringement, a form of patent challenge</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
