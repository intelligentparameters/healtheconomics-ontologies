    <!-- https://healtheconomics.wiki/concept/qaly-gain -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/qaly-gain">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/qaly"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/qaly"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/cost-per-qaly"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/incremental-cost-utility-ratio"/>
        <skos:notation>HE-EE-QALY-007</skos:notation>
        <dcterms:identifier>HE-EE-QALY-007</dcterms:identifier>
        <dcterms:source>Weinstein &amp; Stason 1977</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">QALY Gain</rdfs:label>
        <skos:altLabel xml:lang="en">Incremental QALY</skos:altLabel>
        <skos:altLabel xml:lang="en">QALYs Gained</skos:altLabel>
        <skos:definition xml:lang="en">The increase in quality-adjusted life years attributable to an intervention, the difference between the QALYs expected under it and its comparator.</skos:definition>
        <skos:prefLabel xml:lang="en">QALY Gain</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/outcomes#step-3"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/qaly-gain"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/qaly"/>
        <dcterms:identifier>HEO-L-5fbe477d5f81</dcterms:identifier>
        <linkRationale xml:lang="en">A QALY gain is a quantity expressed in QALYs.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
