    <!-- https://healtheconomics.wiki/concept/response-surface -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/response-surface">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/metamodel"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/metamodel"/>
        <skos:notation>HE-EM-VI-017</skos:notation>
        <dcterms:identifier>HE-EM-VI-017</dcterms:identifier>
        <dcterms:source>Box &amp; Wilson 1951</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Response Surface</rdfs:label>
        <skos:definition xml:lang="en">A fitted mathematical approximation describing how a model&apos;s output varies with its inputs, built from limited runs and used to predict untested combinations.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Fitted-Response Map</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">RSM</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Response Surface</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-11"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/regression-analysis"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/response-surface"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/metamodel"/>
        <dcterms:identifier>HEO-L-4f1ed5f0c162</dcterms:identifier>
        <linkRationale xml:lang="en">A response surface is a fitted approximation of a model, a metamodel.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/response-surface"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/regression-analysis"/>
        <dcterms:identifier>HEO-L-b2a32334a0fa</dcterms:identifier>
        <linkRationale xml:lang="en">RSM fits the response surface, usually by regression.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/response-surface-methodology -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/response-surface-methodology">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
