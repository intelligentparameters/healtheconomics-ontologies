    <!-- https://healtheconomics.wiki/concept/days-cash-on-hand -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/days-cash-on-hand">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/liquidity-ratio"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/liquidity-ratio"/>
        <skos:notation>HE-EE_EA-013</skos:notation>
        <dcterms:identifier>HE-EE_EA-013</dcterms:identifier>
        <dcterms:source>Brealey, Myers &amp; Allen 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Days Cash on Hand</rdfs:label>
        <skos:altLabel xml:lang="en">DCOH</skos:altLabel>
        <skos:definition xml:lang="en">A financial ratio measuring how many days an organisation could cover its operating expenses using only available cash reserves, without extra revenue.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cash Reserve Ratio</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Days Cash on Hand</skos:prefLabel>
        <abbreviation xml:lang="en">DCOH</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-4"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/days-cash-on-hand"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/liquidity-ratio"/>
        <dcterms:identifier>HEO-L-c02d56ec0ba9</dcterms:identifier>
        <linkRationale xml:lang="en">Cash reserves against operating expenses</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/days-in-accounts-receivable -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/days-in-accounts-receivable">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/financial-ratio"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/financial-ratio"/>
        <skos:notation>HS-NHS-PM-006</skos:notation>
        <dcterms:identifier>HS-NHS-PM-006</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-02</dcterms:modified>
        <dcterms:source>HFMA 2026</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Days in Accounts Receivable</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">AR Days</skos:altLabel>
        <skos:altLabel xml:lang="en">DAR</skos:altLabel>
        <skos:definition xml:lang="en">Days in accounts receivable (AR days) is a provider&apos;s net receivables divided by average daily net patient revenue, giving days of revenue still unpaid.</skos:definition>
        <skos:prefLabel xml:lang="en">Days in Accounts Receivable</skos:prefLabel>
        <abbreviation xml:lang="en">AR Days</abbreviation>
        <abbreviation xml:lang="en">DAR</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-4"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/days-in-accounts-receivable"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/financial-ratio"/>
        <dcterms:identifier>HEO-L-900680fabee1</dcterms:identifier>
        <linkRationale xml:lang="en">Receivables over daily revenue</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/de-identification -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/de-identification">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-HP-DH-014</skos:notation>
        <dcterms:identifier>HS-HP-DH-014</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</dcterms:modified>
        <dcterms:source>Garfinkel et al. 2023 (NIST SP 800-188)</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">De-Identification</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:definition xml:lang="en">De-identification is the removal or alteration of identifiers in health data, such as names, exact dates and postcodes, to lower re-identification risk.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Data Anonymisation Process</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Identifier Removal</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">De-Identification</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/confidentiality"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/pseudonymization"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/de-identification"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-50ee3476e193</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Digital Health: health information systems are one of the WHO health system building blocks</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/de-identification"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/confidentiality"/>
        <dcterms:identifier>HEO-L-303b90aa6f61</dcterms:identifier>
        <linkRationale xml:lang="en">Removing identifiers protects patient information</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
