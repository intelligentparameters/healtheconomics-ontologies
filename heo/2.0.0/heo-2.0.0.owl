        <dcterms:identifier>HEO-L-c1b83e070d7a</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Evidence synthesis and appraisal in subdomain Evidence Synthesis; placed under Evidence Assessment, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/intra-rater-reliability"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/reliability-assessment"/>
