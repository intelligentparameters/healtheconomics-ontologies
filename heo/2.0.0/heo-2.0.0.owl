        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/consumer-surplus"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/deadweight-loss"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/price-elasticity-of-demand"/>
        <skos:notation>HE-EE-ME-015</skos:notation>
        <dcterms:identifier>HE-EE-ME-015</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-02</dcterms:modified>
        <dcterms:source>Marshall 1890</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Demand Curve</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">A demand curve shows how much of a good or service, such as health care, is demanded at each price, other factors held fixed. It usually slopes downward.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Demand Schedule</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Price-Quantity Curve</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Demand Curve</skos:prefLabel>
        <prerequisiteFor rdf:resource="https://healtheconomics.wiki/concept/price-elasticity-of-healthcare"/>
        <represents rdf:resource="https://healtheconomics.wiki/concept/demand"/>
        <represents rdf:resource="https://healtheconomics.wiki/concept/demand-price"/>
        <represents rdf:resource="https://healtheconomics.wiki/concept/willingness-to-pay"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/demand-curve"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
