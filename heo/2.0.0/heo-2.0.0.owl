    <!-- https://healtheconomics.wiki/concept/actual-cost -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/actual-cost">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/budget-variance"/>
        <skos:notation>HS-HP-HI-001</skos:notation>
        <dcterms:identifier>HS-HP-HI-001</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Actual Cost</rdfs:label>
        <skos:altLabel xml:lang="en">Incurred Cost</skos:altLabel>
        <skos:definition xml:lang="en">The real, measured expense incurred delivering a healthcare service, based on observed resource use and prices, unlike a standard or estimated cost.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Observed Cost</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Realised Cost</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Realized Cost</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Actual Cost</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/standard-costing"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/actual-cost"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <dcterms:identifier>HEO-L-97144e75cab9</dcterms:identifier>
        <linkRationale xml:lang="en">Actual cost is a measured cost</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/actual-cost"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/budget-variance"/>
        <dcterms:identifier>HEO-L-ae1306a5d025</dcterms:identifier>
        <linkRationale xml:lang="en">Budget variance is budgeted minus actual spending, so actual cost is an input</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
