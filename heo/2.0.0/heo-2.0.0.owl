    <!-- https://healtheconomics.wiki/concept/substance-use-disorder -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/substance-use-disorder">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/substance-use-economics"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/substance-use-economics"/>
        <skos:notation>HE-PE-MH-033</skos:notation>
        <dcterms:identifier>HE-PE-MH-033</dcterms:identifier>
        <dcterms:source>American Psychiatric Association 2013</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Substance Use Disorder</rdfs:label>
        <skos:altLabel xml:lang="en">SUD</skos:altLabel>
        <skos:definition xml:lang="en">A condition marked by an inability to control use of a substance despite significant harmful consequences, including dependence on alcohol, opioids, or other drugs.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Addiction</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Substance Use Disorder</skos:prefLabel>
        <abbreviation xml:lang="en">SUD</abbreviation>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/substance-abuse-policy"/>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/substance-use-economics"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/substance-use-disorder"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
