        <dcterms:identifier>HE-EE-CBA-054</dcterms:identifier>
        <dcterms:source>Boyle &amp; Bergstrom 1992</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Value Transfer</rdfs:label>
        <skos:definition xml:lang="en">The general practice of applying an economic value estimated in one context to a decision in a different context.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Estimate Transfer</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Transferred Estimate</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Value Transfer</skos:prefLabel>
        <assumes rdf:resource="https://healtheconomics.wiki/concept/transferability"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/value-transfer"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-d0515f9b3b38</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Cost-Benefit Analysis: the unplaced concepts here are stated preference terms; the wiki&apos;s topic Stated preference and monetary valuation sits in Outcomes</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/value-transfer"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#assumes"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/transferability"/>
        <dcterms:identifier>HEO-L-59e30b895bf5</dcterms:identifier>
        <linkRationale xml:lang="en">Backwards: benefit transfer is the narrower WTP case; value transfer rests on transferability, as Benefit Transfer does.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


