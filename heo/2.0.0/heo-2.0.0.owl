        <skos:prefLabel xml:lang="en">Substance Use Economics</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
    </owl:NamedIndividual>
