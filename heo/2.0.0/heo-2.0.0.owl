        <owl:versionInfo>1.0.5</owl:versionInfo>
        <skos:altLabel xml:lang="en">ATMP</skos:altLabel>
        <skos:definition xml:lang="en">An advanced therapy medicinal product (ATMP) is an EU-regulated gene, cell or tissue-based medicine, often given once, whose lasting value HTA must judge.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Gene and Cell Therapies</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Advanced Therapy Medicinal Product</skos:prefLabel>
        <abbreviation xml:lang="en">ATMP</abbreviation>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/curative-model-uncertainty"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-policy#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/advanced-therapy"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/biologic"/>
        <dcterms:identifier>HEO-L-bca4df26a5aa</dcterms:identifier>
        <linkRationale xml:lang="en">ATMPs are biological medicines from cells, genes or tissue</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
