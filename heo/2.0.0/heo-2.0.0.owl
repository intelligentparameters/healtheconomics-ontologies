        <dcterms:identifier>HE-ES-SA-024</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>NIST/SEMATECH e-Handbook of Statistical Methods, section 1.3.6.6.6</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Chi-Square Distribution</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Chi-Squared Distribution</skos:altLabel>
        <skos:altLabel xml:lang="en">Chi2 Distribution</skos:altLabel>
        <skos:definition xml:lang="en">The chi-square distribution describes a sum of squared independent standard normals and is the reference for likelihood ratio, heterogeneity and fit tests.</skos:definition>
        <skos:prefLabel xml:lang="en">Chi-Square Distribution</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
