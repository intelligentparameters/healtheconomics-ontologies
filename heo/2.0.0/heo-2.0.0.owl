    <!-- https://healtheconomics.wiki/concept/endowment-effect-concept -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/endowment-effect-concept">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cognitive-bias-concept"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cognitive-bias-concept"/>
        <skos:notation>HE-EE-BE-016</skos:notation>
        <dcterms:identifier>HE-EE-BE-016</dcterms:identifier>
        <dcterms:source>Kahneman, Knetsch &amp; Thaler 1990</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Endowment Effect Concept</rdfs:label>
        <skos:altLabel xml:lang="en">Divestiture Aversion</skos:altLabel>
        <skos:definition xml:lang="en">The tendency to value goods or outcomes already owned more highly than identical items not yet owned.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Endowment Effect</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Endowment Effect Concept</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/endowment-effect-concept"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cognitive-bias-concept"/>
        <dcterms:identifier>HEO-L-edccc787cd81</dcterms:identifier>
        <linkRationale xml:lang="en">The endowment effect is a systematic judgement bias</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/energy-level -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/energy-level">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
