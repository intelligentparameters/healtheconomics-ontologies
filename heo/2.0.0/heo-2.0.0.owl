        <skos:notation>HE-ES-RM-010</skos:notation>
        <dcterms:identifier>HE-ES-RM-010</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Cox 1972</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Hazard Ratio</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:altLabel xml:lang="en">HR</skos:altLabel>
        <skos:altLabel xml:lang="en">Relative Hazard</skos:altLabel>
        <skos:definition xml:lang="en">A hazard ratio (HR) is the ratio of the event rates (hazards) in two groups, the usual measure of a treatment effect on survival in trials and HTA models.</skos:definition>
        <skos:prefLabel xml:lang="en">Hazard Ratio</skos:prefLabel>
        <abbreviation xml:lang="en">HR</abbreviation>
        <assumes rdf:resource="https://healtheconomics.wiki/concept/proportional-hazards-assumption"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/relative-risk"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/hazard-ratio"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
