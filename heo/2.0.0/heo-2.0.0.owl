        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/patient-reported-outcome"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/activity-limitation"/>
        <skos:notation>HE-ES-PM-001</skos:notation>
        <dcterms:identifier>HE-ES-PM-001</dcterms:identifier>
        <dcterms:source>Reilly, Zbrozek &amp; Dukes 1993</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Activity Impairment</rdfs:label>
        <skos:definition xml:lang="en">A measure of how much a health condition interferes with an individual&apos;s ability to perform regular daily activities outside paid work.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Daily-Task Impairment</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Non-Work Impairment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Activity Impairment</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/presenteeism"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/activity-impairment"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
