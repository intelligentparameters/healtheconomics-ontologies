    <!-- https://healtheconomics.wiki/concept/suits-index -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/suits-index">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/inequality-index"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1469999"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/inequality-index"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/progressive-taxation"/>
        <skos:notation>HE-EE-HE-015</skos:notation>
        <dcterms:identifier>HE-EE-HE-015</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Suits 1977</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Suits Index</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A measure of the progressivity of a tax or financing system, using a concentration curve plotting cumulative tax burden against cumulative income.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Suits Progressivity Index</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Tax Progressivity Index</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Suits Index</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/kakwani-index"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-policy#step-4"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/suits-index"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/inequality-index"/>
        <dcterms:identifier>HEO-L-940f45970256</dcterms:identifier>
        <linkRationale xml:lang="en">The Suits index is a concentration-based summary of how unequally tax burden falls across income.</linkRationale>
