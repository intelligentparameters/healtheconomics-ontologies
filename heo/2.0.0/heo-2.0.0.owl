        <dcterms:identifier>HEO-L-1e6063d7b8e1</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Cost utility analysis in subdomain Economic Evaluation; placed under Cost-Utility Analysis, the concept named by its wiki topic</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/absolute-shortfall"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/severity-of-disease"/>
        <dcterms:identifier>HEO-L-4ac64d60306b</dcterms:identifier>
        <linkRationale xml:lang="en">Absolute shortfall is the QALY-loss metric NICE uses to quantify severity (subject definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/absolute-shortfall"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/severity-criterion"/>
        <dcterms:identifier>HEO-L-306b38d553e0</dcterms:identifier>
