    <!-- https://healtheconomics.wiki/concept/geographic-adjustment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/geographic-adjustment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/reimbursement"/>
        <skos:notation>HS-HP-PP-056</skos:notation>
        <dcterms:identifier>HS-HP-PP-056</dcterms:identifier>
        <dcterms:source>CMS, Medicare Physician Fee Schedule</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Geographic Adjustment</rdfs:label>
        <skos:altLabel xml:lang="en">Geographic Cost Adjustment</skos:altLabel>
        <skos:definition xml:lang="en">A modification to a standard payment rate accounting for legitimate cost variation across areas, such as local wage differences.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Area Wage Adjustment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Geographic Adjustment</skos:prefLabel>
        <modifies rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
