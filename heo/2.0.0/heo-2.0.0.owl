        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/psa"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#addresses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/parameter-uncertainty"/>
        <dcterms:identifier>HEO-L-a4a4c6f9a108</dcterms:identifier>
        <linkRationale xml:lang="en">PSA propagates parameter uncertainty to decision uncertainty; it handles it rather than measuring it</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
