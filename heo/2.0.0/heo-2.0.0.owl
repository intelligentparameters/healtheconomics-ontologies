    <!-- https://healtheconomics.wiki/concept/relative-dose-intensity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/relative-dose-intensity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/chemotherapy-cost"/>
        <skos:notation>HE-PE-DT-035</skos:notation>
        <dcterms:identifier>HE-PE-DT-035</dcterms:identifier>
        <dcterms:source>DeVita, Lawrence &amp; Rosenberg 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Relative Dose Intensity</rdfs:label>
        <skos:altLabel xml:lang="en">RDI</skos:altLabel>
        <skos:definition xml:lang="en">A measure comparing the dose intensity a patient actually received to the originally planned, full dose intensity, expressed as a percentage.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Delivered-Dose Ratio</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Relative Dose Intensity</skos:prefLabel>
        <abbreviation xml:lang="en">RDI</abbreviation>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/chemotherapy"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/relative-dose-intensity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-d5682770f316</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: curated: review B: RDI is used mainly to adjust drug acquisition costs in appraisals</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/relative-dose-intensity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/chemotherapy-cost"/>
        <dcterms:identifier>HEO-L-82b8ee1c1c69</dcterms:identifier>
