    <!-- https://healtheconomics.wiki/concept/discrimination-barrier -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/discrimination-barrier">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/access-barrier"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/access-barrier"/>
        <skos:notation>HS-SS-EQ-001</skos:notation>
        <dcterms:identifier>HS-SS-EQ-001</dcterms:identifier>
        <dcterms:source>Whitehead 1992</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Discrimination Barrier</rdfs:label>
        <skos:definition xml:lang="en">An obstacle to healthcare arising from unfair treatment based on characteristics such as race, ethnicity, or disability, rather than clinical need.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Bias-Based Access Barrier</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Discriminatory Barrier</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Discrimination Barrier</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/access-to-care"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/health-equity"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/discrimination-barrier"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/access-barrier"/>
        <dcterms:identifier>HEO-L-654949c0552b</dcterms:identifier>
        <linkRationale xml:lang="en">discrimination is named as an access barrier in the object definition</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/discrimination-barrier"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
