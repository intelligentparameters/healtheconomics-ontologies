        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Health Depreciation</rdfs:label>
        <skos:altLabel xml:lang="en">Depreciation of Health</skos:altLabel>
        <skos:definition xml:lang="en">The rate at which an individual&apos;s stock of health capital declines over time, generally assumed to accelerate with age.</skos:definition>
