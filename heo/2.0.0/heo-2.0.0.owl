        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/seamless-trial-design"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/time-to-market"/>
        <dcterms:identifier>HEO-L-c0de68226a01</dcterms:identifier>
