        <dcterms:identifier>HEO-L-9fbe1b9744dd</dcterms:identifier>
        <linkRationale xml:lang="en">Self-efficacy is a determinant that helps bring about lasting behaviour change</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
