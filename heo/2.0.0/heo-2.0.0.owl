    <!-- https://healtheconomics.wiki/concept/digital-divide -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/digital-divide">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/access-barrier"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/access-barrier"/>
        <skos:notation>HS-SS_DH-015</skos:notation>
        <dcterms:identifier>HS-SS_DH-015</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</dcterms:modified>
        <dcterms:source>van Deursen &amp; van Dijk 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Digital Divide</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:definition xml:lang="en">The digital divide is the gap between people who can access, use and benefit from digital technology and those who cannot, often along social lines.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Digital Access Gap</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Technology Access Divide</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Digital Divide</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/digital-equity"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/health-inequality"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/information-barrier"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/digital-engagement"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/digital-divide"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/access-barrier"/>
        <dcterms:identifier>HEO-L-4f2120111f1a</dcterms:identifier>
        <linkRationale xml:lang="en">being unable to use digital technology is an obstacle to digital care</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/digital-divide"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/digital-equity"/>
        <dcterms:identifier>HEO-L-92f1a3c17102</dcterms:identifier>
