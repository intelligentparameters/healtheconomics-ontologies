        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/quality-improvement"/>
        <skos:notation>HS-NHS-HQ-009</skos:notation>
        <dcterms:identifier>HS-NHS-HQ-009</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Resar et al. 2012</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Care Bundle</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Care Bundle is a quality improvement intervention of three to five evidence-based practices given together to each eligible patient, audited all-or-none.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Bundle of Care</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Evidence-Based Bundle</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Care Bundle</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/patient-safety"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/evidence-based-medicine"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/care-bundle"/>
