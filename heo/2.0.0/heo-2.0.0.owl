    <!-- https://healtheconomics.wiki/concept/summary-of-benefits -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/summary-of-benefits">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
