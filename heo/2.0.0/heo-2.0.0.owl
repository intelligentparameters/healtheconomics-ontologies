    <!-- https://healtheconomics.wiki/concept/gompertz-distribution -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/gompertz-distribution">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/probability-distribution"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/probability-distribution"/>
        <skos:notation>HE-EM-SM-031</skos:notation>
        <dcterms:identifier>HE-EM-SM-031</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Gompertz 1825</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Gompertz Distribution</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A probability distribution characterised by a hazard rate rising exponentially with time, originally developed to describe human mortality increasing with age.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Gompertz Density</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Gompertz Model Distribution</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Gompertz Distribution</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/gompertz-distribution"/>
