    <!-- https://healtheconomics.wiki/concept/law-of-large-numbers -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/law-of-large-numbers">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:notation>HE-ES-SA-100</skos:notation>
        <dcterms:identifier>HE-ES-SA-100</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Casella G, Berger RL. Statistical Inference. 2nd ed. Duxbury; 2002.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Law of Large Numbers</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">LLN</skos:altLabel>
        <skos:definition xml:lang="en">A theorem stating that as sample size increases, the sample average of a variable converges toward the true underlying population average.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Law of Averages</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Law of Large Numbers</skos:prefLabel>
        <abbreviation xml:lang="en">LLN</abbreviation>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/monte-carlo-simulation"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/risk-pooling"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/law-of-large-numbers"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-ed2bfdb82ebf</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Statistical methods in subdomain Evidence Synthesis; placed under Statistical Method, the concept named by its wiki topic</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
