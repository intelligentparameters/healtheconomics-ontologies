    <!-- https://healtheconomics.wiki/concept/generalized-estimating-equations -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/generalized-estimating-equations">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
