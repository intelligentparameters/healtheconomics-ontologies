    <!-- https://healtheconomics.wiki/concept/risk-pooling -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/risk-pooling">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <precedes rdf:resource="https://healtheconomics.wiki/concept/strategic-purchasing"/>
        <skos:notation>HS-HP-HI-166</skos:notation>
        <dcterms:identifier>HS-HP-HI-166</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>WHO, Health Financing for Universal Coverage</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Risk Pooling</rdfs:label>
        <owl:versionInfo>1.0.7</owl:versionInfo>
        <skos:definition xml:lang="en">Risk pooling is the accumulation and management of prepaid health funds for a defined population so that the financial consequences of health-care need are shared across members rather than borne solely by each person when illness occurs.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Financial Pooling</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Fund Pooling</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Pooling</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Risk Pooling</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/financial-protection"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-2"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/risk-pool"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/risk-pooling"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
