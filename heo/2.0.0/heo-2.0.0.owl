    <!-- https://healtheconomics.wiki/concept/restricted-mean-survival-time -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/restricted-mean-survival-time">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcome-measure"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/outcome-measure"/>
        <skos:notation>HE-EM-SM-073</skos:notation>
        <dcterms:identifier>HE-EM-SM-073</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Royston &amp; Parmar 2013</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Restricted Mean Survival Time</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">RMST</skos:altLabel>
        <skos:definition xml:lang="en">A survival summary measure calculated as the area under the survival curve up to a specified time point, an alternative to the hazard ratio.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Mean Survival to Horizon</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Restricted Mean Survival Time</skos:prefLabel>
        <abbreviation xml:lang="en">RMST</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/hazard-ratio"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/kaplan-meier-estimator"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/restricted-mean-survival-time"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/outcome-measure"/>
        <dcterms:identifier>HEO-L-32580edffa3e</dcterms:identifier>
        <linkRationale xml:lang="en">Full page kept; adds the missing backbone parent (a survival summary measure).</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/restricted-mean-survival-time"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/hazard-ratio"/>
        <dcterms:identifier>HEO-L-47b2c399f631</dcterms:identifier>
        <linkRationale xml:lang="en">RMST is a summary measure, not an analysis; its definition presents it as the alternative to the hazard ratio.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/restricted-mean-survival-time"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/kaplan-meier-estimator"/>
