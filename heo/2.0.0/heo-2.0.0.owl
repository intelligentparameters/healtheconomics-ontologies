    <!-- https://healtheconomics.wiki/concept/demand-for-health -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/demand-for-health">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <skos:notation>HE-EE-ME-016</skos:notation>
        <dcterms:identifier>HE-EE-ME-016</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Grossman 1972</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Demand for Health</rdfs:label>
        <owl:versionInfo>1.0.22</owl:versionInfo>
        <skos:definition xml:lang="en">Demand for health is the idea, from the Grossman model, that people value health as a capital stock, so their demand for healthcare is derived from it.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Grossman Demand</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Health Demand</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Demand for Health</skos:prefLabel>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/derived-demand-for-healthcare"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/demand-for-health"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-04d10d67e7fe</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Demand for health and health capital in subdomain Economic Foundations</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/demand-for-health"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isFoundationFor"/>
