        <skos:altLabel xml:lang="en">Cook Distance</skos:altLabel>
        <skos:definition xml:lang="en">Cook&apos;s distance is a regression diagnostic measuring how much all fitted values change when one observation, such as one patient&apos;s cost record, is removed.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Influence Statistic</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cook&apos;s Distance</skos:prefLabel>
