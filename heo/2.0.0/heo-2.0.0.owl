    <!-- https://healtheconomics.wiki/concept/heterogeneous-treatment-effect -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/heterogeneous-treatment-effect">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/treatment-effect"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/treatment-effect"/>
        <skos:notation>HE-ES-CER-016</skos:notation>
        <dcterms:identifier>HE-ES-CER-016</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-23</dcterms:modified>
        <dcterms:source>Kravitz, Duan &amp; Braslow 2004</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Heterogeneous Treatment Effect</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">HTE</skos:altLabel>
        <skos:altLabel xml:lang="en">Treatment Effect Heterogeneity</skos:altLabel>
        <skos:definition xml:lang="en">Variation in the size or direction of a treatment&apos;s effect across individuals or subgroups, so the overall average may not fit any one patient.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Treatment Effect Variation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Heterogeneous Treatment Effect</skos:prefLabel>
        <abbreviation xml:lang="en">HTE</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/heterogeneous-treatment-effect"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/treatment-effect"/>
        <dcterms:identifier>HEO-L-cc8dacf3b836</dcterms:identifier>
        <linkRationale xml:lang="en">A heterogeneous effect is a treatment effect.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/heuristics-concept -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/heuristics-concept">
