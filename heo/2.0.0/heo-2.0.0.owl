    <!-- https://healtheconomics.wiki/concept/model-replication -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/model-replication">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/model-validation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
