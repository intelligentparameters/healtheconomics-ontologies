        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/patent-extension"/>
        <skos:notation>HS-DC-IP-007</skos:notation>
