    <!-- https://healtheconomics.wiki/concept/survival-function -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/survival-function">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q2915096"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:notation>HE-EM-SM-084</skos:notation>
        <dcterms:identifier>HE-EM-SM-084</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Collett 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Survival Function</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Survivor Function</skos:altLabel>
        <skos:altLabel xml:lang="en">Survivorship Function</skos:altLabel>
        <skos:definition xml:lang="en">A function giving the probability that a person survives without the event of interest beyond a specified point in time.</skos:definition>
        <skos:prefLabel xml:lang="en">Survival Function</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-5"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/survival-analysis"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/survival-function"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-e50db3702f56</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Survival analysis and extrapolation in subdomain Economic Modelling</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/survival-function"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isFoundationFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/survival-analysis"/>
        <dcterms:identifier>HEO-L-3c1ead6fb140</dcterms:identifier>
        <linkRationale xml:lang="en">The survival function is a basic quantity on which survival analysis is built; it is not a stage or section of it</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
