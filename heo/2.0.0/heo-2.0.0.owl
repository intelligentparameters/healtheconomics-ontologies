        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/structural-uncertainty -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/structural-uncertainty">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/uncertainty"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/uncertainty"/>
        <skos:notation>HE-EM-UA-073</skos:notation>
        <dcterms:identifier>HE-EM-UA-073</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</dcterms:modified>
        <dcterms:source>Steuten et al. 2026</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Structural Uncertainty</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:altLabel xml:lang="en">Structural Model Uncertainty</skos:altLabel>
        <skos:definition xml:lang="en">Structural uncertainty is doubt about how a health economic model represents a decision problem, such as its health states, pathways or extrapolation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Model-Structure Uncertainty</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Structural Uncertainty</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/decision-uncertainty"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-10"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/structural-uncertainty"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/uncertainty"/>
        <dcterms:identifier>HEO-L-749024de7c69</dcterms:identifier>
        <linkRationale xml:lang="en">Structural uncertainty is one type of uncertainty in health economic models.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/structural-uncertainty"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/decision-uncertainty"/>
        <dcterms:identifier>HEO-L-c25318b67327</dcterms:identifier>
        <linkRationale xml:lang="en">Doubt about model structure adds to the chance the preferred option is wrong.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/structural-validity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/structural-validity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/model-validation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/model-validation"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/model-validation"/>
        <skos:notation>HE-EM-MV-076</skos:notation>
        <dcterms:identifier>HE-EM-MV-076</dcterms:identifier>
        <dcterms:source>Philips et al. 2004</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Structural Validity</rdfs:label>
        <skos:definition xml:lang="en">The degree to which a model&apos;s overall architecture, including its health states and time horizon, appropriately represents the real-world process being studied.</skos:definition>
        <skos:prefLabel xml:lang="en">Structural Validity</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/structural-validity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/model-validation"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-d517e16b4a7d</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Modelling &gt; Model Validation: catalogue subdomain Economic Modelling is one of the subdomains; placed under Model Validation, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/structural-validity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/model-validation"/>
        <dcterms:identifier>HEO-L-ff1bec5e73ed</dcterms:identifier>
        <linkRationale xml:lang="en">Subject is a model&apos;s structural validity, assessed in model validation, not an instrument measurement property</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/structural-validity-instrument -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/structural-validity-instrument">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/measurement-property"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/measurement-property"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/construct-validity"/>
