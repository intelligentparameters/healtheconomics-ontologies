    <!-- https://healtheconomics.wiki/concept/gradient-descent -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/gradient-descent">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/numerical-optimisation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/numerical-optimisation"/>
        <skos:notation>HE-EM-DM-039</skos:notation>
        <dcterms:identifier>HE-EM-DM-039</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-23</dcterms:modified>
        <dcterms:source>Press et al. 2007</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Gradient Descent</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Steepest Descent</skos:altLabel>
        <skos:definition xml:lang="en">Gradient descent is an iterative first-order optimization method that reduces a differentiable objective function by repeatedly moving the parameter vector in the direction opposite its gradient.</skos:definition>
        <skos:hiddenLabel xml:lang="en">First-Order Optimisation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Gradient Descent</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/nelder-mead-method"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/newton-raphson-method"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-12"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
