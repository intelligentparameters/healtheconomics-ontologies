        <dcterms:source>Coleman et al. 2006</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Sign-Out</rdfs:label>
        <skos:definition xml:lang="en">The transfer of information about a patient&apos;s condition and care plan from one clinician to another, typically at shift change.</skos:definition>
        <skos:hiddenLabel xml:lang="en">End-of-Shift Report</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Shift Handover</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Sign-Out</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/sbar"/>
    </owl:NamedIndividual>
