    <!-- https://healtheconomics.wiki/concept/chance-node -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/chance-node">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/decision-tree"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/decision-tree"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/decision-tree"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/expected-value"/>
        <skos:notation>HE-EM-DM-008</skos:notation>
        <dcterms:identifier>HE-EM-DM-008</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Briggs, Claxton &amp; Sculpher 2006</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
