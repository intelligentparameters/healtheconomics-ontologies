    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/competing-events"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#counterpartOf"/>
