    <!-- https://healtheconomics.wiki/concept/cox-snell-residual -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cox-snell-residual">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/residual"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/residual"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/goodness-of-fit"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/deviance-residual"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/martingale-residual"/>
        <skos:notation>HE-EM-SM-009</skos:notation>
        <dcterms:identifier>HE-EM-SM-009</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Cox &amp; Snell 1968</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
