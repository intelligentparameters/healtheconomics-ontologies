    <!-- https://healtheconomics.wiki/concept/special-pricing-arrangement -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/special-pricing-arrangement">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
