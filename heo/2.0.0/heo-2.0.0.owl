    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/master-protocol">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-trial-design"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/clinical-trial-design"/>
        <skos:notation>HE-ES-CTM-051</skos:notation>
        <dcterms:identifier>HE-ES-CTM-051</dcterms:identifier>
        <dcterms:source>Woodcock &amp; LaVange 2017</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Master Protocol</rdfs:label>
        <skos:altLabel xml:lang="en">Master Trial Protocol</skos:altLabel>
        <skos:definition xml:lang="en">An overarching trial framework establishing shared infrastructure to efficiently evaluate multiple treatments, diseases, or both within a single coordinated structure.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Overarching Trial Framework</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Master Protocol</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/master-protocol"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/clinical-trial-design"/>
        <dcterms:identifier>HEO-L-16b8b2235fd6</dcterms:identifier>
        <linkRationale xml:lang="en">A master protocol is a trial design framework</linkRationale>
