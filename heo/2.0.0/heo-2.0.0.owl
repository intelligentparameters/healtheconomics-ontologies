        <skos:notation>HS-HP-HD-090</skos:notation>
        <dcterms:identifier>HS-HP-HD-090</dcterms:identifier>
        <dcterms:source>Faden &amp; Beauchamp 1986</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Procedural Consent</rdfs:label>
        <skos:definition xml:lang="en">The specific informed consent process addressing a particular medical or surgical procedure&apos;s risks, benefits, and alternatives, obtained beforehand.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Procedure-Specific Consent</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Treatment Procedure Authorisation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Procedural Consent</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/procedural-consent"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/consent-for-treatment"/>
        <dcterms:identifier>HEO-L-cbfe9aef7210</dcterms:identifier>
        <linkRationale xml:lang="en">Procedural consent is consent for a specific treatment procedure.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/procedural-justice -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/procedural-justice">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:notation>HS-HP-HTA-159</skos:notation>
        <dcterms:identifier>HS-HP-HTA-159</dcterms:identifier>
        <dcterms:source>Daniels &amp; Sabin 1997</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Procedural Justice</rdfs:label>
        <skos:altLabel xml:lang="en">Procedural Fairness</skos:altLabel>
        <skos:definition xml:lang="en">A principle holding that the fairness of a decision-making process, independent of its outcome, matters for the decision&apos;s legitimacy.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Fair Process</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Procedural Justice</skos:prefLabel>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/accountability-for-reasonableness"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/deliberative-process"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/procedural-justice"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-0c22f9e82f64</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health Technology Assessment: HTA concepts belong to the HTA subdomain</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/procedural-justice"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isFoundationFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/accountability-for-reasonableness"/>
        <dcterms:identifier>HEO-L-513872f6ccba</dcterms:identifier>
        <linkRationale xml:lang="en">A4R is a fair-process framework built on the procedural justice principle</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/procedural-justice"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isFoundationFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/deliberative-process"/>
        <dcterms:identifier>HEO-L-a1ca322368ef</dcterms:identifier>
        <linkRationale xml:lang="en">A principle does not use a process; procedural justice is the basis on which deliberative processes are built (Daniels and Sabin 2008).</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/procedure-volume -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/procedure-volume">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/quality-indicator"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/service-volume"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/quality-indicator"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/service-volume"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/inpatient-quality-indicator"/>
        <skos:notation>HS-NHS-HSP-013</skos:notation>
        <dcterms:identifier>HS-NHS-HSP-013</dcterms:identifier>
        <dcterms:source>Luft, Bunker &amp; Enthoven 1979</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Procedure Volume</rdfs:label>
        <skos:altLabel xml:lang="en">Surgical Cases</skos:altLabel>
        <skos:definition xml:lang="en">The total number of times a specific procedure is performed by a provider over a defined period, closely associated with outcomes for many procedures.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Operative Cases</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Operative Volume</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Surgical Case Volume</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Theatre Caseload</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Procedure Volume</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/procedure-volume"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/quality-indicator"/>
        <dcterms:identifier>HEO-L-497d518285fe</dcterms:identifier>
        <linkRationale xml:lang="en">Procedure volume is used as a structural quality indicator because volume is associated with outcomes.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/procedure-volume"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/service-volume"/>
        <dcterms:identifier>HEO-L-08e90a332ca4</dcterms:identifier>
        <linkRationale xml:lang="en">Volume of one specific procedure is a case of service volume.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/procedure-volume"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/inpatient-quality-indicator"/>
        <dcterms:identifier>HEO-L-96b075636db8</dcterms:identifier>
        <linkRationale xml:lang="en">Definition: IQIs cover complex procedure volume.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/process-capability -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/process-capability">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/statistical-process-control"/>
        <skos:notation>HS-NHS-HQ-058</skos:notation>
        <dcterms:identifier>HS-NHS-HQ-058</dcterms:identifier>
        <dcterms:source>Shewhart 1931</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Process Capability</rdfs:label>
        <skos:definition xml:lang="en">A statistical measure of how consistently a process produces output within specified acceptable limits, assessing whether it reliably meets targets.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Capability Index</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Cp/Cpk</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Process Capability</skos:prefLabel>
        <assumes rdf:resource="https://healtheconomics.wiki/concept/common-cause-variation"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-5"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/process-capability"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-bfe6e4d1be81</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Performance productivity and quality in subdomain Health Systems; placed under Quality of Care, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/process-capability"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-process-control"/>
        <dcterms:identifier>HEO-L-d4cd40c5087e</dcterms:identifier>
        <linkRationale xml:lang="en">Process capability is a measure within the SPC toolkit, not a kind of the toolkit.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/process-capability"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#assumes"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/common-cause-variation"/>
        <dcterms:identifier>HEO-L-96568265dfd5</dcterms:identifier>
        <linkRationale xml:lang="en">Capability indices assume a stable process showing only common cause variation (Montgomery 2009).</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/process-evaluation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/process-evaluation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-evaluation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-evaluation"/>
        <skos:notation>HE-EE-EM-009</skos:notation>
        <dcterms:identifier>HE-EE-EM-009</dcterms:identifier>
        <dcterms:source>Moore et al. 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Process Evaluation</rdfs:label>
        <skos:definition xml:lang="en">An evaluation examining how an intervention was implemented, including fidelity to its intended design, reach, and contextual factors affecting delivery.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Delivery Evaluation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Implementation Evaluation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Process Evaluation</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/process-evaluation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-evaluation"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-7181cffc8164</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Evaluation Methods: wiki topic Evaluation types and frameworks sits in Economic Evaluation</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/process-improvement -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/process-improvement">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/quality-improvement"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/quality-improvement"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Process Improvement</rdfs:label>
        <skos:definition xml:lang="en">The systematic identification and reduction of inefficiency within a care delivery process, using continuous, data-driven refinement.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Continuous Improvement</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Process Improvement</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/operational-efficiency"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/process-mapping"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/process-improvement"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/quality-improvement"/>
        <dcterms:identifier>HEO-L-bd2532423ae2</dcterms:identifier>
        <linkRationale xml:lang="en">Process improvement is a form of quality improvement.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/process-improvement"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/operational-efficiency"/>
        <dcterms:identifier>HEO-L-ad7b336ea120</dcterms:identifier>
        <linkRationale xml:lang="en">Level-3 hub concept; process mapping is its standard tool and reduced waste raises operational efficiency.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/process-improvement"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/process-mapping"/>
        <dcterms:identifier>HEO-L-9201886d7e1e</dcterms:identifier>
        <linkRationale xml:lang="en">Level-3 hub concept; process mapping is its standard tool and reduced waste raises operational efficiency.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
