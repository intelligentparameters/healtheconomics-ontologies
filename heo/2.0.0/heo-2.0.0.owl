    <!-- https://healtheconomics.wiki/concept/principal-agent-problem -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/principal-agent-problem">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/market-failure"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1053211"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/market-failure"/>
        <skos:notation>HE-EE-ME-056</skos:notation>
        <dcterms:identifier>HE-EE-ME-056</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-03</dcterms:modified>
        <dcterms:source>McGuire 2000</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Principal-Agent Problem</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Principal-Agent Dilemma</skos:altLabel>
        <skos:definition xml:lang="en">The principal-agent problem arises when patients or payers rely on providers who know more than they do, act unobserved and may pursue other interests.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Agency Cost Problem</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Principal-Agent Problem</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/perfect-agent"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/demand-inducement"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/supplier-induced-demand"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/contract-theory"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/principal-agent-problem"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/market-failure"/>
        <dcterms:identifier>HEO-L-d7934deafdf3</dcterms:identifier>
        <linkRationale xml:lang="en">Agency problems from unequal information are a market failure, per the object definition</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/principal-agent-problem"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
