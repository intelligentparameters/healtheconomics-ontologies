    <!-- https://healtheconomics.wiki/concept/reservation-price -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/reservation-price">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/willingness-to-pay"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q474606"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/willingness-to-pay"/>
        <skos:notation>HS-DC-DP-090</skos:notation>
        <dcterms:identifier>HS-DC-DP-090</dcterms:identifier>
        <dcterms:source>Varian 2014</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Reservation Price</rdfs:label>
        <skos:definition xml:lang="en">The maximum price a buyer is willing to pay for a good or service before deciding not to purchase it at all.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Maximum Acceptable Price</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Reserve Price</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Reservation Price</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/willingness-to-accept"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/demand-price"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/reservation-price"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/willingness-to-pay"/>
        <dcterms:identifier>HEO-L-8a870b951032</dcterms:identifier>
        <linkRationale xml:lang="en">A reservation price is the maximum a buyer would pay, i.e. willingness to pay.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/reservation-price"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/willingness-to-accept"/>
        <dcterms:identifier>HEO-L-dc07615845eb</dcterms:identifier>
        <linkRationale xml:lang="en">A buyer reservation price (maximum paid) is the standard counterpoint to willingness to accept (minimum compensation).</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
