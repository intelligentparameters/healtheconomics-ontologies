    <!-- https://healtheconomics.wiki/concept/work-productivity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/work-productivity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/productivity"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/productivity"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/productivity-value"/>
        <skos:notation>HE-EE-PM-025</skos:notation>
        <dcterms:identifier>HE-EE-PM-025</dcterms:identifier>
        <dcterms:source>Goetzel et al. 2004</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Work Productivity</rdfs:label>
        <skos:definition xml:lang="en">The output an employee generates per unit of time worked, which health conditions can reduce through both absence and diminished performance.</skos:definition>
        <skos:prefLabel xml:lang="en">Work Productivity</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/work-productivity"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/productivity"/>
        <dcterms:identifier>HEO-L-5b578a8b9aed</dcterms:identifier>
        <linkRationale xml:lang="en">Work productivity is output per unit input.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
