    <!-- https://healtheconomics.wiki/concept/role-functioning -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/role-functioning">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
