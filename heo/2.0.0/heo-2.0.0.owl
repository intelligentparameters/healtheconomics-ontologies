    <!-- https://healtheconomics.wiki/concept/assumption-structure -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/assumption-structure">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/parameter-input"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/parameter-input"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/health-economic-model"/>
        <skos:notation>HE-EM-MP-002</skos:notation>
        <dcterms:identifier>HE-EM-MP-002</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Roberts et al. 2012</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Assumption Structure</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Assumption structure is the full set of simplifying assumptions in a health economic model&apos;s design, such as its health states, events and extrapolation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Modelling Assumptions</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Structural Assumptions</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Assumption Structure</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/structural-uncertainty"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/assumption-structure"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/parameter-input"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-5125de59b393</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Model types and structures in subdomain Economic Modelling; placed under Parameter Input, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
