        <skos:notation>HS-HP-HI-080</skos:notation>
        <dcterms:identifier>HS-HP-HI-080</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Explanation of Benefits</rdfs:label>
        <skos:altLabel xml:lang="en">EOB</skos:altLabel>
        <skos:definition xml:lang="en">A document an insurer sends after processing a claim, detailing services billed, the amount paid, and any remaining enrollee liability.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Claim Statement</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Explanation of Benefits</skos:prefLabel>
        <abbreviation xml:lang="en">EOB</abbreviation>
        <informs rdf:resource="https://healtheconomics.wiki/concept/appeal-process-insurance"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/explanation-of-benefits"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-b2f2899d7bd7</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health Insurance: wiki topic Health financing and insurance sits in Health Systems; placed under Health Insurance, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/explanation-of-benefits"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/appeal-process-insurance"/>
        <dcterms:identifier>HEO-L-4b1013474f7a</dcterms:identifier>
        <linkRationale xml:lang="en">The EOB tells the enrollee what was paid and what they owe; the appeal process lets them challenge a denied claim</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/explanatory-trial -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/explanatory-trial">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/randomised-controlled-trial"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/randomised-controlled-trial"/>
        <skos:notation>HE-ES-CTM-104</skos:notation>
        <dcterms:identifier>HE-ES-CTM-104</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</dcterms:modified>
        <dcterms:source>Thorpe et al. 2009</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Explanatory Trial</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">An explanatory trial is a randomised trial run under ideal, tightly controlled conditions to test whether a treatment can work, so it measures efficacy.</skos:definition>
        <skos:prefLabel xml:lang="en">Explanatory Trial</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/pragmatic-trial"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/efficacy-effectiveness-gap"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/efficacy-evidence"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/explanatory-trial"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/randomised-controlled-trial"/>
        <dcterms:identifier>HEO-L-66199178f4e9</dcterms:identifier>
        <linkRationale xml:lang="en">An explanatory trial is a randomised trial (subject definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/explanatory-trial"/>
