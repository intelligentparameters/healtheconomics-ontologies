        <rdfs:label xml:lang="en">Capacity Management</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Capacity management matches existing hospital beds and staff to patient demand by scheduling admissions and discharges, reducing waits and idle beds.</skos:definition>
