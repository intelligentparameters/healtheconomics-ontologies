    <!-- https://healtheconomics.wiki/concept/appropriateness-criteria -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/appropriateness-criteria">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
