        <partOf rdf:resource="https://healtheconomics.wiki/concept/health-system"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/health-system-building-blocks"/>
        <skos:notation>HS_SS_HS-015</skos:notation>
        <dcterms:identifier>HS_SS_HS-015</dcterms:identifier>
        <dcterms:source>World Health Organization. Everybody&apos;s Business: Strengthening Health Systems to Improve Health Outcomes-WHO&apos;s Framework for Action. WHO; 2007.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Service Delivery Block</rdfs:label>
        <skos:definition xml:lang="en">A core health system building block encompassing how interventions are organised and delivered to reach the population that needs them.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Delivery Building Block</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Service Delivery</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Service Delivery Block</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/service-coverage"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
