        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/externality-correction"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/subsidy"/>
        <skos:notation>HE-EE-EP-022</skos:notation>
        <dcterms:identifier>HE-EE-EP-022</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-03</dcterms:modified>
        <dcterms:source>Goodkin-Gold et al. 2020</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Pigouvian Subsidy</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Corrective Subsidy</skos:altLabel>
        <skos:definition xml:lang="en">A Pigouvian subsidy is a payment for an activity that benefits others, set equal to its marginal external benefit at the socially efficient level.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Externality Subsidy</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Pigouvian Subsidy</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/pigouvian-tax"/>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/positive-externality"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/market-failure"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/pigouvian-subsidy"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/externality-correction"/>
        <dcterms:identifier>HEO-L-acd83aa3c837</dcterms:identifier>
        <linkRationale xml:lang="en">A Pigouvian subsidy is an externality correction, as the object definition names</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
