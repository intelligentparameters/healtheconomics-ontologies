    <!-- https://healtheconomics.wiki/concept/end-of-life-cost -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/end-of-life-cost">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/direct-medical-cost"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/direct-medical-cost"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/lifetime-cost"/>
        <skos:notation>HS-DC-HC-003</skos:notation>
        <dcterms:identifier>HS-DC-HC-003</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">End-of-Life Cost</rdfs:label>
        <skos:definition xml:lang="en">Healthcare expenditure incurred during the final period of a patient&apos;s life, often a disproportionately large share of total lifetime healthcare costs.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Last-Year-of-Life Cost</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Terminal-Phase Cost</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">End-of-Life Cost</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/end-of-life-cost"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/direct-medical-cost"/>
        <dcterms:identifier>HEO-L-f9611a14d0c7</dcterms:identifier>
        <linkRationale xml:lang="en">Spending on care in the final period of life is direct medical cost</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/end-of-life-cost"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/lifetime-cost"/>
        <dcterms:identifier>HEO-L-dcfd086c1f80</dcterms:identifier>
        <linkRationale xml:lang="en">End-of-life cost is a component period of lifetime cost (both definitions)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
