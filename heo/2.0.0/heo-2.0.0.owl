        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cytogenetic Response</rdfs:label>
        <skos:definition xml:lang="en">A response criterion in some leukaemias assessing reduction in cells carrying a disease-associated chromosomal abnormality, an intermediate depth between hematologic and molecular response.</skos:definition>
