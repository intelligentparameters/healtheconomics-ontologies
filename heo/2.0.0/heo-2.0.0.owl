    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/meta-analysis"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/mantel-haenszel-method"/>
        <dcterms:identifier>HEO-L-6cfa1fa2ecf3</dcterms:identifier>
        <linkRationale xml:lang="en">Meta-analysis of binary outcomes uses Mantel-Haenszel pooling, which Cochrane prefers to inverse-variance for fixed-effect analyses with few events.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/meta-analysis"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/mean-difference"/>
        <dcterms:identifier>HEO-L-820ad166c3b6</dcterms:identifier>
        <linkRationale xml:lang="en">The mean difference is the usual effect measure pooled in meta-analysis of continuous outcomes, with inverse-variance weights (Mean Difference article).</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/meta-analysis"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
