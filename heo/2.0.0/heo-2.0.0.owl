    <!-- https://healtheconomics.wiki/concept/insurance-coverage-gap -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/insurance-coverage-gap">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:notation>HS-HP-HI-105</skos:notation>
        <dcterms:identifier>HS-HP-HI-105</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Insurance Coverage Gap</rdfs:label>
        <skos:definition xml:lang="en">A period during which an individual lacks any health insurance, whether from a job transition, lost programme eligibility, or another disruption.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Coverage Lapse</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Uninsured Period</skos:hiddenLabel>
