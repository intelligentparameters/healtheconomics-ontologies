    <!-- https://healtheconomics.wiki/concept/constrained-optimisation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/constrained-optimisation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/optimisation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/optimisation"/>
        <skos:notation>HE-EM-DM-013</skos:notation>
        <dcterms:identifier>HE-EM-DM-013</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Crown et al. 2017</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Constrained Optimisation</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Constrained Optimization</skos:altLabel>
        <skos:definition xml:lang="en">Constrained optimisation finds the choice that does best on an objective, such as QALYs gained, without breaking limits such as a fixed health budget.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Bounded Optimisation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Constrained Optimisation</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/priority-setting"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-12"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/shadow-price"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/budget-constraint"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/constrained-optimisation"/>
