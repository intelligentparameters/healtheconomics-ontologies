        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Health State Definition</rdfs:label>
        <skos:definition xml:lang="en">The precise clinical specification of each distinct health state within a Markov model, describing the criteria a patient must meet to occupy it.</skos:definition>
