    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/scaled-schoenfeld -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/scaled-schoenfeld">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/schoenfeld-residual"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/schoenfeld-residual"/>
        <skos:notation>HE-EM-SM-076</skos:notation>
        <dcterms:identifier>HE-EM-SM-076</dcterms:identifier>
        <dcterms:source>Grambsch &amp; Therneau 1994</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Scaled Schoenfeld</rdfs:label>
        <skos:definition xml:lang="en">A diagnostic technique testing the proportional hazards assumption by scaling Schoenfeld residuals by their variance to improve test power.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Grambsch-Therneau Test</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">PH Assumption Test</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Scaled Schoenfeld</skos:prefLabel>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/proportional-hazards-assumption"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-5"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/cox-proportional-hazards"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/scaled-schoenfeld"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/schoenfeld-residual"/>
        <dcterms:identifier>HEO-L-03257e46ceec</dcterms:identifier>
        <linkRationale xml:lang="en">Scaled Schoenfeld residuals are Schoenfeld residuals scaled by variance.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/scaled-schoenfeld"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#evaluates"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/proportional-hazards-assumption"/>
        <dcterms:identifier>HEO-L-c3203afae931</dcterms:identifier>
        <linkRationale xml:lang="en">Scaled Schoenfeld residuals test the proportional hazards assumption.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/scaled-schoenfeld"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cox-proportional-hazards"/>
        <dcterms:identifier>HEO-L-115e968bfb39</dcterms:identifier>
        <linkRationale xml:lang="en">The test is applied to a fitted Cox model.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
