        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Significance Testing</skos:altLabel>
        <skos:definition xml:lang="en">Hypothesis testing is a statistical decision framework that evaluates how compatible observed data are with a prespecified null hypothesis by comparing a test statistic with its sampling distribution under stated assumptions.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Null-Hypothesis Test</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Statistical Test</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Hypothesis Testing</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/statistical-significance"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/null-hypothesis"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/hypothesis-testing"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/inferential-statistics"/>
        <dcterms:identifier>HEO-L-37a516f6fa4d</dcterms:identifier>
        <linkRationale xml:lang="en">Hypothesis testing is one kind of inferential method, not a component of a branch of statistics</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
