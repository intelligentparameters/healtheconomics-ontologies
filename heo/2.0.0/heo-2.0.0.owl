        <skos:altLabel xml:lang="en">Weight Control</skos:altLabel>
        <skos:definition xml:lang="en">A clinical and behavioural approach to achieving and maintaining a healthy body weight, combining dietary counselling, activity guidance, and sometimes drug or surgical treatment.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Weight Loss Programme</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Weight Management</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/lifestyle-intervention"/>
    </owl:NamedIndividual>
