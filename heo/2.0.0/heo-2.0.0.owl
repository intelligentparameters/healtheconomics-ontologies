        <skos:altLabel xml:lang="en">NHB</skos:altLabel>
        <skos:definition xml:lang="en">Net health benefit (NHB) is the health an option gains, in QALYs, minus the QALYs its extra cost would buy elsewhere at the cost-effectiveness threshold.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Incremental Health Benefit</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Net Health Benefit</skos:prefLabel>
        <abbreviation xml:lang="en">NHB</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/icer"/>
