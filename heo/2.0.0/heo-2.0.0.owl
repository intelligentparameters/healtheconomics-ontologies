    <!-- https://healtheconomics.wiki/concept/dose-reduction -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/dose-reduction">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-PE-DT-012</skos:notation>
        <dcterms:identifier>HE-PE-DT-012</dcterms:identifier>
        <dcterms:source>DeVita, Lawrence &amp; Rosenberg 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Dose Reduction</rdfs:label>
        <skos:definition xml:lang="en">A decrease in the amount of medication given relative to the originally planned dose, typically in response to observed toxicity.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Dose Lowering</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Reduced Dosing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Dose Reduction</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/dose-intensity"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
