        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/dispersion"/>
        <skos:notation>HE-ES-SA-086</skos:notation>
        <dcterms:identifier>HE-ES-SA-086</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-24</dcterms:modified>
        <dcterms:source>Casella G, Berger RL. Statistical Inference. 2nd ed. Duxbury; 2002.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Interquartile Range</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">IQR</skos:altLabel>
        <skos:altLabel xml:lang="en">Midspread</skos:altLabel>
        <skos:definition xml:lang="en">A dispersion measure calculated as the difference between the seventy-fifth and twenty-fifth percentiles, the range containing the middle half of observations.</skos:definition>
        <skos:prefLabel xml:lang="en">Interquartile Range</skos:prefLabel>
        <abbreviation xml:lang="en">IQR</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/range"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/standard-deviation"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/interquartile-range"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-17d9c5d0876e</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Statistical methods in subdomain Evidence Synthesis; placed under Statistical Method, the concept named by its wiki topic</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/interquartile-range"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/dispersion"/>
        <dcterms:identifier>HEO-L-dda4be10f477</dcterms:identifier>
        <linkRationale xml:lang="en">IQR is a statistic quantifying dispersion (object definition names it)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
