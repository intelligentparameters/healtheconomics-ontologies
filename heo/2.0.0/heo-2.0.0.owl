        <rdfs:label xml:lang="en">Assent</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Assent is a child&apos;s affirmative agreement to join research, such as a paediatric trial supplying HTA evidence, given alongside parental permission.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Child Agreement</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Minor Agreement</skos:hiddenLabel>
