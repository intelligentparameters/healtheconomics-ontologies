        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/clinical-practice-variation"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/variation"/>
        <skos:notation>HS-NHS-HQ-083</skos:notation>
        <dcterms:identifier>HS-NHS-HQ-083</dcterms:identifier>
        <dcterms:source>Wennberg &amp; Gittelsohn 1973</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Unwarranted Variation</rdfs:label>
        <skos:altLabel xml:lang="en">Unwarranted Practice Variation</skos:altLabel>
        <skos:definition xml:lang="en">Differences in utilisation or practice unexplained by patient illness, preferences, or evidence-based medicine, unlike warranted variation reflecting legitimate need.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Unexplained Variation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Unwarranted Variation</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/small-area-variation"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/waste-in-healthcare"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
