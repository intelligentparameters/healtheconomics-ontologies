        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/decision-making"/>
        <dcterms:identifier>HEO-L-f7bffce72449</dcterms:identifier>
