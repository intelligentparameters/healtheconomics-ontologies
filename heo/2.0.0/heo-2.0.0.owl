    <!-- https://healtheconomics.wiki/concept/stochastic-frontier-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/stochastic-frontier-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/efficiency-frontier-analysis"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q7617818"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/efficiency-frontier-analysis"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/technical-efficiency"/>
        <skos:notation>HS-NHS-PM-020</skos:notation>
        <dcterms:identifier>HS-NHS-PM-020</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Aigner, Lovell &amp; Schmidt 1977</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Stochastic Frontier Analysis</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">SFA</skos:altLabel>
        <skos:definition xml:lang="en">A parametric method estimating relative efficiency of comparable units by modelling an efficiency frontier while accounting for random statistical noise.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Parametric Frontier Analysis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Stochastic Frontier Analysis</skos:prefLabel>
        <abbreviation xml:lang="en">SFA</abbreviation>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/stochastic-frontier-analysis"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/efficiency-frontier-analysis"/>
        <dcterms:identifier>HEO-L-4f04326e30d7</dcterms:identifier>
        <linkRationale xml:lang="en">SFA is an efficiency frontier method.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/stochastic-frontier-analysis"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
