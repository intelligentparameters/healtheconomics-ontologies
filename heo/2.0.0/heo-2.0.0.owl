    <!-- https://healtheconomics.wiki/concept/outcome-quality-indicator -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/outcome-quality-indicator">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
