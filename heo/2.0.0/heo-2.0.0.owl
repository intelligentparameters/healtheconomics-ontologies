    <!-- https://healtheconomics.wiki/concept/adjuvant-therapy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/adjuvant-therapy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/treatment"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q2481887"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/treatment"/>
        <skos:notation>HE-PE-ON-001</skos:notation>
        <dcterms:identifier>HE-PE-ON-001</dcterms:identifier>
        <dcterms:source>DeVita, Lawrence &amp; Rosenberg 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Adjuvant Therapy</rdfs:label>
        <skos:altLabel xml:lang="en">Adjuvant Treatment</skos:altLabel>
        <skos:definition xml:lang="en">Treatment given after a primary treatment, most commonly surgery, to eliminate remaining cancer cells and reduce the risk of recurrence.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Post-Surgical Therapy</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Adjuvant Therapy</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/neoadjuvant-therapy"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/recurrence"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/adjuvant-therapy"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/treatment"/>
        <dcterms:identifier>HEO-L-fa5181d2c132</dcterms:identifier>
        <linkRationale xml:lang="en">Adds backbone parent; definition: reduces the risk of recurrence.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
