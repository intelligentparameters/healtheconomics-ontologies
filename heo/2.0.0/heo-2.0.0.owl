    <!-- https://healtheconomics.wiki/concept/end-stage-renal-disease -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/end-stage-renal-disease">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
