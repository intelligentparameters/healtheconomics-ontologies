        <skos:altLabel xml:lang="en">Joined-Up Care</skos:altLabel>
        <skos:definition xml:lang="en">A care delivery model coordinating services across different providers, settings, and health system levels for a more seamless patient experience.</skos:definition>
        <skos:prefLabel xml:lang="en">Integrated Care</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/continuity-of-care"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
