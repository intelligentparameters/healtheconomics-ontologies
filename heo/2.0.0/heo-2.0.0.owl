        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Indication Bias</skos:altLabel>
        <skos:definition xml:lang="en">Confounding by indication is bias in observational treatment studies arising when the reason a patient is treated also affects their risk of the outcome.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Channelling Bias</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Confounding by Indication</skos:prefLabel>
