    <!-- https://healtheconomics.wiki/concept/concurrent-query -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/concurrent-query">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/physician-query"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
