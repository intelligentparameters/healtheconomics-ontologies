    <!-- https://healtheconomics.wiki/concept/dropout -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/dropout">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/attrition"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/attrition"/>
        <skos:notation>HE-ES-CTM-029</skos:notation>
        <dcterms:identifier>HE-ES-CTM-029</dcterms:identifier>
        <dcterms:source>Friedman LM, Furberg CD, DeMets DL, Reboussin DM, Granger CB. Fundamentals of Clinical Trials. 5th ed. Springer; 2015. doi:10.1007/978-3-319-18539-2.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Dropout</rdfs:label>
        <skos:altLabel xml:lang="en">Withdrawal</skos:altLabel>
        <skos:definition xml:lang="en">The premature discontinuation of a study participant&apos;s involvement before planned completion, whether from withdrawn consent, adverse events, or lost contact.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Participant Withdrawal</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Study Discontinuation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Dropout</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/treatment-discontinuation"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/missing-data"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/intention-to-treat-analysis"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/dropout"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/attrition"/>
        <dcterms:identifier>HEO-L-5a2bff668e57</dcterms:identifier>
        <linkRationale xml:lang="en">dropout is participant loss, i.e. attrition</linkRationale>
