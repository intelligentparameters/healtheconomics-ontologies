    <!-- https://healtheconomics.wiki/concept/sustainability -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/sustainability">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <skos:notation>HS-HP-HF-077</skos:notation>
        <dcterms:identifier>HS-HP-HF-077</dcterms:identifier>
        <dcterms:source>Brundtland Commission 1987</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Sustainability</rdfs:label>
        <skos:definition xml:lang="en">The capacity of a health system or programme to be maintained long term without depleting resources needed to meet future needs.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Continued Viability</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Enduring Capacity</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Sustainability</skos:prefLabel>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/health-system"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/sustainability"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-88d54ac63064</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health Financing: wiki topic Health financing and insurance sits in Health Systems; placed under Health System Financing, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/sustainability"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isPropertyOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-system"/>
        <dcterms:identifier>HEO-L-448dec53deea</dcterms:identifier>
        <linkRationale xml:lang="en">Sustainability is a capacity of a health system (subject definition), a characteristic not a component</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


