        <skos:hiddenLabel xml:lang="en">Digital Medical Chart</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Electronic Medical Record</skos:prefLabel>
        <abbreviation xml:lang="en">EMR</abbreviation>
        <produces rdf:resource="https://healtheconomics.wiki/concept/electronic-medical-record-data"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
