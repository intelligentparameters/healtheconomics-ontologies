    <!-- https://healtheconomics.wiki/concept/tunnel-state -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/tunnel-state">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/transient-state"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/transient-state"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/markov-model"/>
        <skos:notation>HE-EM-MM-030</skos:notation>
        <dcterms:identifier>HE-EM-MM-030</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-03</dcterms:modified>
        <dcterms:source>Sonnenberg &amp; Beck 1993</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Tunnel State</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">A tunnel state is one of a fixed sequence of one-cycle temporary states in a Markov model, letting risks, costs or utilities vary with time in a state.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Temporary State Sequence</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Tunnel Markov State</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Tunnel State</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/memorylessness"/>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/time-dependency"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/tunnel-state"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/transient-state"/>
        <dcterms:identifier>HEO-L-29f81774d63f</dcterms:identifier>
        <linkRationale xml:lang="en">A tunnel state is a temporary state patients leave, a transient state.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/tunnel-state"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/markov-model"/>
        <dcterms:identifier>HEO-L-3ce29aef1c37</dcterms:identifier>
