        <dcterms:source>Institute of Medicine. Initial National Priorities for Comparative Effectiveness Research. National Academies Press; 2009. doi:10.17226/12648.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Head-to-Head Comparison</rdfs:label>
        <skos:altLabel xml:lang="en">Direct Comparison</skos:altLabel>
        <skos:definition xml:lang="en">A trial directly comparing two or more active treatments against one another within the same study, rather than each against a separate common comparator.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Direct Head-to-Head Trial</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Head-to-Head Comparison</skos:prefLabel>
