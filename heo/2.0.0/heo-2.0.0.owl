    <!-- https://healtheconomics.wiki/concept/fully-incremental-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/fully-incremental-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/incremental-analysis-method"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/incremental-analysis-method"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <skos:notation>HE-EE-CEA-031</skos:notation>
        <dcterms:identifier>HE-EE-CEA-031</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Fully Incremental Analysis</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Full Incremental Analysis</skos:altLabel>
        <skos:definition xml:lang="en">Fully incremental analysis compares all mutually exclusive strategies in an ordered sequence to identify the cost-effectiveness frontier.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Sequential ICER Analysis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Fully Incremental Analysis</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/extended-dominance"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/icer"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/strict-dominance"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/fully-incremental-analysis"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/incremental-analysis-method"/>
        <dcterms:identifier>HEO-L-27eaef65863c</dcterms:identifier>
        <linkRationale xml:lang="en">Fully incremental analysis is an incremental method</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/fully-incremental-analysis"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <dcterms:identifier>HEO-L-5fb5d98bd221</dcterms:identifier>
        <linkRationale xml:lang="en">Ordering strategies and removing dominated options is the incremental step of a multi-option CEA</linkRationale>
