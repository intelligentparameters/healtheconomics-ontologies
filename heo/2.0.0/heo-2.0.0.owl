    <!-- https://healtheconomics.wiki/concept/device-therapy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/device-therapy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-technology"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-technology"/>
        <skos:notation>HE-PE-CV-033</skos:notation>
        <dcterms:identifier>HE-PE-CV-033</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Device Therapy</rdfs:label>
        <skos:definition xml:lang="en">A treatment approach using an implanted or external medical device rather than medication alone, such as a pacemaker or insulin pump.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Device-Based Treatment</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Therapeutic Device Use</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Device Therapy</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/medicinal-product"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
