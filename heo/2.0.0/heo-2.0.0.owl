        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Polypharmacy</rdfs:label>
        <skos:definition xml:lang="en">The concurrent use of multiple medications by a patient, most commonly defined as five or more regularly used medications, though definitions vary.</skos:definition>
