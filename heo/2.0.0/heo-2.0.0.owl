    <!-- https://healtheconomics.wiki/concept/kaiser-criterion -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/kaiser-criterion">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:notation>HE-ES-SA-091</skos:notation>
        <dcterms:identifier>HE-ES-SA-091</dcterms:identifier>
        <dcterms:source>Kaiser 1960</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Kaiser Criterion</rdfs:label>
        <skos:altLabel xml:lang="en">Eigenvalue-Greater-Than-One Rule</skos:altLabel>
        <skos:altLabel xml:lang="en">K1 Rule</skos:altLabel>
        <skos:definition xml:lang="en">A factor analysis rule retaining only factors with an eigenvalue greater than one, since these explain more variance than a single original variable.</skos:definition>
        <skos:prefLabel xml:lang="en">Kaiser Criterion</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/scree-plot"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/eigenvalue"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/kaiser-criterion"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
