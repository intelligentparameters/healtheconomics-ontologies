        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/subsidy"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/government-intervention"/>
        <dcterms:identifier>HEO-L-b1c22bc11760</dcterms:identifier>
        <linkRationale xml:lang="en">Subsidies are government payments made to influence market outcomes.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


