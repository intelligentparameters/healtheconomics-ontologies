    <!-- https://healtheconomics.wiki/concept/health-state-valuation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/health-state-valuation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:notation>HE-EE-HU-033</skos:notation>
        <dcterms:identifier>HE-EE-HU-033</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Torrance GW. Measurement of health state utilities for economic appraisal. Journal of Health Economics. 1986;5(1):1?30. doi:10.1016/0167-6296(86)90020-2.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Health State Valuation</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">Health state valuation is the elicitation and modelling of preferences for defined states of health to assign scores on a scale anchored by dead and full health for use in economic evaluation and related decisions.</skos:definition>
        <skos:hiddenLabel xml:lang="en">State Valuation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Utility Elicitation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Health State Valuation</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/outcomes#step-2"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/disability-weight"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/health-state-utility-value"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/preference-weight"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/scoring-algorithm"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/value-set"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/best-worst-scaling"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/matching-method"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/paired-comparison"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/standard-gamble"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/valuation-protocol"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
