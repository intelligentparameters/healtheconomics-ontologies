        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:altLabel xml:lang="en">National Value Set</skos:altLabel>
        <skos:definition xml:lang="en">A country-specific value set is a set of utility weights, elicited from one country&apos;s general public, that turns EQ-5D or similar responses into utilities.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Country Tariff</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Country-Specific Value Set</skos:prefLabel>
