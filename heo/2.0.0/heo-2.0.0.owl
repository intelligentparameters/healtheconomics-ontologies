    <!-- https://healtheconomics.wiki/concept/basket-of-countries -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/basket-of-countries">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
