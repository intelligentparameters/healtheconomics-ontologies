    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/treatment-de-escalation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/treatment-de-escalation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/treatment-pathway"/>
        <skos:notation>HE-PE-DT-052</skos:notation>
        <dcterms:identifier>HE-PE-DT-052</dcterms:identifier>
        <dcterms:source>DeVita, Lawrence &amp; Rosenberg 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Treatment De-escalation</rdfs:label>
        <skos:definition xml:lang="en">A planned reduction in treatment intensity, such as dose, frequency, or number of agents, once adequate disease control is achieved.</skos:definition>
        <skos:prefLabel xml:lang="en">Treatment De-escalation</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/treatment-escalation"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-de-escalation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-47a6ad1e892d</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Pharmacoeconomics &gt; Drug Therapy: dosing and treatment-line terms describe the clinical evidence and treatment pathways that models use</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-de-escalation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/treatment-pathway"/>
        <dcterms:identifier>HEO-L-7209d4f72bd1</dcterms:identifier>
        <linkRationale xml:lang="en">De-escalation lowers dose or agents, not sequential use of different agents; it is a step in a treatment pathway.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-de-escalation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/treatment-escalation"/>
        <dcterms:identifier>HEO-L-54efbe46c862</dcterms:identifier>
        <linkRationale xml:lang="en">Escalation and de-escalation are opposite planned changes in treatment intensity.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/treatment-discontinuation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/treatment-discontinuation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/persistence-outcome"/>
        <skos:notation>HE-PE-DT-053</skos:notation>
        <dcterms:identifier>HE-PE-DT-053</dcterms:identifier>
        <dcterms:source>Friedman LM, Furberg CD, DeMets DL, Reboussin DM, Granger CB. Fundamentals of Clinical Trials. 5th ed. Springer; 2015. doi:10.1007/978-3-319-18539-2.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Treatment Discontinuation</rdfs:label>
        <skos:definition xml:lang="en">The cessation of a prescribed treatment before its originally planned completion, whether from adverse effects, lack of efficacy, or patient preference.</skos:definition>
        <skos:prefLabel xml:lang="en">Treatment Discontinuation</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-discontinuation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-fbf7ceb34502</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Pharmacoeconomics &gt; Drug Therapy: dosing and treatment-line terms describe the clinical evidence and treatment pathways that models use</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-discontinuation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/persistence-outcome"/>
        <dcterms:identifier>HEO-L-ff0d65de5e59</dcterms:identifier>
        <linkRationale xml:lang="en">Persistence is time from initiation to discontinuation</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/treatment-duration -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/treatment-duration">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-PE-DT-054</skos:notation>
        <dcterms:identifier>HE-PE-DT-054</dcterms:identifier>
        <dcterms:source>Katzung 2017</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Treatment Duration</rdfs:label>
        <skos:definition xml:lang="en">The total length of time a patient receives a specific treatment course, whether fixed in advance or continued until an endpoint.</skos:definition>
        <skos:prefLabel xml:lang="en">Treatment Duration</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/drug-cost"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/treatment"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-duration"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-c659e253b366</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Pharmacoeconomics &gt; Drug Therapy: dosing and treatment-line terms describe the clinical evidence and treatment pathways that models use</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-duration"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-cost"/>
        <dcterms:identifier>HEO-L-1f242fbfd6b5</dcterms:identifier>
        <linkRationale xml:lang="en">A fixed treatment duration is not time-to-event data; duration drives total drug cost in models.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-duration"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isPropertyOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/treatment"/>
        <dcterms:identifier>HEO-L-ef39f3ceec51</dcterms:identifier>
        <linkRationale xml:lang="en">Duration is a characteristic of a treatment course.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/treatment-effect -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/treatment-effect">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/effect-size"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/effect-size"/>
        <skos:notation>HE-ES-CER-028</skos:notation>
        <dcterms:identifier>HE-ES-CER-028</dcterms:identifier>
        <dcterms:source>Rubin 1974</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Treatment Effect</rdfs:label>
        <skos:definition xml:lang="en">The change in an outcome attributable to a specific treatment, distinguished from changes that would have occurred regardless due to other factors.</skos:definition>
        <skos:prefLabel xml:lang="en">Treatment Effect</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-5"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-effect"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/effect-size"/>
        <dcterms:identifier>HEO-L-8480f8f9ad28</dcterms:identifier>
        <linkRationale xml:lang="en">A treatment effect is expressed as the size of an intervention effect, an effect size.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/treatment-effect-heterogeneity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/treatment-effect-heterogeneity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <dcterms:isReplacedBy rdf:resource="https://healtheconomics.wiki/concept/heterogeneous-treatment-effect"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">obsolete Treatment Effect Heterogeneity</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:prefLabel xml:lang="en">obsolete Treatment Effect Heterogeneity</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/concept/treatment-emergent-adverse-event -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/treatment-emergent-adverse-event">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/adverse-event"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/adverse-event"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/adverse-event-rate"/>
        <skos:notation>PP-PC-MS-015</skos:notation>
        <dcterms:identifier>PP-PC-MS-015</dcterms:identifier>
        <dcterms:source>ICH, Good Clinical Practice Guideline (E6)</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Treatment-Emergent Adverse Event</rdfs:label>
        <skos:definition xml:lang="en">An adverse event occurring or worsening during a trial period following study treatment administration, regardless of whether causally related.</skos:definition>
        <skos:prefLabel xml:lang="en">Treatment-Emergent Adverse Event</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-emergent-adverse-event"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/adverse-event"/>
        <dcterms:identifier>HEO-L-20c177f41e4b</dcterms:identifier>
        <linkRationale xml:lang="en">A TEAE is an adverse event defined by timing after treatment.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-emergent-adverse-event"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/adverse-event-rate"/>
        <dcterms:identifier>HEO-L-4fef5b6d52da</dcterms:identifier>
        <linkRationale xml:lang="en">Trial adverse event rates are counted from treatment-emergent events</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/treatment-escalation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/treatment-escalation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/treatment-pathway"/>
        <skos:notation>HE-PE-DT-055</skos:notation>
        <dcterms:identifier>HE-PE-DT-055</dcterms:identifier>
        <dcterms:source>DeVita, Lawrence &amp; Rosenberg 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Treatment Escalation</rdfs:label>
        <skos:definition xml:lang="en">A planned increase in treatment intensity, such as raising dose or adding agents, typically when the current regimen fails to control disease.</skos:definition>
        <skos:prefLabel xml:lang="en">Treatment Escalation</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/add-on-therapy"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-escalation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-83a50afa244e</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Pharmacoeconomics &gt; Drug Therapy: dosing and treatment-line terms describe the clinical evidence and treatment pathways that models use</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-escalation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/treatment-pathway"/>
        <dcterms:identifier>HEO-L-c0ef0126a8b9</dcterms:identifier>
        <linkRationale xml:lang="en">Escalation raises dose or adds agents, not sequential use of different agents; it is a step in a treatment pathway.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-escalation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/add-on-therapy"/>
        <dcterms:identifier>HEO-L-7068bbeaca64</dcterms:identifier>
        <linkRationale xml:lang="en">Escalation includes adding agents; adding to a regimen is the alternative to switching drug.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/treatment-expectation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/treatment-expectation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:notation>HE-ES-CO-090</skos:notation>
        <dcterms:identifier>HE-ES-CO-090</dcterms:identifier>
        <dcterms:source>Kirsch 1985</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Treatment Expectation</rdfs:label>
        <skos:definition xml:lang="en">A patient&apos;s anticipated belief about how effective a treatment will be, which can independently influence their actual experienced outcome, especially for pain.</skos:definition>
        <skos:prefLabel xml:lang="en">Treatment Expectation</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/placebo-effect"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-expectation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-af2d294ce129</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Clinical Outcomes: concepts with this Level 3 that the wiki places in a topic sit in Outcomes (Clinical and patient-reported outcomes)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-expectation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/placebo-effect"/>
        <dcterms:identifier>HEO-L-9a7f5883e9b4</dcterms:identifier>
        <linkRationale xml:lang="en">Expectation of benefit drives the placebo response, especially for pain.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/treatment-failure -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/treatment-failure">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q56317195"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome"/>
        <precedes rdf:resource="https://healtheconomics.wiki/concept/salvage-therapy"/>
        <skos:notation>HE-ES-CO-091</skos:notation>
        <dcterms:identifier>HE-ES-CO-091</dcterms:identifier>
        <dcterms:source>U.S. Food and Drug Administration. Guidance for Industry: Patient-Reported Outcome Measures-Use in Medical Product Development to Support Labeling Claims. FDA; 2009.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Treatment Failure</rdfs:label>
        <skos:definition xml:lang="en">A clinical outcome indicating a treatment did not achieve its intended goal, whether shown by lack of improvement, disease progression, or a therapy switch.</skos:definition>
        <skos:prefLabel xml:lang="en">Treatment Failure</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/treatment-success"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/treatment-discontinuation"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-failure"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome"/>
        <dcterms:identifier>HEO-L-3ddbaaf63c59</dcterms:identifier>
        <linkRationale xml:lang="en">Treatment failure is a clinical outcome by definition.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-failure"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#precedes"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/salvage-therapy"/>
        <dcterms:identifier>HEO-L-23b4464a0514</dcterms:identifier>
        <linkRationale xml:lang="en">added or retargeted in the graph connectivity review (15 Oct 2026), checked by an independent link checker</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-failure"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/treatment-success"/>
        <dcterms:identifier>HEO-L-12ad6caa6f49</dcterms:identifier>
        <linkRationale xml:lang="en">Treatment failure and treatment success are defined as opposites.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-failure"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/treatment-discontinuation"/>
        <dcterms:identifier>HEO-L-bc4025e924eb</dcterms:identifier>
        <linkRationale xml:lang="en">Lack of efficacy is a stated cause of discontinuation.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/treatment-free-interval -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/treatment-free-interval">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/time-to-event"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/time-to-event"/>
        <skos:notation>HE-PE-DT-061</skos:notation>
        <dcterms:identifier>HE-PE-DT-061</dcterms:identifier>
        <dcterms:source>DeVita, Lawrence &amp; Rosenberg 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Treatment-Free Interval</rdfs:label>
        <skos:definition xml:lang="en">The period between completing one treatment course and starting the next, during which a patient receives no active therapy for the condition.</skos:definition>
        <skos:prefLabel xml:lang="en">Treatment-Free Interval</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/time-on-treatment"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-free-interval"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/time-to-event"/>
        <dcterms:identifier>HEO-L-04fa1715b1cd</dcterms:identifier>
        <linkRationale xml:lang="en">The interval to restarting therapy is measured as time-to-event data, possibly censored.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-free-interval"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/time-on-treatment"/>
        <dcterms:identifier>HEO-L-88986022461f</dcterms:identifier>
        <linkRationale xml:lang="en">Time off therapy versus time on therapy are the paired durations.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/treatment-free-remission -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/treatment-free-remission">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/remission"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/remission"/>
        <skos:notation>HE-ES-CO-095</skos:notation>
        <dcterms:identifier>HE-ES-CO-095</dcterms:identifier>
        <dcterms:source>Mahon et al. 2010</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Treatment-Free Remission</rdfs:label>
        <skos:altLabel xml:lang="en">TFR</skos:altLabel>
        <skos:definition xml:lang="en">A leukaemia outcome in which a patient with sufficiently deep, durable molecular response discontinues treatment entirely while maintaining disease control.</skos:definition>
        <skos:prefLabel xml:lang="en">Treatment-Free Remission</skos:prefLabel>
        <abbreviation xml:lang="en">TFR</abbreviation>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/drug-cost"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-free-remission"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome"/>
        <dcterms:identifier>HEO-L-88967a9b927b</dcterms:identifier>
        <linkRationale xml:lang="en">Treatment-free remission is a clinical outcome in leukaemia.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-free-remission"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/remission"/>
        <dcterms:identifier>HEO-L-ad181b3c853d</dcterms:identifier>
        <linkRationale xml:lang="en">Treatment-free remission is a remission maintained without therapy.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-free-remission"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-cost"/>
        <dcterms:identifier>HEO-L-34740d84ab74</dcterms:identifier>
        <linkRationale xml:lang="en">Stopping long-term TKI therapy removes ongoing drug cost, its main economic relevance.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/treatment-gap -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/treatment-gap">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/unmet-need"/>
        <skos:notation>HS-HP-HTA-225</skos:notation>
        <dcterms:identifier>HS-HP-HTA-225</dcterms:identifier>
        <dcterms:source>National Institute for Health and Care Excellence. NICE technology appraisal and highly specialised technologies guidance: the manual (PMG36). Published 2022; updated 2026.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Treatment Gap</rdfs:label>
        <skos:definition xml:lang="en">The difference between the number of people who could clinically benefit from a treatment and the number who actually receive it.</skos:definition>
        <skos:prefLabel xml:lang="en">Treatment Gap</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/priority-setting"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-gap"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-c696fdd4f67e</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health Technology Assessment: HTA concepts belong to the HTA subdomain</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-gap"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/unmet-need"/>
        <dcterms:identifier>HEO-L-2d04af4fd082</dcterms:identifier>
        <linkRationale xml:lang="en">The treatment gap quantifies unmet treatment need</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-gap"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/priority-setting"/>
        <dcterms:identifier>HEO-L-e36e4158320c</dcterms:identifier>
