    <!-- https://healtheconomics.wiki/concept/activity-based-budget -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/activity-based-budget">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/budget-planning"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/budget-planning"/>
        <skos:notation>HE-EE-BIA-001</skos:notation>
        <dcterms:identifier>HE-EE-BIA-001</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-03</dcterms:modified>
        <dcterms:source>Jiang et al. 2022</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Activity-Based Budgeting</rdfs:label>
        <owl:versionInfo>1.0.5</owl:versionInfo>
        <skos:altLabel xml:lang="en">ABB</skos:altLabel>
        <skos:definition xml:lang="en">Activity-based budgeting (ABB) builds a health service budget from forecast service volumes, the activities each needs and each activity&apos;s cost per unit.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Activity-Driven Budget</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Activity-Based Budgeting</skos:prefLabel>
        <abbreviation xml:lang="en">ABB</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/incremental-budget"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-4"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/capacity-planning"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/activity-based-costing"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/cost-driver"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/demand-forecasting"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/activity-based-budget"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/budget-planning"/>
        <dcterms:identifier>HEO-L-e396ed4bafc7</dcterms:identifier>
        <linkRationale xml:lang="en">ABB builds a budget for the next period from activity forecasts; it is a budget planning method, not division of a fixed budget</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
