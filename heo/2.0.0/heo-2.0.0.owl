        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/information-economics"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#explains"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/signaling"/>
        <dcterms:identifier>HEO-L-a123cc689a1d</dcterms:identifier>
        <linkRationale xml:lang="en">Topic within a field; information economics is the theory that accounts for signalling (object definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


