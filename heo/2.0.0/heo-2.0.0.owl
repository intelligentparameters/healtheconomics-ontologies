        <rdfs:label xml:lang="en">Secondary Research</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">Secondary research is research that summarises existing studies instead of collecting new data, as in systematic reviews and meta-analyses.</skos:definition>
