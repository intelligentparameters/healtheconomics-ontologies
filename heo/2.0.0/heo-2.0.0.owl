        <skos:altLabel xml:lang="en">Confidence in Evidence</skos:altLabel>
        <skos:altLabel xml:lang="en">Evidence Certainty</skos:altLabel>
        <skos:definition xml:lang="en">Certainty of evidence is GRADE&apos;s rating, from high to very low, of confidence that a true effect falls on one side of a threshold or within a chosen range.</skos:definition>
        <skos:prefLabel xml:lang="en">Certainty of Evidence</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/recommendation-strength"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/body-of-evidence"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/certainty-of-evidence"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-assessment"/>
