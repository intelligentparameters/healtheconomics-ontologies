    <!-- https://healtheconomics.wiki/concept/just-culture -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/just-culture">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/safety-culture"/>
        <skos:notation>HS-NHS-HQ-037</skos:notation>
        <dcterms:identifier>HS-NHS-HQ-037</dcterms:identifier>
        <dcterms:source>Marx 2001</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Just Culture</rdfs:label>
        <skos:definition xml:lang="en">An organisational approach distinguishing human error, at-risk behaviour, and reckless behaviour, applying a calibrated response to each rather than uniform blame.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Fair Blame Culture</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Just Safety Culture</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Just Culture</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/blame-free-reporting"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/patient-safety"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/high-reliability-organization"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/incident-reporting"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/just-culture"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-f6113aaa0424</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; NHS Productivity &gt; Healthcare Quality: wiki topic Performance, productivity and quality sits in Health Systems; placed under Quality of Care, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/just-culture"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
