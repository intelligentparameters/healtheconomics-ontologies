    <!-- https://healtheconomics.wiki/concept/non-adherence -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/non-adherence">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>PP-PC-MA-004</skos:notation>
        <dcterms:identifier>PP-PC-MA-004</dcterms:identifier>
        <dcterms:source>Cramer et al. 2008</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Non-Adherence</rdfs:label>
        <skos:definition xml:lang="en">A patient&apos;s failure to take a prescribed medication or follow a regimen as directed, whether unintentional, such as forgetting, or intentional.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Medication Non-Compliance</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Non-Compliance</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Non-Adherence</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/treatment-adherence"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/treatment-failure"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/non-adherence"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-09d2b309d635</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Pharmacy Practice &gt; Pharmaceutical Care &gt; Medication Adherence: pharmacy services are part of health care delivery</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/non-adherence"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/treatment-adherence"/>
        <dcterms:identifier>HEO-L-27257f006c78</dcterms:identifier>
        <linkRationale xml:lang="en">Failure to follow a regimen versus adherence to it</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
