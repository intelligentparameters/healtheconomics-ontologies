        <dcterms:identifier>HS-HP-HTA-214</dcterms:identifier>
        <dcterms:source>National Institute for Health and Care Excellence. NICE technology appraisal and highly specialised technologies guidance: the manual (PMG36). Published 2022; updated 2026.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Technology Appraisal</rdfs:label>
        <skos:definition xml:lang="en">A specific type of assessment evaluating whether a technology represents an appropriate use of health system resources, resulting in a funding recommendation.</skos:definition>
