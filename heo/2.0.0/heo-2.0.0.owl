    <!-- https://healtheconomics.wiki/concept/solvency -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/solvency">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <skos:notation>HS-HP-HF-074</skos:notation>
        <dcterms:identifier>HS-HP-HF-074</dcterms:identifier>
        <dcterms:source>Horngren, Datar &amp; Rajan 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Solvency</rdfs:label>
        <skos:definition xml:lang="en">The financial capacity of an organisation, such as an insurer or hospital, to meet its long-term financial obligations as they come due.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Ability to Pay Debts</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Long-Term Viability</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Solvency</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/fiscal-sustainability"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
