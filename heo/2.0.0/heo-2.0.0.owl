    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/waiver-of-consent -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/waiver-of-consent">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HS-HP-HSG-033</skos:notation>
        <dcterms:identifier>HS-HP-HSG-033</dcterms:identifier>
        <dcterms:source>HHS, Common Rule (45 CFR 46)</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Waiver of Consent</rdfs:label>
        <skos:definition xml:lang="en">A regulatory determination permitting research to proceed without standard informed consent under narrowly defined conditions, such as minimal risk studies.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Consent Waiver</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Waived Consent</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Waiver of Consent</skos:prefLabel>
        <modifies rdf:resource="https://healtheconomics.wiki/concept/informed-consent"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/waiver-of-consent"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-120b7d05728a</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: curated: review B: research consent waiver belongs to Trial and study design (research ethics)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/waiver-of-consent"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#modifies"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/informed-consent"/>
        <dcterms:identifier>HEO-L-4eaf1c5fdf9d</dcterms:identifier>
        <linkRationale xml:lang="en">A waiver is a regulatory determination, not a branch of ethics; it changes when informed consent applies.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/wald-test -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/wald-test">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/hypothesis-testing"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q748664"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/hypothesis-testing"/>
        <skos:notation>HE-EM-MV-091</skos:notation>
        <dcterms:identifier>HE-EM-MV-091</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Wald 1943</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Wald Test</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Wald Chi-Square Test</skos:altLabel>
        <skos:altLabel xml:lang="en">Wald Statistic</skos:altLabel>
        <skos:definition xml:lang="en">A statistical test assessing whether an estimated parameter differs significantly from a specified value, based on the ratio of estimate to standard error.</skos:definition>
        <skos:prefLabel xml:lang="en">Wald Test</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/likelihood-ratio-test"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-9"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/standard-normal"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/wald-test"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/hypothesis-testing"/>
        <dcterms:identifier>HEO-L-615ddcc868d6</dcterms:identifier>
        <linkRationale xml:lang="en">The Wald test is a hypothesis test.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/wald-test"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/likelihood-ratio-test"/>
        <dcterms:identifier>HEO-L-a59b1ee90723</dcterms:identifier>
        <linkRationale xml:lang="en">Full page kept; Wald and likelihood ratio tests are alternative likelihood-based tests of the same hypothesis.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/wald-test"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/standard-normal"/>
        <dcterms:identifier>HEO-L-b873289772c1</dcterms:identifier>
        <linkRationale xml:lang="en">The Wald statistic (estimate divided by SE) is referred to the standard normal.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


