    <!-- https://healtheconomics.wiki/concept/uncertainty -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/uncertainty">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:notation>HE-EM-UA-080</skos:notation>
        <dcterms:identifier>HE-EM-UA-080</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</dcterms:modified>
        <dcterms:source>Briggs et al. 2012</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Uncertainty</rdfs:label>
        <owl:versionInfo>1.0.3</owl:versionInfo>
        <skos:definition xml:lang="en">Uncertainty in health economics is imperfect knowledge of a model&apos;s true inputs, structure or methods, so the option chosen as best may prove to be wrong.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Imperfect Knowledge</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Incomplete Information</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Uncertainty</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/decision-uncertainty"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/uncertainty"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-1581140bc0f7</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Modelling &gt; Uncertainty Analysis: catalogue subdomain Economic Modelling is one of the subdomains</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/uncertainty"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/decision-uncertainty"/>
        <dcterms:identifier>HEO-L-e5982f1d2a80</dcterms:identifier>
        <linkRationale xml:lang="en">Uncertainty in inputs produces decision uncertainty.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
