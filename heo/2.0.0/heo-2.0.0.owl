        <rdfs:label xml:lang="en">Per-Protocol Population</rdfs:label>
        <skos:altLabel xml:lang="en">PP Population</skos:altLabel>
        <skos:definition xml:lang="en">The subset of trial participants who completed the study while closely adhering to the protocol, used as the analysis population for a per-protocol analysis.</skos:definition>
