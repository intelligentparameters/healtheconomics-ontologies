        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:notation>HS-HP-PSE-002</skos:notation>
        <dcterms:identifier>HS-HP-PSE-002</dcterms:identifier>
        <dcterms:source>Buchanan &amp; Tullock 1962</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Public Choice Theory</rdfs:label>
        <skos:altLabel xml:lang="en">Public Choice Economics</skos:altLabel>
        <skos:definition xml:lang="en">A branch of economics applying the tools of economic analysis, including self-interested behaviour, to political and governmental decision-making.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Political Economy of Choice</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Public Choice Theory</skos:prefLabel>
