    <!-- https://healtheconomics.wiki/concept/f-distribution -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/f-distribution">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
