    <!-- https://healtheconomics.wiki/concept/societal-cost -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/societal-cost">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <skos:notation>HS-DC-HC-016</skos:notation>
        <dcterms:identifier>HS-DC-HC-016</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Societal Cost</rdfs:label>
        <skos:definition xml:lang="en">The total cost of an intervention from the broadest perspective, covering direct healthcare, direct non-medical, and indirect costs regardless of who bears them.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Societal Perspective Cost</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Total Social Cost</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Societal Cost</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/societal-cost"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <dcterms:identifier>HEO-L-de5479cc66cd</dcterms:identifier>
        <linkRationale xml:lang="en">Societal cost is a cost category.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/societal-perspective -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/societal-perspective">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/perspective"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/perspective"/>
        <skos:notation>HE-EE-CEA-058</skos:notation>
        <dcterms:identifier>HE-EE-CEA-058</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-03</dcterms:modified>
        <dcterms:source>Sanders et al. 2016</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Societal Perspective</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Social Perspective</skos:altLabel>
        <skos:definition xml:lang="en">The societal perspective is an economic evaluation viewpoint that counts all costs and outcomes, whoever bears them, including productivity and carer time.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Whole-Society Viewpoint</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Societal Perspective</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/healthcare-sector-perspective"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/societal-cost"/>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/societal-value"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/friction-cost-method"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/human-capital-approach"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/societal-perspective"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/perspective"/>
        <dcterms:identifier>HEO-L-50e607c9b501</dcterms:identifier>
        <linkRationale xml:lang="en">The societal perspective is one perspective.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/societal-perspective"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
