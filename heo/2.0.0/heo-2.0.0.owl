    <!-- https://healtheconomics.wiki/concept/alliance-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/alliance-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q131844295"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-SS_HSM-002</skos:notation>
        <dcterms:identifier>HS-SS_HSM-002</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Billings &amp; de Weger 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Alliance Model</rdfs:label>
        <owl:versionInfo>1.0.3</owl:versionInfo>
        <skos:definition xml:lang="en">An alliance model is a health care arrangement in which independent providers and commissioners share goals, decisions, risk and reward without merging.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Alliance Contracting</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Collaborative Alliance</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Alliance Model</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/vertically-integrated"/>
