    <!-- https://healtheconomics.wiki/concept/transfer-management -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/transfer-management">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
