        <dcterms:identifier>HEO-L-23475c87037b</dcterms:identifier>
        <linkRationale xml:lang="en">Capital costs do not vary with volume in the short run</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
