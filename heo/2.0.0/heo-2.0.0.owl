    <!-- https://healtheconomics.wiki/concept/fee-for-service-incentive -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/fee-for-service-incentive">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <skos:notation>HS-HP-PP-052</skos:notation>
        <dcterms:identifier>HS-HP-PP-052</dcterms:identifier>
        <dcterms:source>Folland, Goodman &amp; Stano 2016</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Fee-For-Service Incentive</rdfs:label>
        <skos:altLabel xml:lang="en">FFS Volume Incentive</skos:altLabel>
        <skos:definition xml:lang="en">The financial incentive within fee-for-service payment where revenue rises with service volume, independent of necessity or value of care given.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Volume Incentive</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Fee-For-Service Incentive</skos:prefLabel>
        <abbreviation xml:lang="en">FFS Volume Incentive</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/value-based-purchasing"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/overutilization"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/supplier-induced-demand"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/fee-for-service"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/fee-for-service-incentive"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-1ee0462d1e67</dcterms:identifier>
