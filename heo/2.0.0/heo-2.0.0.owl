    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/cumulative-hazard -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cumulative-hazard">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/cox-snell-residual"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/survival-function"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/transition-probability"/>
        <skos:notation>HE-EM-SM-010</skos:notation>
        <dcterms:identifier>HE-EM-SM-010</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Collett 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cumulative Hazard</rdfs:label>
        <owl:versionInfo>1.0.3</owl:versionInfo>
        <skos:altLabel xml:lang="en">Integrated Hazard</skos:altLabel>
        <skos:definition xml:lang="en">Cumulative hazard, H(t), is the hazard rate summed over time in survival models. Survival equals exp(-H(t)), and unlike a probability H(t) can exceed 1.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Accumulated Hazard</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cumulative Hazard</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/cumulative-incidence"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cumulative-hazard"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-1dac72885795</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Survival analysis and extrapolation in subdomain Economic Modelling</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cumulative-hazard"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cox-snell-residual"/>
        <dcterms:identifier>HEO-L-7cb91d163c41</dcterms:identifier>
        <linkRationale xml:lang="en">A Cox-Snell residual is the fitted cumulative hazard at the observed time</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cumulative-hazard"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/survival-function"/>
        <dcterms:identifier>HEO-L-fbf3ec90cb47</dcterms:identifier>
        <linkRationale xml:lang="en">S(t) = exp(-H(t)) (subject definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cumulative-hazard"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/transition-probability"/>
        <dcterms:identifier>HEO-L-d230b95f01d5</dcterms:identifier>
        <linkRationale xml:lang="en">Per-cycle TP is 1 minus exp of minus the change in cumulative hazard (Briggs et al. 2006)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
