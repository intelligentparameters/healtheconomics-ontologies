        <skos:altLabel xml:lang="en">Charitable Hospital</skos:altLabel>
        <skos:altLabel xml:lang="en">Not-for-Profit Hospital</skos:altLabel>
        <skos:definition xml:lang="en">A hospital organised as a non-profit entity, reinvesting operating surplus rather than distributing it, typically in exchange for tax-exempt status.</skos:definition>
        <skos:prefLabel xml:lang="en">Non-Profit Hospital</skos:prefLabel>
        <performs rdf:resource="https://healtheconomics.wiki/concept/charity-care"/>
        <performs rdf:resource="https://healtheconomics.wiki/concept/community-benefit"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
