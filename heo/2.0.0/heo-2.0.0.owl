    <!-- https://healtheconomics.wiki/concept/therapeutic-index -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/therapeutic-index">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q659446"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-PE-DT-047</skos:notation>
        <dcterms:identifier>HE-PE-DT-047</dcterms:identifier>
        <dcterms:source>Rowland &amp; Tozer 2010</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Therapeutic Index</rdfs:label>
        <skos:altLabel xml:lang="en">Therapeutic Ratio</skos:altLabel>
        <skos:definition xml:lang="en">A drug&apos;s safety margin, calculated as the ratio between the dose that produces toxicity and the dose producing the desired effect.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Safety Margin Index</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Therapeutic Index</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/dose-finding"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/medicinal-product"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/therapeutic-index"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-55b5e988af12</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Pharmacoeconomics &gt; Drug Therapy: dosing and treatment-line terms describe the clinical evidence and treatment pathways that models use</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/therapeutic-index"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/dose-finding"/>
        <dcterms:identifier>HEO-L-e6929242968d</dcterms:identifier>
        <linkRationale xml:lang="en">The toxic-to-effective dose ratio guides dose selection.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/therapeutic-index"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isPropertyOf"/>
