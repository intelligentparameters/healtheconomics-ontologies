    <!-- https://healtheconomics.wiki/concept/high-reliability-organization -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/high-reliability-organization">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <skos:notation>HS-NHS-HQ-033</skos:notation>
        <dcterms:identifier>HS-NHS-HQ-033</dcterms:identifier>
        <dcterms:source>Weick &amp; Sutcliffe 2001</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">High Reliability Organization</rdfs:label>
        <skos:altLabel xml:lang="en">HRO</skos:altLabel>
        <skos:definition xml:lang="en">An organisation operating in a high-risk environment that consistently achieves exceptionally low serious failure rates through specific cultural characteristics.</skos:definition>
        <skos:hiddenLabel xml:lang="en">High-Reliability Healthcare Organisation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">High Reliability Organization</skos:prefLabel>
        <abbreviation xml:lang="en">HRO</abbreviation>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/patient-safety"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/quality-improvement"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/high-reliability-organization"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-3f52729ec63a</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; NHS Productivity &gt; Healthcare Quality: wiki topic Performance, productivity and quality sits in Health Systems; placed under Quality of Care, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/high-reliability-organization"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/patient-safety"/>
        <dcterms:identifier>HEO-L-e4e80061e22c</dcterms:identifier>
        <linkRationale xml:lang="en">HROs aim at very low serious failure rates.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
