    <!-- https://healtheconomics.wiki/concept/preference-based-measure -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/preference-based-measure">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcome-measure"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/outcome-measure"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/qaly"/>
        <skos:notation>HE-EE-HU-057</skos:notation>
        <dcterms:identifier>HE-EE-HU-057</dcterms:identifier>
        <dcterms:source>Brazier et al. 2007</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Preference-Based Measure</rdfs:label>
        <skos:definition xml:lang="en">A health status instrument whose scoring derives from a formal preference elicitation exercise, so its scores can be used directly as utility values for QALYs.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Preference-Elicited Instrument</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Preference-Weighted Measure</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Preference-Based Measure</skos:prefLabel>
        <produces rdf:resource="https://healtheconomics.wiki/concept/multi-attribute-utility"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/preference-based-measure"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/outcome-measure"/>
        <dcterms:identifier>HEO-L-f8c1094bb2ec</dcterms:identifier>
        <linkRationale xml:lang="en">A preference-based measure is an outcome measure</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/preference-based-measure"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/qaly"/>
        <dcterms:identifier>HEO-L-6ab88c11fd27</dcterms:identifier>
        <linkRationale xml:lang="en">The subject definition says its scores are used directly as utilities for QALYs</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/preference-based-measure"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#produces"/>
