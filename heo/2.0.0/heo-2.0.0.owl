        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Transitional Care</rdfs:label>
        <skos:definition xml:lang="en">Actions ensuring the coordination and continuity of care as patients transfer between different locations or levels of care.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Inter-Setting Care</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Transition-of-Care Service</skos:hiddenLabel>
