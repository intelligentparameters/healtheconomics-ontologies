        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Decision Relevance Period</rdfs:label>
        <skos:definition xml:lang="en">The length of time a technology assessment decision is expected to remain applicable before newer evidence or treatments supersede it.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Decision Validity Period</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Relevance Horizon</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Decision Relevance Period</skos:prefLabel>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/coverage-decision"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
