    <!-- https://healtheconomics.wiki/concept/medication-therapy-management -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/medication-therapy-management">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
