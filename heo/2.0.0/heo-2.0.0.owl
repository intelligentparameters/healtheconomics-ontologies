        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/demand-for-health"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/revealed-preference"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
