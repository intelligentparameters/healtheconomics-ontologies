    <!-- https://healtheconomics.wiki/concept/external-reference-pricing -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/external-reference-pricing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/price-linkage"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/reference-pricing"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q85760110"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/price-linkage"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/reference-pricing"/>
        <skos:notation>HS-DC-DP-029</skos:notation>
        <dcterms:identifier>HS-DC-DP-029</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Danzon 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">External Reference Pricing</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">ERP</skos:altLabel>
        <skos:definition xml:lang="en">A medicine-pricing policy that uses prices for the same or comparable product in other jurisdictions as benchmarks for a domestic price or reimbursement decision.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cross-Country Reference Pricing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">External Reference Pricing</skos:prefLabel>
        <abbreviation xml:lang="en">ERP</abbreviation>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-policy#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/list-price"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/external-reference-pricing"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <dcterms:identifier>HEO-L-7d498407f378</dcterms:identifier>
        <linkRationale xml:lang="en">ERP is a drug pricing policy</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
