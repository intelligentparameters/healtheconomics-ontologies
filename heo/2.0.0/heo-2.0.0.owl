    <!-- https://healtheconomics.wiki/concept/multivariate-meta-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/multivariate-meta-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/meta-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/meta-analysis"/>
        <skos:notation>HE-ES-ESM-037</skos:notation>
        <dcterms:identifier>HE-ES-ESM-037</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-24</dcterms:modified>
        <dcterms:source>Jackson, Riley &amp; White 2011</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Multivariate Meta-Analysis</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">MVMA</skos:altLabel>
        <skos:definition xml:lang="en">A meta-analysis method jointly analysing two or more related outcomes simultaneously, accounting for the correlation between them.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Joint Meta-Analysis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Multivariate Meta-Analysis</skos:prefLabel>
        <abbreviation xml:lang="en">MVMA</abbreviation>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/surrogate-endpoint"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-4"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/random-effects-model"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/multivariate-meta-analysis"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/meta-analysis"/>
        <dcterms:identifier>HEO-L-6fe5c25dcc34</dcterms:identifier>
        <linkRationale xml:lang="en">A meta-analysis method</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
