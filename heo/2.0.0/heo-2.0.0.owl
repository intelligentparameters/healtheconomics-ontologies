        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/patent-extension"/>
        <dcterms:identifier>HEO-L-46664969ad0e</dcterms:identifier>
        <linkRationale xml:lang="en">The SPC (current EU Regulation 469/2009) extends patent-based protection to compensate for regulatory review time.</linkRationale>
