    <!-- https://healtheconomics.wiki/concept/reimbursement-restriction -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/reimbursement-restriction">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/market-access"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
