    <!-- https://healtheconomics.wiki/concept/pharmacoeconomic-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/pharmacoeconomic-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-economic-model"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-economic-model"/>
        <skos:notation>HE-EM-DM-078</skos:notation>
        <dcterms:identifier>HE-EM-DM-078</dcterms:identifier>
        <dcterms:source>Bootman, Townsend &amp; McGhan 2005</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Pharmacoeconomic Model</rdfs:label>
        <skos:altLabel xml:lang="en">PE Model</skos:altLabel>
        <skos:definition xml:lang="en">A decision-analytic model built specifically to evaluate the cost and outcomes of pharmaceutical treatments, typically supporting pricing and reimbursement decisions.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Pharmacoeconomic Evaluation Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Pharmacoeconomic Model</skos:prefLabel>
        <abbreviation xml:lang="en">PE Model</abbreviation>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/decision-tree"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/markov-model"/>
    </owl:NamedIndividual>
    <owl:Axiom>
