        <skos:hiddenLabel xml:lang="en">Tertiary-Level Prevention</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Tertiary Prevention</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
