        <dcterms:source>Danzon 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Free Pricing</rdfs:label>
        <skos:definition xml:lang="en">A pricing environment in which manufacturers set a drug&apos;s initial launch price without direct government price controls, largely the case in the US.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Free Market Pricing</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Unregulated Pricing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Free Pricing</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/external-reference-pricing"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/value-based-pricing"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
