        <skos:prefLabel xml:lang="en">Healthcare Sector Perspective</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/payer-perspective"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/programme-perspective"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/healthcare-system-cost"/>
