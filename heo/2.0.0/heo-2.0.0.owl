    <!-- https://healtheconomics.wiki/concept/expected-net-benefit-of-sampling -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/expected-net-benefit-of-sampling">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
