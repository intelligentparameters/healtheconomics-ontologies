    <!-- https://healtheconomics.wiki/concept/statistical-significance -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/statistical-significance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q425265"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/hypothesis-testing"/>
        <skos:notation>HE-ES-SA-204</skos:notation>
        <dcterms:identifier>HE-ES-SA-204</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Fisher 1925</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Statistical Significance</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">Statistical significance is a threshold-based conclusion that an observed result is sufficiently incompatible with a prespecified null hypothesis under a stated statistical model to meet the chosen significance level.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Significant Result</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Statistical Significance</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/statistical-significance"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-b5beac41e173</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Statistical methods in subdomain Evidence Synthesis; placed under Statistical Method, the concept named by its wiki topic</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/statistical-significance"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/hypothesis-testing"/>
        <dcterms:identifier>HEO-L-a1052d57564a</dcterms:identifier>
        <linkRationale xml:lang="en">The significance conclusion is the decision element of the testing framework (both definitions)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/status-quo-bias-concept -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/status-quo-bias-concept">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cognitive-bias-concept"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cognitive-bias-concept"/>
        <skos:notation>HE-EE-BE-039</skos:notation>
        <dcterms:identifier>HE-EE-BE-039</dcterms:identifier>
        <dcterms:source>Samuelson &amp; Zeckhauser 1988</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Status Quo Bias Concept</rdfs:label>
        <skos:altLabel xml:lang="en">Status Quo Bias</skos:altLabel>
        <skos:definition xml:lang="en">The tendency to prefer the current state of affairs over available alternatives, even when switching would be beneficial.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Inertia Bias</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Status Quo Bias Concept</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/default-effect-concept"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/status-quo-bias-concept"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cognitive-bias-concept"/>
        <dcterms:identifier>HEO-L-910af9a8641f</dcterms:identifier>
        <linkRationale xml:lang="en">Status quo bias is a kind of cognitive bias, not a component of behavioural economics</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/status-quo-bias-concept"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/default-effect-concept"/>
        <dcterms:identifier>HEO-L-b7c608a504fa</dcterms:identifier>
        <linkRationale xml:lang="en">Preferring the current state drives sticking with defaults.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/status-quo-option -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/status-quo-option">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/choice-set"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/discrete-choice-experiment"/>
        <skos:notation>HE-EE-CBA-049</skos:notation>
        <dcterms:identifier>HE-EE-CBA-049</dcterms:identifier>
        <dcterms:source>Louviere, Hensher &amp; Swait 2000</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Status Quo Option</rdfs:label>
        <skos:definition xml:lang="en">An alternative in a choice experiment representing a respondent&apos;s current circumstances, included so preferences can be measured against a realistic baseline.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Current-Situation Option</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">No-Choice Option</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Status Quo Option</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
