    <!-- https://healtheconomics.wiki/concept/nelder-mead-method -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/nelder-mead-method">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
