    <!-- https://healtheconomics.wiki/concept/continuity-of-care -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/continuity-of-care">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/integrated-care"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q138494548"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/integrated-care"/>
        <skos:notation>HS-HP-IC-009</skos:notation>
        <dcterms:identifier>HS-HP-IC-009</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Haggerty et al. 2003</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Continuity of Care</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:definition xml:lang="en">Continuity of care is the extent to which a patient&apos;s care over time is joined up, through a known clinician, shared information or a consistent plan.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Care Continuity</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Continuous Care Relationship</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Continuity of Care</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/continuity-of-care"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/integrated-care"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-b92c6ede3d15</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Integrated Care: organisation and delivery of care is the Health Systems subdomain (Organisation and governance); placed under Integrated Care, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/continuity-of-care"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
