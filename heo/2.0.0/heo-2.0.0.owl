    <!-- https://healtheconomics.wiki/concept/early-detection -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/early-detection">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/secondary-prevention"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/secondary-prevention"/>
        <skos:notation>HE-PE-OP-008</skos:notation>
        <dcterms:identifier>HE-PE-OP-008</dcterms:identifier>
        <dcterms:source>DeVita, Lawrence &amp; Rosenberg 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Early Detection</rdfs:label>
        <skos:definition xml:lang="en">The identification of a disease, most commonly cancer, at an earlier stage than would otherwise occur, typically through screening or symptom awareness.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Early Diagnosis</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Timely Detection</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Early Detection</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/screening"/>
    </owl:NamedIndividual>
