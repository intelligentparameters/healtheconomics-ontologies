    <!-- https://healtheconomics.wiki/concept/dose-response -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/dose-response">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
