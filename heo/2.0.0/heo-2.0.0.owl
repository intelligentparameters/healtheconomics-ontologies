    <!-- https://healtheconomics.wiki/concept/haematologic-response -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/haematologic-response">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/treatment-response"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/treatment-response"/>
        <skos:notation>HE-ES-CO-035</skos:notation>
        <dcterms:identifier>HE-ES-CO-035</dcterms:identifier>
        <dcterms:source>Baccarani et al. 2013</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Haematologic Response</rdfs:label>
        <skos:altLabel xml:lang="en">Hematologic Response</skos:altLabel>
        <skos:definition xml:lang="en">A response criterion in blood cancers assessing normalisation of blood cell counts and examination findings, the least sensitive but most readily available level.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Blood Count Response</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Haematologic Response</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/molecular-response"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
