        <measures rdf:resource="https://healtheconomics.wiki/concept/multicollinearity"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/regression-analysis"/>
        <skos:notation>HE-ES-SA-029</skos:notation>
        <dcterms:identifier>HE-ES-SA-029</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-09</dcterms:modified>
        <dcterms:source>Kim 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Collinearity Diagnostics</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Collinearity diagnostics are regression checks, such as variance inflation factors, showing when predictors overlap too much to estimate separate effects.</skos:definition>
        <skos:hiddenLabel xml:lang="en">VIF Analysis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Collinearity Diagnostics</skos:prefLabel>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/eigenvalue"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/tolerance"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/variance-inflation-factor"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/collinearity-diagnostics"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <dcterms:identifier>HEO-L-d94488fd2a31</dcterms:identifier>
        <linkRationale xml:lang="en">Regression diagnostics are statistical methods</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/collinearity-diagnostics"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
