        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/latin-hypercube-sampling"/>
        <dcterms:identifier>HEO-L-07e4dd360953</dcterms:identifier>
