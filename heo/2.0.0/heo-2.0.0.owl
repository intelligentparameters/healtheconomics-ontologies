    <!-- https://healtheconomics.wiki/concept/healthcare-associated-infection -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/healthcare-associated-infection">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/adverse-event"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/adverse-event"/>
        <skos:notation>HS-NHS-HQ-032</skos:notation>
        <dcterms:identifier>HS-NHS-HQ-032</dcterms:identifier>
        <dcterms:source>CDC, National Healthcare Safety Network</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Healthcare-Associated Infection</rdfs:label>
        <skos:altLabel xml:lang="en">HAI</skos:altLabel>
        <skos:altLabel xml:lang="en">Nosocomial Infection</skos:altLabel>
        <skos:definition xml:lang="en">An infection a patient develops during care in a healthcare facility, not present or incubating at admission, largely preventable.</skos:definition>
        <skos:prefLabel xml:lang="en">Healthcare-Associated Infection</skos:prefLabel>
        <abbreviation xml:lang="en">HAI</abbreviation>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/healthcare-associated-infection"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/adverse-event"/>
        <dcterms:identifier>HEO-L-e19864d0046d</dcterms:identifier>
        <linkRationale xml:lang="en">An HCAI is harm caused by care, an adverse event.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/healthcare-budget -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/healthcare-budget">
