    <!-- https://healtheconomics.wiki/concept/point-prevalence -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/point-prevalence">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/prevalence"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/prevalence"/>
        <skos:notation>HE-ES-EP-033</skos:notation>
        <dcterms:identifier>HE-ES-EP-033</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams &amp; Wilkins; 2008.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Point Prevalence</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">The proportion of a population found to have a particular condition at a single specific point in time, unlike period prevalence or incidence.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Prevalence at a Single Time</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Snapshot Prevalence</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Point Prevalence</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/point-prevalence"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/prevalence"/>
        <dcterms:identifier>HEO-L-34514ed669d0</dcterms:identifier>
        <linkRationale xml:lang="en">Point prevalence is a kind of prevalence</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/poisson-distribution -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/poisson-distribution">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/probability-distribution"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/probability-distribution"/>
        <skos:notation>HE-ES-SA-157</skos:notation>
        <dcterms:identifier>HE-ES-SA-157</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Casella G, Berger RL. Statistical Inference. 2nd ed. Duxbury; 2002.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Poisson Distribution</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A discrete probability distribution describing the number of times an event occurs within a fixed interval, assuming independence and a constant average rate.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Count Distribution</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Poisson Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Poisson Distribution</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <represents rdf:resource="https://healtheconomics.wiki/concept/discrete-data"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/poisson-distribution"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/probability-distribution"/>
        <dcterms:identifier>HEO-L-db9481a50a27</dcterms:identifier>
        <linkRationale xml:lang="en">The Poisson is a probability distribution</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/poisson-distribution"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#represents"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/discrete-data"/>
        <dcterms:identifier>HEO-L-b1d4a19b0263</dcterms:identifier>
        <linkRationale xml:lang="en">Poisson Distribution is a discrete distribution of event counts; the article notes rare-event counts are called Poisson data.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/poisson-regression -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/poisson-regression">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/regression-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/regression-analysis"/>
        <skos:notation>HE-ES-SA-158</skos:notation>
        <dcterms:identifier>HE-ES-SA-158</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Cameron &amp; Trivedi 2013</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Poisson Regression</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A modelling technique analysing count outcome data, such as clinical events per patient, based on the assumption that outcomes follow a Poisson distribution.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Count Regression</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Log-Linear Count Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Poisson Regression</skos:prefLabel>
        <assumes rdf:resource="https://healtheconomics.wiki/concept/poisson-distribution"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/poisson-regression"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/regression-analysis"/>
        <dcterms:identifier>HEO-L-4f36f4964a10</dcterms:identifier>
        <linkRationale xml:lang="en">Poisson regression is a regression model for counts</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/poisson-regression"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#assumes"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/poisson-distribution"/>
        <dcterms:identifier>HEO-L-2bdcc40a7fff</dcterms:identifier>
        <linkRationale xml:lang="en">Poisson regression assumes Poisson distributed counts, as its definition states</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
