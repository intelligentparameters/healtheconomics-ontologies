        <rdfs:label xml:lang="en">Care Management</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Care Management is planned support for high-need, high-cost patients, in which a care manager agrees a care plan and follows up to avoid costly admissions.</skos:definition>
