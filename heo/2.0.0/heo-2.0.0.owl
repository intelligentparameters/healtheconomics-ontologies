    <!-- https://healtheconomics.wiki/concept/cardinal-scaling -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cardinal-scaling">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-state-valuation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-state-valuation"/>
        <skos:notation>HE-EE-HU-006</skos:notation>
        <dcterms:identifier>HE-EE-HU-006</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Roudijk et al. 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cardinal Scaling</rdfs:label>
        <owl:versionInfo>1.0.3</owl:versionInfo>
        <skos:definition xml:lang="en">Cardinal scaling values health states so that differences between values show strength of preference, as QALYs require; ordinal scales give rank only.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cardinal Measurement</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Interval-Level Scaling</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cardinal Scaling</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/ordinal-scaling"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/utility"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/standard-gamble"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/time-trade-off"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cardinal-scaling"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-state-valuation"/>
        <dcterms:identifier>HEO-L-3703f115eded</dcterms:identifier>
