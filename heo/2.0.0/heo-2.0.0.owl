        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Exponential Distribution</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A probability distribution characterised by a constant hazard rate over time, used to model event timing when risk is assumed not to change.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Constant-Hazard Distribution</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Memoryless Distribution</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Exponential Distribution</skos:prefLabel>
        <assumes rdf:resource="https://healtheconomics.wiki/concept/constant-hazard"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/hazard-rate"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/exponential-distribution"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/probability-distribution"/>
        <dcterms:identifier>HEO-L-23f9248baf61</dcterms:identifier>
        <linkRationale xml:lang="en">A probability distribution</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
