    <!-- https://healtheconomics.wiki/concept/prospective-data -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/prospective-data">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-source"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-source"/>
        <skos:notation>HE-ES-ES-034</skos:notation>
        <dcterms:identifier>HE-ES-ES-034</dcterms:identifier>
        <dcterms:source>Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams &amp; Wilkins; 2008.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Prospective Data</rdfs:label>
        <skos:definition xml:lang="en">Data collected by following participants forward in time from a defined start, gathered as events occur rather than reconstructed later.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Concurrent Data</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Forward-Looking Data</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Prospective Data</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/retrospective-data"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/prospective-data"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-source"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-c81436434206</dcterms:identifier>
