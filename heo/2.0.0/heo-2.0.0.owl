    <!-- https://healtheconomics.wiki/concept/prospective-review -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/prospective-review">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/utilisation-review"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
