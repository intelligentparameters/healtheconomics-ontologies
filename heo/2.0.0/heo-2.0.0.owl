    <!-- https://healtheconomics.wiki/concept/organ-response -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/organ-response">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-response"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/clinical-response"/>
        <skos:notation>HE-ES-CO-047</skos:notation>
        <dcterms:identifier>HE-ES-CO-047</dcterms:identifier>
        <dcterms:source>FDA-NIH Biomarker Working Group 2016</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Organ Response</rdfs:label>
        <skos:definition xml:lang="en">A biomarker-based outcome measure indicating improvement in a specific organ&apos;s function or structure affected by disease, requiring disease-specific validated criteria.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Organ-Level Response</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Organ-Specific Improvement</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Organ Response</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/organ-response"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/clinical-response"/>
        <dcterms:identifier>HEO-L-bd31587030af</dcterms:identifier>
        <linkRationale xml:lang="en">Organ response is a clinical response defined for a specific organ</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


