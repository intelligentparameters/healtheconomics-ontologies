    <!-- https://healtheconomics.wiki/concept/interaction -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/interaction">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/epidemiology"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/epidemiology"/>
        <skos:notation>HE-ES-EP-024</skos:notation>
        <dcterms:identifier>HE-ES-EP-024</dcterms:identifier>
        <dcterms:source>Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams &amp; Wilkins; 2008.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Interaction</rdfs:label>
        <skos:definition xml:lang="en">A situation where the joint effect of two or more exposures on an outcome differs from what their individual effects would predict.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Joint-Exposure Effect</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Statistical Effect Modification</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Interaction</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/interaction"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/epidemiology"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-aeeb2c636ade</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Epidemiology: catalogue subdomain Evidence Synthesis is one of the subdomains; placed under Epidemiology, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/interaction-effect -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/interaction-effect">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
