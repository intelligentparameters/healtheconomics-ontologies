        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Clinical Alert</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">A clinical alert is an automated message in a health record or ordering system warning a clinician of a patient-specific risk, such as a drug interaction.</skos:definition>
