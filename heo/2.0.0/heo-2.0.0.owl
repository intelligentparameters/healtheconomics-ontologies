        <dcterms:source>Suissa 2008</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Immortal Time</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Guarantee-Time Period</skos:altLabel>
        <skos:altLabel xml:lang="en">Immortal Person-Time</skos:altLabel>
        <skos:definition xml:lang="en">A period of follow-up during which, due to how exposure groups were defined, a participant could not possibly have experienced the outcome.</skos:definition>
