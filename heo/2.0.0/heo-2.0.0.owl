        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/effectiveness"/>
        <skos:notation>HE-ES-PRO-006</skos:notation>
        <dcterms:identifier>HE-ES-PRO-006</dcterms:identifier>
        <dcterms:source>Institute of Medicine. Initial National Priorities for Comparative Effectiveness Research. National Academies Press; 2009. doi:10.17226/12648.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Effectiveness Outcome</rdfs:label>
        <skos:definition xml:lang="en">A clinical outcome measured under real-world, routine practice conditions, reflecting how a treatment performs across a diverse patient population.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Pragmatic Outcome</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Real-World Outcome</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Effectiveness Outcome</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/efficacy-outcome"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/effectiveness-outcome"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
