    <!-- https://healtheconomics.wiki/concept/protective-factor -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/protective-factor">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
