    <!-- https://healtheconomics.wiki/concept/out-of-pocket-maximum -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/out-of-pocket-maximum">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:notation>HS-HP-HI-127</skos:notation>
        <dcterms:identifier>HS-HP-HI-127</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Out-of-Pocket Maximum</rdfs:label>
        <skos:altLabel xml:lang="en">Maximum Out-of-Pocket</skos:altLabel>
        <skos:altLabel xml:lang="en">OOP Maximum</skos:altLabel>
        <skos:definition xml:lang="en">The highest total amount an insured person will pay for covered costs within a period, beyond which the plan covers everything further.</skos:definition>
        <skos:prefLabel xml:lang="en">Out-of-Pocket Maximum</skos:prefLabel>
        <abbreviation xml:lang="en">OOP Maximum</abbreviation>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/catastrophic-health-expenditure"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/out-of-pocket-cost"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
