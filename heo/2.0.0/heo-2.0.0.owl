    <!-- https://healtheconomics.wiki/concept/deprescribing -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/deprescribing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/medication-safety"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q16251540"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
