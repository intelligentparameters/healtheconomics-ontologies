    <!-- https://healtheconomics.wiki/concept/research-prioritisation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/research-prioritisation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/priority-setting"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/priority-setting"/>
        <skos:notation>HE-EM-VI-027</skos:notation>
        <dcterms:identifier>HE-EM-VI-027</dcterms:identifier>
        <dcterms:source>Claxton &amp; Posnett 1996</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Research Prioritisation</rdfs:label>
        <skos:altLabel xml:lang="en">Research Priority Setting</skos:altLabel>
        <skos:definition xml:lang="en">The process of deciding which research studies to fund first, given limited resources, informed by formal value of information methods.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Study Prioritisation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Research Prioritisation</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/research-prioritisation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/priority-setting"/>
        <dcterms:identifier>HEO-L-74bdb121dee5</dcterms:identifier>
        <linkRationale xml:lang="en">Research prioritisation is priority setting applied to research funding.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/research-question -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/research-question">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/systematic-review"/>
        <skos:notation>HS-HP-HTA-182</skos:notation>
        <dcterms:identifier>HS-HP-HTA-182</dcterms:identifier>
        <dcterms:source>Richardson et al. 1995</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Research Question</rdfs:label>
        <skos:definition xml:lang="en">The specific, well-defined question a study or assessment is designed to answer, typically structured using a framework such as PICO.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Research Aim</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Study Question</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Research Question</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/pico-framework"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/research-question"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
