    <!-- https://healtheconomics.wiki/concept/blinding -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/blinding">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/clinical-trial-design"/>
        <skos:notation>HE-ES-CTM-008</skos:notation>
        <dcterms:identifier>HE-ES-CTM-008</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Hopewell et al. 2025</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Blinding</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Masking</skos:altLabel>
        <skos:definition xml:lang="en">Blinding (masking) keeps trial participants, clinicians, assessors or analysts unaware of assignment, limiting bias in effect, utility and cost estimates.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Single-Blind</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Treatment Masking</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Triple-Blind</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Blinding</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/cointervention"/>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/detection-bias"/>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/treatment-expectation"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/open-label-study"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/risk-of-bias-assessment"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/information-bias"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/blinding"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-6cf7b58b5734</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Clinical Trial Methods: catalogue subdomain Evidence Synthesis is one of the subdomains</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/blinding"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
