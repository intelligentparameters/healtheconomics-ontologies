    <!-- https://healtheconomics.wiki/concept/appropriateness -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/appropriateness">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <skos:notation>HS-NHS-HQ-004</skos:notation>
        <dcterms:identifier>HS-NHS-HQ-004</dcterms:identifier>
        <dcterms:source>Brook et al. 1986</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Appropriateness</rdfs:label>
        <skos:definition xml:lang="en">A judgement of whether a procedure&apos;s expected health benefit exceeds its expected negative consequences by a sufficiently wide margin to justify performing it.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Care Justifiability</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Clinical Suitability</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Appropriateness</skos:prefLabel>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/appropriate-care"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/appropriateness"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-0bb9eacc40eb</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; NHS Productivity &gt; Healthcare Quality: wiki topic Performance, productivity and quality sits in Health Systems; placed under Quality of Care, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/appropriateness"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <dcterms:identifier>HEO-L-b0e292ea09e5</dcterms:identifier>
        <linkRationale xml:lang="en">Consistency with professional knowledge, the core of appropriateness, is a dimension in the quality of care definition</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
