        <skos:altLabel xml:lang="en">BAT</skos:altLabel>
        <skos:altLabel xml:lang="en">Best Available Therapy</skos:altLabel>
        <skos:definition xml:lang="en">The most effective treatment currently accessible for a condition, used as the comparator against which a new intervention&apos;s incremental value is assessed.</skos:definition>
        <skos:prefLabel xml:lang="en">Best Available Treatment</skos:prefLabel>
        <abbreviation xml:lang="en">BAT</abbreviation>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
