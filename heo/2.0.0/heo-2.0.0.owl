    <!-- https://healtheconomics.wiki/concept/budget-overrun -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/budget-overrun">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/budget-variance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/budget-variance"/>
        <skos:notation>HE-EE-BIA-017</skos:notation>
        <dcterms:identifier>HE-EE-BIA-017</dcterms:identifier>
        <dcterms:source>Horngren, Datar &amp; Rajan 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Budget Overrun</rdfs:label>
        <skos:altLabel xml:lang="en">Budget Overspend</skos:altLabel>
        <skos:definition xml:lang="en">Spending that exceeds the amount allocated in an approved budget, typically requiring explanation, reallocated funds, or a formal amendment.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cost Overrun</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Budget Overrun</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/budget-overrun"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/budget-variance"/>
        <dcterms:identifier>HEO-L-66c1841bc761</dcterms:identifier>
        <linkRationale xml:lang="en">An overrun is an adverse budget variance</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/budget-planning -->

