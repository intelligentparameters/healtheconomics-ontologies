        <dcterms:identifier>HEO-L-a912179f2a54</dcterms:identifier>
        <linkRationale xml:lang="en">Growth curve modelling is trajectory analysis</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
