    <!-- https://healtheconomics.wiki/concept/targeted-therapy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/targeted-therapy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/precision-medicine"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q492646"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/precision-medicine"/>
        <skos:notation>HE-PE-TI-033</skos:notation>
        <dcterms:identifier>HE-PE-TI-033</dcterms:identifier>
        <dcterms:source>DeVita, Lawrence &amp; Rosenberg 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Targeted Therapy</rdfs:label>
        <skos:altLabel xml:lang="en">Targeted Treatment</skos:altLabel>
        <skos:definition xml:lang="en">A treatment acting on a specific molecular target in a disease process, most commonly in oncology, interfering with proteins or pathways driving tumour growth.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Molecular Precision Drug</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Targeted Therapy</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/targeted-therapy-cost"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/companion-diagnostic"/>
    </owl:NamedIndividual>
