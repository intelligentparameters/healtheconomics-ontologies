        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/non-sampling-error"/>
        <skos:notation>HE-DS-BV-029</skos:notation>
        <dcterms:identifier>HE-DS-BV-029</dcterms:identifier>
        <dcterms:source>Groves et al. 2009</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Reporting Error</rdfs:label>
        <skos:definition xml:lang="en">A mistake occurring when study results are inaccurately transcribed, summarised, or presented in a publication, distinct from errors in collection or analysis.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Misreporting</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Report Data Error</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Reporting Error</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/reporting-error"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/non-sampling-error"/>
        <dcterms:identifier>HEO-L-870d658499eb</dcterms:identifier>
        <linkRationale xml:lang="en">The definition sets reporting error apart from data collection errors; it is an error not arising from sampling.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/reporting-error"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#threatensValidityOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:identifier>HEO-L-1b81039be8a9</dcterms:identifier>
        <linkRationale xml:lang="en">Misreported published results propagate into extracted data for synthesis.</linkRationale>
