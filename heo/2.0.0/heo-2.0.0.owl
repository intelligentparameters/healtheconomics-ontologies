        <dcterms:identifier>HS-HP-HS-003</dcterms:identifier>
        <dcterms:source>Garner &amp; Littlejohns 2011</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Do Not Do</rdfs:label>
        <skos:definition xml:lang="en">A formal recommendation identifying a practice or treatment that should no longer be used, evidence indicating insufficient benefit relative to cost or risk.</skos:definition>
