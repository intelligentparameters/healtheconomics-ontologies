    <!-- https://healtheconomics.wiki/concept/long-term-outcome -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/long-term-outcome">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcome-measure"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/outcome-measure"/>
        <skos:notation>HE-ES-PRO-015</skos:notation>
        <dcterms:identifier>HE-ES-PRO-015</dcterms:identifier>
        <dcterms:source>U.S. Food and Drug Administration. Guidance for Industry: Patient-Reported Outcome Measures-Use in Medical Product Development to Support Labeling Claims. FDA; 2009.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Long-Term Outcome</rdfs:label>
        <skos:definition xml:lang="en">A clinical or economic outcome observed or projected over an extended time horizon, often beyond a trial&apos;s observed follow-up period.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Extended-Horizon Outcome</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Long-Term Result</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Long-Term Outcome</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/long-term-outcome"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/outcome-measure"/>
        <dcterms:identifier>HEO-L-66c4a0cd7c08</dcterms:identifier>
        <linkRationale xml:lang="en">The definition allows economic outcomes, so not all are clinical outcomes; placed like its sibling Short-Term Outcome (that contrast already exists on the Short-Term side)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/longitudinal-data -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/longitudinal-data">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-ES-SA-106</skos:notation>
        <dcterms:identifier>HE-ES-SA-106</dcterms:identifier>
        <dcterms:source>Liang &amp; Zeger 1986</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Longitudinal Data</rdfs:label>
        <skos:altLabel xml:lang="en">Repeated-Measures Data</skos:altLabel>
        <skos:definition xml:lang="en">Data collected on the same individuals repeatedly over time, allowing observation of change and the timing between exposures and outcomes.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Follow-Up Data</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Longitudinal Data</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/cross-sectional-data"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/longitudinal-data"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-4e1af9d3b944</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Statistical Analysis: catalogue subdomain Evidence Synthesis is one of the subdomains</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/longitudinal-data"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cross-sectional-data"/>
        <dcterms:identifier>HEO-L-65551fd5cfee</dcterms:identifier>
        <linkRationale xml:lang="en">Longitudinal data can come from trials or cohorts, so they are not all routinely collected real-world data; repeated versus single-time collection is the standard contrast</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/longitudinal-design -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/longitudinal-design">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/study-design"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/study-design"/>
        <skos:notation>HE-ES-CTM-049</skos:notation>
        <dcterms:identifier>HE-ES-CTM-049</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-24</dcterms:modified>
        <dcterms:source>Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams &amp; Wilkins; 2008.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Longitudinal Design</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Longitudinal Study Design</skos:altLabel>
        <skos:definition xml:lang="en">A longitudinal design observes the same individuals or other study units at multiple time points to characterize within-unit change, temporal sequence, and differences in trajectories over time.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Follow-Up Design</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Longitudinal Design</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-1"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/longitudinal-data"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/longitudinal-design"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/study-design"/>
        <dcterms:identifier>HEO-L-7d0c6ed6834f</dcterms:identifier>
        <linkRationale xml:lang="en">A longitudinal design is a study design</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
