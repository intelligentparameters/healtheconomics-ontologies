        <dcterms:identifier>HS-HP-HSR-017</dcterms:identifier>
        <dcterms:source>AHIMA, Clinical Documentation Improvement guidance</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Concurrent Query</rdfs:label>
        <skos:definition xml:lang="en">A request from a documentation specialist to a treating physician, made while a patient is still hospitalised, seeking clarification on documentation.</skos:definition>
