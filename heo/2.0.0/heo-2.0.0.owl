        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:notation>HS-HP-HTA-051</skos:notation>
        <dcterms:identifier>HS-HP-HTA-051</dcterms:identifier>
        <dcterms:source>National Institute for Health and Care Excellence. NICE technology appraisal and highly specialised technologies guidance: the manual (PMG36). Published 2022; updated 2026.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Contextualization</rdfs:label>
        <skos:altLabel xml:lang="en">Contextualisation</skos:altLabel>
        <skos:definition xml:lang="en">The process of interpreting and adapting external evidence to reflect the specific clinical, economic, and organisational context of a decision-making body.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Evidence Adaptation to Setting</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Contextualization</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
