    <!-- https://healtheconomics.wiki/concept/inconsistency -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/inconsistency">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-ES-ESM-026</skos:notation>
        <dcterms:identifier>HE-ES-ESM-026</dcterms:identifier>
        <dcterms:source>Dias et al. 2013</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Inconsistency</rdfs:label>
        <skos:definition xml:lang="en">Within network meta-analysis, a discrepancy between direct and indirect evidence for the same comparison, indicating the two sources disagree.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Direct-Indirect Discrepancy</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Evidence Discordance</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Inconsistency</skos:prefLabel>
