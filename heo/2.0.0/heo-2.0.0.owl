        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Market Signalling</skos:altLabel>
        <skos:definition xml:lang="en">An action taken by an informed party to credibly convey private information to an uninformed party that could not otherwise be verified.</skos:definition>
