    <!-- https://healtheconomics.wiki/concept/cohort-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cohort-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/aggregate-model"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/simulation-model"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1724283"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/aggregate-model"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/simulation-model"/>
        <skos:notation>HE-EM-DM-009</skos:notation>
        <dcterms:identifier>HE-EM-DM-009</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-09</dcterms:modified>
        <dcterms:source>Davis et al. 2014</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cohort Model</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">A cohort model is a health economic decision model that estimates mean costs and outcomes for a patient group as a whole, without simulating individuals.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cohort-Level Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cohort Model</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/individual-level-model"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/population-level-model"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-3"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/cohort-trace"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cohort-model"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/aggregate-model"/>
        <dcterms:identifier>HEO-L-ae5c9b179e94</dcterms:identifier>
        <linkRationale xml:lang="en">A cohort model is one kind of aggregate (summary-parameter) model; the broader concept is the object, so the reverse link should go</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
