    <!-- https://healtheconomics.wiki/concept/me-too-drug -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/me-too-drug">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/incremental-innovation"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q19778341"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/incremental-innovation"/>
        <skos:notation>HE-PE-TI-019</skos:notation>
        <dcterms:identifier>HE-PE-TI-019</dcterms:identifier>
        <dcterms:source>DiMasi JA, Grabowski HG, Hansen RW. Innovation in the pharmaceutical industry: new estimates of R&amp;D costs. Journal of Health Economics. 2016;47:20-33. doi:10.1016/j.jhealeco.2016.01.012.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Me-Too Drug</rdfs:label>
        <skos:definition xml:lang="en">A newly developed drug chemically similar to and working through the same mechanism as an existing treatment, offering limited additional benefit.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Copycat Drug</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Follow-On Compound</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Me-Too Drug</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/first-in-class"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/therapeutic-competition"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/me-too-drug"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/incremental-innovation"/>
        <dcterms:identifier>HEO-L-bcae8dc2d0d0</dcterms:identifier>
        <linkRationale xml:lang="en">A me-too drug is a modest improvement on an existing product</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/me-too-drug"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/first-in-class"/>
        <dcterms:identifier>HEO-L-7ce0ab198027</dcterms:identifier>
        <linkRationale xml:lang="en">A wholly new mechanism is a radical innovation; me-too drugs copy an existing mechanism.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
