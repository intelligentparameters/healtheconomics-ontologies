    <!-- https://healtheconomics.wiki/concept/factor-fixing -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/factor-fixing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/global-sensitivity-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/global-sensitivity-analysis"/>
        <skos:notation>HE-EM-UA-021</skos:notation>
        <dcterms:identifier>HE-EM-UA-021</dcterms:identifier>
        <dcterms:source>Saltelli et al. 2008</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Factor Fixing</rdfs:label>
        <skos:definition xml:lang="en">A global sensitivity analysis technique identifying which input parameters have negligible influence on a model&apos;s output, so they could be fixed at a constant.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Negligible-Factor Screening</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Parameter Fixing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Factor Fixing</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/factor-prioritisation"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/sobol-indices"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/factor-fixing"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/global-sensitivity-analysis"/>
        <dcterms:identifier>HEO-L-51c8ff98247e</dcterms:identifier>
        <linkRationale xml:lang="en">Factor fixing is a GSA setting (subject definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
