    <!-- https://healtheconomics.wiki/concept/high-performer-identification -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/high-performer-identification">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/benchmarking"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/benchmarking"/>
        <skos:notation>HS-SS_HSP-030</skos:notation>
        <dcterms:identifier>HS-SS_HSP-030</dcterms:identifier>
        <dcterms:source>Donabedian A. Evaluating the quality of medical care. Milbank Memorial Fund Quarterly. 1966;44(3):166-206. doi:10.2307/3348969.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">High Performer Identification</rdfs:label>
        <skos:definition xml:lang="en">The process of systematically identifying providers who consistently achieve superior performance on quality or efficiency metrics, to understand and disseminate their practices.</skos:definition>
        <skos:hiddenLabel xml:lang="en">High-Performer Detection</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Top-Performer Identification</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">High Performer Identification</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/quality-indicator"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/high-performer-identification"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/benchmarking"/>
        <dcterms:identifier>HEO-L-4c9018037fcd</dcterms:identifier>
