        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Drug Substitution</rdfs:label>
        <skos:altLabel xml:lang="en">Medicine Substitution</skos:altLabel>
        <skos:definition xml:lang="en">The replacement of one medicine with another regarded as equivalent, such as a generic or biosimilar for an originator product, commonly to lower cost.</skos:definition>
