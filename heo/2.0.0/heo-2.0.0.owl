    <!-- https://healtheconomics.wiki/concept/bayesian-information-criterion -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/bayesian-information-criterion">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/model-validation"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1988242"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/model-validation"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/goodness-of-fit"/>
        <skos:notation>HE-EM-MV-004</skos:notation>
        <dcterms:identifier>HE-EM-MV-004</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Schwarz 1978</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Bayesian Information Criterion</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">BIC</skos:altLabel>
        <skos:altLabel xml:lang="en">Schwarz Criterion</skos:altLabel>
        <skos:definition xml:lang="en">Bayesian information criterion (BIC) ranks models fitted to the same data, such as HTA survival curves, by fit with a penalty that grows with sample size.</skos:definition>
        <skos:prefLabel xml:lang="en">Bayesian Information Criterion</skos:prefLabel>
        <abbreviation xml:lang="en">BIC</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/likelihood-ratio-test"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-9"/>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/parametric-survival-model"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/maximum-likelihood-estimation"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/bayesian-information-criterion"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/model-validation"/>
