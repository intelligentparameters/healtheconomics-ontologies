    <!-- https://healtheconomics.wiki/concept/relevance-criterion -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/relevance-criterion">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/applicability-criterion"/>
        <skos:notation>HS-HP-HTA-180</skos:notation>
        <dcterms:identifier>HS-HP-HTA-180</dcterms:identifier>
        <dcterms:source>Guyatt GH, Oxman AD, Vist GE, et al. GRADE: an emerging consensus on rating quality of evidence and strength of recommendations. BMJ. 2008;336:924-926. doi:10.1136/bmj.39489.470347.AD.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Relevance Criterion</rdfs:label>
        <skos:definition xml:lang="en">A standard assessing whether a piece of evidence or consideration is genuinely pertinent to the specific decision being made.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Pertinence Rule</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Relevance Test</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Relevance Criterion</skos:prefLabel>
        <benchmarkFor rdf:resource="https://healtheconomics.wiki/concept/data-relevance"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/relevance-criterion"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
