    <!-- https://healtheconomics.wiki/concept/care-transition -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/care-transition">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/integrated-care"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/integrated-care"/>
        <precedes rdf:resource="https://healtheconomics.wiki/concept/readmission"/>
        <riskFactorFor rdf:resource="https://healtheconomics.wiki/concept/adverse-drug-event"/>
        <riskFactorFor rdf:resource="https://healtheconomics.wiki/concept/readmission"/>
        <skos:notation>HS-HP-IC-006</skos:notation>
        <dcterms:identifier>HS-HP-IC-006</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>World Health Organization 2016</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Care Transition</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Transition of Care</skos:altLabel>
        <skos:definition xml:lang="en">Care Transition is a patient&apos;s move between care settings or providers, such as hospital discharge home, a period of raised risk of harm and readmission.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Care Handover</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Care Transition</skos:prefLabel>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/medication-reconciliation"/>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/transitional-care"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/care-transition"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/integrated-care"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-3dda87200e8d</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Integrated Care: organisation and delivery of care is the Health Systems subdomain (Organisation and governance); placed under Integrated Care, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/care-transition"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#precedes"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/readmission"/>
        <dcterms:identifier>HEO-L-ac63f590fbd4</dcterms:identifier>
        <skos:editorialNote xml:lang="en">suggested source, not yet checked: no source found</skos:editorialNote>
        <linkRationale xml:lang="en">A readmission by definition follows a discharge, so the transition is a precondition, not a risk factor; precedes fits</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/care-transition"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#riskFactorFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/adverse-drug-event"/>
        <dcterms:identifier>HEO-L-f9747ea05496</dcterms:identifier>
        <skos:editorialNote xml:lang="en">suggested source, not yet checked: Forster et al. 2003</skos:editorialNote>
        <linkRationale xml:lang="en">About one in five patients had an adverse event after discharge, most often an adverse drug event</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/care-transition"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#riskFactorFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/readmission"/>
        <dcterms:identifier>HEO-L-ba3894091b1b</dcterms:identifier>
