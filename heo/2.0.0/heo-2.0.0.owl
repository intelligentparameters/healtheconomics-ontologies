    <!-- https://healtheconomics.wiki/concept/living-will -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/living-will">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/advance-directive"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/advance-directive"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/advance-care-planning"/>
        <skos:notation>HS-HP-HD-068</skos:notation>
        <dcterms:identifier>HS-HP-HD-068</dcterms:identifier>
        <dcterms:source>Patient Self-Determination Act 1990</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Living Will</rdfs:label>
        <skos:definition xml:lang="en">A type of advance directive documenting an individual&apos;s preferences for future medical treatment, particularly life-sustaining interventions, if they cannot communicate.</skos:definition>
        <skos:hiddenLabel xml:lang="en">End-of-Life Directive</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Personal Directive</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Living Will</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/life-sustaining-treatment"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/living-will"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/advance-directive"/>
        <dcterms:identifier>HEO-L-ac456c2b1828</dcterms:identifier>
        <linkRationale xml:lang="en">The subject definition says it is a type of advance directive</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/living-will"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/advance-care-planning"/>
        <dcterms:identifier>HEO-L-3ca5d78b9e79</dcterms:identifier>
        <linkRationale xml:lang="en">Documenting treatment preferences is part of ACP, as Power of Attorney already is.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
