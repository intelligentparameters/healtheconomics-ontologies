        <dcterms:identifier>HE-EE-HE-010</dcterms:identifier>
        <dcterms:source>Cornia &amp; Stewart 1993</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Leakage Rate</rdfs:label>
        <skos:altLabel xml:lang="en">Targeting Leakage</skos:altLabel>
        <skos:definition xml:lang="en">The proportion of a targeted programme&apos;s total benefits that reach individuals outside its intended eligible population.</skos:definition>
