    <!-- https://healtheconomics.wiki/concept/pseudo-random-number -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/pseudo-random-number">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/microsimulation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/microsimulation"/>
        <skos:notation>HE-EM-MS-007</skos:notation>
        <dcterms:identifier>HE-EM-MS-007</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Press et al. 2007</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Pseudo-Random Number</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A pseudo-random number is a value produced by a deterministic algorithm whose sequence is designed to exhibit specified statistical properties of random draws.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Deterministic Random Draw</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">PRNG Output</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Pseudo-Random Number</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-7"/>
        <prerequisiteFor rdf:resource="https://healtheconomics.wiki/concept/common-random-numbers"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/pseudo-random-number"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/microsimulation"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-856edf6af405</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Discrete event and individual level simulation in subdomain Economic Modelling; placed under Microsimulation, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/pseudo-random-number"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#prerequisiteFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/common-random-numbers"/>
        <dcterms:identifier>HEO-L-3e712e0765cf</dcterms:identifier>
        <linkRationale xml:lang="en">A number is not a process; reusing seeded pseudo-random streams must be understood before common random numbers.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/pseudonymization -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/pseudonymization">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-HP-DH-037</skos:notation>
        <dcterms:identifier>HS-HP-DH-037</dcterms:identifier>
        <dcterms:source>European Union, General Data Protection Regulation</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Pseudonymization</rdfs:label>
        <skos:altLabel xml:lang="en">Pseudonymisation</skos:altLabel>
        <skos:definition xml:lang="en">A technique replacing identifying information in a dataset with an artificial identifier, so data cannot be linked to an individual without separate stored information.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Key-Coded De-Identification</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Pseudonymization</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/confidentiality"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/pseudonymization"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-7ba518548cfc</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Digital Health: health information systems are one of the WHO health system building blocks</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/pseudonymization"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/confidentiality"/>
        <dcterms:identifier>HEO-L-973d37aced72</dcterms:identifier>
        <linkRationale xml:lang="en">Pseudonymisation helps keep identifiable data confidential.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


