        <uses rdf:resource="https://healtheconomics.wiki/concept/certificate-of-need"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/swot-analysis"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/health-planning"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
