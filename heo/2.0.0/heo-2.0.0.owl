        <skos:altLabel xml:lang="en">Posterior Interval</skos:altLabel>
        <skos:definition xml:lang="en">A credible interval is a Bayesian range that contains an unknown parameter, such as a treatment effect, with a stated posterior probability, often 95%.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Bayesian Interval</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Credible Interval</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/credible-interval"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/interval-estimate"/>
        <dcterms:identifier>HEO-L-6dc4fb30c765</dcterms:identifier>
        <linkRationale xml:lang="en">A credible interval conveys uncertainty around an estimate</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/credible-interval-estimation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/credible-interval-estimation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/bayesian-analysis"/>
        <skos:notation>HE-ES-SA-040</skos:notation>
        <dcterms:identifier>HE-ES-SA-040</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>O&apos;Hagan &amp; Stevens 2001</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Credible Interval Estimation</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">The Bayesian process of calculating a range of plausible values for a parameter based on its estimated posterior probability distribution.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Bayesian Interval Estimation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Posterior Interval Estimation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Credible Interval Estimation</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/confidence-interval-estimation"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/posterior-distribution"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/credible-interval-estimation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
