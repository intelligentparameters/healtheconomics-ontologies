        <rdfs:label xml:lang="en">Matching Method</rdfs:label>
        <skos:altLabel xml:lang="en">Matching Technique</skos:altLabel>
        <skos:definition xml:lang="en">A health state valuation technique in which respondents adjust one attribute of an outcome until two alternatives seem equally preferable.</skos:definition>
