        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">QALY Shortfall</rdfs:label>
        <skos:definition xml:lang="en">QALY shortfall is the expected QALY gap between a matched general population and patients on current care, which NICE reads as absolute or proportional.</skos:definition>
        <skos:hiddenLabel xml:lang="en">QALE Shortfall</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Quality-Adjusted Life Expectancy Shortfall</skos:hiddenLabel>
