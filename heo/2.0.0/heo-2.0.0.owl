    <!-- https://healtheconomics.wiki/concept/underwriting -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/underwriting">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:notation>HS-HP-HI-198</skos:notation>
        <dcterms:identifier>HS-HP-HI-198</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Underwriting</rdfs:label>
        <skos:definition xml:lang="en">The process by which an insurer evaluates the risk of a potential policyholder and determines whether to offer coverage and at what price.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Premium Rating</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Risk Assessment Pricing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Underwriting</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/risk-selection"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/private-insurance-premium"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/pre-existing-condition"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/underwriting"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-6b2f1ab98c02</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health Insurance: wiki topic Health financing and insurance sits in Health Systems; placed under Health Insurance, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/underwriting"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/risk-selection"/>
        <dcterms:identifier>HEO-L-fb3c433e75d2</dcterms:identifier>
        <linkRationale xml:lang="en">Underwriting on risk produces risk selection.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
