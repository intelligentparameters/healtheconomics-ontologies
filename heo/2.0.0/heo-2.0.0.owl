    <!-- https://healtheconomics.wiki/concept/clinical-audit -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/clinical-audit">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/audit-and-feedback"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/quality-improvement"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q5133817"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/audit-and-feedback"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/quality-improvement"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/guideline-compliance"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/protocol-adherence"/>
        <skos:notation>HS-NHS-HQ-013</skos:notation>
        <dcterms:identifier>HS-NHS-HQ-013</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-09</dcterms:modified>
        <dcterms:source>HQIP 2020</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Clinical Audit</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Clinical audit is a quality improvement cycle that checks care against explicit evidence-based standards, acts on gaps and re-measures to confirm change.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Care Audit</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Practice Audit</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Clinical Audit</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/audit-criterion"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/clinical-guideline"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/clinical-audit"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
