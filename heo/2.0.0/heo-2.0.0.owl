        <rdfs:label xml:lang="en">Case-Control Design</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Case-Control Study</skos:altLabel>
        <skos:altLabel xml:lang="en">Case-Referent Design</skos:altLabel>
        <skos:altLabel xml:lang="en">Case-Referent Study</skos:altLabel>
        <skos:definition xml:lang="en">Case-Control Design is an observational study comparing past exposures of cases (with an outcome) and controls (without it), used in HTA for rare outcomes.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Case-Control Method</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Retrospective Case Study</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Case-Control Design</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/cohort-design"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/logistic-regression"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/mantel-haenszel-method"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/odds-ratio"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/case-control-design"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/observational-study"/>
        <dcterms:identifier>HEO-L-3bb6e5aab60f</dcterms:identifier>
        <linkRationale xml:lang="en">A case-control design is observational</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
