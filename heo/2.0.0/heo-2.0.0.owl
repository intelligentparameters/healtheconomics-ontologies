    <!-- https://healtheconomics.wiki/concept/expert-consultation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/expert-consultation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-ES-ESM-018</skos:notation>
        <dcterms:identifier>HE-ES-ESM-018</dcterms:identifier>
        <dcterms:source>Cooke 1991</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Expert Consultation</rdfs:label>
        <skos:definition xml:lang="en">The process of seeking input from subject matter experts to inform a research question or fill a gap in the evidence.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Expert Input</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Specialist Consultation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Expert Consultation</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/evidence-assessment"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/expert-panel"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/expert-consultation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-d5aa5aca2620</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Evidence Synthesis Methods: catalogue subdomain Evidence Synthesis is one of the subdomains</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/expert-consultation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-assessment"/>
        <dcterms:identifier>HEO-L-02e044f8d47b</dcterms:identifier>
        <linkRationale xml:lang="en">Expert input fills evidence gaps for an assessment (subject definition); an input, not a fixed component</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/expert-consultation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/expert-panel"/>
        <dcterms:identifier>HEO-L-5bcb4def5196</dcterms:identifier>
        <linkRationale xml:lang="en">Consultation draws on an expert panel</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/expert-elicitation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/expert-elicitation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/expert-consultation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/expert-consultation"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/parameter-uncertainty"/>
        <skos:notation>HE-EM-VI-016</skos:notation>
        <dcterms:identifier>HE-EM-VI-016</dcterms:identifier>
        <dcterms:source>Cooke 1991</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Expert Elicitation</rdfs:label>
        <skos:altLabel xml:lang="en">Elicitation of Expert Opinion</skos:altLabel>
        <skos:altLabel xml:lang="en">Structured Expert Judgement</skos:altLabel>
        <skos:definition xml:lang="en">A structured process for obtaining quantitative judgements from subject matter experts on uncertain quantities when direct empirical data are unavailable.</skos:definition>
        <skos:prefLabel xml:lang="en">Expert Elicitation</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/clinical-expert"/>
