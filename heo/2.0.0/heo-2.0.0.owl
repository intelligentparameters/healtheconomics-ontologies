    <!-- https://healtheconomics.wiki/concept/outcomes -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/outcomes">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-economics"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-economics"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/health-economics"/>
        <skos:notation>HE-EE-HO-001</skos:notation>
        <dcterms:identifier>HE-EE-HO-001</dcterms:identifier>
        <dcterms:source>HealthEconomics.wiki subdomain page https://healtheconomics.wiki/subdomain/outcomes (read 16 Oct 2026)</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Outcomes</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/subdomain/outcomes"/>
        <skos:altLabel xml:lang="en">Health Outcomes Research</skos:altLabel>
        <skos:definition xml:lang="en">Outcomes is the area of health economics that measures and values the health consequences an economic evaluation counts, from survival and symptoms to quality-adjusted life years.</skos:definition>
        <skos:editorialNote xml:lang="en">In HEO this concept is the wiki subdomain Outcomes, directly under Health Economics. Concepts in that subdomain with no is-type-of parent are classified under it or under a concept within it.</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Outcomes</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-economics"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-9740f1d38117</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: the wiki subdomain Outcomes (https://healtheconomics.wiki/subdomain/outcomes)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
