        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/donor-funding"/>
        <dcterms:identifier>HEO-L-5a7c224fc5b1</dcterms:identifier>
