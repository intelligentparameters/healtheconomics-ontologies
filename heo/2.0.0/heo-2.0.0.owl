    <!-- https://healtheconomics.wiki/concept/balancing-measure -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/balancing-measure">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/performance-measure"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
