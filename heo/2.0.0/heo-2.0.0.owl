    <!-- https://healtheconomics.wiki/concept/distribution-fitting -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/distribution-fitting">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/parametric-methods"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/parametric-methods"/>
        <skos:notation>HE-EM-MP-011</skos:notation>
        <dcterms:identifier>HE-EM-MP-011</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Vose 2008</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Distribution Fitting</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Fitting Distributions</skos:altLabel>
        <skos:definition xml:lang="en">Distribution fitting selects a probability distribution and estimates its parameters from data to represent the frequency of possible values under stated assumptions.</skos:definition>
