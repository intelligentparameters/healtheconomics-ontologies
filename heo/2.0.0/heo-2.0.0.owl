        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/priority-setting"/>
        <dcterms:identifier>HEO-L-6ef969fb73f0</dcterms:identifier>
