    <!-- https://healtheconomics.wiki/concept/branch -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/branch">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/decision-tree"/>
        <skos:notation>HE-EM-DM-004</skos:notation>
        <dcterms:identifier>HE-EM-DM-004</dcterms:identifier>
        <dcterms:source>Briggs A, Claxton K, Sculpher M. Decision Modelling for Health Economic Evaluation. Oxford University Press; 2006. doi:10.1093/oso/9780198526629.001.0001.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Branch</rdfs:label>
        <skos:definition xml:lang="en">A pathway within a decision tree representing one of the possible outcomes or choices available at a given node.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Outcome Pathway</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Tree Pathway</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Branch</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/branch"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-a7fe20ffc841</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Modelling &gt; Decision Modelling: catalogue subdomain Economic Modelling is one of the subdomains</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/branch"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/decision-tree"/>
        <dcterms:identifier>HEO-L-c37eba728a1a</dcterms:identifier>
        <linkRationale xml:lang="en">Only link; branches are the structural components of a decision tree</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/branching-logic -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/branching-logic">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/conditional-logic"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/conditional-logic"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/decision-tree"/>
        <skos:notation>HE-EM-DM-005</skos:notation>
        <dcterms:identifier>HE-EM-DM-005</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Manski &amp; Molinari 2008</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Branching Logic</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Branching logic is the set of if-then rules that route a health survey respondent, or a patient in a decision model, by earlier answers or chance events.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Model Routing Logic</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Pathway Logic</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Branching Logic</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/data-quality"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/branching-logic"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/conditional-logic"/>
        <dcterms:identifier>HEO-L-a38b4c6a48c4</dcterms:identifier>
        <linkRationale xml:lang="en">Branching logic (routing by earlier answers or chance) is one kind of if-then conditional logic; replaces generic link</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/branching-logic"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/decision-tree"/>
        <dcterms:identifier>HEO-L-ddd9de96583a</dcterms:identifier>
        <linkRationale xml:lang="en">The chance and decision branches with their routing rules form the structure of a decision tree</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/branching-logic"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/data-quality"/>
        <dcterms:identifier>HEO-L-81f667eb512b</dcterms:identifier>
        <linkRationale xml:lang="en">Skip rules stop irrelevant or inconsistent answers, improving data quality</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/brand-name -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/brand-name">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-classification"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/drug-classification"/>
        <skos:notation>HE-PE-DC-003</skos:notation>
        <dcterms:identifier>HE-PE-DC-003</dcterms:identifier>
        <dcterms:source>FDA, Code of Federal Regulations Title 21</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Brand Name</rdfs:label>
        <skos:definition xml:lang="en">The proprietary trademarked name under which a manufacturer markets a specific drug product, unlike its generic, non-proprietary chemical name.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Brand-Name Drug</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Originator Brand</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Brand Name</skos:prefLabel>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/medicinal-product"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/brand-name"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-classification"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-2b5cbd52d585</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Pharmacoeconomics &gt; Drug Classification: drug naming and classification are regulatory conventions (Drug development and regulation); placed under Drug Classification, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/brand-name"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isPropertyOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/medicinal-product"/>
        <dcterms:identifier>HEO-L-576e98ce6402</dcterms:identifier>
        <linkRationale xml:lang="en">Only link; the contrast is with Generic Name (Generic Name contrastsWith Brand Name exists); a brand name is a property of a product</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/brand-tier -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/brand-tier">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/formulary"/>
        <skos:notation>HS-HP-HI-025</skos:notation>
        <dcterms:identifier>HS-HP-HI-025</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Brand Tier</rdfs:label>
        <skos:definition xml:lang="en">A formulary category for brand-name drugs within a tiered insurance design, typically carrying higher cost-sharing than generic drugs in a lower tier.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Brand Drug Tier</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Branded Formulary Tier</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Brand Tier</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/generic-tier"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/brand-tier"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-b25b663bc1c7</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health Insurance: wiki topic Health financing and insurance sits in Health Systems; placed under Health Insurance, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/brand-tier"/>
