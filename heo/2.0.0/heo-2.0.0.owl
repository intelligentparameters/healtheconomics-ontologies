        <skos:altLabel xml:lang="en">Personalized Therapy</skos:altLabel>
        <skos:definition xml:lang="en">A treatment tailored to an individual patient&apos;s specific clinical, genetic, or biomarker characteristics, rather than a uniform strategy for all patients.</skos:definition>
        <skos:prefLabel xml:lang="en">Personalised Therapy</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/stratified-medicine"/>
