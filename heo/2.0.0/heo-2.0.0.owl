        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">PBMA</rdfs:label>
        <skos:altLabel xml:lang="en">Programme Budgeting and Marginal Analysis</skos:altLabel>
        <skos:definition xml:lang="en">An abbreviation for programme budgeting and marginal analysis, a priority-setting method reallocating resources from lower-value to higher-value activities within a fixed budget.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Marginal Reallocation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">PBMA</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/disinvestment"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/resource-reallocation"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/health-needs-assessment"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/marginal-analysis"/>
    </owl:NamedIndividual>
