    <!-- https://healtheconomics.wiki/concept/stigma -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/stigma">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/social-determinants-of-health"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/social-determinants-of-health"/>
        <skos:notation>HE-PE-MH-032</skos:notation>
        <dcterms:identifier>HE-PE-MH-032</dcterms:identifier>
        <dcterms:source>Goffman 1963</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Stigma</rdfs:label>
        <skos:definition xml:lang="en">A social process in which people with a particular characteristic, such as mental illness, are devalued through negative stereotyping and exclusion.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Discrediting Attribute</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Social Disapproval</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Stigma</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/stigma-barrier"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/treatment-gap"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/stigma"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/social-determinants-of-health"/>
        <dcterms:identifier>HEO-L-31fe7c8d8d4b</dcterms:identifier>
        <linkRationale xml:lang="en">Stigma is a social condition that shapes health, a kind of social determinant (Hatzenbuehler et al. 2013)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/stigma"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/stigma-barrier"/>
        <dcterms:identifier>HEO-L-411728fad418</dcterms:identifier>
        <linkRationale xml:lang="en">Stigma creates a fear-of-judgement barrier.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/stigma"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/treatment-gap"/>
        <dcterms:identifier>HEO-L-0e3d5ea3019d</dcterms:identifier>
