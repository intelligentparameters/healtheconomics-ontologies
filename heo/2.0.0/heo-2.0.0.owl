    <!-- https://healtheconomics.wiki/concept/pricing-dossier -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/pricing-dossier">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
