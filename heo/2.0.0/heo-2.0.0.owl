    <!-- https://healtheconomics.wiki/concept/deterministic-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/deterministic-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:notation>HE-EM-UA-016</skos:notation>
        <dcterms:identifier>HE-EM-UA-016</dcterms:identifier>
        <dcterms:source>Briggs A, Claxton K, Sculpher M. Decision Modelling for Health Economic Evaluation. Oxford University Press; 2006. doi:10.1093/oso/9780198526629.001.0001.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Deterministic Analysis</rdfs:label>
        <skos:definition xml:lang="en">An analysis in which every model input is assigned a single, fixed value, producing one specific result rather than a distribution.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Fixed-Input Analysis</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Point-Estimate Analysis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Deterministic Analysis</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/psa"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/deterministic-analysis"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-c57c6d12140f</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Modelling &gt; Uncertainty Analysis: catalogue subdomain Economic Modelling is one of the subdomains</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/deterministic-analysis"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/psa"/>
        <dcterms:identifier>HEO-L-7e6a697cd68b</dcterms:identifier>
        <linkRationale xml:lang="en">Fixed inputs versus jointly drawn inputs</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
