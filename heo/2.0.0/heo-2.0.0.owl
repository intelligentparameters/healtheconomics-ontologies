    <!-- https://healtheconomics.wiki/concept/level-of-detail -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/level-of-detail">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
