    <!-- https://healtheconomics.wiki/concept/clinical-integration -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/clinical-integration">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/integrated-care"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/integrated-care"/>
        <skos:notation>HS-SS_IC-001</skos:notation>
        <dcterms:identifier>HS-SS_IC-001</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-09</dcterms:modified>
        <dcterms:source>Valentijn et al. 2013</dcterms:source>
