        <skos:hiddenLabel xml:lang="en">Psychiatric Service Coverage</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Mental Health Service Coverage</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/mental-health-service-coverage"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-system-performance"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-6e1934a368e0</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Systems Strengthening &gt; Health System Performance: health system strengthening is the Health Systems subdomain; placed under Health System Performance, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/mental-health-service-coverage"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/access-to-care"/>
        <dcterms:identifier>HEO-L-34b0d8fba6b9</dcterms:identifier>
        <linkRationale xml:lang="en">Subject is a measure of access to mental health services, not a benefit category</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/merit-good -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/merit-good">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-good"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/economic-good"/>
        <skos:notation>HE-EE-ME-039</skos:notation>
        <dcterms:identifier>HE-EE-ME-039</dcterms:identifier>
        <dcterms:source>Musgrave 1959</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Merit Good</rdfs:label>
        <skos:definition xml:lang="en">A good society deems worthy of consumption regardless of an individual&apos;s own willingness to pay for it, often subsidised by government.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Meritorious Good</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Socially Encouraged Good</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Merit Good</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/public-good"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/merit-good"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-good"/>
        <dcterms:identifier>HEO-L-5d1893762c15</dcterms:identifier>
        <linkRationale xml:lang="en">A merit good is a class of economic good</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/merit-good"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/public-good"/>
        <dcterms:identifier>HEO-L-d8cb44e65ac9</dcterms:identifier>
        <linkRationale xml:lang="en">Merit goods are excludable and justified by value judgement, unlike public goods</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/meta-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/meta-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/quantitative-synthesis"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q815382"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/quantitative-synthesis"/>
        <skos:notation>HE-ES-ESM-035</skos:notation>
        <dcterms:identifier>HE-ES-ESM-035</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-24</dcterms:modified>
        <dcterms:source>DerSimonian R, Laird N. Meta-analysis in clinical trials. Controlled Clinical Trials. 1986;7(3):177?188. doi:10.1016/0197-2456(86)90046-2.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Meta-Analysis</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">Meta-analysis statistically combines effect estimates from multiple studies addressing a sufficiently similar question.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Effect-Size Pooling</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Pooled Analysis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Meta-Analysis</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-4"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/summary-roc-curve"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/effect-size"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/effect-size-estimation"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/fixed-effect-model"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/funnel-plot-analysis"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/mantel-haenszel-method"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/mean-difference"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/random-effects-model"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/standardised-mean-difference"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/meta-analysis"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:identifier>HEO-L-7ecb6e62f743</dcterms:identifier>
        <linkRationale xml:lang="en">Meta-analysis is a form of evidence synthesis</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/meta-analysis"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/quantitative-synthesis"/>
        <dcterms:identifier>HEO-L-bc2501362b6b</dcterms:identifier>
        <linkRationale xml:lang="en">relatedTo retired; meta-analysis is statistical pooling, i.e. a quantitative synthesis.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/meta-analysis"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#produces"/>
