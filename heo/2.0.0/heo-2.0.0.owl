        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Preventive Treatment</rdfs:label>
        <skos:definition xml:lang="en">Treatment given to reduce the risk of a disease developing, encompassing both medications and procedures for individuals without clinically apparent disease.</skos:definition>
