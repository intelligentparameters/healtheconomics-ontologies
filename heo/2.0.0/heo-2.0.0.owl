    <!-- https://healtheconomics.wiki/concept/instrumental-variable-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/instrumental-variable-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
