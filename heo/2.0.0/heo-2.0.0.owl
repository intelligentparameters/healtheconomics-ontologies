        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/matrix-algebra"/>
    </owl:NamedIndividual>
    <owl:Axiom>
