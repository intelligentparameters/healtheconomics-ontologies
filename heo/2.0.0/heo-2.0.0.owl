        <skos:notation>HE-EM-UA-086</skos:notation>
        <dcterms:identifier>HE-EM-UA-086</dcterms:identifier>
        <dcterms:source>Briggs A, Claxton K, Sculpher M. Decision Modelling for Health Economic Evaluation. Oxford University Press; 2006. doi:10.1093/oso/9780198526629.001.0001.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Worst Case Scenario</rdfs:label>
        <skos:definition xml:lang="en">A combination of assumptions representing the least favourable plausible circumstances for an intervention&apos;s cost-effectiveness, used within scenario analysis.</skos:definition>
        <skos:prefLabel xml:lang="en">Worst Case Scenario</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/worst-case-scenario"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
