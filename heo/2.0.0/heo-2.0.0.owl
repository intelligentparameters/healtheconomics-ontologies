    <!-- https://healtheconomics.wiki/concept/system-quality -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/system-quality">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <skos:notation>HS-SS_HQ-018</skos:notation>
        <dcterms:identifier>HS-SS_HQ-018</dcterms:identifier>
        <dcterms:source>Donabedian A. Evaluating the quality of medical care. Milbank Memorial Fund Quarterly. 1966;44(3):166-206. doi:10.2307/3348969.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">System Quality</rdfs:label>
        <skos:definition xml:lang="en">The overall degree to which an entire health system achieves desired outcomes consistent with professional knowledge, delivered efficiently and equitably.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Organisational Quality</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Overall Care Quality</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">System Quality</skos:prefLabel>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/health-system"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/system-quality"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <dcterms:identifier>HEO-L-b758c23e8820</dcterms:identifier>
        <linkRationale xml:lang="en">Quality of care is defined for individuals and populations, so system-level quality is a kind of it.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/system-quality"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isPropertyOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-system"/>
        <dcterms:identifier>HEO-L-6b21eb02a38e</dcterms:identifier>
        <linkRationale xml:lang="en">System quality is a characteristic of a health system, per the subject definition</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/system-resilience -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/system-resilience">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS_SS_HS-020</skos:notation>
        <dcterms:identifier>HS_SS_HS-020</dcterms:identifier>
        <dcterms:source>Kruk et al. 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">System Resilience</rdfs:label>
        <skos:definition xml:lang="en">A health system&apos;s capacity to prepare for, respond to, and recover from a significant shock, such as a disease outbreak, while continuing essential services.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Shock-Absorption Capacity</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">System Robustness</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">System Resilience</skos:prefLabel>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/health-system"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/system-resilience"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-678b6b4b3c47</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Systems Strengthening &gt; Health Systems: health system strengthening is the Health Systems subdomain</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/system-resilience"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isPropertyOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-system"/>
        <dcterms:identifier>HEO-L-841eb5d62d96</dcterms:identifier>
        <linkRationale xml:lang="en">Resilience is a capacity of a health system, per the subject definition, not a constituent</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/system-sustainability -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/system-sustainability">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/sustainability"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/sustainability"/>
        <skos:notation>HS_SS_HS-023</skos:notation>
        <dcterms:identifier>HS_SS_HS-023</dcterms:identifier>
        <dcterms:source>Brundtland Commission 1987</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">System Sustainability</rdfs:label>
        <skos:definition xml:lang="en">The capacity of a health system&apos;s financing, workforce, and infrastructure to be maintained long term without unsustainable debt or disruptive cuts.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Long-Run Affordability</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Systemic Viability</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">System Sustainability</skos:prefLabel>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/health-system"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/system-sustainability"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/sustainability"/>
        <dcterms:identifier>HEO-L-9a0f3aa55d85</dcterms:identifier>
        <linkRationale xml:lang="en">System sustainability is sustainability applied to the health system.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/system-sustainability"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isPropertyOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-system"/>
        <dcterms:identifier>HEO-L-d93e1dcc789b</dcterms:identifier>
        <linkRationale xml:lang="en">Subject definition, a capacity of the health system, a characteristic not a component</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/system-testing -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/system-testing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/software-verification"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/testing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/software-verification"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/testing"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/technical-verification"/>
        <precedes rdf:resource="https://healtheconomics.wiki/concept/acceptance-testing"/>
        <skos:notation>HE-EM-MV-077</skos:notation>
        <dcterms:identifier>HE-EM-MV-077</dcterms:identifier>
        <dcterms:source>Eddy DM, Hollingworth W, Caro JJ, et al. Model transparency and validation: a report of the ISPOR-SMDM Modeling Good Research Practices Task Force-7. Value in Health. 2012;15(6):843-850. doi:10.1016/j.jval.2012.04.012.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">System Testing</rdfs:label>
        <skos:definition xml:lang="en">A verification technique evaluating a complete model as an integrated whole, confirming all its components work together to produce sensible results.</skos:definition>
        <skos:hiddenLabel xml:lang="en">End-to-End Testing</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Integrated Testing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">System Testing</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/unit-testing"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/system-testing"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/software-verification"/>
        <dcterms:identifier>HEO-L-a2e71da7aa9d</dcterms:identifier>
        <linkRationale xml:lang="en">Testing a whole model confirms it implements its specification, software verification.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/system-testing"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/testing"/>
        <dcterms:identifier>HEO-L-c87789351ec4</dcterms:identifier>
        <linkRationale xml:lang="en">System testing is testing applied to the integrated model.</linkRationale>
