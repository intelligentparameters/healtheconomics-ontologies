    <!-- https://healtheconomics.wiki/concept/substituted-judgment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/substituted-judgment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-HP-HD-108</skos:notation>
        <dcterms:identifier>HS-HP-HD-108</dcterms:identifier>
        <dcterms:source>Appelbaum &amp; Grisso 1988</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Substituted Judgment</rdfs:label>
        <skos:altLabel xml:lang="en">Substituted Judgement</skos:altLabel>
        <skos:definition xml:lang="en">A decision standard for a surrogate acting for a patient lacking capacity, choosing what the patient themselves would have chosen based on known values.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Proxy Judgment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Substituted Judgment</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/substituted-judgment"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-04c5dd88ee77</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Healthcare Delivery: organisation and delivery of care is the Health Systems subdomain (Organisation and governance)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/substitution-effect -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/substitution-effect">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q372251"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/demand"/>
        <skos:notation>HE-EE-BIA-046</skos:notation>
        <dcterms:identifier>HE-EE-BIA-046</dcterms:identifier>
        <dcterms:source>Hicks 1939</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Substitution Effect</rdfs:label>
        <skos:definition xml:lang="en">The change in quantity of a good consumed that results purely from a change in its relative price, holding purchasing power constant.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Relative-Price Effect</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Substitution Response</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Substitution Effect</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/price-elasticity-of-demand"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/substitution-effect"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-73a0b03bb363</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Demand supply and markets in subdomain Economic Foundations</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/substitution-effect"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/demand"/>
        <dcterms:identifier>HEO-L-8983be25e270</dcterms:identifier>
        <linkRationale xml:lang="en">The substitution effect is one component of the demand response to price (Slutsky decomposition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/substitution-effect"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/price-elasticity-of-demand"/>
        <dcterms:identifier>HEO-L-7bfe4a737754</dcterms:identifier>
        <linkRationale xml:lang="en">The substitution effect is one component of the quantity response that price elasticity summarises.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
