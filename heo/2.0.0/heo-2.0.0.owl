    <!-- https://healtheconomics.wiki/concept/boost-intervention -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/boost-intervention">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/behaviour-change-intervention"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/behaviour-change-intervention"/>
