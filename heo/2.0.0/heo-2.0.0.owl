        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Reimbursement Decision</rdfs:label>
        <skos:definition xml:lang="en">The formal determination by a payer regarding whether, and under what conditions, a technology will be financially covered for a population.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Coverage Verdict</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Reimbursement Verdict</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Reimbursement Decision</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/reimbursement-decision"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/coverage-decision"/>
        <dcterms:identifier>HEO-L-93a5755a1066</dcterms:identifier>
        <linkRationale xml:lang="en">A reimbursement decision is a payer ruling on funding, a coverage decision.</linkRationale>
