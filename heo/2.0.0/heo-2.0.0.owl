    <!-- https://healtheconomics.wiki/concept/non-preferred-drug -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/non-preferred-drug">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
