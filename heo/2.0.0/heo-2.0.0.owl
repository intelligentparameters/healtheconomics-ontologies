    <!-- https://healtheconomics.wiki/concept/probability-to-rate-conversion -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/probability-to-rate-conversion">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
