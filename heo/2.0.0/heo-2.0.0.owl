        <skos:notation>HS-SS_HD-003</skos:notation>
        <dcterms:identifier>HS-SS_HD-003</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Heslin et al. 2024</dcterms:source>
