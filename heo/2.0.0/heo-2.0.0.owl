        <dcterms:identifier>HE-ES-CTM-099</dcterms:identifier>
        <dcterms:source>Friedman LM, Furberg CD, DeMets DL, Reboussin DM, Granger CB. Fundamentals of Clinical Trials. 5th ed. Springer; 2015. doi:10.1007/978-3-319-18539-2.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Trial Population</rdfs:label>
        <skos:definition xml:lang="en">The specific group of individuals enrolled in a trial, defined by the study&apos;s inclusion and exclusion criteria.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Enrolled Population</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Study Population</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Trial Population</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/target-population"/>
