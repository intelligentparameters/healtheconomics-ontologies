        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/nudge-intervention"/>
        <dcterms:identifier>HEO-L-6ae90bbd9185</dcterms:identifier>
        <linkRationale xml:lang="en">A default is a choice-architecture nudge</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
