        <rdfs:label xml:lang="en">Administrative Feasibility</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Administrative feasibility is whether the agencies that would run a health policy have the staff, systems and mandate to deliver it as designed.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Implementation Feasibility</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Institutional Feasibility</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Administrative Feasibility</skos:prefLabel>
