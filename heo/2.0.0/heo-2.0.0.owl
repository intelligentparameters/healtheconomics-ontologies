    <!-- https://healtheconomics.wiki/concept/duplicate-order-alert -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/duplicate-order-alert">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
