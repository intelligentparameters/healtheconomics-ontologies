        <skos:altLabel xml:lang="en">Individual-Level Markov Model</skos:altLabel>
        <skos:definition xml:lang="en">Markov microsimulation is an individual-level state-transition modeling method that simulates each person&apos;s sequence of health states over time using transition probabilities that may depend on current state, personal characteristics, time, and explicitly retained history.</skos:definition>
        <skos:hiddenLabel xml:lang="en">First-Order Markov Simulation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Markov Microsimulation</skos:prefLabel>
