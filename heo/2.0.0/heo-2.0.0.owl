        <skos:prefLabel xml:lang="en">Prognostic Model</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/prognostic-biomarker"/>
    </owl:NamedIndividual>
