    <!-- https://healtheconomics.wiki/concept/adverse-drug-event -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/adverse-drug-event">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/adverse-event"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/adverse-event"/>
        <skos:notation>PP-PC-MS-001</skos:notation>
        <dcterms:identifier>PP-PC-MS-001</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>AHRQ 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Adverse Drug Event</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">ADE</skos:altLabel>
        <skos:definition xml:lang="en">An adverse drug event (ADE) is harm to a patient from a medicine, whether caused by a medication error or by a reaction despite correct use.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Drug-Related Injury</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Adverse Drug Event</skos:prefLabel>
        <abbreviation xml:lang="en">ADE</abbreviation>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/admissions"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/length-of-stay"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/mortality"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/adverse-drug-event"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/adverse-event"/>
        <dcterms:identifier>HEO-L-0892cb370fe2</dcterms:identifier>
        <linkRationale xml:lang="en">Harm from a medicine is an adverse event</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
