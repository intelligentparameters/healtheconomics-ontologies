    <!-- https://healtheconomics.wiki/concept/incremental-analysis-method -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/incremental-analysis-method">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <skos:notation>HE-EE_EA-026</skos:notation>
        <dcterms:identifier>HE-EE_EA-026</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Incremental Analysis Method</rdfs:label>
        <skos:definition xml:lang="en">An analytic approach comparing the additional cost and effect of one option relative to the next best alternative, rather than each option&apos;s total.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Incremental Approach</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Marginal Comparison Method</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Incremental Analysis Method</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/incremental-cost"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/incremental-analysis-method"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-4c192f2e1f72</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: curated: review B: incremental analysis is the core CEA method</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/incremental-analysis-method"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <dcterms:identifier>HEO-L-80e21e3d1c64</dcterms:identifier>
        <linkRationale xml:lang="en">Comparing extra cost and effect against the next best option is the core step of CEA</linkRationale>
