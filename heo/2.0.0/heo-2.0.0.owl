    <!-- https://healtheconomics.wiki/concept/minimal-response -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/minimal-response">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-response"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/clinical-response"/>
        <skos:notation>HE-ES-CO-044</skos:notation>
        <dcterms:identifier>HE-ES-CO-044</dcterms:identifier>
        <dcterms:source>Baccarani et al. 2013</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Minimal Response</rdfs:label>
        <skos:altLabel xml:lang="en">Minor Response</skos:altLabel>
        <skos:definition xml:lang="en">A response criterion indicating some improvement following treatment, but of a lesser degree than a partial or major response under disease-specific criteria.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Slight Response</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Minimal Response</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/partial-response"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/minimal-response"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/clinical-response"/>
        <dcterms:identifier>HEO-L-b315a0eae1fc</dcterms:identifier>
        <linkRationale xml:lang="en">A minimal response is a predefined response criterion</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/minimal-response"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/partial-response"/>
        <dcterms:identifier>HEO-L-cb04299272bc</dcterms:identifier>
