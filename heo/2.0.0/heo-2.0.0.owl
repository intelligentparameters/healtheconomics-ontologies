    <!-- https://healtheconomics.wiki/concept/episode-based-payment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/episode-based-payment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/bundled-payment"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/bundled-payment"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <skos:notation>HS-HP-PP-046</skos:notation>
        <dcterms:identifier>HS-HP-PP-046</dcterms:identifier>
        <dcterms:source>CMS, Bundled Payments for Care Improvement</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Episode-Based Payment</rdfs:label>
        <skos:altLabel xml:lang="en">Episode Payment</skos:altLabel>
        <skos:definition xml:lang="en">A methodology reimbursing a single, comprehensive amount for all care within a defined clinical episode, incentivising efficient, coordinated care.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Bundled Episode Reimbursement</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Care-Episode Reimbursement</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Episode Reimbursement</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Per-Episode Bundled Payment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Episode-Based Payment</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/episode-based-payment"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/bundled-payment"/>
        <dcterms:identifier>HEO-L-5061fb4bda03</dcterms:identifier>
        <linkRationale xml:lang="en">Both definitions describe one price for all care in an episode; episode-based payment is a bundled payment</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
