    <!-- https://healtheconomics.wiki/concept/readmission-rate -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/readmission-rate">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
