    <!-- https://healtheconomics.wiki/concept/seir-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/seir-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/compartmental-model"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/dynamic-transmission-model"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q5382699"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/compartmental-model"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/dynamic-transmission-model"/>
        <skos:notation>HE-EM-DM-088</skos:notation>
        <dcterms:identifier>HE-EM-DM-088</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
