    <!-- https://healtheconomics.wiki/concept/free-rider-problem -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/free-rider-problem">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/market-failure"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/market-failure"/>
        <skos:notation>HE-EE-ME-024</skos:notation>
        <dcterms:identifier>HE-EE-ME-024</dcterms:identifier>
        <dcterms:source>Olson 1965</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Free Rider Problem</rdfs:label>
        <skos:altLabel xml:lang="en">Free Riding</skos:altLabel>
        <skos:definition xml:lang="en">A situation in which individuals benefit from a shared resource or collective action without contributing to its cost, because exclusion is not feasible.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Collective Action Problem</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Free Rider Problem</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/public-goods-provision"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/free-rider-problem"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/market-failure"/>
        <dcterms:identifier>HEO-L-41b88547547f</dcterms:identifier>
        <linkRationale xml:lang="en">Free riding is a market failure</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/free-rider-problem"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/public-goods-provision"/>
        <dcterms:identifier>HEO-L-e88b83491f18</dcterms:identifier>
        <linkRationale xml:lang="en">Free riding causes undersupply of public goods</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/free-rider-problem-in-insurance -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/free-rider-problem-in-insurance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/free-rider-problem"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/free-rider-problem"/>
