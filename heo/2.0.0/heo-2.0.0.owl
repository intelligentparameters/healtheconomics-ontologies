    <!-- https://healtheconomics.wiki/concept/net-monetary-benefit -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/net-monetary-benefit">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
