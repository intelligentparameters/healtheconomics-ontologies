    <!-- https://healtheconomics.wiki/concept/present-bias-concept -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/present-bias-concept">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/time-preference"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/time-preference"/>
        <skos:notation>HE-EE-BE-031</skos:notation>
        <dcterms:identifier>HE-EE-BE-031</dcterms:identifier>
        <dcterms:source>O&apos;Donoghue &amp; Rabin 1999</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Present Bias</rdfs:label>
        <skos:definition xml:lang="en">The tendency to place disproportionate weight on immediate rewards or costs relative to future ones, beyond what constant discounting predicts.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Current-Moment Bias</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Present Bias Concept</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Present Bias</skos:prefLabel>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/self-control-concept"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/hyperbolic-discounting"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/present-bias-concept"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/time-preference"/>
        <dcterms:identifier>HEO-L-773bd3012d66</dcterms:identifier>
        <linkRationale xml:lang="en">Present bias is a form of time preference</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
