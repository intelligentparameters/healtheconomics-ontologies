    <!-- https://healtheconomics.wiki/concept/contact-rate -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/contact-rate">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/parameter-input"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/parameter-input"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/basic-reproduction-number"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/force-of-infection"/>
        <skos:notation>HE-EM-MP-008</skos:notation>
        <dcterms:identifier>HE-EM-MP-008</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Kermack &amp; McKendrick 1927</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Contact Rate</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">Contact rate is the expected number of defined, potentially transmission-relevant encounters an individual has per unit time in an infectious-disease model.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Contact Frequency</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Mixing Rate</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Contact Rate</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-4"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/contact-rate"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/parameter-input"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-134d40fd777e</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Model inputs and parameters in subdomain Economic Modelling; placed under Parameter Input, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/contact-rate"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/basic-reproduction-number"/>
        <dcterms:identifier>HEO-L-6cbcb7dc2e7b</dcterms:identifier>
        <linkRationale xml:lang="en">Full page kept; contact rate is an input to R0 and to transmission models.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
