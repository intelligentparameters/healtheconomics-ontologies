        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">SEIR Compartmental Model</skos:altLabel>
        <skos:altLabel xml:lang="en">Susceptible-Exposed-Infectious-Recovered Model</skos:altLabel>
        <skos:definition xml:lang="en">An extension of the basic epidemic model adding an exposed compartment for individuals infected but not yet infectious, before they become infectious.</skos:definition>
        <skos:prefLabel xml:lang="en">SEIR Model</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/sir-model"/>
