    <!-- https://healtheconomics.wiki/concept/sign-out -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/sign-out">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/handoff"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/handoff"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/care-coordination"/>
