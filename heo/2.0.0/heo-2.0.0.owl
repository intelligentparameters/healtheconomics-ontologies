    <!-- https://healtheconomics.wiki/concept/dispersion -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/dispersion">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
