        <dcterms:identifier>HE-EM-SM-086</dcterms:identifier>
        <dcterms:source>Cox 1972</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Time-Fixed Covariate</rdfs:label>
        <skos:altLabel xml:lang="en">Baseline Covariate</skos:altLabel>
        <skos:altLabel xml:lang="en">Time-Invariant Covariate</skos:altLabel>
        <skos:definition xml:lang="en">A patient characteristic in a survival model measured once and assumed constant throughout follow-up, such as baseline age or sex.</skos:definition>
        <skos:prefLabel xml:lang="en">Time-Fixed Covariate</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/time-varying-covariate"/>
