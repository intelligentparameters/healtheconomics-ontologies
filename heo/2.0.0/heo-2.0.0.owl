    <!-- https://healtheconomics.wiki/concept/safety-net-provider -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/safety-net-provider">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
