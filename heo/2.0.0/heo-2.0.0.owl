    <!-- https://healtheconomics.wiki/concept/national-health-service -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/national-health-service">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
