        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/genetic-discrimination"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/discrimination-barrier"/>
        <dcterms:identifier>HEO-L-037efd3922b4</dcterms:identifier>
        <linkRationale xml:lang="en">Existing parent Discrimination is the statistical model-discrimination concept (wrong sense, should be removed); underwriting on genetic information is how it arises in insurance</linkRationale>
