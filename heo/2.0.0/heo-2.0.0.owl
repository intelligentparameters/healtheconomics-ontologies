    <!-- https://healtheconomics.wiki/concept/failure-to-rescue -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/failure-to-rescue">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/mortality-measure"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q98795374"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/mortality-measure"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/patient-safety"/>
        <skos:notation>HS-HP-HQ-012</skos:notation>
        <dcterms:identifier>HS-HP-HQ-012</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-24</dcterms:modified>
        <dcterms:source>Silber, Williams, Krakauer &amp; Schwartz 1992</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Failure to Rescue</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">FTR</skos:altLabel>
        <skos:definition xml:lang="en">Failure to rescue is a serious adverse outcome, usually death, among patients who experience a defined potentially treatable complication, commonly measured as deaths divided by patients with qualifying complications.</skos:definition>
        <skos:prefLabel xml:lang="en">Failure to Rescue</skos:prefLabel>
        <abbreviation xml:lang="en">FTR</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
