    <!-- https://healtheconomics.wiki/concept/economic-evidence -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/economic-evidence">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/evidence"/>
        <skos:notation>HE-ES-EA-013</skos:notation>
        <dcterms:identifier>HE-ES-EA-013</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Economic Evidence</rdfs:label>
        <skos:altLabel xml:lang="en">Economic Data Health</skos:altLabel>
        <skos:definition xml:lang="en">Data and analysis addressing the costs, resource use, and cost-effectiveness of health interventions, distinct from clinical evidence on safety and efficacy alone.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cost and Resource Data</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Cost-Effectiveness Evidence</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Health Economic Data</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Value Evidence</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Economic Evidence</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/economic-evidence"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence"/>
        <dcterms:identifier>HEO-L-6140f193ad29</dcterms:identifier>
        <linkRationale xml:lang="en">economic evidence is evidence</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/economic-evidence"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
