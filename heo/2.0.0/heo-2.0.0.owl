    <!-- https://healtheconomics.wiki/concept/evidence-base -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/evidence-base">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-assessment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-assessment"/>
        <skos:notation>HE-ES-EA-015</skos:notation>
        <dcterms:identifier>HE-ES-EA-015</dcterms:identifier>
        <dcterms:source>Guyatt GH, Oxman AD, Vist GE, et al. GRADE: an emerging consensus on rating quality of evidence and strength of recommendations. BMJ. 2008;336:924-926. doi:10.1136/bmj.39489.470347.AD.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Evidence Base</rdfs:label>
        <skos:definition xml:lang="en">The complete collection of research findings relevant to a particular question, upon which conclusions and recommendations are built.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Body of Findings</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Research Evidence Corpus</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Evidence Base</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/practice-guidelines"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
