        <dcterms:identifier>HE-ES-CTM-086</dcterms:identifier>
        <dcterms:source>Friedman LM, Furberg CD, DeMets DL, Reboussin DM, Granger CB. Fundamentals of Clinical Trials. 5th ed. Springer; 2015. doi:10.1007/978-3-319-18539-2.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Single-Arm Trial</rdfs:label>
        <skos:altLabel xml:lang="en">Single-Arm Study</skos:altLabel>
        <skos:altLabel xml:lang="en">Uncontrolled Trial</skos:altLabel>
        <skos:definition xml:lang="en">A trial design in which all participants receive the same treatment without a concurrently randomised comparator, assessed against historical or external data.</skos:definition>
        <skos:prefLabel xml:lang="en">Single-Arm Trial</skos:prefLabel>
