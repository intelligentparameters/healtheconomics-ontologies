    <!-- https://healtheconomics.wiki/concept/time-driven-activity-based-costing -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/time-driven-activity-based-costing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/activity-based-costing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/activity-based-costing"/>
        <skos:notation>HE-EE-CM-018</skos:notation>
        <dcterms:identifier>HE-EE-CM-018</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Kaplan &amp; Anderson 2004</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Time-Driven Activity-Based Costing</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">TDABC</skos:altLabel>
        <skos:altLabel xml:lang="en">Time-Driven ABC</skos:altLabel>
        <skos:definition xml:lang="en">A costing method estimating a service&apos;s cost by multiplying the capacity cost rate of resources involved by the time required to complete each activity.</skos:definition>
        <skos:prefLabel xml:lang="en">Time-Driven Activity-Based Costing</skos:prefLabel>
        <abbreviation xml:lang="en">TDABC</abbreviation>
        <abbreviation xml:lang="en">Time-Driven ABC</abbreviation>
        <informs rdf:resource="https://healtheconomics.wiki/concept/capacity-planning"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/costs#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/cost-allocation"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/time-driven-activity-based-costing"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/activity-based-costing"/>
        <dcterms:identifier>HEO-L-7484330cd9b1</dcterms:identifier>
        <linkRationale xml:lang="en">TDABC is the time-driven variant of activity-based costing.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/time-driven-activity-based-costing"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/capacity-planning"/>
        <dcterms:identifier>HEO-L-635d3d7aad45</dcterms:identifier>
        <linkRationale xml:lang="en">TDABC capacity cost rates and activity times inform capacity planning.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/time-driven-activity-based-costing"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-allocation"/>
        <dcterms:identifier>HEO-L-c1bbbb60945e</dcterms:identifier>
        <linkRationale xml:lang="en">TDABC allocates resource costs to activities by the time each uses.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/time-fixed-covariate -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/time-fixed-covariate">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
