    <!-- https://healtheconomics.wiki/concept/insurance-policy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/insurance-policy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
