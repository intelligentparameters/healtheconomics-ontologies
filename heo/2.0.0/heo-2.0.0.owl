    <!-- https://healtheconomics.wiki/concept/induction-therapy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/induction-therapy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/treatment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/treatment"/>
        <precedes rdf:resource="https://healtheconomics.wiki/concept/consolidation-therapy"/>
        <skos:notation>HE-PE-DT-023</skos:notation>
        <dcterms:identifier>HE-PE-DT-023</dcterms:identifier>
        <dcterms:source>DeVita, Lawrence &amp; Rosenberg 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Induction Therapy</rdfs:label>
        <skos:altLabel xml:lang="en">Induction Regimen</skos:altLabel>
        <skos:definition xml:lang="en">An initial, often intensive treatment given to rapidly reduce disease burden at the start of a course, typically followed by consolidation or maintenance.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Initial Intensive Therapy</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Induction Therapy</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/induction-therapy"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/treatment"/>
        <dcterms:identifier>HEO-L-61fb95f65ff4</dcterms:identifier>
        <linkRationale xml:lang="en">Induction therapy is a treatment</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
