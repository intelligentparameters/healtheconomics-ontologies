        <dcterms:source>Idler &amp; Benyamini 1997</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Self-Reported Health</rdfs:label>
        <skos:definition xml:lang="en">Health status information provided directly by the patient rather than through clinical examination, ranging from a simple rating to detailed symptom questionnaires.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Patient-Reported Health</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Self-Report Health Data</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Self-Reported Health</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
