    <!-- https://healtheconomics.wiki/concept/cost-to-charge-ratio -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cost-to-charge-ratio">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/relative-weight"/>
        <skos:notation>HE-EE-HP-002</skos:notation>
        <dcterms:identifier>HE-EE-HP-002</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</dcterms:modified>
        <dcterms:source>Pickens et al. 2021</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cost-to-Charge Ratio</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:altLabel xml:lang="en">CCR</skos:altLabel>
        <skos:altLabel xml:lang="en">Cost-Charge Ratio</skos:altLabel>
        <skos:definition xml:lang="en">The cost-to-charge ratio (CCR) is a hospital&apos;s reported costs divided by its billed charges, used to estimate costs from the charges on patient records.</skos:definition>
        <skos:prefLabel xml:lang="en">Cost-to-Charge Ratio</skos:prefLabel>
        <abbreviation xml:lang="en">CCR</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/costs#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cost-to-charge-ratio"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-b31887a0470b</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Costing methods in subdomain Costs</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cost-to-charge-ratio"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <dcterms:identifier>HEO-L-68dffb65b62f</dcterms:identifier>
        <linkRationale xml:lang="en">Cost is estimated as charges multiplied by the CCR (subject definition); a ratio does not measure cost</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
