    <!-- https://healtheconomics.wiki/concept/outcome-reporting-bias -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/outcome-reporting-bias">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/reporting-bias"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/reporting-bias"/>
        <skos:notation>HE-DS-BV-022</skos:notation>
        <dcterms:identifier>HE-DS-BV-022</dcterms:identifier>
        <dcterms:source>Chan et al. 2004</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Outcome Reporting Bias</rdfs:label>
        <skos:altLabel xml:lang="en">Selective Outcome Reporting</skos:altLabel>
        <skos:definition xml:lang="en">Bias arising when the outcomes reported in a published study are selected based on the direction or significance of their results, not as originally planned.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Outcome Switching</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Outcome Reporting Bias</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/publication-bias"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/outcome-reporting-bias"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/reporting-bias"/>
        <dcterms:identifier>HEO-L-44dc1e8a1915</dcterms:identifier>
        <linkRationale xml:lang="en">Object definition covers outcome-level selective reporting</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/outcome-reporting-bias"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/publication-bias"/>
        <dcterms:identifier>HEO-L-e9c48edfa653</dcterms:identifier>
        <linkRationale xml:lang="en">Outcome-level versus study-level selective reporting are the two contrasting reporting biases</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/outcome-reporting-bias"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#threatensValidityOf"/>
