        <skos:altLabel xml:lang="en">Named-Patient Supply</skos:altLabel>
        <skos:definition xml:lang="en">A pathway letting a physician request an unlicensed medicine for a specific, individually identified patient with unmet clinical need before formal approval.</skos:definition>
        <skos:prefLabel xml:lang="en">Named Patient Programme</skos:prefLabel>
        <abbreviation xml:lang="en">NPP</abbreviation>
