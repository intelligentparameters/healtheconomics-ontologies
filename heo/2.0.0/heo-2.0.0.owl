    <!-- https://healtheconomics.wiki/concept/patient-experience-outcome -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/patient-experience-outcome">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcome-measure"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/outcome-measure"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/patient-experience"/>
        <skos:notation>HE-ES-CO-054</skos:notation>
        <dcterms:identifier>HE-ES-CO-054</dcterms:identifier>
        <dcterms:source>U.S. Food and Drug Administration. Guidance for Industry: Patient-Reported Outcome Measures-Use in Medical Product Development to Support Labeling Claims. FDA; 2009.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Patient Experience Outcome</rdfs:label>
        <skos:altLabel xml:lang="en">PREM Outcome</skos:altLabel>
        <skos:definition xml:lang="en">A measure of a patient&apos;s subjective care experience, covering provider communication and care coordination, distinct from an overall satisfaction rating.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Experience Outcome</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Patient Experience Outcome</skos:prefLabel>
        <abbreviation xml:lang="en">PREM Outcome</abbreviation>
