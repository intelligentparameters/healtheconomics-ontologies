    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/optimisation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/optimisation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/numerical-method"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q141495"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/numerical-method"/>
        <skos:notation>HE-EM-DM-100</skos:notation>
        <dcterms:identifier>HE-EM-DM-100</dcterms:identifier>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Optimisation</rdfs:label>
        <skos:altLabel xml:lang="en">Optimization</skos:altLabel>
        <skos:definition xml:lang="en">In health economics, the selection of the resource allocation or treatment decision that maximises health outcomes or net benefit subject to budget and capacity constraints, applied in decision-analytic modelling and priority setting.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Objective Maximisation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Optimisation</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/newton-raphson-method"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/optimisation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/numerical-method"/>
        <dcterms:identifier>HEO-L-c51d2b63354f</dcterms:identifier>
        <linkRationale xml:lang="en">Optimisation methods are computational procedures solving maximisation problems</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/optimisation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/newton-raphson-method"/>
        <dcterms:identifier>HEO-L-0d2250abfaee</dcterms:identifier>
