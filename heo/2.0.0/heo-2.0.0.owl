        <partOf rdf:resource="https://healtheconomics.wiki/concept/model-structure"/>
        <skos:notation>HE-EM-MM-029</skos:notation>
        <dcterms:identifier>HE-EM-MM-029</dcterms:identifier>
        <dcterms:source>Sonnenberg FA, Beck JR. Markov models in medical decision making: a practical guide. Medical Decision Making. 1993;13(4):322-338. doi:10.1177/0272989X9301300409.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Transition Structure</rdfs:label>
        <skos:definition xml:lang="en">The overall pattern of permitted movements between health states within a Markov model, reflecting which transitions are clinically plausible.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Allowed-Move Pattern</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">State-Flow Structure</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Transition Structure</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/transition-matrix"/>
    </owl:NamedIndividual>
