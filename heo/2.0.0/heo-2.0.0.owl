        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/absolute-risk"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/parameter-input"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/absolute-risk-reduction"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/relative-risk"/>
        <skos:notation>HE-EM-MP-004</skos:notation>
        <dcterms:identifier>HE-EM-MP-004</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Dias et al. 2011 (NICE DSU TSD 5)</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Baseline Risk</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Baseline Event Rate</skos:altLabel>
        <skos:definition xml:lang="en">Baseline risk is the probability of an event without the intervention under study; models apply relative treatment effects to it to give absolute benefit.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Untreated Risk</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Baseline Risk</skos:prefLabel>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
