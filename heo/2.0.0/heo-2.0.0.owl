    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/sunset-clause"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#setsScopeOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/conditional-coverage"/>
        <dcterms:identifier>HEO-L-b18d7a58c6a5</dcterms:identifier>
        <linkRationale xml:lang="en">The expiry date sets the period within which conditional coverage applies.</linkRationale>
