        <dcterms:identifier>HS-HP-HI-066</dcterms:identifier>
        <dcterms:source>Ellis 2008</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Demographic Adjustment</rdfs:label>
        <skos:altLabel xml:lang="en">Demographic Risk Adjustment</skos:altLabel>
        <skos:definition xml:lang="en">A risk adjustment method predicting expected costs based on basic characteristics, such as age and sex, without detailed clinical diagnosis information.</skos:definition>
