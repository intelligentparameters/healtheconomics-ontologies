    <!-- https://healtheconomics.wiki/concept/demographic-adjustment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/demographic-adjustment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/risk-adjustment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/risk-adjustment"/>
