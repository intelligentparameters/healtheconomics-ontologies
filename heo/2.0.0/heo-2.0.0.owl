    <!-- https://healtheconomics.wiki/concept/coverage-expansion -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/coverage-expansion">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/access-policy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/access-policy"/>
        <skos:notation>HS-HP-HI-055</skos:notation>
        <dcterms:identifier>HS-HP-HI-055</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</dcterms:modified>
        <dcterms:source>WHO 2010</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Coverage Expansion</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:definition xml:lang="en">Coverage expansion is a policy change that extends health cover to more people, adds services or cuts cost sharing, moving towards universal coverage.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Coverage Extension</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Scope Expansion</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Coverage Expansion</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/access-to-care"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/crowding-out"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/financial-protection"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/universal-health-coverage"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/coverage-expansion"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/access-policy"/>
        <dcterms:identifier>HEO-L-a8ae3951c709</dcterms:identifier>
        <linkRationale xml:lang="en">A coverage measure is one of the access policy measures in the object definition</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
