    <!-- https://healtheconomics.wiki/concept/morbidity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/morbidity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-outcome"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1367554"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-outcome"/>
        <skos:notation>HS-HP-PHO-013</skos:notation>
        <dcterms:identifier>HS-HP-PHO-013</dcterms:identifier>
        <dcterms:source>Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams &amp; Wilkins; 2008.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Morbidity</rdfs:label>
        <skos:definition xml:lang="en">The state of being affected by a disease, covering associated symptoms, functional impairment, and reduced quality of life, unlike mortality.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Disease Occurrence</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Sickness Rate</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Morbidity</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/mortality"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/burden-of-illness"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/morbidity"/>
