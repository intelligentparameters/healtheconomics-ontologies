        <rdfs:label xml:lang="en">Mass Screening</rdfs:label>
        <skos:altLabel xml:lang="en">Universal Screening</skos:altLabel>
        <skos:definition xml:lang="en">A screening programme offered to an entire defined population regardless of individual risk factors, unlike targeted screening of higher-risk subgroups.</skos:definition>
