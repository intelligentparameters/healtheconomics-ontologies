        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q17126475"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-PE-CP-008</skos:notation>
        <dcterms:identifier>HE-PE-CP-008</dcterms:identifier>
        <dcterms:source>Rowland &amp; Tozer 2010</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Maintenance Dose</rdfs:label>
        <skos:definition xml:lang="en">The regular, ongoing dose given after an initial loading dose, if used, to sustain a stable therapeutic drug concentration.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Regular Dose</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Sustaining Dose</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Maintenance Dose</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/loading-dose"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/maintenance-dose"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-bba8545378bf</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Pharmacoeconomics &gt; Clinical Pharmacology: pharmacokinetic and dosing terms describe the clinical evidence behind a treatment effect</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/maintenance-dose"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/loading-dose"/>
        <dcterms:identifier>HEO-L-b853d7ca2a9b</dcterms:identifier>
        <linkRationale xml:lang="en">Ongoing versus initial dose are contrasted; only link on this subject</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/maintenance-therapy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/maintenance-therapy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/treatment"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q6736822"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/treatment"/>
        <skos:notation>HE-PE-DT-027</skos:notation>
        <dcterms:identifier>HE-PE-DT-027</dcterms:identifier>
        <dcterms:source>DeVita, Lawrence &amp; Rosenberg 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Maintenance Therapy</rdfs:label>
        <skos:definition xml:lang="en">Ongoing treatment given after an initial, more intensive phase to sustain a positive response and prevent relapse or progression.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Continuation Therapy</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Sustaining Treatment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Maintenance Therapy</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/induction-therapy"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/disease-progression"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/maintenance-therapy"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/treatment"/>
        <dcterms:identifier>HEO-L-b172ac9d8543</dcterms:identifier>
        <linkRationale xml:lang="en">Maintenance therapy is a treatment</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/maintenance-therapy"/>
