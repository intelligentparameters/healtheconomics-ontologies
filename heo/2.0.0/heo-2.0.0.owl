    <!-- https://healtheconomics.wiki/concept/affordability -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/affordability">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/budget-impact-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/budget-impact-analysis"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/access-to-care"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/patient-access"/>
        <skos:notation>HE-EE-BIA-002</skos:notation>
        <dcterms:identifier>HE-EE-BIA-002</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>ICER 2023; WHO &amp; World Bank 2025</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Affordability</rdfs:label>
        <owl:versionInfo>1.0.5</owl:versionInfo>
        <skos:altLabel xml:lang="en">Financial Access</skos:altLabel>
        <skos:definition xml:lang="en">Affordability is whether a payer or household can meet the cost of health care from available resources without displacing other care or causing hardship.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Ability to Pay</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Ability to Pay for Care</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Financial Reach</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Affordability</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-6"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/affordability-criterion"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
