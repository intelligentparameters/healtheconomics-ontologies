    <!-- https://healtheconomics.wiki/concept/managed-access-agreement -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/managed-access-agreement">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/managed-entry-agreement"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/managed-entry-agreement"/>
        <skos:notation>HS-DC-MA-011</skos:notation>
        <dcterms:identifier>HS-DC-MA-011</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</dcterms:modified>
        <dcterms:source>NICE PMG36 (2022, updated 2026)</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Managed Access Agreement</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:altLabel xml:lang="en">MAA</skos:altLabel>
        <skos:definition xml:lang="en">A managed access agreement is a time-limited NHS England deal funding a promising but uncertain medicine while data are collected for a NICE reappraisal.</skos:definition>
        <skos:hiddenLabel xml:lang="en">NICE Managed Access</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Managed Access Agreement</skos:prefLabel>
        <abbreviation xml:lang="en">MAA</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/only-in-research"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/real-world-evidence"/>
        <counterpartOf rdf:resource="https://healtheconomics.wiki/concept/managed-access-program"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/managed-access-agreement"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/managed-entry-agreement"/>
        <dcterms:identifier>HEO-L-e08141ca1c1f</dcterms:identifier>
        <linkRationale xml:lang="en">A managed access agreement is a managed entry agreement</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/managed-access-agreement"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/only-in-research"/>
        <dcterms:identifier>HEO-L-2ce5d738366a</dcterms:identifier>
        <linkRationale xml:lang="en">Funded access with data collection versus research-only funding are alternative NICE routes for uncertain technologies (current NICE/NHS England arrangements)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
