    <!-- https://healtheconomics.wiki/concept/revealed-preference -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/revealed-preference">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
