        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">LR-</skos:altLabel>
        <skos:altLabel xml:lang="en">Negative LR</skos:altLabel>
        <skos:definition xml:lang="en">Negative Likelihood Ratio (LR-): (1 minus sensitivity) over specificity, the factor by which a negative test multiplies disease odds in decision models.</skos:definition>
        <skos:prefLabel xml:lang="en">Negative Likelihood Ratio</skos:prefLabel>
        <abbreviation xml:lang="en">LR-</abbreviation>
        <abbreviation xml:lang="en">Negative LR</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/positive-likelihood-ratio"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-2"/>
