    <!-- https://healtheconomics.wiki/concept/trajectory-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/trajectory-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:notation>HE-ES-SA-222</skos:notation>
        <dcterms:identifier>HE-ES-SA-222</dcterms:identifier>
        <dcterms:source>Nagin 1999</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Trajectory Analysis</rdfs:label>
        <skos:definition xml:lang="en">A statistical approach identifying and characterising distinct patterns of change in an outcome over time, often revealing subgroups with different courses.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Growth Curve Modelling</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Longitudinal Pattern Analysis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Trajectory Analysis</skos:prefLabel>
