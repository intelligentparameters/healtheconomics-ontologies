    <!-- https://healtheconomics.wiki/concept/consolidated-billing -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/consolidated-billing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <skos:notation>HS-HP-PP-028</skos:notation>
        <dcterms:identifier>HS-HP-PP-028</dcterms:identifier>
        <dcterms:source>CMS, Medicare Payment Systems</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Consolidated Billing</rdfs:label>
        <skos:definition xml:lang="en">A billing requirement mandating certain post-acute facilities bill for most services a resident receives, including outside consultants, rather than separate billing.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Bundled Facility Billing</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Consolidated Claims</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Consolidated Billing</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/unbundling"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/consolidated-billing"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
