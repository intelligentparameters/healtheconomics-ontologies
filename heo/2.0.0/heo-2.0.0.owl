    <!-- https://healtheconomics.wiki/concept/pooling-equilibrium -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/pooling-equilibrium">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/equilibrium"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/equilibrium"/>
        <skos:notation>HE-EE-ME-050</skos:notation>
        <dcterms:identifier>HE-EE-ME-050</dcterms:identifier>
        <dcterms:source>Rothschild &amp; Stiglitz 1976</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Pooling Equilibrium</rdfs:label>
        <skos:definition xml:lang="en">A market outcome in which different risk types make the same choice, so a firm cannot distinguish between them from behaviour alone.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Mixed-Type Equilibrium</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Pooling Outcome</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Pooling Equilibrium</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/separating-equilibrium"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/pooling-equilibrium"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/equilibrium"/>
        <dcterms:identifier>HEO-L-27b30f7944ad</dcterms:identifier>
        <linkRationale xml:lang="en">A pooling equilibrium is a kind of equilibrium in markets with hidden information</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/pooling-equilibrium"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
