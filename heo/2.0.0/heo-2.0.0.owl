        <dcterms:identifier>HE-ES-EA-045</dcterms:identifier>
        <dcterms:source>Guyatt GH, Oxman AD, Vist GE, et al. GRADE: an emerging consensus on rating quality of evidence and strength of recommendations. BMJ. 2008;336:924-926. doi:10.1136/bmj.39489.470347.AD.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Weak Recommendation</rdfs:label>
        <skos:altLabel xml:lang="en">Conditional Recommendation</skos:altLabel>
        <skos:altLabel xml:lang="en">Discretionary Recommendation</skos:altLabel>
        <skos:altLabel xml:lang="en">Qualified Recommendation</skos:altLabel>
        <skos:definition xml:lang="en">Within GRADE, a conditional recommendation indicating benefits probably outweigh harms with less certainty, so patients might reasonably choose differently.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Conditional GRADE Recommendation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Grade 2 Recommendation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Weak Recommendation</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
