    <!-- https://healtheconomics.wiki/concept/internal-rate-of-return -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/internal-rate-of-return">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-benefit-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/cost-benefit-analysis"/>
        <skos:notation>HE-EE-CBA-028</skos:notation>
        <dcterms:identifier>HE-EE-CBA-028</dcterms:identifier>
        <dcterms:source>Brealey, Myers &amp; Allen 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Internal Rate of Return</rdfs:label>
        <skos:definition xml:lang="en">The discount rate at which the net present value of a stream of cash flows equals zero, used to summarise an investment&apos;s return.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Discounted Return Rate</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Rate of Return</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Internal Rate of Return</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/net-present-value"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-5"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/internal-rate-of-return"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-benefit-analysis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-991276eeb46c</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Cost benefit analysis and investment appraisal in subdomain Economic Evaluation; placed under Cost-Benefit Analysis, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/internal-rate-of-return"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/net-present-value"/>
        <dcterms:identifier>HEO-L-f4a02320e66b</dcterms:identifier>
        <linkRationale xml:lang="en">IRR is not the evaluation discount rate; IRR and NPV are alternative investment criteria</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/internal-reference-pricing -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/internal-reference-pricing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/reference-pricing"/>
