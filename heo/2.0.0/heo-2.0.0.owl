    <!-- https://healtheconomics.wiki/concept/action-research -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/action-research">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/participatory-research"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/participatory-research"/>
        <skos:notation>HS-HP-HSG-035</skos:notation>
        <dcterms:identifier>HS-HP-HSG-035</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</dcterms:modified>
        <dcterms:source>Meyer 2000</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Action Research</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:definition xml:lang="en">Action research is a cyclical approach where researchers and staff plan, act, observe and reflect together to change health care while studying the change.</skos:definition>
        <skos:prefLabel xml:lang="en">Action Research</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/barrier-to-implementation"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/practice-change"/>
