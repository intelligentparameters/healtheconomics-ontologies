    <!-- https://healtheconomics.wiki/concept/demand-side-control -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/demand-side-control">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-containment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cost-containment"/>
        <skos:notation>HS-HP-HSR-024</skos:notation>
        <dcterms:identifier>HS-HP-HSR-024</dcterms:identifier>
        <dcterms:source>Wickizer &amp; Lessler 2002</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Demand-Side Control</rdfs:label>
        <skos:definition xml:lang="en">Cost containment strategies targeting patient-side incentives, such as cost-sharing, to influence utilisation, unlike supply-side controls targeting provider behaviour.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Demand-Side Measure</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Patient-Side Cost Control</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Demand-Side Control</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/supply-side-control"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
