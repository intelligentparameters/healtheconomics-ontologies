    <!-- https://healtheconomics.wiki/concept/kaplan-meier-estimator -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/kaplan-meier-estimator">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/non-parametric-estimation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/non-parametric-estimation"/>
        <skos:notation>HE-EM-SM-038</skos:notation>
        <dcterms:identifier>HE-EM-SM-038</dcterms:identifier>
