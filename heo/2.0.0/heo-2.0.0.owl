    <!-- https://healtheconomics.wiki/concept/population-attributable-fraction -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/population-attributable-fraction">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/attributable-fraction"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/attributable-fraction"/>
        <skos:notation>HE-ES-RM-020</skos:notation>
        <dcterms:identifier>HE-ES-RM-020</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Levin 1953</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Population Attributable Fraction</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">PAF</skos:altLabel>
        <skos:altLabel xml:lang="en">Population Aetiologic Fraction</skos:altLabel>
        <skos:definition xml:lang="en">The proportion of disease cases in an entire population that would not occur if a specific exposure were eliminated, accounting for its prevalence.</skos:definition>
        <skos:prefLabel xml:lang="en">Population Attributable Fraction</skos:prefLabel>
        <abbreviation xml:lang="en">PAF</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/population-attributable-risk"/>
        <counterpartOf rdf:resource="https://healtheconomics.wiki/concept/prevented-fraction"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/population-attributable-fraction"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/attributable-fraction"/>
        <dcterms:identifier>HEO-L-78c92eaa0f7f</dcterms:identifier>
        <linkRationale xml:lang="en">PAF is the whole-population form of the attributable fraction</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/population-attributable-fraction"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/population-attributable-risk"/>
        <dcterms:identifier>HEO-L-0b9d024ced8c</dcterms:identifier>
        <linkRationale xml:lang="en">PAF is a proportion and PAR an absolute rate; they are alternative expressions of exposure burden</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
