    <!-- https://healtheconomics.wiki/concept/fixed-effect-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/fixed-effect-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-ES-ESM-019</skos:notation>
        <dcterms:identifier>HE-ES-ESM-019</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-23</dcterms:modified>
        <dcterms:source>DerSimonian R, Laird N. Meta-analysis in clinical trials. Controlled Clinical Trials. 1986;7(3):177?188. doi:10.1016/0197-2456(86)90046-2.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Fixed Effect Model</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Common-Effect Model</skos:altLabel>
        <skos:altLabel xml:lang="en">Fixed Effect Synthesis</skos:altLabel>
        <skos:altLabel xml:lang="en">Fixed-Effect Meta-Analysis</skos:altLabel>
        <skos:definition xml:lang="en">A meta-analysis model assuming all included studies estimate the same true effect, with observed variation attributed entirely to sampling error.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Common-True-Effect Synthesis</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Inverse-Variance Fixed Synthesis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Fixed Effect Model</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/random-effects-model"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-4"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/fixed-effect-model"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-b2da3ba9da6c</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Evidence synthesis and appraisal in subdomain Evidence Synthesis</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/fixed-effect-model"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/random-effects-model"/>
        <dcterms:identifier>HEO-L-507a19288ea2</dcterms:identifier>
        <linkRationale xml:lang="en">Fixed and random effects are the alternative meta-analysis models</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


