        <skos:hiddenLabel xml:lang="en">Pooled Group</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Risk Pool</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
