    <!-- https://healtheconomics.wiki/concept/health-policy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/health-policy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-economics"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1519812"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-economics"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/health-system"/>
        <skos:notation>HS-HP-PA-008</skos:notation>
        <dcterms:identifier>HS-HP-PA-008</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Weimer &amp; Vining 2017</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Health Policy</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/subdomain/health-policy"/>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">Government or organisational decisions, plans, and actions intended to achieve specific health-related objectives, covering financing, regulation, and programming.</skos:definition>
        <skos:editorialNote xml:lang="en">In HEO this concept is the wiki subdomain Health Policy, directly under Health Economics. Concepts in that subdomain with no is-type-of parent are classified under it or under a concept within it.</skos:editorialNote>
        <skos:hiddenLabel xml:lang="en">Government Health Decisions</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Health-Sector Policy</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Health Policy</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/government-intervention"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-economics"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-452a6e1ba10f</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: the wiki subdomain Health Policy (https://healtheconomics.wiki/subdomain/health-policy)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-system"/>
        <dcterms:identifier>HEO-L-605119abc47f</dcterms:identifier>
        <linkRationale xml:lang="en">Policy actions to promote health fall within the actions that make up a health system, per the object definition</linkRationale>
