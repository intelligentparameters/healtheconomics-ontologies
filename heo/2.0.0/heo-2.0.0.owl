        <rdfs:label xml:lang="en">Scale Dependence</rdfs:label>
        <skos:altLabel xml:lang="en">Scale Dependency</skos:altLabel>
        <skos:definition xml:lang="en">The phenomenon in which the presence or size of a statistical interaction differs depending on whether it is assessed on an additive or multiplicative scale.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Additive-Multiplicative Discrepancy</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Scale Dependence</skos:prefLabel>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/effect-modification"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/scale-dependence"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-829109ec7f65</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Risk Measures: catalogue subdomain Evidence Synthesis is one of the subdomains</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/scale-dependence"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isPropertyOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/effect-modification"/>
        <dcterms:identifier>HEO-L-b0822b7e217d</dcterms:identifier>
        <linkRationale xml:lang="en">Only link; dependence on the chosen scale is a characteristic of effect modification and interaction</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/scale-efficiency -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/scale-efficiency">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/efficiency"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/efficiency"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/productive-efficiency"/>
        <skos:notation>HE-EE_EA-049</skos:notation>
        <dcterms:identifier>HE-EE_EA-049</dcterms:identifier>
        <dcterms:source>Banker, Charnes &amp; Cooper 1984</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Scale Efficiency</rdfs:label>
        <skos:definition xml:lang="en">A measure of whether a provider is operating at its optimal size, distinct from whether it uses its current scale of inputs efficiently.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Scale Optimality</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Size Efficiency</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Scale Efficiency</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/technical-efficiency"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/data-envelopment-analysis"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/scale-efficiency"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/efficiency"/>
        <dcterms:identifier>HEO-L-edd09edbaa28</dcterms:identifier>
        <linkRationale xml:lang="en">Scale efficiency is a type of efficiency.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/scale-efficiency"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/productive-efficiency"/>
        <dcterms:identifier>HEO-L-fcbc0d139061</dcterms:identifier>
        <linkRationale xml:lang="en">Overall technical efficiency decomposes into pure technical and scale efficiency, so scale is a component of productive efficiency</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/scale-efficiency"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/technical-efficiency"/>
        <dcterms:identifier>HEO-L-19f15b9bf735</dcterms:identifier>
        <linkRationale xml:lang="en">Scale efficiency is the component separate from (pure) technical efficiency in DEA.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/scale-efficiency"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/data-envelopment-analysis"/>
        <dcterms:identifier>HEO-L-3b6bc2c7085a</dcterms:identifier>
        <linkRationale xml:lang="en">Scale efficiency is estimated with DEA.</linkRationale>
