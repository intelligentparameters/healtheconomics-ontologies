        <dcterms:identifier>HEO-L-bfe381e81f86</dcterms:identifier>
        <linkRationale xml:lang="en">The subject definition calls the Weibull a probability distribution</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
