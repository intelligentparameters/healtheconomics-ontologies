    <!-- https://healtheconomics.wiki/concept/living-review -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/living-review">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/systematic-review"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/systematic-review"/>
        <skos:notation>HE-ES-ESM-034</skos:notation>
        <dcterms:identifier>HE-ES-ESM-034</dcterms:identifier>
        <dcterms:source>Elliott et al. 2014</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Living Review</rdfs:label>
        <skos:altLabel xml:lang="en">Living Systematic Review</skos:altLabel>
        <skos:definition xml:lang="en">A systematic review continually updated as new relevant evidence becomes available, rather than conducted once and left static.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Continuously Updated Review</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Living Review</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/rapid-review"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/living-guideline"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/cumulative-meta-analysis"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/literature-search"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/living-review"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/systematic-review"/>
        <dcterms:identifier>HEO-L-a3fc713191ab</dcterms:identifier>
        <linkRationale xml:lang="en">A living review is a systematic review</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/living-review"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/rapid-review"/>
        <dcterms:identifier>HEO-L-5cc66bc103df</dcterms:identifier>
        <linkRationale xml:lang="en">Continuously updated versus abbreviated time-limited reviews are alternative review modes</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
