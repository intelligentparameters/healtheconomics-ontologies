    <!-- https://healtheconomics.wiki/concept/parallel-group-design -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/parallel-group-design">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/randomised-controlled-trial"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/study-design"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/randomised-controlled-trial"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/study-design"/>
        <skos:notation>HE-ES-CTM-060</skos:notation>
        <dcterms:identifier>HE-ES-CTM-060</dcterms:identifier>
        <dcterms:source>Friedman LM, Furberg CD, DeMets DL, Reboussin DM, Granger CB. Fundamentals of Clinical Trials. 5th ed. Springer; 2015. doi:10.1007/978-3-319-18539-2.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Parallel Group Design</rdfs:label>
        <skos:altLabel xml:lang="en">Parallel-Arm Trial</skos:altLabel>
        <skos:altLabel xml:lang="en">Parallel-Group Trial</skos:altLabel>
        <skos:definition xml:lang="en">A trial design randomly assigning participants to one of two or more groups, each receiving only one treatment throughout, with outcomes compared between groups.</skos:definition>
        <skos:prefLabel xml:lang="en">Parallel Group Design</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/parallel-group-design"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/randomised-controlled-trial"/>
        <dcterms:identifier>HEO-L-aea5aad4060c</dcterms:identifier>
        <linkRationale xml:lang="en">Subject definition says groups are randomly assigned, so it is a randomised trial design</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/parallel-group-design"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/study-design"/>
        <dcterms:identifier>HEO-L-79f4e8ecb94d</dcterms:identifier>
