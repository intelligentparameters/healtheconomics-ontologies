    <!-- https://healtheconomics.wiki/concept/severity-modifier -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/severity-modifier">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/severity-criterion"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/severity-criterion"/>
        <skos:notation>HE-EE-CUA-010</skos:notation>
        <dcterms:identifier>HE-EE-CUA-010</dcterms:identifier>
        <dcterms:source>NICE PMG36 (2022, updated 2026) sections 6.2.16 to 6.2.18</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Severity Modifier</rdfs:label>
        <skos:definition xml:lang="en">The severity modifier is a weight of 1.2 or 1.7 that NICE applies to QALY gains for conditions with a high absolute or proportional QALY shortfall.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Severity Adjustment Factor</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Severity Weight</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Severity Modifier</skos:prefLabel>
        <modifies rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-threshold"/>
        <modifies rdf:resource="https://healtheconomics.wiki/concept/qaly"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/absolute-shortfall"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/severity-modifier"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/severity-criterion"/>
        <dcterms:identifier>HEO-L-278ec16e3eeb</dcterms:identifier>
        <linkRationale xml:lang="en">The modifier weights QALYs by shortfall, which is a severity criterion; Equity Criterion is defined as about disparities between groups.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/severity-modifier"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#modifies"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-threshold"/>
        <dcterms:identifier>HEO-L-b2ef730fe0e5</dcterms:identifier>
        <linkRationale xml:lang="en">The registry example; weighting QALYs by 1.2 or 1.7 raises the effective threshold (NICE PMG36 2022).</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/severity-modifier"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#modifies"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/qaly"/>
        <dcterms:identifier>HEO-L-4f122df034b8</dcterms:identifier>
        <linkRationale xml:lang="en">The modifier is a weight applied to QALY gains (object definition); it does not take QALYs as an input to compute itself</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
