    <!-- https://healtheconomics.wiki/concept/patient-access-scheme -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/patient-access-scheme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/managed-entry-agreement"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/managed-entry-agreement"/>
        <skos:notation>HS-DC-MA-018</skos:notation>
        <dcterms:identifier>HS-DC-MA-018</dcterms:identifier>
        <dcterms:source>Carlson JJ, Sullivan SD, Garrison LP, Neumann PJ, Veenstra DL. Linking payment to health outcomes: a taxonomy and examination of performance-based reimbursement schemes. Health Policy. 2010;96(3):179-190.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Patient Access Scheme</rdfs:label>
        <skos:altLabel xml:lang="en">PAS</skos:altLabel>
        <skos:definition xml:lang="en">A managed entry agreement, most associated with the UK, offering a discount to improve a treatment&apos;s cost-effectiveness enough to secure reimbursement.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Confidential Access Scheme</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Patient Access Scheme</skos:prefLabel>
        <abbreviation xml:lang="en">PAS</abbreviation>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/confidential-discount"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/free-goods"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/patient-access-scheme"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/managed-entry-agreement"/>
        <dcterms:identifier>HEO-L-4d83e0866272</dcterms:identifier>
        <linkRationale xml:lang="en">Subject definition says a PAS is a managed entry agreement; UK schemes current</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
