    <!-- https://healtheconomics.wiki/concept/impoverishing-expenditure-measure -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/impoverishing-expenditure-measure">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/financial-hardship-measure"/>
