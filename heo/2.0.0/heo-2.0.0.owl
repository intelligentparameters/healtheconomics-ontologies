    <!-- https://healtheconomics.wiki/concept/diminishing-returns -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/diminishing-returns">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-principle"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/economic-principle"/>
        <skos:notation>HE-EE-EPR-004</skos:notation>
        <dcterms:identifier>HE-EE-EPR-004</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</dcterms:modified>
        <dcterms:source>Greenlaw et al. 2022</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Diminishing Returns</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:definition xml:lang="en">Diminishing returns is the eventual fall in extra health from each added unit of care, such as another screening round, when other inputs stay fixed.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Decreasing Returns</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Marginal Product Decline</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Diminishing Returns</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/economies-of-scale"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/marginal-cost"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/health-production-function"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/diminishing-returns"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-principle"/>
        <dcterms:identifier>HEO-L-284a3abf6fb7</dcterms:identifier>
        <linkRationale xml:lang="en">diminishing returns is a standard economic principle</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/diminishing-returns"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economies-of-scale"/>
        <dcterms:identifier>HEO-L-52af1a3c21a1</dcterms:identifier>
