    <!-- https://healtheconomics.wiki/concept/line-extension -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/line-extension">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-development"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/drug-development"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/lifecycle-management"/>
        <skos:notation>HE-PE-DD-025</skos:notation>
        <dcterms:identifier>HE-PE-DD-025</dcterms:identifier>
        <dcterms:source>DiMasi JA, Grabowski HG, Hansen RW. Innovation in the pharmaceutical industry: new estimates of R&amp;D costs. Journal of Health Economics. 2016;47:20-33. doi:10.1016/j.jhealeco.2016.01.012.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Line Extension</rdfs:label>
        <skos:definition xml:lang="en">The development of a new version or formulation of an already-approved drug, such as an extended-release form, intended to extend the product&apos;s lifecycle.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Brand Extension</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">New-Formulation Variant</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Line Extension</skos:prefLabel>
        <produces rdf:resource="https://healtheconomics.wiki/concept/formulation"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/line-extension"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-development"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-611636378c81</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Pharmacoeconomics &gt; Drug Development: wiki topic Drug development and regulation sits in Health Policy; placed under Drug Development, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/line-extension"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
