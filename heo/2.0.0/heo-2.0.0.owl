    <!-- https://healtheconomics.wiki/concept/effective-reproduction-number -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/effective-reproduction-number">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/reproduction-number"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/reproduction-number"/>
        <skos:notation>HE-ES-EP-012</skos:notation>
        <dcterms:identifier>HE-ES-EP-012</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-21</dcterms:modified>
        <dcterms:source>Anderson &amp; May 1991</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Effective Reproduction Number</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Rt</skos:altLabel>
        <skos:altLabel xml:lang="en">Time-Varying Reproduction Number</skos:altLabel>
        <skos:definition xml:lang="en">The average number of secondary infections from one infected person in a population not entirely susceptible, accounting for existing immunity or control measures.</skos:definition>
        <skos:prefLabel xml:lang="en">Effective Reproduction Number</skos:prefLabel>
        <abbreviation xml:lang="en">Rt</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/effective-reproduction-number"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/reproduction-number"/>
        <dcterms:identifier>HEO-L-19a72e8cae07</dcterms:identifier>
        <linkRationale xml:lang="en">Re is a reproduction number</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/effective-sample-size -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/effective-sample-size">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q25304606"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/statistical-power"/>
        <skos:notation>HE-ES-SA-057</skos:notation>
        <dcterms:identifier>HE-ES-SA-057</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Kish 1965</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Effective Sample Size</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">ESS</skos:altLabel>
        <skos:definition xml:lang="en">The sample size a simple random sample would need to match the precision of an actual sample from a more complex design, such as clustered.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Equivalent Random-Sample Size</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Effective Sample Size</skos:prefLabel>
        <abbreviation xml:lang="en">ESS</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/effective-sample-size"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-1985b8ce5f54</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Statistical methods in subdomain Evidence Synthesis; placed under Statistical Method, the concept named by its wiki topic</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/effective-sample-size"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-power"/>
        <dcterms:identifier>HEO-L-838f13d9df6b</dcterms:identifier>
        <linkRationale xml:lang="en">Power for clustered or complex designs is calculated with the effective sample size rather than the nominal one</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
