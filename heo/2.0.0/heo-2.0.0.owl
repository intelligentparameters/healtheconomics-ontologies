        <rdfs:label xml:lang="en">Headroom Analysis</rdfs:label>
        <skos:altLabel xml:lang="en">Headroom Method</skos:altLabel>
        <skos:definition xml:lang="en">An early-stage technique estimating the maximum price or cost-effectiveness ceiling a technology under development could command, before detailed clinical evidence exists.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Value Ceiling Analysis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Headroom Analysis</skos:prefLabel>
