    <!-- https://healtheconomics.wiki/concept/cost-utility-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cost-utility-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <skos:notation>HE-EE-CUA-004</skos:notation>
        <dcterms:identifier>HE-EE-CUA-004</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Weinstein MC, Stason WB. Foundations of Cost-Effectiveness Analysis for Health and Medical Practices. 1977. https://doi.org/10.1056/NEJM197703312961304 | Torrance GW. Measurement of Health State Utilities for Economic Appraisal. 1986. https://doi.org/10.1016/0167-6296(86)90020-2 | NICE. Health technology evaluations: the manual—Economic evaluation. https://www.nice.org.uk/process/pmg36/chapter/economic-evaluation-2 | CDA-AMC. Guidelines for the Economic Evaluation of Health Technologies: Canada. 4th ed. https://www.cda-amc.ca/guidelines-economic-evaluation-health-technologies-canada-4th-edition | NICE Decision Support Unit. TSD 22: Mapping to estimate health state utilities. https://sheffield.ac.uk/nice-dsu/tsds/full-list</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cost-Utility Analysis</rdfs:label>
        <owl:versionInfo>1.5.33</owl:versionInfo>
        <skos:altLabel xml:lang="en">CUA</skos:altLabel>
        <skos:definition xml:lang="en">Cost-utility analysis is an economic evaluation that measures health gains in quality-adjusted life years (QALYs) and reports cost per QALY gained.</skos:definition>
        <skos:hiddenLabel xml:lang="en">QALY-Based Cost-Effectiveness</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cost-Utility Analysis</skos:prefLabel>
        <abbreviation xml:lang="en">CUA</abbreviation>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-4"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/cost-per-qaly"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/incremental-cost-utility-ratio"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/qaly"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cost-utility-analysis"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <dcterms:identifier>HEO-L-84d627c66679</dcterms:identifier>
        <linkRationale xml:lang="en">Drummond et al. treat CUA as a form of CEA with QALYs as the outcome</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
