        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cumulative Meta-Analysis</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">Cumulative meta-analysis is a meta-analysis repeated as each new study is added, usually by date, showing how the pooled effect and its uncertainty evolve.</skos:definition>
        <skos:prefLabel xml:lang="en">Cumulative Meta-Analysis</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/research-prioritisation"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cumulative-meta-analysis"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
