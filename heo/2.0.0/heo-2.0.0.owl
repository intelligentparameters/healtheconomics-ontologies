    <!-- https://healtheconomics.wiki/concept/multiple-comparison -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/multiple-comparison">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <skos:notation>HE-EE-CEA-041</skos:notation>
        <dcterms:identifier>HE-EE-CEA-041</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Multiple Comparison</rdfs:label>
        <skos:definition xml:lang="en">A situation involving more than two mutually exclusive interventions, requiring a systematic method, such as fully incremental analysis, to rank and compare them correctly.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Many-Option Ranking</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Multi-Way Comparison</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Multiple Comparison</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/pairwise-comparison"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/fully-incremental-analysis"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/multiple-comparison"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
