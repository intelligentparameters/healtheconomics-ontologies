        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/absolute-risk-reduction"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/relative-risk"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/transition-probability"/>
        <skos:notation>HE-ES-EP-009</skos:notation>
        <dcterms:identifier>HE-ES-EP-009</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</dcterms:modified>
        <dcterms:source>CDC 2012</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cumulative Incidence</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:altLabel xml:lang="en">Incidence Risk</skos:altLabel>
        <skos:definition xml:lang="en">Cumulative incidence, or risk, is the proportion of people free of an event at the start of a period who have it by the end, such as a 5-year stroke risk.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cumulative Risk Measure</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cumulative Incidence</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/incidence-rate"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cumulative-incidence"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/incidence"/>
        <dcterms:identifier>HEO-L-feaf54eb69ed</dcterms:identifier>
        <linkRationale xml:lang="en">A measure of new cases over a period</linkRationale>
