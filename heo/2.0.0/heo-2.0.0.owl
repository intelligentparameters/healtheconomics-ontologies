    <!-- https://healtheconomics.wiki/concept/institutional-perspective -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/institutional-perspective">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/perspective"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/perspective"/>
        <skos:notation>HE-EE-EPR-021</skos:notation>
        <dcterms:identifier>HE-EE-EPR-021</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Institutional Perspective</rdfs:label>
        <skos:definition xml:lang="en">An analytic viewpoint including only costs and outcomes relevant to a single institution, such as a hospital, rather than the broader health system.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Hospital Perspective</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Provider Institution Perspective</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Institutional Perspective</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/healthcare-sector-perspective"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/societal-perspective"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
