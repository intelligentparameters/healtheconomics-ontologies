    <!-- https://healtheconomics.wiki/concept/technology-replacement -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/technology-replacement">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/horizon-scanning"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/horizon-scanning"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/technology-lifecycle"/>
        <skos:notation>HS-HP-HS-021</skos:notation>
        <dcterms:identifier>HS-HP-HS-021</dcterms:identifier>
        <dcterms:source>Elshaug et al. 2012</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Technology Replacement</rdfs:label>
        <skos:definition xml:lang="en">The process by which a newer technology supersedes an older, established alternative, motivated by improved effectiveness, safety, or cost-efficiency.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Device Replacement</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Technology Substitution</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Technology Replacement</skos:prefLabel>
        <produces rdf:resource="https://healtheconomics.wiki/concept/obsolete-technology"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/technology-replacement"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/horizon-scanning"/>
