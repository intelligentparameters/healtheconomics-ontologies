        <dcterms:identifier>HE-PE-DD-053</dcterms:identifier>
        <dcterms:source>DiMasi JA, Grabowski HG, Hansen RW. Innovation in the pharmaceutical industry: new estimates of R&amp;D costs. Journal of Health Economics. 2016;47:20-33. doi:10.1016/j.jhealeco.2016.01.012.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Preclinical Development</rdfs:label>
        <skos:altLabel xml:lang="en">Nonclinical Development</skos:altLabel>
        <skos:definition xml:lang="en">The drug development stage before human trials begin, covering laboratory and animal studies characterising a compound&apos;s biological activity, pharmacokinetics, and safety.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Pre-Human Development</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Preclinical Development</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
