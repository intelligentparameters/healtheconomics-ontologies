    <!-- https://healtheconomics.wiki/concept/standardised-mean-difference -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/standardised-mean-difference">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/effect-size"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/effect-size"/>
        <skos:notation>HE-ES-SA-243</skos:notation>
        <dcterms:identifier>HE-ES-SA-243</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</dcterms:modified>
