    <!-- https://healtheconomics.wiki/concept/behavioural-health-carve-out -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/behavioural-health-carve-out">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/carve-out"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
