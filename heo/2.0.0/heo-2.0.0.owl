        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/unit-cost"/>
        <skos:notation>HE-EE-CA-007</skos:notation>
        <dcterms:identifier>HE-EE-CA-007</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
