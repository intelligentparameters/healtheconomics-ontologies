    <!-- https://healtheconomics.wiki/concept/herd-immunity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/herd-immunity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-PE-ID-029</skos:notation>
        <dcterms:identifier>HE-PE-ID-029</dcterms:identifier>
        <dcterms:source>Anderson &amp; May 1991</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Herd Immunity</rdfs:label>
        <skos:altLabel xml:lang="en">Community Immunity</skos:altLabel>
        <skos:altLabel xml:lang="en">Community Protection</skos:altLabel>
        <skos:altLabel xml:lang="en">Herd Effect</skos:altLabel>
        <skos:altLabel xml:lang="en">Indirect Protection</skos:altLabel>
        <skos:altLabel xml:lang="en">Population Immunity</skos:altLabel>
        <skos:definition xml:lang="en">A state where a sufficiently high proportion of a population is immune to a disease that transmission is substantially reduced even among the susceptible.</skos:definition>
        <skos:prefLabel xml:lang="en">Herd Immunity</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/vaccination-externalities"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/effective-reproduction-number"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/herd-immunity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-389e2c79cbc8</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Pharmacoeconomics &gt; Infectious Disease: herd immunity and outbreak terms are epidemiology; concepts with this Level 3 that the wiki places in a topic mostly sit in Evidence Synthesis</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/herd-immunity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/vaccination-externalities"/>
        <dcterms:identifier>HEO-L-aa3f89e5312b</dcterms:identifier>
        <linkRationale xml:lang="en">Population immunity yields benefits to others.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/herd-immunity"/>
