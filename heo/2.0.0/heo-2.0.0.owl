        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Responder Definition</rdfs:label>
        <skos:definition xml:lang="en">The specific threshold change in an outcome measure used to classify a patient as having experienced a meaningful clinical improvement.</skos:definition>
