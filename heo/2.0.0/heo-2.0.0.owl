    <!-- https://healtheconomics.wiki/concept/representativeness-concept -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/representativeness-concept">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/heuristics-concept"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/heuristics-concept"/>
        <skos:notation>HE-EE-BE-033</skos:notation>
        <dcterms:identifier>HE-EE-BE-033</dcterms:identifier>
        <dcterms:source>Tversky &amp; Kahneman 1974</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Representativeness Concept</rdfs:label>
        <skos:altLabel xml:lang="en">Representativeness Heuristic</skos:altLabel>
        <skos:definition xml:lang="en">A cognitive heuristic in which the probability of an event is judged by how closely it resembles a typical case rather than actual likelihood.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Similarity Judgment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Representativeness Concept</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/cognitive-bias-concept"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/representativeness-concept"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/heuristics-concept"/>
        <dcterms:identifier>HEO-L-98b826aa06c2</dcterms:identifier>
        <linkRationale xml:lang="en">Representativeness is a heuristic (Tversky and Kahneman).</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/representativeness-concept"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cognitive-bias-concept"/>
        <dcterms:identifier>HEO-L-0af13bc0ad62</dcterms:identifier>
        <linkRationale xml:lang="en">Representativeness is a heuristic that gives rise to biased judgements, not itself a bias.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/reproducibility -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/reproducibility">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/model-validation"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1425625"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/model-validation"/>
        <skos:notation>HE-EM-MV-067</skos:notation>
        <dcterms:identifier>HE-EM-MV-067</dcterms:identifier>
        <dcterms:source>Eddy DM, Hollingworth W, Caro JJ, et al. Model transparency and validation: a report of the ISPOR-SMDM Modeling Good Research Practices Task Force-7. Value in Health. 2012;15(6):843-850. doi:10.1016/j.jval.2012.04.012.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Reproducibility</rdfs:label>
        <skos:definition xml:lang="en">The ability of an independent party to obtain the same results as originally reported by rebuilding or re-running a model using documented methods.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Independent Verifiability</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Result Consistency</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Reproducibility</skos:prefLabel>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/health-economic-model"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/reproducibility"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/model-validation"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-770d95311b60</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Modelling &gt; Model Validation: catalogue subdomain Economic Modelling is one of the subdomains; placed under Model Validation, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/reproducibility"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isPropertyOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-economic-model"/>
        <dcterms:identifier>HEO-L-03a924c1a0a8</dcterms:identifier>
        <linkRationale xml:lang="en">Reproducibility is a characteristic of a model and its documentation, not a validation component</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


