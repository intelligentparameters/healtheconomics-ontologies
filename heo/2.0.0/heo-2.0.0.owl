    <!-- https://healtheconomics.wiki/concept/biosimilar-uptake -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/biosimilar-uptake">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
