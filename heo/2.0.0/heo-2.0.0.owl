        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Volume Control</rdfs:label>
        <skos:definition xml:lang="en">Mechanisms used to manage or limit the total quantity of healthcare services delivered, such as capacity constraints or global budget caps.</skos:definition>
