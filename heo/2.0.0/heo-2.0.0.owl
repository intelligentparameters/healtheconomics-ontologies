    <!-- https://healtheconomics.wiki/concept/coding-error -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/coding-error">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/processing-error"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/processing-error"/>
        <skos:notation>HE-DS-BV-005</skos:notation>
        <dcterms:identifier>HE-DS-BV-005</dcterms:identifier>
        <dcterms:source>Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams &amp; Wilkins; 2008.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Coding Error</rdfs:label>
        <skos:altLabel xml:lang="en">Miscoding</skos:altLabel>
        <skos:definition xml:lang="en">A mistake introduced when categorical data, such as diagnosis codes, are incorrectly assigned during data processing, potentially misclassifying patients or events.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Code Assignment Error</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Coding Error</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/misclassification"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/administrative-data"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/coding-error"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/processing-error"/>
        <dcterms:identifier>HEO-L-7512b58f9d89</dcterms:identifier>
        <linkRationale xml:lang="en">Code assignment happens during data processing (subject definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/coding-error"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/misclassification"/>
        <dcterms:identifier>HEO-L-f7ecccdb21d9</dcterms:identifier>
        <linkRationale xml:lang="en">Coding Error is defined as incorrectly assigned codes potentially misclassifying patients or events.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
