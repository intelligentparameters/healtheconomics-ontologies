    <!-- https://healtheconomics.wiki/concept/gross-costing -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/gross-costing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <skos:notation>HE-EE-CM-011</skos:notation>
        <dcterms:identifier>HE-EE-CM-011</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Gross Costing</rdfs:label>
        <skos:definition xml:lang="en">A costing method that applies a single, average unit cost figure, typically from routine administrative data, to estimate total intervention cost.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Aggregate Costing</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Average-Cost Method</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Gross Costing</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/micro-costing"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/unit-cost"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/gross-costing"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
