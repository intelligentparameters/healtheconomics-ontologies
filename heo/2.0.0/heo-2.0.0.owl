    <!-- https://healtheconomics.wiki/concept/health-depreciation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/health-depreciation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
