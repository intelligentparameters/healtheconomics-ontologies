    <!-- https://healtheconomics.wiki/concept/bias-variance-tradeoff -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/bias-variance-tradeoff">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q17003119"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:notation>HE-ES-SA-014</skos:notation>
        <dcterms:identifier>HE-ES-SA-014</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Geman, Bienenstock &amp; Doursat 1992</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Bias-Variance Tradeoff</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Bias-Variance Dilemma</skos:altLabel>
        <skos:definition xml:lang="en">The bias-variance tradeoff is how cutting systematic error (bias) tends to raise sampling variance, as in choosing HTA survival curves or subgroup inputs.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Bias-Variance Balance</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Bias-Variance Tradeoff</skos:prefLabel>
        <explains rdf:resource="https://healtheconomics.wiki/concept/overfitting"/>
        <explains rdf:resource="https://healtheconomics.wiki/concept/underfitting"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/model-selection"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/bias-variance-tradeoff"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-34272079e493</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Statistical methods in subdomain Evidence Synthesis; placed under Statistical Method, the concept named by its wiki topic</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/bias-variance-tradeoff"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#explains"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/overfitting"/>
        <dcterms:identifier>HEO-L-edaed096ed62</dcterms:identifier>
        <linkRationale xml:lang="en">The tradeoff accounts for why overly flexible models fit noise (high variance); a theory explaining a pattern</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
