    <!-- https://healtheconomics.wiki/concept/relative-risk-reduction -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/relative-risk-reduction">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/relative-measure"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/relative-measure"/>
        <skos:notation>HE-ES-RM-035</skos:notation>
        <dcterms:identifier>HE-ES-RM-035</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams &amp; Wilkins; 2008.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Relative Risk Reduction</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">RRR</skos:altLabel>
        <skos:definition xml:lang="en">The proportional reduction in risk associated with a treatment, calculated as one minus the relative risk, expressed as a percentage.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Proportional Risk Reduction</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Relative Risk Reduction</skos:prefLabel>
        <abbreviation xml:lang="en">RRR</abbreviation>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/relative-risk-reduction"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/relative-measure"/>
        <dcterms:identifier>HEO-L-06e995ebb06e</dcterms:identifier>
        <linkRationale xml:lang="en">Relative risk reduction is a proportional (ratio-based) effect measure.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
