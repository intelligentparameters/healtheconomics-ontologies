    <!-- https://healtheconomics.wiki/concept/net-present-value -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/net-present-value">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/present-value"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/present-value"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/internal-rate-of-return"/>
        <skos:notation>HE-EE-CBA-036</skos:notation>
        <dcterms:identifier>HE-EE-CBA-036</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-24</dcterms:modified>
        <dcterms:source>Brealey, Myers &amp; Allen 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Net Present Value</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">NPV</skos:altLabel>
        <skos:definition xml:lang="en">Net present value is the sum of monetary net flows at different times after each has been discounted to a common valuation date, including the initial flow.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Discounted Net Value</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Net Present Value</skos:prefLabel>
        <abbreviation xml:lang="en">NPV</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/payback-period"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/net-present-value"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/present-value"/>
        <dcterms:identifier>HEO-L-a9286645a2db</dcterms:identifier>
        <linkRationale xml:lang="en">A sum of discounted flows is a present value</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
