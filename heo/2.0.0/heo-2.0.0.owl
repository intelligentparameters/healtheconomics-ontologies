    <!-- https://healtheconomics.wiki/concept/working-correlation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/working-correlation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/generalized-estimating-equations"/>
        <skos:notation>HE-ES-SA-238</skos:notation>
        <dcterms:identifier>HE-ES-SA-238</dcterms:identifier>
        <dcterms:source>Liang &amp; Zeger 1986</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Working Correlation</rdfs:label>
        <skos:definition xml:lang="en">In generalised estimating equations, an assumed correlation structure among repeated observations, improving statistical efficiency even if not perfectly correct.</skos:definition>
        <skos:prefLabel xml:lang="en">Working Correlation</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
