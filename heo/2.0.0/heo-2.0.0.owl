        <dcterms:identifier>HEO-L-a6951cd837e1</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Evidence synthesis and appraisal in subdomain Evidence Synthesis</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/p-score"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/treatment-ranking"/>
        <dcterms:identifier>HEO-L-8b1b6ee29b61</dcterms:identifier>
        <linkRationale xml:lang="en">A P-score is a summary measure of ranking, as SUCRA measures Treatment Ranking, not the ranking itself</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
