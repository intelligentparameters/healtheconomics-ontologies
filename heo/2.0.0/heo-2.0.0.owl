    <!-- https://healtheconomics.wiki/concept/full-immunisation-coverage -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/full-immunisation-coverage">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
