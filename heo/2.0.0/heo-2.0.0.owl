    <!-- https://healtheconomics.wiki/concept/transition-probability -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/transition-probability">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/conditional-probability"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/event-probability"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/parameter-input"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/conditional-probability"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/event-probability"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/parameter-input"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/transition-matrix"/>
        <skos:notation>HE-EM-MP-042</skos:notation>
        <dcterms:identifier>HE-EM-MP-042</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Sonnenberg FA, Beck JR. Markov models in medical decision making: a practical guide. Medical Decision Making. 1993;13(4):322?338. doi:10.1177/0272989X9301300409.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Transition Probability</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:definition xml:lang="en">A transition probability is the chance of moving from one health state to another, or staying, during one cycle of a Markov or state-transition model.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cycle Transition Chance</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Move Probability</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Transition Probability</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-4"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/transition-probability"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/conditional-probability"/>
        <dcterms:identifier>HEO-L-bd52383c14f4</dcterms:identifier>
        <linkRationale xml:lang="en">A transition probability is conditional on being in the starting state at the cycle start.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/transition-probability"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/event-probability"/>
        <dcterms:identifier>HEO-L-a98a1676580d</dcterms:identifier>
        <linkRationale xml:lang="en">A transition probability is the probability of an event (state change) in one cycle.</linkRationale>
