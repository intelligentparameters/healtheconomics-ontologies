    <!-- https://healtheconomics.wiki/concept/scope-sensitivity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/scope-sensitivity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:notation>HE-EE-CBA-045</skos:notation>
        <dcterms:identifier>HE-EE-CBA-045</dcterms:identifier>
        <dcterms:source>Carson 1997</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Scope Sensitivity</rdfs:label>
        <skos:altLabel xml:lang="en">Sensitivity to Scope</skos:altLabel>
        <skos:definition xml:lang="en">The degree to which a stated valuation rises appropriately with the scale of the good being valued, such as a larger risk reduction.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Scope Test</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Scope Sensitivity</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/embedding-effect"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/stated-preference"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/willingness-to-pay"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/scope-sensitivity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-f47e3db97461</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Cost-Benefit Analysis: the unplaced concepts here are stated preference terms; the wiki&apos;s topic Stated preference and monetary valuation sits in Outcomes</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/scope-sensitivity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/embedding-effect"/>
        <dcterms:identifier>HEO-L-5722a04b4d13</dcterms:identifier>
        <linkRationale xml:lang="en">Scope sensitivity and the embedding effect are opposite findings.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/scope-sensitivity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isPropertyOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/stated-preference"/>
        <dcterms:identifier>HEO-L-141ae40aa56f</dcterms:identifier>
        <linkRationale xml:lang="en">Scope sensitivity is a standard validity test for stated preference values.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/scope-sensitivity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isPropertyOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/willingness-to-pay"/>
        <dcterms:identifier>HEO-L-c60509071a98</dcterms:identifier>
        <linkRationale xml:lang="en">Scope sensitivity is a validity property of WTP estimates.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/scoping -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/scoping">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/hta-process"/>
        <precedes rdf:resource="https://healtheconomics.wiki/concept/technology-appraisal"/>
        <skos:notation>HS-HP-HTA-191</skos:notation>
        <dcterms:identifier>HS-HP-HTA-191</dcterms:identifier>
        <dcterms:source>National Institute for Health and Care Excellence. NICE technology appraisal and highly specialised technologies guidance: the manual (PMG36). Published 2022; updated 2026.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Scoping</rdfs:label>
        <skos:definition xml:lang="en">The initial assessment stage in which the specific boundaries, including technology, population, comparators, and outcomes, are formally defined.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Boundary-Setting Process</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Scope Definition</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Scope-Setting Procedure</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Scoping</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/comparator"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/pico-framework"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/scoping"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-c48511ed5b48</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health Technology Assessment: HTA concepts belong to the HTA subdomain</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/scoping"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/hta-process"/>
        <dcterms:identifier>HEO-L-0ad26769b3ba</dcterms:identifier>
        <linkRationale xml:lang="en">Scoping is the first step of the HTA process (both definitions)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/scoping"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#precedes"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/technology-appraisal"/>
        <dcterms:identifier>HEO-L-0c05823df9dc</dcterms:identifier>
        <linkRationale xml:lang="en">Scoping is the initial stage that defines the boundaries before the appraisal itself is carried out.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/scoping"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#setsScopeOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/comparator"/>
        <dcterms:identifier>HEO-L-afa9ef521564</dcterms:identifier>
        <linkRationale xml:lang="en">Scoping formally decides which comparators fall inside the assessment.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/scoping"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/pico-framework"/>
        <dcterms:identifier>HEO-L-fc04d1cfbe29</dcterms:identifier>
