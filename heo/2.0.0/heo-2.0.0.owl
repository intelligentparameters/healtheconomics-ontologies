        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/social-impact-bond"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/health-capital-formation"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
