    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/reservation-price"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isFoundationFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/demand-price"/>
        <dcterms:identifier>HEO-L-8f9e8c2c5181</dcterms:identifier>
        <linkRationale xml:lang="en">Reservation prices across buyers trace out the demand price at each quantity.</linkRationale>
