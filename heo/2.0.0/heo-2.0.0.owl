    <!-- https://healtheconomics.wiki/concept/consumer-price-index -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/consumer-price-index">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q180687"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/inflation-rate"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/real-cost"/>
        <skos:notation>HE-EE-CA-013</skos:notation>
        <dcterms:identifier>HE-EE-CA-013</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>ONS 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Consumer Price Index</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:altLabel xml:lang="en">CPI</skos:altLabel>
        <skos:definition xml:lang="en">The consumer price index (CPI) measures change in the prices households pay for a fixed basket of goods and services, used to adjust costs for inflation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Consumer Price Measure</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Consumer Price Index</skos:prefLabel>
        <abbreviation xml:lang="en">CPI</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/health-price-index"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/consumer-price-index"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-62b841f90e8d</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Cost Analysis: cost analysis is costing; most concepts with this Level 3 that the wiki places in a topic sit in Costs</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
