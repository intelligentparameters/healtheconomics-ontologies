    <!-- https://healtheconomics.wiki/concept/residual -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/residual">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
