    <!-- https://healtheconomics.wiki/concept/performance-budget -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/performance-budget">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
