    <!-- https://healtheconomics.wiki/concept/prior-odds -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/prior-odds">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
