    <!-- https://healtheconomics.wiki/concept/crowding-in -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/crowding-in">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:notation>HE-EE-EP-008</skos:notation>
        <dcterms:identifier>HE-EE-EP-008</dcterms:identifier>
        <dcterms:source>Weimer &amp; Vining 2017</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Crowding In</rdfs:label>
        <skos:altLabel xml:lang="en">Crowd In</skos:altLabel>
        <skos:definition xml:lang="en">A phenomenon in which public spending or intervention stimulates additional private sector activity or investment, rather than displacing it.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Public-Private Complementarity</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Crowding In</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/crowding-out"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/crowding-in"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-8512f04e770e</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Economic Policy: taxes, subsidies and other economic policy instruments are policy choices</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/crowding-in"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/crowding-out"/>
        <dcterms:identifier>HEO-L-2ea3638bc835</dcterms:identifier>
        <linkRationale xml:lang="en">Opposite effects of public spending on private activity; only link of Crowding In</linkRationale>
