    <!-- https://healtheconomics.wiki/concept/non-profit-hospital -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/non-profit-hospital">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
