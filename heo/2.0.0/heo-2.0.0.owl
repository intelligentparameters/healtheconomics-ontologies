    <!-- https://healtheconomics.wiki/concept/activity-limitation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/activity-limitation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/disability"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/disability"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/healthy-life-years"/>
        <skos:notation>HE-ES-CO-001</skos:notation>
        <dcterms:identifier>HE-ES-CO-001</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-04</dcterms:modified>
        <dcterms:source>WHO 2002</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Activity Limitation</rdfs:label>
        <owl:versionInfo>1.0.4</owl:versionInfo>
        <skos:altLabel xml:lang="en">Functional Limitation</skos:altLabel>
        <skos:definition xml:lang="en">Activity limitation is a difficulty a person has in carrying out a task or action, such as walking, washing or communicating, as defined in the WHO ICF.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Activity Restriction</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Functional Restriction</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Impaired Ability</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Task Difficulty</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Activity Limitation</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/participation-restriction"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/outcomes#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/activity-limitation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/disability"/>
        <dcterms:identifier>HEO-L-d9b9f59df9a2</dcterms:identifier>
        <linkRationale xml:lang="en">Disability in the ICF covers activity limitations</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
