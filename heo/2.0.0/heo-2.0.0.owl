    <!-- https://healtheconomics.wiki/concept/team-based-care -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/team-based-care">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/coordinated-care-model"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/coordinated-care-model"/>
        <skos:notation>HS-SS_IC-007</skos:notation>
        <dcterms:identifier>HS-SS_IC-007</dcterms:identifier>
        <dcterms:source>AHA, American Hospital Association</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Team-Based Care</rdfs:label>
        <skos:definition xml:lang="en">A delivery model in which a coordinated team of providers collectively takes responsibility for a patient&apos;s care, rather than a single provider alone.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Multiprofessional Care</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Team Care</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Team-Based Care</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/team-based-care"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/coordinated-care-model"/>
        <dcterms:identifier>HEO-L-12d75c4a8cea</dcterms:identifier>
        <linkRationale xml:lang="en">Team-based care coordinates care among several providers.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


