        <dcterms:identifier>HE-EE-CM-019</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-30</dcterms:modified>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Top-Down Costing</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:altLabel xml:lang="en">Aggregate Cost Estimation</skos:altLabel>
        <skos:definition xml:lang="en">A costing approach that starts with aggregate costs and allocates them to services, activities or patients using documented shares and output counts.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Macro-Costing</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Top-Down Cost Estimation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Top-Level Costing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Top-Down Costing</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/costs#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/cost-to-charge-ratio"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/top-down-costing"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-8cf8b800ca12</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Costing methods in subdomain Costs</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
