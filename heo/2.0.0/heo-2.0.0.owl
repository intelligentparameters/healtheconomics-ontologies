    <!-- https://healtheconomics.wiki/concept/insurance-value -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/insurance-value">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/value-element"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/value-element"/>
        <skos:notation>HS-HP-HTA-116</skos:notation>
        <dcterms:identifier>HS-HP-HTA-116</dcterms:identifier>
        <dcterms:source>Lakdawalla et al. 2017</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Insurance Value</rdfs:label>
        <skos:definition xml:lang="en">A component of a technology&apos;s value reflecting the benefit patients receive from reduced financial risk, distinct from direct clinical benefit.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Financial Risk Value</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Risk-Protection Value</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Insurance Value</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/insurance-value"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/value-element"/>
        <dcterms:identifier>HEO-L-f6bbd615b708</dcterms:identifier>
        <linkRationale xml:lang="en">A value element</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/intangible-cost -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/intangible-cost">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <skos:notation>HE-EE-CA-054</skos:notation>
        <dcterms:identifier>HE-EE-CA-054</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-24</dcterms:modified>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Intangible Cost</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A cost representing the non-financial burden of illness or treatment, such as pain or reduced quality of life, that is hard to value in money.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Non-Financial Cost</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Psychosocial Cost</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Intangible Cost</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/direct-cost"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/indirect-cost"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/costs#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/intangible-cost"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <dcterms:identifier>HEO-L-f5ce20bfda0e</dcterms:identifier>
        <linkRationale xml:lang="en">Intangible cost is a standard cost category (Drummond et al. 2015)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
