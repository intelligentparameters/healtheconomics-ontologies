    <!-- https://healtheconomics.wiki/concept/risk-of-bias -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/risk-of-bias">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-assessment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-assessment"/>
        <skos:notation>HE-ES-EA-038</skos:notation>
        <dcterms:identifier>HE-ES-EA-038</dcterms:identifier>
        <dcterms:source>Higgins et al. 2011</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Risk of Bias</rdfs:label>
        <skos:altLabel xml:lang="en">RoB</skos:altLabel>
        <skos:definition xml:lang="en">The degree to which a study&apos;s design, conduct, or analysis may have introduced systematic errors distorting its findings from the truth.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Bias Susceptibility</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Risk of Bias</skos:prefLabel>
        <abbreviation xml:lang="en">RoB</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/random-error"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/risk-of-bias"/>
