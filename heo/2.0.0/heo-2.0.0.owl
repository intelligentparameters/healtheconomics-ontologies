    <!-- https://healtheconomics.wiki/concept/model-update -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/model-update">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/model-validation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/model-validation"/>
