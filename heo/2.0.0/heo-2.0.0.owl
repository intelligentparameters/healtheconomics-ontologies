    <!-- https://healtheconomics.wiki/concept/dominance-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/dominance-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <precedes rdf:resource="https://healtheconomics.wiki/concept/icer"/>
        <skos:notation>HE-EE-CEA-021</skos:notation>
        <dcterms:identifier>HE-EE-CEA-021</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Dominance Analysis</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">Dominance analysis identifies interventions that are inferior to another feasible option or to the efficient combination of options on cost and health outcome, leaving a frontier for fully incremental comparison.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Dominance Screening</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Dominated-Option Check</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Dominance Analysis</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/dominance"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/dominance-analysis"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-e1dab6a699f6</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Cost effectiveness analysis in subdomain Economic Evaluation; placed under Cost-Effectiveness Analysis, the concept named by its wiki topic</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/dominance-analysis"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <dcterms:identifier>HEO-L-08a7bb66f451</dcterms:identifier>
        <linkRationale xml:lang="en">Ruling out dominated options is a step of incremental analysis in CEA, before ICERs</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
