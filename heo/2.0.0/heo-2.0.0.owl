    <!-- https://healtheconomics.wiki/concept/health-planning -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/health-planning">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q70450952"/>
