        <skos:hiddenLabel xml:lang="en">Life-Year Trade-Off</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Time Trade-Off</skos:prefLabel>
        <abbreviation xml:lang="en">TTO</abbreviation>
