        <dcterms:source>NICE 2009</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">End-of-Life Criteria</rdfs:label>
        <skos:definition xml:lang="en">Special decision criteria applied by some health technology assessment bodies allowing a higher cost-effectiveness threshold for treatments of conditions with short life expectancy.</skos:definition>
        <skos:hiddenLabel xml:lang="en">End-of-Life Modifier</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Terminal-Illness Criteria</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">End-of-Life Criteria</skos:prefLabel>
        <counterpartOf rdf:resource="https://healtheconomics.wiki/concept/severity-modifier"/>
        <modifies rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-threshold"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
