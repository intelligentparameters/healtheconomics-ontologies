    <!-- https://healtheconomics.wiki/concept/disproportionate-share -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/disproportionate-share">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
