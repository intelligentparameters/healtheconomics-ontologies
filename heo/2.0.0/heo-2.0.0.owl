        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Dose Range Alert</rdfs:label>
        <skos:altLabel xml:lang="en">Dose Range Check</skos:altLabel>
        <skos:definition xml:lang="en">A computerised notification warning a prescriber that a proposed medication dose falls outside a safe range for the patient&apos;s characteristics.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Out-of-Range Dose Warning</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Dose Range Alert</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/alert-fatigue"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/medication-error"/>
