    <!-- https://healtheconomics.wiki/concept/provider-shortage -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/provider-shortage">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-HP-HSC-005</skos:notation>
        <dcterms:identifier>HS-HP-HSC-005</dcterms:identifier>
        <dcterms:source>World Health Organization. Everybody&apos;s Business: Strengthening Health Systems to Improve Health Outcomes-WHO&apos;s Framework for Action. WHO; 2007.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Provider Shortage</rdfs:label>
        <skos:altLabel xml:lang="en">Provider Gap</skos:altLabel>
        <skos:definition xml:lang="en">A situation where the supply of healthcare providers is insufficient to meet population needs, often more pronounced in certain specialties or regions.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Clinician Scarcity</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Provider Shortfall</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Workforce Gap</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Workforce Shortage</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Provider Shortage</skos:prefLabel>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/health-workforce"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/access-to-care"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/availability"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/geographic-access"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/provider-shortage"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-3243f4348456</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health System Capacity: organisation and delivery of care is the Health Systems subdomain (Organisation and governance)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/provider-shortage"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isPropertyOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-workforce"/>
        <dcterms:identifier>HEO-L-b1a41a97db3b</dcterms:identifier>
        <linkRationale xml:lang="en">A shortage describes the state of the workforce relative to need, not a component of it</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/provider-shortage"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
