    <!-- https://healtheconomics.wiki/concept/digital-literacy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/digital-literacy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/health-literacy"/>
        <skos:notation>HS-SS_DH-022</skos:notation>
        <dcterms:identifier>HS-SS_DH-022</dcterms:identifier>
        <dcterms:source>van Dijk 2006</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Digital Literacy</rdfs:label>
        <skos:definition xml:lang="en">An individual&apos;s ability to effectively find, evaluate, and use information through digital technologies, a specific dimension of overall health literacy.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Digital Health Literacy</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Technology Literacy</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Digital Literacy</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/digital-equity"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/digital-divide"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/digital-literacy"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-cc039238823b</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Systems Strengthening &gt; Digital Health: health system strengthening is the Health Systems subdomain</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
