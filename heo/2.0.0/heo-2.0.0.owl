        <skos:notation>HE-ES-EA-028</skos:notation>
        <dcterms:identifier>HE-ES-EA-028</dcterms:identifier>
        <dcterms:source>Guyatt GH, Oxman AD, Vist GE, et al. GRADE: an emerging consensus on rating quality of evidence and strength of recommendations. BMJ. 2008;336:924-926. doi:10.1136/bmj.39489.470347.AD.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Low-Quality Evidence</rdfs:label>
        <skos:altLabel xml:lang="en">Low-Certainty Evidence</skos:altLabel>
        <skos:definition xml:lang="en">Within GRADE, a rating indicating limited confidence that the true effect matches the reported estimate, typically from observational or flawed studies.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Weak Evidence</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Low-Quality Evidence</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
