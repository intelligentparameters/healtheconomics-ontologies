    <!-- https://healtheconomics.wiki/concept/regulatory-standards -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/regulatory-standards">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/regulation"/>
        <skos:notation>HS-HP-HSR-051</skos:notation>
        <dcterms:identifier>HS-HP-HSR-051</dcterms:identifier>
        <dcterms:source>FDA, About FDA</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Regulatory Standards</rdfs:label>
        <skos:altLabel xml:lang="en">Legal Standards</skos:altLabel>
        <skos:definition xml:lang="en">The specific rules and requirements established by a governmental regulatory agency that organisations within its jurisdiction must satisfy.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Legal Requirements</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Mandated Standards</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Regulatory Requirements</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Statutory Standards</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Regulatory Standards</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/compliance"/>
    </owl:NamedIndividual>
    <owl:Axiom>
