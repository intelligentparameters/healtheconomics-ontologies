        <rdfs:label xml:lang="en">Reference Standard</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">The reference standard is the best available method for deciding whether a target condition is present, against which a test&apos;s accuracy is judged.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Gold Standard</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Reference Standard</skos:prefLabel>
        <benchmarkFor rdf:resource="https://healtheconomics.wiki/concept/accuracy"/>
        <benchmarkFor rdf:resource="https://healtheconomics.wiki/concept/criterion-validity"/>
        <benchmarkFor rdf:resource="https://healtheconomics.wiki/concept/diagnostic-accuracy"/>
        <benchmarkFor rdf:resource="https://healtheconomics.wiki/concept/sensitivity"/>
        <benchmarkFor rdf:resource="https://healtheconomics.wiki/concept/specificity"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/reference-standard"/>
