    <!-- https://healtheconomics.wiki/concept/epidemic -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/epidemic">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/global-health"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/global-health"/>
        <skos:notation>HS-SS-GH-007</skos:notation>
        <dcterms:identifier>HS-SS-GH-007</dcterms:identifier>
        <dcterms:source>Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams &amp; Wilkins; 2008.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Epidemic</rdfs:label>
        <skos:definition xml:lang="en">An occurrence of disease cases clearly in excess of what would normally be expected within a community over a defined period.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Disease Outbreak</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Excess Case Occurrence</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Epidemic</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/outbreak-cost"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/epidemic"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/global-health"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-983c34cae921</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Systems Strengthening &gt; Global Health: health system strengthening is the Health Systems subdomain; placed under Global Health, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/epidemic"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/outbreak-cost"/>
        <dcterms:identifier>HEO-L-f7500b598c9e</dcterms:identifier>
        <linkRationale xml:lang="en">An epidemic generates outbreak response and treatment costs</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


