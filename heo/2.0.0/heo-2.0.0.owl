    <!-- https://healtheconomics.wiki/concept/weak-dominance -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/weak-dominance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/dominance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/dominance"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/fully-incremental-analysis"/>
        <precedes rdf:resource="https://healtheconomics.wiki/concept/extended-dominance"/>
        <skos:notation>HE-EE-CEA-068</skos:notation>
        <dcterms:identifier>HE-EE-CEA-068</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Weak Dominance</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Weak dominance is when another option costs no more and is at least as effective, and is strictly better on one, so the dominated option is dropped.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Non-Strict Dominance</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Weakly Dominated Option</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Weak Dominance</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/weak-dominance"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/dominance"/>
        <dcterms:identifier>HEO-L-05cf64a8fa9b</dcterms:identifier>
        <linkRationale xml:lang="en">Weak dominance is dominance.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/weak-dominance"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/fully-incremental-analysis"/>
        <dcterms:identifier>HEO-L-98e3c4492a33</dcterms:identifier>
        <linkRationale xml:lang="en">Removing weakly dominated options is a step of fully incremental analysis</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/weak-dominance"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#precedes"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/extended-dominance"/>
