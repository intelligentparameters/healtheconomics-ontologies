        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Supplementary Protection Certificate</rdfs:label>
        <skos:definition xml:lang="en">Additional EU intellectual property protection extending a patented drug&apos;s effective market exclusivity to compensate for time lost during regulatory review.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Certificate of Supplementary Protection</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Drug Patent Extension</skos:hiddenLabel>
