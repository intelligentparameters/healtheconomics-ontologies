    <!-- https://healtheconomics.wiki/concept/discharges -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/discharges">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/throughput"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/throughput"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/average-length-of-stay"/>
        <skos:notation>HS-NHS-HSP-005</skos:notation>
        <dcterms:identifier>HS-NHS-HSP-005</dcterms:identifier>
        <dcterms:source>AHA, American Hospital Association</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Discharges</rdfs:label>
        <skos:definition xml:lang="en">The total number of patients formally released from inpatient care within a facility over a defined period, a throughput measure.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Inpatient Releases</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Release Count</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Discharges</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/discharges"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/throughput"/>
        <dcterms:identifier>HEO-L-8446968b41a3</dcterms:identifier>
        <linkRationale xml:lang="en">discharges are completed service units per period, a throughput measure</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
