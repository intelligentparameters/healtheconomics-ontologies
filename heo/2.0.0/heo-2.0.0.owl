        <dcterms:identifier>HEO-L-1e277ddf8231</dcterms:identifier>
        <linkRationale xml:lang="en">dosage form is a characteristic of a medicinal product</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
