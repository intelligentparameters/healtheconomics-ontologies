    <!-- https://healtheconomics.wiki/concept/resource-constraint -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/resource-constraint">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-principle"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-principle"/>
        <skos:notation>HE-EE-EPR-042</skos:notation>
        <dcterms:identifier>HE-EE-EPR-042</dcterms:identifier>
        <dcterms:source>Varian 2014</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Resource Constraint</rdfs:label>
        <skos:definition xml:lang="en">A limit on the total resources, such as budget, staff, or facilities, available to an organisation, within which competing demands must be prioritised.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Resource Limit</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Supply Constraint</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Resource Constraint</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/rationing"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/opportunity-cost"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/resource-allocation"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/resource-constraint"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-principle"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-fd0cd2c9fdc1</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Scarcity choice and opportunity cost in subdomain Economic Foundations; placed under Economic Principle, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/resource-constraint"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/rationing"/>
        <dcterms:identifier>HEO-L-bf1fd8db5df3</dcterms:identifier>
