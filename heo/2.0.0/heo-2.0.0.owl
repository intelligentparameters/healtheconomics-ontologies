    <!-- https://healtheconomics.wiki/concept/dose-limiting-toxicity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/dose-limiting-toxicity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/adverse-event"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/adverse-event"/>
        <skos:notation>HE-ES-CTM-027</skos:notation>
        <dcterms:identifier>HE-ES-CTM-027</dcterms:identifier>
        <dcterms:source>Le Tourneau, Lee &amp; Siu 2009</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Dose-Limiting Toxicity</rdfs:label>
        <skos:altLabel xml:lang="en">DLT</skos:altLabel>
        <skos:definition xml:lang="en">A sufficiently severe adverse event in early-phase trials that prevents further dose escalation, used to help determine the maximum tolerated dose.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Dose-Limiting Adverse Event</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Dose-Limiting Toxicity</skos:prefLabel>
        <abbreviation xml:lang="en">DLT</abbreviation>
        <informs rdf:resource="https://healtheconomics.wiki/concept/maximum-tolerated-dose"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/dose-limiting-toxicity"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/adverse-event"/>
        <dcterms:identifier>HEO-L-d5d7a68d937f</dcterms:identifier>
        <linkRationale xml:lang="en">a DLT is a severe adverse event</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/dose-limiting-toxicity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/maximum-tolerated-dose"/>
        <dcterms:identifier>HEO-L-b4b69a90078a</dcterms:identifier>
        <linkRationale xml:lang="en">DLT observations are used to determine the MTD, per the subject definition</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/dose-range-alert -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/dose-range-alert">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-alert"/>
