        <dcterms:source>Elshaug et al. 2012</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Decommissioning</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:definition xml:lang="en">Decommissioning is the formal step that ends funding or provision of a health service or technology, in full or for some patients, once judged low value.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Service Withdrawal</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Technology Retirement</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Decommissioning</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/allocative-efficiency"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/low-value-care"/>
