        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Star Rating</rdfs:label>
        <skos:definition xml:lang="en">A summary quality rating system, typically one to five stars, conveying a simplified assessment based on aggregate underlying measure scores.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Quality Scorecard</skos:hiddenLabel>
