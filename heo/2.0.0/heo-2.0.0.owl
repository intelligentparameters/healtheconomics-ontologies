    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/differential-pricing -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/differential-pricing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:notation>HS-DC-DP-022</skos:notation>
        <dcterms:identifier>HS-DC-DP-022</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</dcterms:modified>
        <dcterms:source>Danzon 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Differential Pricing</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:altLabel xml:lang="en">Price Differentiation</skos:altLabel>
        <skos:definition xml:lang="en">Differential pricing is charging different prices for the same patented medicine in different markets, typically lower where ability to pay is lower.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Market-Specific Pricing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Differential Pricing</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/external-reference-pricing"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/differential-pricing"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <dcterms:identifier>HEO-L-c686eaa9ead6</dcterms:identifier>
        <linkRationale xml:lang="en">differential pricing is a way of setting medicine prices</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/differential-pricing"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/external-reference-pricing"/>
        <dcterms:identifier>HEO-L-c84c02d4ec3a</dcterms:identifier>
        <linkRationale xml:lang="en">reference pricing imports foreign prices and so works against setting lower prices where ability to pay is lower</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
