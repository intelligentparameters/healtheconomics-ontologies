        <skos:altLabel xml:lang="en">Factorial Trial</skos:altLabel>
        <skos:definition xml:lang="en">A trial design evaluating two or more interventions simultaneously by assigning participants to every possible combination, revealing each effect and any interaction.</skos:definition>
