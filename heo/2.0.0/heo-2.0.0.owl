    <!-- https://healtheconomics.wiki/concept/value-based-pricing -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/value-based-pricing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q7912715"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:notation>HS-DC-DP-103</skos:notation>
        <dcterms:identifier>HS-DC-DP-103</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Claxton et al. 2011</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Value-Based Pricing</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">VBP Pricing</skos:altLabel>
        <skos:definition xml:lang="en">Value-based pricing sets a medicine&apos;s price by the health it adds over current care, typically the highest price that meets a cost-effectiveness threshold.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Value-Based Price Setting</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Value-Based Pricing</skos:prefLabel>
        <abbreviation xml:lang="en">VBP Pricing</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/external-reference-pricing"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-threshold"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/threshold-price"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/value-based-pricing"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <dcterms:identifier>HEO-L-fb22e0ee86a6</dcterms:identifier>
        <linkRationale xml:lang="en">Value-based pricing is drug pricing.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
