    <!-- https://healtheconomics.wiki/concept/dose-intensity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/dose-intensity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/relative-dose-intensity"/>
        <skos:notation>HE-PE-DT-011</skos:notation>
        <dcterms:identifier>HE-PE-DT-011</dcterms:identifier>
        <dcterms:source>DeVita, Lawrence &amp; Rosenberg 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Dose Intensity</rdfs:label>
        <skos:definition xml:lang="en">The amount of drug given per unit of time, reflecting both dose size and administration interval, a measure of regimen aggressiveness.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cumulative Dose Rate</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Regimen Aggressiveness</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Dose Intensity</skos:prefLabel>
