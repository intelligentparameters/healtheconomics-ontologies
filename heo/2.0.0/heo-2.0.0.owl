    <!-- https://healtheconomics.wiki/concept/maximum-tolerated-dose -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/maximum-tolerated-dose">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-PE-CP-009</skos:notation>
        <dcterms:identifier>HE-PE-CP-009</dcterms:identifier>
        <dcterms:source>Le Tourneau, Lee &amp; Siu 2009</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Maximum Tolerated Dose</rdfs:label>
        <skos:altLabel xml:lang="en">MTD</skos:altLabel>
        <skos:definition xml:lang="en">The highest drug dose that can be given without unacceptable toxicity, typically found during early-phase trials through dose escalation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Highest Tolerated Dosage</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Maximum Tolerated Dose</skos:prefLabel>
        <abbreviation xml:lang="en">MTD</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/minimum-effective-dose"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/recommended-phase-2-dose"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/maximum-tolerated-dose"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
