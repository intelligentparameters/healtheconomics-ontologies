    <!-- https://healtheconomics.wiki/concept/data-exclusivity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/data-exclusivity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/regulation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/regulation"/>
        <skos:notation>HS-DC-IP-001</skos:notation>
        <dcterms:identifier>HS-DC-IP-001</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</dcterms:modified>
        <dcterms:source>European Parliament and Council 2004</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Data Exclusivity</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:altLabel xml:lang="en">Data Protection Period</skos:altLabel>
        <skos:altLabel xml:lang="en">Regulatory Data Protection</skos:altLabel>
        <skos:definition xml:lang="en">Data exclusivity is the period after a medicine&apos;s first approval in which generic or biosimilar applicants may not rely on the originator&apos;s trial data.</skos:definition>
        <skos:prefLabel xml:lang="en">Data Exclusivity</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/market-exclusivity"/>
        <counterpartOf rdf:resource="https://healtheconomics.wiki/concept/patent"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/biosimilar"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/generic-drug"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/data-exclusivity"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/regulation"/>
        <dcterms:identifier>HEO-L-4d03295486cf</dcterms:identifier>
        <linkRationale xml:lang="en">A regulatory rule restricting generic applicants; current in EU and US law</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
