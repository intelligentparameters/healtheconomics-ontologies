        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">ROA</skos:altLabel>
        <skos:definition xml:lang="en">A financial ratio calculated as net income divided by total assets, showing how efficiently an organisation uses its assets to generate profit.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Asset Return</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Return on Assets</skos:prefLabel>
        <abbreviation xml:lang="en">ROA</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/return-on-equity"/>
