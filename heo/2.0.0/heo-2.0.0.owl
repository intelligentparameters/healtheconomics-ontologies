    <!-- https://healtheconomics.wiki/concept/case-management -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/case-management">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/integrated-care"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q366193"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/integrated-care"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/integrated-care"/>
        <skos:notation>HS-HP-IC-007</skos:notation>
        <dcterms:identifier>HS-HP-IC-007</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Stokes et al. 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Case Management</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Case Management is a service in which a case manager or team assesses, plans and coordinates care for people with complex needs and high expected costs.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Case Coordination</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Patient Case Coordination</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Case Management</skos:prefLabel>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/care-coordination"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/care-plan"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/risk-stratification"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/case-management"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/integrated-care"/>
