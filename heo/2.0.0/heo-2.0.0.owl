        <rdfs:label xml:lang="en">Evidence Adaptation</rdfs:label>
        <owl:versionInfo>1.0.4</owl:versionInfo>
        <skos:altLabel xml:lang="en">Model Adaptation</skos:altLabel>
        <skos:definition xml:lang="en">Evidence adaptation is modifying an economic evaluation from one country or setting so that it reflects another setting&apos;s costs, practice and population.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cross-Jurisdiction Transfer</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Evidence Transfer</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Model Repurposing</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Setting Transfer</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Evidence Adaptation</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/purchasing-power-parity"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/sensitivity-analysis"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/unit-cost"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
