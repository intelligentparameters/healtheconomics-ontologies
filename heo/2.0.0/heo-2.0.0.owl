    <!-- https://healtheconomics.wiki/concept/concurrent-risk-adjustment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/concurrent-risk-adjustment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/risk-adjustment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/risk-adjustment"/>
        <skos:notation>HS-HP-HI-044</skos:notation>
        <dcterms:identifier>HS-HP-HI-044</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-21</dcterms:modified>
        <dcterms:source>Ellis 2008</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Concurrent Risk Adjustment</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A risk adjustment method using diagnoses observed in the same period costs are predicted for, unlike prospective adjustment using prior period data.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Concurrent Risk Model</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Same-Period Risk Adjustment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Concurrent Risk Adjustment</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/prospective-risk-adjustment"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/diagnosis-based-risk-score"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/concurrent-risk-adjustment"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/risk-adjustment"/>
        <dcterms:identifier>HEO-L-8f9d9fe3edc2</dcterms:identifier>
        <linkRationale xml:lang="en">A risk adjustment method</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
