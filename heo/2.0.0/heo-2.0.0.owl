        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Reference-Based Pricing</rdfs:label>
        <skos:altLabel xml:lang="en">RBP</skos:altLabel>
        <skos:definition xml:lang="en">A general term for policies anchoring a drug&apos;s price or reimbursement to a defined reference point, such as a similar drug or another country.</skos:definition>
