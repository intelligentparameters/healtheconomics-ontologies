    <!-- https://healtheconomics.wiki/concept/programme-budgeting -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/programme-budgeting">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <precedes rdf:resource="https://healtheconomics.wiki/concept/marginal-analysis"/>
        <skos:notation>HS-HP-HF-059</skos:notation>
        <dcterms:identifier>HS-HP-HF-059</dcterms:identifier>
        <dcterms:source>Mooney, Russell &amp; Weir 1986</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Programme Budgeting</rdfs:label>
        <skos:altLabel xml:lang="en">Program Budgeting</skos:altLabel>
        <skos:definition xml:lang="en">A budgeting approach organising health spending around specific programmes or disease areas rather than input categories, allowing cross-programme comparison.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Budget Programming</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Programme Budgeting</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/resource-allocation"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-2"/>
