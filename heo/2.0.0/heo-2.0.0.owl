        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Network Model</rdfs:label>
        <skos:definition xml:lang="en">A managed care structure where a plan contracts with a broad network of independent providers, rather than employing them directly.</skos:definition>
        <skos:prefLabel xml:lang="en">Network Model</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/provider-network"/>
