        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-evaluation"/>
        <dcterms:identifier>HEO-L-c01954edc190</dcterms:identifier>
