    <!-- https://healtheconomics.wiki/concept/variance-reduction -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/variance-reduction">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:notation>HE-EM-UA-083</skos:notation>
        <dcterms:identifier>HE-EM-UA-083</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Law &amp; Kelton 2000</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Variance Reduction</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Variance-Reduction Technique</skos:altLabel>
        <skos:definition xml:lang="en">Variance reduction is the use of simulation sampling or estimator design to lower Monte Carlo error for a specified quantity without changing the quantity being estimated.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Efficiency Technique</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Variance Reduction</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-10"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/monte-carlo-error"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/variance-reduction"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-dcd528f02cd1</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Uncertainty and sensitivity analysis in subdomain Economic Modelling</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/variance-reduction"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/monte-carlo-error"/>
        <dcterms:identifier>HEO-L-e20dff0bf856</dcterms:identifier>
