    <!-- https://healtheconomics.wiki/concept/preferred-drug -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/preferred-drug">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/formulary-management"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/formulary-management"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/preferred-tier"/>
        <skos:notation>PP-PC-FM-008</skos:notation>
        <dcterms:identifier>PP-PC-FM-008</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Preferred Drug</rdfs:label>
        <skos:definition xml:lang="en">A medication assigned to a lower-cost formulary tier, typically with lower patient cost-sharing, to encourage its use over costlier alternatives.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Favoured Formulary Agent</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">First-Line Formulary Choice</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Preferred Drug</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/preferred-drug"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/formulary-management"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-b3e48fc2d9b4</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Pharmacy Practice &gt; Pharmaceutical Care &gt; Formulary Management: formulary listing is a reimbursement decision (Reimbursement and managed access); placed under Formulary Management, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/preferred-drug"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/preferred-tier"/>
        <dcterms:identifier>HEO-L-c24c63ffa124</dcterms:identifier>
        <linkRationale xml:lang="en">second check: Paired removal: partOf Formulary is itself being removed (HEO-L-7a7aa78db93d) because of this link; a preferred drug is a member of the preferred tier</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/preferred-provider-organization -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/preferred-provider-organization">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/managed-care-organization"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q7239847"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/managed-care-organization"/>
        <skos:notation>HS-HP-HI-138</skos:notation>
        <dcterms:identifier>HS-HP-HI-138</dcterms:identifier>
        <dcterms:source>Kongstvedt 2012</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Preferred Provider Organization</rdfs:label>
        <skos:altLabel xml:lang="en">PPO</skos:altLabel>
        <skos:definition xml:lang="en">A managed care plan offering a discounted contracted network while still allowing out-of-network care at higher cost-sharing, without requiring referrals.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Preferred-Network Plan</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Preferred Provider Organization</skos:prefLabel>
        <abbreviation xml:lang="en">PPO</abbreviation>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/provider-network"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/preferred-provider-organization"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/managed-care-organization"/>
        <dcterms:identifier>HEO-L-aba9746c1640</dcterms:identifier>
        <linkRationale xml:lang="en">A PPO is a managed care organisation</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/preferred-provider-organization"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/provider-network"/>
        <dcterms:identifier>HEO-L-834bbfd1b3df</dcterms:identifier>
