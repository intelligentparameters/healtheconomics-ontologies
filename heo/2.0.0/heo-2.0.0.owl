        <skos:notation>HE-EE-BE-043</skos:notation>
        <dcterms:identifier>HE-EE-BE-043</dcterms:identifier>
        <dcterms:source>Michie S, van Stralen MM, West R. The behaviour change wheel: a new method for characterising and designing behaviour change interventions. Implementation Science. 2011;6:42. doi:10.1186/1748-5908-6-42.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Health Behaviour</rdfs:label>
        <skos:altLabel xml:lang="en">Health Behavior</skos:altLabel>
        <skos:altLabel xml:lang="en">Health-Related Behaviour</skos:altLabel>
        <skos:definition xml:lang="en">An action or pattern of action that affects an individual&apos;s health, healthcare use or response to prevention and treatment.</skos:definition>
        <skos:prefLabel xml:lang="en">Health Behaviour</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/health"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/health-behaviour"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/behavioural-economics"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-f4085b69ef8b</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Behavioral Economics: behavioural economics enters health economics mainly through policy design (incentives, nudges); placed under Behavioural Economics, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/health-behaviour"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health"/>
        <dcterms:identifier>HEO-L-e2edc9e4a741</dcterms:identifier>
