    <!-- https://healtheconomics.wiki/concept/societal-value -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/societal-value">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-NHS-VBH-016</skos:notation>
        <dcterms:identifier>HS-NHS-VBH-016</dcterms:identifier>
        <dcterms:source>Lakdawalla et al. 2017</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Societal Value</rdfs:label>
        <skos:definition xml:lang="en">The total benefit a technology provides from the broadest perspective, covering direct patient health, caregiver burden, productivity, and other societal effects.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Broad Value</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Social Value</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Societal Value</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/value-assessment"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/societal-value"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-d08372d6a813</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; NHS Productivity &gt; Value-Based Healthcare: wiki topic Performance, productivity and quality sits in Health Systems</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/societal-value"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/value-assessment"/>
        <dcterms:identifier>HEO-L-8cc134773819</dcterms:identifier>
        <linkRationale xml:lang="en">Value assessment evaluates a technology&apos;s overall benefit relative to cost; societal value is that benefit from the broadest perspective</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/socioeconomic-adjustment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/socioeconomic-adjustment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/risk-adjustment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/risk-adjustment"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/risk-adjustment-mechanism"/>
        <skos:notation>HS-HP-HI-181</skos:notation>
        <dcterms:identifier>HS-HP-HI-181</dcterms:identifier>
        <dcterms:source>Ellis 2008</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Socioeconomic Adjustment</rdfs:label>
        <skos:definition xml:lang="en">A modification to a risk adjustment or payment formula accounting for added costs of caring for socioeconomically disadvantaged populations.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Deprivation Adjustment</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Socioeconomic Risk Adjustment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Socioeconomic Adjustment</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-2"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/social-determinants-of-health"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/socioeconomic-adjustment"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/risk-adjustment"/>
        <dcterms:identifier>HEO-L-6ba86504dab6</dcterms:identifier>
        <linkRationale xml:lang="en">Socioeconomic adjustment is a risk adjustment for disadvantage.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/socioeconomic-adjustment"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/risk-adjustment-mechanism"/>
        <dcterms:identifier>HEO-L-517700470995</dcterms:identifier>
        <linkRationale xml:lang="en">A socioeconomic term is an element added to the risk adjustment payment formula</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
