        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Inpatient Surgery</rdfs:label>
        <skos:definition xml:lang="en">A surgical procedure performed on a patient formally admitted to hospital, typically requiring at least one overnight stay, unlike outpatient surgery.</skos:definition>
