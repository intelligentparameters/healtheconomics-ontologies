        <dcterms:identifier>HE-EE-CBA-001</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Augestad et al. 2016</dcterms:source>
