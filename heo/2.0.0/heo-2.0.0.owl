        <skos:altLabel xml:lang="en">Recurrent Budget</skos:altLabel>
        <skos:definition xml:lang="en">A budget covering the day-to-day revenues and expenses required to run an organisation&apos;s ongoing operations.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Running-Costs Budget</skos:hiddenLabel>
