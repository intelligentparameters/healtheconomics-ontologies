    <!-- https://healtheconomics.wiki/concept/odds-ratio -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/odds-ratio">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/relative-measure"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1862216"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/relative-measure"/>
        <skos:notation>HE-ES-RM-019</skos:notation>
        <dcterms:identifier>HE-ES-RM-019</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Cornfield 1951</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Odds Ratio</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">OR</skos:altLabel>
        <skos:definition xml:lang="en">A measure comparing the odds of an outcome in one group to the odds in another, common in case-control studies and logistic regression.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Odds Relative Measure</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Odds Ratio</skos:prefLabel>
        <abbreviation xml:lang="en">OR</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/relative-risk"/>
