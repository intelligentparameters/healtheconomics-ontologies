    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/law-of-large-numbers"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isFoundationFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/risk-pooling"/>
        <dcterms:identifier>HEO-L-b5c4e34eb76b</dcterms:identifier>
        <linkRationale xml:lang="en">Insurance pooling relies on average claims becoming predictable as the pool grows.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/lead-identification -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/lead-identification">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-development"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/drug-development"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/drug-discovery"/>
        <precedes rdf:resource="https://healtheconomics.wiki/concept/lead-optimisation"/>
        <skos:notation>HE-PE-DD-023</skos:notation>
        <dcterms:identifier>HE-PE-DD-023</dcterms:identifier>
        <dcterms:source>DiMasi JA, Grabowski HG, Hansen RW. Innovation in the pharmaceutical industry: new estimates of R&amp;D costs. Journal of Health Economics. 2016;47:20-33. doi:10.1016/j.jhealeco.2016.01.012.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Lead Identification</rdfs:label>
        <skos:definition xml:lang="en">An early drug discovery stage in which promising compounds from initial screening are characterised and prioritised for further development based on potency and selectivity.</skos:definition>
        <skos:prefLabel xml:lang="en">Lead Identification</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
