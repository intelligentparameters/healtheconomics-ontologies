        <skos:hiddenLabel xml:lang="en">Emergency Treatment Expense</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Emergency Care Cost</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
