        <skos:hiddenLabel xml:lang="en">Public Support</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Subsidy</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
