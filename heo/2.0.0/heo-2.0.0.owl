    <!-- https://healtheconomics.wiki/concept/gini-coefficient -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/gini-coefficient">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/inequality-index"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q162455"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/inequality-index"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/health-inequality"/>
        <skos:notation>HE-EE-WE-027</skos:notation>
        <dcterms:identifier>HE-EE-WE-027</dcterms:identifier>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Gini Coefficient</rdfs:label>
        <skos:altLabel xml:lang="en">Gini Index</skos:altLabel>
        <skos:definition xml:lang="en">A summary measure of inequality across a population, ranging from 0 for perfect equality to 1 for maximum inequality, commonly applied to income or health.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Inequality Coefficient</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Gini Coefficient</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/gini-coefficient"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/inequality-index"/>
        <dcterms:identifier>HEO-L-252d9960be2e</dcterms:identifier>
        <linkRationale xml:lang="en">The Gini coefficient has subtypes (health Gini), so it is a class, not an individual</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/gini-coefficient"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-inequality"/>
        <dcterms:identifier>HEO-L-410d22a5bae5</dcterms:identifier>
