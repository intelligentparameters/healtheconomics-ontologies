    <!-- https://healtheconomics.wiki/concept/inhalation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/inhalation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
