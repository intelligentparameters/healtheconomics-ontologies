    <!-- https://healtheconomics.wiki/concept/serious-adverse-event -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/serious-adverse-event">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/adverse-event"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q446142"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/adverse-event"/>
        <skos:notation>PP-PC-MS-013</skos:notation>
        <dcterms:identifier>PP-PC-MS-013</dcterms:identifier>
        <dcterms:source>ICH, Good Clinical Practice Guideline (E6)</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Serious Adverse Event</rdfs:label>
        <skos:altLabel xml:lang="en">SAE</skos:altLabel>
        <skos:definition xml:lang="en">An untoward medical occurrence during research or treatment resulting in death, life-threatening risk, hospitalisation, or persistent significant disability, per international guidance.</skos:definition>
        <skos:prefLabel xml:lang="en">Serious Adverse Event</skos:prefLabel>
        <abbreviation xml:lang="en">SAE</abbreviation>
        <informs rdf:resource="https://healtheconomics.wiki/concept/benefit-risk-assessment"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/serious-adverse-event"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/adverse-event"/>
        <dcterms:identifier>HEO-L-3889d965511a</dcterms:identifier>
        <linkRationale xml:lang="en">A serious adverse event is a severe adverse event.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/serious-adverse-event"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/benefit-risk-assessment"/>
