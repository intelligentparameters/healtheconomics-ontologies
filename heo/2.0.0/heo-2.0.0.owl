        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/multi-attribute-utility"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/preference-weight"/>
        <skos:notation>HE-EE-CBA-039</skos:notation>
        <dcterms:identifier>HE-EE-CBA-039</dcterms:identifier>
        <dcterms:source>Luce &amp; Tukey 1964</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Part-Worth Utility</rdfs:label>
        <skos:altLabel xml:lang="en">Attribute-Level Utility</skos:altLabel>
        <skos:altLabel xml:lang="en">Conjoint Part-Worth</skos:altLabel>
        <skos:definition xml:lang="en">The contribution of a single attribute level to an individual&apos;s overall utility for a good, estimated from a conjoint or choice experiment.</skos:definition>
        <skos:prefLabel xml:lang="en">Part-Worth Utility</skos:prefLabel>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/level"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/outcomes#step-4"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
