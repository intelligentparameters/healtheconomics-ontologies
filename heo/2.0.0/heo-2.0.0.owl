    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/audit-and-feedback">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/feedback-intervention"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/implementation-strategy"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/quality-improvement"/>
