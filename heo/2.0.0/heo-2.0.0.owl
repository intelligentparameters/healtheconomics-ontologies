    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/screening -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/screening">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/secondary-prevention"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1163564"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/secondary-prevention"/>
        <skos:notation>HE-ES-CTM-082</skos:notation>
        <dcterms:identifier>HE-ES-CTM-082</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>UK National Screening Committee 2023</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Screening</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">Screening is the process of identifying apparently healthy people at increased risk of a condition, then offering information, further tests or treatment.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Early Detection Programme</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Screening</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/diagnosis-coverage"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/screening"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/secondary-prevention"/>
        <dcterms:identifier>HEO-L-fdf35efca960</dcterms:identifier>
        <linkRationale xml:lang="en">Screening detects disease early before symptoms, which is the definition of secondary prevention.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/screening"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/diagnosis-coverage"/>
        <dcterms:identifier>HEO-L-ec29dfa79235</dcterms:identifier>
        <linkRationale xml:lang="en">Screening finds undiagnosed cases and so raises the share diagnosed</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/screening-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/screening-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
