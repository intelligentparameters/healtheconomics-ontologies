    <!-- https://healtheconomics.wiki/concept/family-impact -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/family-impact">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
