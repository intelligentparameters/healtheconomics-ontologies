        <skos:altLabel xml:lang="en">Admitted Patient Care</skos:altLabel>
        <skos:definition xml:lang="en">Healthcare services provided to a patient formally admitted to hospital, typically requiring at least one overnight stay, unlike outpatient care.</skos:definition>
