        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Clinical Benefit Criterion</rdfs:label>
        <skos:definition xml:lang="en">A standard judging whether a treatment provides sufficient clinical benefit, absolute or relative, to warrant a positive funding recommendation.</skos:definition>
