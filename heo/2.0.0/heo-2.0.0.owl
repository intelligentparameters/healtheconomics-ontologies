        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/odds-ratio"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/relative-measure"/>
        <dcterms:identifier>HEO-L-898aa1f9c3ca</dcterms:identifier>
        <linkRationale xml:lang="en">The odds ratio is a ratio measure of effect, per both definitions, not a component of epidemiology</linkRationale>
