    <!-- https://healtheconomics.wiki/concept/audit-recovery -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/audit-recovery">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-HP-HSR-005</skos:notation>
        <dcterms:identifier>HS-HP-HSR-005</dcterms:identifier>
        <dcterms:source>CMS, Recovery Audit Program</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Audit Recovery</rdfs:label>
        <skos:definition xml:lang="en">The process of a payer identifying and recovering improper payments previously made to a provider, typically following an audit.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Payment Recovery</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Recovery Audit</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Audit Recovery</skos:prefLabel>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/compliance"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/audit-recovery"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-524769ad844a</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health System Regulation: compliance, audit and accreditation govern how providers work (Organisation and governance)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/audit-recovery"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#promotes"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/compliance"/>
        <dcterms:identifier>HEO-L-d356beed9076</dcterms:identifier>
        <linkRationale xml:lang="en">Recovering improper payments is an enforcement mechanism that encourages billing compliance, not part of it</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


