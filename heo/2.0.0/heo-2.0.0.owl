        <skos:altLabel xml:lang="en">Economic Modeling</skos:altLabel>
        <skos:altLabel xml:lang="en">Health Economic Modelling</skos:altLabel>
        <skos:definition xml:lang="en">Economic modelling is the area of health economics that combines evidence in a mathematical structure to estimate the long-term costs and health outcomes of competing options.</skos:definition>
        <skos:editorialNote xml:lang="en">In HEO this concept is the wiki subdomain Economic Modelling, directly under Health Economics. Concepts in that subdomain with no is-type-of parent are classified under it or under a concept within it.</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Economic Modelling</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
