        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">ADME</skos:altLabel>
        <skos:definition xml:lang="en">ADME studies measure how a drug is absorbed, distributed, metabolised and excreted, informing dose adjustments for organ impairment and drug interactions.</skos:definition>
        <skos:hiddenLabel xml:lang="en">ADME Profiling</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Absorption Distribution Metabolism Excretion</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">ADME Studies</skos:prefLabel>
        <abbreviation xml:lang="en">ADME</abbreviation>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/drug-drug-interaction"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/dose-finding"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/adme-studies"/>
