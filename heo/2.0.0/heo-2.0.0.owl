        <dcterms:identifier>HE-PE-TI-008</dcterms:identifier>
        <dcterms:source>Jørgensen &amp; Kefalas 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Curative Therapy</rdfs:label>
        <skos:altLabel xml:lang="en">Curative Treatment</skos:altLabel>
        <skos:altLabel xml:lang="en">Transformative Therapy</skos:altLabel>
        <skos:definition xml:lang="en">A treatment intended to permanently eliminate a disease rather than merely manage its symptoms or slow its progression.</skos:definition>
