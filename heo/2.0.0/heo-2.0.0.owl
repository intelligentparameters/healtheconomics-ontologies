        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Adaptive Trial Design</rdfs:label>
        <owl:versionInfo>1.0.5</owl:versionInfo>
        <skos:altLabel xml:lang="en">Adaptive Study Design</skos:altLabel>
        <skos:definition xml:lang="en">Adaptive trial design is a trial plan whose prespecified rules let interim data change the trial, such as stopping early, while keeping inference valid.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Adaptive Trial</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Flexible Study Design</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Flexible Trial Design</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Prospectively Adaptive Study</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Adaptive Trial Design</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/interim-analysis"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/monte-carlo-simulation"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/stopping-rule"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/adaptive-trial-design"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/clinical-trial-design"/>
