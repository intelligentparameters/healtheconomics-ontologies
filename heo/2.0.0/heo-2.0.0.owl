        <measures rdf:resource="https://healtheconomics.wiki/concept/social-welfare"/>
        <skos:notation>HE-EE-WE-022</skos:notation>
        <dcterms:identifier>HE-EE-WE-022</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-03</dcterms:modified>
        <dcterms:source>Asaria et al. 2013</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Social Welfare Function</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">SWF</skos:altLabel>
        <skos:definition xml:lang="en">A social welfare function (SWF) combines individual health or wellbeing into overall social welfare, setting how equality is weighed against the total.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Welfare Aggregation Function</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Social Welfare Function</skos:prefLabel>
        <abbreviation xml:lang="en">SWF</abbreviation>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/atkinson-index"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/equity-efficiency-trade-off"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/social-welfare-function"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/welfare-economics"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-dd25243d1bbf</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Welfare Economics: welfarism and extra-welfarism are the normative basis of cost-benefit and cost-effectiveness analysis; placed under Welfare Economics, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/social-welfare-function"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/social-welfare"/>
        <dcterms:identifier>HEO-L-582508219e03</dcterms:identifier>
        <linkRationale xml:lang="en">second check: Circular removal; HEO-L-a6918bdacfcd removes the usedToCalculate twin citing this link, so both would go; the SWF does quantify social welfare</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/social-welfare-function"/>
