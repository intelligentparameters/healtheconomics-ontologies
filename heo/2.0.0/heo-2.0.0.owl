    <!-- https://healtheconomics.wiki/concept/individual-patient-data-meta-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/individual-patient-data-meta-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/meta-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/meta-analysis"/>
        <skos:notation>HE-ES-ESM-029</skos:notation>
        <dcterms:identifier>HE-ES-ESM-029</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-23</dcterms:modified>
        <dcterms:source>Stewart &amp; Parmar 1993</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Individual Patient Data Meta-Analysis</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">IPD Meta-Analysis</skos:altLabel>
        <skos:altLabel xml:lang="en">IPD-MA</skos:altLabel>
        <skos:altLabel xml:lang="en">Individual Participant Data Meta-Analysis</skos:altLabel>
        <skos:altLabel xml:lang="en">Patient-Level Meta-Analysis</skos:altLabel>
        <skos:definition xml:lang="en">Individual patient data meta-analysis systematically obtains, checks, and jointly synthesises participant-level records from eligible studies to estimate effects and investigate variation across studies or patients.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Individual Patient Meta-Analysis</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Participant-Level Meta-Analysis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Individual Patient Data Meta-Analysis</skos:prefLabel>
        <abbreviation xml:lang="en">IPD Meta-Analysis</abbreviation>
        <abbreviation xml:lang="en">IPD-MA</abbreviation>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-4"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/individual-patient-data-meta-analysis"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/meta-analysis"/>
        <dcterms:identifier>HEO-L-a5b8fa656f5b</dcterms:identifier>
        <linkRationale xml:lang="en">IPD meta-analysis is a form of meta-analysis</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


