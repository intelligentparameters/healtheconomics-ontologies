        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/patient-reported-outcome"/>
        <dcterms:identifier>HEO-L-1f3e89186cf4</dcterms:identifier>
        <linkRationale xml:lang="en">Health status reported directly by the patient is a patient-reported outcome.</linkRationale>
