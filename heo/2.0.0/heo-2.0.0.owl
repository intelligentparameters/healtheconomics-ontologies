    <!-- https://healtheconomics.wiki/concept/direct-benefit -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/direct-benefit">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-HP-HSG-008</skos:notation>
        <dcterms:identifier>HS-HP-HSG-008</dcterms:identifier>
        <dcterms:source>National Commission, Belmont Report 1979</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Direct Benefit</rdfs:label>
        <skos:definition xml:lang="en">A potential positive outcome a research participant may personally experience from their participation, such as access to an investigational treatment.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Participant Benefit</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Personal Trial Benefit</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Direct Benefit</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/research-risk"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/informed-consent"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/direct-benefit"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
