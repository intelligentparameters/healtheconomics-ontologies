    <!-- https://healtheconomics.wiki/concept/cause-specific-mortality -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cause-specific-mortality">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/mortality-rate"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/mortality-rate"/>
        <skos:notation>HE-EM-MP-005</skos:notation>
        <dcterms:identifier>HE-EM-MP-005</dcterms:identifier>
        <dcterms:source>Chiang 1984</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cause-Specific Mortality</rdfs:label>
        <skos:altLabel xml:lang="en">Disease-Specific Mortality</skos:altLabel>
        <skos:definition xml:lang="en">The rate of death attributable to a particular disease within a defined population, calculated separately from deaths due to other causes.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cause-of-Death Rate</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cause-Specific Mortality</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cause-specific-mortality"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/mortality-rate"/>
        <dcterms:identifier>HEO-L-3f55c1004eda</dcterms:identifier>
        <linkRationale xml:lang="en">A cause-specific death rate is a mortality rate (both definitions)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/cause-specific-survival -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cause-specific-survival">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/time-to-event"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/time-to-event"/>
        <skos:notation>HE-EM-SM-005</skos:notation>
        <dcterms:identifier>HE-EM-SM-005</dcterms:identifier>
        <dcterms:source>Latimer 2013</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cause-Specific Survival</rdfs:label>
        <skos:altLabel xml:lang="en">Disease-Specific Survival</skos:altLabel>
        <skos:definition xml:lang="en">The probability of surviving without dying from a specific cause of interest, treating deaths from other causes as censoring rather than a competing risk.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Net Survival</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cause-Specific Survival</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/overall-survival"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/relative-survival"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-5"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cause-specific-survival"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/time-to-event"/>
        <dcterms:identifier>HEO-L-d18d32ce0316</dcterms:identifier>
        <linkRationale xml:lang="en">CSS is a survival endpoint, not an analysis method; it is time-to-event data with competing deaths censored</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cause-specific-survival"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/overall-survival"/>
        <dcterms:identifier>HEO-L-78ff8ce2b07e</dcterms:identifier>
        <linkRationale xml:lang="en">Cause-specific deaths versus deaths from any cause are alternative survival endpoints</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cause-specific-survival"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/relative-survival"/>
        <dcterms:identifier>HEO-L-62feb315ee93</dcterms:identifier>
