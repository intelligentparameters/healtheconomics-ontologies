    <!-- https://healtheconomics.wiki/concept/simplification-intervention -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/simplification-intervention">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/choice-architecture-intervention"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/nudge-intervention"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/choice-architecture-intervention"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/nudge-intervention"/>
        <skos:notation>HE-EE-BE-036</skos:notation>
        <dcterms:identifier>HE-EE-BE-036</dcterms:identifier>
        <dcterms:source>Thaler &amp; Sunstein 2008</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Simplification Intervention</rdfs:label>
        <skos:definition xml:lang="en">An intervention that reduces the complexity of choices or information presented to a decision-maker to improve decision quality.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Complexity Reduction</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Simplification Nudge</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Simplification Intervention</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/simplification-intervention"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/choice-architecture-intervention"/>
        <dcterms:identifier>HEO-L-a13ed5616a92</dcterms:identifier>
        <linkRationale xml:lang="en">Simplifying how options are presented is itself a choice architecture intervention, not a tool it employs.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/simplification-intervention"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/nudge-intervention"/>
        <dcterms:identifier>HEO-L-4439350101c0</dcterms:identifier>
