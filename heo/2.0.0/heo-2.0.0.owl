    <!-- https://healtheconomics.wiki/concept/herd-immunity-threshold -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/herd-immunity-threshold">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-PE-ID-030</skos:notation>
        <dcterms:identifier>HE-PE-ID-030</dcterms:identifier>
        <dcterms:source>Anderson &amp; May 1991</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Herd Immunity Threshold</rdfs:label>
        <skos:definition xml:lang="en">The proportion of a population that must be immune to achieve herd immunity, mathematically related to a pathogen&apos;s basic reproduction number.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Critical Immunity Threshold</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">HIT</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Herd Immunity Threshold</skos:prefLabel>
        <benchmarkFor rdf:resource="https://healtheconomics.wiki/concept/herd-immunity"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/immunisation-programme"/>
