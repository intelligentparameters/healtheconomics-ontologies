    <!-- https://healtheconomics.wiki/concept/event-free-survival -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/event-free-survival">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/time-to-event"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/time-to-event"/>
        <skos:notation>HE-ES-CO-025</skos:notation>
        <dcterms:identifier>HE-ES-CO-025</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-24</dcterms:modified>
        <dcterms:source>Latimer 2013</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Event-Free Survival</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">EFS</skos:altLabel>
        <skos:definition xml:lang="en">Event-free survival is the time from a specified starting point to the first event in a prespecified endpoint, with incomplete event-free follow-up handled according to the study&apos;s censoring rules.</skos:definition>
        <skos:prefLabel xml:lang="en">Event-Free Survival</skos:prefLabel>
        <abbreviation xml:lang="en">EFS</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/progression-free-survival"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/outcomes#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/event-free-survival"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/time-to-event"/>
        <dcterms:identifier>HEO-L-86bd41f4b693</dcterms:identifier>
        <linkRationale xml:lang="en">EFS is time to first event, a time-to-event outcome</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/event-free-survival"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/progression-free-survival"/>
        <dcterms:identifier>HEO-L-86b2d79f0305</dcterms:identifier>
