        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Profitability Ratio</rdfs:label>
        <skos:definition xml:lang="en">A financial ratio measuring an organisation&apos;s ability to generate profit relative to its revenue, assets, or equity.</skos:definition>
