    <!-- https://healtheconomics.wiki/concept/for-profit-hospital -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/for-profit-hospital">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/healthcare-facility"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/healthcare-facility"/>
        <skos:notation>HS-HP-HD-046</skos:notation>
        <dcterms:identifier>HS-HP-HD-046</dcterms:identifier>
        <dcterms:source>AHA, American Hospital Association</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">For-Profit Hospital</rdfs:label>
        <skos:altLabel xml:lang="en">Investor-Owned Hospital</skos:altLabel>
        <skos:altLabel xml:lang="en">Proprietary Hospital</skos:altLabel>
        <skos:definition xml:lang="en">A hospital organised as a for-profit business entity, distributing operating surplus to shareholders rather than reinvesting it entirely, unlike a non-profit hospital.</skos:definition>
        <skos:prefLabel xml:lang="en">For-Profit Hospital</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/non-profit-hospital"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
