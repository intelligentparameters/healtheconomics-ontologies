        <skos:hiddenLabel xml:lang="en">HTA Appraisal</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Technology Appraisal</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
    </owl:NamedIndividual>
