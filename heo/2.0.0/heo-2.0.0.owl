    <!-- https://healtheconomics.wiki/concept/cost-effectiveness-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cost-effectiveness-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/full-economic-evaluation"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1754768"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/full-economic-evaluation"/>
        <skos:notation>HE-EE-CEA-012</skos:notation>
        <dcterms:identifier>HE-EE-CEA-012</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Drummond MF et al. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. 2015. https://global.oup.com/academic/product/methods-for-the-economic-evaluation-of-health-care-programmes-9780199665884 | NICE. Health technology evaluations: the manual—Economic evaluation. https://www.nice.org.uk/process/pmg36/chapter/economic-evaluation-2 | WHO. Generalized Cost-Effectiveness Analysis. https://www.who.int/teams/health-financing-and-economics/economic-analysis/health-technology-assessment-and-benefit-package-design/generalized-cost-effectiveness-analysis</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cost-Effectiveness Analysis</rdfs:label>
        <owl:versionInfo>1.5.76</owl:versionInfo>
        <skos:altLabel xml:lang="en">CEA</skos:altLabel>
        <skos:definition xml:lang="en">Cost-effectiveness analysis compares healthcare options by the extra cost of each extra unit of health gained, such as cost per life-year gained.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cost per Outcome Analysis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cost-Effectiveness Analysis</skos:prefLabel>
        <abbreviation xml:lang="en">CEA</abbreviation>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-3"/>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/value-for-money"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/screening-policy"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/ceac"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/ceaf"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-frontier"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/icer"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-plane"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/decision-analysis"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/health-economic-model"/>
