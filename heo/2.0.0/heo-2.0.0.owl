        <dcterms:identifier>HS-HP-HF-020</dcterms:identifier>
        <dcterms:source>CMS, Medicaid Disproportionate Share Hospital Program</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Disproportionate Share</rdfs:label>
        <skos:altLabel xml:lang="en">DSH</skos:altLabel>
        <skos:definition xml:lang="en">A US Medicaid funding mechanism providing additional payments to hospitals serving a disproportionately large share of low-income and uninsured patients.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Safety-Net Hospital Payment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Disproportionate Share</skos:prefLabel>
        <abbreviation xml:lang="en">DSH</abbreviation>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/uncompensated-care"/>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/safety-net-provider"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
