    <!-- https://healtheconomics.wiki/concept/moral-hazard-in-health-insurance -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/moral-hazard-in-health-insurance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/moral-hazard"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/moral-hazard"/>
        <skos:notation>HE-EE-HI-003</skos:notation>
        <dcterms:identifier>HE-EE-HI-003</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-03</dcterms:modified>
        <dcterms:source>Einav &amp; Finkelstein 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Moral Hazard in Health Insurance</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Moral hazard in health insurance is extra healthcare use when cover lowers the price patients pay, and any reduced effort to stay healthy once insured.</skos:definition>
        <skos:prefLabel xml:lang="en">Moral Hazard in Health Insurance</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/adverse-selection"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/deadweight-loss"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/moral-hazard-in-health-insurance"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/moral-hazard"/>
        <dcterms:identifier>HEO-L-4530c7408e7e</dcterms:identifier>
        <linkRationale xml:lang="en">Moral hazard in the health insurance setting</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
