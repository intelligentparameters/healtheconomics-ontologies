    <!-- https://healtheconomics.wiki/concept/quality-of-life -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/quality-of-life">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-related-quality-of-life"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q13100823"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-related-quality-of-life"/>
        <skos:notation>HE-EE_HRQL-008</skos:notation>
        <dcterms:identifier>HE-EE_HRQL-008</dcterms:identifier>
        <dcterms:source>WHOQOL Group 1995</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Quality of Life</rdfs:label>
        <skos:altLabel xml:lang="en">QoL</skos:altLabel>
        <skos:definition xml:lang="en">A broad concept covering a person&apos;s overall wellbeing, including physical, psychological, social, and material aspects, of which health is one part.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Life Quality</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Quality of Life</skos:prefLabel>
        <abbreviation xml:lang="en">QoL</abbreviation>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/qaly"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/quality-of-life"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-related-quality-of-life"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-5a5fb143456c</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Health-Related Quality of Life: quality of life measurement is part of Outcomes; placed under Health-Related Quality of Life, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/quality-of-life"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isFoundationFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/qaly"/>
        <dcterms:identifier>HEO-L-2a98cac7589c</dcterms:identifier>
        <linkRationale xml:lang="en">relatedTo retired; the QALY definition combines length and quality of life, so QoL is a basic idea it builds on.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/quality-of-life-outcome -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/quality-of-life-outcome">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
