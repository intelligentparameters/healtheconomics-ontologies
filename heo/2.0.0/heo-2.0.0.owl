    <!-- https://healtheconomics.wiki/concept/second-primary-cancer -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/second-primary-cancer">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
