    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/psa -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/psa">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/sensitivity-analysis"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/stochastic-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/sensitivity-analysis"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/stochastic-analysis"/>
        <skos:notation>HE-EM-UA-055</skos:notation>
        <dcterms:identifier>HE-EM-UA-055</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</dcterms:modified>
        <dcterms:source>Steuten et al. 2026</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Probabilistic Sensitivity Analysis</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:altLabel xml:lang="en">PSA</skos:altLabel>
        <skos:definition xml:lang="en">Probabilistic sensitivity analysis (PSA) runs a decision model many times on jointly drawn inputs to estimate expected outcomes and decision uncertainty.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Probabilistic Analysis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Probabilistic Sensitivity Analysis</skos:prefLabel>
        <abbreviation xml:lang="en">PSA</abbreviation>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/parameter-uncertainty"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-10"/>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/decision-uncertainty"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/ceaf"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-acceptability"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/expected-net-benefit"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/probability-of-cost-effectiveness"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/antithetic-variates"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/beta-distribution"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/cholesky-decomposition"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/dirichlet-distribution"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/emulator"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/latin-hypercube-sampling"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/monte-carlo-simulation"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/nested-loop"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/parameter-distribution"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/psa"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/sensitivity-analysis"/>
        <dcterms:identifier>HEO-L-1d91d66afc20</dcterms:identifier>
        <linkRationale xml:lang="en">PSA is a sensitivity analysis.</linkRationale>
