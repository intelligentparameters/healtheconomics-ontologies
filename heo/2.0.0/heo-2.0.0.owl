    <!-- https://healtheconomics.wiki/concept/causal-pathway -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/causal-pathway">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/comparative-effectiveness-research"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/comparative-effectiveness-research"/>
        <skos:notation>HE-ES-CER-030</skos:notation>
        <dcterms:identifier>HE-ES-CER-030</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</dcterms:modified>
        <dcterms:source>Hernán and Robins 2020; Rohwer et al. 2017</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Causal Pathway</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:definition xml:lang="en">A causal pathway is the sequence of steps through which an intervention or exposure produces a health outcome, acting through intermediate variables.</skos:definition>
        <skos:prefLabel xml:lang="en">Causal Pathway</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/model-conceptualization"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/mediation-analysis"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/surrogate-endpoint"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/causal-pathway"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/comparative-effectiveness-research"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-137e85dac06d</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Comparative Effectiveness Research: catalogue subdomain Evidence Synthesis is one of the subdomains; placed under Comparative Effectiveness Research, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/causal-pathway"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/model-conceptualization"/>
        <dcterms:identifier>HEO-L-5d6ef46fb3c5</dcterms:identifier>
        <linkRationale xml:lang="en">Mapping the causal pathway is input to model conceptualisation (Roberts et al. 2012)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
