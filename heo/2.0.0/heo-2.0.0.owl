        <skos:hiddenLabel xml:lang="en">Grievance Frequency</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Complaint Rate</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-5"/>
