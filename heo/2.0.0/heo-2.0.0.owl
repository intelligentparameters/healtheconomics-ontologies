    <!-- https://healtheconomics.wiki/concept/fatigue -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/fatigue">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/patient-reported-outcome"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q9690"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/patient-reported-outcome"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/health-related-quality-of-life"/>
        <skos:notation>HE-ES-CO-027</skos:notation>
        <dcterms:identifier>HE-ES-CO-027</dcterms:identifier>
        <dcterms:source>Yellen et al. 1997</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Fatigue</rdfs:label>
        <skos:definition xml:lang="en">A clinical outcome measure capturing a patient&apos;s subjective tiredness or lack of energy, commonly assessed using standardised, validated fatigue-specific instruments.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Lack of Energy</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Tiredness</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Fatigue</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
