    <!-- https://healtheconomics.wiki/concept/value-based-payment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/value-based-payment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/value-based-purchasing"/>
        <skos:notation>HS-HP-PP-100</skos:notation>
        <dcterms:identifier>HS-HP-PP-100</dcterms:identifier>
        <dcterms:source>Carlson JJ, Sullivan SD, Garrison LP, Neumann PJ, Veenstra DL. Linking payment to health outcomes: a taxonomy and examination of performance-based reimbursement schemes. Health Policy. 2010;96(3):179-190.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Value-Based Payment</rdfs:label>
        <skos:altLabel xml:lang="en">VBP</skos:altLabel>
        <skos:definition xml:lang="en">A general term for arrangements tying provider reimbursement to quality, efficiency, or outcomes, rather than volume alone under fee-for-service.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Outcome-Linked Payment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Value-Based Payment</skos:prefLabel>
        <abbreviation xml:lang="en">VBP</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/fee-for-service"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/value-based-payment"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <dcterms:identifier>HEO-L-176fe831c90b</dcterms:identifier>
        <linkRationale xml:lang="en">Value-based payment is a provider payment.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/value-based-payment"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/value-based-purchasing"/>
        <dcterms:identifier>HEO-L-33a79f9b4478</dcterms:identifier>
