        <dcterms:source>WHOQOL Group 1995</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Wellbeing</rdfs:label>
        <skos:altLabel xml:lang="en">Well-Being</skos:altLabel>
        <skos:definition xml:lang="en">A broad concept covering an individual&apos;s overall state of comfort, health, and happiness, of which health-related quality of life is one part.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Life Satisfaction</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Wellbeing</skos:prefLabel>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/social-welfare"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
