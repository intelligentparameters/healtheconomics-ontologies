    <!-- https://healtheconomics.wiki/concept/technical-feasibility -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/technical-feasibility">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/feasibility-assessment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/feasibility-assessment"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/policy-option-assessment"/>
        <skos:notation>HS-HP-PA-018</skos:notation>
        <dcterms:identifier>HS-HP-PA-018</dcterms:identifier>
        <dcterms:source>Weimer &amp; Vining 2017</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Technical Feasibility</rdfs:label>
        <skos:definition xml:lang="en">An assessment of whether a proposed policy can practically be implemented given available technology, data, and technical expertise.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Engineering Feasibility</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Technical Viability</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Technical Feasibility</skos:prefLabel>
