        <skos:notation>HS-HP-HTA-217</skos:notation>
        <dcterms:identifier>HS-HP-HTA-217</dcterms:identifier>
        <dcterms:source>National Institute for Health and Care Excellence. NICE technology appraisal and highly specialised technologies guidance: the manual (PMG36). Published 2022; updated 2026.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Therapeutic Area</rdfs:label>
        <skos:altLabel xml:lang="en">Clinical Area</skos:altLabel>
        <skos:altLabel xml:lang="en">Disease Area</skos:altLabel>
        <skos:definition xml:lang="en">A defined category of medical conditions or treatments, such as oncology, used to organise research, development, and assessment activities.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Assessment Area</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Clinical Field</skos:hiddenLabel>
