    <!-- https://healtheconomics.wiki/concept/prevalence -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/prevalence">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/epidemiology"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q719602"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/epidemiology"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/accuracy"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/prevalence-ratio"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/years-lived-with-disability"/>
        <skos:notation>HE-ES-EP-034</skos:notation>
        <dcterms:identifier>HE-ES-EP-034</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams &amp; Wilkins; 2008.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Prevalence</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">The total proportion of a population with a particular condition at a given time, covering both new and pre-existing cases.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Case Proportion</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Existing-Case Frequency</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Prevalence</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/prevalence"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
