    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/superiority-trial -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/superiority-trial">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-trial"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/clinical-trial"/>
        <skos:notation>HE-ES-CTM-092</skos:notation>
        <dcterms:identifier>HE-ES-CTM-092</dcterms:identifier>
        <dcterms:source>Piaggio et al. 2006</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Superiority Trial</rdfs:label>
        <skos:altLabel xml:lang="en">Superiority Design</skos:altLabel>
        <skos:altLabel xml:lang="en">Superiority Study</skos:altLabel>
        <skos:definition xml:lang="en">A trial designed to show a new treatment produces a better outcome than its comparator, unlike a non-inferiority or equivalence trial.</skos:definition>
        <skos:prefLabel xml:lang="en">Superiority Trial</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/superiority-trial"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/clinical-trial"/>
        <dcterms:identifier>HEO-L-d28bdc77123b</dcterms:identifier>
        <linkRationale xml:lang="en">A superiority trial is a clinical trial.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/supplemental-budget -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/supplemental-budget">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/budget-amendment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/budget-amendment"/>
        <skos:notation>HE-EE-BIA-047</skos:notation>
        <dcterms:identifier>HE-EE-BIA-047</dcterms:identifier>
        <dcterms:source>Musgrave &amp; Musgrave 1989</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Supplemental Budget</rdfs:label>
        <skos:altLabel xml:lang="en">Supplementary Budget</skos:altLabel>
        <skos:definition xml:lang="en">An additional budget allocation approved after the original budget cycle, usually to cover unforeseen spending needs beyond the original appropriation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Additional Appropriation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Supplemental Budget</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/budget-overrun"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/supplemental-budget"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/budget-amendment"/>
        <dcterms:identifier>HEO-L-6a2a39853bfc</dcterms:identifier>
        <linkRationale xml:lang="en">A supplemental budget is an approved revision adding funds after the cycle begins.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/supplemental-budget"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#addresses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/budget-overrun"/>
        <dcterms:identifier>HEO-L-0196b96e0256</dcterms:identifier>
        <linkRationale xml:lang="en">Definition: covers unforeseen spending beyond the original appropriation</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/supplementary-benefits -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/supplementary-benefits">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/benefit-design"/>
        <skos:notation>HS-HP-HTA-209</skos:notation>
        <dcterms:identifier>HS-HP-HTA-209</dcterms:identifier>
        <dcterms:source>WHO, Health Financing for Universal Coverage</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Supplementary Benefits</rdfs:label>
        <skos:definition xml:lang="en">Additional healthcare services covered beyond a health system&apos;s core essential benefits package, often through supplementary insurance or extra cost.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Add-On Benefits</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Supplementary Cover</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Supplementary Benefits</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/benefit-package"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/supplementary-benefits"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-f96407d1ba1f</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health Technology Assessment: HTA concepts belong to the HTA subdomain</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/supplementary-benefits"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/benefit-design"/>
        <dcterms:identifier>HEO-L-94dde1a7b0b3</dcterms:identifier>
        <linkRationale xml:lang="en">Benefit design sets covered services; supplementary benefits are covered services beyond the core package.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/supplementary-benefits"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/benefit-package"/>
        <dcterms:identifier>HEO-L-c21557b6d310</dcterms:identifier>
