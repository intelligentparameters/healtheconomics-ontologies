        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/ethical-criterion"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/decision-criteria"/>
        <dcterms:identifier>HEO-L-81e6078fd20b</dcterms:identifier>
        <linkRationale xml:lang="en">An ethical criterion is one of the factors weighed in a decision</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
