        <dcterms:identifier>HE-EM-MM-016</dcterms:identifier>
        <dcterms:source>Sonnenberg FA, Beck JR. Markov models in medical decision making: a practical guide. Medical Decision Making. 1993;13(4):322-338. doi:10.1177/0272989X9301300409.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">State Definition</rdfs:label>
        <skos:definition xml:lang="en">The precise specification of what constitutes a distinct health state within a Markov model, including the clinical criteria for assignment to it.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Health-State Description</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">State Characterisation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">State Definition</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
