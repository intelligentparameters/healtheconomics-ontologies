    <!-- https://healtheconomics.wiki/concept/outpatient-visits -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/outpatient-visits">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
