        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/average-length-of-stay"/>
        <dcterms:identifier>HEO-L-ed768835e011</dcterms:identifier>
