        <rdfs:label xml:lang="en">Probability</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">Probability is a number between zero and one assigned to the likelihood of a precisely defined event under stated conditions.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Chance</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Likelihood of Event</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Probability</skos:prefLabel>
