        <dcterms:identifier>HS-DC-DP-034</dcterms:identifier>
        <dcterms:source>Danzon 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Generic Pricing</rdfs:label>
        <skos:altLabel xml:lang="en">Generic Drug Pricing</skos:altLabel>
        <skos:definition xml:lang="en">The pricing strategies applied to generic drugs, typically set substantially below the original brand-name product&apos;s price to reflect lower development cost.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Off-Patent Pricing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Generic Pricing</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/generic-entry-impact"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/generic-reference-pricing"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/generic-pricing"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <dcterms:identifier>HEO-L-a209188e590d</dcterms:identifier>
        <linkRationale xml:lang="en">Generic pricing is drug pricing</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
