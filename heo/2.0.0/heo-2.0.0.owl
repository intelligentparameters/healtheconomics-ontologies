    <!-- https://healtheconomics.wiki/concept/financial-protection -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/financial-protection">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/universal-health-coverage"/>
        <skos:notation>HS-HP-HI-081</skos:notation>
        <dcterms:identifier>HS-HP-HI-081</dcterms:identifier>
        <dcterms:source>Xu et al. 2003</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Financial Protection</rdfs:label>
        <skos:altLabel xml:lang="en">Financial Risk Protection</skos:altLabel>
        <skos:definition xml:lang="en">The degree to which a financing system shields individuals from healthcare cost burden, covering both service breadth and protection depth.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cost Burden Shielding</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Financial Protection</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/affordability"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/insurance-value"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/catastrophic-health-expenditure"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/impoverishment"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/financial-protection"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-901817402365</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health Insurance: wiki topic Health financing and insurance sits in Health Systems; placed under Health Insurance, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/financial-protection"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/universal-health-coverage"/>
        <dcterms:identifier>HEO-L-f1c02e50f4ec</dcterms:identifier>
