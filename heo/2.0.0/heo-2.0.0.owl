    <!-- https://healtheconomics.wiki/concept/technology-driven-cost-growth -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/technology-driven-cost-growth">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/healthcare-cost-growth"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/healthcare-cost-growth"/>
        <skos:notation>HE-EE-CA-081</skos:notation>
        <dcterms:identifier>HE-EE-CA-081</dcterms:identifier>
        <dcterms:source>Newhouse 1992</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Technology-Driven Cost Growth</rdfs:label>
        <skos:definition xml:lang="en">The portion of rising healthcare expenditure attributable to the development and spread of new medical technologies, rather than population change or inflation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Innovation-Driven Spending</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Technology Cost Driver</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Technology-Driven Cost Growth</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/technology-driven-cost-growth"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/healthcare-cost-growth"/>
        <dcterms:identifier>HEO-L-4368ce3f166e</dcterms:identifier>
        <linkRationale xml:lang="en">Technology-driven growth is one component of healthcare cost growth.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
