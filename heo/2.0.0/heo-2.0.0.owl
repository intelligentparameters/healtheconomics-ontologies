    <!-- https://healtheconomics.wiki/concept/administrative-waste -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/administrative-waste">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
