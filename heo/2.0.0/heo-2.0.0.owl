        <rdfs:label xml:lang="en">Case Complexity</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Case Complexity is how demanding a patient&apos;s case is to treat, given comorbidity, illness severity and social circumstances, which drive its resource use.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Case Difficulty</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Clinical Complexity</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Case Complexity</skos:prefLabel>
