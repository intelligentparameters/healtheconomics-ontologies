    <!-- https://healtheconomics.wiki/concept/minimal-residual-disease -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/minimal-residual-disease">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/biomarker"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q6865356"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/biomarker"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/treatment-response"/>
        <skos:notation>HE-ES-CO-043</skos:notation>
        <dcterms:identifier>HE-ES-CO-043</dcterms:identifier>
        <dcterms:source>Campana 2010</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Minimal Residual Disease</rdfs:label>
        <skos:altLabel xml:lang="en">MRD</skos:altLabel>
        <skos:definition xml:lang="en">The small amount of disease still detectable using highly sensitive techniques after treatment appears, by less sensitive measures, to have achieved complete response.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Molecular Residual Disease</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Minimal Residual Disease</skos:prefLabel>
        <abbreviation xml:lang="en">MRD</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/outcomes#step-1"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/minimal-residual-disease"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/biomarker"/>
        <dcterms:identifier>HEO-L-9c39b92491c4</dcterms:identifier>
        <linkRationale xml:lang="en">MRD status is used as a biomarker of response and prognosis (FDA 2020 MRD guidance)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
