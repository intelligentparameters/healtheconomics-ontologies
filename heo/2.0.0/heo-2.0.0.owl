    <!-- https://healtheconomics.wiki/concept/comorbidity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/comorbidity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1414874"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <riskFactorFor rdf:resource="https://healtheconomics.wiki/concept/mortality"/>
        <skos:notation>HS-HP-PHO-003</skos:notation>
        <dcterms:identifier>HS-HP-PHO-003</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-09</dcterms:modified>
        <dcterms:source>Valderas et al. 2009</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Comorbidity</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Co-Morbidity</skos:altLabel>
        <skos:altLabel xml:lang="en">Coexisting Condition</skos:altLabel>
        <skos:definition xml:lang="en">Comorbidity is any other condition a patient has alongside the index disease under study; in health economics it shifts costs, utilities and survival.</skos:definition>
        <skos:prefLabel xml:lang="en">Comorbidity</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/multimorbidity"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/case-complexity"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/disease-burden"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/comorbidity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-889f7f5d7828</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Population Health Outcomes: burden, comorbidity and multimorbidity are epidemiology; most concepts with this Level 3 that the wiki places in a topic sit in Evidence Synthesis</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/comorbidity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#riskFactorFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/mortality"/>
        <dcterms:identifier>HEO-L-8377baa9f35e</dcterms:identifier>
        <skos:editorialNote xml:lang="en">suggested source, not yet checked: Charlson et al. 1987</skos:editorialNote>
        <linkRationale xml:lang="en">Comorbidity burden predicts mortality (basis of the Charlson index)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/comorbidity"/>
