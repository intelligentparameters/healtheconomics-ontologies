    <!-- https://healtheconomics.wiki/concept/multimorbidity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/multimorbidity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1952420"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <riskFactorFor rdf:resource="https://healtheconomics.wiki/concept/polypharmacy"/>
        <skos:notation>HS-HP-PHO-016</skos:notation>
        <dcterms:identifier>HS-HP-PHO-016</dcterms:identifier>
        <dcterms:source>Valderas et al. 2009</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Multimorbidity</rdfs:label>
        <skos:altLabel xml:lang="en">Multiple Morbidity</skos:altLabel>
        <skos:definition xml:lang="en">The co-occurrence of two or more chronic conditions in the same individual, without designating any single condition as the primary focus.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Co-occurring Conditions</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Multimorbidity</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/case-complexity"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/disease-burden"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/multimorbidity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
