        <dcterms:source>Patient Self-Determination Act 1990</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Treatment Limitation</rdfs:label>
        <skos:definition xml:lang="en">A documented decision restricting the scope or intensity of treatment a patient will receive, reflecting their own or a surrogate&apos;s preferences.</skos:definition>
