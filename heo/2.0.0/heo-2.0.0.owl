        <skos:altLabel xml:lang="en">PRO</skos:altLabel>
        <skos:definition xml:lang="en">Any report of a patient&apos;s health status that comes directly from the patient without clinical interpretation, from symptom ratings to full quality of life instruments.</skos:definition>
