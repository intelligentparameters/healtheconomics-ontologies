    <!-- https://healtheconomics.wiki/concept/compassionate-use -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/compassionate-use">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-development"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/drug-development"/>
        <skos:notation>HS-DC-MA-002</skos:notation>
        <dcterms:identifier>HS-DC-MA-002</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-09</dcterms:modified>
        <dcterms:source>EMA 2007 (CHMP guideline EMEA/27170/2006)</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Compassionate Use</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Compassionate use is the supply of an unauthorised medicine, outside a trial, to patients with a serious disease and no satisfactory authorised treatment.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Emergency Treatment Access</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Investigational Access</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Compassionate Use</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/clinical-trial"/>
        <counterpartOf rdf:resource="https://healtheconomics.wiki/concept/early-access-scheme"/>
        <counterpartOf rdf:resource="https://healtheconomics.wiki/concept/expanded-access"/>
        <counterpartOf rdf:resource="https://healtheconomics.wiki/concept/special-access-scheme"/>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/access-to-care"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/compassionate-use"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-development"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-9f883b4f09b0</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: curated: review B: unlicensed supply is a regulatory access route (Drug development and regulation)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
