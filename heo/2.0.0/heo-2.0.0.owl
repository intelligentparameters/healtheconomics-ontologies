    <!-- https://healtheconomics.wiki/concept/impoverishment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/impoverishment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/poverty"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/poverty"/>
        <skos:notation>HS-HP-HI-101</skos:notation>
        <dcterms:identifier>HS-HP-HI-101</dcterms:identifier>
        <dcterms:source>Xu et al. 2003</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Impoverishment</rdfs:label>
        <skos:definition xml:lang="en">A state where household income or consumption falls below an established poverty line, which out-of-pocket healthcare spending can cause or worsen.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Medical Poverty</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Poverty from Health Costs</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Impoverishment</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/impoverishment"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/poverty"/>
        <dcterms:identifier>HEO-L-a86c7b86ffca</dcterms:identifier>
        <linkRationale xml:lang="en">Impoverishment is a household falling below a poverty line (subject definition); Poverty is the broader state</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/imprecision -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/imprecision">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/grade"/>
        <skos:notation>HE-DS-BV-013</skos:notation>
        <dcterms:identifier>HE-DS-BV-013</dcterms:identifier>
        <dcterms:source>Guyatt GH, Oxman AD, Vist GE, et al. GRADE: an emerging consensus on rating quality of evidence and strength of recommendations. BMJ. 2008;336:924-926. doi:10.1136/bmj.39489.470347.AD.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Imprecision</rdfs:label>
        <skos:definition xml:lang="en">A GRADE evidence quality domain assessing whether a study&apos;s confidence intervals are narrow enough to support a confident conclusion about the true effect.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Effect Estimate Uncertainty</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Wide Confidence Interval</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Imprecision</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/confidence-interval"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/precision-assessment"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/imprecision"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
