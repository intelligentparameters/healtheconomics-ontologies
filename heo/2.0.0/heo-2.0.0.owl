        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/study-selection"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-3c5bb60def34</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Evidence Synthesis Methods: catalogue subdomain Evidence Synthesis is one of the subdomains</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/study-selection"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/systematic-review"/>
        <dcterms:identifier>HEO-L-ac13b2303cc4</dcterms:identifier>
        <linkRationale xml:lang="en">Applying inclusion criteria is a stage of a systematic review (both definitions)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/study-selection"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#precedes"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/data-extraction"/>
        <dcterms:identifier>HEO-L-41522c4369ba</dcterms:identifier>
