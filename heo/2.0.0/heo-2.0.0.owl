        <skos:altLabel xml:lang="en">CHE</skos:altLabel>
        <skos:altLabel xml:lang="en">Catastrophic Spending</skos:altLabel>
        <skos:definition xml:lang="en">Catastrophic health expenditure (CHE) is out-of-pocket health spending that exceeds a set share of a household&apos;s total budget or its capacity to pay.</skos:definition>
        <skos:prefLabel xml:lang="en">Catastrophic Health Expenditure</skos:prefLabel>
        <abbreviation xml:lang="en">CHE</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/impoverishing-health-expenditure"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/asset-sale"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/borrowing-for-health"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/coping-strategy"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/reduced-consumption"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/catastrophic-health-expenditure"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/out-of-pocket-payment"/>
        <dcterms:identifier>HEO-L-e95f21dc171e</dcterms:identifier>
        <linkRationale xml:lang="en">CHE is household out-of-pocket spending above a threshold, not total population health spending</linkRationale>
