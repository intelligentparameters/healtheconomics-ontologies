        <skos:hiddenLabel xml:lang="en">Volume Concession</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Rebate</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
