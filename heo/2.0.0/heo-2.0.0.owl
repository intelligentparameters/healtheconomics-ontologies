    <!-- https://healtheconomics.wiki/concept/dynamic-transmission-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/dynamic-transmission-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/transmission-model"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/transmission-model"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/vaccination-externalities"/>
        <skos:notation>HE-EM-DM-027</skos:notation>
        <dcterms:identifier>HE-EM-DM-027</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-21</dcterms:modified>
        <dcterms:source>Kermack &amp; McKendrick 1927</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Dynamic Transmission Model</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">DTM</skos:altLabel>
        <skos:definition xml:lang="en">A dynamic transmission model represents how an infectious disease spreads through a population while the risk of infection changes with the number and characteristics of infectious people.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Dynamic Infection Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Dynamic Transmission Model</skos:prefLabel>
        <abbreviation xml:lang="en">DTM</abbreviation>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-8"/>
        <represents rdf:resource="https://healtheconomics.wiki/concept/herd-immunity"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/basic-reproduction-number"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/compartmental-model"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/contact-rate"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/finite-difference-method"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/runge-kutta-method"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/dynamic-transmission-model"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/transmission-model"/>
        <dcterms:identifier>HEO-L-d8b7353f89ae</dcterms:identifier>
        <linkRationale xml:lang="en">a dynamic transmission model is a transmission model</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/dynamic-transmission-model"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/vaccination-externalities"/>
        <dcterms:identifier>HEO-L-664a0b96070f</dcterms:identifier>
        <linkRationale xml:lang="en">Only dynamic models capture indirect protection of others, the quantity that is the vaccination externality</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
