    <!-- https://healtheconomics.wiki/concept/cohort-simulation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cohort-simulation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/simulation-method"/>
