    <!-- https://healtheconomics.wiki/concept/bias -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/bias">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-DS-BV-004</skos:notation>
        <dcterms:identifier>HE-DS-BV-004</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Boutron et al. 2022</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Bias</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Bias is systematic error that pushes a treatment effect or cost estimate in economic evaluation away from the true value; larger samples do not remove it.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Non-Random Error</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Systematic Deviation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Bias</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/random-error"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/unbiasedness"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/effect-estimate"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/bias"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-e98fabc4cc10</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Bias &amp; Validity: catalogue subdomain Evidence Synthesis is one of the subdomains</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
