        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/budget-allocation"/>
        <dcterms:identifier>HEO-L-52c6416711f5</dcterms:identifier>
        <linkRationale xml:lang="en">Incremental budgeting applies to capital or operating budgets; it is an allocation method, like zero-based budgeting.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
