    <!-- https://healtheconomics.wiki/concept/progressive-disease -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/progressive-disease">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/tumour-response"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1951525"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/tumour-response"/>
        <skos:notation>HE-PE-OO-019</skos:notation>
        <dcterms:identifier>HE-PE-OO-019</dcterms:identifier>
        <dcterms:source>Eisenhauer et al. 2009</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Progressive Disease</rdfs:label>
        <skos:definition xml:lang="en">A standardised tumour response classification indicating a significant, predefined increase in target lesion size, or the appearance of new lesions.</skos:definition>
        <skos:hiddenLabel xml:lang="en">RECIST Progression</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Radiological Progression</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Progressive Disease</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/stable-disease"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/progression-free-survival"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/progressive-disease"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/tumour-response"/>
        <dcterms:identifier>HEO-L-fe811edc3baf</dcterms:identifier>
        <linkRationale xml:lang="en">Progressive disease is a tumour response category.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
