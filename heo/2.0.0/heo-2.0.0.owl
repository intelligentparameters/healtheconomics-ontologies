        <dcterms:identifier>HE-PE-DD-073</dcterms:identifier>
        <dcterms:source>DiMasi JA, Grabowski HG, Hansen RW. Innovation in the pharmaceutical industry: new estimates of R&amp;D costs. Journal of Health Economics. 2016;47:20-33. doi:10.1016/j.jhealeco.2016.01.012.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Target Validation</rdfs:label>
        <skos:definition xml:lang="en">A drug discovery stage gathering evidence that modulating a specific biological target actually produces the desired effect, before committing to full development.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Preclinical Target Confirmation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Target Confirmation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Target Validation</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/attrition-rate"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
