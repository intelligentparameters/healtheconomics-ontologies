        <reduces rdf:resource="https://healtheconomics.wiki/concept/adverse-drug-reaction"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/polypharmacy"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/potentially-inappropriate-medication"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/deprescribing"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
