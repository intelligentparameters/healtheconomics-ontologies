    <!-- https://healtheconomics.wiki/concept/global-sensitivity-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/global-sensitivity-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/sensitivity-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/sensitivity-analysis"/>
        <skos:notation>HE-EM-UA-030</skos:notation>
        <dcterms:identifier>HE-EM-UA-030</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-23</dcterms:modified>
        <dcterms:source>Saltelli et al. 2008</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Global Sensitivity Analysis</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">GSA</skos:altLabel>
        <skos:definition xml:lang="en">Global sensitivity analysis, or GSA, evaluates how uncertainty in model inputs contributes to variation in model outputs when inputs vary across their full specified ranges or distributions.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Simultaneous Sensitivity Analysis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Global Sensitivity Analysis</skos:prefLabel>
        <abbreviation xml:lang="en">GSA</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/one-way-sensitivity-analysis"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-10"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/sobol-indices"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/elementary-effect"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/monte-carlo-simulation"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/partial-correlation"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/global-sensitivity-analysis"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/sensitivity-analysis"/>
        <dcterms:identifier>HEO-L-a10011a120e5</dcterms:identifier>
        <linkRationale xml:lang="en">GSA is sensitivity analysis</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/global-sensitivity-analysis"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/one-way-sensitivity-analysis"/>
        <dcterms:identifier>HEO-L-bc78e13b2df0</dcterms:identifier>
