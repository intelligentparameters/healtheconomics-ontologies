    <!-- https://healtheconomics.wiki/concept/value-communication -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/value-communication">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/market-access"/>
        <skos:notation>HS-NHS-VBH-019</skos:notation>
        <dcterms:identifier>HS-NHS-VBH-019</dcterms:identifier>
        <dcterms:source>ISPOR, Global Health Technology Assessment Roadmap</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Value Communication</rdfs:label>
        <skos:altLabel xml:lang="en">Value Messaging</skos:altLabel>
        <skos:definition xml:lang="en">The process of clearly and accurately conveying a technology&apos;s demonstrated value to clinicians, patients, and payers, grounded in the underlying evidence.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Value Storytelling</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Value Communication</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/value-dossier"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/value-proposition"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/value-story"/>
    </owl:NamedIndividual>
    <owl:Axiom>
