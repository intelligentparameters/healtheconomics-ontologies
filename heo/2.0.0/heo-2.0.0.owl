        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Payback</skos:altLabel>
        <skos:definition xml:lang="en">Clawback is a payment that medicine manufacturers return to a payer when total public spending on medicines exceeds an agreed cap.</skos:definition>
