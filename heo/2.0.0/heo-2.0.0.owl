    <!-- https://healtheconomics.wiki/concept/partnership-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/partnership-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-system-organization"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-system-organization"/>
        <skos:notation>HS-SS_HSM-013</skos:notation>
        <dcterms:identifier>HS-SS_HSM-013</dcterms:identifier>
        <dcterms:source>WHO, Health Financing for Universal Coverage</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Partnership Model</rdfs:label>
        <skos:definition xml:lang="en">A financing or delivery arrangement where multiple stakeholders, such as government and civil society, collaborate to jointly deliver a health programme.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Collaborative Model</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Joint-Working Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Partnership Model</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
