        <dcterms:identifier>HE-EM-VI-034</dcterms:identifier>
        <dcterms:source>Cooke 1991</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Target Question</rdfs:label>
        <skos:definition xml:lang="en">A question of genuine interest to a decision-maker with an unknown true answer, posed to experts in structured elicitation, unlike a calibration seed question.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Structured Review Question</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Target Question</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/seed-question"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
