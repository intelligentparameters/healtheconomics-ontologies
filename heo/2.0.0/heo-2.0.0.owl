        <dcterms:identifier>HS-DC-HC-002</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Emergency Care Cost</rdfs:label>
        <skos:definition xml:lang="en">The expense of treatment provided in an emergency department or urgent care setting, typically higher per visit than equivalent primary care.</skos:definition>
