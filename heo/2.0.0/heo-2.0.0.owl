    <!-- https://healtheconomics.wiki/concept/eligibility-design -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/eligibility-design">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:notation>HS-HP-HI-071</skos:notation>
        <dcterms:identifier>HS-HP-HI-071</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Eligibility Design</rdfs:label>
        <skos:altLabel xml:lang="en">Entitlement Definition</skos:altLabel>
        <skos:definition xml:lang="en">The specific criteria an insurance plan or public programme establishes to determine who qualifies for coverage, such as income or age.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Benefit Entitlement</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Eligibility Criteria Design</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Qualification Rules</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Right-to-Benefit Criteria</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Eligibility Design</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/beneficiary"/>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/population-coverage"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/eligibility-design"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
