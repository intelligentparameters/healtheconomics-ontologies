        <dcterms:identifier>HEO-L-6f9608aca782</dcterms:identifier>
        <linkRationale xml:lang="en">A run-in is a pre-randomisation phase of a randomised trial (subject definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
