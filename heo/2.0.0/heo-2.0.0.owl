    <!-- https://healtheconomics.wiki/concept/kalman-filter -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/kalman-filter">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q846780"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:notation>HE-EM-MP-021</skos:notation>
        <dcterms:identifier>HE-EM-MP-021</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-24</dcterms:modified>
        <dcterms:source>Kalman 1960</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Kalman Filter</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A recursive estimator that predicts an evolving latent state and updates that estimate and its uncertainty when a new noisy measurement arrives.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Recursive State Filter</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">State Estimator</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Kalman Filter</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/particle-filter"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-4"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/bayes-theorem"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/state-space-model"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/kalman-filter"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <dcterms:identifier>HEO-L-dbc1bd66d1d1</dcterms:identifier>
        <linkRationale xml:lang="en">A recursive estimator</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/kalman-filter"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/particle-filter"/>
        <dcterms:identifier>HEO-L-2c0a35f63148</dcterms:identifier>
        <linkRationale xml:lang="en">Alternative state filters</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
