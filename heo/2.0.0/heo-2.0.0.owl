        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/anatomical-therapeutic-chemical"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/claims-database"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/pharmacy-data"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/pharmacoepidemiology"/>
