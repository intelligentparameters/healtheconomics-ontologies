        <uses rdf:resource="https://healtheconomics.wiki/concept/best-case-scenario"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/sensitivity-analysis"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/value-of-information"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/uncertainty-assessment"/>
