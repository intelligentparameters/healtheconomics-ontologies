        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/years-of-life-lost"/>
        <skos:notation>HE-EE-DC-001</skos:notation>
        <dcterms:identifier>HE-EE-DC-001</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-03</dcterms:modified>
