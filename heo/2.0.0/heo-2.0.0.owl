        <skos:altLabel xml:lang="en">Second-Line Treatment</skos:altLabel>
        <skos:definition xml:lang="en">A treatment used after a patient&apos;s first-line treatment has failed to control disease adequately or has been discontinued due to intolerance.</skos:definition>
