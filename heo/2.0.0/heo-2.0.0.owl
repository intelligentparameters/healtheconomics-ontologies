    <!-- https://healtheconomics.wiki/concept/club-goods -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/club-goods">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-good"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/economic-good"/>
        <skos:notation>HE-EE-CRE-001</skos:notation>
        <dcterms:identifier>HE-EE-CRE-001</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-09</dcterms:modified>
