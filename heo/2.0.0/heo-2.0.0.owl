    <!-- https://healtheconomics.wiki/concept/competing-events -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/competing-events">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/discrete-event-simulation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/discrete-event-simulation"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/discrete-event-simulation"/>
        <skos:notation>HE-EM-DES-003</skos:notation>
        <dcterms:identifier>HE-EM-DES-003</dcterms:identifier>
        <dcterms:source>Law &amp; Kelton 2000</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Competing Events</rdfs:label>
        <skos:altLabel xml:lang="en">Competing Event</skos:altLabel>
        <skos:definition xml:lang="en">A situation in a simulation model where several distinct events could occur next for an entity, requiring the model to determine which happens first.</skos:definition>
        <skos:prefLabel xml:lang="en">Competing Events</skos:prefLabel>
        <counterpartOf rdf:resource="https://healtheconomics.wiki/concept/competing-risks"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/competing-events"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/discrete-event-simulation"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-905c01e5c1fc</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Modelling &gt; Discrete Event Simulation: catalogue subdomain Economic Modelling is one of the subdomains; placed under Discrete Event Simulation, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/competing-events"/>
