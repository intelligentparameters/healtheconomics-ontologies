        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/reimbursement"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/coverage-policy"/>
