        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Drug Evaluation Committee</rdfs:label>
        <skos:altLabel xml:lang="en">DEC</skos:altLabel>
        <skos:definition xml:lang="en">A formally constituted expert body responsible for reviewing evidence for a pharmaceutical product and recommending its reimbursement or formulary inclusion.</skos:definition>
