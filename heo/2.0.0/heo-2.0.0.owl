    <!-- https://healtheconomics.wiki/concept/hosmer-lemeshow-test -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/hosmer-lemeshow-test">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/goodness-of-fit-test"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q5908162"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/goodness-of-fit-test"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/goodness-of-fit"/>
        <skos:notation>HE-ES-SA-079</skos:notation>
        <dcterms:identifier>HE-ES-SA-079</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-23</dcterms:modified>
        <dcterms:source>Hosmer &amp; Lemeshow 1980</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Hosmer-Lemeshow Test</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">H-L Test</skos:altLabel>
        <skos:altLabel xml:lang="en">Hosmer-Lemeshow Statistic</skos:altLabel>
        <skos:definition xml:lang="en">A goodness of fit test assessing how well a logistic regression model&apos;s predicted probabilities match observed outcome frequencies across risk groups.</skos:definition>
        <skos:prefLabel xml:lang="en">Hosmer-Lemeshow Test</skos:prefLabel>
        <abbreviation xml:lang="en">H-L Test</abbreviation>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/logistic-regression"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/hosmer-lemeshow-test"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/goodness-of-fit-test"/>
        <dcterms:identifier>HEO-L-91507c092616</dcterms:identifier>
        <linkRationale xml:lang="en">A goodness of fit test.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/hosmer-lemeshow-test"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
