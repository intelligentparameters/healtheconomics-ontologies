    <!-- https://healtheconomics.wiki/concept/ordinal-scaling -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/ordinal-scaling">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/measurement-scale-type"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/measurement-scale-type"/>
        <skos:notation>HE-EE-HU-054</skos:notation>
        <dcterms:identifier>HE-EE-HU-054</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Torrance GW. Measurement of health state utilities for economic appraisal. Journal of Health Economics. 1986;5(1):1?30. doi:10.1016/0167-6296(86)90020-2.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Ordinal Scaling</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A measurement scale property in which values can be ranked but numerical differences do not necessarily reflect equal differences in the underlying quantity.</skos:definition>
