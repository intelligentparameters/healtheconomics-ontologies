    <!-- https://healtheconomics.wiki/concept/drg-creep -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/drg-creep">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <skos:notation>HS-HP-PP-044</skos:notation>
        <dcterms:identifier>HS-HP-PP-044</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-03</dcterms:modified>
        <dcterms:source>Carter et al. 1990</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">DRG Creep</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">DRG Upcoding</skos:altLabel>
        <skos:definition xml:lang="en">DRG creep is a rise in recorded hospital case mix, and so in DRG payments, that comes from coding changes rather than from sicker or more complex patients.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Code Creep</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">DRG Creep</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/health-spending"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/case-mix-index"/>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/drg-assignment"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/drg-creep"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-0d3d489cdf79</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Provider payment in subdomain Health Systems; placed under Provider Payment, the concept named by its wiki topic</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/drg-creep"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-spending"/>
        <dcterms:identifier>HEO-L-bf805bd4956f</dcterms:identifier>
        <linkRationale xml:lang="en">coding-driven case mix rises increase DRG payments and spending</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
