    <!-- https://healtheconomics.wiki/concept/secondary-care -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/secondary-care">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q70447305"/>
