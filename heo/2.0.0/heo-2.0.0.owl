    <!-- https://healtheconomics.wiki/concept/debt-ratio -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/debt-ratio">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
