    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/vertical-inequity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/vertical-inequity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-inequity"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-inequity"/>
        <skos:notation>HE-EE-HE-019</skos:notation>
        <dcterms:identifier>HE-EE-HE-019</dcterms:identifier>
        <dcterms:source>Wagstaff &amp; van Doorslaer 2000</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Vertical Inequity</rdfs:label>
        <skos:altLabel xml:lang="en">Vertical Health Inequity</skos:altLabel>
        <skos:definition xml:lang="en">A violation of the principle that individuals with unequal healthcare needs should be treated appropriately differently, in proportion to their greater need.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Vertical Unfairness</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Vertical Inequity</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/vertical-inequity"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-inequity"/>
        <dcterms:identifier>HEO-L-7b7bea6fdc05</dcterms:identifier>
        <linkRationale xml:lang="en">Vertical inequity is an unfair difference, not a neutral inequality; matches Horizontal Inequity isTypeOf Health Inequity.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/vertically-integrated -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/vertically-integrated">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/integrated-care"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/integrated-care"/>
        <skos:notation>HS-HP-IC-037</skos:notation>
        <dcterms:identifier>HS-HP-IC-037</dcterms:identifier>
        <dcterms:source>Kongstvedt 2012</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Vertically Integrated</rdfs:label>
        <skos:definition xml:lang="en">A structure in which organisations providing different care levels, such as hospitals and insurers, combine under common ownership.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Integrated Delivery</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Vertical Integration</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Vertically Integrated</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/care-coordination"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/integrated-delivery-network"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/vertically-integrated"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/integrated-care"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-88e5db8f3bf9</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Integrated Care: organisation and delivery of care is the Health Systems subdomain (Organisation and governance); placed under Integrated Care, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/vertically-integrated"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/care-coordination"/>
        <dcterms:identifier>HEO-L-58bd64be230f</dcterms:identifier>
        <linkRationale xml:lang="en">Common ownership helps coordinate care.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/vertically-integrated"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isPropertyOf"/>
