        <skos:notation>HE-EE-CEA-049</skos:notation>
        <dcterms:identifier>HE-EE-CEA-049</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Pairwise Comparison</rdfs:label>
        <skos:definition xml:lang="en">A comparison of exactly two interventions at a time, used as a building block within a fully incremental analysis of several options.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Direct Head-to-Head</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Two-Arm Comparison</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Pairwise Comparison</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-3"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/icer"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
