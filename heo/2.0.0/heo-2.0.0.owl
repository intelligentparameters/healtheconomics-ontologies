        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/quality-of-evidence"/>
        <dcterms:identifier>HEO-L-fb73bc985b9e</dcterms:identifier>
        <linkRationale xml:lang="en">Very low is a GRADE quality-of-evidence level.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
