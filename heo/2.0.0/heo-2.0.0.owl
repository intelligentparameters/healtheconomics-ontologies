    <!-- https://healtheconomics.wiki/concept/skill-mix -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/skill-mix">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
