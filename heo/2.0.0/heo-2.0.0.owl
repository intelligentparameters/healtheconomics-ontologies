    <!-- https://healtheconomics.wiki/concept/node-splitting -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/node-splitting">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-ES-ESM-042</skos:notation>
        <dcterms:identifier>HE-ES-ESM-042</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Dias, Welton, Caldwell &amp; Ades 2010</dcterms:source>
