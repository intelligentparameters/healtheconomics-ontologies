        <skos:notation>HS-HP-HTA-227</skos:notation>
        <dcterms:identifier>HS-HP-HTA-227</dcterms:identifier>
        <dcterms:source>National Institute for Health and Care Excellence. NICE technology appraisal and highly specialised technologies guidance: the manual (PMG36). Published 2022; updated 2026.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Treatment Pathway</rdfs:label>
        <skos:definition xml:lang="en">The typical sequence of treatments and clinical decisions a patient with a specific condition experiences, from diagnosis through subsequent therapy lines.</skos:definition>
        <skos:prefLabel xml:lang="en">Treatment Pathway</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-pathway"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/care-pathway"/>
        <dcterms:identifier>HEO-L-9d150346310f</dcterms:identifier>
        <linkRationale xml:lang="en">A treatment pathway is the treatment part of a care pathway.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/treatment-preference -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/treatment-preference">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/patient-preference"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/patient-preference"/>
        <skos:notation>HE-ES-CO-092</skos:notation>
        <dcterms:identifier>HE-ES-CO-092</dcterms:identifier>
        <dcterms:source>Louviere, Hensher &amp; Swait 2000</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Treatment Preference</rdfs:label>
        <skos:definition xml:lang="en">A patient&apos;s or clinician&apos;s relative preference among treatment options, typically elicited using stated preference methods such as a discrete choice experiment.</skos:definition>
        <skos:prefLabel xml:lang="en">Treatment Preference</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-preference"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/patient-preference"/>
        <dcterms:identifier>HEO-L-e53a89dcfc6c</dcterms:identifier>
        <linkRationale xml:lang="en">Treatment preference is mainly a patient relative valuation of treatment options.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/treatment-protocol -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/treatment-protocol">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-PE-DT-058</skos:notation>
        <dcterms:identifier>HE-PE-DT-058</dcterms:identifier>
        <dcterms:source>Friedman LM, Furberg CD, DeMets DL, Reboussin DM, Granger CB. Fundamentals of Clinical Trials. 5th ed. Springer; 2015. doi:10.1007/978-3-319-18539-2.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Treatment Protocol</rdfs:label>
        <skos:definition xml:lang="en">A formal, standardised plan specifying the exact treatments, doses, and schedule for managing a specific condition.</skos:definition>
        <skos:prefLabel xml:lang="en">Treatment Protocol</skos:prefLabel>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/care-standardization"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/clinical-practice-variation"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-protocol"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-3c9f59bac6a5</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Pharmacoeconomics &gt; Drug Therapy: dosing and treatment-line terms describe the clinical evidence and treatment pathways that models use</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-protocol"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#promotes"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/care-standardization"/>
        <dcterms:identifier>HEO-L-c802aa5450d7</dcterms:identifier>
        <linkRationale xml:lang="en">A protocol is not a systematic-review-based guideline; it fixes treatments and doses so care is applied uniformly.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-protocol"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/clinical-practice-variation"/>
        <dcterms:identifier>HEO-L-c3c9c7e3ff51</dcterms:identifier>
        <linkRationale xml:lang="en">Local protocols translate guidelines and standardise care, cutting variation.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/treatment-ranking -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/treatment-ranking">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-ES-ESM-063</skos:notation>
        <dcterms:identifier>HE-ES-ESM-063</dcterms:identifier>
        <dcterms:source>Salanti, Ades &amp; Ioannidis 2011</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Treatment Ranking</rdfs:label>
        <skos:definition xml:lang="en">The ordering of treatments in a network meta-analysis by estimated relative effectiveness, often summarised using measures such as SUCRA or P-scores.</skos:definition>
        <skos:prefLabel xml:lang="en">Treatment Ranking</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/treatment-selection"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-ranking"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-a50a96b9e754</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Evidence Synthesis Methods: catalogue subdomain Evidence Synthesis is one of the subdomains</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-ranking"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/treatment-selection"/>
        <dcterms:identifier>HEO-L-64ac4068f8c0</dcterms:identifier>
        <linkRationale xml:lang="en">Treatment selection is informed by comparative evidence (object definition); rankings summarise NMA comparative effectiveness</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/treatment-response -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/treatment-response">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/treatment-success"/>
        <skos:notation>HE-ES-CO-093</skos:notation>
        <dcterms:identifier>HE-ES-CO-093</dcterms:identifier>
        <dcterms:source>U.S. Food and Drug Administration. Guidance for Industry: Patient-Reported Outcome Measures-Use in Medical Product Development to Support Labeling Claims. FDA; 2009.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Treatment Response</rdfs:label>
        <skos:altLabel xml:lang="en">Therapeutic Response</skos:altLabel>
        <skos:definition xml:lang="en">A general term for the degree to which a patient&apos;s condition improves following treatment, assessed using disease-specific clinical and patient-reported criteria.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Symptomatic Improvement</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Treatment Response</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/response-based-payment"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-response"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome"/>
        <dcterms:identifier>HEO-L-26d3b2fdc3ce</dcterms:identifier>
        <linkRationale xml:lang="en">Treatment response is a clinical outcome.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-response"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/treatment-success"/>
        <dcterms:identifier>HEO-L-7d7b8c0f72f6</dcterms:identifier>
        <linkRationale xml:lang="en">Clinical response is one of the criteria combined in treatment success, per the object definition</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/treatment-response"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/response-based-payment"/>
