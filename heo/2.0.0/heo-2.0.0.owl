    <!-- https://healtheconomics.wiki/concept/healthcare-system-cost -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/healthcare-system-cost">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
