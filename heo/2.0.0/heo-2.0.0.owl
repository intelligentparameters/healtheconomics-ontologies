    <!-- https://healtheconomics.wiki/concept/system-dynamics-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/system-dynamics-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/continuous-model"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/simulation-model"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/continuous-model"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/simulation-model"/>
        <skos:notation>HE-EM-DM-101</skos:notation>
        <dcterms:identifier>HE-EM-DM-101</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Sterman 2000</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">System Dynamics Model</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">SD Model</skos:altLabel>
        <skos:altLabel xml:lang="en">System Dynamics Simulation</skos:altLabel>
        <skos:definition xml:lang="en">A modelling approach representing a complex system using stocks, flows, and feedback loops to capture how it evolves through internal dynamics.</skos:definition>
        <skos:prefLabel xml:lang="en">System Dynamics Model</skos:prefLabel>
        <abbreviation xml:lang="en">SD Model</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-8"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/causal-loop-diagram"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/stock-and-flow-model"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/system-dynamics-model"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/continuous-model"/>
        <dcterms:identifier>HEO-L-d81e3c25659f</dcterms:identifier>
        <linkRationale xml:lang="en">System dynamics models run in continuous time using rates of flow.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/system-dynamics-model"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
