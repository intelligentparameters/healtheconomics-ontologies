    <!-- https://healtheconomics.wiki/concept/payback-period -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/payback-period">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-benefit-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/cost-benefit-analysis"/>
        <skos:notation>HE-EE-CBA-040</skos:notation>
        <dcterms:identifier>HE-EE-CBA-040</dcterms:identifier>
        <dcterms:source>Brealey, Myers &amp; Allen 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Payback Period</rdfs:label>
        <skos:definition xml:lang="en">The length of time required for the cumulative cash inflows from an investment to equal its initial cost.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Break-Even Time</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Recoupment Period</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Payback Period</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/return-on-investment"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-5"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
