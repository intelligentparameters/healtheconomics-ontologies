        <skos:altLabel xml:lang="en">FDM</skos:altLabel>
        <skos:definition xml:lang="en">The finite difference method replaces derivatives with algebraic differences between function values at neighbouring grid points.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Difference Quotient Method</skos:hiddenLabel>
