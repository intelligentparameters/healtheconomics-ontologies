        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/outcome-measure"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/patient-centred-outcome"/>
        <skos:notation>HE-ES-CO-033</skos:notation>
        <dcterms:identifier>HE-ES-CO-033</dcterms:identifier>
        <dcterms:source>Kiresuk &amp; Sherman 1968</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Goal Attainment</rdfs:label>
        <skos:definition xml:lang="en">An outcome approach assessing treatment success by how far a patient reaches personally meaningful goals set with their clinician, rather than standardised measures alone.</skos:definition>
        <skos:hiddenLabel xml:lang="en">GAS</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Individualised Goal Scaling</skos:hiddenLabel>
