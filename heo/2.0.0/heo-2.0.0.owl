    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/market-access-strategy"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/market-access"/>
        <dcterms:identifier>HEO-L-821c9071be6d</dcterms:identifier>
