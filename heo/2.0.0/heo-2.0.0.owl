    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/scarcity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/scarcity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-principle"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q815758"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/economic-principle"/>
        <skos:notation>HE-EE-EPR-043</skos:notation>
        <dcterms:identifier>HE-EE-EPR-043</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Robbins 1932</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Scarcity</rdfs:label>
        <owl:versionInfo>1.0.8</owl:versionInfo>
        <skos:definition xml:lang="en">Scarcity is the condition in which health care resources, such as funding, staff and beds, cannot meet every competing need, so choices must be made.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Limited Resources</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Resource Insufficiency</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Scarcity</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/rationing"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/economic-choice"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/opportunity-cost"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/resource-allocation"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/resource"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/scarcity"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-principle"/>
        <dcterms:identifier>HEO-L-28c368210d21</dcterms:identifier>
        <linkRationale xml:lang="en">The economic principle definition names scarcity.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/scarcity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/rationing"/>
        <dcterms:identifier>HEO-L-fcf1b4b0dc36</dcterms:identifier>
        <linkRationale xml:lang="en">Scarcity forces rationing.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/scarcity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isFoundationFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-choice"/>
        <dcterms:identifier>HEO-L-52ee07638df2</dcterms:identifier>
        <linkRationale xml:lang="en">Economic choice is defined as choice under scarcity.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/scarcity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isFoundationFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/opportunity-cost"/>
        <dcterms:identifier>HEO-L-fa89658109c4</dcterms:identifier>
