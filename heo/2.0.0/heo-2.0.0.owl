        <skos:altLabel xml:lang="en">Variance-Based SA</skos:altLabel>
        <skos:definition xml:lang="en">Global sensitivity analysis techniques, including Sobol indices, decomposing total output variance into components attributable to each parameter and their interactions.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Sobol Sensitivity Analysis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Variance-Based Sensitivity</skos:prefLabel>
