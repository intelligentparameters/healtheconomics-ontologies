    <!-- https://healtheconomics.wiki/concept/hybrid-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/hybrid-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-economic-model"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-economic-model"/>
        <skos:notation>HE-EM-DM-043</skos:notation>
        <dcterms:identifier>HE-EM-DM-043</dcterms:identifier>
        <dcterms:source>Briggs A, Claxton K, Sculpher M. Decision Modelling for Health Economic Evaluation. Oxford University Press; 2006. doi:10.1093/oso/9780198526629.001.0001.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Hybrid Model</rdfs:label>
        <skos:altLabel xml:lang="en">Hybrid Decision Model</skos:altLabel>
        <skos:definition xml:lang="en">A decision-analytic model combining two or more approaches, such as a decision tree feeding into a Markov model, to represent a disease process.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Combined Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Hybrid Model</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/decision-tree"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/markov-model"/>
    </owl:NamedIndividual>
