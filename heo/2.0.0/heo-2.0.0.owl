    <!-- https://healtheconomics.wiki/concept/economic-life-years -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/economic-life-years">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
