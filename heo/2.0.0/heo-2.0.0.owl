        <skos:altLabel xml:lang="en">End-Stage Kidney Disease</skos:altLabel>
        <skos:definition xml:lang="en">The most severe stage of chronic kidney disease, where kidney function has declined to require dialysis or transplantation to sustain life.</skos:definition>
        <skos:prefLabel xml:lang="en">End-Stage Renal Disease</skos:prefLabel>
        <abbreviation xml:lang="en">ESRD</abbreviation>
