    <!-- https://healtheconomics.wiki/concept/health-state-definition -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/health-state-definition">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
