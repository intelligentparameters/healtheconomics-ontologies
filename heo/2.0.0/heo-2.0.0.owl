    <!-- https://healtheconomics.wiki/concept/early-awareness -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/early-awareness">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/horizon-scanning"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/horizon-scanning"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/horizon-scanning"/>
        <skos:notation>HS-HP-HS-004</skos:notation>
        <dcterms:identifier>HS-HP-HS-004</dcterms:identifier>
        <dcterms:source>Douw &amp; Vondeling 2006</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Early Awareness</rdfs:label>
        <skos:definition xml:lang="en">The initial identification of a new or emerging technology with significant future implications, before it reaches regulatory approval or wide use.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Early Signal Detection</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Emerging Technology Awareness</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Early Awareness</skos:prefLabel>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/emerging-technology"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/early-awareness"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/horizon-scanning"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-8997748837e2</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Horizon Scanning: horizon scanning is the first stage of an HTA process; placed under Horizon Scanning, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/early-awareness"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
