    <!-- https://healtheconomics.wiki/concept/distress -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/distress">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
