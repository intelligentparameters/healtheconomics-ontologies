    <!-- https://healtheconomics.wiki/concept/property-rights -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/property-rights">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1400881"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <skos:notation>HE-EE-CRE-004</skos:notation>
        <dcterms:identifier>HE-EE-CRE-004</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-03</dcterms:modified>
        <dcterms:source>Alchian 2008</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Property Rights</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Property rights are entitlements to use a resource, exclude others, take its income and transfer it, as with medicine patents or pharmacy contracts.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Legal Property Entitlement</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Ownership Rights</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Property Rights</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/externality"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/property-rights"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-cbd89da8e7a9</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Market failure and information in subdomain Economic Foundations</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/property-rights"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#addresses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/externality"/>
        <dcterms:identifier>HEO-L-af420434d27e</dcterms:identifier>
        <linkRationale xml:lang="en">Assigning property rights is the Coase solution to externalities (Coase 1960); not a part of welfare economics</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/prophylactic-therapy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/prophylactic-therapy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/preventive-therapy"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/preventive-treatment"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/primary-prevention"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/preventive-therapy"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/preventive-treatment"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/primary-prevention"/>
        <skos:notation>HE-PE-DT-034</skos:notation>
        <dcterms:identifier>HE-PE-DT-034</dcterms:identifier>
        <dcterms:source>Katzung 2017</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Prophylactic Therapy</rdfs:label>
        <skos:definition xml:lang="en">Treatment given specifically to prevent a disease or complication before any evidence it has begun to develop, such as pre-surgical antibiotics.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Chemoprevention Regimen</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Preventive Drug Course</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Prophylactic Therapy</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/prophylactic-therapy"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/preventive-therapy"/>
        <dcterms:identifier>HEO-L-9debe4613a7b</dcterms:identifier>
        <linkRationale xml:lang="en">Prophylactic therapy is preventive therapy per both definitions.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
