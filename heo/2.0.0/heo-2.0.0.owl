    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/relative-survival -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/relative-survival">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q7310803"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:notation>HE-EM-SM-069</skos:notation>
        <dcterms:identifier>HE-EM-SM-069</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Ederer, Axtell &amp; Cutler 1961</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Relative Survival</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A survival measure comparing observed survival in a population to expected survival in a comparable general population, without needing cause-of-death data.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Expected-Ratio Survival</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Population-Adjusted Survival</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Relative Survival</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/relative-survival"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-f5e400ca6d0e</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Survival analysis and extrapolation in subdomain Economic Modelling</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    


