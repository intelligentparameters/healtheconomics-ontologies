    <!-- https://healtheconomics.wiki/concept/block-randomization -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/block-randomization">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/randomization"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/randomization"/>
        <precedes rdf:resource="https://healtheconomics.wiki/concept/allocation-concealment"/>
