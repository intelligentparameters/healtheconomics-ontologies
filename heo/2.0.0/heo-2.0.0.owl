    <!-- https://healtheconomics.wiki/concept/patient-responsibility -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/patient-responsibility">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/out-of-pocket-cost"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/out-of-pocket-cost"/>
        <skos:notation>HS-HP-HI-129</skos:notation>
        <dcterms:identifier>HS-HP-HI-129</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Patient Responsibility</rdfs:label>
        <skos:altLabel xml:lang="en">Patient Financial Responsibility</skos:altLabel>
        <skos:definition xml:lang="en">The total amount a patient owes for services after insurance has been applied, covering any deductible, copayment, coinsurance, or non-covered amounts.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Patient Liability</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Patient Responsibility</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/patient-responsibility"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/out-of-pocket-cost"/>
        <dcterms:identifier>HEO-L-c8f132b3b3a1</dcterms:identifier>
        <linkRationale xml:lang="en">Amount owed after insurance, including non-covered care, is out-of-pocket cost</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/patient-safety -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/patient-safety">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
