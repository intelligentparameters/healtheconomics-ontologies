        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/effect-size"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/responsiveness"/>
        <dcterms:identifier>HEO-L-d367bf5243f6</dcterms:identifier>
        <linkRationale xml:lang="en">Responsiveness is commonly quantified with effect-size statistics such as the SRM</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
