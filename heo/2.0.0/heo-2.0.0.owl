    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/model-selection -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/model-selection">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q6888345"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:notation>HE-EM-MV-051</skos:notation>
        <dcterms:identifier>HE-EM-MV-051</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Philips et al. 2004</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Model Selection</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">The process of choosing a model from plausible alternatives using criteria suited to the intended question, data, predictive or explanatory performance, and decision context.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Model Choice</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Specification Search</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Model Selection</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-9"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/overfitting"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/bayesian-information-criterion"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/validation-set"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/model-selection"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <dcterms:identifier>HEO-L-f0ca3772be9b</dcterms:identifier>
        <linkRationale xml:lang="en">Choosing among models with statistical criteria</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/model-selection"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/overfitting"/>
        <dcterms:identifier>HEO-L-973ba8a38716</dcterms:identifier>
