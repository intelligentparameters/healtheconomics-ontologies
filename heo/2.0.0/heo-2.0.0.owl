        <dcterms:identifier>HEO-L-37e3600cb735</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Pharmacy Practice &gt; Pharmaceutical Care &gt; Medication Safety: pharmacy services are part of health care delivery; placed under Medication Safety, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
