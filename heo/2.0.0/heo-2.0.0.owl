    <!-- https://healtheconomics.wiki/concept/reference-pricing -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/reference-pricing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:notation>HS-DC-DP-087</skos:notation>
        <dcterms:identifier>HS-DC-DP-087</dcterms:identifier>
        <dcterms:source>Danzon 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Reference Pricing</rdfs:label>
        <skos:definition xml:lang="en">A pricing policy setting a benchmark price based on prices of similar products or the same product elsewhere, constraining pharmaceutical spending.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Benchmark Pricing</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Comparator-Based Pricing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Reference Pricing</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/price-spillover"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/reference-pricing"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <dcterms:identifier>HEO-L-a242e7032e0c</dcterms:identifier>
        <linkRationale xml:lang="en">Reference pricing is a drug pricing policy.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
