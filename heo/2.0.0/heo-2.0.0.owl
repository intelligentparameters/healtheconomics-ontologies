    <!-- https://healtheconomics.wiki/concept/purchasing-power-parity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/purchasing-power-parity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q82135"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <skos:notation>HE-EE-CA-069</skos:notation>
        <dcterms:identifier>HE-EE-CA-069</dcterms:identifier>
        <dcterms:source>Krugman &amp; Obstfeld 2009</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Purchasing Power Parity</rdfs:label>
        <skos:definition xml:lang="en">A method of comparing economic value across countries based on the relative cost of a common basket of goods and services, rather than exchange rates.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Common-Basket Comparison</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">International Price Comparison</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Purchasing Power Parity</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/purchasing-power-parity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-083799a37dce</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Cost Analysis: cost analysis is costing; most concepts with this Level 3 that the wiki places in a topic sit in Costs</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/qaly -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/qaly">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-adjusted-life-year"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcome-measure"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q614165"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-adjusted-life-year"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/outcome-measure"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/cost-per-qaly"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/icer"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/incremental-cost-utility-ratio"/>
        <skos:notation>HE-EE-QALY-005</skos:notation>
        <dcterms:identifier>HE-EE-QALY-005</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Weinstein MC, Torrance G, McGuire A. QALYs: The Basics. Value Health. 2009;12(Suppl 1):S5–S9. https://doi.org/10.1111/j.1524-4733.2009.00515.x | Sassi F. Calculating QALYs, comparing QALY and DALY calculations. Health Policy Plan. 2006;21(5):402–408. https://doi.org/10.1093/heapol/czl018 | EuroQol Research Foundation. Value sets for scoring EQ-5D. https://euroqol.org/information-and-support/resources/value-sets/ | NICE. Health technology evaluations: the manual. https://www.nice.org.uk/process/pmg36</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Quality-Adjusted Life Year (QALY)</rdfs:label>
        <owl:versionInfo>1.5.4</owl:versionInfo>
        <skos:altLabel xml:lang="en">QALY</skos:altLabel>
        <skos:altLabel xml:lang="en">Quality-Adjusted Life-Year</skos:altLabel>
        <skos:definition xml:lang="en">A quality-adjusted life year (QALY) combines length and quality of life in one measure: a year in full health counts as one QALY and death counts as zero.</skos:definition>
        <skos:prefLabel xml:lang="en">Quality-Adjusted Life Year (QALY)</skos:prefLabel>
        <abbreviation xml:lang="en">QALY</abbreviation>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/outcomes#step-3"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/quality-adjusted-expectancy"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/qaly"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-adjusted-life-year"/>
        <dcterms:identifier>HEO-L-81eddbeb37d2</dcterms:identifier>
        <linkRationale xml:lang="en">The QALY is a health-adjusted life year per definition.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
