    <!-- https://healtheconomics.wiki/concept/care-gap -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/care-gap">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <skos:notation>HS-SS_HQ-002</skos:notation>
        <dcterms:identifier>HS-SS_HQ-002</dcterms:identifier>
        <dcterms:source>Donabedian A. Evaluating the quality of medical care. Milbank Memorial Fund Quarterly. 1966;44(3):166-206. doi:10.2307/3348969.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Care Gap</rdfs:label>
        <skos:definition xml:lang="en">A discrepancy between the care a patient is recommended to receive based on guidelines and the care they actually receive.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Guideline Gap</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Unmet Care Need</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Care Gap</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/guideline-compliance"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/quality-gap"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/care-gap"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
