    <!-- https://healtheconomics.wiki/concept/attribute -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/attribute">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/discrete-choice-experiment"/>
        <skos:notation>HE-EE-CBA-002</skos:notation>
        <dcterms:identifier>HE-EE-CBA-002</dcterms:identifier>
        <dcterms:source>Lancaster 1966</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Attribute</rdfs:label>
        <skos:definition xml:lang="en">A characteristic of a good or service that is varied systematically across profiles in a choice experiment, such as price or waiting time.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Characteristic</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Product Feature</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Attribute</skos:prefLabel>
