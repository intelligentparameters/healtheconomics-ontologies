    <!-- https://healtheconomics.wiki/concept/multiple-imputation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/multiple-imputation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/imputation"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/missing-data-methods"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q20919573"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/imputation"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/missing-data-methods"/>
        <skos:notation>HE-ES-SA-133</skos:notation>
        <dcterms:identifier>HE-ES-SA-133</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-24</dcterms:modified>
        <dcterms:source>Rubin 1987</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Multiple Imputation</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">MI</skos:altLabel>
        <skos:definition xml:lang="en">Multiple imputation is a missing-data method that creates several plausible completed datasets, analyses each for the same target, and pools the estimates and their uncertainty to reflect uncertainty about unobserved values.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Rubin&apos;s Rules</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Multiple Imputation</skos:prefLabel>
        <abbreviation xml:lang="en">MI</abbreviation>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/missing-data"/>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/verification-bias"/>
        <assumes rdf:resource="https://healtheconomics.wiki/concept/missing-at-random"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/multiple-imputation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/imputation"/>
        <dcterms:identifier>HEO-L-18cd69e16334</dcterms:identifier>
        <linkRationale xml:lang="en">Replaces missing values with estimates</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
