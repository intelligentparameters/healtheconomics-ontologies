        <rdfs:label xml:lang="en">Pharmacoepidemiology</rdfs:label>
        <skos:definition xml:lang="en">A field combining pharmacology and epidemiology to study medication use, effectiveness, and safety within large populations, often using real-world observational data.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Drug Epidemiology</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Post-Marketing Epidemiology</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Pharmacoepidemiology</skos:prefLabel>
