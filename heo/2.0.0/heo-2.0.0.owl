    <!-- https://healtheconomics.wiki/concept/floating-point-arithmetic -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/floating-point-arithmetic">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
