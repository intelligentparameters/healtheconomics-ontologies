        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Dynamic Programming Health</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">DP in Health</skos:altLabel>
        <skos:definition xml:lang="en">An optimisation technique solving complex sequential decision problems by breaking them into smaller, nested subproblems solved in relation to one another.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Sequential Decision Optimisation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Dynamic Programming Health</skos:prefLabel>
        <abbreviation xml:lang="en">DP in Health</abbreviation>
