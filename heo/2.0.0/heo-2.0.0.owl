    <!-- https://healtheconomics.wiki/concept/indirectness -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/indirectness">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/grade"/>
        <skos:notation>HE-DS-BV-014</skos:notation>
        <dcterms:identifier>HE-DS-BV-014</dcterms:identifier>
        <dcterms:source>Guyatt GH, Oxman AD, Vist GE, et al. GRADE: an emerging consensus on rating quality of evidence and strength of recommendations. BMJ. 2008;336:924-926. doi:10.1136/bmj.39489.470347.AD.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Indirectness</rdfs:label>
        <skos:definition xml:lang="en">A GRADE evidence quality domain assessing whether the population, intervention, comparator, or outcome studied differs meaningfully from those relevant to the actual decision.</skos:definition>
        <skos:prefLabel xml:lang="en">Indirectness</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
