    <!-- https://healtheconomics.wiki/concept/screening-in-insurance -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/screening-in-insurance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:notation>HS-HP-HI-174</skos:notation>
        <dcterms:identifier>HS-HP-HI-174</dcterms:identifier>
        <dcterms:source>Rothschild &amp; Stiglitz 1976</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Screening in Insurance</rdfs:label>
        <skos:definition xml:lang="en">A process where an insurer designs a menu of policy options intended to lead individuals to reveal their private risk information through their own choice.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Insurance Screening</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Insurer Self-Selection Menu</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Screening in Insurance</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/signaling"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/separating-equilibrium"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/adverse-selection"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/screening-in-insurance"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-5f5b870fc1e3</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health Insurance: wiki topic Health financing and insurance sits in Health Systems; placed under Health Insurance, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/screening-in-insurance"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/signaling"/>
        <dcterms:identifier>HEO-L-35bb9fb06253</dcterms:identifier>
        <linkRationale xml:lang="en">Screening (uninformed party offers a menu) and signalling (informed party acts) are the two opposing responses to hidden information.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/screening-in-insurance"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#produces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/separating-equilibrium"/>
        <dcterms:identifier>HEO-L-38bd0dd4c62d</dcterms:identifier>
        <linkRationale xml:lang="en">A self-selection menu can yield a separating equilibrium in which risk types choose different policies.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/screening-in-insurance"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/adverse-selection"/>
        <dcterms:identifier>HEO-L-8b1b5b3489b1</dcterms:identifier>
        <linkRationale xml:lang="en">Getting risk types to reveal themselves limits the adverse selection that hidden risk information causes.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/screening-policy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/screening-policy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/prevention-policy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/prevention-policy"/>
        <skos:notation>HS-HP-PHP-011</skos:notation>
        <dcterms:identifier>HS-HP-PHP-011</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Screening Policy</rdfs:label>
        <skos:definition xml:lang="en">Government or health system policy governing which population screening programmes will be offered and funded, informed by health economic evaluation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Screening Governance</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Screening Programme Policy</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Screening Policy</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/screening-programme"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/screening-policy"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/prevention-policy"/>
        <dcterms:identifier>HEO-L-d776000c395e</dcterms:identifier>
        <linkRationale xml:lang="en">Screening policy is a policy aimed at preventing disease progression, a kind of prevention policy.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/screening-policy"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#setsScopeOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/screening-programme"/>
        <dcterms:identifier>HEO-L-5c0c7565a1f4</dcterms:identifier>
        <linkRationale xml:lang="en">The policy decides which screening programmes are offered and funded, which is setting scope, not supplying evidence.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/screening-programme -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/screening-programme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/public-health-programme"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/secondary-prevention"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/public-health-programme"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/secondary-prevention"/>
        <skos:notation>HS-SS-GH-025</skos:notation>
        <dcterms:identifier>HS-SS-GH-025</dcterms:identifier>
        <dcterms:source>Wilson &amp; Jungner 1968</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Screening Programme</rdfs:label>
        <skos:altLabel xml:lang="en">Population Screening</skos:altLabel>
        <skos:altLabel xml:lang="en">Screening Program</skos:altLabel>
        <skos:definition xml:lang="en">An organised public health initiative systematically testing an eligible population for early disease signs, before symptoms would otherwise prompt care-seeking.</skos:definition>
        <skos:prefLabel xml:lang="en">Screening Programme</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/screening-programme"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/public-health-programme"/>
        <dcterms:identifier>HEO-L-04eccf36bb1a</dcterms:identifier>
        <linkRationale xml:lang="en">A screening programme is an organised population-level health intervention, a public health programme.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/screening-programme"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/secondary-prevention"/>
        <dcterms:identifier>HEO-L-4d79103a4b00</dcterms:identifier>
        <linkRationale xml:lang="en">A programme testing for early disease signs is itself a form of secondary prevention rather than a separate cause of it.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/screening-theory -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/screening-theory">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <skos:notation>HE-EE-ME-064</skos:notation>
        <dcterms:identifier>HE-EE-ME-064</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Rothschild &amp; Stiglitz 1976</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Screening Theory</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A body of theory analysing how an uninformed party can design a menu of options that leads individuals to reveal their private information through choice.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Menu Design Theory</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Screening Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Screening Theory</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/signaling-theory"/>
        <explains rdf:resource="https://healtheconomics.wiki/concept/screening-in-insurance"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/mechanism-design"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/screening-theory"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-f13032550df2</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Market failure and information in subdomain Economic Foundations</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/screening-theory"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/signaling-theory"/>
        <dcterms:identifier>HEO-L-2108c9fe6557</dcterms:identifier>
