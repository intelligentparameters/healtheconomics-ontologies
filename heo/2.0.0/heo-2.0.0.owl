    <!-- https://healtheconomics.wiki/concept/discrete-event-simulation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/discrete-event-simulation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/simulation-model"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/stochastic-simulation"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q574814"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/simulation-model"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/stochastic-simulation"/>
        <skos:notation>HE-EM-DES-006</skos:notation>
        <dcterms:identifier>HE-EM-DES-006</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Law &amp; Kelton 2000</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Discrete Event Simulation</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:altLabel xml:lang="en">DES</skos:altLabel>
        <skos:altLabel xml:lang="en">Discrete Event Model</skos:altLabel>
        <skos:definition xml:lang="en">Discrete event simulation (DES) is a modelling method that follows each patient from event to event over time, tracking their history and use of resources.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Event-Driven Simulation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Discrete Event Simulation</skos:prefLabel>
        <abbreviation xml:lang="en">DES</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/markov-model"/>
