    <!-- https://healtheconomics.wiki/concept/precision-medicine -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/precision-medicine">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-technology"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-technology"/>
        <skos:notation>HE-PE-TI-022</skos:notation>
        <dcterms:identifier>HE-PE-TI-022</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Hamburg &amp; Collins 2010</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Precision Medicine</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Individualised Medicine</skos:altLabel>
        <skos:definition xml:lang="en">An approach to prevention, diagnosis or treatment that uses relevant individual or disease characteristics to select a more appropriate care strategy.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Precision Health</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Precision Medicine</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-policy#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/biomarker"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/companion-diagnostic"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/pharmacogenomics"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/precision-therapy"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/precision-medicine"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-technology"/>
        <dcterms:identifier>HEO-L-7906016e9196</dcterms:identifier>
