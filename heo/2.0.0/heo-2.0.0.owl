    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/public-sector-perspective -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/public-sector-perspective">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/perspective"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/perspective"/>
        <skos:notation>HE-EE-EPR-039</skos:notation>
        <dcterms:identifier>HE-EE-EPR-039</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Public Sector Perspective</rdfs:label>
        <skos:altLabel xml:lang="en">Government Perspective</skos:altLabel>
        <skos:altLabel xml:lang="en">Policy Perspective</skos:altLabel>
        <skos:definition xml:lang="en">An analytic viewpoint including costs and outcomes relevant to government budgets, potentially spanning multiple public agencies rather than a single health payer.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cross-Agency Viewpoint</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Decision-Maker Standpoint</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Government-Sector Viewpoint</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Policymaker Viewpoint</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Public Budget Perspective</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">State Analytic Perspective</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Public Sector Perspective</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/payer-perspective"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/societal-perspective"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/public-sector-perspective"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/perspective"/>
        <dcterms:identifier>HEO-L-6f9762326c73</dcterms:identifier>
