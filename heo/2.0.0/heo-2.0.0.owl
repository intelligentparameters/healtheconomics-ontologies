    <!-- https://healtheconomics.wiki/concept/consumer-surplus -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/consumer-surplus">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/welfare-economics"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q361800"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/welfare-economics"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/deadweight-loss"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/net-benefit"/>
        <skos:notation>HE-EE-WE-003</skos:notation>
        <dcterms:identifier>HE-EE-WE-003</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Marshall 1890</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Consumer Surplus</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Buyer Surplus</skos:altLabel>
        <skos:altLabel xml:lang="en">Consumer&apos;s Surplus</skos:altLabel>
        <skos:definition xml:lang="en">Consumer surplus is the most that buyers would pay for a good or service minus what they pay, measured as the area under the demand curve above the price.</skos:definition>
        <skos:prefLabel xml:lang="en">Consumer Surplus</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/equivalent-variation"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/consumer-surplus"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/welfare-economics"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-f231725e4ed6</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Welfare Economics: welfarism and extra-welfarism are the normative basis of cost-benefit and cost-effectiveness analysis; placed under Welfare Economics, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/consumer-surplus"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
