    <!-- https://healtheconomics.wiki/concept/nudge-intervention -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/nudge-intervention">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/behaviour-change-intervention"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/choice-architecture-intervention"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/behaviour-change-intervention"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/choice-architecture-intervention"/>
        <skos:notation>HE-EE-BE-029</skos:notation>
        <dcterms:identifier>HE-EE-BE-029</dcterms:identifier>
        <dcterms:source>Thaler &amp; Sunstein 2008</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Nudge Intervention</rdfs:label>
        <skos:altLabel xml:lang="en">Behavioural Nudge</skos:altLabel>
        <skos:definition xml:lang="en">A feature of choice architecture that predictably alters behaviour without forbidding options or significantly changing economic incentives.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Nudge</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Nudge Intervention</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/nudge-intervention"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/behaviour-change-intervention"/>
        <dcterms:identifier>HEO-L-532f1109f291</dcterms:identifier>
