        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Balancing Measure</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">A balancing measure is a quality improvement metric that checks whether a change that improves one part of a health system causes new problems elsewhere.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Counterbalance Measure</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">QI Balancing Metric</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Balancing Measure</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/outcome-measure"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/process-measure"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/plan-do-study-act"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
