    <!-- https://healtheconomics.wiki/concept/random-number-generation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/random-number-generation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/microsimulation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/microsimulation"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/monte-carlo-simulation"/>
        <skos:notation>HE-EM-MS-008</skos:notation>
        <dcterms:identifier>HE-EM-MS-008</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Press et al. 2007</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Random Number Generation</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">RNG</skos:altLabel>
        <skos:definition xml:lang="en">Random number generation supplies the uncertain draws used in probabilistic sensitivity analysis, microsimulation, discrete-event simulation, bootstrap procedures, and other stochastic analyses.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Random Draw Generation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Random Number Generation</skos:prefLabel>
        <abbreviation xml:lang="en">RNG</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-7"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/pseudo-random-number"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/random-number-generation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/microsimulation"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-f69a59f549d6</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Discrete event and individual level simulation in subdomain Economic Modelling; placed under Microsimulation, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/random-number-generation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/monte-carlo-simulation"/>
        <dcterms:identifier>HEO-L-d819ecac3462</dcterms:identifier>
