    <!-- https://healtheconomics.wiki/concept/time-trade-off -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/time-trade-off">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/choice-based-method"/>
