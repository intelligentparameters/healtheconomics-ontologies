    <!-- https://healtheconomics.wiki/concept/spider-plot -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/spider-plot">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/data-visualisation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/data-visualisation"/>
        <skos:notation>HE-EE-EPR-002</skos:notation>
        <dcterms:identifier>HE-EE-EPR-002</dcterms:identifier>
        <dcterms:source>Briggs A, Claxton K, Sculpher M. Decision Modelling for Health Economic Evaluation. Oxford University Press; 2006. doi:10.1093/oso/9780198526629.001.0001.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Spider Plot</rdfs:label>
        <skos:altLabel xml:lang="en">Spider Diagram</skos:altLabel>
        <skos:definition xml:lang="en">A graphical sensitivity analysis tool showing how a model&apos;s output changes as each input parameter is varied across its plausible range.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Radar Plot</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Spider Plot</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/tornado-diagram"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/spider-plot"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/data-visualisation"/>
        <dcterms:identifier>HEO-L-614b98d7f630</dcterms:identifier>
        <linkRationale xml:lang="en">A spider plot is a graphical presentation of results.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/spider-plot"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/tornado-diagram"/>
        <dcterms:identifier>HEO-L-d2901fdaf96f</dcterms:identifier>
