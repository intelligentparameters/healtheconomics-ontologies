        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/partial-capitation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/capitation"/>
        <dcterms:identifier>HEO-L-ae5764777e94</dcterms:identifier>
        <linkRationale xml:lang="en">Partial capitation is a capitation arrangement</linkRationale>
