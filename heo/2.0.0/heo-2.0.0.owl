        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/kaldor-hicks-efficiency"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/welfare-economics"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-7971c2524e6b</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: curated: review B: potential Pareto criterion is the welfare basis of CBA (Economic Evaluation), not Health Systems</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/kaldor-hicks-efficiency"/>
