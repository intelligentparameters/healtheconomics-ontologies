    <!-- https://healtheconomics.wiki/concept/structural-equation-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/structural-equation-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/regression-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/regression-analysis"/>
        <skos:notation>HE-ES-SA-207</skos:notation>
        <dcterms:identifier>HE-ES-SA-207</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>J�reskog 1969</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Structural Equation Model</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">SEM</skos:altLabel>
        <skos:definition xml:lang="en">A system of linked equations representing hypothesised relationships among observed and possibly latent variables, often combining a measurement model with structural paths.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Structural Equation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Structural Equation Model</skos:prefLabel>
        <abbreviation xml:lang="en">SEM</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/factor-analysis"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/structural-equation-model"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/regression-analysis"/>
        <dcterms:identifier>HEO-L-c205ad3714e6</dcterms:identifier>
        <linkRationale xml:lang="en">An SEM is a system of linked regression equations relating observed and latent variables.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/structural-equation-model"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/factor-analysis"/>
        <dcterms:identifier>HEO-L-3bdff53f6419</dcterms:identifier>
        <linkRationale xml:lang="en">The measurement part of an SEM is a confirmatory factor analysis model.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
