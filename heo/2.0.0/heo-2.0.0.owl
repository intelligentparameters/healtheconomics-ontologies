    <!-- https://healtheconomics.wiki/concept/expanded-disability-status-scale -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/expanded-disability-status-scale">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
