    <!-- https://healtheconomics.wiki/concept/diffusion -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/diffusion">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/innovation-adoption"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/innovation-adoption"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/technical-change-in-healthcare"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/technology-lifecycle"/>
        <skos:notation>HE-EE-BIA-028</skos:notation>
        <dcterms:identifier>HE-EE-BIA-028</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</dcterms:modified>
        <dcterms:source>Hall 2004</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Diffusion</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:altLabel xml:lang="en">Technology Diffusion</skos:altLabel>
        <skos:definition xml:lang="en">Diffusion in health economics is the spread of a new technology&apos;s use among eligible patients and providers over time, shaping costs and health gains.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Innovation Spread</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Population Uptake</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Diffusion</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/healthcare-cost-growth"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/budget-impact-analysis"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/diffusion"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/innovation-adoption"/>
        <dcterms:identifier>HEO-L-853c4a05f71e</dcterms:identifier>
        <linkRationale xml:lang="en">diffusion is the spread of use of a new technology into routine care, the adoption process by both definitions</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/diffusion"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/technical-change-in-healthcare"/>
        <dcterms:identifier>HEO-L-2ef441d1c5bf</dcterms:identifier>
        <linkRationale xml:lang="en">Diffusion is the adoption stage of technical change, per the object definition</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/diffusion"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/technology-lifecycle"/>
        <dcterms:identifier>HEO-L-63396277f992</dcterms:identifier>
