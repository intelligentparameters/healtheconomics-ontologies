    <!-- https://healtheconomics.wiki/concept/out-of-pocket-cost -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/out-of-pocket-cost">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/catastrophic-expenditure-measure"/>
        <skos:notation>HS-DC-HC-011</skos:notation>
        <dcterms:identifier>HS-DC-HC-011</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Out-of-Pocket Cost</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">OOP Cost</skos:altLabel>
        <skos:definition xml:lang="en">The amount a patient or household pays directly for health care without third-party reimbursement, including applicable cost sharing and uncovered care.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Patient Out-of-Pocket Spending</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Out-of-Pocket Cost</skos:prefLabel>
        <abbreviation xml:lang="en">OOP Cost</abbreviation>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/financial-barrier"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/out-of-pocket-cost"/>
