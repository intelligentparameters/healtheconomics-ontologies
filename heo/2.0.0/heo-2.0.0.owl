    <!-- https://healtheconomics.wiki/concept/monte-carlo-integration -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/monte-carlo-integration">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/numerical-integration"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/numerical-integration"/>
        <skos:notation>HE-EM-UA-038</skos:notation>
        <dcterms:identifier>HE-EM-UA-038</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-24</dcterms:modified>
        <dcterms:source>Metropolis &amp; Ulam 1949</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Monte Carlo Integration</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">MC Integration</skos:altLabel>
        <skos:definition xml:lang="en">A numerical technique estimating a complex integral&apos;s value by sampling random points repeatedly and averaging them, useful when no closed-form solution exists.</skos:definition>
        <skos:prefLabel xml:lang="en">Monte Carlo Integration</skos:prefLabel>
        <abbreviation xml:lang="en">MC Integration</abbreviation>
