    <!-- https://healtheconomics.wiki/concept/budget-impact-criterion -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/budget-impact-criterion">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/affordability-criterion"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/decision-criteria"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/affordability-criterion"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/decision-criteria"/>
        <skos:notation>HS-HP-HTA-025</skos:notation>
        <dcterms:identifier>HS-HP-HTA-025</dcterms:identifier>
        <dcterms:source>Sullivan et al. 2014</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Budget Impact Criterion</rdfs:label>
        <skos:altLabel xml:lang="en">BIA Criterion</skos:altLabel>
        <skos:definition xml:lang="en">A standard determining whether a new technology&apos;s projected budget impact is significant enough to warrant additional scrutiny or a modified pathway.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Budget-Impact Threshold Criterion</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Budget Impact Criterion</skos:prefLabel>
        <abbreviation xml:lang="en">BIA Criterion</abbreviation>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/budget-impact-analysis"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/budget-impact-criterion"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/affordability-criterion"/>
        <dcterms:identifier>HEO-L-78f0f870c1e0</dcterms:identifier>
        <linkRationale xml:lang="en">A budget impact criterion is an affordability test</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
