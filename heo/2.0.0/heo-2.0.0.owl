    <!-- https://healtheconomics.wiki/concept/connected-network -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/connected-network">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/treatment-network"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/treatment-network"/>
        <skos:notation>HE-ES-ESM-007</skos:notation>
        <dcterms:identifier>HE-ES-ESM-007</dcterms:identifier>
        <dcterms:source>Dias et al. 2013</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Connected Network</rdfs:label>
        <skos:definition xml:lang="en">A set of trials that together link every treatment of interest to every other through a chain of direct comparisons.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Connected Evidence Network</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Linked Evidence Network</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Connected Network</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/connected-network"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/treatment-network"/>
        <dcterms:identifier>HEO-L-b8eea3d9f22b</dcterms:identifier>
        <linkRationale xml:lang="en">A connected network is a treatment network in which every treatment is linked by a chain of comparisons</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/consensus-building -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/consensus-building">
