    <!-- https://healtheconomics.wiki/concept/innovation-criterion -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/innovation-criterion">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/decision-criteria"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/decision-criteria"/>
        <skos:notation>HS-HP-HTA-114</skos:notation>
        <dcterms:identifier>HS-HP-HTA-114</dcterms:identifier>
        <dcterms:source>National Institute for Health and Care Excellence. NICE technology appraisal and highly specialised technologies guidance: the manual (PMG36). Published 2022; updated 2026.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Innovation Criterion</rdfs:label>
        <skos:definition xml:lang="en">A standard giving additional weight to a technology&apos;s genuinely novel characteristics, such as a new mechanism addressing unmet need.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Innovation Weighting</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Novelty Criterion</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Innovation Criterion</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/innovation-premium"/>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/innovation"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/innovation-criterion"/>
