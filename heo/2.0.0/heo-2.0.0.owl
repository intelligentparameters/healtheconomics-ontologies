        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Resource Valuation</rdfs:label>
        <skos:definition xml:lang="en">The process of assigning a monetary value to a measured quantity of resource use, typically by multiplying it by a unit cost.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Input Valuation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Resource Pricing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Resource Valuation</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/resource-use"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/unit-cost"/>
    </owl:NamedIndividual>
