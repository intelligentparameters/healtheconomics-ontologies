    <!-- https://healtheconomics.wiki/concept/knot -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/knot">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/cubic-spline"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/flexible-parametric-model"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/restricted-cubic-spline"/>
        <skos:notation>HE-EM-SM-040</skos:notation>
        <dcterms:identifier>HE-EM-SM-040</dcterms:identifier>
        <dcterms:source>Royston &amp; Parmar 2002</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Knot</rdfs:label>
        <skos:definition xml:lang="en">A specified point along a variable&apos;s range at which a spline function is allowed to change shape, used in flexible parametric survival models.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Change Point</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Spline Breakpoint</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Knot</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/knot"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-ccb399c71bdf</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Modelling &gt; Survival Modelling: catalogue subdomain Economic Modelling is one of the subdomains</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
