    <!-- https://healtheconomics.wiki/concept/country-specific-value-set -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/country-specific-value-set">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/value-set"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
