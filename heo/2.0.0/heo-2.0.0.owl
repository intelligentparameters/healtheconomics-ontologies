        <skos:notation>HE-PE-MH-024</skos:notation>
        <dcterms:identifier>HE-PE-MH-024</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Psychiatric Hospitalization</rdfs:label>
        <skos:altLabel xml:lang="en">Inpatient Psychiatric Admission</skos:altLabel>
        <skos:definition xml:lang="en">Admission to a specialist inpatient facility for an acute mental health crisis or severe psychiatric condition requiring close monitoring.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Mental Health Admission</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Psychiatric Hospitalization</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
