    <!-- https://healtheconomics.wiki/concept/generalized-gamma-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/generalized-gamma-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/generalized-f-model"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/parametric-survival-model"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/generalized-f-model"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/parametric-survival-model"/>
        <skos:notation>HE-EM-SM-030</skos:notation>
        <dcterms:identifier>HE-EM-SM-030</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-23</dcterms:modified>
        <dcterms:source>Stacy 1962</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Generalized Gamma Model</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">GG Model</skos:altLabel>
        <skos:definition xml:lang="en">A survival model based on the generalised gamma distribution, nesting simpler distributions, such as the Weibull and log-normal, within one framework.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Gen-Gamma Survival Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Generalized Gamma Model</skos:prefLabel>
        <abbreviation xml:lang="en">GG Model</abbreviation>
        <assumes rdf:resource="https://healtheconomics.wiki/concept/generalized-gamma"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/generalized-gamma-model"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/generalized-f-model"/>
