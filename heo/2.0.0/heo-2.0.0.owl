        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/crude-coverage"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/tracer-indicator"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/crude-coverage"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/tracer-indicator"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/universal-health-coverage-index"/>
        <skos:notation>HS-SS_HSP-002</skos:notation>
        <dcterms:identifier>HS-SS_HSP-002</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>WHO 2025; WHO 2016</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Antenatal Care Coverage</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">ANC Coverage</skos:altLabel>
        <skos:altLabel xml:lang="en">Prenatal Care Coverage</skos:altLabel>
        <skos:definition xml:lang="en">Antenatal care coverage is the share of women with a recent live birth who had at least one, four or eight antenatal contacts; ANC4+ is a UHC tracer.</skos:definition>
        <skos:prefLabel xml:lang="en">Antenatal Care Coverage</skos:prefLabel>
        <abbreviation xml:lang="en">ANC Coverage</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/antenatal-care-coverage"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/crude-coverage"/>
        <dcterms:identifier>HEO-L-4d5330f2b91d</dcterms:identifier>
        <linkRationale xml:lang="en">Counting ANC contacts without quality adjustment is crude coverage by both definitions</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
