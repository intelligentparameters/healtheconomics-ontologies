    <!-- https://healtheconomics.wiki/concept/skewness -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/skewness">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/descriptive-statistics"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q9051521"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/descriptive-statistics"/>
        <skos:notation>HE-ES-SA-197</skos:notation>
        <dcterms:identifier>HE-ES-SA-197</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Pearson 1895</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Skewness</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Skew</skos:altLabel>
        <skos:definition xml:lang="en">A measure describing a distribution&apos;s asymmetry around its mean, positive skewness meaning a longer tail toward higher values.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Distribution Asymmetry</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Skewness</skos:prefLabel>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/probability-distribution"/>
