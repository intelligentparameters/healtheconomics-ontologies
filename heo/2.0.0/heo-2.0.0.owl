        <uses rdf:resource="https://healtheconomics.wiki/concept/deliberative-process"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/problem-structuring"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
