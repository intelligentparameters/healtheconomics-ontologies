        <skos:notation>HE-PE-CD-019</skos:notation>
        <dcterms:identifier>HE-PE-CD-019</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Geriatric Economics</rdfs:label>
        <skos:definition xml:lang="en">The application of health economic evaluation to health and long-term care needs specific to older adults, including assessment and multiple chronic conditions.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Economics of Ageing</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Older-Adult Health Economics</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Geriatric Economics</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/geriatric-economics"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-evaluation"/>
