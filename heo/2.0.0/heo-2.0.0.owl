    <!-- https://healtheconomics.wiki/concept/three-state-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/three-state-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/markov-model"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/markov-model"/>
        <skos:notation>HE-EM-MM-021</skos:notation>
        <dcterms:identifier>HE-EM-MM-021</dcterms:identifier>
        <dcterms:source>Sonnenberg FA, Beck JR. Markov models in medical decision making: a practical guide. Medical Decision Making. 1993;13(4):322-338. doi:10.1177/0272989X9301300409.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Three-State Model</rdfs:label>
        <skos:definition xml:lang="en">A simplified Markov structure with exactly three health states, commonly well, diseased, and death, used when a fuller structure is unnecessary.</skos:definition>
        <skos:hiddenLabel xml:lang="en">3-State Markov Model</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Three-Compartment Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Three-State Model</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/partitioned-survival-model"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/health-state"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/three-state-model"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/markov-model"/>
        <dcterms:identifier>HEO-L-e423799f42ee</dcterms:identifier>
        <linkRationale xml:lang="en">A three-state model is a simplified Markov model.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
