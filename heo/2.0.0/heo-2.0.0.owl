    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/egalitarian-distribution -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/egalitarian-distribution">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/distributive-justice"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/distributive-justice"/>
        <skos:notation>HE-EE-WE-005</skos:notation>
        <dcterms:identifier>HE-EE-WE-005</dcterms:identifier>
        <dcterms:source>Rawls 1971</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Egalitarian Distribution</rdfs:label>
        <skos:definition xml:lang="en">An allocation of resources or outcomes in which all individuals receive an equal share, regardless of differences in need or contribution.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Equal Distribution</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Equal-Share Allocation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Egalitarian Distribution</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/health-equity"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/vertical-equity"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/egalitarian-distribution"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/distributive-justice"/>
        <dcterms:identifier>HEO-L-be7623fd1fce</dcterms:identifier>
        <linkRationale xml:lang="en">Strict equal shares is the egalitarian principle of distributive justice</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/egalitarian-distribution"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-equity"/>
        <dcterms:identifier>HEO-L-9f606d11ab41</dcterms:identifier>
        <linkRationale xml:lang="en">Equal shares (equality) differ from a fair chance to reach health potential (equity); the standard equality-equity contrast</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/egalitarian-distribution"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/vertical-equity"/>
        <dcterms:identifier>HEO-L-aa8932a9e513</dcterms:identifier>
        <linkRationale xml:lang="en">Equal shares regardless of need is the opposite principle to unequal treatment of unequal need.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/egalitarian-welfare -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/egalitarian-welfare">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/distributive-justice"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/social-welfare-function"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/distributive-justice"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/social-welfare-function"/>
        <skos:notation>HE-EE-WE-006</skos:notation>
        <dcterms:identifier>HE-EE-WE-006</dcterms:identifier>
        <dcterms:source>Wagstaff 1991</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Egalitarian Welfare</rdfs:label>
        <skos:definition xml:lang="en">Egalitarian welfare is a social welfare view that values equal distribution of health or well-being, accepting some loss of total gain for less inequality.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Prioritarian Welfare</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Worst-Off Priority</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Egalitarian Welfare</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/egalitarian-welfare"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/distributive-justice"/>
        <dcterms:identifier>HEO-L-8e01cf120844</dcterms:identifier>
        <linkRationale xml:lang="en">Egalitarian welfare is a position in distributive justice, prioritising the worst-off</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/egalitarian-welfare"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/social-welfare-function"/>
        <dcterms:identifier>HEO-L-19b9689a873b</dcterms:identifier>
        <linkRationale xml:lang="en">An egalitarian SWF is one form of social welfare function, weighting equality against the total</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/egger-test -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/egger-test">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/small-study-effects"/>
        <skos:notation>HE-ES-ESM-014</skos:notation>
        <dcterms:identifier>HE-ES-ESM-014</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Egger et al. 1997</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Egger Test</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Egger Regression Test</skos:altLabel>
        <skos:definition xml:lang="en">A statistical test for funnel plot asymmetry, and by extension potential publication bias, using regression of effect estimates against standard errors.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Funnel-Plot Asymmetry Test</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Egger Test</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-4"/>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/funnel-plot"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/egger-test"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <dcterms:identifier>HEO-L-0bd0ab9099ce</dcterms:identifier>
        <linkRationale xml:lang="en">The Egger test is a regression-based statistical test</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/egger-test"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/small-study-effects"/>
        <dcterms:identifier>HEO-L-c54ad660c360</dcterms:identifier>
        <linkRationale xml:lang="en">The Egger test detects funnel plot asymmetry, which can have causes other than publication bias (Cochrane Handbook)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
