        <skos:hiddenLabel xml:lang="en">Pharmacovigilance Signal</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Safety Signal</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
