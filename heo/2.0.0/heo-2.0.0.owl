    <!-- https://healtheconomics.wiki/concept/recurrence -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/recurrence">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome"/>
        <skos:notation>HE-PE-OO-020</skos:notation>
        <dcterms:identifier>HE-PE-OO-020</dcterms:identifier>
        <dcterms:source>DeVita, Lawrence &amp; Rosenberg 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Recurrence</rdfs:label>
        <skos:definition xml:lang="en">The return of cancer after a period with no detectable disease, occurring either at the original site or elsewhere in the body.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cancer Relapse</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Disease Return</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Recurrence</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
