        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Digital Safety</rdfs:label>
        <skos:definition xml:lang="en">The degree to which a digital health technology avoids causing unintended harm, covering both clinical safety and data security or algorithmic bias.</skos:definition>
