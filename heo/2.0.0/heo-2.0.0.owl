        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Patient-Centred Outcome</rdfs:label>
        <skos:altLabel xml:lang="en">Patient-Important Outcome</skos:altLabel>
        <skos:definition xml:lang="en">A health outcome measure specifically identified as important to patients themselves, rather than selected primarily for clinical or biomarker significance.</skos:definition>
