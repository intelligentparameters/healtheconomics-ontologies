    <!-- https://healtheconomics.wiki/concept/variance-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/variance-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HE-EE_EA-056</skos:notation>
        <dcterms:identifier>HE-EE_EA-056</dcterms:identifier>
        <dcterms:source>Horngren, Datar &amp; Rajan 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Variance Analysis</rdfs:label>
        <skos:definition xml:lang="en">A technique for decomposing the difference between budgeted and actual financial results into component causes, such as price and volume effects.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Budget-vs-Actual Analysis</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Financial Variance Review</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Variance Analysis</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-4"/>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/cost-variance"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/budget-variance"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/standard-costing"/>
    </owl:NamedIndividual>
    <owl:Axiom>
