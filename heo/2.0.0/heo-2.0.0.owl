    <!-- https://healtheconomics.wiki/concept/external-audit -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/external-audit">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-HP-HSR-031</skos:notation>
        <dcterms:identifier>HS-HP-HSR-031</dcterms:identifier>
        <dcterms:source>OIG, Compliance Program Guidance</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">External Audit</rdfs:label>
        <skos:altLabel xml:lang="en">Independent Audit</skos:altLabel>
        <skos:definition xml:lang="en">A review of an organisation&apos;s compliance, financial, or operational practices conducted by an independent party outside the organisation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Third-Party Audit</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">External Audit</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/internal-audit"/>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/compliance"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/external-audit"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-a9d32ebea573</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health System Regulation: compliance, audit and accreditation govern how providers work (Organisation and governance)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/external-audit"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/internal-audit"/>
        <dcterms:identifier>HEO-L-d88b111bfe4c</dcterms:identifier>
        <linkRationale xml:lang="en">External versus internal audit; reverse in queue-r3-11, keep one at merge</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/external-audit"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#evaluates"/>
