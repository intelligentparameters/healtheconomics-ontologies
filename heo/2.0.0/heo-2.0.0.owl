        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/confidential-price"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/net-price"/>
        <dcterms:identifier>HEO-L-2f1b5d0295fa</dcterms:identifier>
        <linkRationale xml:lang="en">A price is not a kind of pricing process; the confidential price is the actual net price paid</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
