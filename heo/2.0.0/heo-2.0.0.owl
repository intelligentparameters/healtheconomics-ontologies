    <!-- https://healtheconomics.wiki/concept/target-trial-emulation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/target-trial-emulation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/causal-inference"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/causal-inference"/>
        <skos:notation>HE-ES-CER-026</skos:notation>
        <dcterms:identifier>HE-ES-CER-026</dcterms:identifier>
        <dcterms:source>Hernán &amp; Robins 2016</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Target Trial Emulation</rdfs:label>
        <skos:altLabel xml:lang="en">Target Trial Framework</skos:altLabel>
        <skos:definition xml:lang="en">A framework designing an observational study to closely emulate a hypothetical randomised trial answering the same causal question, specified before analysis.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Emulated Trial</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Target Trial Emulation</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/immortal-time"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/randomised-controlled-trial"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/immortal-time-bias"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/real-world-data"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/target-trial-emulation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/causal-inference"/>
        <dcterms:identifier>HEO-L-cd4bd7fed60e</dcterms:identifier>
        <linkRationale xml:lang="en">Target trial emulation is a framework for causal inference from observational data.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/target-trial-emulation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#addresses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/immortal-time"/>
        <dcterms:identifier>HEO-L-98aeae9f9f85</dcterms:identifier>
        <linkRationale xml:lang="en">Full page; both methods align time zero to remove immortal person-time.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
