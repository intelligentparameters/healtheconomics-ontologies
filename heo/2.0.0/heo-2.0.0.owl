    <!-- https://healtheconomics.wiki/concept/risk-factor -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/risk-factor">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/determinant-of-health"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/exposure"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/determinant-of-health"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/exposure"/>
        <skos:notation>HE-ES-EP-039</skos:notation>
        <dcterms:identifier>HE-ES-EP-039</dcterms:identifier>
        <dcterms:source>Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams &amp; Wilkins; 2008.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Risk Factor</rdfs:label>
        <skos:definition xml:lang="en">A characteristic, behaviour, or exposure associated with an increased likelihood of a disease or health outcome, without necessarily being an established direct cause.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Determinant of Risk</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Predisposing Factor</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Risk Factor</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
