        <skos:notation>HS-NHS-HQ-079</skos:notation>
        <dcterms:identifier>HS-NHS-HQ-079</dcterms:identifier>
        <dcterms:source>Donabedian A. Evaluating the quality of medical care. Milbank Memorial Fund Quarterly. 1966;44(3):166-206. doi:10.2307/3348969.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Structure Quality Indicator</rdfs:label>
        <skos:altLabel xml:lang="en">Structural Quality Indicator</skos:altLabel>
        <skos:definition xml:lang="en">A measurable metric assessing the resources and organisational capacity available to a provider, such as staffing ratios or specialist equipment.</skos:definition>
