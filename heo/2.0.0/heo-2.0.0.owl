        <dcterms:identifier>HEO-L-855e9ce957b9</dcterms:identifier>
        <linkRationale xml:lang="en">The shadow price of health quantifies the health opportunity cost of spending</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
