    <!-- https://healtheconomics.wiki/concept/hub-and-spoke-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/hub-and-spoke-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/coordinated-care-model"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/coordinated-care-model"/>
        <skos:notation>HS-SS_HSM-007</skos:notation>
        <dcterms:identifier>HS-SS_HSM-007</dcterms:identifier>
        <dcterms:source>AHA, American Hospital Association</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Hub And Spoke Model</rdfs:label>
        <skos:altLabel xml:lang="en">Hub-and-Spoke Network</skos:altLabel>
        <skos:definition xml:lang="en">A network structure where a central, highly specialist hub coordinates with dispersed spoke facilities providing basic care and referring complex cases.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Centralised Care Network</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Hub And Spoke Model</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/referral-system"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/hub-and-spoke-model"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/coordinated-care-model"/>
        <dcterms:identifier>HEO-L-0282e690efbd</dcterms:identifier>
        <linkRationale xml:lang="en">A central hub coordinates care with dispersed spokes, a coordinated care arrangement</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/hub-and-spoke-model"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/referral-system"/>
        <dcterms:identifier>HEO-L-72dfe3bb78a5</dcterms:identifier>
        <linkRationale xml:lang="en">Network Model is a managed care contracting structure; hub and spoke works by referral from spokes to the hub.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/hui -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/hui">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/index-instrument"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/index-instrument"/>
        <skos:notation>HE-EE-HU-036</skos:notation>
        <dcterms:identifier>HE-EE-HU-036</dcterms:identifier>
        <dcterms:source>Feeny et al. 1995</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">HUI</rdfs:label>
        <skos:altLabel xml:lang="en">Health Utilities Index</skos:altLabel>
        <skos:definition xml:lang="en">An abbreviation for the Health Utilities Index, a family of generic, multi-attribute health status classification systems producing a single utility value.</skos:definition>
        <skos:prefLabel xml:lang="en">HUI</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/hui"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/index-instrument"/>
        <dcterms:identifier>HEO-L-56183100f60f</dcterms:identifier>
        <linkRationale xml:lang="en">HUI is an instrument family; a multi-attribute utility is the value it yields, not its class.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/hui2 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/hui2">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
