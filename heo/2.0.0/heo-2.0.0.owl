        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/digital-adoption -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/digital-adoption">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/innovation-adoption"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/innovation-adoption"/>
        <skos:notation>HS-SS_DH-014</skos:notation>
        <dcterms:identifier>HS-SS_DH-014</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</dcterms:modified>
        <dcterms:source>Greenhalgh et al. 2017</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Digital Adoption</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:definition xml:lang="en">Digital adoption is the uptake and continued use of a digital health technology by patients, carers, clinicians or the organisations that provide care.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Digital Technology Adoption</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Digital Uptake</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Digital Adoption</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/budget-impact-analysis"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/digital-adoption"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/innovation-adoption"/>
        <dcterms:identifier>HEO-L-e594be34cdde</dcterms:identifier>
        <linkRationale xml:lang="en">digital adoption is the adoption of a digital innovation</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
