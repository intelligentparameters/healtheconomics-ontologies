    <!-- https://healtheconomics.wiki/concept/cultural-barrier -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cultural-barrier">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/access-barrier"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/access-barrier"/>
        <skos:notation>HS-HP-HE-012</skos:notation>
        <dcterms:identifier>HS-HP-HE-012</dcterms:identifier>
        <dcterms:source>Penchansky R, Thomas JW. The concept of access: definition and relationship to consumer satisfaction. Medical Care. 1981;19(2):127-140. doi:10.1097/00005650-198102000-00001.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cultural Barrier</rdfs:label>
        <skos:definition xml:lang="en">An obstacle to healthcare arising from differences between a patient&apos;s cultural beliefs or practices and those embedded in the healthcare system.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cultural Access Barrier</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Cultural Obstacle</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cultural Barrier</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/acceptability"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cultural-barrier"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/access-barrier"/>
        <dcterms:identifier>HEO-L-1dd8f86d98a6</dcterms:identifier>
        <linkRationale xml:lang="en">A cultural obstacle to care is an access barrier</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cultural-barrier"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/acceptability"/>
        <dcterms:identifier>HEO-L-2ab97a6cf481</dcterms:identifier>
        <linkRationale xml:lang="en">A cultural mismatch makes services less acceptable, the cultural fit dimension of access</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
