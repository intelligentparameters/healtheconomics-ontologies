        <dcterms:identifier>HS-HP-HSR-035</dcterms:identifier>
        <dcterms:source>American Health Planning Association, Certificate of Need Programs</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
