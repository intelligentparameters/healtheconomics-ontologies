        <skos:notation>HE-ES-CO-079</skos:notation>
        <dcterms:identifier>HE-ES-CO-079</dcterms:identifier>
        <dcterms:source>Kumar et al. 2016</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Stringent Complete Response</rdfs:label>
        <skos:altLabel xml:lang="en">Stringent CR</skos:altLabel>
        <skos:altLabel xml:lang="en">sCR</skos:altLabel>
        <skos:definition xml:lang="en">A myeloma response criterion more rigorous than a standard complete response, requiring additional laboratory confirmation, such as normalised light chain ratios.</skos:definition>
        <skos:prefLabel xml:lang="en">Stringent Complete Response</skos:prefLabel>
        <abbreviation xml:lang="en">Stringent CR</abbreviation>
        <abbreviation xml:lang="en">sCR</abbreviation>
