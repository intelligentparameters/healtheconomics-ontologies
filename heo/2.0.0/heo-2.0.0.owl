        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Narrative Synthesis</rdfs:label>
        <skos:definition xml:lang="en">An evidence synthesis summarising findings from multiple studies primarily through descriptive text, rather than formal statistical pooling.</skos:definition>
