        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Biomarker Development</rdfs:label>
        <skos:definition xml:lang="en">The process of identifying, validating, and establishing the clinical utility of a biological indicator used to diagnose disease or predict treatment response.</skos:definition>
