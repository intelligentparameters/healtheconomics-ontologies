        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/end-stage-renal-disease"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/chronic-kidney-disease"/>
        <dcterms:identifier>HEO-L-3ef6ee2b3571</dcterms:identifier>
