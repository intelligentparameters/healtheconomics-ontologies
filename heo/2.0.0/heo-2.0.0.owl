    <!-- https://healtheconomics.wiki/concept/external-consistency -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/external-consistency">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/model-validation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/model-validation"/>
        <skos:notation>HE-EM-MV-023</skos:notation>
        <dcterms:identifier>HE-EM-MV-023</dcterms:identifier>
        <dcterms:source>Eddy DM, Hollingworth W, Caro JJ, et al. Model transparency and validation: a report of the ISPOR-SMDM Modeling Good Research Practices Task Force-7. Value in Health. 2012;15(6):843-850. doi:10.1016/j.jval.2012.04.012.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">External Consistency</rdfs:label>
        <skos:definition xml:lang="en">The degree to which a model&apos;s results align with findings from other independent studies or models addressing a similar question.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Between-Study Agreement</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Cross-Model Consistency</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">External Consistency</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/external-validity"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/credibility-assessment"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/external-consistency"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/model-validation"/>
        <dcterms:identifier>HEO-L-5b98df00e9a6</dcterms:identifier>
        <linkRationale xml:lang="en">External consistency is one form of model validation</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/external-consistency"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/external-validity"/>
        <dcterms:identifier>HEO-L-a52b4d61744c</dcterms:identifier>
        <linkRationale xml:lang="en">Agreement with other models (cross-validation) differs from agreement with observed outcomes</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/external-consistency"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/credibility-assessment"/>
        <dcterms:identifier>HEO-L-ece1ac064302</dcterms:identifier>
        <linkRationale xml:lang="en">Agreement with other models is evidence used in judging model credibility.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/external-control-arm -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/external-control-arm">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/control-arm"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/control-arm"/>
        <skos:notation>HE-ES-CER-014</skos:notation>
        <dcterms:identifier>HE-ES-CER-014</dcterms:identifier>
        <dcterms:source>Jahanshahi et al. 2021</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">External Control Arm</rdfs:label>
        <skos:definition xml:lang="en">A comparator group built from data outside the trial itself, such as a historical cohort or registry, used when no concurrent control is feasible.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Registry Control Group</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Synthetic Control Arm</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">External Control Arm</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/randomised-controlled-trial"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/natural-history-study"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/external-control-arm"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/control-arm"/>
        <dcterms:identifier>HEO-L-5b57c475e3e8</dcterms:identifier>
        <linkRationale xml:lang="en">An external control arm is a control arm</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/external-control-arm"/>
