    <!-- https://healtheconomics.wiki/concept/flexible-spending-account -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/flexible-spending-account">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
