        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/non-excludable-goods -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/non-excludable-goods">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-good"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/economic-good"/>
        <skos:notation>HE-EE-ME-047</skos:notation>
        <dcterms:identifier>HE-EE-ME-047</dcterms:identifier>
        <dcterms:source>Musgrave 1959</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Non-Excludable Goods</rdfs:label>
        <skos:definition xml:lang="en">Goods for which it is not possible, or not practical, to stop those who have not paid from consuming their benefits.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Non-Excludable Resource</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Open-Access Good</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Non-Excludable Goods</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/market-failure"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
