    <!-- https://healtheconomics.wiki/concept/gibbs-sampling -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/gibbs-sampling">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/markov-chain-monte-carlo"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/markov-chain-monte-carlo"/>
        <skos:notation>HE-EM-MP-016</skos:notation>
        <dcterms:identifier>HE-EM-MP-016</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-23</dcterms:modified>
        <dcterms:source>Geman &amp; Geman 1984</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Gibbs Sampling</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Gibbs Sampler</skos:altLabel>
        <skos:definition xml:lang="en">A Markov chain Monte Carlo algorithm generating samples from a complex joint distribution by iteratively sampling each variable from its conditional distribution.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Conditional Sampling</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Gibbs Sampling</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/metropolis-hastings"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-4"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/gibbs-sampling"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/markov-chain-monte-carlo"/>
        <dcterms:identifier>HEO-L-6049708d708f</dcterms:identifier>
        <linkRationale xml:lang="en">Gibbs sampling is an MCMC algorithm</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/gibbs-sampling"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
