    <!-- https://healtheconomics.wiki/concept/adverse-event-cost -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/adverse-event-cost">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/direct-medical-cost"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/direct-medical-cost"/>
        <skos:notation>HS-DC-DMS-001</skos:notation>
        <dcterms:identifier>HS-DC-DMS-001</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Adverse Event Cost</rdfs:label>
        <skos:altLabel xml:lang="en">AE Cost</skos:altLabel>
        <skos:definition xml:lang="en">The expense of managing a treatment&apos;s side effects, covering additional medical visits, hospitalisation, and supportive medications required.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Side Effect Cost</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Toxicity Management Cost</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Adverse Event Cost</skos:prefLabel>
        <abbreviation xml:lang="en">AE Cost</abbreviation>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/adverse-event-cost"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/direct-medical-cost"/>
        <dcterms:identifier>HEO-L-1fe370fee36b</dcterms:identifier>
        <linkRationale xml:lang="en">Managing side effects is medical care spending</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/adverse-event-rate -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/adverse-event-rate">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
