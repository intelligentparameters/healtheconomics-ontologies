        <dcterms:identifier>HS_SS_HS-024</dcterms:identifier>
        <dcterms:source>HealthEconomics.wiki subdomain page https://healtheconomics.wiki/subdomain/health-systems (read 16 Oct 2026)</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Health Systems</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/subdomain/health-systems"/>
        <skos:altLabel xml:lang="en">Health Systems Economics</skos:altLabel>
        <skos:definition xml:lang="en">Health systems is the area of health economics that studies how care is financed and organised, how providers are paid and how efficiently services turn resources into health.</skos:definition>
        <skos:editorialNote xml:lang="en">In HEO this concept is the wiki subdomain Health Systems, directly under Health Economics. Concepts in that subdomain with no is-type-of parent are classified under it or under a concept within it.</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Health Systems</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
