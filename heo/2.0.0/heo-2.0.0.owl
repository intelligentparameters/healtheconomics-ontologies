    <!-- https://healtheconomics.wiki/concept/community-mental-health -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/community-mental-health">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/community-care"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q113468986"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/community-care"/>
        <skos:notation>HE-PE-MH-008</skos:notation>
        <dcterms:identifier>HE-PE-MH-008</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Community Mental Health</rdfs:label>
        <skos:altLabel xml:lang="en">Community-Based Mental Health</skos:altLabel>
        <skos:definition xml:lang="en">A mental health service delivery model providing care within a patient&apos;s local community rather than a centralised psychiatric institution.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Community Psychiatry</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Community Mental Health</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/psychiatric-hospitalization"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/recovery-model"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/community-mental-health"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/community-care"/>
        <dcterms:identifier>HEO-L-49b1dd98bc86</dcterms:identifier>
        <linkRationale xml:lang="en">Community mental health is community care (both definitions)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
