    <!-- https://healtheconomics.wiki/concept/acquired-resistance -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/acquired-resistance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-resistance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/drug-resistance"/>
        <skos:notation>HE-PE-OO-001</skos:notation>
        <dcterms:identifier>HE-PE-OO-001</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Vasan et al. 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Acquired Treatment Resistance</rdfs:label>
        <owl:versionInfo>1.0.4</owl:versionInfo>
        <skos:altLabel xml:lang="en">Secondary Resistance</skos:altLabel>
        <skos:definition xml:lang="en">Acquired treatment resistance is the loss of a cancer treatment&apos;s effect after initial response or disease control, as the tumour adapts and progresses.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Developed Resistance</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Emergent Resistance</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Late-Onset Resistance</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Post-Treatment Resistance</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Acquired Treatment Resistance</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/primary-resistance"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/disease-progression"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/treatment-failure"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/outcomes#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/acquired-resistance"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-resistance"/>
        <dcterms:identifier>HEO-L-ffa1ff7dcb3d</dcterms:identifier>
        <linkRationale xml:lang="en">Acquired resistance is loss of effect through tumour adaptation, as Drug Resistance is defined</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/acquired-resistance"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/primary-resistance"/>
        <dcterms:identifier>HEO-L-18a7195ad55a</dcterms:identifier>
        <linkRationale xml:lang="en">Resistance after initial response versus from the outset; symmetric, reverse copy (queue-r3-15) is the duplicate</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/acquired-resistance"/>
