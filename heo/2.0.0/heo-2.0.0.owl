        <skos:altLabel xml:lang="en">Hit Finding</skos:altLabel>
        <skos:definition xml:lang="en">An early drug discovery stage identifying initial candidate compounds, called hits, showing biological activity against a target, typically via large-scale screening.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Hit Discovery</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Hit Identification</skos:prefLabel>
