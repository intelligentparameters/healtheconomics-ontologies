        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/multicollinearity"/>
        <skos:notation>HE-ES-SA-233</skos:notation>
        <dcterms:identifier>HE-ES-SA-233</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Belsley, Kuh &amp; Welsch 1980</dcterms:source>
