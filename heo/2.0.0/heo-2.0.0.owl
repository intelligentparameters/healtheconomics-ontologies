    <!-- https://healtheconomics.wiki/concept/effect-estimate -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/effect-estimate">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/effect-size"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/point-estimate"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/effect-size"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/point-estimate"/>
        <skos:notation>HE-ES-SA-054</skos:notation>
        <dcterms:identifier>HE-ES-SA-054</dcterms:identifier>
        <dcterms:source>Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams &amp; Wilkins; 2008.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Effect Estimate</rdfs:label>
        <skos:altLabel xml:lang="en">Estimate of Effect</skos:altLabel>
        <skos:definition xml:lang="en">A calculated numerical value representing the estimated magnitude of association between an exposure or treatment and an outcome, drawn from a specific study.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Association Estimate</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Estimated Effect</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Effect Estimate</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
