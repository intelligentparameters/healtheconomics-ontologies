        <dcterms:identifier>HEO-L-60be2ca31939</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Pharmacoeconomics &gt; Rare Disease: orphan designation and incentives are regulatory policy (Drug development and regulation)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/orphan-disease"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/small-population-challenge"/>
        <dcterms:identifier>HEO-L-47ace501680d</dcterms:identifier>
