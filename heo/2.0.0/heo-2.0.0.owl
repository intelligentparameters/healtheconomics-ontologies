    <!-- https://healtheconomics.wiki/concept/ecological-bias -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/ecological-bias">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/bias"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/bias"/>
        <skos:notation>HE-DS-BV-011</skos:notation>
        <dcterms:identifier>HE-DS-BV-011</dcterms:identifier>
        <dcterms:source>Robinson 1950</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Ecological Bias</rdfs:label>
        <skos:altLabel xml:lang="en">Aggregation Bias</skos:altLabel>
        <skos:altLabel xml:lang="en">Cross-Level Bias</skos:altLabel>
        <skos:definition xml:lang="en">A distortion arising when group-level associations are wrongly assumed to apply to individuals within those groups, potentially reversing the true relationship.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Ecological Fallacy</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Ecological Bias</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/study-level-covariate"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/ecological-bias"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/bias"/>
        <dcterms:identifier>HEO-L-037944abb1d6</dcterms:identifier>
        <linkRationale xml:lang="en">ecological bias is a systematic error</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/ecological-bias"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#threatensValidityOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/study-level-covariate"/>
        <dcterms:identifier>HEO-L-ddea3a5b3a1a</dcterms:identifier>
        <linkRationale xml:lang="en">meta-regression on study-level covariates is prone to ecological bias</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/ecological-design -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/ecological-design">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/observational-study"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/observational-study"/>
        <skos:notation>HE-ES-CTM-030</skos:notation>
        <dcterms:identifier>HE-ES-CTM-030</dcterms:identifier>
        <dcterms:source>Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams &amp; Wilkins; 2008.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Ecological Design</rdfs:label>
        <skos:altLabel xml:lang="en">Ecological Study</skos:altLabel>
        <skos:definition xml:lang="en">An observational design analysing data at group or population level, such as regions, examining group-level exposure against group-level outcome rates.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Group-Level Study</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Ecological Design</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/cohort-study"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/ecological-bias"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/ecological-design"/>
