    <!-- https://healtheconomics.wiki/concept/recovery-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/recovery-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
