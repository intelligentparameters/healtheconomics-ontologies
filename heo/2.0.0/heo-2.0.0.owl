    <!-- https://healtheconomics.wiki/concept/emerging-technology -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/emerging-technology">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-technology"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-technology"/>
        <skos:notation>HS-HP-HS-006</skos:notation>
        <dcterms:identifier>HS-HP-HS-006</dcterms:identifier>
        <dcterms:source>Douw &amp; Vondeling 2006</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Emerging Technology</rdfs:label>
        <skos:altLabel xml:lang="en">Emerging Health Technology</skos:altLabel>
        <skos:definition xml:lang="en">A technology in an early development or adoption stage, not yet standard practice, often still generating evidence for a full assessment.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Early-Stage Technology</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Nascent Technology</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Emerging Technology</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/obsolete-technology"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/emerging-technology"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-technology"/>
        <dcterms:identifier>HEO-L-405bfb1e3178</dcterms:identifier>
        <linkRationale xml:lang="en">An emerging technology is a health technology at an early stage</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/emerging-technology"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/obsolete-technology"/>
        <dcterms:identifier>HEO-L-24b237e76488</dcterms:identifier>
        <linkRationale xml:lang="en">Emerging and obsolete are opposite ends of the technology life cycle; reverse link is in queue-r3-13, keep one at merge</linkRationale>
