    <!-- https://healtheconomics.wiki/concept/active-control-trial -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/active-control-trial">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-trial"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/clinical-trial"/>
        <skos:notation>HE-ES-CER-001</skos:notation>
        <dcterms:identifier>HE-ES-CER-001</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-03</dcterms:modified>
        <dcterms:source>ICH E10 2000</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Active Control Trial</rdfs:label>
        <owl:versionInfo>1.0.4</owl:versionInfo>
        <skos:altLabel xml:lang="en">Active-Controlled Trial</skos:altLabel>
        <skos:definition xml:lang="en">An active control trial is a randomised trial testing a new treatment against a known effective treatment, not placebo, for superiority or non-inferiority.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Head-to-Head Trial</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Active Control Trial</skos:prefLabel>
