    <!-- https://healtheconomics.wiki/concept/mature-minor -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/mature-minor">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-HP-HD-072</skos:notation>
        <dcterms:identifier>HS-HP-HD-072</dcterms:identifier>
        <dcterms:source>American Academy of Pediatrics, Informed Consent in Decision-Making in Pediatric Practice</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Mature Minor</rdfs:label>
        <skos:definition xml:lang="en">A legal doctrine letting a sufficiently mature adolescent below the age of majority consent to certain treatments independently of parental involvement.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Adolescent Consent Capacity</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Gillick Competence</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Mature Minor</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/emancipated-minor"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/minor-consent"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/mature-minor"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-a9aa47db8eae</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Healthcare Delivery: organisation and delivery of care is the Health Systems subdomain (Organisation and governance)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/mature-minor"/>
