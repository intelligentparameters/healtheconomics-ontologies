        <skos:notation>HE-EE-CEA-036</skos:notation>
        <dcterms:identifier>HE-EE-CEA-036</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-03</dcterms:modified>
        <dcterms:source>Hoch et al. 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Incremental Net Monetary Benefit</rdfs:label>
        <owl:versionInfo>1.2.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">INMB</skos:altLabel>
        <skos:definition xml:lang="en">Incremental net monetary benefit (INMB) is the extra health of an option over its comparator, valued at a threshold, minus the extra cost, per patient.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Incremental Monetary Net Benefit</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Incremental Net Monetary Benefit</skos:prefLabel>
        <abbreviation xml:lang="en">INMB</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/icer"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
