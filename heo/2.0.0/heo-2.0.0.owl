        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Funnel Plot Analysis</rdfs:label>
        <skos:definition xml:lang="en">The formal examination of a funnel plot&apos;s symmetry, often with a statistical test such as Egger&apos;s, to assess likely publication bias.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Asymmetry Analysis</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Funnel Plot Assessment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Funnel Plot Analysis</skos:prefLabel>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/publication-bias"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/funnel-plot"/>
    </owl:NamedIndividual>
    <owl:Axiom>
