    <!-- https://healtheconomics.wiki/concept/time-without-symptoms-of-progression -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/time-without-symptoms-of-progression">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/quality-adjusted-time-without-symptoms"/>
        <skos:notation>HE-EE-QALY-010</skos:notation>
        <dcterms:identifier>HE-EE-QALY-010</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Gelber et al. 1989</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Time Without Symptoms of Progression</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">TWiST</skos:altLabel>
        <skos:definition xml:lang="en">A phase within the Q-TWiST framework covering the period free of significant treatment toxicity or disease progression symptoms, typically weighted highest.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Symptom-Free Progression-Free Time</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Time Without Symptoms of Progression</skos:prefLabel>
        <abbreviation xml:lang="en">TWiST</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/outcomes#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/time-without-symptoms-of-progression"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-56650886de0d</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic QALYs, DALYs and summary measures in subdomain Outcomes</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/time-without-symptoms-of-progression"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/quality-adjusted-time-without-symptoms"/>
        <dcterms:identifier>HEO-L-cc8775479d3f</dcterms:identifier>
        <linkRationale xml:lang="en">The object definition partitions survival into this phase among others</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/timed-up-and-go-test -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/timed-up-and-go-test">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/performance-outcome"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <skos:related rdf:resource="https://healtheconomics.wiki/concept/frailty"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/performance-outcome"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/activity-limitation"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/physical-function"/>
        <skos:notation>HE-ES-CO-110</skos:notation>
        <dcterms:identifier>HE-ES-CO-110</dcterms:identifier>
        <dcterms:source>Podsiadlo &amp; Richardson 1991</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Timed Up and Go Test</rdfs:label>
        <skos:definition xml:lang="en">Timed Up and Go Test (TUG) is a performance outcome timing how long a person takes to rise, walk 3 metres, turn and sit, used for mobility and falls risk.</skos:definition>
        <skos:hiddenLabel xml:lang="en">TUG</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">TUGT</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Timed Up &amp; Go</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Timed Up and Go Test</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
