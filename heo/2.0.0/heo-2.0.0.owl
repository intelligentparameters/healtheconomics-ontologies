        <skos:notation>HE-EE-BIA-037</skos:notation>
        <dcterms:identifier>HE-EE-BIA-037</dcterms:identifier>
        <dcterms:source>Sullivan et al. 2014</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Market Share</rdfs:label>
        <skos:definition xml:lang="en">The proportion of eligible patients or total treatment volume captured by a particular product within a defined market.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Market Uptake Proportion</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Sales Share</skos:hiddenLabel>
