        <skos:altLabel xml:lang="en">Performance-Based Outcome</skos:altLabel>
        <skos:definition xml:lang="en">A clinical outcome based on a standardised task performed by a patient, such as a timed walk test, unlike a self-reported measure.</skos:definition>
        <skos:prefLabel xml:lang="en">Performance Outcome</skos:prefLabel>
        <abbreviation xml:lang="en">PerfO</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/patient-reported-outcome"/>
