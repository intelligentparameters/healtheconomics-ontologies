    <!-- https://healtheconomics.wiki/concept/cash-budget -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cash-budget">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
