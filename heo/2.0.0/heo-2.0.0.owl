    <!-- https://healtheconomics.wiki/concept/cubic-spline -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cubic-spline">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1537263"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:notation>CS-NA-IN-003</skos:notation>
        <dcterms:identifier>CS-NA-IN-003</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</dcterms:modified>
        <dcterms:source>Rutherford et al. 2020</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cubic Spline</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:definition xml:lang="en">A cubic spline is a smooth curve made of cubic polynomial pieces joined at knots, used in health economics to fit flexible survival and hazard curves.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Piecewise Cubic</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Smooth Spline Fit</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cubic Spline</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/fractional-polynomial"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-12"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cubic-spline"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <dcterms:identifier>HEO-L-4c41ba795f18</dcterms:identifier>
        <linkRationale xml:lang="en">A flexible curve-fitting method used in statistical analysis</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
