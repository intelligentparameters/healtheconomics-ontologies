    <!-- https://healtheconomics.wiki/concept/barthel-index -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/barthel-index">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome-assessment"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/non-preference-based-measure"/>
