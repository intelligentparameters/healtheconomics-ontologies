    <!-- https://healtheconomics.wiki/concept/cognitive-decline -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cognitive-decline">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/neurological-disease-economics"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/neurological-disease-economics"/>
        <skos:notation>HE-PE-NR-002</skos:notation>
        <dcterms:identifier>HE-PE-NR-002</dcterms:identifier>
        <dcterms:source>WHO 2001</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cognitive Decline</rdfs:label>
        <skos:definition xml:lang="en">A reduction in mental abilities, including memory, attention, and problem-solving, ranging from normal ageing to severe impairment such as dementia.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cognitive Impairment</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Mental Decline</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cognitive Decline</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/dependency"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cognitive-decline"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/neurological-disease-economics"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-2f200ca3e18b</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: curated: review B: disease or clinical specialty term; a disease is not an evidence synthesis method; classify under its disease-area economics concept</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cognitive-decline"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/dependency"/>
        <dcterms:identifier>HEO-L-f8389bdec292</dcterms:identifier>
        <linkRationale xml:lang="en">Dependency is needing help with daily activities due to physical or cognitive limitations (object definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/cognitive-function -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cognitive-function">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/mental-functioning"/>
        <skos:notation>HE-ES-CO-010</skos:notation>
        <dcterms:identifier>HE-ES-CO-010</dcterms:identifier>
        <dcterms:source>U.S. Food and Drug Administration. Guidance for Industry: Patient-Reported Outcome Measures-Use in Medical Product Development to Support Labeling Claims. FDA; 2009.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cognitive Function</rdfs:label>
        <skos:definition xml:lang="en">A clinical outcome domain capturing mental processes, including memory, attention, and executive function, commonly measured using standardised neuropsychological tools.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cognition</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Cognitive Ability</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Cognitive Capacity</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Mental Function</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cognitive Function</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cognitive-function"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-be7f00620502</dcterms:identifier>
