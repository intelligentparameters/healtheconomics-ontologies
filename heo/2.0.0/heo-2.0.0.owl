    <!-- https://healtheconomics.wiki/concept/remission -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/remission">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
