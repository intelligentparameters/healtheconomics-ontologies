        <informs rdf:resource="https://healtheconomics.wiki/concept/only-in-research"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/research-prioritisation"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
