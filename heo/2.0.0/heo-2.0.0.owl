        <dcterms:identifier>HS-HP-HTA-067</dcterms:identifier>
        <dcterms:source>National Institute for Health and Care Excellence. NICE technology appraisal and highly specialised technologies guidance: the manual (PMG36). Published 2022; updated 2026.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Draft Recommendation</rdfs:label>
        <skos:definition xml:lang="en">A preliminary funding decision issued before a final decision, typically released for public and stakeholder consultation and comment.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Preliminary Recommendation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Provisional Decision</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Draft Recommendation</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/final-recommendation"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
