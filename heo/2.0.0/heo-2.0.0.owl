    <!-- https://healtheconomics.wiki/concept/time-on-treatment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/time-on-treatment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/time-to-event"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/treatment-duration"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/time-to-event"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/treatment-duration"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/drug-cost"/>
        <skos:notation>HE-PE-DT-051</skos:notation>
        <dcterms:identifier>HE-PE-DT-051</dcterms:identifier>
        <dcterms:source>Katzung 2017</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Time on Treatment</rdfs:label>
        <skos:altLabel xml:lang="en">ToT</skos:altLabel>
        <skos:definition xml:lang="en">The duration a patient continues receiving a specific therapy before discontinuation, whether from progression, intolerable effects, or achieving the treatment goal.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Duration on Therapy</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Time on Treatment</skos:prefLabel>
        <abbreviation xml:lang="en">ToT</abbreviation>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/time-on-treatment"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/time-to-event"/>
        <dcterms:identifier>HEO-L-8f93d26e1874</dcterms:identifier>
        <linkRationale xml:lang="en">Time on treatment is a duration until discontinuation, a time-to-event outcome.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
