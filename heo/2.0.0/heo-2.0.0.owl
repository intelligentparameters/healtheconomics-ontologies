    <!-- https://healtheconomics.wiki/concept/wellbeing-or-capability-instrument -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/wellbeing-or-capability-instrument">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcome-measure"/>
