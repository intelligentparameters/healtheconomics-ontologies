        <informs rdf:resource="https://healtheconomics.wiki/concept/decision"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/research-prioritisation"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/population-evpi"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/nested-loop"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/psa"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/value-of-information"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
