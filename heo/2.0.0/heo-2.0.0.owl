        <rdfs:label xml:lang="en">Personal Health Record</rdfs:label>
        <skos:altLabel xml:lang="en">PHR</skos:altLabel>
        <skos:definition xml:lang="en">A digital health record controlled and maintained by the patient themselves, unlike an electronic medical record controlled by a healthcare organisation.</skos:definition>
