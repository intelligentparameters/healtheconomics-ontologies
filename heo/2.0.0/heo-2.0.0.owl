    <!-- https://healtheconomics.wiki/concept/cost-effectiveness-policy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cost-effectiveness-policy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <skos:notation>HS-HP-PA-003</skos:notation>
        <dcterms:identifier>HS-HP-PA-003</dcterms:identifier>
        <dcterms:source>Claxton et al. 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cost-Effectiveness Policy</rdfs:label>
        <skos:definition xml:lang="en">A policy analysis approach comparing costs and non-monetary outcomes, such as health gains, without converting outcomes into monetary terms.</skos:definition>
        <skos:hiddenLabel xml:lang="en">CE Policy Analysis</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Cost-Effectiveness Appraisal Policy</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cost-Effectiveness Policy</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/cost-benefit-policy"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-policy"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <dcterms:identifier>HEO-L-4dcbf167eda6</dcterms:identifier>
        <linkRationale xml:lang="en">CEA applied to policy options</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
