        <abbreviation xml:lang="en">CMO</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/curative-therapy"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
