    <!-- https://healtheconomics.wiki/concept/time-horizon -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/time-horizon">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
