    <!-- https://healtheconomics.wiki/concept/telemedicine -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/telemedicine">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
