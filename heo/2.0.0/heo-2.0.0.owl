    <!-- https://healtheconomics.wiki/concept/shared-care -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/shared-care">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/integrated-care"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q7489543"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/integrated-care"/>
        <skos:notation>HS-SS_IC-005</skos:notation>
        <dcterms:identifier>HS-SS_IC-005</dcterms:identifier>
        <dcterms:source>Starfield 1998</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Shared Care</rdfs:label>
        <skos:definition xml:lang="en">A delivery model explicitly sharing responsibility for a patient&apos;s ongoing care between a primary care provider and a specialist, with defined roles.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Collaborative Care Arrangement</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Joint Care Management</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Shared Care</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/care-coordination"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/shared-care"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/integrated-care"/>
        <dcterms:identifier>HEO-L-7ff1f43c3d12</dcterms:identifier>
        <linkRationale xml:lang="en">Shared care is one kind of integrated care model, sharing responsibility across providers</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/shared-care"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/care-coordination"/>
        <dcterms:identifier>HEO-L-01bc904c2492</dcterms:identifier>
        <linkRationale xml:lang="en">Shared responsibility between primary care and specialist depends on coordinated roles</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/shared-decision-making -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/shared-decision-making">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/patient-centred-care"/>
        <skos:notation>HS-HP-PCC-005</skos:notation>
        <dcterms:identifier>HS-HP-PCC-005</dcterms:identifier>
        <dcterms:source>Charles, Gafni &amp; Whelan 1997</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Shared Decision Making</rdfs:label>
        <skos:altLabel xml:lang="en">SDM</skos:altLabel>
        <skos:definition xml:lang="en">A collaborative process in which clinician and patient work together, combining best evidence with the patient&apos;s own values and preferences.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Collaborative Decision Making</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Shared Decision Making</skos:prefLabel>
        <abbreviation xml:lang="en">SDM</abbreviation>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/informed-choice"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/decision-aid"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/treatment-preference"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/shared-decision-making"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-af0ee779028a</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Patient-Centered Care: organisation and delivery of care is the Health Systems subdomain (Organisation and governance)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/shared-decision-making"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/patient-centred-care"/>
        <dcterms:identifier>HEO-L-3ae0eae27042</dcterms:identifier>
        <linkRationale xml:lang="en">Shared decision making is a component of patient-centred care (both definitions)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
