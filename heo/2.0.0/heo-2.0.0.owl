    <!-- https://healtheconomics.wiki/concept/discrete-choice-experiment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/discrete-choice-experiment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
