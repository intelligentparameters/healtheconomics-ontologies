        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/external-validity-of-valuation"/>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/stated-preference"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/hypothetical-bias"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/bias"/>
        <dcterms:identifier>HEO-L-3b18f07c3da4</dcterms:identifier>
        <linkRationale xml:lang="en">A systematic error, so a bias.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
