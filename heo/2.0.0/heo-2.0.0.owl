    <!-- https://healtheconomics.wiki/concept/post-test-probability -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/post-test-probability">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/posterior-probability"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/posterior-probability"/>
        <skos:notation>HE-ES-RM-025</skos:notation>
        <dcterms:identifier>HE-ES-RM-025</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Sackett et al. 1991</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Post-Test Probability</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">The updated probability that a patient has a condition after a diagnostic test result is known, combining pre-test probability with the likelihood ratio.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Post-Test Risk</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Updated Diagnostic Probability</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Post-Test Probability</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/likelihood-ratio"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/post-test-probability"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/posterior-probability"/>
        <dcterms:identifier>HEO-L-150312f2b8a7</dcterms:identifier>
        <linkRationale xml:lang="en">A post-test probability is a posterior probability in the diagnostic setting</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/post-test-probability"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/likelihood-ratio"/>
        <dcterms:identifier>HEO-L-8c1709997182</dcterms:identifier>
        <linkRationale xml:lang="en">Post-test probability combines pre-test probability with the likelihood ratio</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/posterior-distribution -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/posterior-distribution">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/credible-interval"/>
        <skos:notation>HE-ES-SA-159</skos:notation>
        <dcterms:identifier>HE-ES-SA-159</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Bayes 1763</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Posterior Distribution</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">In Bayesian statistics, the updated probability distribution for a parameter after combining a prior distribution with the likelihood of observed data.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Posterior</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Updated Distribution</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Posterior Distribution</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/prior-distribution"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/posterior-distribution"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-1de445128891</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Statistical methods in subdomain Evidence Synthesis; placed under Statistical Method, the concept named by its wiki topic</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/posterior-distribution"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/credible-interval"/>
        <dcterms:identifier>HEO-L-843f6acb307f</dcterms:identifier>
        <linkRationale xml:lang="en">A credible interval is read from posterior quantiles</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
