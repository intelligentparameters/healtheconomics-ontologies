    <!-- https://healtheconomics.wiki/concept/sustained-outcome -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/sustained-outcome">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/long-term-outcome"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/long-term-outcome"/>
        <skos:notation>HE-ES-CO-080</skos:notation>
        <dcterms:identifier>HE-ES-CO-080</dcterms:identifier>
        <dcterms:source>FDA 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Sustained Outcome</rdfs:label>
        <skos:definition xml:lang="en">A clinical or economic outcome that persists over an extended period following treatment, rather than a transient improvement that soon reverses.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Lasting Outcome</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Maintained Outcome</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Sustained Outcome</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/sustained-outcome"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/long-term-outcome"/>
        <dcterms:identifier>HEO-L-d93e224f4f5e</dcterms:identifier>
        <linkRationale xml:lang="en">The definition covers economic as well as clinical outcomes that persist over an extended period, which is a long-term outcome.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


