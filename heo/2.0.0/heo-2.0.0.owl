    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/warranted-variation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/warranted-variation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-practice-variation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/clinical-practice-variation"/>
        <skos:notation>HS-NHS-HQ-086</skos:notation>
        <dcterms:identifier>HS-NHS-HQ-086</dcterms:identifier>
        <dcterms:source>Wennberg &amp; Gittelsohn 1973</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Warranted Variation</rdfs:label>
        <skos:definition xml:lang="en">Differences in utilisation or practice that appropriately reflect legitimate differences in patient illness or informed preference, unlike unwarranted variation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Appropriate Variation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Justified Variation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Warranted Variation</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/unwarranted-variation"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/warranted-variation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/clinical-practice-variation"/>
        <dcterms:identifier>HEO-L-a6f3f4659c84</dcterms:identifier>
        <linkRationale xml:lang="en">Warranted variation is clinical practice variation.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/warranted-variation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/unwarranted-variation"/>
        <dcterms:identifier>HEO-L-3ef5791697e1</dcterms:identifier>
        <linkRationale xml:lang="en">Warranted and unwarranted variation are opposites.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/washout-period -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/washout-period">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/crossover-trial"/>
        <skos:notation>HE-ES-CTM-102</skos:notation>
        <dcterms:identifier>HE-ES-CTM-102</dcterms:identifier>
        <dcterms:source>Friedman LM, Furberg CD, DeMets DL, Reboussin DM, Granger CB. Fundamentals of Clinical Trials. 5th ed. Springer; 2015. doi:10.1007/978-3-319-18539-2.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Washout Period</rdfs:label>
        <skos:altLabel xml:lang="en">Wash-Out Period</skos:altLabel>
        <skos:definition xml:lang="en">A period with no treatment given in a crossover trial between two active phases, letting the first treatment&apos;s effects fully dissipate.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Clearance Period</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Washout Period</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/carryover-effect"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/washout-period"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
