        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">HALY</skos:altLabel>
        <skos:definition xml:lang="en">A general term for outcome measures, including the QALY and DALY, combining length of life with a weighting for quality or disability into one unit.</skos:definition>
