    <!-- https://healtheconomics.wiki/concept/generic-drug -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/generic-drug">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
