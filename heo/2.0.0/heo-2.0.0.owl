        <dcterms:identifier>HEO-L-da1cea4d1abe</dcterms:identifier>
        <linkRationale xml:lang="en">Verbal consent can be informed consent.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
