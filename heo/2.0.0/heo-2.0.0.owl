    <!-- https://healtheconomics.wiki/concept/friction-cost-method -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/friction-cost-method">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/productivity-cost"/>
        <skos:notation>HS-DC-ICM-001</skos:notation>
        <dcterms:identifier>HS-DC-ICM-001</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Koopmanschap et al. 1995</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Friction Cost Method</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">FCM</skos:altLabel>
        <skos:altLabel xml:lang="en">Friction Cost Approach</skos:altLabel>
        <skos:definition xml:lang="en">A productivity loss valuation approach estimating only the cost of the finite period needed to restore normal production, generally lower than human capital estimates.</skos:definition>
        <skos:prefLabel xml:lang="en">Friction Cost Method</skos:prefLabel>
        <abbreviation xml:lang="en">FCM</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/human-capital-approach"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/costs#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/friction-cost-method"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-77ffd7ba5740</dcterms:identifier>
