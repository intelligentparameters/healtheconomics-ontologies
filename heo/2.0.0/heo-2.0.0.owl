    <!-- https://healtheconomics.wiki/concept/jackknife -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/jackknife">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/resampling"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/resampling"/>
        <skos:notation>HE-ES-SA-088</skos:notation>
        <dcterms:identifier>HE-ES-SA-088</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Tukey 1958</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Jackknife</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A resampling technique estimating a statistic&apos;s variability by systematically recalculating it after removing one observation at a time.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Leave-One-Out Estimation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Quenouille Method</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Jackknife</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/jackknife-standard-error"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/jackknife"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/resampling"/>
        <dcterms:identifier>HEO-L-75d3bfce889a</dcterms:identifier>
        <linkRationale xml:lang="en">Object definition names the jackknife</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/jackknife"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#produces"/>
