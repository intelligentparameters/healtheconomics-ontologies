        <skos:notation>HS-SS_HSP-011</skos:notation>
        <dcterms:identifier>HS-SS_HSP-011</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-03</dcterms:modified>
        <dcterms:source>Valdmanis et al. 2004</dcterms:source>
