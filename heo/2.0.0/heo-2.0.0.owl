    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/ceiling-effect -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/ceiling-effect">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/measurement-error"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1181915"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/measurement-error"/>
        <skos:notation>HE-EE-HU-008</skos:notation>
        <dcterms:identifier>HE-EE-HU-008</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-09</dcterms:modified>
        <dcterms:source>Terwee et al. 2007</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Ceiling Effect</rdfs:label>
        <owl:versionInfo>1.0.3</owl:versionInfo>
        <skos:definition xml:lang="en">A ceiling effect is a measurement limitation in which many respondents score at the top of a health scale, so further improvement cannot be detected.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Ceiling Limitation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Score Ceiling</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Ceiling Effect</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/floor-effect"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/responsiveness"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/eq-5d-3l"/>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/patient-reported-outcome"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/ceiling-effect"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/measurement-error"/>
        <dcterms:identifier>HEO-L-f9494f1f8b9f</dcterms:identifier>
        <linkRationale xml:lang="en">Scores capped at the top misstate the true value, a measurement error (both definitions)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/ceiling-effect"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/floor-effect"/>
        <dcterms:identifier>HEO-L-33d5fc06aa1c</dcterms:identifier>
        <linkRationale xml:lang="en">Ceiling and floor effects are the opposite ends of the same scale limitation (both definitions)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/ceiling-effect"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/responsiveness"/>
        <dcterms:identifier>HEO-L-88e4510ae042</dcterms:identifier>
        <linkRationale xml:lang="en">Top-scoring respondents cannot register improvement, lowering responsiveness (Terwee et al. 2007)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/ceiling-effect"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#threatensValidityOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/eq-5d-3l"/>
        <dcterms:identifier>HEO-L-2b1745c58735</dcterms:identifier>
        <linkRationale xml:lang="en">The 3L ceiling effect motivated the five-level version (Herdman et al. 2011)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/ceiling-effect"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#threatensValidityOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/patient-reported-outcome"/>
        <dcterms:identifier>HEO-L-0b0f79fbd189</dcterms:identifier>
        <linkRationale xml:lang="en">Ceiling effects undermine detection of change in PRO instruments (Terwee et al. 2007)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/cell-therapy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cell-therapy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/biological-therapy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/biological-therapy"/>
        <skos:notation>HE-PE-AT-003</skos:notation>
        <dcterms:identifier>HE-PE-AT-003</dcterms:identifier>
        <dcterms:source>Jørgensen &amp; Kefalas 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cell Therapy</rdfs:label>
        <skos:altLabel xml:lang="en">Cell-Based Therapy</skos:altLabel>
        <skos:altLabel xml:lang="en">Cellular Therapy</skos:altLabel>
        <skos:definition xml:lang="en">A treatment involving the administration of living cells, such as genetically modified immune cells or stem cells, to treat or potentially cure a disease.</skos:definition>
        <skos:prefLabel xml:lang="en">Cell Therapy</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cell-therapy"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/biological-therapy"/>
        <dcterms:identifier>HEO-L-6f19e2e66880</dcterms:identifier>
        <linkRationale xml:lang="en">Not every cell therapy is an EU ATMP (minimally manipulated transplants are not); all are biological therapies</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/censoring -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/censoring">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:notation>HE-EM-SM-006</skos:notation>
        <dcterms:identifier>HE-EM-SM-006</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-09</dcterms:modified>
        <dcterms:source>Clark et al. 2003</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Censoring</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Censoring in survival analysis occurs when a patient&apos;s time to an event is only partly known, for example still event-free when trial follow-up ends.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Censored Data</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Censored Observation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Censoring</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/truncation"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-5"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/time-to-event"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/censoring"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-90be0aa6ce6b</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Survival analysis and extrapolation in subdomain Economic Modelling</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/censoring"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/truncation"/>
        <dcterms:identifier>HEO-L-0dc34b85fc63</dcterms:identifier>
        <linkRationale xml:lang="en">Censoring (partly observed times) and truncation (excluded observations) are distinct incomplete-data problems</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/censoring"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isPropertyOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/time-to-event"/>
        <dcterms:identifier>HEO-L-64323ea53186</dcterms:identifier>
        <linkRationale xml:lang="en">Censoring characterises time-to-event data (object definition says possibly censored)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/census-data -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/census-data">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cross-sectional-data"/>
