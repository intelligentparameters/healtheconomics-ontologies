        <dcterms:identifier>HS-SS-GH-029</dcterms:identifier>
        <dcterms:source>Last 2001</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Tertiary Prevention</rdfs:label>
        <skos:definition xml:lang="en">Preventive intervention aimed at reducing the impact of already established disease, such as rehabilitation preventing further complications or disability.</skos:definition>
