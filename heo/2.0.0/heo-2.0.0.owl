        <skos:hiddenLabel xml:lang="en">Routine-Practice Data</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Real-World Data</skos:prefLabel>
        <abbreviation xml:lang="en">RWD</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/synthetic-data"/>
