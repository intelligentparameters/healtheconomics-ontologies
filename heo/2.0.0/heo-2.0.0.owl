        <skos:altLabel xml:lang="en">Constant Sum Method</skos:altLabel>
        <skos:definition xml:lang="en">The point allocation method asks respondents to divide a fixed total of points, often 100, among health outcomes or criteria to show their relative value.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Fixed-Total Allocation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Point Allocation</skos:hiddenLabel>
