    <!-- https://healtheconomics.wiki/concept/control-arm -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/control-arm">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
