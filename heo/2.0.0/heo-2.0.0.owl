    <!-- https://healtheconomics.wiki/concept/generation-time -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/generation-time">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/epidemiology"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/epidemiology"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/basic-reproduction-number"/>
        <skos:notation>HE-ES-EP-017</skos:notation>
        <dcterms:identifier>HE-ES-EP-017</dcterms:identifier>
        <dcterms:source>Anderson &amp; May 1991</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Generation Time</rdfs:label>
        <skos:altLabel xml:lang="en">Generation Interval</skos:altLabel>
        <skos:definition xml:lang="en">The average time interval between the onset of infection in one person and the onset of infection in those they subsequently infect.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Transmission Interval</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Generation Time</skos:prefLabel>
        <counterpartOf rdf:resource="https://healtheconomics.wiki/concept/serial-interval"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/generation-time"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/epidemiology"/>
