    <!-- https://healtheconomics.wiki/concept/actuarial-value -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/actuarial-value">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:notation>HS-HP-HI-003</skos:notation>
        <dcterms:identifier>HS-HP-HI-003</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
