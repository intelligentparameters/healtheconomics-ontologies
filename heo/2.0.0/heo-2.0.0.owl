    <!-- https://healtheconomics.wiki/concept/demand-forecasting -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/demand-forecasting">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-SS_HD-006</skos:notation>
        <dcterms:identifier>HS-SS_HD-006</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-02</dcterms:modified>
        <dcterms:source>Hyndman &amp; Athanasopoulos 2021</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Demand Forecasting</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Demand forecasting projects future use of health services and medicines, and the staff needed, from past utilisation, population change and other drivers.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Service-Demand Projection</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Utilisation Forecasting</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Demand Forecasting</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/budget-impact-analysis"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/capacity-planning"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/health-planning"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/workforce-planning"/>
