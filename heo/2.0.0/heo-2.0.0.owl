    <!-- https://healtheconomics.wiki/concept/self-referral -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/self-referral">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/conflict-of-interest"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/referral"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/conflict-of-interest"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/referral"/>
        <skos:notation>HS-HP-IC-033</skos:notation>
        <dcterms:identifier>HS-HP-IC-033</dcterms:identifier>
        <dcterms:source>US, Stark Law (Physician Self-Referral Law)</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Self-Referral</rdfs:label>
        <skos:definition xml:lang="en">A situation where a physician refers a patient to a facility in which they have a financial interest, raising conflict of interest concerns.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Physician Financial Referral</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Referral to Owned Facility</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Self-Referral</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/supplier-induced-demand"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/self-referral"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/conflict-of-interest"/>
        <dcterms:identifier>HEO-L-37a7fe87833c</dcterms:identifier>
        <linkRationale xml:lang="en">Self-referral to a facility in which the physician has a financial interest is a clinical conflict of interest the IOM recognises</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/self-referral"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/referral"/>
        <dcterms:identifier>HEO-L-4d630e794e25</dcterms:identifier>
        <linkRationale xml:lang="en">Self-referral is a referral made to an entity the physician has a financial interest in.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/self-referral"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/supplier-induced-demand"/>
        <dcterms:identifier>HEO-L-c021c7f931c3</dcterms:identifier>
