    <!-- https://healtheconomics.wiki/concept/targeting-policy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/targeting-policy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:notation>HS-HP-HI-194</skos:notation>
        <dcterms:identifier>HS-HP-HI-194</dcterms:identifier>
        <dcterms:source>Cornia &amp; Stewart 1993</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Targeting Policy</rdfs:label>
        <skos:definition xml:lang="en">A policy governing how a programme directs benefits toward a specific population, using means testing, categorical eligibility, or geographic targeting.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Selective Allocation Policy</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Targeting Approach</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Targeting Policy</skos:prefLabel>
