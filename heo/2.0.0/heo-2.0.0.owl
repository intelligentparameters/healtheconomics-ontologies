    <!-- https://healtheconomics.wiki/concept/conditional-approval -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/conditional-approval">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
