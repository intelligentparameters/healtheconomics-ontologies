        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Monopoly</rdfs:label>
        <skos:definition xml:lang="en">A market structure in which a single seller controls the entire supply of a good, allowing prices above what competition would produce.</skos:definition>
