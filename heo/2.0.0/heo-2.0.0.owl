    <!-- https://healtheconomics.wiki/concept/asset-efficiency -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/asset-efficiency">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/efficiency"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/operational-efficiency"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/efficiency"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/operational-efficiency"/>
        <skos:notation>HS-SS_HSP-003</skos:notation>
        <dcterms:identifier>HS-SS_HSP-003</dcterms:identifier>
        <dcterms:source>Horngren, Datar &amp; Rajan 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Asset Efficiency</rdfs:label>
        <skos:definition xml:lang="en">A measure of how effectively an organisation uses its physical and financial assets, such as equipment, to generate patient care activity.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Asset Utilisation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Capital Efficiency</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Asset Efficiency</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/asset-efficiency"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/efficiency"/>
        <dcterms:identifier>HEO-L-33f1ac23b630</dcterms:identifier>
        <linkRationale xml:lang="en">Efficient use of physical and financial assets is a form of efficiency</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/asset-efficiency"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/operational-efficiency"/>
        <dcterms:identifier>HEO-L-9840a6dbb8f8</dcterms:identifier>
        <linkRationale xml:lang="en">Asset use for activity is one form of operational efficiency, as labour efficiency is</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/asset-sale -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/asset-sale">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/coping-strategy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/coping-strategy"/>
        <skos:notation>HS-HP-HF-001</skos:notation>
        <dcterms:identifier>HS-HP-HF-001</dcterms:identifier>
        <dcterms:source>Musgrave &amp; Musgrave 1989</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Asset Sale</rdfs:label>
        <skos:definition xml:lang="en">The sale of household property to cover healthcare costs, a coping strategy used when other financial resources are insufficient.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Distress Sale</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Property Sale</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Asset Sale</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/impoverishment"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/asset-sale"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/coping-strategy"/>
        <dcterms:identifier>HEO-L-59d0afb66089</dcterms:identifier>
        <linkRationale xml:lang="en">Coping strategy definition names selling assets</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/asset-sale"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/impoverishment"/>
        <dcterms:identifier>HEO-L-c6138c26a465</dcterms:identifier>
