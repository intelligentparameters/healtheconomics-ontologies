    <!-- https://healtheconomics.wiki/concept/positive-list -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/positive-list">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/formulary"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/formulary"/>
        <skos:notation>HS-DC-MA-023</skos:notation>
        <dcterms:identifier>HS-DC-MA-023</dcterms:identifier>
        <dcterms:source>Danzon 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Positive List</rdfs:label>
        <skos:definition xml:lang="en">A list explicitly specifying which medications or services are covered under a health plan, unlike a negative list specifying exclusions.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Inclusion List</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Reimbursement List</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Positive List</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/reimbursement"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/positive-list"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/formulary"/>
        <dcterms:identifier>HEO-L-04f2815e3b44</dcterms:identifier>
        <linkRationale xml:lang="en">A positive list is a kind of formulary that names covered items (both definitions)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/positive-list"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#setsScopeOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/reimbursement"/>
        <dcterms:identifier>HEO-L-76ea159c183b</dcterms:identifier>
        <linkRationale xml:lang="en">A positive list determines which products are reimbursed</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
