        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Systems Strengthening &gt; Healthcare Delivery: health system strengthening is the Health Systems subdomain</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
