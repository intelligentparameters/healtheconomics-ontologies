    <!-- https://healtheconomics.wiki/concept/relative-effectiveness -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/relative-effectiveness">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/comparative-effectiveness-research"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/comparative-effectiveness-research"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/effectiveness"/>
        <skos:notation>HE-ES-CER-024</skos:notation>
        <dcterms:identifier>HE-ES-CER-024</dcterms:identifier>
        <dcterms:source>Institute of Medicine. Initial National Priorities for Comparative Effectiveness Research. National Academies Press; 2009. doi:10.17226/12648.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Relative Effectiveness</rdfs:label>
        <skos:definition xml:lang="en">A measure comparing how well a treatment performs against an alternative under real-world practice conditions, unlike relative efficacy measured under trial conditions.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Head-to-Head Effectiveness</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">REA Result</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Relative Effectiveness</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/added-therapeutic-value"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/relative-effectiveness"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/comparative-effectiveness-research"/>
