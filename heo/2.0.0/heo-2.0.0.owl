        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Deprescribing</rdfs:label>
        <skos:definition xml:lang="en">The planned, supervised process of reducing or stopping a medication no longer beneficial or causing harm, managing polypharmacy and related risk.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Medication Withdrawal</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Planned Dose Reduction</skos:hiddenLabel>
