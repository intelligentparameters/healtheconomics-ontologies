        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/market-exclusivity"/>
        <dcterms:identifier>HEO-L-ae03365f372c</dcterms:identifier>
        <linkRationale xml:lang="en">Orphan exclusivity is a regulatory market exclusivity period</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
