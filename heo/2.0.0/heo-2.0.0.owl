        <dcterms:identifier>HEO-L-223ec34baef5</dcterms:identifier>
        <linkRationale xml:lang="en">digital health technologies fall within the health technology definition</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
