        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:notation>HS-HP-HTA-279</skos:notation>
        <dcterms:identifier>HS-HP-HTA-279</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</dcterms:modified>
        <dcterms:source>EUnetHTA 2016</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Autonomy</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:altLabel xml:lang="en">Patient Autonomy</skos:altLabel>
        <skos:definition xml:lang="en">Autonomy is the ethical principle that people able to decide may make informed, voluntary choices about their own care, weighed in HTA ethical analysis.</skos:definition>
        <skos:prefLabel xml:lang="en">Autonomy</skos:prefLabel>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/informed-consent"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/shared-decision-making"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/autonomy"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
