        <dcterms:identifier>HEO-L-27409454e2af</dcterms:identifier>
        <linkRationale xml:lang="en">fixes a type-of loop: the weighted tests generalise the log-rank test, not the reverse (16 Oct 2026)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
