    <!-- https://healtheconomics.wiki/concept/remembered-utility -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/remembered-utility">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/utility"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/utility"/>
        <skos:notation>HE-EE-HU-065</skos:notation>
        <dcterms:identifier>HE-EE-HU-065</dcterms:identifier>
        <dcterms:source>Kahneman, Wakker &amp; Sarin 1997</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Remembered Utility</rdfs:label>
        <skos:definition xml:lang="en">The retrospective evaluation a person gives of a past experience or health state, which can differ from the utility actually experienced at the time.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Recalled Utility</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Retrospective Utility</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Remembered Utility</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/experienced-utility"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/remembered-utility"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/utility"/>
        <dcterms:identifier>HEO-L-95462ced5342</dcterms:identifier>
        <linkRationale xml:lang="en">Remembered utility is a form of utility (retrospective evaluation).</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/remembered-utility"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/experienced-utility"/>
        <dcterms:identifier>HEO-L-e5723b2abb07</dcterms:identifier>
