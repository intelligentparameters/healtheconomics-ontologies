    <!-- https://healtheconomics.wiki/concept/acquisition-cost -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/acquisition-cost">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/direct-cost"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/direct-cost"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/drug-cost"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/budget-impact"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/incremental-cost"/>
        <skos:notation>HS-DC-DAA-001</skos:notation>
        <dcterms:identifier>HS-DC-DAA-001</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-03</dcterms:modified>
        <dcterms:source>Hay et al. 2010</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Acquisition Cost</rdfs:label>
        <owl:versionInfo>1.0.5</owl:versionInfo>
        <skos:definition xml:lang="en">Acquisition cost is what a payer spends to buy a drug, at the price actually paid after any discounts, excluding administration and monitoring costs.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Invoice Cost</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Purchase Cost</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Acquisition Cost</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/list-price"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/costs#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/acquisition-cost"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/direct-cost"/>
        <dcterms:identifier>HEO-L-4925f089c3d5</dcterms:identifier>
        <linkRationale xml:lang="en">Drug purchase is a resource used for care (Direct Cost definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
