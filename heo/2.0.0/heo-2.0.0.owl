        <dcterms:identifier>HS-NHS-HQ-005</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Fitch et al. 2001</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Appropriateness Criteria</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Appropriate Use Criteria</skos:altLabel>
        <skos:definition xml:lang="en">Appropriateness criteria are expert panel ratings of when a procedure&apos;s benefit exceeds its harms enough to be worth doing, exclusive of cost.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Appropriateness Standards</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Appropriateness Criteria</skos:prefLabel>
        <benchmarkFor rdf:resource="https://healtheconomics.wiki/concept/appropriateness"/>
        <benchmarkFor rdf:resource="https://healtheconomics.wiki/concept/underuse"/>
