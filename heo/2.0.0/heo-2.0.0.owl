    <!-- https://healtheconomics.wiki/concept/fee-freeze -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/fee-freeze">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-containment"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/price-control"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cost-containment"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/price-control"/>
        <skos:notation>HS-HP-PP-047</skos:notation>
        <dcterms:identifier>HS-HP-PP-047</dcterms:identifier>
        <dcterms:source>Musgrave &amp; Musgrave 1989</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Fee Freeze</rdfs:label>
        <skos:definition xml:lang="en">A regulatory or contractual action preventing fee schedule rates from increasing for a specified period, a cost-containment mechanism.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Fee Rate Freeze</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Payment Freeze</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Fee Freeze</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/fee-schedule"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
