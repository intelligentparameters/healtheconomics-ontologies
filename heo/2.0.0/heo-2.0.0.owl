    <!-- https://healtheconomics.wiki/concept/timely-access -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/timely-access">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/access-to-care"/>
        <skos:notation>HS-HP-HE-032</skos:notation>
        <dcterms:identifier>HS-HP-HE-032</dcterms:identifier>
        <dcterms:source>Penchansky R, Thomas JW. The concept of access: definition and relationship to consumer satisfaction. Medical Care. 1981;19(2):127-140. doi:10.1097/00005650-198102000-00001.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Timely Access</rdfs:label>
        <skos:altLabel xml:lang="en">Timeliness of Care</skos:altLabel>
        <skos:definition xml:lang="en">A healthcare access dimension concerning whether patients can obtain needed care within a clinically appropriate timeframe, including wait times.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Prompt Access</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Timely Access</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/timely-access"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-ec3bbdd1be66</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health Equity: catalogue group Health Policy is one of the subdomains</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/timely-access"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/access-to-care"/>
        <dcterms:identifier>HEO-L-80ee92498af8</dcterms:identifier>
        <linkRationale xml:lang="en">Only link; the subject definition calls timeliness a dimension of access, which the Access to Care concept covers</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/tipping-point-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/tipping-point-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/threshold-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/threshold-analysis"/>
        <skos:notation>HE-ES-SA-218</skos:notation>
        <dcterms:identifier>HE-ES-SA-218</dcterms:identifier>
        <dcterms:source>Carpenter &amp; Kenward 2013</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Tipping Point Analysis</rdfs:label>
        <skos:altLabel xml:lang="en">Tipping-Point Method</skos:altLabel>
        <skos:definition xml:lang="en">A missing data sensitivity technique searching for the specific departure from a standard assumption that would be needed to overturn a study&apos;s conclusion.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Switch-Point Analysis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Tipping Point Analysis</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/delta-adjustment"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/tipping-point-analysis"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/threshold-analysis"/>
        <dcterms:identifier>HEO-L-61c700d663a1</dcterms:identifier>
        <linkRationale xml:lang="en">A tipping point analysis searches for the value that overturns the conclusion, a threshold analysis.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/tipping-point-analysis"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/delta-adjustment"/>
        <dcterms:identifier>HEO-L-14444999c890</dcterms:identifier>
        <linkRationale xml:lang="en">Tipping points are found by increasing the delta shift until the conclusion changes.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/titration -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/titration">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <precedes rdf:resource="https://healtheconomics.wiki/concept/maintenance-dose"/>
        <skos:notation>HE-PE-CP-015</skos:notation>
        <dcterms:identifier>HE-PE-CP-015</dcterms:identifier>
        <dcterms:source>Rowland &amp; Tozer 2010</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Titration</rdfs:label>
        <skos:definition xml:lang="en">The process of gradually adjusting a medication&apos;s dose, usually starting low and increasing, to balance therapeutic effect against tolerability.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Dose Adjustment</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Dose Ramping</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Titration</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/loading-dose"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/titration"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-c159bfc65a97</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Pharmacoeconomics &gt; Clinical Pharmacology: pharmacokinetic and dosing terms describe the clinical evidence behind a treatment effect</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/titration"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#precedes"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/maintenance-dose"/>
        <dcterms:identifier>HEO-L-d7af63261e0b</dcterms:identifier>
        <linkRationale xml:lang="en">Titration is a dose-adjustment process, not the study of drug effects; the titration phase comes before the maintenance dose.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/titration"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/loading-dose"/>
        <dcterms:identifier>HEO-L-dbffe5a0833b</dcterms:identifier>
        <linkRationale xml:lang="en">Start low and increase versus start high to reach target fast.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


