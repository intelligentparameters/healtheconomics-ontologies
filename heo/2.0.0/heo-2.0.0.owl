    <!-- https://healtheconomics.wiki/concept/probability-of-cost-effectiveness -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/probability-of-cost-effectiveness">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/ceac"/>
        <skos:notation>HE-EE-CEA-055</skos:notation>
        <dcterms:identifier>HE-EE-CEA-055</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Fenwick, Claxton &amp; Sculpher 2001</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Probability of Cost-Effectiveness</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Probability CE</skos:altLabel>
        <skos:definition xml:lang="en">The probability of cost-effectiveness is the model-based probability that an intervention meets a stated net-benefit criterion against specified alternatives at a given willingness-to-pay threshold under the assumed uncertainty distribution.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Likelihood of Cost-Effectiveness</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Probability of Cost-Effectiveness</skos:prefLabel>
        <abbreviation xml:lang="en">Probability CE</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/probability-of-cost-effectiveness"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-265f013a1740</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Cost effectiveness analysis in subdomain Economic Evaluation; placed under Cost-Effectiveness Analysis, the concept named by its wiki topic</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/probability-of-cost-effectiveness"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/ceac"/>
        <dcterms:identifier>HEO-L-59cdf8148cd8</dcterms:identifier>
