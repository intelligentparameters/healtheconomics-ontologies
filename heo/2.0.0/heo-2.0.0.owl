    <!-- https://healtheconomics.wiki/concept/urgent-care-centre -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/urgent-care-centre">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
