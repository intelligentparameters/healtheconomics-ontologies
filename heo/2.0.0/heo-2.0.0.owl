    <!-- https://healtheconomics.wiki/concept/nephrology-economics -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/nephrology-economics">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-evaluation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-evaluation"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/health-economics"/>
        <skos:notation>HE-PE-RN-005</skos:notation>
        <dcterms:identifier>HE-PE-RN-005</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Nephrology Economics</rdfs:label>
        <skos:altLabel xml:lang="en">Dialysis Economics</skos:altLabel>
        <skos:definition xml:lang="en">The broad application of health economic evaluation to kidney-related conditions, spanning chronic kidney disease, dialysis, and kidney transplantation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Dialysis Cost-Effectiveness</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Kidney Care Economics</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Renal Disease Economics</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Renal Economics</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Renal Replacement Economics</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Nephrology Economics</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/nephrology-economics"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-evaluation"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-85fc4391fdfd</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: curated: disease-area economics is a wiki topic in Economic Evaluation (Disease-area economics); a field within health economics (partOf), not a type of it</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/nephrology-economics"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-economics"/>
        <dcterms:identifier>HEO-L-5a48c880df43</dcterms:identifier>
