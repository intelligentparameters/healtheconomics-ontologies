    <!-- https://healtheconomics.wiki/concept/major-response -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/major-response">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-response"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/clinical-response"/>
        <skos:notation>HE-ES-CO-041</skos:notation>
        <dcterms:identifier>HE-ES-CO-041</dcterms:identifier>
        <dcterms:source>Baccarani et al. 2013</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Major Response</rdfs:label>
        <skos:definition xml:lang="en">A general term for a substantial, predefined reduction in disease burden following treatment, distinct from a minimal or partial response.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Major Clinical Response</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Marked Response</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Major Response</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/partial-response"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/major-response"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
