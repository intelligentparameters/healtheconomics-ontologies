    <!-- https://healtheconomics.wiki/concept/calibration -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/calibration">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/parameter-estimation"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q736777"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/parameter-estimation"/>
        <skos:notation>HE-EM-MV-006</skos:notation>
        <dcterms:identifier>HE-EM-MV-006</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Stout et al. 2009</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Calibration</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Calibration is the estimation of unobservable or uncertain parameters in a health economic model by adjusting them until model outputs match observed data.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Model Tuning</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Parameter Fitting</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Calibration</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-9"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/bayesian-optimisation"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/genetic-algorithm"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/goodness-of-fit"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/nelder-mead-method"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/numerical-optimisation"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/simulated-annealing"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/calibration"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/parameter-estimation"/>
        <dcterms:identifier>HEO-L-232542862640</dcterms:identifier>
        <linkRationale xml:lang="en">Calibration infers parameter values from data</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
