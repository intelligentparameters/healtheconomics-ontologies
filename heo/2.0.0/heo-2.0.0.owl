        <dcterms:identifier>HE-PE-DT-022</dcterms:identifier>
        <dcterms:source>FDA, Code of Federal Regulations Title 21</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Indication</rdfs:label>
        <skos:definition xml:lang="en">The specific medical condition or use for which a drug has received regulatory approval and is intended to be prescribed.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Approved Use</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Licensed Use</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Indication</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/off-label-use"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/medicinal-product"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/indication"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
