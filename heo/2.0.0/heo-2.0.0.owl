        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/continuous-coverage -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/continuous-coverage">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:notation>HS-HP-HI-047</skos:notation>
        <dcterms:identifier>HS-HP-HI-047</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>US Congress 1996 (29 USC 1181)</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Continuous Coverage</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:definition xml:lang="en">Continuous coverage is health insurance held with no gap longer than a set limit, often 63 days in US law, which can shorten pre-existing exclusions.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Gap-Free Coverage</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Uninterrupted Coverage</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Continuous Coverage</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/insurance-coverage-gap"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/access-to-care"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
