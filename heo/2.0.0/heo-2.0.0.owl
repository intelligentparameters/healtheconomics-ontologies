        <dcterms:source>Kongstvedt 2012</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Retrospective Review</rdfs:label>
        <skos:definition xml:lang="en">A utilisation management assessment conducted after a service has been delivered, evaluating whether it was consistent with coverage criteria.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Look-Back Review</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Post-Service Review</skos:hiddenLabel>
