        <owl:versionInfo>1.0.3</owl:versionInfo>
        <skos:altLabel xml:lang="en">Probability Node</skos:altLabel>
        <skos:definition xml:lang="en">A chance node is a point in a decision tree where an uncertain event, not a choice, decides the pathway, and its branch probabilities sum to one.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Random Node</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Chance Node</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/decision-node"/>
