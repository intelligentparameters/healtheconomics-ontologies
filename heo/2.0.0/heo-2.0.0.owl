        <dcterms:identifier>HS-HP-HSG-027</dcterms:identifier>
        <dcterms:source>National Commission, Belmont Report 1979</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Research Ethics</rdfs:label>
        <skos:definition xml:lang="en">The branch of applied ethics concerned with moral principles governing human subjects research, including respect for persons, beneficence, and justice.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Ethical Research Conduct</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Human-Participant Protection</skos:hiddenLabel>
