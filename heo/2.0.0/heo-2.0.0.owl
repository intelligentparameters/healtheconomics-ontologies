    <!-- https://healtheconomics.wiki/concept/interchangeability -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/interchangeability">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:notation>HS-DC-GC-007</skos:notation>
        <dcterms:identifier>HS-DC-GC-007</dcterms:identifier>
        <dcterms:source>FDA, Biologics Price Competition and Innovation Act 2009</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Interchangeability</rdfs:label>
        <skos:definition xml:lang="en">A general term describing whether one product can be substituted for another with the expectation of producing the same clinical effect.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Product Equivalence</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Substitutability</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Interchangeability</skos:prefLabel>
