    <!-- https://healtheconomics.wiki/concept/composite-endpoint -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/composite-endpoint">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-endpoint"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/clinical-endpoint"/>
        <skos:notation>HE-ES-CTM-018</skos:notation>
        <dcterms:identifier>HE-ES-CTM-018</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>FDA 2022</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Composite Endpoint</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Combined Endpoint</skos:altLabel>
        <skos:altLabel xml:lang="en">Combined Outcome</skos:altLabel>
        <skos:altLabel xml:lang="en">Composite Outcome</skos:altLabel>
        <skos:definition xml:lang="en">A composite endpoint is a trial outcome combining two or more events, such as death or hospitalisation, usually counting a patient once at the first event.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Composite Primary Endpoint</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Multi-Component Outcome</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Composite Endpoint</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/statistical-power"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/composite-endpoint"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/clinical-endpoint"/>
        <dcterms:identifier>HEO-L-140c5f3ad794</dcterms:identifier>
        <linkRationale xml:lang="en">A predefined trial outcome</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/composite-endpoint"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-power"/>
