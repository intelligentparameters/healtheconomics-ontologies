        <dcterms:identifier>HEO-L-21caea86220d</dcterms:identifier>
        <linkRationale xml:lang="en">Definitions contrast independent specialists with a collectively responsible team</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/multidisciplinary-round -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/multidisciplinary-round">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/integrated-care"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/integrated-care"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/multidisciplinary-care"/>
        <skos:notation>HS-HP-IC-024</skos:notation>
        <dcterms:identifier>HS-HP-IC-024</dcterms:identifier>
        <dcterms:source>AHA, American Hospital Association</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Multidisciplinary Round</rdfs:label>
        <skos:altLabel xml:lang="en">MDT Round</skos:altLabel>
        <skos:definition xml:lang="en">A structured process in which clinicians from different specialties collaboratively review a patient&apos;s case together, typically for complex hospitalised patients.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Interdisciplinary Ward Round</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Multidisciplinary Round</skos:prefLabel>
        <abbreviation xml:lang="en">MDT Round</abbreviation>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/care-coordination"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
