    <!-- https://healtheconomics.wiki/concept/disease-free-survival -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/disease-free-survival">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
