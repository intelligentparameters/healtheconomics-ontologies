        <skos:hiddenLabel xml:lang="en">Production-Cost Relationship</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cost Function</skos:prefLabel>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
