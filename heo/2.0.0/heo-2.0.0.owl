        <counterpartOf rdf:resource="https://healtheconomics.wiki/concept/return-on-investment"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/resource-allocation"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
