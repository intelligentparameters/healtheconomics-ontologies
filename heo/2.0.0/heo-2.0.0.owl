        <dcterms:source>Neyman &amp; Pearson 1933</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">One-Tailed Test</rdfs:label>
        <skos:altLabel xml:lang="en">Directional Test</skos:altLabel>
        <skos:altLabel xml:lang="en">One-Sided Test</skos:altLabel>
        <skos:definition xml:lang="en">A hypothesis test assessing evidence for an effect in only one specified direction, requiring strong prior justification for that direction.</skos:definition>
        <skos:prefLabel xml:lang="en">One-Tailed Test</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/two-tailed-test"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/p-value"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/one-tailed-test"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/hypothesis-testing"/>
        <dcterms:identifier>HEO-L-65910c37028c</dcterms:identifier>
        <linkRationale xml:lang="en">A one-tailed test is a kind of hypothesis test, not a component of the framework</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
