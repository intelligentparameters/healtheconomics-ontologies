        <skos:notation>HE-ES-SA-132</skos:notation>
        <dcterms:identifier>HE-ES-SA-132</dcterms:identifier>
        <dcterms:source>Hochberg &amp; Tamhane 1987</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Multiple Comparisons</rdfs:label>
        <skos:altLabel xml:lang="en">Multiple Testing</skos:altLabel>
        <skos:altLabel xml:lang="en">Multiplicity Problem</skos:altLabel>
        <skos:definition xml:lang="en">The statistical concern that conducting several hypothesis tests at once raises the overall chance of a false positive result purely by chance.</skos:definition>
        <skos:prefLabel xml:lang="en">Multiple Comparisons</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/type-i-error"/>
