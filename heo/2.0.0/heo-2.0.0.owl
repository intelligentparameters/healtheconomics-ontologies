    <!-- https://healtheconomics.wiki/concept/moral-hazard -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/moral-hazard">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q44454"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:notation>HE-EE-ME-043</skos:notation>
        <dcterms:identifier>HE-EE-ME-043</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Pauly 1968</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Moral Hazard</rdfs:label>
        <owl:versionInfo>1.0.13</owl:versionInfo>
        <skos:altLabel xml:lang="en">Hidden Action</skos:altLabel>
        <skos:definition xml:lang="en">Moral hazard is the change in behaviour, such as greater use of healthcare, that occurs when insurance shields people from the full cost of their choices.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Post-Contract Opportunism</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Moral Hazard</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/supplier-induced-demand"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/deadweight-loss"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/market-failure"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/induced-innovation"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/moral-hazard"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-6e9fb6412b71</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: curated: moral hazard is an insurance concept, review B</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/moral-hazard"/>
