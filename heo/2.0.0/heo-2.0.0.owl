    <!-- https://healtheconomics.wiki/concept/targeting-efficiency -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/targeting-efficiency">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:notation>HE-EE-HE-016</skos:notation>
        <dcterms:identifier>HE-EE-HE-016</dcterms:identifier>
        <dcterms:source>Cornia &amp; Stewart 1993</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Targeting Efficiency</rdfs:label>
        <skos:definition xml:lang="en">A measure of how effectively a programme directs its benefits to its intended eligible population, typically the share of benefits received by eligible individuals.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Allocation Precision</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Targeting Accuracy</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Targeting Efficiency</skos:prefLabel>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/proxy-means-test"/>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/targeting-policy"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/targeting-policy"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/targeting-efficiency"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-1779705bccbf</dcterms:identifier>
