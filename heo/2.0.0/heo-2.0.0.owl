        <owl:versionInfo>1.0.12</owl:versionInfo>
        <skos:altLabel xml:lang="en">Asymmetric Information</skos:altLabel>
        <skos:definition xml:lang="en">Information asymmetry occurs when one party to an economic decision has more or better information than another, affecting choices, bargaining power and the efficiency of resulting outcomes.</skos:definition>
