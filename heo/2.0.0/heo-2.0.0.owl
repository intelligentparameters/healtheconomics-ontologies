    <!-- https://healtheconomics.wiki/concept/utilitarian-welfare -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/utilitarian-welfare">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/social-welfare-function"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/social-welfare-function"/>
        <skos:notation>HE-EE-WE-023</skos:notation>
        <dcterms:identifier>HE-EE-WE-023</dcterms:identifier>
        <dcterms:source>Bentham 1789</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Utilitarian Welfare</rdfs:label>
        <skos:definition xml:lang="en">A conception of social welfare judging policies by the sum, or average, of individual utility across the population, regardless of distribution.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Sum-Ranking Welfare</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Utilitarianism</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Utilitarian Welfare</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/egalitarian-welfare"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/utilitarian-welfare"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/social-welfare-function"/>
        <dcterms:identifier>HEO-L-b7286d2589a3</dcterms:identifier>
        <linkRationale xml:lang="en">A utilitarian SWF sums individual utility.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/utilitarian-welfare"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
