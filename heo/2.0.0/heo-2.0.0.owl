        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Income Elasticity</skos:altLabel>
        <skos:definition xml:lang="en">A measure of how quantity demanded responds to a change in consumer income, calculated as percentage change in demand over percentage change in income.</skos:definition>
