    <!-- https://healtheconomics.wiki/concept/league-table-construction -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/league-table-construction">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
