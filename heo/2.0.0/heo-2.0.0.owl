    <!-- https://healtheconomics.wiki/concept/hidden-markov-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/hidden-markov-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/state-space-model"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q176769"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/state-space-model"/>
        <skos:notation>HE-EM-MM-009</skos:notation>
        <dcterms:identifier>HE-EM-MM-009</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-23</dcterms:modified>
        <dcterms:source>Rabiner 1989</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Hidden Markov Model</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">HMM</skos:altLabel>
        <skos:altLabel xml:lang="en">Latent Markov Model</skos:altLabel>
        <skos:definition xml:lang="en">A statistical model in which the true underlying state cannot be directly observed, only indicated indirectly and probabilistically by observable data.</skos:definition>
        <skos:prefLabel xml:lang="en">Hidden Markov Model</skos:prefLabel>
        <abbreviation xml:lang="en">HMM</abbreviation>
        <counterpartOf rdf:resource="https://healtheconomics.wiki/concept/latent-transition-analysis"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/latent-variable"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/markov-chain"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/hidden-markov-model"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
