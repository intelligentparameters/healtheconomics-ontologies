    <!-- https://healtheconomics.wiki/concept/quality-adjusted-time-without-symptoms -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/quality-adjusted-time-without-symptoms">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-adjusted-life-year"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-adjusted-life-year"/>
        <skos:notation>HE-EE-QALY-009</skos:notation>
        <dcterms:identifier>HE-EE-QALY-009</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Gelber et al. 1989</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Quality-Adjusted Time Without Symptoms</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Q-TWiST</skos:altLabel>
        <skos:definition xml:lang="en">A quality-weighted survival measure that partitions time into toxicity, time without defined symptoms or toxicity, and time after disease progression, then sums each duration multiplied by its state-specific weight.</skos:definition>
        <skos:hiddenLabel xml:lang="en">TWiST Analysis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Quality-Adjusted Time Without Symptoms</skos:prefLabel>
        <abbreviation xml:lang="en">Q-TWiST</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/outcomes#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/quality-adjusted-time-without-symptoms"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-adjusted-life-year"/>
