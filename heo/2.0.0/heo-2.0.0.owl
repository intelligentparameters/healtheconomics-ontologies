    <!-- https://healtheconomics.wiki/concept/catastrophic-health-expenditure -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/catastrophic-health-expenditure">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/out-of-pocket-payment"/>
