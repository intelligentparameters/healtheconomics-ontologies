        <owl:versionInfo>1.0.4</owl:versionInfo>
        <skos:altLabel xml:lang="en">Total Mortality</skos:altLabel>
        <skos:definition xml:lang="en">All-cause mortality is the rate of death from any cause in a population; models take background rates from life tables, and trials use it as an endpoint.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Overall Death Rate</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">All-Cause Mortality</skos:prefLabel>
