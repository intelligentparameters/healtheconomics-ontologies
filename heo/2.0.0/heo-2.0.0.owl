        <skos:hiddenLabel xml:lang="en">Health Gini</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Gini Coefficient Health</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-policy#step-4"/>
