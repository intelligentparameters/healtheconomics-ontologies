        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Orphan Drug Incentives</rdfs:label>
        <skos:definition xml:lang="en">The regulatory and financial benefits offered to manufacturers developing rare disease treatments, including trial expense tax credits and extended exclusivity.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Orphan Development Incentives</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Rare-Disease Incentives</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Orphan Drug Incentives</skos:prefLabel>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/drug-development"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
