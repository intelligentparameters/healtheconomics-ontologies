    <!-- https://healtheconomics.wiki/concept/related-future-cost -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/related-future-cost">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/future-cost"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/future-cost"/>
        <skos:notation>HS-DC-FC-002</skos:notation>
        <dcterms:identifier>HS-DC-FC-002</dcterms:identifier>
        <dcterms:source>Meltzer 1997</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Related Future Cost</rdfs:label>
        <skos:definition xml:lang="en">Future medical costs incurred in added years of life gained from treatment, arising from the same condition the original intervention addressed.</skos:definition>
        <skos:hiddenLabel xml:lang="en">In-Scope Future Spending</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Related Downstream Cost</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Related Future Cost</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/unrelated-future-cost"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/related-future-cost"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/future-cost"/>
        <dcterms:identifier>HEO-L-8e0a3fa31c45</dcterms:identifier>
        <linkRationale xml:lang="en">Related future costs are future costs in added life years.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/related-future-cost"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/unrelated-future-cost"/>
        <dcterms:identifier>HEO-L-71561f937cb9</dcterms:identifier>
        <linkRationale xml:lang="en">Related and unrelated future costs are the two alternative categories of future cost.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
