    <!-- https://healtheconomics.wiki/concept/value-driver -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/value-driver">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/value-proposition"/>
        <skos:notation>HS-NHS-VBH-022</skos:notation>
        <dcterms:identifier>HS-NHS-VBH-022</dcterms:identifier>
        <dcterms:source>Porter 2010</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Value Driver</rdfs:label>
        <skos:definition xml:lang="en">A specific factor contributing meaningfully to a technology&apos;s overall assessed value, such as a particularly strong trial result or safety profile.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Value Contributor</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Value Lever</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Value Driver</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/value-assessment"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/value-driver"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-c1332c91917d</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; NHS Productivity &gt; Value-Based Healthcare: wiki topic Performance, productivity and quality sits in Health Systems</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/value-driver"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/value-proposition"/>
        <dcterms:identifier>HEO-L-6be31aaf8511</dcterms:identifier>
        <linkRationale xml:lang="en">Drivers are the specific benefits a value proposition rests on.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
