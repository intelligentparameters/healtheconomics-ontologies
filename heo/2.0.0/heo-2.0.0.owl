    <!-- https://healtheconomics.wiki/concept/therapeutic-value -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/therapeutic-value">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-NHS-VBH-017</skos:notation>
        <dcterms:identifier>HS-NHS-VBH-017</dcterms:identifier>
        <dcterms:source>IQWiG General Methods 2020</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Therapeutic Value</rdfs:label>
        <skos:definition xml:lang="en">The clinical benefit a treatment provides for a condition, a core consideration within assessment frameworks that formally rate treatment benefit.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Clinical Worth</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Treatment Value</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Therapeutic Value</skos:prefLabel>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/added-value"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/therapeutic-value"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-e47d18ea522e</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; NHS Productivity &gt; Value-Based Healthcare: wiki topic Performance, productivity and quality sits in Health Systems</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/therapeutic-value"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isFoundationFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/added-value"/>
        <dcterms:identifier>HEO-L-0aaaba3963c0</dcterms:identifier>
        <linkRationale xml:lang="en">Added value is benefit beyond existing care (as HAS rates ASMR after SMR); it builds on therapeutic value rather than containing it.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


