        <dcterms:identifier>HEO-L-d34afcea824a</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Drug development and regulation in subdomain Health Policy</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/abbreviated-new-drug-application"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#precedes"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-approval"/>
        <dcterms:identifier>HEO-L-38461b572ef2</dcterms:identifier>
        <linkRationale xml:lang="en">An ANDA is an application, not the approval decision; the application comes before Drug Approval</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
