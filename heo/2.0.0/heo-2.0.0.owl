        <skos:altLabel xml:lang="en">Second Malignancy</skos:altLabel>
        <skos:definition xml:lang="en">A new, distinct cancer developing in a person with a prior different cancer diagnosis, unlike a recurrence or metastasis of the original.</skos:definition>
