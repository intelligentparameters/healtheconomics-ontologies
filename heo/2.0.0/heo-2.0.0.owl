        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:notation>HS-HP-HI-092</skos:notation>
        <dcterms:identifier>HS-HP-HI-092</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Guaranteed Renewability</rdfs:label>
        <skos:altLabel xml:lang="en">Guaranteed Renewal</skos:altLabel>
        <skos:definition xml:lang="en">A regulatory requirement mandating an insurer renew an existing policyholder&apos;s coverage on request, regardless of changes in their health status.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Renewability Requirement</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Guaranteed Renewability</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/continuous-coverage"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/guaranteed-renewability"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <dcterms:identifier>HEO-L-5704a86965d4</dcterms:identifier>
        <linkRationale xml:lang="en">A regulatory requirement is a health policy</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
