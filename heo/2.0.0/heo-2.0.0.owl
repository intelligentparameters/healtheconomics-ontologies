    <!-- https://healtheconomics.wiki/concept/money-back-guarantee -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/money-back-guarantee">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcomes-based-contract"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/performance-based-agreement"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/response-based-payment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/outcomes-based-contract"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/performance-based-agreement"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/response-based-payment"/>
        <skos:notation>HS-DC-MA-014</skos:notation>
        <dcterms:identifier>HS-DC-MA-014</dcterms:identifier>
        <dcterms:source>Carlson JJ, Sullivan SD, Garrison LP, Neumann PJ, Veenstra DL. Linking payment to health outcomes: a taxonomy and examination of performance-based reimbursement schemes. Health Policy. 2010;96(3):179-190.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Money-Back Guarantee</rdfs:label>
        <skos:definition xml:lang="en">An outcomes-based agreement in which a manufacturer refunds some or all of a treatment&apos;s cost if the patient does not achieve a predefined outcome.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Money-Back Scheme</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Refund Guarantee</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Money-Back Guarantee</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/money-back-guarantee"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/outcomes-based-contract"/>
        <dcterms:identifier>HEO-L-6a2d449a8fbb</dcterms:identifier>
        <linkRationale xml:lang="en">Definition says an outcomes-based agreement</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/money-back-guarantee"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/performance-based-agreement"/>
        <dcterms:identifier>HEO-L-7399828be90e</dcterms:identifier>
        <linkRationale xml:lang="en">Refund depends on the treatment achieving a predefined outcome</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
