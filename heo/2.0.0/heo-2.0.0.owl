    <!-- https://healtheconomics.wiki/concept/restricted-cubic-spline -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/restricted-cubic-spline">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cubic-spline"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cubic-spline"/>
        <skos:notation>HE-EM-SM-071</skos:notation>
        <dcterms:identifier>HE-EM-SM-071</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Royston &amp; Parmar 2002</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Restricted Cubic Spline</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">RCS</skos:altLabel>
        <skos:altLabel xml:lang="en">Restricted Cubic Splines</skos:altLabel>
        <skos:definition xml:lang="en">A restricted cubic spline is a smooth piecewise cubic function of a continuous predictor constrained to be linear beyond its outer knots, allowing regression models to represent nonlinear associations without prescribing one global polynomial shape.</skos:definition>
        <skos:prefLabel xml:lang="en">Restricted Cubic Spline</skos:prefLabel>
        <abbreviation xml:lang="en">RCS</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/restricted-cubic-spline"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cubic-spline"/>
        <dcterms:identifier>HEO-L-8bd06b026cdf</dcterms:identifier>
        <linkRationale xml:lang="en">A restricted cubic spline is a constrained cubic spline.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


