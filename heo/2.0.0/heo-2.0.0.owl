    <!-- https://healtheconomics.wiki/concept/lead-optimisation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/lead-optimisation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-development"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/drug-development"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/drug-discovery"/>
        <precedes rdf:resource="https://healtheconomics.wiki/concept/preclinical-development"/>
        <skos:notation>HE-PE-DD-024</skos:notation>
        <dcterms:identifier>HE-PE-DD-024</dcterms:identifier>
        <dcterms:source>DiMasi JA, Grabowski HG, Hansen RW. Innovation in the pharmaceutical industry: new estimates of R&amp;D costs. Journal of Health Economics. 2016;47:20-33. doi:10.1016/j.jhealeco.2016.01.012.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Lead Optimisation</rdfs:label>
        <skos:altLabel xml:lang="en">Lead Optimization</skos:altLabel>
        <skos:definition xml:lang="en">A drug discovery stage in which chemists modify a promising compound&apos;s structure to improve potency, selectivity, and pharmacokinetics before preclinical testing.</skos:definition>
        <skos:prefLabel xml:lang="en">Lead Optimisation</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
