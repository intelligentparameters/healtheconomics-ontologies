    <!-- https://healtheconomics.wiki/concept/research-cost -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/research-cost">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <skos:notation>HE-EM-VI-004</skos:notation>
        <dcterms:identifier>HE-EM-VI-004</dcterms:identifier>
        <dcterms:source>Claxton &amp; Posnett 1996</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Research Cost</rdfs:label>
        <skos:definition xml:lang="en">The total expected expense of conducting a proposed study, weighed against the expected value of sample information the study would generate.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Study Cost</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Trial Development Cost</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Research Cost</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/research-cost"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <dcterms:identifier>HEO-L-2bbd34b6397f</dcterms:identifier>
        <linkRationale xml:lang="en">Research cost is a cost.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/research-ethics -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/research-ethics">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/bioethics"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
