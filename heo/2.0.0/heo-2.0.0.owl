    <!-- https://healtheconomics.wiki/concept/rawlsian-justice -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/rawlsian-justice">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/distributive-justice"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/distributive-justice"/>
        <skos:notation>HE-EE-WE-018</skos:notation>
        <dcterms:identifier>HE-EE-WE-018</dcterms:identifier>
        <dcterms:source>Rawls 1971</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Rawlsian Justice</rdfs:label>
        <skos:altLabel xml:lang="en">Justice as Fairness</skos:altLabel>
        <skos:definition xml:lang="en">A theory of distributive justice holding that inequalities are justified only if they benefit the least advantaged, derived from a hypothetical veil of ignorance.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Difference Principle</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Rawlsian Justice</skos:prefLabel>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/maximin-criterion"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/rawlsian-welfare"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/rawlsian-justice"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
