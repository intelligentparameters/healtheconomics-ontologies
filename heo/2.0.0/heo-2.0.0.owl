        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/community-benefit"/>
        <dcterms:identifier>HEO-L-990f52667cc7</dcterms:identifier>
