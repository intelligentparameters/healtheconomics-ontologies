    <!-- https://healtheconomics.wiki/concept/return-on-equity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/return-on-equity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/financial-ratio"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/profitability-ratio"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q591174"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/financial-ratio"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/profitability-ratio"/>
        <skos:notation>HE-EE_EA-048</skos:notation>
        <dcterms:identifier>HE-EE_EA-048</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Brealey, Myers &amp; Allen 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Return on Equity</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">ROE</skos:altLabel>
        <skos:definition xml:lang="en">A financial ratio calculated as net income divided by owner equity, showing the return generated on capital invested by an organisation&apos;s owners.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Equity Return</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Return on Equity</skos:prefLabel>
        <abbreviation xml:lang="en">ROE</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-4"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/return-on-equity"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/financial-ratio"/>
        <dcterms:identifier>HEO-L-c6ecff47dca7</dcterms:identifier>
        <linkRationale xml:lang="en">Return on equity is a financial statement ratio.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
