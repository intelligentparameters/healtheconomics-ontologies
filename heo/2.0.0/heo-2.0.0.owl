    <!-- https://healtheconomics.wiki/concept/intermediate-outcome -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/intermediate-outcome">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
