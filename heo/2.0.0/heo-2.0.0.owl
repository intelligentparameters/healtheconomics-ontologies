    <!-- https://healtheconomics.wiki/concept/delta-method -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/delta-method">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1132714"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:notation>HE-ES-SA-046</skos:notation>
        <dcterms:identifier>HE-ES-SA-046</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</dcterms:modified>
        <dcterms:source>Kearns et al. 2020</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Delta Method</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:altLabel xml:lang="en">Taylor Series Method</skos:altLabel>
        <skos:definition xml:lang="en">The delta method approximates the variance of a function of estimated parameters, such as an ICER or mean survival, using a first-order Taylor expansion.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Delta Approximation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">First-Order Approximation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Taylor-Series Variance</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Delta Method</skos:prefLabel>
        <assumes rdf:resource="https://healtheconomics.wiki/concept/asymptotic-normality"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/bootstrapping"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/fieller-method"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/confidence-interval"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/variance"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/taylor-series-expansion"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/variance-covariance-matrix"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/delta-method"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <dcterms:identifier>HEO-L-df63f4af9e0a</dcterms:identifier>
        <linkRationale xml:lang="en">Variance estimation procedure</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
