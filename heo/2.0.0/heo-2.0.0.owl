        <uses rdf:resource="https://healtheconomics.wiki/concept/cost-benefit-analysis"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/cost-utility-analysis"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
