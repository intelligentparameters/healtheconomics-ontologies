    <!-- https://healtheconomics.wiki/concept/time-value-of-money -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/time-value-of-money">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <skos:notation>HE-EE-CA-082</skos:notation>
        <dcterms:identifier>HE-EE-CA-082</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Brealey, Myers &amp; Allen 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Time Value of Money</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">TVM</skos:altLabel>
        <skos:definition xml:lang="en">The principle that a given sum of money is worth more today than the same sum received in the future.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Present Value Principle</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Time Value of Money</skos:prefLabel>
        <abbreviation xml:lang="en">TVM</abbreviation>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/discount-rate"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/discounting-costs"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/net-present-value"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/costs#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/time-value-of-money"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-2045aa53ea76</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Costing methods in subdomain Costs</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/time-value-of-money"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isFoundationFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/discount-rate"/>
        <dcterms:identifier>HEO-L-7d4036d9cea5</dcterms:identifier>
        <linkRationale xml:lang="en">A discount rate expresses the time value of money.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
