        <dcterms:identifier>HE-EE-ME-025</dcterms:identifier>
        <dcterms:source>Olson 1965</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Free Rider Problem in Insurance</rdfs:label>
        <skos:definition xml:lang="en">The tendency for healthy individuals to skip buying insurance while relying on emergency care or others&apos; willingness to fund risk pools.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Coverage Free-Riding</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Insurance Free Riding</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Free Rider Problem in Insurance</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/adverse-selection"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/uncompensated-care"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/free-rider-problem-in-insurance"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/free-rider-problem"/>
        <dcterms:identifier>HEO-L-2001aaf3b96d</dcterms:identifier>
        <linkRationale xml:lang="en">Insurance free riding is a free rider problem</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
