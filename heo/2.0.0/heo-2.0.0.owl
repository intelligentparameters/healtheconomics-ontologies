    <!-- https://healtheconomics.wiki/concept/evpi -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/evpi">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/value-of-information"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q5420852"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/value-of-information"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/decision-uncertainty"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/voi-analysis"/>
        <skos:notation>HE-EM-VI-009</skos:notation>
        <dcterms:identifier>HE-EM-VI-009</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</dcterms:modified>
        <dcterms:source>Steuten et al. 2026</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Expected Value of Perfect Information</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:altLabel xml:lang="en">EVPI</skos:altLabel>
        <skos:definition xml:lang="en">Expected value of perfect information (EVPI) is the expected gain from removing all uncertainty in a funding decision, the upper limit on research value.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Perfect-Information Value</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Expected Value of Perfect Information</skos:prefLabel>
        <abbreviation xml:lang="en">EVPI</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/evsi"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/probability-of-cost-effectiveness"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-11"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/research-prioritisation"/>
        <prerequisiteFor rdf:resource="https://healtheconomics.wiki/concept/evppi"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/psa"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/evpi"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/value-of-information"/>
        <dcterms:identifier>HEO-L-c9a893030cf9</dcterms:identifier>
        <linkRationale xml:lang="en">EVPI is a value of information measure</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/evpi"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/decision-uncertainty"/>
        <dcterms:identifier>HEO-L-e31eff61ae58</dcterms:identifier>
        <linkRationale xml:lang="en">EVPI is the expected cost of decision uncertainty, probability of a wrong decision times its loss (Claxton 1999)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/evpi"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/voi-analysis"/>
        <dcterms:identifier>HEO-L-c3586bd38b7a</dcterms:identifier>
        <linkRationale xml:lang="en">second check: VOI Analysis is a separate published concept whose definition runs EVPI, EVPPI, EVSI and ENBS in turn, so EVPI is a precise component step</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/evpi"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evsi"/>
        <dcterms:identifier>HEO-L-36c8aac34acd</dcterms:identifier>
        <linkRationale xml:lang="en">EVPI (all uncertainty) contrasts with EVSI (a specific study)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/evpi"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/probability-of-cost-effectiveness"/>
        <dcterms:identifier>HEO-L-55175f3f988f</dcterms:identifier>
        <linkRationale xml:lang="en">EVPI values the consequence of uncertainty, while the probability measures only its chance</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/evpi"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/research-prioritisation"/>
        <dcterms:identifier>HEO-L-44c3d0c6c4a4</dcterms:identifier>
        <linkRationale xml:lang="en">EVPI bounds research value and so informs research priorities</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/evpi"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#prerequisiteFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evppi"/>
        <dcterms:identifier>HEO-L-2e57d9086c85</dcterms:identifier>
        <linkRationale xml:lang="en">EVPPI extends EVPI to subsets of parameters, so EVPI is learned first</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/evpi"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/psa"/>
        <dcterms:identifier>HEO-L-bc905d7abf1f</dcterms:identifier>
        <linkRationale xml:lang="en">EVPI is computed from PSA simulations</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/evppi -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/evppi">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/value-of-information"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/value-of-information"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/parameter-importance"/>
        <skos:notation>HE-EM-VI-010</skos:notation>
        <dcterms:identifier>HE-EM-VI-010</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</dcterms:modified>
        <dcterms:source>Fenwick et al. 2020</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Expected Value of Partial Perfect Information</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:altLabel xml:lang="en">EVPPI</skos:altLabel>
        <skos:definition xml:lang="en">Expected value of partial perfect information (EVPPI) is the expected gain in net benefit from knowing selected model parameters exactly before deciding.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Partial Perfect-Information Value</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Expected Value of Partial Perfect Information</skos:prefLabel>
        <abbreviation xml:lang="en">EVPPI</abbreviation>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-11"/>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/decision-uncertainty"/>
        <prerequisiteFor rdf:resource="https://healtheconomics.wiki/concept/evsi"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/psa"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/evppi"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/value-of-information"/>
        <dcterms:identifier>HEO-L-61dfc2a01e94</dcterms:identifier>
        <linkRationale xml:lang="en">EVPPI is a value of information measure</linkRationale>
