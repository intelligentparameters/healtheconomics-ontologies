    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/effect-size -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/effect-size">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1287978"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/responsiveness"/>
        <skos:notation>HE-ES-SA-055</skos:notation>
        <dcterms:identifier>HE-ES-SA-055</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Cohen 1988</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Effect Size</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">An effect size is a measure of the magnitude of an association or intervention effect for a specified outcome, comparator, population, and scale.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Magnitude of Effect</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Magnitude of Treatment Effect</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Standardised Effect</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Effect Size</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/statistical-significance"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/clinical-meaningfulness"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/effect-size"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-2abf8d238444</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Statistical methods in subdomain Evidence Synthesis; placed under Statistical Method, the concept named by its wiki topic</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
