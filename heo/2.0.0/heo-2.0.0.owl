    <!-- https://healtheconomics.wiki/concept/design-effect -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/design-effect">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q5264333"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/effective-sample-size"/>
        <skos:notation>HE-ES-SA-048</skos:notation>
        <dcterms:identifier>HE-ES-SA-048</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</dcterms:modified>
        <dcterms:source>WHO 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Design Effect</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:altLabel xml:lang="en">Deff</skos:altLabel>
        <skos:definition xml:lang="en">The design effect (DEFF) is the ratio of an estimate&apos;s variance under a clustered or complex sample to that under a simple random sample of equal size.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Variance Inflation from Clustering</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Design Effect</skos:prefLabel>
        <abbreviation xml:lang="en">Deff</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/design-effect"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-6e89f1664b17</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Statistical methods in subdomain Evidence Synthesis; placed under Statistical Method, the concept named by its wiki topic</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/design-effect"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/effective-sample-size"/>
        <dcterms:identifier>HEO-L-7ef4c3cc0be0</dcterms:identifier>
        <linkRationale xml:lang="en">Effective sample size is n divided by the design effect</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


