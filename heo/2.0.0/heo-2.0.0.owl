    <!-- https://healtheconomics.wiki/concept/price-elasticity-of-icer -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/price-elasticity-of-icer">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/elasticity"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/elasticity"/>
        <skos:notation>HE-PE-DP-001</skos:notation>
        <dcterms:identifier>HE-PE-DP-001</dcterms:identifier>
        <dcterms:source>Claxton et al. 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Price Elasticity of ICER</rdfs:label>
        <skos:definition xml:lang="en">A measure of how sensitively a treatment&apos;s ICER responds to price changes, used to identify the price at which it crosses a cost-effectiveness threshold.</skos:definition>
        <skos:hiddenLabel xml:lang="en">ICER Elasticity</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">ICER Price Sensitivity</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Price Elasticity of ICER</skos:prefLabel>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/icer"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/price-elasticity-of-icer"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/elasticity"/>
        <dcterms:identifier>HEO-L-2a11216b2e37</dcterms:identifier>
        <linkRationale xml:lang="en">This is an elasticity of the ICER with respect to price</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/price-elasticity-of-icer"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isPropertyOf"/>
