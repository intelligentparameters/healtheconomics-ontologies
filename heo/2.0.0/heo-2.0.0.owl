    <!-- https://healtheconomics.wiki/concept/allocative-efficiency -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/allocative-efficiency">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/efficiency"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q4175604"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/efficiency"/>
        <skos:notation>HE-EE_EA-002</skos:notation>
        <dcterms:identifier>HE-EE_EA-002</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Palmer &amp; Torgerson 1999</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Allocative Efficiency</rdfs:label>
        <owl:versionInfo>1.0.3</owl:versionInfo>
        <skos:definition xml:lang="en">Allocative efficiency is spending a health budget on the mix of services that yields the most health or welfare, so that no reallocation could do better.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Allocative Optimality</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Value-Maximising Allocation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Allocative Efficiency</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/technical-efficiency"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/allocative-efficiency"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/efficiency"/>
        <dcterms:identifier>HEO-L-32764e128fda</dcterms:identifier>
        <linkRationale xml:lang="en">Allocative efficiency is one form of efficiency</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/allocative-efficiency"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/technical-efficiency"/>
        <dcterms:identifier>HEO-L-5b5a848627df</dcterms:identifier>
        <linkRationale xml:lang="en">Right mix versus least inputs; symmetric, reverse copy (queue-r3-19) is the duplicate</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


