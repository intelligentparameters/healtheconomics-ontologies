    <!-- https://healtheconomics.wiki/concept/health-system-responsiveness -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/health-system-responsiveness">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-system-goals"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-system-goals"/>
        <skos:notation>HS-HP-HSM-012</skos:notation>
        <dcterms:identifier>HS-HP-HSM-012</dcterms:identifier>
        <dcterms:source>WHO, World Health Report 2000</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Health System Responsiveness</rdfs:label>
        <skos:definition xml:lang="en">The degree to which a health system meets the legitimate non-health expectations of its population, such as dignity, autonomy, and prompt attention.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Patient Responsiveness</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">System Responsiveness</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Health System Responsiveness</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/health-system-performance"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/health-system"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/health-system-responsiveness"/>
