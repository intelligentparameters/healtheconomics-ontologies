        <skos:altLabel xml:lang="en">Randomisation Test</skos:altLabel>
        <skos:definition xml:lang="en">A non-parametric hypothesis test determining significance by repeatedly rearranging observed data labels to build an empirical distribution under the null hypothesis.</skos:definition>
