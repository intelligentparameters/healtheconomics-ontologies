        <linkRationale xml:lang="en">Overheads such as administration are recurring costs within operating cost (both definitions)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/overhead-cost"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/administrative-cost-ratio"/>
        <dcterms:identifier>HEO-L-981956fa2901</dcterms:identifier>
        <linkRationale xml:lang="en">The ratio is calculated from administrative overhead spending; it does not measure a cost category</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/override-rate -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/override-rate">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/alert-fatigue"/>
        <skos:notation>HS-HP-DH-032</skos:notation>
        <dcterms:identifier>HS-HP-DH-032</dcterms:identifier>
        <dcterms:source>Ancker et al. 2017</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Override Rate</rdfs:label>
        <skos:definition xml:lang="en">The proportion of computerised clinical alerts a provider dismisses without following the recommended action, a key metric for alert calibration.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Alert Dismissal Rate</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Alert Override Frequency</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Override Rate</skos:prefLabel>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/clinical-alert"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/override-rate"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-74864faa469a</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Digital Health: health information systems are one of the WHO health system building blocks</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/override-rate"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/alert-fatigue"/>
        <dcterms:identifier>HEO-L-ae3f9bf9b28a</dcterms:identifier>
        <linkRationale xml:lang="en">A rate is not decision support software; override rate is the usual metric of alert fatigue (Alert Fatigue contributesTo Override Rate)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
