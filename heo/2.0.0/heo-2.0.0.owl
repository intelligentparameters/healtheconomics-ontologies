        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Minimisation (Trial Allocation)</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Minimization</skos:altLabel>
        <skos:definition xml:lang="en">Minimisation is a trial allocation method steering each new participant to the arm best balancing chosen prognostic factors, often with a random element.</skos:definition>
        <skos:prefLabel xml:lang="en">Minimisation (Trial Allocation)</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/confounding"/>
