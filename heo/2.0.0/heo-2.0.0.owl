        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/variance-covariance-matrix"/>
        <dcterms:identifier>HEO-L-69342799625d</dcterms:identifier>
        <linkRationale xml:lang="en">Covariances are correlations times the two standard deviations</linkRationale>
