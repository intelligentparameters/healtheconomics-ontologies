    <!-- https://healtheconomics.wiki/concept/basic-reproduction-number -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/basic-reproduction-number">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/reproduction-number"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q901464"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/reproduction-number"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/attack-rate"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/herd-immunity-threshold"/>
        <skos:notation>HE-ES-EP-003</skos:notation>
        <dcterms:identifier>HE-ES-EP-003</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Pitman et al. 2012</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Basic Reproduction Number</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Basic Reproduction Ratio</skos:altLabel>
        <skos:altLabel xml:lang="en">Basic Reproductive Number</skos:altLabel>
        <skos:altLabel xml:lang="en">R0</skos:altLabel>
        <skos:altLabel xml:lang="en">R₀</skos:altLabel>
        <skos:definition xml:lang="en">The basic reproduction number (R0) is the average number of infections one typical case causes in a fully susceptible population, used in vaccine models.</skos:definition>
        <skos:prefLabel xml:lang="en">Basic Reproduction Number</skos:prefLabel>
        <abbreviation xml:lang="en">R0</abbreviation>
        <abbreviation xml:lang="en">R₀</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/effective-reproduction-number"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/basic-reproduction-number"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/reproduction-number"/>
        <dcterms:identifier>HEO-L-f9a5b5ea8cb6</dcterms:identifier>
        <linkRationale xml:lang="en">Definition covers basic and effective</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
