        <dcterms:identifier>HEO-L-3c20efc1df30</dcterms:identifier>
        <linkRationale xml:lang="en">Substituting a generic is an activity carried out at dispensing (both definitions)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
