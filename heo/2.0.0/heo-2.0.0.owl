    <!-- https://healtheconomics.wiki/concept/particle-filter -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/particle-filter">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/sequential-monte-carlo"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1151499"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/sequential-monte-carlo"/>
        <skos:notation>HE-EM-MP-029</skos:notation>
        <dcterms:identifier>HE-EM-MP-029</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Gordon, Salmond &amp; Smith 1993</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Particle Filter</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A sequential Monte Carlo algorithm that approximates the evolving probability distribution of a hidden state with weighted simulated particles, updating their weights as observations arrive.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Bootstrap Filter</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Sequential Monte Carlo Filter</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Particle Filter</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-4"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/bayes-theorem"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/state-space-model"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/particle-filter"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/sequential-monte-carlo"/>
        <dcterms:identifier>HEO-L-6104de4ad153</dcterms:identifier>
        <linkRationale xml:lang="en">Object definition names particle filtering as sequential Monte Carlo</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/particle-filter"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/bayes-theorem"/>
        <dcterms:identifier>HEO-L-d3f8cd801417</dcterms:identifier>
        <linkRationale xml:lang="en">Full page kept; it approximates Bayesian filtering by weighted samples (link to State Space Model given on that row).</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/particle-filter"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/state-space-model"/>
        <dcterms:identifier>HEO-L-4f6e80e077eb</dcterms:identifier>
        <linkRationale xml:lang="en">Full page kept; Kalman and particle filters are the estimation algorithms for state space models. Definition could be sharpened (latent state plus observation equation).</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/particle-swarm-optimisation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/particle-swarm-optimisation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/numerical-optimisation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/numerical-optimisation"/>
        <skos:notation>HE-EM-DM-075</skos:notation>
        <dcterms:identifier>HE-EM-DM-075</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Kennedy &amp; Eberhart 1995</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Particle Swarm Optimisation</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">PSO</skos:altLabel>
        <skos:definition xml:lang="en">A population-based optimisation technique inspired by flocking behaviour, in which candidate solutions adjust position based on their own and the group&apos;s best results.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Swarm Optimisation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Particle Swarm Optimisation</skos:prefLabel>
        <abbreviation xml:lang="en">PSO</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/genetic-algorithm"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/simulated-annealing"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-12"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
