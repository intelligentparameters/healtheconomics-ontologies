    <!-- https://healtheconomics.wiki/concept/waste-in-healthcare -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/waste-in-healthcare">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/health-spending"/>
        <skos:notation>HS-NHS-HQ-087</skos:notation>
        <dcterms:identifier>HS-NHS-HQ-087</dcterms:identifier>
        <dcterms:source>Berwick &amp; Hackbarth 2012</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Waste in Healthcare</rdfs:label>
        <skos:definition xml:lang="en">Healthcare spending that does not contribute to improving patient health, covering administrative waste, clinical waste, and operational inefficiency.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Healthcare Waste</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Wasteful Spending</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Waste in Healthcare</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/waste-in-healthcare"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
