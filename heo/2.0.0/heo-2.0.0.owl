    <!-- https://healtheconomics.wiki/concept/embedding-effect -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/embedding-effect">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/bias"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/bias"/>
        <skos:notation>HE-EE-CBA-018</skos:notation>
        <dcterms:identifier>HE-EE-CBA-018</dcterms:identifier>
        <dcterms:source>Kahneman &amp; Knetsch 1992</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Embedding Effect</rdfs:label>
        <skos:definition xml:lang="en">A phenomenon in which a stated value fails to rise proportionally, or at all, as the scope of the good being valued expands.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Part-Whole Bias</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Scope Insensitivity</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Embedding Effect</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/contingent-valuation"/>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/willingness-to-pay"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/embedding-effect"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/bias"/>
        <dcterms:identifier>HEO-L-273d52faa279</dcterms:identifier>
        <linkRationale xml:lang="en">The embedding effect is a systematic scope-insensitivity error in stated values</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/embedding-effect"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#threatensValidityOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/contingent-valuation"/>
        <dcterms:identifier>HEO-L-de369847a8d9</dcterms:identifier>
        <linkRationale xml:lang="en">Insensitivity to scope undermines contingent valuation estimates (subject definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/embedding-effect"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#threatensValidityOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/willingness-to-pay"/>
        <dcterms:identifier>HEO-L-fafe9a299569</dcterms:identifier>
