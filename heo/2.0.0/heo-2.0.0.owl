        <skos:altLabel xml:lang="en">Cytotoxic Therapy</skos:altLabel>
        <skos:definition xml:lang="en">A treatment using cytotoxic drugs to kill or slow the growth of rapidly dividing cancer cells, historically the primary systemic cancer treatment.</skos:definition>
