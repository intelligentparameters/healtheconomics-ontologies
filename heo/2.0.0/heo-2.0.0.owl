        <dcterms:identifier>HE-EM-MV-015</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</dcterms:modified>
        <dcterms:source>Hastie, Tibshirani &amp; Friedman 2009</dcterms:source>
