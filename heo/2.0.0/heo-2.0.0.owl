    <!-- https://healtheconomics.wiki/concept/pareto-chart -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/pareto-chart">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <skos:notation>HS-NHS-HQ-051</skos:notation>
        <dcterms:identifier>HS-NHS-HQ-051</dcterms:identifier>
        <dcterms:source>Juran 1951</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Pareto Chart</rdfs:label>
        <skos:altLabel xml:lang="en">Pareto Diagram</skos:altLabel>
        <skos:definition xml:lang="en">A bar chart displaying problem category frequency in descending order, combined with a cumulative percentage line, identifying which few account for most impact.</skos:definition>
        <skos:hiddenLabel xml:lang="en">80/20 Chart</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Pareto Chart</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/quality-improvement"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/pareto-chart"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-20502f59c2ce</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; NHS Productivity &gt; Healthcare Quality: wiki topic Performance, productivity and quality sits in Health Systems; placed under Quality of Care, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/pareto-chart"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
