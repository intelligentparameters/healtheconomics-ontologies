    <!-- https://healtheconomics.wiki/concept/provisional-approval -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/provisional-approval">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-approval"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/drug-approval"/>
        <skos:notation>HE-PE-DD-059</skos:notation>
        <dcterms:identifier>HE-PE-DD-059</dcterms:identifier>
        <dcterms:source>EMA, Conditional Marketing Authorisation</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Provisional Approval</rdfs:label>
        <skos:definition xml:lang="en">A regulatory pathway granting conditional market access based on preliminary evidence, subject to the manufacturer providing further confirmatory data within a set timeframe.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Interim Authorisation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Time-Limited Approval</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Provisional Approval</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/full-approval"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/provisional-approval"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-approval"/>
        <dcterms:identifier>HEO-L-adf5fbc8136e</dcterms:identifier>
        <linkRationale xml:lang="en">Provisional approval is a form of drug marketing approval.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/provisional-approval"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/full-approval"/>
        <dcterms:identifier>HEO-L-ca32b77ddab9</dcterms:identifier>
        <linkRationale xml:lang="en">EU conditional approval is a provisional authorisation pending confirmatory data; full approval is the definitive alternative.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/proxy-means-test -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/proxy-means-test">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:notation>HE-EE-HE-013</skos:notation>
        <dcterms:identifier>HE-EE-HE-013</dcterms:identifier>
        <dcterms:source>Coady, Grosh &amp; Hoddinott 2004</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Proxy Means Test</rdfs:label>
        <skos:altLabel xml:lang="en">PMT</skos:altLabel>
        <skos:definition xml:lang="en">A method of estimating household welfare using easily observable indicators, such as housing or assets, correlated with income rather than direct verification.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Proxy-Indicator Targeting</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Proxy Means Test</skos:prefLabel>
        <abbreviation xml:lang="en">PMT</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/means-testing"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/subsidy"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/proxy-means-test"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-3904e5925bb9</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Health Equity: wiki topic Equity and inequality sits in Health Policy</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/proxy-means-test"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/means-testing"/>
        <dcterms:identifier>HEO-L-886a6709d9b8</dcterms:identifier>
        <linkRationale xml:lang="en">Means Testing is defined as direct assessment; a proxy means test estimates welfare indirectly (Coady, Grosh and Hoddinott 2004).</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/proxy-means-test"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#setsScopeOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/subsidy"/>
        <dcterms:identifier>HEO-L-51d9ba08bd83</dcterms:identifier>
