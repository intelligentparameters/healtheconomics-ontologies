        <dcterms:source>Black 1990</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Southeast Quadrant</rdfs:label>
        <skos:altLabel xml:lang="en">SE Quadrant</skos:altLabel>
        <skos:definition xml:lang="en">The region of the cost-effectiveness plane where a new intervention is both less costly and more effective than its comparator.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Dominant Quadrant</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Southeast Quadrant</skos:prefLabel>
