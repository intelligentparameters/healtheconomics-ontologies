    <!-- https://healtheconomics.wiki/concept/k-fold-cross-validation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/k-fold-cross-validation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cross-validation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cross-validation"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/predictive-accuracy"/>
        <skos:notation>HE-ES-SA-093</skos:notation>
        <dcterms:identifier>HE-ES-SA-093</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-24</dcterms:modified>
        <dcterms:source>Stone 1974</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">K-Fold Cross-Validation</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">K-fold CV</skos:altLabel>
        <skos:definition xml:lang="en">An internal validation procedure that repeatedly fits a model on all but one of K data folds and evaluates it on the held-out fold.</skos:definition>
        <skos:prefLabel xml:lang="en">K-Fold Cross-Validation</skos:prefLabel>
        <abbreviation xml:lang="en">K-fold CV</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/in-sample"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/k-fold-cross-validation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cross-validation"/>
        <dcterms:identifier>HEO-L-5ed07aac8c69</dcterms:identifier>
        <linkRationale xml:lang="en">A form of cross-validation</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/k-fold-cross-validation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
