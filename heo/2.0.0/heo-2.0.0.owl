        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/parameter-distribution"/>
        <dcterms:identifier>HEO-L-339e9c4e3886</dcterms:identifier>
