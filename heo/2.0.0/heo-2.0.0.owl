    <!-- https://healtheconomics.wiki/concept/endemic -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/endemic">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/global-health"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/global-health"/>
        <skos:notation>HS-SS-GH-006</skos:notation>
        <dcterms:identifier>HS-SS-GH-006</dcterms:identifier>
        <dcterms:source>Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams &amp; Wilkins; 2008.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Endemic</rdfs:label>
        <skos:definition xml:lang="en">A disease consistently present within a geographic area at a generally predictable, stable baseline level, unlike an epidemic&apos;s sudden increase.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Baseline Disease Presence</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Stable Prevalence Disease</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Endemic</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/epidemic"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/pandemic"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/endemic"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/global-health"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-b57c8ded71c6</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Systems Strengthening &gt; Global Health: health system strengthening is the Health Systems subdomain; placed under Global Health, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/endemic"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/epidemic"/>
        <dcterms:identifier>HEO-L-214252a2c212</dcterms:identifier>
        <linkRationale xml:lang="en">Endemic (stable baseline) contrasts with epidemic (excess over baseline), as both definitions say</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/endemic"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/pandemic"/>
        <dcterms:identifier>HEO-L-87a7924d4d49</dcterms:identifier>
