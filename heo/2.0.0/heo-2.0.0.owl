        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Repeated Measures</rdfs:label>
        <skos:definition xml:lang="en">A study design in which the same outcome is measured multiple times on the same individuals, typically at different points in time.</skos:definition>
