    <!-- https://healtheconomics.wiki/concept/small-population-challenge -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/small-population-challenge">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:notation>HE-PE-RR-012</skos:notation>
        <dcterms:identifier>HE-PE-RR-012</dcterms:identifier>
        <dcterms:source>FDA, Rare Diseases: Natural History Studies for Drug Development guidance</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Small Population Challenge</rdfs:label>
        <skos:definition xml:lang="en">The methodological difficulty of generating robust clinical evidence when a disease affects only a small number of patients, limiting conventional trial feasibility.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Limited Evidence Challenge</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Small Sample Challenge</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Small Population Challenge</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/statistical-power"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/small-population-challenge"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-d2110417025e</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Pharmacoeconomics &gt; Rare Disease: orphan designation and incentives are regulatory policy (Drug development and regulation)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/small-population-challenge"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-power"/>
        <dcterms:identifier>HEO-L-4f6a7ab0b7cd</dcterms:identifier>
        <linkRationale xml:lang="en">Few patients limit achievable sample size and so lower the power of a trial to detect an effect</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/small-study-effects -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/small-study-effects">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:notation>HE-EM-UA-066</skos:notation>
        <dcterms:identifier>HE-EM-UA-066</dcterms:identifier>
        <dcterms:source>Sterne, Gavaghan &amp; Egger 2000</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Small Study Effects</rdfs:label>
        <skos:definition xml:lang="en">A pattern in meta-analysis where smaller studies tend to report systematically larger treatment effects than larger studies, possibly reflecting publication bias.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Small Trial Effect</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Small-Study Bias</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Small Study Effects</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/meta-analysis"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/small-study-effects"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-7a19b710b0a3</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Modelling &gt; Uncertainty Analysis: catalogue subdomain Economic Modelling is one of the subdomains</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/small-study-effects"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#threatensValidityOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/meta-analysis"/>
        <dcterms:identifier>HEO-L-59230ed3377f</dcterms:identifier>
        <linkRationale xml:lang="en">Systematically larger effects in small studies can bias a pooled meta-analytic estimate</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/smart-alert -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/smart-alert">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-alert"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-decision-support"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/clinical-alert"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/clinical-decision-support"/>
        <skos:notation>HS-HP-DH-041</skos:notation>
        <dcterms:identifier>HS-HP-DH-041</dcterms:identifier>
        <dcterms:source>Ancker et al. 2017</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Smart Alert</rdfs:label>
        <skos:definition xml:lang="en">A computerised clinical alert using more sophisticated logic, such as patient-specific risk factors, to reduce clinically insignificant notifications compared with simpler rule-based alerts.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Context-Aware Alert</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Intelligent Alert</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Smart Alert</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/alert-fatigue"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/smart-alert"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/clinical-alert"/>
        <dcterms:identifier>HEO-L-a2fce79120fe</dcterms:identifier>
        <linkRationale xml:lang="en">Definition: a computerised clinical alert; Clinical Alert is the nearer parent than Clinical Decision Support</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/smart-alert"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/clinical-decision-support"/>
        <dcterms:identifier>HEO-L-36039a37bab7</dcterms:identifier>
        <linkRationale xml:lang="en">A smart alert is a CDS alert.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/smart-alert"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/alert-fatigue"/>
