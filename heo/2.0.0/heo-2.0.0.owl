        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/prom"/>
        <skos:notation>HE-EE-HU-022</skos:notation>
        <dcterms:identifier>HE-EE-HU-022</dcterms:identifier>
        <dcterms:source>EuroQol Group 1990</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
