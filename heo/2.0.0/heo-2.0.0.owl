        <dcterms:identifier>HEO-L-1b81d3530a62</dcterms:identifier>
        <linkRationale xml:lang="en">Unbundled payment is a way of paying providers.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/unbundling -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/unbundling">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-HP-HSR-061</skos:notation>
        <dcterms:identifier>HS-HP-HSR-061</dcterms:identifier>
        <dcterms:source>AHIMA, Clinical Documentation Improvement guidance</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Unbundling</rdfs:label>
        <skos:definition xml:lang="en">A billing practice separately billing individual components of a service that should properly be billed together under one comprehensive code.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Component Billing</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Fragmented Billing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Unbundling</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/consolidated-billing"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/unbundling"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-29a442621c1d</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health System Regulation: compliance, audit and accreditation govern how providers work (Organisation and governance)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/unbundling"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/consolidated-billing"/>
        <dcterms:identifier>HEO-L-9d68356b0e71</dcterms:identifier>
