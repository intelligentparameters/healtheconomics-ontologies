    <!-- https://healtheconomics.wiki/concept/very-low-quality-evidence -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/very-low-quality-evidence">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
