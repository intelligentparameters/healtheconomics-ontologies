        <skos:hiddenLabel xml:lang="en">Itemised Payment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Unbundled Payment</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
