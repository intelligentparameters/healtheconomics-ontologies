    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/relapse-free-survival -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/relapse-free-survival">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/time-to-event"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/time-to-event"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/recurrence"/>
        <skos:notation>HE-ES-CO-064</skos:notation>
        <dcterms:identifier>HE-ES-CO-064</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Latimer 2013</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Relapse-Free Survival</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">RFS</skos:altLabel>
        <skos:definition xml:lang="en">A time-to-event measure defined as the time from treatment completion until disease recurrence or death, used for curative-intent treatments.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Relapse-Free Interval</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Relapse-Free Survival</skos:prefLabel>
        <abbreviation xml:lang="en">RFS</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/outcomes#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/relapse-free-survival"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/time-to-event"/>
        <dcterms:identifier>HEO-L-ce1d17261cd4</dcterms:identifier>
        <linkRationale xml:lang="en">Relapse-free survival is a time-to-event measure (as its definition says), not an analysis method.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/relapse-free-survival"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/recurrence"/>
        <dcterms:identifier>HEO-L-3bd9f06af524</dcterms:identifier>
        <linkRationale xml:lang="en">RFS is the time-to-event endpoint that records recurrence or death</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/relapse-period -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/relapse-period">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
