        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:definition xml:lang="en">Cross-validation estimates how well a prediction model, such as a cost or risk model, will perform on new data by testing it on data held out from fitting.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Out-of-Sample Validation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Resampling Validation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cross-Validation</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/bootstrapping"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/cross-validity-assessment"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/in-sample"/>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/overfitting"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/model-selection"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-9"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/test-set"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/training-set"/>
