    <!-- https://healtheconomics.wiki/concept/cost-plus-pricing -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cost-plus-pricing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-based-pricing"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q932294"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cost-based-pricing"/>
        <skos:notation>HS-DC-DP-020</skos:notation>
        <dcterms:identifier>HS-DC-DP-020</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</dcterms:modified>
        <dcterms:source>WHO 2020</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cost-Plus Pricing</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Cost-plus pricing sets the price of a medicine or health product as its estimated unit cost plus a profit mark-up, either a percentage or a fixed amount.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cost-Plus Markup</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Full-Cost Pricing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cost-Plus Pricing</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/value-based-pricing"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cost-plus-pricing"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-based-pricing"/>
        <dcterms:identifier>HEO-L-823fd5dac160</dcterms:identifier>
        <linkRationale xml:lang="en">A cost-based pricing method</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
