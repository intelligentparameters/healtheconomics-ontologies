        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cost-description"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/partial-economic-evaluation"/>
        <dcterms:identifier>HEO-L-8676defec283</dcterms:identifier>
        <linkRationale xml:lang="en">Cost Analysis is defined as comparing alternatives; a cost description compares none, so it is a partial evaluation</linkRationale>
