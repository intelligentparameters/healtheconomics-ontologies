    <!-- https://healtheconomics.wiki/concept/meta-regression-transfer -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/meta-regression-transfer">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/benefit-transfer"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/value-transfer"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/benefit-transfer"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/value-transfer"/>
        <skos:notation>HE-EE-CBA-033</skos:notation>
        <dcterms:identifier>HE-EE-CBA-033</dcterms:identifier>
        <dcterms:source>Nelson &amp; Kennedy 2009</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Meta-Regression Transfer</rdfs:label>
        <skos:altLabel xml:lang="en">Meta-Regression Benefit Transfer</skos:altLabel>
        <skos:definition xml:lang="en">A form of benefit transfer in which a regression model estimated across many original studies predicts a value for a new context based on its characteristics.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Regression-Based Transfer</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Meta-Regression Transfer</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/outcomes#step-4"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/meta-analysis"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/study-level-covariate"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/meta-regression-transfer"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/benefit-transfer"/>
        <dcterms:identifier>HEO-L-4bca6695119e</dcterms:identifier>
        <linkRationale xml:lang="en">The subject definition calls it a form of benefit transfer</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
