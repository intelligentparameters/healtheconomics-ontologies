    <!-- https://healtheconomics.wiki/concept/confidence-interval -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/confidence-interval">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/interval-estimate"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/interval-estimate"/>
        <skos:notation>HE-ES-SA-033</skos:notation>
        <dcterms:identifier>HE-ES-SA-033</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Greenland et al. 2016</dcterms:source>
