    <!-- https://healtheconomics.wiki/concept/neuropathic-pain -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/neuropathic-pain">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/neurological-disease-economics"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/neurological-disease-economics"/>
        <skos:notation>HE-PE-NR-014</skos:notation>
        <dcterms:identifier>HE-PE-NR-014</dcterms:identifier>
        <dcterms:source>Treede et al. 2008</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Neuropathic Pain</rdfs:label>
        <skos:altLabel xml:lang="en">Nerve Pain</skos:altLabel>
        <skos:definition xml:lang="en">Chronic pain arising from damage or dysfunction of the nervous system itself, rather than ongoing tissue injury, often burning or shooting in character.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Neuralgia</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Neuropathic Pain</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/disability"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/neuropathic-pain"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
