    <!-- https://healtheconomics.wiki/concept/difference-in-differences -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/difference-in-differences">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/quasi-experimental-design"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/quasi-experimental-design"/>
        <skos:notation>HE-ES-CER-008</skos:notation>
        <dcterms:identifier>HE-ES-CER-008</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-02</dcterms:modified>
        <dcterms:source>Card &amp; Krueger 1994</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Difference-in-Differences</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">DiD</skos:altLabel>
        <skos:altLabel xml:lang="en">Diff-in-Diff</skos:altLabel>
        <skos:definition xml:lang="en">Difference-in-differences (DiD) estimates a policy&apos;s causal effect by comparing outcome changes over time in an exposed group and a comparison group.</skos:definition>
        <skos:prefLabel xml:lang="en">Difference-in-Differences</skos:prefLabel>
        <abbreviation xml:lang="en">DiD</abbreviation>
        <abbreviation xml:lang="en">Diff-in-Diff</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/interrupted-time-series"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/synthetic-control"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/fixed-effects"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/robust-standard-error"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/difference-in-differences"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/quasi-experimental-design"/>
        <dcterms:identifier>HEO-L-ef399f73f640</dcterms:identifier>
        <linkRationale xml:lang="en">DiD estimates causal effects without randomisation, per the design definition</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/difference-in-differences"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/interrupted-time-series"/>
        <dcterms:identifier>HEO-L-c0bbb62d0854</dcterms:identifier>
