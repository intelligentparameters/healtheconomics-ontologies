    <!-- https://healtheconomics.wiki/concept/parametric-estimation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/parametric-estimation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/parametric-methods"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/survival-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/parametric-methods"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/survival-analysis"/>
        <skos:notation>HE-EM-SM-060</skos:notation>
        <dcterms:identifier>HE-EM-SM-060</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Collett 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Parametric Estimation</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A statistical approach estimating a survival function by assuming the data follow a specific distribution, such as Weibull or log-normal, with estimated parameters.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Distribution-Based Estimation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Parametric Fitting</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Parametric Estimation</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/parametric-survival-model"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/parametric-estimation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/parametric-methods"/>
        <dcterms:identifier>HEO-L-6c3a951d3c56</dcterms:identifier>
        <linkRationale xml:lang="en">Parametric estimation is a parametric method</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/parametric-estimation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/survival-analysis"/>
        <dcterms:identifier>HEO-L-943fc22372a3</dcterms:identifier>
        <linkRationale xml:lang="en">Parametric estimation of survival is one kind of survival analysis approach (subject definition)</linkRationale>
