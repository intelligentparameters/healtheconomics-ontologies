    <!-- https://healtheconomics.wiki/concept/scree-plot -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/scree-plot">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/data-visualisation"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q60526233"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/data-visualisation"/>
        <skos:notation>HE-ES-SA-190</skos:notation>
        <dcterms:identifier>HE-ES-SA-190</dcterms:identifier>
        <dcterms:source>Cattell 1966</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Scree Plot</rdfs:label>
        <skos:definition xml:lang="en">A graphical tool in factor analysis plotting eigenvalues in descending order to identify a visible point where they level off.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Eigenvalue Plot</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Scree Diagram</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Scree Plot</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/eigenvalue"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/scree-plot"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/data-visualisation"/>
        <dcterms:identifier>HEO-L-18b391904eb4</dcterms:identifier>
        <linkRationale xml:lang="en">A scree plot is a graphical presentation of data, a kind of data visualisation.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/scree-plot"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/eigenvalue"/>
        <dcterms:identifier>HEO-L-262d0fd91181</dcterms:identifier>
        <linkRationale xml:lang="en">The scree plot plots eigenvalues in descending order, so eigenvalues are its input.</linkRationale>
