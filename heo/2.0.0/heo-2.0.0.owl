        <measures rdf:resource="https://healtheconomics.wiki/concept/productivity"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/technical-efficiency"/>
        <skos:notation>HS-NHS-PM-012</skos:notation>
        <dcterms:identifier>HS-NHS-PM-012</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-24</dcterms:modified>
        <dcterms:source>F�re, Grosskopf, Norris &amp; Zhang 1994</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
