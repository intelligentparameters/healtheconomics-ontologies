    <!-- https://healtheconomics.wiki/concept/active-comparator -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/active-comparator">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/comparator"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/comparator"/>
        <skos:notation>HE-EE-CEA-001</skos:notation>
        <dcterms:identifier>HE-EE-CEA-001</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-03</dcterms:modified>
        <dcterms:source>EUnetHTA 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Active Comparator</rdfs:label>
        <owl:versionInfo>1.0.4</owl:versionInfo>
        <skos:altLabel xml:lang="en">Active Control</skos:altLabel>
        <skos:definition xml:lang="en">An active comparator is an existing treatment, rather than placebo, that a new health technology is compared with in HTA and economic evaluation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Active Reference</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Active Comparator</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/placebo-comparator"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-3"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/confounding-by-indication"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/active-comparator"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/comparator"/>
        <dcterms:identifier>HEO-L-aa6b3e7dd42b</dcterms:identifier>
        <linkRationale xml:lang="en">An active comparator is the alternative a new intervention is compared with</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
