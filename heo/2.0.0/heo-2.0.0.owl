    <!-- https://healtheconomics.wiki/concept/net-survival-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/net-survival-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
