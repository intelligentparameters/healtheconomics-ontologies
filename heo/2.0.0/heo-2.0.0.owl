        <informs rdf:resource="https://healtheconomics.wiki/concept/research-prioritisation"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-11"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
