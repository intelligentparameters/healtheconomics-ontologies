        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-system-performance"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/statistical-process-control"/>
        <skos:notation>HS-SS_HSP-016</skos:notation>
        <dcterms:identifier>HS-SS_HSP-016</dcterms:identifier>
        <dcterms:source>Shewhart 1931</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Control Chart Analysis</rdfs:label>
        <skos:definition xml:lang="en">The process of interpreting a control chart to determine whether observed variation reflects normal fluctuation or a significant change requiring action.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Control Chart Interpretation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">SPC Interpretation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Control Chart Analysis</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/run-chart-analysis"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/control-chart"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/control-chart-analysis"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
