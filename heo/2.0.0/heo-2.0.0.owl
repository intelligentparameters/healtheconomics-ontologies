    <!-- https://healtheconomics.wiki/concept/data-collection-requirement -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/data-collection-requirement">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
