        <skos:hiddenLabel xml:lang="en">Service Reach</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Service Coverage</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
