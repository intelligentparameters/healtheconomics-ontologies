    <!-- https://healtheconomics.wiki/concept/allocative-distortion -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/allocative-distortion">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/welfare-economics"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/welfare-economics"/>
        <skos:notation>HE-EE-WE-001</skos:notation>
        <dcterms:identifier>HE-EE-WE-001</dcterms:identifier>
        <dcterms:source>Varian 2014</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Allocative Distortion</rdfs:label>
        <skos:definition xml:lang="en">A departure from the efficient allocation of resources across competing uses, typically caused by market failure, regulation, or mispriced goods.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Allocative Inefficiency</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Resource Misallocation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Allocative Distortion</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/allocative-efficiency"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/deadweight-loss"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/allocative-distortion"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/welfare-economics"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-943e23cbdf70</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Welfare Economics: welfarism and extra-welfarism are the normative basis of cost-benefit and cost-effectiveness analysis; placed under Welfare Economics, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/allocative-distortion"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/allocative-efficiency"/>
        <dcterms:identifier>HEO-L-cad35e676cdc</dcterms:identifier>
        <linkRationale xml:lang="en">Departure from versus attainment of efficient allocation</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
