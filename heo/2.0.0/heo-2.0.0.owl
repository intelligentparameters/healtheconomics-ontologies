        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Interval Censoring</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A form of censoring in which an event&apos;s exact time is unknown but known to fall within a specific interval, such as between visits.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Between-Visit Censoring</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Interval-Censored Data</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Interval Censoring</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/left-censoring"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/right-censoring"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/interval-censoring"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/censoring"/>
        <dcterms:identifier>HEO-L-a2dcd6e54f63</dcterms:identifier>
        <linkRationale xml:lang="en">A form of censoring</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
