    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/highly-specialized-technology -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/highly-specialized-technology">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
