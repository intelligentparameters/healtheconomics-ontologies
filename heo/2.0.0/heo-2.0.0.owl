        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/demand-side-control"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/benefit-design"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/out-of-pocket-cost"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/plan-design"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/actuarial-value"/>
        <skos:notation>HS-HP-HI-053</skos:notation>
        <dcterms:identifier>HS-HP-HI-053</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563?643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cost Sharing</rdfs:label>
        <owl:versionInfo>1.0.3</owl:versionInfo>
        <skos:altLabel xml:lang="en">Cost-Sharing</skos:altLabel>
        <skos:definition xml:lang="en">Cost sharing is the part of the cost of covered care that an insured patient pays directly, through deductibles, co-payments or coinsurance, not premiums.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Patient Cost Share</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cost Sharing</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/employee-contribution"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/catastrophic-health-expenditure"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/underinsurance"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-2"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/ex-post-moral-hazard"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/financial-protection"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cost-sharing"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/demand-side-control"/>
        <dcterms:identifier>HEO-L-3df48b259089</dcterms:identifier>
        <linkRationale xml:lang="en">Object definition gives cost sharing as the example demand-side control</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cost-sharing"/>
