        <dcterms:source>Sullivan et al. 2014</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Affordability Criterion</rdfs:label>
        <skos:altLabel xml:lang="en">Sustainability Criterion</skos:altLabel>
        <skos:definition xml:lang="en">A standard judging whether a new technology&apos;s aggregate cost is sustainable within a health system&apos;s resources, considered separately from cost-effectiveness.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Affordability Standard</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Budget Sustainability Criterion</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Sustainability Test</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">System-Viability Criterion</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Affordability Criterion</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-threshold"/>
