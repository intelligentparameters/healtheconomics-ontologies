    <!-- https://healtheconomics.wiki/concept/recall-bias -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/recall-bias">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/information-bias"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/misclassification"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/information-bias"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/misclassification"/>
        <skos:notation>HE-DS-BV-027</skos:notation>
        <dcterms:identifier>HE-DS-BV-027</dcterms:identifier>
        <dcterms:source>Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams &amp; Wilkins; 2008.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Recall Bias</rdfs:label>
        <skos:definition xml:lang="en">A form of information bias where participants with a particular outcome recall past exposures differently, often more thoroughly, than those without it.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Memory Bias</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Retrospective Recall Error</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Recall Bias</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/patient-reported-outcome"/>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/self-reported-health"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/recall-bias"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/information-bias"/>
        <dcterms:identifier>HEO-L-ae13309bd269</dcterms:identifier>
        <linkRationale xml:lang="en">Recall bias is information bias.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/recall-bias"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/misclassification"/>
        <dcterms:identifier>HEO-L-7ef0b4693314</dcterms:identifier>
