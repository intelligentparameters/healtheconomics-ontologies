    <!-- https://healtheconomics.wiki/concept/unit-value-transfer -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/unit-value-transfer">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
