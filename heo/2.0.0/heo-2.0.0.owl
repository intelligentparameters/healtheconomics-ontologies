    <!-- https://healtheconomics.wiki/concept/spline-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/spline-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:notation>HE-EM-SM-080</skos:notation>
        <dcterms:identifier>HE-EM-SM-080</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Royston &amp; Parmar 2002</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Spline Model</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A model using piecewise polynomial functions joined smoothly at knots to represent a flexible, non-linear relationship such as time and hazard.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Piecewise Polynomial Model</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Spline-Based Model</skos:hiddenLabel>
