    <!-- https://healtheconomics.wiki/concept/upcoding -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/upcoding">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-HP-HSR-062</skos:notation>
        <dcterms:identifier>HS-HP-HSR-062</dcterms:identifier>
        <dcterms:source>AHIMA, Clinical Documentation Improvement guidance</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Upcoding</rdfs:label>
        <skos:altLabel xml:lang="en">Overcoding</skos:altLabel>
        <skos:definition xml:lang="en">A billing practice assigning a higher-level, more complex code than the clinical documentation actually supports, inappropriately increasing reimbursement.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Code Inflation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Upcoding</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/drg-creep"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/upcoding"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-54d10d976c7c</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health System Regulation: compliance, audit and accreditation govern how providers work (Organisation and governance)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/upcoding"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drg-creep"/>
        <dcterms:identifier>HEO-L-4f6cb55c753a</dcterms:identifier>
        <linkRationale xml:lang="en">Upcoding raises recorded case mix, DRG creep.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


