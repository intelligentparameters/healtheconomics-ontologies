    <!-- https://healtheconomics.wiki/concept/clinical-benefit-criterion -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/clinical-benefit-criterion">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
