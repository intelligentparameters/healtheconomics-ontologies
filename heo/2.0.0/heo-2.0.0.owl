    <!-- https://healtheconomics.wiki/concept/perspective -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/perspective">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/decision-problem"/>
        <skos:notation>HE-EE-CEA-052</skos:notation>
        <dcterms:identifier>HE-EE-CEA-052</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Perspective</rdfs:label>
        <owl:versionInfo>1.0.24</owl:versionInfo>
        <skos:definition xml:lang="en">Perspective in health economic evaluation is the viewpoint, such as the health system, payer or society, that decides which costs and outcomes are counted.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Analytic Viewpoint</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Costing Standpoint</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Perspective</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/cost-analysis"/>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/indirect-cost"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/perspective"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-c6b04693f31d</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Evaluation types and frameworks in subdomain Economic Evaluation; placed under Cost-Effectiveness Analysis, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/perspective"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/decision-problem"/>
        <dcterms:identifier>HEO-L-703e2721cd1d</dcterms:identifier>
        <linkRationale xml:lang="en">The decision maker&apos;s viewpoint is an element of the decision problem (object definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/perspective"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#setsScopeOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <dcterms:identifier>HEO-L-e7861ce3007f</dcterms:identifier>
