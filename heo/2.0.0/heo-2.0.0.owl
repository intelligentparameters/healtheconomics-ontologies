    <!-- https://healtheconomics.wiki/concept/drug-holiday -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/drug-holiday">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/deprescribing"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q5308895"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/deprescribing"/>
        <skos:notation>HE-PE-DT-014</skos:notation>
        <dcterms:identifier>HE-PE-DT-014</dcterms:identifier>
        <dcterms:source>Katzung 2017</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Drug Holiday</rdfs:label>
        <skos:altLabel xml:lang="en">Treatment Break</skos:altLabel>
        <skos:definition xml:lang="en">A planned, temporary discontinuation of a medication, used to reduce cumulative toxicity, manage side effects, or assess if treatment remains needed.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Planned Medication Pause</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Drug Holiday</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/adverse-drug-reaction"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/drug-tolerance"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/drug-holiday"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/deprescribing"/>
        <dcterms:identifier>HEO-L-a371c507daa2</dcterms:identifier>
        <linkRationale xml:lang="en">a planned stop to reassess need is a deprescribing strategy</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/drug-holiday"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/adverse-drug-reaction"/>
        <dcterms:identifier>HEO-L-2690cc0cac61</dcterms:identifier>
        <linkRationale xml:lang="en">a break lowers cumulative toxicity, per the subject definition</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
