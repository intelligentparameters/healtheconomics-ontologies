    <!-- https://healtheconomics.wiki/concept/quarantine -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/quarantine">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/global-health"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q182899"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/global-health"/>
        <skos:notation>HS-SS-GH-024</skos:notation>
        <dcterms:identifier>HS-SS-GH-024</dcterms:identifier>
        <dcterms:source>Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams &amp; Wilkins; 2008.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Quarantine</rdfs:label>
        <skos:definition xml:lang="en">A public health practice restricting movement of individuals who may have been exposed to a contagious disease but are not confirmed infected.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Movement Restriction</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Quarantine</skos:prefLabel>
