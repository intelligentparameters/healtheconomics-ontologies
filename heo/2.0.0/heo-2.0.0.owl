    <!-- https://healtheconomics.wiki/concept/scoring-algorithm -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/scoring-algorithm">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
