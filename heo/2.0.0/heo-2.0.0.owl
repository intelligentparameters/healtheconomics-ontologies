        <rdfs:label xml:lang="en">Marginal Analysis</rdfs:label>
        <owl:versionInfo>1.0.17</owl:versionInfo>
        <skos:definition xml:lang="en">Marginal analysis compares the extra cost and extra benefit of a small change in a health service, to judge whether expanding or cutting it is worthwhile.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Analysis at the Margin</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Incremental Reasoning</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Marginal Analysis</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/priority-setting"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/icer"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/marginal-cost-effectiveness"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
