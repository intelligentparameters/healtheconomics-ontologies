    <!-- https://healtheconomics.wiki/concept/health-investment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/health-investment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/demand-for-health"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/demand-for-health"/>
        <skos:notation>HE-EE-EPR-016</skos:notation>
        <dcterms:identifier>HE-EE-EPR-016</dcterms:identifier>
        <dcterms:source>Grossman 1972</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Health Investment</rdfs:label>
        <skos:altLabel xml:lang="en">Investment in Health</skos:altLabel>
        <skos:definition xml:lang="en">Resources an individual or system devotes to maintaining or improving health capital, including healthcare use, exercise, and other health-promoting behaviour.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Health-Improving Investment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Health Investment</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/health-capital"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
