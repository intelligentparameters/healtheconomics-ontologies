    <!-- https://healtheconomics.wiki/concept/technology-lifecycle -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/technology-lifecycle">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/horizon-scanning"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/horizon-scanning"/>
        <skos:notation>HS-HP-HS-019</skos:notation>
        <dcterms:identifier>HS-HP-HS-019</dcterms:identifier>
        <dcterms:source>DiMasi JA, Grabowski HG, Hansen RW. Innovation in the pharmaceutical industry: new estimates of R&amp;D costs. Journal of Health Economics. 2016;47:20-33. doi:10.1016/j.jhealeco.2016.01.012.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Technology Lifecycle</rdfs:label>
        <skos:altLabel xml:lang="en">Innovation Cycle</skos:altLabel>
        <skos:altLabel xml:lang="en">Lifecycle of Technology</skos:altLabel>
        <skos:altLabel xml:lang="en">Technology Life Cycle</skos:altLabel>
        <skos:definition xml:lang="en">The complete sequence of stages a technology passes through, from development and introduction through maturity to eventual decline or obsolescence.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Innovation Lifecycle</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Technology Development Cycle</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Technology Lifecycle</skos:prefLabel>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/lifecycle-management"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/technology-lifecycle"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/horizon-scanning"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-2fb6c453e792</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Horizon Scanning: horizon scanning is the first stage of an HTA process; placed under Horizon Scanning, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/technology-lifecycle"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isFoundationFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/lifecycle-management"/>
        <dcterms:identifier>HEO-L-ec8e5a521ab5</dcterms:identifier>
        <linkRationale xml:lang="en">The lifecycle is the sequence of stages; lifecycle management is the planning built on that idea, not a kind of it.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/technology-maturity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/technology-maturity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/horizon-scanning"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/horizon-scanning"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/technology-lifecycle"/>
        <skos:notation>HS-HP-HS-020</skos:notation>
        <dcterms:identifier>HS-HP-HS-020</dcterms:identifier>
        <dcterms:source>Douw &amp; Vondeling 2006</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Technology Maturity</rdfs:label>
        <skos:definition xml:lang="en">The degree to which a technology has an established evidence base and standardised, predictable clinical use, unlike a newly emerging one.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Maturity Stage</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Technology Readiness</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Technology Maturity</skos:prefLabel>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/health-technology"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
