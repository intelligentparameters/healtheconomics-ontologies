        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/drug-development"/>
        <skos:notation>HE-PE-DD-074</skos:notation>
        <dcterms:identifier>HE-PE-DD-074</dcterms:identifier>
        <dcterms:source>DiMasi JA, Grabowski HG, Hansen RW. Innovation in the pharmaceutical industry: new estimates of R&amp;D costs. Journal of Health Economics. 2016;47:20-33. doi:10.1016/j.jhealeco.2016.01.012.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Time to Market</rdfs:label>
        <skos:altLabel xml:lang="en">Speed to Market</skos:altLabel>
        <skos:definition xml:lang="en">The total elapsed time from a drug candidate&apos;s discovery to regulatory approval and market availability, often spanning a decade or more.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Launch Timeline</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Time to Market</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/research-and-development-cost"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/drug-development"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/time-to-market"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-development"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-3b36e82b46a6</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Pharmacoeconomics &gt; Drug Development: wiki topic Drug development and regulation sits in Health Policy; placed under Drug Development, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/time-to-market"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/research-and-development-cost"/>
        <dcterms:identifier>HEO-L-a285fd639da0</dcterms:identifier>
        <linkRationale xml:lang="en">Longer development time raises development cost, including the cost of capital tied up.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/time-to-market"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isPropertyOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-development"/>
        <dcterms:identifier>HEO-L-54cbefeedbf4</dcterms:identifier>
        <linkRationale xml:lang="en">Time to market is the elapsed duration of drug development, a characteristic of the process</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/time-to-response -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/time-to-response">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/time-to-event"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/time-to-event"/>
        <precedes rdf:resource="https://healtheconomics.wiki/concept/duration-of-response"/>
        <skos:notation>HE-EE-HU-077</skos:notation>
        <dcterms:identifier>HE-EE-HU-077</dcterms:identifier>
        <dcterms:source>Guyatt et al. 2002</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Time to Response</rdfs:label>
        <skos:definition xml:lang="en">The interval between the start of treatment and the point a patient meets a defined responder threshold on a relevant outcome measure.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Response Time</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Time until Response</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Time to Response</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
