        <skos:altLabel xml:lang="en">UCR</skos:altLabel>
        <skos:altLabel xml:lang="en">UCR Charge</skos:altLabel>
        <skos:definition xml:lang="en">A methodology insurers use to determine reimbursement for out-of-network care, based on typical charges for similar services in a geographic area.</skos:definition>
        <skos:prefLabel xml:lang="en">Usual Customary Reasonable</skos:prefLabel>
        <abbreviation xml:lang="en">UCR</abbreviation>
        <abbreviation xml:lang="en">UCR Charge</abbreviation>
        <counterpartOf rdf:resource="https://healtheconomics.wiki/concept/fee-schedule"/>
