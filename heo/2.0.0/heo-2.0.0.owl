    <!-- https://healtheconomics.wiki/concept/hawthorne-effect -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/hawthorne-effect">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/bias"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/bias"/>
        <skos:notation>HE-ES-CTM-039</skos:notation>
        <dcterms:identifier>HE-ES-CTM-039</dcterms:identifier>
        <dcterms:source>Landsberger 1958</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Hawthorne Effect</rdfs:label>
        <skos:definition xml:lang="en">A phenomenon in which participants alter their behaviour simply because they know they are being observed, independent of any specific intervention.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Observation Reactivity</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Observer Effect</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Hawthorne Effect</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/placebo-effect"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/effect-estimate"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/hawthorne-effect"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/bias"/>
        <dcterms:identifier>HEO-L-598cd31da9fa</dcterms:identifier>
        <linkRationale xml:lang="en">Hawthorne changes behaviour, not data recording, so Information Bias is wrong</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/hawthorne-effect"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/placebo-effect"/>
        <dcterms:identifier>HEO-L-0b5bcb379e9f</dcterms:identifier>
