    <!-- https://healtheconomics.wiki/concept/regressive-financing -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/regressive-financing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <skos:notation>HS-HP-HF-064</skos:notation>
        <dcterms:identifier>HS-HP-HF-064</dcterms:identifier>
        <dcterms:source>Musgrave &amp; Musgrave 1989</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Regressive Financing</rdfs:label>
        <skos:definition xml:lang="en">A financing arrangement where contributions fall as a proportion of income for wealthier individuals, so lower earners contribute a larger share.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Income-Falling Contribution</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Regressive Health Funding</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Regressive Financing</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/progressive-financing"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
