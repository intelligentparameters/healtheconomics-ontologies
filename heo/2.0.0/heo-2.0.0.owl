    <!-- https://healtheconomics.wiki/concept/kaldor-hicks-efficiency -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/kaldor-hicks-efficiency">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/welfare-economics"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/welfare-economics"/>
        <skos:notation>HE-EE_EA-029</skos:notation>
        <dcterms:identifier>HE-EE_EA-029</dcterms:identifier>
        <dcterms:source>Kaldor 1939</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Kaldor-Hicks Efficiency</rdfs:label>
        <skos:altLabel xml:lang="en">Compensation Criterion</skos:altLabel>
        <skos:altLabel xml:lang="en">Kaldor-Hicks Criterion</skos:altLabel>
        <skos:definition xml:lang="en">A criterion for judging welfare improvement, satisfied when gainers from a change could in principle compensate losers and still be better off.</skos:definition>
        <skos:prefLabel xml:lang="en">Kaldor-Hicks Efficiency</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/pareto-efficiency"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
