    <!-- https://healtheconomics.wiki/concept/health-worker-density -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/health-worker-density">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/workforce-planning"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/workforce-planning"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/availability"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/health-workforce"/>
        <skos:notation>HS-NHS-WP-002</skos:notation>
        <dcterms:identifier>HS-NHS-WP-002</dcterms:identifier>
        <dcterms:source>World Health Organization. Everybody&apos;s Business: Strengthening Health Systems to Improve Health Outcomes-WHO&apos;s Framework for Action. WHO; 2007.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Health Worker Density</rdfs:label>
        <skos:definition xml:lang="en">A measure of the number of healthcare workers, such as physicians or nurses, available relative to the population they serve.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Health Personnel Density</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Workforce Density</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Health Worker Density</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/workforce-planning"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-5"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/health-worker-density"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/workforce-planning"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-9340a31f0e45</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Performance productivity and quality in subdomain Health Systems; placed under Workforce Planning, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/health-worker-density"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/availability"/>
        <dcterms:identifier>HEO-L-527a32a914ea</dcterms:identifier>
        <linkRationale xml:lang="en">Availability is supply relative to need; a shortage lowers it and worker density quantifies it</linkRationale>
