        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Secondary Attack Rate</rdfs:label>
        <skos:altLabel xml:lang="en">SAR</skos:altLabel>
        <skos:definition xml:lang="en">A measure of infectious disease transmission, the proportion of susceptible close contacts of a primary case who themselves become infected.</skos:definition>
