    <!-- https://healtheconomics.wiki/concept/efficiency-incentive -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/efficiency-incentive">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-incentive"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/economic-incentive"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/value-based-payment"/>
        <skos:notation>HS-NHS-PM-007</skos:notation>
        <dcterms:identifier>HS-NHS-PM-007</dcterms:identifier>
        <dcterms:source>Carlson JJ, Sullivan SD, Garrison LP, Neumann PJ, Veenstra DL. Linking payment to health outcomes: a taxonomy and examination of performance-based reimbursement schemes. Health Policy. 2010;96(3):179-190.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Efficiency Incentive</rdfs:label>
        <skos:definition xml:lang="en">A financial reward or payment adjustment encouraging a provider to deliver care using fewer resources while maintaining or improving quality.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Efficiency Reward</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Productivity Incentive</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Efficiency Incentive</skos:prefLabel>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/operational-efficiency"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/efficiency-incentive"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-incentive"/>
        <dcterms:identifier>HEO-L-1b1f4c35d2b9</dcterms:identifier>
        <linkRationale xml:lang="en">A reward for using fewer resources is one kind of economic incentive</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
