    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/private-health-insurance"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/social-health-insurance"/>
        <dcterms:identifier>HEO-L-f5c19ac1bfa5</dcterms:identifier>
        <linkRationale xml:lang="en">Insurance should contrast with insurance: private premium-funded cover versus publicly mandated social insurance; Public Payer is an entity.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/private-insurance-premium -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/private-insurance-premium">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/premium"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/premium"/>
        <skos:notation>HS-HP-HF-058</skos:notation>
        <dcterms:identifier>HS-HP-HF-058</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Private Insurance Premium</rdfs:label>
        <skos:definition xml:lang="en">The periodic payment an individual or employer makes to a private insurer in exchange for coverage of specified healthcare costs.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Commercial Insurance Premium</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Private Cover Premium</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Private Insurance Premium</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/private-insurance-premium"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/premium"/>
        <dcterms:identifier>HEO-L-8084fab2831a</dcterms:identifier>
        <linkRationale xml:lang="en">A private insurance premium is a premium paid to a private insurer.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/private-payer -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/private-payer">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/healthcare-payer"/>
