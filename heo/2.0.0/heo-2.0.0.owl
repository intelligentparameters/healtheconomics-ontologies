    <!-- https://healtheconomics.wiki/concept/diagnostic-safety -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/diagnostic-safety">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/patient-safety"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/patient-safety"/>
        <skos:notation>HS-NHS-HQ-024</skos:notation>
        <dcterms:identifier>HS-NHS-HQ-024</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-12</dcterms:modified>
        <dcterms:source>Slawomirski et al. 2025</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Diagnostic Safety</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:definition xml:lang="en">Diagnostic safety is avoiding harm and wasted care from missed, delayed or wrong diagnoses, through correct, timely diagnoses explained to patients.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Diagnostic Error Prevention</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Safe Diagnosis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Diagnostic Safety</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/patient-outcome"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/diagnostic-safety"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/patient-safety"/>
        <dcterms:identifier>HEO-L-b25fe08e7c44</dcterms:identifier>
        <linkRationale xml:lang="en">diagnostic safety is the diagnosis-related part of patient safety, a kind of it</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/diagnostic-safety"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/patient-outcome"/>
        <dcterms:identifier>HEO-L-08cd29eb0242</dcterms:identifier>
        <linkRationale xml:lang="en">avoiding diagnostic error is a driver of patient outcomes</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
