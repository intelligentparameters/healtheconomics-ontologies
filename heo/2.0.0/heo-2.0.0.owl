    <!-- https://healtheconomics.wiki/concept/sequential-sampling -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/sequential-sampling">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-ES-CTM-085</skos:notation>
        <dcterms:identifier>HE-ES-CTM-085</dcterms:identifier>
        <dcterms:source>Wald 1947</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Sequential Sampling</rdfs:label>
        <skos:definition xml:lang="en">A data collection approach in which the decision to continue or stop sampling is made based on accumulating data, rather than a fixed sample size.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Adaptive Sampling</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Sequential Data Collection</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Sequential Sampling</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-1"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/stopping-rule"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/sequential-sampling"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-4bbf7ff9ff66</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Trial and study design in subdomain Evidence Synthesis</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/sequential-sampling"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/stopping-rule"/>
        <dcterms:identifier>HEO-L-fa244cc372e1</dcterms:identifier>
        <linkRationale xml:lang="en">Sequential sampling decides to stop or continue on accumulating data (subject definition) by applying a stopping rule</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/sequential-therapy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/sequential-therapy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/treatment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/treatment"/>
        <skos:notation>HE-PE-DT-040</skos:notation>
        <dcterms:identifier>HE-PE-DT-040</dcterms:identifier>
        <dcterms:source>DeVita, Lawrence &amp; Rosenberg 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Sequential Therapy</rdfs:label>
        <skos:altLabel xml:lang="en">Sequential Treatment</skos:altLabel>
        <skos:definition xml:lang="en">A treatment approach in which different agents are administered one after another in a planned order, unlike simultaneous combination therapy.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Step-Wise Therapy</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Sequential Therapy</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/combination-therapy"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/sequential-therapy"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/treatment"/>
        <dcterms:identifier>HEO-L-4ff6867b2bbd</dcterms:identifier>
        <linkRationale xml:lang="en">Adds the missing backbone parent; it already contrasts with Combination Therapy.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/sequential-therapy"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/combination-therapy"/>
        <dcterms:identifier>HEO-L-3d3dc2abb7e3</dcterms:identifier>
        <linkRationale xml:lang="en">Agents one after another contrasts with agents together.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/serial-interval -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/serial-interval">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/epidemiology"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q7454689"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/epidemiology"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/basic-reproduction-number"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/effective-reproduction-number"/>
        <skos:notation>HE-ES-EP-041</skos:notation>
        <dcterms:identifier>HE-ES-EP-041</dcterms:identifier>
        <dcterms:source>Anderson &amp; May 1991</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Serial Interval</rdfs:label>
        <skos:definition xml:lang="en">The time between symptom onset in a primary infected case and symptom onset in the secondary cases that person infects.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Case-to-Case Interval</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Serial Generation Interval</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Serial Interval</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/serial-interval"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/epidemiology"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-830ee4370dec</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Epidemiology: catalogue subdomain Evidence Synthesis is one of the subdomains; placed under Epidemiology, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/serial-interval"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/basic-reproduction-number"/>
        <dcterms:identifier>HEO-L-231ceacd2dd8</dcterms:identifier>
        <linkRationale xml:lang="en">R0 is estimated from growth rate and serial interval (Wallinga and Lipsitch 2007)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/serial-interval"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
