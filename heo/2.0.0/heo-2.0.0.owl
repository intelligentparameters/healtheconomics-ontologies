    <!-- https://healtheconomics.wiki/concept/programme-perspective -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/programme-perspective">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
