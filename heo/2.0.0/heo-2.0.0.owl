        <dcterms:identifier>HS-HP-HSM-018</dcterms:identifier>
        <dcterms:source>World Health Organization. Everybody&apos;s Business: Strengthening Health Systems to Improve Health Outcomes-WHO&apos;s Framework for Action. WHO; 2007.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Public System</rdfs:label>
        <skos:definition xml:lang="en">A health system model in which financing and delivery are predominantly provided through government-owned institutions, funded through taxation or mandatory insurance.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Government Health System</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">State-Run System</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Public System</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/private-system"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
