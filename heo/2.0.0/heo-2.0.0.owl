    <!-- https://healtheconomics.wiki/concept/evidence-synthesis-hta -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/evidence-synthesis-hta">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-ES-ESM-017</skos:notation>
        <dcterms:identifier>HE-ES-ESM-017</dcterms:identifier>
        <dcterms:source>Dias et al. 2013</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Evidence Synthesis HTA</rdfs:label>
        <skos:altLabel xml:lang="en">HTA Evidence Synthesis</skos:altLabel>
        <skos:definition xml:lang="en">The process of systematically combining findings from multiple studies into a coherent summary, supporting both effectiveness conclusions and model parameters.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Assessment Data Synthesis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Evidence Synthesis HTA</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/network-meta-analysis"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis-hta"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:identifier>HEO-L-7a06b20e44c9</dcterms:identifier>
        <linkRationale xml:lang="en">Synthesis for HTA is evidence synthesis</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis-hta"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/network-meta-analysis"/>
        <dcterms:identifier>HEO-L-8bff7ea6ac3c</dcterms:identifier>
