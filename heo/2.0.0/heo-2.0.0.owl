        <dcterms:identifier>HE-EE-DC-014</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-03</dcterms:modified>
        <dcterms:source>Cairns &amp; van der Pol 2000</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Time Preference</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Time preference is the preference for benefits sooner and costs later; in health economics it is one reason future costs and QALYs are discounted.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Impatience Parameter</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Temporal Discounting</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Time Preference</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-2"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/discount-rate-selection"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/differential-discounting"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/discount-rate"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/discounting-costs"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/private-discount-rate"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/time-preference"/>
