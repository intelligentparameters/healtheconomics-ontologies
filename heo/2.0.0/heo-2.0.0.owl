    <!-- https://healtheconomics.wiki/concept/likelihood-ratio -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/likelihood-ratio">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/diagnostic-accuracy"/>
        <skos:notation>HE-ES-RM-012</skos:notation>
        <dcterms:identifier>HE-ES-RM-012</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Sackett et al. 1991</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Likelihood Ratio</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">LR</skos:altLabel>
        <skos:definition xml:lang="en">A ratio comparing the likelihood of the same observed evidence under two specified conditions or statistical models.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Test Result Weight</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Likelihood Ratio</skos:prefLabel>
        <abbreviation xml:lang="en">LR</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/likelihood-ratio"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-910044aac933</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Epidemiology and risk measures in subdomain Evidence Synthesis</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
