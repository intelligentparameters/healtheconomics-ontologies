        <dcterms:source>Law &amp; Kelton 2000</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Patient Flow</rdfs:label>
        <skos:definition xml:lang="en">The movement of patients through a healthcare facility from arrival through treatment to discharge, encompassing the transitions along the way.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Flow of Patients</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Patient Throughput</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Patient Flow</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/throughput"/>
