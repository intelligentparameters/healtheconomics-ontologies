        <skos:hiddenLabel xml:lang="en">Research-into-Practice Translation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Evidence Implementation</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/implementation-strategy"/>
    </owl:NamedIndividual>
