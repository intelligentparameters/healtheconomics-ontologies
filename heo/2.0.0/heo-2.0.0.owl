        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/dynamic-transmission-model"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#represents"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/herd-immunity"/>
