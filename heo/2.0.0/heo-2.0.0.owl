    <!-- https://healtheconomics.wiki/concept/task-shifting -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/task-shifting">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/workforce-policy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/workforce-policy"/>
        <skos:notation>HS-NHS-WP-005</skos:notation>
        <dcterms:identifier>HS-NHS-WP-005</dcterms:identifier>
        <dcterms:source>WHO, Task Shifting: Global Recommendations</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Task Shifting</rdfs:label>
        <skos:definition xml:lang="en">The delegation of healthcare tasks from more highly trained workers to those with less training but adequate skill, maximising workforce capacity.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Role Delegation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Task Sharing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Task Shifting</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/skill-mix"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
