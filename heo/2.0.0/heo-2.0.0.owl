    <!-- https://healtheconomics.wiki/concept/attributable-risk -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/attributable-risk">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/risk-difference"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/risk-difference"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/attributable-fraction"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/number-needed-to-harm"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/population-attributable-fraction"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/population-attributable-risk"/>
        <skos:notation>HE-ES-RM-007</skos:notation>
        <dcterms:identifier>HE-ES-RM-007</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Coggon, Rose &amp; Barker 1997</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Attributable Risk</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Excess Risk</skos:altLabel>
        <skos:definition xml:lang="en">Attributable risk is the risk in exposed minus unexposed people: the excess attributed to exposure, which health economic models turn into costs and QALYs.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Exposure-Related Risk</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Attributable Risk</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/relative-risk"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/attributable-risk"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/risk-difference"/>
        <dcterms:identifier>HEO-L-4f46993cd455</dcterms:identifier>
        <linkRationale xml:lang="en">Exposed minus unexposed risk is a risk difference</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/attributable-risk"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/attributable-fraction"/>
        <dcterms:identifier>HEO-L-3f8b8cb5b92b</dcterms:identifier>
        <linkRationale xml:lang="en">Attributable fraction equals attributable risk divided by risk in the exposed</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/attributable-risk"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/number-needed-to-harm"/>
        <dcterms:identifier>HEO-L-b15074eb5d05</dcterms:identifier>
        <linkRationale xml:lang="en">The reciprocal of an exposure attributable risk is the number needed to harm; NNT applies to an intervention benefit</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/attributable-risk"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/population-attributable-fraction"/>
        <dcterms:identifier>HEO-L-07e9fbdb6b05</dcterms:identifier>
        <linkRationale xml:lang="en">PAF equals attributable risk times exposure prevalence divided by total risk</linkRationale>
