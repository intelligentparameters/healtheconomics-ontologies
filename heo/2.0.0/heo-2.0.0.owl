    <!-- https://healtheconomics.wiki/concept/non-dominated-alternative -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/non-dominated-alternative">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/efficiency-frontier"/>
        <skos:notation>HE-EE-CEA-045</skos:notation>
        <dcterms:identifier>HE-EE-CEA-045</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Non-Dominated Alternative</rdfs:label>
        <skos:definition xml:lang="en">An intervention on the cost-effectiveness frontier, meaning no other option or combination of options is both less costly and more effective.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Efficient Option</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Frontier Option</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Non-Dominated Alternative</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/non-dominated-alternative"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-caaff2ca0d86</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Cost-Effectiveness Analysis: wiki topic Cost-effectiveness analysis sits in Economic Evaluation; placed under Cost-Effectiveness Analysis, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/non-dominated-alternative"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/efficiency-frontier"/>
        <dcterms:identifier>HEO-L-e9b2d9540955</dcterms:identifier>
