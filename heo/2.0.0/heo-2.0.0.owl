        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/gini-coefficient"/>
        <dcterms:identifier>HEO-L-cbf37a9590f9</dcterms:identifier>
        <linkRationale xml:lang="en">A health Gini is a Gini coefficient</linkRationale>
