        <dcterms:identifier>CS-SC-VF-002</dcterms:identifier>
        <dcterms:source>U.S. Food and Drug Administration. General Principles of Software Validation; Final Guidance for Industry and FDA Staff. FDA; 2002.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Software Validation</rdfs:label>
        <skos:definition xml:lang="en">The process of confirming that software fulfils its intended purpose and produces results that are suitable for its intended use.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Fit-for-Purpose Check</skos:hiddenLabel>
