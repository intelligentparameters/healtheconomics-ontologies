    <!-- https://healtheconomics.wiki/concept/language-bias -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/language-bias">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/reporting-bias"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/reporting-bias"/>
        <skos:notation>HE-DS-BV-042</skos:notation>
        <dcterms:identifier>HE-DS-BV-042</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</dcterms:modified>
        <dcterms:source>Boutron et al. 2024</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Language Bias</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">Language bias is a reporting bias in which a study&apos;s language of publication depends on its results, so reviews limited to English can misstate effects.</skos:definition>
        <skos:prefLabel xml:lang="en">Language Bias</skos:prefLabel>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/meta-analysis"/>
