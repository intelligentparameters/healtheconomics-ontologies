        <dcterms:identifier>HEO-L-a60955212dbc</dcterms:identifier>
        <linkRationale xml:lang="en">Free pricing is a drug pricing regime</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
