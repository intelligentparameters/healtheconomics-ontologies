        <dcterms:identifier>HS-DC-MA-026</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Reimbursement Restriction</rdfs:label>
        <skos:altLabel xml:lang="en">Limitation</skos:altLabel>
        <skos:definition xml:lang="en">A coverage limitation, such as restricting a treatment to a patient subgroup or requiring prior therapy failure, to manage cost or ensure appropriate use.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Funding Caveat</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Funding Restriction</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Recommendation Restriction</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Restricted Coverage</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Reimbursement Restriction</skos:prefLabel>
        <modifies rdf:resource="https://healtheconomics.wiki/concept/reimbursement"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/restricted-listing"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/reimbursement-restriction"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/market-access"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-3a01a8deec13</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Drug Costs &gt; Market Access: concepts with this Level 3 that the wiki places in a topic sit in HTA (Reimbursement and managed access); placed under Market Access, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/reimbursement-restriction"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#modifies"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/reimbursement"/>
        <dcterms:identifier>HEO-L-1f9374af66de</dcterms:identifier>
