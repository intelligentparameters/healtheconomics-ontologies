        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:notation>HS-HP-HTA-143</skos:notation>
        <dcterms:identifier>HS-HP-HTA-143</dcterms:identifier>
        <dcterms:source>Wickizer &amp; Lessler 2002</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Overutilization</rdfs:label>
        <skos:altLabel xml:lang="en">Overuse</skos:altLabel>
        <skos:definition xml:lang="en">The use of healthcare services beyond what is clinically necessary or beneficial, an inefficient use of health system resources.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Excess Utilisation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Service Overprovision</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Overutilization</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/underuse"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/clinical-practice-variation"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/waste-in-healthcare"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/overutilization"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-6fc43ffa63c2</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health Technology Assessment: HTA concepts belong to the HTA subdomain</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/overutilization"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/underuse"/>
        <dcterms:identifier>HEO-L-1a4c1203d19b</dcterms:identifier>
        <linkRationale xml:lang="en">Overuse and underuse are the opposing quality failures (Chassin and Galvin 1998)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/overutilization"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/clinical-practice-variation"/>
        <dcterms:identifier>HEO-L-64b882557b64</dcterms:identifier>
        <linkRationale xml:lang="en">Variation is the observed pattern; overuse is one cause of unwarranted variation (Wennberg 2010)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
