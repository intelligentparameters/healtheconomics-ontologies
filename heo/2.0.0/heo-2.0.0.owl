    <!-- https://healtheconomics.wiki/concept/diagnosis-based-risk-score -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/diagnosis-based-risk-score">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/predicted-cost"/>
        <skos:notation>HS-HP-HI-068</skos:notation>
        <dcterms:identifier>HS-HP-HI-068</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-24</dcterms:modified>
        <dcterms:source>Ellis 2008</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Diagnosis-Based Risk Score</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A diagnosis-based risk score combines coded health conditions, often with demographic factors, to predict an outcome such as future healthcare spending relative to a model-specific reference.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Condition-Based Risk Score</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">DxCG</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Diagnosis-Based Risk Score</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/pharmacy-based-risk-score"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/diagnosis-based-risk-score"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
