    <!-- https://healtheconomics.wiki/concept/local-adaptation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/local-adaptation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:notation>HS-HP-HTA-124</skos:notation>
        <dcterms:identifier>HS-HP-HTA-124</dcterms:identifier>
        <dcterms:source>Welte et al. 2004</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Local Adaptation</rdfs:label>
        <skos:definition xml:lang="en">The process of modifying evidence or guidance from another setting to reflect specific local clinical practice, resources, and population.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Country Adaptation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Local Contextualisation</skos:hiddenLabel>
