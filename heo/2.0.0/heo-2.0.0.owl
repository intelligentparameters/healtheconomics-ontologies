        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Psychotherapy Cost</rdfs:label>
        <skos:definition xml:lang="en">The expense of providing talk-based mental health treatment by a trained therapist, varying by therapy type, format, and duration.</skos:definition>
