        <dcterms:identifier>HEO-L-44aca0bb3a00</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: curated: demand-for-health theory (Grossman), filed with Demand for Health, review B</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/health-investment"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
