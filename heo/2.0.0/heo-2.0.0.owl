    <!-- https://healtheconomics.wiki/concept/single-imputation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/single-imputation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/missing-data-methods"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/missing-data-methods"/>
        <skos:notation>HE-ES-SA-196</skos:notation>
        <dcterms:identifier>HE-ES-SA-196</dcterms:identifier>
        <dcterms:source>Rubin 1987</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Single Imputation</rdfs:label>
        <skos:altLabel xml:lang="en">Single Value Imputation</skos:altLabel>
        <skos:definition xml:lang="en">A missing data method replacing each missing value with a single estimated substitute, unlike multiple imputation, which generates several plausible values.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Deterministic Imputation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Single Imputation</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/multiple-imputation"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/single-imputation"/>
