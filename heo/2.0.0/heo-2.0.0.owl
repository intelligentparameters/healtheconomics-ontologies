    <!-- https://healtheconomics.wiki/concept/community-benefit -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/community-benefit">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
