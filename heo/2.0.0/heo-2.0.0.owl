    <!-- https://healtheconomics.wiki/concept/cognitively-impaired-research -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cognitively-impaired-research">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-HP-HSG-006</skos:notation>
        <dcterms:identifier>HS-HP-HSG-006</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-09</dcterms:modified>
        <dcterms:source>National Commission, Belmont Report 1979</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cognitively Impaired Research</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Cognitively impaired research is research with people whose impaired capacity may prevent valid consent, so proxy involvement and extra safeguards apply.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Diminished-Capacity Research</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Research with Impaired Capacity</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cognitively Impaired Research</skos:prefLabel>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/capacity-assessment"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/surrogate-decision-maker"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cognitively-impaired-research"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
