    <!-- https://healtheconomics.wiki/concept/black-box-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/black-box-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/model-validation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/model-validation"/>
        <skos:notation>HE-EM-MV-005</skos:notation>
        <dcterms:identifier>HE-EM-MV-005</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Rudin 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Black Box Model</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">A black box model is a model whose workings cannot be inspected or understood, such as a locked cost-effectiveness model or a deep learning algorithm.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Non-Transparent Model</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Opaque Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Black Box Model</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/open-source-model"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/white-box-model"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/black-box-model"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/model-validation"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-5497d0c60040</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Modelling &gt; Model Validation: catalogue subdomain Economic Modelling is one of the subdomains; placed under Model Validation, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/black-box-model"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/open-source-model"/>
        <dcterms:identifier>HEO-L-bbc088b022c4</dcterms:identifier>
        <linkRationale xml:lang="en">Openly inspectable code vs workings that cannot be inspected</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
