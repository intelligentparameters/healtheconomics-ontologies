        <precedes rdf:resource="https://healtheconomics.wiki/concept/biosimilar-uptake"/>
        <skos:notation>HE-PE-BM-004</skos:notation>
        <dcterms:identifier>HE-PE-BM-004</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
