    <!-- https://healtheconomics.wiki/concept/local-sensitivity-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/local-sensitivity-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/deterministic-sensitivity-analysis"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/sensitivity-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/deterministic-sensitivity-analysis"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/sensitivity-analysis"/>
        <skos:notation>HE-EM-UA-026</skos:notation>
        <dcterms:identifier>HE-EM-UA-026</dcterms:identifier>
        <dcterms:source>Saltelli et al. 2008</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Local Sensitivity Analysis</rdfs:label>
        <skos:altLabel xml:lang="en">Local SA</skos:altLabel>
        <skos:definition xml:lang="en">A sensitivity analysis examining how output changes with small variations around a fixed base case for each parameter, unlike global sensitivity analysis.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Derivative-Based Sensitivity Analysis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Local Sensitivity Analysis</skos:prefLabel>
        <abbreviation xml:lang="en">Local SA</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/global-sensitivity-analysis"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
