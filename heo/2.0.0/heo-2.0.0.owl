    <!-- https://healtheconomics.wiki/concept/deadweight-loss -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/deadweight-loss">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/welfare-economics"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q358063"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/welfare-economics"/>
        <skos:notation>HE-EE-WE-004</skos:notation>
        <dcterms:identifier>HE-EE-WE-004</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-02</dcterms:modified>
        <dcterms:source>Hines 1999</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Deadweight Loss</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Excess Burden</skos:altLabel>
        <skos:definition xml:lang="en">Deadweight loss is the net loss of total surplus when a tax, subsidy, market power or insurance drives a wedge between price and marginal cost.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Welfare Loss</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Deadweight Loss</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/allocative-efficiency"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/cost-benefit-analysis"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
