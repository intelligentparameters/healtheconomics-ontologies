        <dcterms:identifier>HE-ES-ES-014</dcterms:identifier>
        <dcterms:source>Groves et al. 2009</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Data Completeness</rdfs:label>
        <skos:definition xml:lang="en">The extent to which all intended data elements have actually been recorded, distinct from data accuracy, which concerns whether values are correct.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Data Coverage</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Record Completeness</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Data Completeness</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
