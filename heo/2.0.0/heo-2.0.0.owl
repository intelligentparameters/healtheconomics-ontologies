    <!-- https://healtheconomics.wiki/concept/emergency-research-waiver -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/emergency-research-waiver">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/waiver-of-consent"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/waiver-of-consent"/>
        <skos:notation>HS-HP-HSG-009</skos:notation>
        <dcterms:identifier>HS-HP-HSG-009</dcterms:identifier>
        <dcterms:source>FDA, Exception from Informed Consent for Emergency Research</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Emergency Research Waiver</rdfs:label>
        <skos:altLabel xml:lang="en">Exception from Informed Consent</skos:altLabel>
        <skos:definition xml:lang="en">A regulatory provision permitting research without prospective consent in narrowly defined emergencies where the affected individual cannot consent and no representative is available.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Deferred-Consent Waiver</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Emergency Research Waiver</skos:prefLabel>
        <modifies rdf:resource="https://healtheconomics.wiki/concept/informed-consent"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
