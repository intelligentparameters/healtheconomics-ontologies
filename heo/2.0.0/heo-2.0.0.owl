    <!-- https://healtheconomics.wiki/concept/heart-failure -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/heart-failure">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cardiovascular-economics"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
