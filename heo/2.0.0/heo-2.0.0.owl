        <skos:altLabel xml:lang="en">LOCF</skos:altLabel>
        <skos:definition xml:lang="en">Last observation carried forward (LOCF) fills missing trial follow-up values with each participant&apos;s last observed value, assuming no change after dropout.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Carry-Forward Imputation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Last Observation Carried Forward</skos:prefLabel>
        <abbreviation xml:lang="en">LOCF</abbreviation>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/missing-data"/>
