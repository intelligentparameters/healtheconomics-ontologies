        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/benefit-design"/>
        <skos:notation>HS-HP-HI-023</skos:notation>
        <dcterms:identifier>HS-HP-HI-023</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Benefit Limit</rdfs:label>
        <skos:altLabel xml:lang="en">Benefit Cap</skos:altLabel>
        <skos:definition xml:lang="en">A maximum amount, in money or number of services, that an insurance plan will pay for a specific care category within a defined period.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Coverage Ceiling</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Benefit Limit</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
