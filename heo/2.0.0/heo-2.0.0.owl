    <!-- https://healtheconomics.wiki/concept/progression-free-survival -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/progression-free-survival">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/surrogate-endpoint"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/surrogate-endpoint"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/disease-progression"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/quality-adjusted-time-without-symptoms"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/time-without-symptoms-of-progression"/>
        <skos:notation>HE-PE-OO-018</skos:notation>
        <dcterms:identifier>HE-PE-OO-018</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Latimer 2013</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Progression-Free Survival</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">PFS</skos:altLabel>
        <skos:definition xml:lang="en">Progression-free survival is the time from a prespecified origin, usually randomisation or treatment initiation, until objectively defined disease progression or death from any cause, whichever occurs first.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Time Without Progression</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Progression-Free Survival</skos:prefLabel>
        <abbreviation xml:lang="en">PFS</abbreviation>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/outcomes#step-1"/>
        <counterpartOf rdf:resource="https://healtheconomics.wiki/concept/relapse-free-survival"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/progression-free-survival"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/surrogate-endpoint"/>
        <dcterms:identifier>HEO-L-150d82b9b82e</dcterms:identifier>
        <linkRationale xml:lang="en">PFS is commonly used as a surrogate for overall survival in oncology HTA.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/progression-free-survival"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/disease-progression"/>
        <dcterms:identifier>HEO-L-0e1bfda82953</dcterms:identifier>
        <linkRationale xml:lang="en">PFS is not opposed to progression; it is the endpoint that quantifies time until progression or death</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/progression-free-survival"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/quality-adjusted-time-without-symptoms"/>
        <dcterms:identifier>HEO-L-315918ba2342</dcterms:identifier>
        <linkRationale xml:lang="en">PFS splits time into states for Q-TWiST</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/progression-free-survival"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/time-without-symptoms-of-progression"/>
        <dcterms:identifier>HEO-L-387e307b5799</dcterms:identifier>
