    <!-- https://healtheconomics.wiki/concept/financial-efficiency -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/financial-efficiency">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/efficiency"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/efficiency"/>
        <skos:notation>HS-SS_HSP-027</skos:notation>
        <dcterms:identifier>HS-SS_HSP-027</dcterms:identifier>
        <dcterms:source>Horngren, Datar &amp; Rajan 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Financial Efficiency</rdfs:label>
        <skos:definition xml:lang="en">A measure of how effectively an organisation converts financial resources into patient care activity and outcomes, avoiding unnecessary spending.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cost Efficiency of Finance</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Fiscal Efficiency</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Financial Efficiency</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/financial-efficiency"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/efficiency"/>
        <dcterms:identifier>HEO-L-0d21a3cda395</dcterms:identifier>
        <linkRationale xml:lang="en">Financial efficiency is efficiency judged on financial resources</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/financial-feasibility -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/financial-feasibility">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/feasibility-assessment"/>
