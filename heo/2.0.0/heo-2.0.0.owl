        <skos:notation>HE-EE-CUA-007</skos:notation>
        <dcterms:identifier>HE-EE-CUA-007</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Kamaraj et al. 2021</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Incremental Cost-Utility Ratio</rdfs:label>
        <owl:versionInfo>1.0.3</owl:versionInfo>
        <skos:altLabel xml:lang="en">ICUR</skos:altLabel>
        <skos:definition xml:lang="en">The incremental cost-utility ratio (ICUR) is the ICER of a cost-utility analysis: extra cost over a comparator divided by extra QALYs gained.</skos:definition>
        <skos:prefLabel xml:lang="en">Incremental Cost-Utility Ratio</skos:prefLabel>
        <abbreviation xml:lang="en">ICUR</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/average-cost-effectiveness-ratio"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/net-health-benefit"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/net-monetary-benefit"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-4"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/coverage-decision"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/incremental-cost-utility-ratio"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/icer"/>
        <dcterms:identifier>HEO-L-9538c9208293</dcterms:identifier>
        <linkRationale xml:lang="en">An ICUR is an ICER with QALYs.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
