    <!-- https://healtheconomics.wiki/concept/decision-utility -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/decision-utility">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/utility"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/utility"/>
        <skos:notation>HE-EE-HU-014</skos:notation>
        <dcterms:identifier>HE-EE-HU-014</dcterms:identifier>
        <dcterms:source>Kahneman, Wakker &amp; Sarin 1997</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Decision Utility</rdfs:label>
        <skos:definition xml:lang="en">The value an individual assigns to an outcome at the moment of choosing it, based on anticipated experience, unlike experienced utility.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Anticipated Utility</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Decision-Based Utility</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Decision Utility</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
