        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/patient-access-programme"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#addresses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/access-barrier"/>
        <dcterms:identifier>HEO-L-300d846555f1</dcterms:identifier>
        <linkRationale xml:lang="en">Designed to overcome cost and coverage barriers to a treatment.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/patient-access-programme"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#promotes"/>
