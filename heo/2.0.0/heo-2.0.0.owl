        <dcterms:identifier>HEO-L-f28a10b530d6</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Health financing and insurance in subdomain Health Systems; placed under Health Insurance, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/diagnosis-based-risk-score"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/predicted-cost"/>
        <dcterms:identifier>HEO-L-bccb5d27a5e1</dcterms:identifier>
