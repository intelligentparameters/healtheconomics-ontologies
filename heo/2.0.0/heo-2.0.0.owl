    <!-- https://healtheconomics.wiki/concept/opportunity-cost -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/opportunity-cost">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-principle"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q185715"/>
