    <!-- https://healtheconomics.wiki/concept/gaussian-process-regression -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/gaussian-process-regression">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/non-parametric-methods"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q225926"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/non-parametric-methods"/>
        <skos:notation>HE-EM-DM-036</skos:notation>
        <dcterms:identifier>HE-EM-DM-036</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Rasmussen &amp; Williams 2006</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Gaussian Process Regression</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">GPR</skos:altLabel>
        <skos:altLabel xml:lang="en">Kriging</skos:altLabel>
        <skos:definition xml:lang="en">Gaussian process regression is a probabilistic method that predicts an unknown function from observed input-output pairs by conditioning a joint Gaussian model specified through a mean and covariance function.</skos:definition>
        <skos:prefLabel xml:lang="en">Gaussian Process Regression</skos:prefLabel>
        <abbreviation xml:lang="en">GPR</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-12"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/gaussian-process"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
