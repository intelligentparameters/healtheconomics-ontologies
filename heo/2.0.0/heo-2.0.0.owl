        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/prom"/>
        <dcterms:identifier>HEO-L-ed14d2c1cdb5</dcterms:identifier>
        <linkRationale xml:lang="en">A patient-reported instrument; it captures symptomatic adverse events (frequency, severity, interference).</linkRationale>
