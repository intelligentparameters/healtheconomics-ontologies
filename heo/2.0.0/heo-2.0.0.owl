    <!-- https://healtheconomics.wiki/concept/service-utilisation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/service-utilisation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/resource-utilisation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/resource-utilisation"/>
        <skos:notation>HS-NHS-PM-019</skos:notation>
        <dcterms:identifier>HS-NHS-PM-019</dcterms:identifier>
        <dcterms:source>World Health Organization. Everybody&apos;s Business: Strengthening Health Systems to Improve Health Outcomes-WHO&apos;s Framework for Action. WHO; 2007.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Service Utilisation</rdfs:label>
        <skos:altLabel xml:lang="en">Healthcare Utilisation</skos:altLabel>
        <skos:altLabel xml:lang="en">Service Use</skos:altLabel>
        <skos:definition xml:lang="en">The extent to which a defined population uses a specific healthcare service, commonly measured as a rate per population over a period.</skos:definition>
        <skos:prefLabel xml:lang="en">Service Utilisation</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/service-utilisation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/resource-utilisation"/>
        <dcterms:identifier>HEO-L-fa4ca5ceeda3</dcterms:identifier>
        <linkRationale xml:lang="en">Use of a service by a population is one form of resource utilisation.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/service-volume -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/service-volume">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
