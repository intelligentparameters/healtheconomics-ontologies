    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/price-indexation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/price-indexation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/price-control"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/price-control"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:notation>HS-DC-DP-067</skos:notation>
        <dcterms:identifier>HS-DC-DP-067</dcterms:identifier>
        <dcterms:source>Danzon 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Price Indexation</rdfs:label>
        <skos:definition xml:lang="en">A mechanism tying a drug&apos;s allowed price increases to a specified inflation index, limiting growth to a predictable, generally modest rate.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Indexed Pricing</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Price Linking</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Price Indexation</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/health-price-index"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/price-indexation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/price-control"/>
        <dcterms:identifier>HEO-L-c490dc4a55bc</dcterms:identifier>
        <linkRationale xml:lang="en">Capping increases at an index is a form of price control.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/price-indexation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <dcterms:identifier>HEO-L-169873c2ece8</dcterms:identifier>
        <linkRationale xml:lang="en">Indexation is a pricing mechanism within drug pricing arrangements (both definitions)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/price-indexation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-price-index"/>
        <dcterms:identifier>HEO-L-7784a4446311</dcterms:identifier>
