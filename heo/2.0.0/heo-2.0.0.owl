    <!-- https://healtheconomics.wiki/concept/crisis-intervention -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/crisis-intervention">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/intervention"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/intervention"/>
        <skos:notation>HE-PE-MH-010</skos:notation>
        <dcterms:identifier>HE-PE-MH-010</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Crisis Intervention</rdfs:label>
        <skos:definition xml:lang="en">A short-term, intensive treatment for an acute mental health crisis, intended to stabilise the situation and connect the individual with ongoing care.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Acute Crisis Response</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Crisis Care</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Crisis Intervention</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/psychiatric-hospitalization"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
