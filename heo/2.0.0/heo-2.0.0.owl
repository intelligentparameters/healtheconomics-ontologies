        <skos:hiddenLabel xml:lang="en">Wellness Promotion</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Health Promotion</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/social-determinants-of-health"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
