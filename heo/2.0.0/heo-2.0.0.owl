    <!-- https://healtheconomics.wiki/concept/modified-itt -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/modified-itt">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/intention-to-treat-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/intention-to-treat-analysis"/>
        <skos:notation>HE-ES-CTM-053</skos:notation>
        <dcterms:identifier>HE-ES-CTM-053</dcterms:identifier>
        <dcterms:source>Friedman LM, Furberg CD, DeMets DL, Reboussin DM, Granger CB. Fundamentals of Clinical Trials. 5th ed. Springer; 2015. doi:10.1007/978-3-319-18539-2.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Modified ITT</rdfs:label>
        <skos:altLabel xml:lang="en">Modified Intention-to-Treat</skos:altLabel>
        <skos:altLabel xml:lang="en">mITT</skos:altLabel>
        <skos:definition xml:lang="en">A variation of intention-to-treat analysis excluding a small, prespecified subset of participants, such as those never dosed, while keeping others by original assignment.</skos:definition>
        <skos:prefLabel xml:lang="en">Modified ITT</skos:prefLabel>
        <abbreviation xml:lang="en">mITT</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/per-protocol-analysis"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/modified-itt"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/intention-to-treat-analysis"/>
        <dcterms:identifier>HEO-L-8d7f007b8ddb</dcterms:identifier>
        <linkRationale xml:lang="en">Definition says a variation of intention-to-treat analysis</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/modified-itt"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/per-protocol-analysis"/>
