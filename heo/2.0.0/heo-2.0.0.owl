    <!-- https://healtheconomics.wiki/concept/standard-gamble -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/standard-gamble">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/choice-based-method"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-state-valuation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/choice-based-method"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-state-valuation"/>
        <skos:notation>HE-EE-HU-073</skos:notation>
        <dcterms:identifier>HE-EE-HU-073</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Torrance, Thomas &amp; Sackett 1972</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Standard Gamble</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">SG</skos:altLabel>
        <skos:definition xml:lang="en">The standard gamble is a choice-based health-state valuation method that finds the probability at which a respondent is indifferent between living in a certain health state and accepting a lottery between specified better and worse outcomes.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Reference Gamble</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Standard Gamble</skos:prefLabel>
        <abbreviation xml:lang="en">SG</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/time-trade-off"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/outcomes#step-2"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/utility"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/standard-gamble"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/choice-based-method"/>
        <dcterms:identifier>HEO-L-c40561c50b05</dcterms:identifier>
        <linkRationale xml:lang="en">Standard gamble is choice-based, named in the definition.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
