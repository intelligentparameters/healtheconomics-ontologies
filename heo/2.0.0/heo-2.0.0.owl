    <!-- https://healtheconomics.wiki/concept/time-lag-bias -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/time-lag-bias">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/reporting-bias"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/reporting-bias"/>
        <skos:notation>HE-DS-BV-043</skos:notation>
        <dcterms:identifier>HE-DS-BV-043</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</dcterms:modified>
        <dcterms:source>Boutron et al. 2024</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Time-Lag Bias</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">Time-lag bias is distortion of the evidence available at a given time because studies with favourable or significant results are published sooner.</skos:definition>
        <skos:prefLabel xml:lang="en">Time-Lag Bias</skos:prefLabel>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/meta-analysis"/>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/treatment-effect"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/time-lag-bias"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/reporting-bias"/>
        <dcterms:identifier>HEO-L-768fbb474090</dcterms:identifier>
        <linkRationale xml:lang="en">Cochrane lists time-lag bias among reporting biases.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
