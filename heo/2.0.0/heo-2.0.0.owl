        <dcterms:identifier>HS-HP-HTA-183</dcterms:identifier>
        <dcterms:source>Danzon 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Restricted Listing</rdfs:label>
        <skos:definition xml:lang="en">The inclusion of a treatment on a reimbursement list subject to specific conditions, such as a patient subgroup restriction or prior authorisation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Conditional Listing</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Restricted Reimbursement</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Restricted Listing</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/unrestricted-listing"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/eligible-population"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/restricted-listing"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
