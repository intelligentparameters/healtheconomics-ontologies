        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/demand"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isFoundationFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/market-equilibrium"/>
        <dcterms:identifier>HEO-L-5db8b7822305</dcterms:identifier>
