        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/discrimination-barrier"/>
        <skos:notation>HS-HP-HI-085</skos:notation>
        <dcterms:identifier>HS-HP-HI-085</dcterms:identifier>
        <dcterms:source>US, Genetic Information Nondiscrimination Act</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Genetic Discrimination</rdfs:label>
        <skos:definition xml:lang="en">The unfair treatment of an individual based on their genetic information, such as denying insurance based on genetic test results.</skos:definition>
        <skos:hiddenLabel xml:lang="en">DNA-Based Discrimination</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Genetic Bias</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Genetic Discrimination</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/health-inequity"/>
