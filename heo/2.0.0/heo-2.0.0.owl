        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">Survival estimates derived from a fitted mathematical distribution rather than directly from observed data alone, allowing extrapolation beyond the data.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Assumed-Form Survival</skos:hiddenLabel>
