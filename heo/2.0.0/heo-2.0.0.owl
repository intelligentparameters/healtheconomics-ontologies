    <!-- https://healtheconomics.wiki/concept/work-productivity-outcome -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/work-productivity-outcome">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/patient-reported-outcome"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/patient-reported-outcome"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/work-productivity"/>
        <skos:notation>HE-ES-PM-002</skos:notation>
        <dcterms:identifier>HE-ES-PM-002</dcterms:identifier>
        <dcterms:source>Reilly, Zbrozek &amp; Dukes 1993</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Work Productivity Outcome</rdfs:label>
        <skos:definition xml:lang="en">A measure capturing a health condition&apos;s effect on work-related productivity, covering both absenteeism, time missed entirely, and presenteeism, reduced performance while present.</skos:definition>
        <skos:prefLabel xml:lang="en">Work Productivity Outcome</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
