    <!-- https://healtheconomics.wiki/concept/independent-assessment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/independent-assessment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/assessment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/assessment"/>
        <skos:notation>HS-HP-HTA-109</skos:notation>
        <dcterms:identifier>HS-HP-HTA-109</dcterms:identifier>
        <dcterms:source>National Institute for Health and Care Excellence. NICE technology appraisal and highly specialised technologies guidance: the manual (PMG36). Published 2022; updated 2026.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Independent Assessment</rdfs:label>
        <skos:definition xml:lang="en">An assessment conducted by an evaluator without a direct financial interest in the outcome, unlike one funded by the manufacturer.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Arms-Length Assessment</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Independent Evaluation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Independent Assessment</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/conflict-of-interest"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/manufacturer-submission"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
