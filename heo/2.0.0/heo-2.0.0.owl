    <!-- https://healtheconomics.wiki/concept/drug-resistance -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/drug-resistance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q12147416"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-PE-DT-016</skos:notation>
        <dcterms:identifier>HE-PE-DT-016</dcterms:identifier>
        <dcterms:source>Katzung 2017</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Drug Resistance</rdfs:label>
        <skos:definition xml:lang="en">A reduction in a treatment&apos;s effectiveness over time due to biological adaptation, such as mutation of a pathogen or tumour cell population.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Reduced Drug Susceptibility</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Treatment Resistance</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Drug Resistance</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/treatment-failure"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/drug-resistance"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-c09ee0b7e964</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Pharmacoeconomics &gt; Drug Therapy: dosing and treatment-line terms describe the clinical evidence and treatment pathways that models use</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/drug-resistance"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/treatment-failure"/>
        <dcterms:identifier>HEO-L-3a83219f192b</dcterms:identifier>
        <skos:editorialNote xml:lang="en">suggested source, not yet checked: Holohan et al. 2013</skos:editorialNote>
        <linkRationale xml:lang="en">Drug resistance is a mechanism causing treatment failure (partial cause), not an exposure-type risk factor</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/drug-standards -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/drug-standards">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
