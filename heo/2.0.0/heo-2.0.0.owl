    <!-- https://healtheconomics.wiki/concept/dose-finding -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/dose-finding">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-development"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/drug-development"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/drug-development"/>
        <skos:notation>HE-PE-DD-014</skos:notation>
        <dcterms:identifier>HE-PE-DD-014</dcterms:identifier>
        <dcterms:source>Le Tourneau, Lee &amp; Siu 2009</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Dose Finding</rdfs:label>
        <skos:altLabel xml:lang="en">Dose-Finding Study</skos:altLabel>
        <skos:definition xml:lang="en">The overall process of identifying an appropriate dose or regimen for a new treatment, balancing efficacy against tolerability during early development.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Dose Optimisation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Dose Finding</skos:prefLabel>
        <produces rdf:resource="https://healtheconomics.wiki/concept/maximum-tolerated-dose"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/minimum-effective-dose"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/recommended-phase-2-dose"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/dose-finding"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
