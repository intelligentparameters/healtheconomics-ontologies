        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Rent Seeking</rdfs:label>
        <skos:altLabel xml:lang="en">Rent-Seeking Behaviour</skos:altLabel>
        <skos:definition xml:lang="en">The pursuit of increased wealth through manipulating the economic or political environment, rather than through creating new value via production.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Unproductive Profit-Seeking</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Rent Seeking</skos:prefLabel>
