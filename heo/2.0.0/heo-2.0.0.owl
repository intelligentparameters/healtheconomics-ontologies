    <!-- https://healtheconomics.wiki/concept/opportunity-cost-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/opportunity-cost-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-principle"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-principle"/>
        <skos:notation>HE-EE-EPR-031</skos:notation>
        <dcterms:identifier>HE-EE-EPR-031</dcterms:identifier>
        <dcterms:source>Claxton et al. 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Opportunity Cost Analysis</rdfs:label>
        <skos:altLabel xml:lang="en">Opportunity Cost Assessment</skos:altLabel>
        <skos:definition xml:lang="en">A form of analysis explicitly estimating the health or value forgone elsewhere in a system when resources are allocated to a specific intervention.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Displacement Assessment</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Foregone-Benefit Analysis</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Opportunity-Cost Appraisal</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Opportunity-Cost Evaluation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Opportunity Cost Analysis</skos:prefLabel>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/opportunity-cost"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/opportunity-cost-criterion"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/resource-allocation"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
