    <!-- https://healtheconomics.wiki/concept/resource-reallocation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/resource-reallocation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/resource-allocation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/resource-allocation"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/priority-setting"/>
        <skos:notation>HS-HP-HF-066</skos:notation>
        <dcterms:identifier>HS-HP-HF-066</dcterms:identifier>
        <dcterms:source>Mooney, Russell &amp; Weir 1986</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Resource Reallocation</rdfs:label>
        <skos:definition xml:lang="en">The process of shifting resources from lower-value to higher-value uses, informed by comparative cost-effectiveness evidence, the core of priority setting.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Fund Redeployment</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Resource Shifting</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Resource Reallocation</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/resource-reallocation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/resource-allocation"/>
        <dcterms:identifier>HEO-L-cde4df34ec60</dcterms:identifier>
        <linkRationale xml:lang="en">Reallocation is a form of resource allocation.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/resource-reallocation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/priority-setting"/>
        <dcterms:identifier>HEO-L-fbb6d3a6a7c9</dcterms:identifier>
