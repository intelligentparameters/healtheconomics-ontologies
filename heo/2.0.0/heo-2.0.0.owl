    <!-- https://healtheconomics.wiki/concept/disease-control-rate -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/disease-control-rate">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/tumour-response"/>
        <skos:notation>HE-PE-OO-008</skos:notation>
        <dcterms:identifier>HE-PE-OO-008</dcterms:identifier>
        <dcterms:source>Eisenhauer et al. 2009</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Disease Control Rate</rdfs:label>
        <skos:altLabel xml:lang="en">DCR</skos:altLabel>
        <skos:definition xml:lang="en">A cancer outcome measure combining complete response, partial response, and stable disease rates, characterising the proportion whose disease did not progress.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Non-Progression Proportion</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Disease Control Rate</skos:prefLabel>
        <abbreviation xml:lang="en">DCR</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/outcomes#step-1"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/disease-control-rate"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
