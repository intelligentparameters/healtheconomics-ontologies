    <!-- https://healtheconomics.wiki/concept/means-testing -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/means-testing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
