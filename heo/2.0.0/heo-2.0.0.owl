    <!-- https://healtheconomics.wiki/concept/benefit-transfer -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/benefit-transfer">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
