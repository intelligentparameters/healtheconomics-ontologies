    <!-- https://healtheconomics.wiki/concept/rational-choice -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/rational-choice">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-principle"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-principle"/>
        <skos:notation>HE-EE-EPR-040</skos:notation>
        <dcterms:identifier>HE-EE-EPR-040</dcterms:identifier>
        <dcterms:source>Varian 2014</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Rational Choice</rdfs:label>
        <skos:definition xml:lang="en">A model of decision-making in which individuals are assumed to select the option that maximises their expected utility given preferences and information.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Rational Agent Model</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Utility Maximisation Assumption</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Rational Choice</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/behavioural-economics"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/welfare-economics"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/utility"/>
    </owl:NamedIndividual>
