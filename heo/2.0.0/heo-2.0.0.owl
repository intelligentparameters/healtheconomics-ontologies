    <!-- https://healtheconomics.wiki/concept/incentive-intervention -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/incentive-intervention">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/behaviour-change-technique"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/behaviour-change-technique"/>
        <skos:notation>HE-EE-BE-025</skos:notation>
        <dcterms:identifier>HE-EE-BE-025</dcterms:identifier>
        <dcterms:source>Volpp et al. 2009</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Incentive Intervention</rdfs:label>
        <skos:definition xml:lang="en">The use of monetary or non-monetary rewards to encourage a desired health behaviour, such as smoking cessation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Financial Incentive Programme</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Reward Intervention</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Incentive Intervention</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/nudge-intervention"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/incentive-intervention"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/behaviour-change-technique"/>
        <dcterms:identifier>HEO-L-54f2859fead5</dcterms:identifier>
        <linkRationale xml:lang="en">Incentives are a coded BCT.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/incentive-intervention"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
