        <dcterms:identifier>HS-HP-HTA-100</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>O’Rourke B, Oortwijn W, Schuller T, International Joint Task Group. The new definition of health technology assessment. Int J Technol Assess Health Care. 2020;36(3):187–190. doi:10.1017/S0266462320000215 | WHO. Health Technology Assessment of Medical Devices. 2nd ed. 2025. https://www.who.int/publications/i/item/9789240110878 | NICE. Health Technology Evaluations: The Manual. PMG36. https://www.nice.org.uk/process/pmg36 | European Commission. Implementation of Regulation (EU) 2021/2282. https://health.ec.europa.eu/health-technology-assessment/implementation-regulation-health-technology-assessment_en</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Health Technology Assessment</rdfs:label>
