        <skos:notation>HE-EM-MV-048</skos:notation>
        <dcterms:identifier>HE-EM-MV-048</dcterms:identifier>
        <dcterms:source>Philips et al. 2004</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Model Parsimony</rdfs:label>
        <skos:definition xml:lang="en">The principle that a model should be no more complex than necessary to address its intended decision question adequately.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Model Economy</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Parsimonious Modelling</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Model Parsimony</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/model-transparency"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/model-simplification"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/level-of-detail"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/model-parsimony"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/model-validation"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-1ca5264380f7</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Modelling &gt; Model Validation: catalogue subdomain Economic Modelling is one of the subdomains; placed under Model Validation, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/model-parsimony"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/model-transparency"/>
        <dcterms:identifier>HEO-L-c321afba782e</dcterms:identifier>
        <linkRationale xml:lang="en">Simpler models are easier for reviewers to follow.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/model-parsimony"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isFoundationFor"/>
