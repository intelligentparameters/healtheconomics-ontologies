    <!-- https://healtheconomics.wiki/concept/diagnosis-coverage -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/diagnosis-coverage">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
