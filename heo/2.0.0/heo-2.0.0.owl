    <!-- https://healtheconomics.wiki/concept/high-value-care -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/high-value-care">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-NHS-VBH-008</skos:notation>
        <dcterms:identifier>HS-NHS-VBH-008</dcterms:identifier>
        <dcterms:source>Owens et al. 2011</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">High-Value Care</rdfs:label>
        <skos:altLabel xml:lang="en">High-Value Healthcare</skos:altLabel>
        <skos:definition xml:lang="en">Healthcare providing substantial benefit relative to its cost and potential harms, the outcome quality improvement and cost-effectiveness aim to promote.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cost-Effective Care</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">High-Value Care</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/low-value-care"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/high-value-care"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-fa51e1b29a12</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; NHS Productivity &gt; Value-Based Healthcare: wiki topic Performance, productivity and quality sits in Health Systems</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/high-value-care"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/low-value-care"/>
        <dcterms:identifier>HEO-L-fed403db46d5</dcterms:identifier>
