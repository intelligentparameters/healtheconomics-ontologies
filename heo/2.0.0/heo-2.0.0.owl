    <!-- https://healtheconomics.wiki/concept/referral -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/referral">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/integrated-care"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q2667988"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/integrated-care"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/care-pathway"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/referral-system"/>
        <precedes rdf:resource="https://healtheconomics.wiki/concept/secondary-care"/>
        <skos:notation>HS-HP-IC-030</skos:notation>
        <dcterms:identifier>HS-HP-IC-030</dcterms:identifier>
        <dcterms:source>AHA, American Hospital Association</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Referral</rdfs:label>
        <skos:definition xml:lang="en">The process by which a provider directs a patient to another provider or service, typically because needs exceed their own scope.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Care Handoff</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Specialist Direction</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Referral</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/specialty-access"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/referral"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/integrated-care"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-4b02809efca9</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Integrated Care: organisation and delivery of care is the Health Systems subdomain (Organisation and governance); placed under Integrated Care, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/referral"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/care-pathway"/>
        <dcterms:identifier>HEO-L-e1ddc76ae8d9</dcterms:identifier>
        <linkRationale xml:lang="en">Referral is a step in a patient&apos;s organised care pathway (both definitions)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
