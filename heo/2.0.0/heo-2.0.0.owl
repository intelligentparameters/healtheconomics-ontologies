        <dcterms:identifier>HE-ES-RM-013</dcterms:identifier>
        <dcterms:source>Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams &amp; Wilkins; 2008.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Multiplicative Scale</rdfs:label>
        <skos:definition xml:lang="en">A framework assessing whether two exposures interact by examining whether their combined effect on relative risk differs from the product of each.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Log Scale</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Relative-Effect Scale</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Multiplicative Scale</skos:prefLabel>
        <prerequisiteFor rdf:resource="https://healtheconomics.wiki/concept/scale-dependence"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/relative-risk"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/multiplicative-scale"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-e04168cf272d</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Risk Measures: catalogue subdomain Evidence Synthesis is one of the subdomains</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/multiplicative-scale"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#prerequisiteFor"/>
