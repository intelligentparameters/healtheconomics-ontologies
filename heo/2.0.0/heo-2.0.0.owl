    <!-- https://healtheconomics.wiki/concept/prevented-fraction -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/prevented-fraction">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-ES-RM-029</skos:notation>
        <dcterms:identifier>HE-ES-RM-029</dcterms:identifier>
        <dcterms:source>Levin 1953</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Prevented Fraction</rdfs:label>
        <skos:altLabel xml:lang="en">PF</skos:altLabel>
        <skos:definition xml:lang="en">The proportion of disease cases avoided in a population due to a protective exposure or intervention, the counterpart to the attributable fraction.</skos:definition>
        <skos:prefLabel xml:lang="en">Prevented Fraction</skos:prefLabel>
        <abbreviation xml:lang="en">PF</abbreviation>
        <informs rdf:resource="https://healtheconomics.wiki/concept/disease-prevention"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-2"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/prevented-fraction"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-b71ac971308f</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Epidemiology and risk measures in subdomain Evidence Synthesis</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/prevented-fraction"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/disease-prevention"/>
        <dcterms:identifier>HEO-L-340b9538c139</dcterms:identifier>
