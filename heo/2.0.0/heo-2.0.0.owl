    <!-- https://healtheconomics.wiki/concept/pay-for-performance -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/pay-for-performance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/value-based-payment"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/value-based-purchasing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/value-based-payment"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/value-based-purchasing"/>
        <skos:notation>HS-HP-PP-068</skos:notation>
        <dcterms:identifier>HS-HP-PP-068</dcterms:identifier>
        <dcterms:source>Carlson JJ, Sullivan SD, Garrison LP, Neumann PJ, Veenstra DL. Linking payment to health outcomes: a taxonomy and examination of performance-based reimbursement schemes. Health Policy. 2010;96(3):179-190.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Pay-for-Performance</rdfs:label>
        <skos:altLabel xml:lang="en">P4P</skos:altLabel>
        <skos:definition xml:lang="en">A methodology linking a portion of provider reimbursement directly to measured performance on quality, efficiency, or outcome metrics, rather than volume alone.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Performance-Related Pay</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Pay-for-Performance</skos:prefLabel>
        <abbreviation xml:lang="en">P4P</abbreviation>
        <counterpartOf rdf:resource="https://healtheconomics.wiki/concept/performance-based-financing"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/penalty"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/performance-standards"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/pay-for-performance"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/value-based-payment"/>
        <dcterms:identifier>HEO-L-714da305d7d7</dcterms:identifier>
        <linkRationale xml:lang="en">P4P ties reimbursement to quality, a value-based payment</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
