    <!-- https://healtheconomics.wiki/concept/decision-aid -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/decision-aid">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-HP-HD-034</skos:notation>
        <dcterms:identifier>HS-HP-HD-034</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</dcterms:modified>
        <dcterms:source>Stacey et al. 2024</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Decision Aid</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:definition xml:lang="en">A decision aid is a tool that helps patients choose between treatment or screening options by setting out benefits and harms and clarifying their values.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Decision Support Tool</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Shared-Decision Tool</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Decision Aid</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/patient-information-leaflet"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/informed-choice"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/shared-decision-making"/>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/autonomy"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/decision-aid"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-d0a9b4374a91</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Healthcare Delivery: organisation and delivery of care is the Health Systems subdomain (Organisation and governance)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/decision-aid"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/patient-information-leaflet"/>
        <dcterms:identifier>HEO-L-99c181655207</dcterms:identifier>
        <linkRationale xml:lang="en">The PIL article contrasts the one-medicine leaflet with decision aids; leaflet-style information is the usual-care comparator in decision aid trials.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
