    <!-- https://healtheconomics.wiki/concept/decision-fatigue-concept -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/decision-fatigue-concept">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cognitive-bias-concept"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cognitive-bias-concept"/>
        <skos:notation>HE-EE-BE-011</skos:notation>
        <dcterms:identifier>HE-EE-BE-011</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</dcterms:modified>
        <dcterms:source>Persson et al. 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Decision Fatigue Concept</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:definition xml:lang="en">The decision fatigue concept holds that decision quality falls after a long run of choices, as when clinicians treat patients differently late in a shift.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Choice Fatigue</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Decision Fatigue</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Decision Fatigue Concept</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/choice-overload"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/clinical-practice-variation"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/low-value-care"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
