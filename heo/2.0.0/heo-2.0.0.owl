    <!-- https://healtheconomics.wiki/concept/outcome-based-budget -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/outcome-based-budget">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/budget-allocation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/budget-allocation"/>
        <skos:notation>HE-EE-BIA-040</skos:notation>
        <dcterms:identifier>HE-EE-BIA-040</dcterms:identifier>
        <dcterms:source>Musgrave &amp; Musgrave 1989</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Outcome-Based Budget</rdfs:label>
        <skos:definition xml:lang="en">A budgeting approach that allocates funds according to expected or achieved health outcomes rather than historical spending or input costs.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Outcome-Linked Budget</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Results-Based Budget</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Outcome-Based Budget</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/incremental-budget"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/performance-budget"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/outcome-based-budget"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/budget-allocation"/>
        <dcterms:identifier>HEO-L-101d916645a3</dcterms:identifier>
        <linkRationale xml:lang="en">Allocation approach; definition contrasts it with historical (incremental) budgeting</linkRationale>
