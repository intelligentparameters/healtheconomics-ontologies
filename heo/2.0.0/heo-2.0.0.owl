    <!-- https://healtheconomics.wiki/concept/disinvestment-framework -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/disinvestment-framework">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
