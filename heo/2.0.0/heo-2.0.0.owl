    <!-- https://healtheconomics.wiki/concept/carve-out -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/carve-out">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <skos:notation>HS-HP-PP-019</skos:notation>
        <dcterms:identifier>HS-HP-PP-019</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Hinton et al. 2025</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Carve-Out</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Carve-Out is the removal of a service, such as pharmacy or behavioural health, from a health plan or payment unit so it is managed and paid for separately.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Benefit Segmentation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Separated Benefit Management</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Carve-Out</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/integrated-care"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/cost-shifting"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/fragmented-system"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/unbundled-payment"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/carve-out"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-9efea3b42080</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Provider Payment: wiki topic Provider payment sits in Health Systems; placed under Provider Payment, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/carve-out"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/integrated-care"/>
        <dcterms:identifier>HEO-L-824f63384dc7</dcterms:identifier>
        <linkRationale xml:lang="en">Separating a service vs joining services up</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
