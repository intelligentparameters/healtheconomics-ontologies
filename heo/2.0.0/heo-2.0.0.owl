    <!-- https://healtheconomics.wiki/concept/sf-6d -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/sf-6d">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/preference-based-measure"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/preference-based-measure"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/health-state-utility-value"/>
        <skos:notation>HE-EE-HU-071</skos:notation>
        <dcterms:identifier>HE-EE-HU-071</dcterms:identifier>
        <dcterms:source>Brazier, Roberts &amp; Deverill 2002</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">SF-6D</rdfs:label>
        <skos:altLabel xml:lang="en">Short Form Six Dimension</skos:altLabel>
        <skos:definition xml:lang="en">A preference-based utility measure derived from a subset of SF-36 or SF-12 items, combined using a scoring algorithm into a single utility index.</skos:definition>
        <skos:hiddenLabel xml:lang="en">SF6D Index</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">SF-6D</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/sf-36"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/value-set"/>
    </owl:NamedIndividual>
