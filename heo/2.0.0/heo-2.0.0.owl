    <!-- https://healtheconomics.wiki/concept/minimal-clinically-important-difference -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/minimal-clinically-important-difference">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q17069312"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-ES-CTM-052</skos:notation>
        <dcterms:identifier>HE-ES-CTM-052</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Jaeschke, Singer &amp; Guyatt 1989</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Minimal Clinically Important Difference</rdfs:label>
        <owl:versionInfo>1.0.3</owl:versionInfo>
        <skos:altLabel xml:lang="en">MCID</skos:altLabel>
        <skos:definition xml:lang="en">The minimal clinically important difference (MCID) is the smallest change in an outcome score that patients perceive as important, beneficial or harmful.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Minimal Important Difference</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Minimal Clinically Important Difference</skos:prefLabel>
        <abbreviation xml:lang="en">MCID</abbreviation>
        <benchmarkFor rdf:resource="https://healtheconomics.wiki/concept/clinical-meaningfulness"/>
        <benchmarkFor rdf:resource="https://healtheconomics.wiki/concept/effect-size"/>
        <benchmarkFor rdf:resource="https://healtheconomics.wiki/concept/mean-difference"/>
        <benchmarkFor rdf:resource="https://healtheconomics.wiki/concept/symptomatic-response"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/statistical-significance"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/responder-analysis"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/responder-definition"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/sample-size-calculation"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/minimal-clinically-important-difference"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-b9fe7de85a96</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Trial and study design in subdomain Evidence Synthesis</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/minimal-clinically-important-difference"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#benchmarkFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/clinical-meaningfulness"/>
