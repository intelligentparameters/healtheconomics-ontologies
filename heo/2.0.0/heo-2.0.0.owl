    <!-- https://healtheconomics.wiki/concept/quality-adjusted-coverage -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/quality-adjusted-coverage">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/effective-coverage"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/effective-coverage"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/universal-health-coverage"/>
        <precedes rdf:resource="https://healtheconomics.wiki/concept/user-adjusted-coverage"/>
        <skos:notation>HS-SS_HSP-050</skos:notation>
        <dcterms:identifier>HS-SS_HSP-050</dcterms:identifier>
        <dcterms:source>Tanahashi 1978</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Quality-Adjusted Coverage</rdfs:label>
        <skos:definition xml:lang="en">A coverage measure accounting for whether an intervention was delivered with sufficient quality to achieve its intended health benefit, not just contact.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Effective Service Coverage</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Quality-Weighted Coverage</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Quality-Adjusted Coverage</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/quality-adjusted-coverage"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/effective-coverage"/>
        <dcterms:identifier>HEO-L-8fb6aa62dcb4</dcterms:identifier>
        <linkRationale xml:lang="en">Quality-adjusted coverage is a form of effective coverage.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
