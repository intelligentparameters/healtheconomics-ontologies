        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Authorized Generic</rdfs:label>
        <skos:altLabel xml:lang="en">AG</skos:altLabel>
        <skos:definition xml:lang="en">A generic version of a brand-name drug produced or licensed by the original manufacturer, marketed without a brand name but chemically identical.</skos:definition>
