    <!-- https://healtheconomics.wiki/concept/personalised-therapy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/personalised-therapy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/precision-medicine"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
