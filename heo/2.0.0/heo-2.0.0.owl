        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-cost"/>
        <dcterms:identifier>HEO-L-d730eb57c593</dcterms:identifier>
        <linkRationale xml:lang="en">Drug Cost is defined as acquisition plus administration and monitoring, so acquisition is a component</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
