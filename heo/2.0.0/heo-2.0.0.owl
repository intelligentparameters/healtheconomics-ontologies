    <!-- https://healtheconomics.wiki/concept/selection-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/selection-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/missing-data-methods"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/missing-data-methods"/>
        <skos:notation>HE-ES-SA-191</skos:notation>
        <dcterms:identifier>HE-ES-SA-191</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Heckman 1979</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Selection Model</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A missing data modelling approach explicitly modelling the process by which observations become missing, alongside the model for the outcome itself.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Heckman Correction</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Sample Selection Correction</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Selection Model</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/missing-not-at-random"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/selection-model"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/missing-data-methods"/>
        <dcterms:identifier>HEO-L-9590cbec60cd</dcterms:identifier>
        <linkRationale xml:lang="en">Selection models are a missing data method.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/selection-model"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#addresses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/missing-not-at-random"/>
        <dcterms:identifier>HEO-L-700263f33af3</dcterms:identifier>
        <linkRationale xml:lang="en">Selection models explicitly model the missingness process to handle MNAR.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/selective-reporting -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/selective-reporting">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-DS-BV-034</skos:notation>
        <dcterms:identifier>HE-DS-BV-034</dcterms:identifier>
        <dcterms:source>Chan et al. 2004</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Selective Reporting</rdfs:label>
        <skos:definition xml:lang="en">The practice of reporting only a subset of a study&apos;s originally planned outcomes or analyses, typically favouring those with significant or favourable results.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Outcome Cherry-Picking</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Selective Analysis Reporting</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Selective Reporting</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/outcome-reporting-bias"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/reporting-bias"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/selective-reporting"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-36ccc0c1c180</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Bias &amp; Validity: catalogue subdomain Evidence Synthesis is one of the subdomains</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/selective-reporting"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/outcome-reporting-bias"/>
        <dcterms:identifier>HEO-L-66b7b0966822</dcterms:identifier>
        <linkRationale xml:lang="en">Reporting a subset of planned outcomes by result causes outcome reporting bias.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/selective-reporting"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/reporting-bias"/>
        <dcterms:identifier>HEO-L-1c9f50d5a23c</dcterms:identifier>
        <linkRationale xml:lang="en">Selective reporting of outcomes or analyses produces reporting bias.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
