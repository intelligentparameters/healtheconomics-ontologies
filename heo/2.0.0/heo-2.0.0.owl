        <rdfs:label xml:lang="en">Propensity Score</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">PS</skos:altLabel>
        <skos:definition xml:lang="en">The estimated probability that an individual would receive a particular treatment given their observed characteristics, used to balance confounders in observational studies.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Treatment Probability Score</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Propensity Score</skos:prefLabel>
        <abbreviation xml:lang="en">PS</abbreviation>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-5"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/confounding"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/propensity-score"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/comparative-effectiveness-research"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-1e92f2729926</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Causal inference and real world evidence in subdomain Evidence Synthesis; placed under Comparative Effectiveness Research, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/propensity-score"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/confounding"/>
        <dcterms:identifier>HEO-L-e48973e7fb4d</dcterms:identifier>
        <linkRationale xml:lang="en">Definition: the score is used to balance confounders, reducing measured confounding.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


