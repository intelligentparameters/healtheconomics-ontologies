    <!-- https://healtheconomics.wiki/concept/administrative-cost-ratio -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/administrative-cost-ratio">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/financial-ratio"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/financial-ratio"/>
        <skos:notation>HS-HP-HI-004</skos:notation>
        <dcterms:identifier>HS-HP-HI-004</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563?643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
