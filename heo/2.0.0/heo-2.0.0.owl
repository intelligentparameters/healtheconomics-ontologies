        <skos:hiddenLabel xml:lang="en">Trial Data</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Clinical Trial Data</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/real-world-data"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/clinical-trial-data"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
