        <rdfs:label xml:lang="en">Recovery Model</rdfs:label>
        <skos:altLabel xml:lang="en">Recovery Approach</skos:altLabel>
        <skos:altLabel xml:lang="en">Recovery-Oriented Care</skos:altLabel>
        <skos:definition xml:lang="en">A mental health treatment approach emphasising a person&apos;s own goals, strengths, and capacity for a meaningful life, rather than symptom elimination alone.</skos:definition>
