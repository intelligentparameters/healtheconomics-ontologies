        <skos:altLabel xml:lang="en">AV</skos:altLabel>
        <skos:definition xml:lang="en">Actuarial value (AV) is the share of the total allowed cost of covered care that a health plan is expected to pay for a standard population.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Metal-Tier Coverage Level</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Actuarial Value</skos:prefLabel>
        <abbreviation xml:lang="en">AV</abbreviation>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/plan-design"/>
