        <skos:altLabel xml:lang="en">CDHP</skos:altLabel>
        <skos:definition xml:lang="en">A consumer-directed health plan (CDHP) is a US health plan pairing a high deductible with a tax-favoured account, such as an HSA or HRA, to pay for care.</skos:definition>
        <skos:hiddenLabel xml:lang="en">High-Deductible Consumer Plan</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Consumer-Directed Health Plan</skos:prefLabel>
        <abbreviation xml:lang="en">CDHP</abbreviation>
