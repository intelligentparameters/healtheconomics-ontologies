    <!-- https://healtheconomics.wiki/concept/cost-offset-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cost-offset-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cost-analysis"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/cost-savings"/>
        <skos:notation>HE-EE-CA-031</skos:notation>
        <dcterms:identifier>HE-EE-CA-031</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cost-Offset Analysis</rdfs:label>
        <skos:altLabel xml:lang="en">Cost Offset Study</skos:altLabel>
        <skos:definition xml:lang="en">An analysis examining whether the extra cost of an intervention is partly or fully offset by savings elsewhere, such as fewer hospital admissions.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Savings Offset Analysis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cost-Offset Analysis</skos:prefLabel>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/cost-avoidance"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cost-offset-analysis"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-analysis"/>
        <dcterms:identifier>HEO-L-03f22fbf04b0</dcterms:identifier>
        <linkRationale xml:lang="en">Compares costs with offsetting savings, no outcomes</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
