    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/log-logistic-distribution"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/probability-distribution"/>
        <dcterms:identifier>HEO-L-c5a4e0da65da</dcterms:identifier>
        <linkRationale xml:lang="en">A distribution is not a survival model; the log-logistic model uses it (that link exists)</linkRationale>
