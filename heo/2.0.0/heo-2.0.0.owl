    <!-- https://healtheconomics.wiki/concept/generic-reference-pricing -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/generic-reference-pricing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/internal-reference-pricing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/internal-reference-pricing"/>
        <skos:notation>HS-DC-DP-035</skos:notation>
        <dcterms:identifier>HS-DC-DP-035</dcterms:identifier>
        <dcterms:source>Danzon 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Generic Reference Pricing</rdfs:label>
        <skos:definition xml:lang="en">A reimbursement policy setting a fixed level based on a generic drug&apos;s price, requiring patients or the brand manufacturer to cover any difference.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cluster Reference Pricing</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Generic-Based Reference Pricing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Generic Reference Pricing</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/therapeutic-reference-pricing"/>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/generic-substitution"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/generic-reference-pricing"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/internal-reference-pricing"/>
        <dcterms:identifier>HEO-L-14ff2216de6d</dcterms:identifier>
        <linkRationale xml:lang="en">Generic reference pricing is internal reference pricing</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/generic-reference-pricing"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/therapeutic-reference-pricing"/>
        <dcterms:identifier>HEO-L-62ac6b06489d</dcterms:identifier>
