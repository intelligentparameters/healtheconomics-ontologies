        <skos:hiddenLabel xml:lang="en">Real-Time Query</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Concurrent Query</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/coding-accuracy"/>
