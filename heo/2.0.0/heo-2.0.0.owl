    <!-- https://healtheconomics.wiki/concept/community-rating -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/community-rating">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/premium-setting"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/premium-setting"/>
        <skos:notation>HS-HP-HI-041</skos:notation>
        <dcterms:identifier>HS-HP-HI-041</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563?643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Community Rating</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Community rating is a health insurance pricing rule that stops premiums varying with health or claims, allowing at most limited variation by age or area.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Community-Rated Premium</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Uniform Premium Setting</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Community Rating</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/experience-rating"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/medical-underwriting"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/risk-rating"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/adverse-selection"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/death-spiral"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/risk-selection"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-2"/>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/risk-pooling"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/premium-design"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/community-rating"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/premium-setting"/>
        <dcterms:identifier>HEO-L-98e9ce4f2562</dcterms:identifier>
        <linkRationale xml:lang="en">Community rating is one method of setting premiums, like risk rating</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
