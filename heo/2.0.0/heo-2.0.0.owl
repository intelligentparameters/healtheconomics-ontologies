    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/confounder -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/confounder">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1125472"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-DS-BV-006</skos:notation>
        <dcterms:identifier>HE-DS-BV-006</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>VanderWeele 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Confounder</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Confounding Factor</skos:altLabel>
        <skos:altLabel xml:lang="en">Confounding Variable</skos:altLabel>
        <skos:definition xml:lang="en">A confounder is a variable, such as disease severity, that affects both the treatment a patient receives and the outcome, biasing unadjusted comparisons.</skos:definition>
        <skos:prefLabel xml:lang="en">Confounder</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/instrumental-variable"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/confounding"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/unmeasured-confounding"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/causal-inference"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/confounder"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
