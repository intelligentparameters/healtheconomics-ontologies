    <!-- https://healtheconomics.wiki/concept/undue-inducement -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/undue-inducement">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-HP-HSG-032</skos:notation>
        <dcterms:identifier>HS-HP-HSG-032</dcterms:identifier>
        <dcterms:source>National Commission, Belmont Report 1979</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Undue Inducement</rdfs:label>
        <skos:altLabel xml:lang="en">Excessive Inducement</skos:altLabel>
        <skos:definition xml:lang="en">An offer so substantial it could overwhelm a prospective participant&apos;s rational judgement about risk, compromising the voluntariness of their consent.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Improper Incentive</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Undue Inducement</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/informed-consent"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/undue-inducement"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-15b48bc5ff95</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health System Governance: organisation and delivery of care is the Health Systems subdomain (Organisation and governance)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/undue-inducement"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#threatensValidityOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/informed-consent"/>
        <dcterms:identifier>HEO-L-96190545b8ea</dcterms:identifier>
        <linkRationale xml:lang="en">Undue inducement compromises voluntariness of consent.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
