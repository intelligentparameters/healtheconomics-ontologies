    <!-- https://healtheconomics.wiki/concept/price-volume-agreement -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/price-volume-agreement">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/risk-sharing-scheme"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/risk-sharing-scheme"/>
        <skos:notation>HS-DC-DP-079</skos:notation>
        <dcterms:identifier>HS-DC-DP-079</dcterms:identifier>
        <dcterms:source>Carlson JJ, Sullivan SD, Garrison LP, Neumann PJ, Veenstra DL. Linking payment to health outcomes: a taxonomy and examination of performance-based reimbursement schemes. Health Policy. 2010;96(3):179-190.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Price-Volume Agreement</rdfs:label>
        <skos:altLabel xml:lang="en">PVA</skos:altLabel>
        <skos:definition xml:lang="en">An arrangement linking a treatment&apos;s price to its total utilisation volume, giving payers a mechanism to manage budget exposure as use expands.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Volume-Linked Pricing Deal</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Price-Volume Agreement</skos:prefLabel>
        <abbreviation xml:lang="en">PVA</abbreviation>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/budget-overrun"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/price-volume-agreement"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/risk-sharing-scheme"/>
        <dcterms:identifier>HEO-L-2383ae52d5bd</dcterms:identifier>
        <linkRationale xml:lang="en">Price-volume agreements are a financial risk-sharing scheme</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
