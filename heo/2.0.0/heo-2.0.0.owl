    <!-- https://healtheconomics.wiki/concept/summary-roc-curve -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/summary-roc-curve">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/roc-curve"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/roc-curve"/>
        <skos:notation>HE-ES-SA-247</skos:notation>
        <dcterms:identifier>HE-ES-SA-247</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</dcterms:modified>
        <dcterms:source>Derezea et al. 2024</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Summary ROC Curve</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">SROC</skos:altLabel>
        <skos:altLabel xml:lang="en">Summary Receiver Operating Characteristic Curve</skos:altLabel>
        <skos:definition xml:lang="en">A summary ROC (SROC) curve pools diagnostic accuracy studies to show how a test&apos;s sensitivity trades off against specificity across positivity thresholds.</skos:definition>
        <skos:hiddenLabel xml:lang="en">HSROC Curve</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Summary ROC Curve</skos:prefLabel>
        <abbreviation xml:lang="en">SROC</abbreviation>
        <represents rdf:resource="https://healtheconomics.wiki/concept/diagnostic-accuracy"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/hierarchical-model"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/sensitivity"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/specificity"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/summary-roc-curve"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/roc-curve"/>
        <dcterms:identifier>HEO-L-6b9222fe1c18</dcterms:identifier>
        <linkRationale xml:lang="en">A summary ROC curve is an ROC curve pooled across studies.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/summary-roc-curve"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#represents"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/diagnostic-accuracy"/>
        <dcterms:identifier>HEO-L-3066c0fa4a68</dcterms:identifier>
        <linkRationale xml:lang="en">The SROC curve depicts pooled diagnostic accuracy across thresholds.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
