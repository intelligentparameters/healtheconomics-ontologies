    <!-- https://healtheconomics.wiki/concept/applicability-criterion -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/applicability-criterion">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:notation>HS-HP-HTA-011</skos:notation>
        <dcterms:identifier>HS-HP-HTA-011</dcterms:identifier>
        <dcterms:source>Guyatt GH, Oxman AD, Vist GE, et al. GRADE: an emerging consensus on rating quality of evidence and strength of recommendations. BMJ. 2008;336:924-926. doi:10.1136/bmj.39489.470347.AD.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Applicability Criterion</rdfs:label>
        <skos:definition xml:lang="en">A standard assessing whether evidence supporting an assessment is sufficiently relevant and generalisable to the population and setting intended.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Applicability Standard</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Generalisability Criterion</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Applicability Criterion</skos:prefLabel>
        <benchmarkFor rdf:resource="https://healtheconomics.wiki/concept/transferability"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/applicability-criterion"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-6fc853e58f4b</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health Technology Assessment: HTA concepts belong to the HTA subdomain</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/applicability-criterion"/>
