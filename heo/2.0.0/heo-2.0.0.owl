        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#assumes"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/transitivity"/>
        <dcterms:identifier>HEO-L-984c54868ee3</dcterms:identifier>
