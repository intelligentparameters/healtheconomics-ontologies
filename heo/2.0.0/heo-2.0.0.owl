    <!-- https://healtheconomics.wiki/concept/net-budget-impact -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/net-budget-impact">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/budget-impact"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/budget-impact"/>
        <skos:notation>HE-EE-BIA-038</skos:notation>
        <dcterms:identifier>HE-EE-BIA-038</dcterms:identifier>
        <dcterms:source>Sullivan et al. 2014</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Net Budget Impact</rdfs:label>
        <skos:definition xml:lang="en">The overall change in spending from adopting a new technology, after accounting for offsetting savings elsewhere, such as avoided hospital admissions.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Incremental Budget Impact</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Net BIA Result</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Net Budget Impact</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-6"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/affordability"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/net-budget-impact"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/budget-impact"/>
        <dcterms:identifier>HEO-L-b4d1fc5e4096</dcterms:identifier>
        <linkRationale xml:lang="en">Net budget impact is budget impact after offsetting savings</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
