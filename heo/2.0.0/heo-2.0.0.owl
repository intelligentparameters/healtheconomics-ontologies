        <skos:hiddenLabel xml:lang="en">Early Modelling</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Early Health Technology Assessment</skos:prefLabel>
        <abbreviation xml:lang="en">Early HTA</abbreviation>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/moving-target-problem"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/clinical-development-plan"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/coverage-decision"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/value-based-pricing"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-technology-assessment#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
