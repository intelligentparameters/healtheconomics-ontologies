        <skos:notation>HS-HP-HTA-141</skos:notation>
        <dcterms:identifier>HS-HP-HTA-141</dcterms:identifier>
        <dcterms:source>Chan et al. 2004</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Outcome Reporting</rdfs:label>
        <skos:definition xml:lang="en">The practice of documenting and disclosing a study&apos;s results, ideally consistent with what was originally planned before results were known.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Endpoint Reporting</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Results Reporting</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Outcome Reporting</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/selective-reporting"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
