        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Kendall&apos;s Tau</skos:altLabel>
        <skos:definition xml:lang="en">A non-parametric measure of association between two ranked variables, based on the number of concordant and discordant pairs of observations.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Tau Coefficient</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Kendall Tau</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/pearson-correlation"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/spearman-correlation"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/kendall-tau"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/correlation-coefficient"/>
