        <skos:definition xml:lang="en">A measure of the frequency of central line-associated bloodstream infections within a facility, tracking infection prevention performance for catheter care.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Central Line Infection Rate</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">CLABSI Rate</skos:prefLabel>
