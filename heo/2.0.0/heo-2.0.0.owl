        <rdfs:label xml:lang="en">Clinical Benefit</rdfs:label>
        <skos:altLabel xml:lang="en">Therapeutic Benefit</skos:altLabel>
        <skos:definition xml:lang="en">A favourable effect of an intervention on how a patient feels, functions or survives relative to an appropriate comparator.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Patient Benefit</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Clinical Benefit</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/outcomes#step-1"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/clinical-benefit"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-outcome"/>
        <dcterms:identifier>HEO-L-74f7ac222eb1</dcterms:identifier>
        <linkRationale xml:lang="en">Clinical benefit is a favourable change in health status (both definitions)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/clinical-benefit"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/effectiveness"/>
        <dcterms:identifier>HEO-L-0a2fa9d9aa50</dcterms:identifier>
        <linkRationale xml:lang="en">Benefits are one component of effectiveness, alongside harms (object definition)</linkRationale>
