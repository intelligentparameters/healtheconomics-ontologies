    <!-- https://healtheconomics.wiki/concept/coase-theorem -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/coase-theorem">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-foundations"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1050037"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
