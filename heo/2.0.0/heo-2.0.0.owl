    <!-- https://healtheconomics.wiki/concept/icer -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/icer">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q6015473"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/threshold-price"/>
        <skos:notation>HE-EE-CEA-034</skos:notation>
        <dcterms:identifier>HE-EE-CEA-034</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Drummond et al. 2015 | Gray et al. 2011 | NICE PMG36 Economic evaluation | Stinnett and Mullahy 1998</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Incremental Cost-Effectiveness Ratio (ICER)</rdfs:label>
        <owl:versionInfo>1.2.22</owl:versionInfo>
        <skos:altLabel xml:lang="en">ICER</skos:altLabel>
        <skos:definition xml:lang="en">The incremental cost-effectiveness ratio (ICER) is a treatment&apos;s extra cost divided by its extra health gain versus a comparator, such as cost per QALY.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cost-Effectiveness Ratio</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Incremental Cost per Unit</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Incremental Cost-Effectiveness Ratio (ICER)</skos:prefLabel>
        <abbreviation xml:lang="en">ICER</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/marginal-cost-effectiveness"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-3"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/coverage-decision"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
