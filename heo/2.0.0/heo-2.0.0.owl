    <!-- https://healtheconomics.wiki/concept/market-exclusivity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/market-exclusivity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <precedes rdf:resource="https://healtheconomics.wiki/concept/first-generic-entry"/>
        <skos:notation>HS-DC-IP-003</skos:notation>
        <dcterms:identifier>HS-DC-IP-003</dcterms:identifier>
        <dcterms:source>FDA, Orphan Drug Act</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Market Exclusivity</rdfs:label>
        <skos:altLabel xml:lang="en">Marketing Exclusivity</skos:altLabel>
        <skos:definition xml:lang="en">A period during which regulators will not approve a competing generic or biosimilar, arising from patent protection, regulatory provisions, or both.</skos:definition>
        <skos:prefLabel xml:lang="en">Market Exclusivity</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/market-exclusivity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
