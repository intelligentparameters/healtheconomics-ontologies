        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-good"/>
        <dcterms:identifier>HEO-L-9e4e4bb8c698</dcterms:identifier>
        <linkRationale xml:lang="en">A search good is classified by how quality is assessed, one kind of economic good.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
