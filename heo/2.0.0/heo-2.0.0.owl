    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/oral-administration -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/oral-administration">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
