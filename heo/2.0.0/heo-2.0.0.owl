    <!-- https://healtheconomics.wiki/concept/effectiveness-evidence -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/effectiveness-evidence">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/real-world-evidence"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/real-world-evidence"/>
        <skos:notation>HS-HP-HTA-073</skos:notation>
        <dcterms:identifier>HS-HP-HTA-073</dcterms:identifier>
        <dcterms:source>Institute of Medicine. Initial National Priorities for Comparative Effectiveness Research. National Academies Press; 2009. doi:10.17226/12648.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Effectiveness Evidence</rdfs:label>
        <skos:definition xml:lang="en">Data demonstrating how well an intervention performs under real-world practice conditions, unlike efficacy evidence from controlled trial conditions.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Practice-Based Evidence</skos:hiddenLabel>
