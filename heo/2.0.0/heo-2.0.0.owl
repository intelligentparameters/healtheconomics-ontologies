        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Observational Error</skos:altLabel>
        <skos:definition xml:lang="en">Measurement error is the discrepancy between an observed or recorded value and the intended value of the quantity being measured, arising from the measurement process rather than sampling alone.</skos:definition>
