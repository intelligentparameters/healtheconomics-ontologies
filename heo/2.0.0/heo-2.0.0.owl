        <skos:altLabel xml:lang="en">Permuted Block Randomisation</skos:altLabel>
        <skos:altLabel xml:lang="en">Random Permuted Blocks</skos:altLabel>
        <skos:definition xml:lang="en">Block randomisation assigns participants in small blocks with set numbers per arm in random order, keeping arms balanced throughout trials that inform HTA.</skos:definition>
        <skos:prefLabel xml:lang="en">Block Randomization</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-1"/>
