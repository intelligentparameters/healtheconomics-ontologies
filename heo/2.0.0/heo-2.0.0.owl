    <!-- https://healtheconomics.wiki/concept/heterogeneity-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/heterogeneity-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <skos:notation>HE-EM-UA-027</skos:notation>
        <dcterms:identifier>HE-EM-UA-027</dcterms:identifier>
        <dcterms:source>Briggs A, Claxton K, Sculpher M. Decision Modelling for Health Economic Evaluation. Oxford University Press; 2006. doi:10.1093/oso/9780198526629.001.0001.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Heterogeneity Analysis</rdfs:label>
        <skos:definition xml:lang="en">An examination of how a model&apos;s results vary across different patient subgroups, unlike parameter uncertainty concerning imprecision in a single average population value.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Effect Heterogeneity Study</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Subgroup Variation Study</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Heterogeneity Analysis</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/parameter-uncertainty"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/subgroup-analysis"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/heterogeneity-analysis"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-modelling"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-acc36cd1b4c0</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Modelling &gt; Uncertainty Analysis: catalogue subdomain Economic Modelling is one of the subdomains</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/heterogeneity-analysis"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/parameter-uncertainty"/>
        <dcterms:identifier>HEO-L-cdec50999724</dcterms:identifier>
        <linkRationale xml:lang="en">Definition: heterogeneity is distinct from parameter uncertainty.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
