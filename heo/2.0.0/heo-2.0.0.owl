        <dcterms:identifier>HEO-L-7b0c24532783</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Decision trees in subdomain Economic Modelling; placed under Decision Tree, the concept named by its wiki topic</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/chance-node"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/decision-tree"/>
        <dcterms:identifier>HEO-L-6976d34175d1</dcterms:identifier>
        <linkRationale xml:lang="en">Chance nodes are structural components of a decision tree (object definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
