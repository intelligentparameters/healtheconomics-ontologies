    <!-- https://healtheconomics.wiki/concept/overconfidence -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/overconfidence">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cognitive-bias-concept"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cognitive-bias-concept"/>
        <skos:notation>HE-DS-BV-023</skos:notation>
        <dcterms:identifier>HE-DS-BV-023</dcterms:identifier>
        <dcterms:source>Lichtenstein, Fischhoff &amp; Phillips 1982</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Overconfidence</rdfs:label>
        <skos:definition xml:lang="en">A cognitive bias in which individuals, including expert forecasters, express excessive certainty, producing judgements narrower than their actual accuracy would justify.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Excessive Certainty</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Over-Precision</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Overconfidence</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/expert-elicitation"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/overconfidence"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cognitive-bias-concept"/>
        <dcterms:identifier>HEO-L-38abd23e181c</dcterms:identifier>
        <linkRationale xml:lang="en">Overconfidence is a cognitive bias</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/overconfidence"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#threatensValidityOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/expert-elicitation"/>
        <dcterms:identifier>HEO-L-70805fb4a302</dcterms:identifier>
        <linkRationale xml:lang="en">Overconfident experts give over-narrow distributions in elicitation</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/overfitting -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/overfitting">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q331309"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:notation>HE-ES-SA-146</skos:notation>
        <dcterms:identifier>HE-ES-SA-146</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Hastie, Tibshirani &amp; Friedman 2009</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Overfitting</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Over-Fitting</skos:altLabel>
        <skos:definition xml:lang="en">A situation in which a model is fit too closely to the noise in its training data, performing poorly on new, independent data.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Model Overfit</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Overfitting</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/underfitting"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/prediction-error"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/in-sample"/>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/multiple-regression"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/overfitting"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-5fe97e35e09e</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Statistical methods in subdomain Evidence Synthesis; placed under Statistical Method, the concept named by its wiki topic</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/overfitting"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/underfitting"/>
        <dcterms:identifier>HEO-L-04b586ac9505</dcterms:identifier>
        <linkRationale xml:lang="en">Overfitting and underfitting are opposing fit failures</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
