    <!-- https://healtheconomics.wiki/concept/data-governance -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/data-governance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/health-information-system"/>
        <skos:notation>HS-SS_DH-008</skos:notation>
        <dcterms:identifier>HS-SS_DH-008</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</dcterms:modified>
        <dcterms:source>OECD 2016</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Data Governance</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:definition xml:lang="en">Data governance is the set of rules, roles and controls that decides who may access and use health data, for what purpose and under which safeguards.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Data Stewardship</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Information Governance</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Data Governance</skos:prefLabel>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/data-quality"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/anonymization"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/data-use-agreement"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/de-identification"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/data-governance"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-9bc4d427c249</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Systems Strengthening &gt; Digital Health: health system strengthening is the Health Systems subdomain</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/data-governance"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-information-system"/>
        <dcterms:identifier>HEO-L-a43f3dc44f0e</dcterms:identifier>
