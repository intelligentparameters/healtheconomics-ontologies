    <!-- https://healtheconomics.wiki/concept/cumulative-meta-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cumulative-meta-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/meta-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/meta-analysis"/>
        <skos:notation>HE-ES-ESM-068</skos:notation>
        <dcterms:identifier>HE-ES-ESM-068</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</dcterms:modified>
