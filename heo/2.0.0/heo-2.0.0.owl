        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Plan Design</rdfs:label>
        <skos:definition xml:lang="en">The overall set of decisions determining a plan&apos;s covered benefits, cost-sharing structure, provider network, and utilisation management features.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Benefit Structure Design</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Coverage Design</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Plan Design</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/plan-design"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/benefit-design"/>
        <dcterms:identifier>HEO-L-62b34eb38c0e</dcterms:identifier>
        <linkRationale xml:lang="en">Plan design and benefit design cover the same set of plan rules</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/plan-do-study-act -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/plan-do-study-act">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q820214"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/model-for-improvement"/>
        <skos:notation>HS-NHS-HQ-056</skos:notation>
        <dcterms:identifier>HS-NHS-HQ-056</dcterms:identifier>
        <dcterms:source>Deming 1986</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Plan-Do-Study-Act</rdfs:label>
        <skos:altLabel xml:lang="en">Deming Cycle</skos:altLabel>
        <skos:altLabel xml:lang="en">PDSA Cycle</skos:altLabel>
        <skos:definition xml:lang="en">A structured, iterative four-stage cycle involving planning a change, implementing it small-scale, studying results, and acting on what was learned.</skos:definition>
        <skos:prefLabel xml:lang="en">Plan-Do-Study-Act</skos:prefLabel>
        <abbreviation xml:lang="en">PDSA Cycle</abbreviation>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/plan-do-study-act"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-149a25194462</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; NHS Productivity &gt; Healthcare Quality: wiki topic Performance, productivity and quality sits in Health Systems; placed under Quality of Care, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/plan-do-study-act"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
