    <!-- https://healtheconomics.wiki/concept/barrier-to-implementation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/barrier-to-implementation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-HP-SS-005</skos:notation>
        <dcterms:identifier>HS-HP-SS-005</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Damschroder et al. 2022</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Barrier to Implementation</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">A barrier to implementation is a factor, such as cost or staffing, that limits uptake of an effective health intervention, so health gains go unrealised.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Adoption Barrier</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Implementation Barrier</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Barrier to Implementation</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/facilitator-of-implementation"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/implementation-strategy"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/quality-improvement"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/barrier-to-implementation"/>
