    <!-- https://healtheconomics.wiki/concept/controllable-cost -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/controllable-cost">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <skos:notation>HE-EE-CA-015</skos:notation>
        <dcterms:identifier>HE-EE-CA-015</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Franklin et al. 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Controllable Cost</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Controllable cost is a health service cost that a named budget holder can influence within the budget period, such as ward overtime or agency staffing.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Manageable Cost</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Manager-Influenced Cost</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Controllable Cost</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/uncontrollable-cost"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/budget-control"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/controllable-cost"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <dcterms:identifier>HEO-L-064df07f4e5c</dcterms:identifier>
        <linkRationale xml:lang="en">A category of cost</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/controllable-cost"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/uncontrollable-cost"/>
        <dcterms:identifier>HEO-L-b6ab60e71972</dcterms:identifier>
