    <!-- https://healtheconomics.wiki/concept/oblique-rotation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/oblique-rotation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/factor-rotation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/factor-rotation"/>
        <skos:notation>HE-ES-SA-141</skos:notation>
        <dcterms:identifier>HE-ES-SA-141</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Kaiser 1958</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Oblique Rotation</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A factor analysis technique transforming a solution into a more interpretable structure while allowing the resulting factors to correlate with each other.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Correlated-Factor Rotation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Promax Rotation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Oblique Rotation</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/orthogonal-rotation"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/oblique-rotation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/factor-rotation"/>
        <dcterms:identifier>HEO-L-81047ef8a71c</dcterms:identifier>
        <linkRationale xml:lang="en">A factor rotation</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/oblique-rotation"/>
