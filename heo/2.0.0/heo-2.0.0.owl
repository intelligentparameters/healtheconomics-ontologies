    <!-- https://healtheconomics.wiki/concept/reporting-standards -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/reporting-standards">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/governance-standards"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/governance-standards"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/evaluation-standards"/>
        <skos:notation>HS-HP-HSG-026</skos:notation>
        <dcterms:identifier>HS-HP-HSG-026</dcterms:identifier>
        <dcterms:source>National Commission, Belmont Report 1979</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Reporting Standards</rdfs:label>
        <skos:altLabel xml:lang="en">Reporting Guidelines</skos:altLabel>
        <skos:definition xml:lang="en">The requirements governing how research findings, positive and negative, must be documented and disclosed, to prevent selective reporting bias.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Publication Standards</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Reporting Standards</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/selective-reporting"/>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/model-transparency"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/outcome-reporting"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/reporting-standards"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/governance-standards"/>
        <dcterms:identifier>HEO-L-d32ac87e932e</dcterms:identifier>
        <linkRationale xml:lang="en">Reporting standards are research governance requirements.</linkRationale>
