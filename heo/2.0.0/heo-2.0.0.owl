    <!-- https://healtheconomics.wiki/concept/post-hoc-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/post-hoc-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
