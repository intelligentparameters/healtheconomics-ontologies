    <!-- https://healtheconomics.wiki/concept/prior-probability -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/prior-probability">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/parameter-input"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/parameter-input"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/bayesian-analysis"/>
        <skos:notation>HE-EM-MP-033</skos:notation>
        <dcterms:identifier>HE-EM-MP-033</dcterms:identifier>
        <dcterms:source>Bayes 1763</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Prior Probability</rdfs:label>
        <skos:definition xml:lang="en">The probability assigned to a hypothesis before accounting for new evidence, representing existing belief later updated through Bayesian analysis.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Pre-Data Probability</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Prior Belief</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Prior Probability</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-4"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/prior-probability"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/parameter-input"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-e44d0e2bfe0c</dcterms:identifier>
