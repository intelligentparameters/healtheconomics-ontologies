        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Antibiotic stewardship is a coordinated programme that improves antibiotic prescribing to protect patients, slow resistance and cut avoidable costs.</skos:definition>
