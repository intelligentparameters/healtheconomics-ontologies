        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/feasibility-assessment"/>
        <dcterms:identifier>HEO-L-d2956a7a0e91</dcterms:identifier>
