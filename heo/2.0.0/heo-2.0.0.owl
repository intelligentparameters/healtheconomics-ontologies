        <dcterms:identifier>HE-EE-EPR-038</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Programme Perspective</rdfs:label>
        <skos:altLabel xml:lang="en">Program Perspective</skos:altLabel>
        <skos:definition xml:lang="en">An analytic viewpoint defined by the boundaries of a specific programme, including all costs and outcomes attributable to it regardless of the broader payer.</skos:definition>
