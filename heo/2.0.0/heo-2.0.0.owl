        <skos:notation>HS-HP-HSM-020</skos:notation>
        <dcterms:identifier>HS-HP-HSM-020</dcterms:identifier>
        <dcterms:source>World Health Organization. Everybody&apos;s Business: Strengthening Health Systems to Improve Health Outcomes-WHO&apos;s Framework for Action. WHO; 2007.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Unitary System</rdfs:label>
        <skos:altLabel xml:lang="en">Unitary Health System</skos:altLabel>
        <skos:definition xml:lang="en">A health system structure in which a single, centralised government authority holds primary responsibility for policy, financing, and often delivery.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Centralised Health System</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Unitary System</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/decentralization"/>
