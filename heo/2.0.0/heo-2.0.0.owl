        <dcterms:identifier>HEO-L-7a27478f7135</dcterms:identifier>
        <linkRationale xml:lang="en">A unitary system is a type of health system structure.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
