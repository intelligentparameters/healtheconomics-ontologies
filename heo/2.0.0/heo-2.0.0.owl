    <!-- https://healtheconomics.wiki/concept/health-system-fairness -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/health-system-fairness">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-system-goals"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-system-goals"/>
        <skos:notation>HS-HP-HSM-007</skos:notation>
        <dcterms:identifier>HS-HP-HSM-007</dcterms:identifier>
        <dcterms:source>WHO, World Health Report 2000</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Health System Fairness</rdfs:label>
        <skos:altLabel xml:lang="en">System Equity</skos:altLabel>
        <skos:definition xml:lang="en">The degree to which a health system distributes financing burden and access equitably across the population, regardless of income or health status.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cross-System Fairness</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Fair Distribution</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Fair Financing</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Health System Equity</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Health System Fairness</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/health-equity"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/health-system-fairness"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-system-goals"/>
        <dcterms:identifier>HEO-L-6d6838613d08</dcterms:identifier>
        <linkRationale xml:lang="en">Fairness in financial contribution is one of the WHO health system goals.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
