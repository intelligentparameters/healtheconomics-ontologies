        <dcterms:identifier>HS-HP-HD-005</dcterms:identifier>
        <dcterms:source>AHA, American Hospital Association</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">AMA Discharge</rdfs:label>
        <skos:altLabel xml:lang="en">Discharge Against Medical Advice</skos:altLabel>
        <skos:altLabel xml:lang="en">Self-Discharge</skos:altLabel>
        <skos:definition xml:lang="en">A hospital discharge occurring against medical advice, where a patient chooses to leave before clinicians recommend, despite informed risk disclosure.</skos:definition>
        <skos:prefLabel xml:lang="en">AMA Discharge</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
