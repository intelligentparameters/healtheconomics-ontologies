    <!-- https://healtheconomics.wiki/concept/systematic-error -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/systematic-error">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/bias"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q2257880"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/bias"/>
        <skos:notation>HE-DS-BV-037</skos:notation>
        <dcterms:identifier>HE-DS-BV-037</dcterms:identifier>
        <dcterms:source>Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams &amp; Wilkins; 2008.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Systematic Error</rdfs:label>
        <skos:definition xml:lang="en">A consistent, non-random deviation of results from the true value, arising from a specific flaw in design, measurement, or analysis.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Consistent Error</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Directional Error</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Systematic Error</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/systematic-error"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/bias"/>
        <dcterms:identifier>HEO-L-4fe04fb345f3</dcterms:identifier>
        <linkRationale xml:lang="en">Bias is defined as systematic error, so systematic error falls under bias.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
