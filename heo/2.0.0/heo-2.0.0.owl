        <skos:notation>HE-ES-CTM-046</skos:notation>
        <dcterms:identifier>HE-ES-CTM-046</dcterms:identifier>
        <dcterms:source>Friedman LM, Furberg CD, DeMets DL, Reboussin DM, Granger CB. Fundamentals of Clinical Trials. 5th ed. Springer; 2015. doi:10.1007/978-3-319-18539-2.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Intention-to-Treat Population</rdfs:label>
        <skos:altLabel xml:lang="en">ITT Population</skos:altLabel>
        <skos:definition xml:lang="en">The complete set of trial participants analysed by their original random assignment, regardless of protocol deviations or non-adherence.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Full Analysis Set</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Intention-to-Treat Population</skos:prefLabel>
        <abbreviation xml:lang="en">ITT Population</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/modified-itt"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
