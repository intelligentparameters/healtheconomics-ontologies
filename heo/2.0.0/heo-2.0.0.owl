        <skos:altLabel xml:lang="en">Crossover Trial Design</skos:altLabel>
        <skos:definition xml:lang="en">Crossover design is a clinical trial design in which each participant receives two or more treatments in a randomised order and acts as their own control.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Within-Subject Design</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Crossover Design</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/parallel-group-design"/>
