    <!-- https://healtheconomics.wiki/concept/linear-programming -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/linear-programming">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/constrained-optimisation"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/numerical-optimisation"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q202843"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/constrained-optimisation"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/numerical-optimisation"/>
        <skos:notation>CS-OP-CO-001</skos:notation>
        <dcterms:identifier>CS-OP-CO-001</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-24</dcterms:modified>
        <dcterms:source>Nocedal J, Wright SJ. Numerical Optimization. 2nd ed. Springer; 2006. doi:10.1007/978-0-387-40065-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Linear Programming</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">LP</skos:altLabel>
        <skos:definition xml:lang="en">Linear programming identifies the best feasible allocation of limited resources when the objective and constraints can be expressed as linear relationships.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Linear Optimisation Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Linear Programming</skos:prefLabel>
        <abbreviation xml:lang="en">LP</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-12"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/linear-programming"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/constrained-optimisation"/>
        <dcterms:identifier>HEO-L-bc9aac7d6f5f</dcterms:identifier>
        <linkRationale xml:lang="en">LP optimises a linear objective subject to constraints, so it is a constrained optimisation problem</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/linear-programming"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/numerical-optimisation"/>
        <dcterms:identifier>HEO-L-fdbae961db5a</dcterms:identifier>
        <linkRationale xml:lang="en">LP problems are solved by iterative numerical algorithms such as simplex</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
