    <!-- https://healtheconomics.wiki/concept/target-question -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/target-question">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/value-of-information"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/value-of-information"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/expert-elicitation"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/structured-expert-judgment"/>
