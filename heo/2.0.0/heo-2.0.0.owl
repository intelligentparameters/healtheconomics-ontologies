        <dcterms:identifier>HS-HP-PHO-008</dcterms:identifier>
        <dcterms:source>U.S. Food and Drug Administration. Guidance for Industry: Patient-Reported Outcome Measures-Use in Medical Product Development to Support Labeling Claims. FDA; 2009.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Health Outcome</rdfs:label>
        <skos:definition xml:lang="en">Any change in health status resulting from a healthcare intervention or a condition&apos;s natural course, from survival to patient-reported quality of life.</skos:definition>
