        <dcterms:identifier>HEO-L-3dce8f349a85</dcterms:identifier>
        <linkRationale xml:lang="en">Out-of-Sample is a descriptor; k-fold CV estimates out-of-sample predictive accuracy</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
