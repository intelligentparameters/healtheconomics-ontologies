    <!-- https://healtheconomics.wiki/concept/response-based-payment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/response-based-payment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcomes-based-payment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/outcomes-based-payment"/>
        <skos:notation>HS-DC-MA-027</skos:notation>
        <dcterms:identifier>HS-DC-MA-027</dcterms:identifier>
        <dcterms:source>Carlson JJ, Sullivan SD, Garrison LP, Neumann PJ, Veenstra DL. Linking payment to health outcomes: a taxonomy and examination of performance-based reimbursement schemes. Health Policy. 2010;96(3):179-190.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Response-Based Payment</rdfs:label>
        <skos:definition xml:lang="en">A payment arrangement in which the amount a payer reimburses depends on whether an individual patient achieves a defined clinical response.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Pay-for-Response</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Response-Linked Payment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Response-Based Payment</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/conditional-coverage"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/response-based-payment"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/outcomes-based-payment"/>
        <dcterms:identifier>HEO-L-e6550aa60e2a</dcterms:identifier>
        <linkRationale xml:lang="en">Response-based payment conditions payment on achieved clinical outcomes.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/response-based-payment"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/conditional-coverage"/>
        <dcterms:identifier>HEO-L-d81ecc830536</dcterms:identifier>
