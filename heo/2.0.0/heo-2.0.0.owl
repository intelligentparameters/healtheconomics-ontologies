    <!-- https://healtheconomics.wiki/concept/tiered-care -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/tiered-care">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/coordinated-care-model"/>
