        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/drug-resistance"/>
        <riskFactorFor rdf:resource="https://healtheconomics.wiki/concept/treatment-failure"/>
        <skos:notation>HE-PE-ID-005</skos:notation>
        <dcterms:identifier>HE-PE-ID-005</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>WHO 2026</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Antimicrobial Resistance</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">AMR</skos:altLabel>
        <skos:definition xml:lang="en">Antimicrobial resistance (AMR) is the ability of microbes to withstand antimicrobial medicines, making infections harder to treat and costlier to manage.</skos:definition>
        <skos:prefLabel xml:lang="en">Antimicrobial Resistance</skos:prefLabel>
        <abbreviation xml:lang="en">AMR</abbreviation>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/amr-economic-burden"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/antimicrobial-resistance"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-resistance"/>
        <dcterms:identifier>HEO-L-d3fbede5a27a</dcterms:identifier>
        <linkRationale xml:lang="en">AMR is microbial adaptation reducing treatment effectiveness, a kind of drug resistance</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
