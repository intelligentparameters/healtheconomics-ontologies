        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/bias"/>
        <skos:notation>HE-DS-BV-012</skos:notation>
        <dcterms:identifier>HE-DS-BV-012</dcterms:identifier>
        <dcterms:source>Suissa 2008</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Immortal Time Bias</rdfs:label>
        <skos:altLabel xml:lang="en">Guarantee-Time Bias</skos:altLabel>
        <skos:altLabel xml:lang="en">Survivor Treatment Selection Bias</skos:altLabel>
        <skos:definition xml:lang="en">A bias where a period of follow-up is misclassified so a participant cannot, by design, experience the outcome during it, inflating apparent benefit.</skos:definition>
        <skos:prefLabel xml:lang="en">Immortal Time Bias</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/observational-study"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/immortal-time-bias"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/bias"/>
        <dcterms:identifier>HEO-L-d75592c8c7d5</dcterms:identifier>
        <linkRationale xml:lang="en">A bias.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
