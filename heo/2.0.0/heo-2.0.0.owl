        <skos:altLabel xml:lang="en">SPA</skos:altLabel>
        <skos:definition xml:lang="en">Special pricing arrangement, in PBS listing, publishes a higher price while the sponsor pays quarterly rebates down to the effective price under a deed.</skos:definition>
        <skos:prefLabel xml:lang="en">Special Pricing Arrangement</skos:prefLabel>
        <abbreviation xml:lang="en">SPA</abbreviation>
        <produces rdf:resource="https://healtheconomics.wiki/concept/confidential-price"/>
