        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/dissemination-research -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/dissemination-research">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-HP-SS-011</skos:notation>
        <dcterms:identifier>HS-HP-SS-011</dcterms:identifier>
        <dcterms:source>Rabin &amp; Brownson 2012</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Dissemination Research</rdfs:label>
        <skos:definition xml:lang="en">A field studying how to effectively spread information about evidence-based interventions to a target audience, increasing knowledge and adoption.</skos:definition>
