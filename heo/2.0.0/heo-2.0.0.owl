    <!-- https://healtheconomics.wiki/concept/second-line-therapy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/second-line-therapy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
