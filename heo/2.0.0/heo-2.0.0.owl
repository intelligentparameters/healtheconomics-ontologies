        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/heterogeneity-analysis"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/subgroup-analysis"/>
        <dcterms:identifier>HEO-L-516784eaaa47</dcterms:identifier>
