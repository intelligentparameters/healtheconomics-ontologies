    <!-- https://healtheconomics.wiki/concept/effectiveness -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/effectiveness">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/treatment-effect"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/treatment-effect"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/efficacy-effectiveness-gap"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/incremental-effectiveness"/>
        <skos:notation>HE-ES-CER-009</skos:notation>
        <dcterms:identifier>HE-ES-CER-009</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Institute of Medicine. Initial National Priorities for Comparative Effectiveness Research. National Academies Press; 2009. doi:10.17226/12648.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Effectiveness</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">The benefits and harms an intervention produces under care conditions relevant to a specified population, comparator, outcome and time horizon.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Real-World Benefit</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Routine-Practice Benefit</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Effectiveness</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/efficacy"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/effectiveness"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/treatment-effect"/>
        <dcterms:identifier>HEO-L-e0e745184e55</dcterms:identifier>
        <linkRationale xml:lang="en">effectiveness is a treatment effect under routine care</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/effectiveness"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/efficacy-effectiveness-gap"/>
        <dcterms:identifier>HEO-L-5782384d4c95</dcterms:identifier>
        <linkRationale xml:lang="en">The gap is efficacy minus effectiveness, per its definition</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/effectiveness"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/incremental-effectiveness"/>
        <dcterms:identifier>HEO-L-2d20ea9d82b5</dcterms:identifier>
        <linkRationale xml:lang="en">Incremental effectiveness is the difference between options&apos; effectiveness, so effectiveness is its input</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
