    <!-- https://healtheconomics.wiki/concept/transitivity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/transitivity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-ES-ESM-061</skos:notation>
        <dcterms:identifier>HE-ES-ESM-061</dcterms:identifier>
        <dcterms:source>Salanti 2012</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Transitivity</rdfs:label>
        <skos:definition xml:lang="en">A key network meta-analysis assumption that treatments compared indirectly are similar enough in relevant characteristics for the comparison to be valid.</skos:definition>
        <skos:prefLabel xml:lang="en">Transitivity</skos:prefLabel>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/consistency"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
