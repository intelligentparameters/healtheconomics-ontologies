    <!-- https://healtheconomics.wiki/concept/full-assessment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/full-assessment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/hta-process"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/hta-process"/>
        <skos:notation>HS-HP-HTA-091</skos:notation>
        <dcterms:identifier>HS-HP-HTA-091</dcterms:identifier>
        <dcterms:source>National Institute for Health and Care Excellence. NICE technology appraisal and highly specialised technologies guidance: the manual (PMG36). Published 2022; updated 2026.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Full Assessment</rdfs:label>
        <skos:definition xml:lang="en">A comprehensive assessment process involving detailed evaluation of clinical and cost-effectiveness, unlike an abbreviated or rapid review process.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Comprehensive HTA</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Full HTA Review</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Full Assessment</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/mini-hta"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/rapid-assessment"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/full-assessment"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/hta-process"/>
        <dcterms:identifier>HEO-L-a168264489f0</dcterms:identifier>
        <linkRationale xml:lang="en">Full assessment is an HTA process</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
