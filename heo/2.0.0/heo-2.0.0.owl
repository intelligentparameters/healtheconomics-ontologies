    <!-- https://healtheconomics.wiki/concept/government-subsidy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/government-subsidy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/subsidy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/subsidy"/>
        <skos:notation>HS-HP-HF-037</skos:notation>
        <dcterms:identifier>HS-HP-HF-037</dcterms:identifier>
        <dcterms:source>Musgrave &amp; Musgrave 1989</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Government Subsidy</rdfs:label>
        <skos:altLabel xml:lang="en">Public Subsidy</skos:altLabel>
        <skos:altLabel xml:lang="en">State Subsidy</skos:altLabel>
        <skos:definition xml:lang="en">Financial support provided by a government to reduce the cost of a good or service, such as healthcare, below unsubsidised market price.</skos:definition>
        <skos:prefLabel xml:lang="en">Government Subsidy</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/tax-credit"/>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/merit-good"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
