    <!-- https://healtheconomics.wiki/concept/pico-framework -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/pico-framework">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:notation>HS-HP-HTA-154</skos:notation>
        <dcterms:identifier>HS-HP-HTA-154</dcterms:identifier>
        <dcterms:source>Richardson et al. 1995</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">PICO Framework</rdfs:label>
        <skos:altLabel xml:lang="en">PICO</skos:altLabel>
        <skos:altLabel xml:lang="en">Population-Intervention-Comparator-Outcome</skos:altLabel>
        <skos:definition xml:lang="en">A structured framework specifying the Population, Intervention, Comparator, and Outcome, used to formulate a well-defined clinical or research question.</skos:definition>
        <skos:prefLabel xml:lang="en">PICO Framework</skos:prefLabel>
        <abbreviation xml:lang="en">PICO</abbreviation>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/search-strategy"/>
    </owl:NamedIndividual>
