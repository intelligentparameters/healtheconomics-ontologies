        <skos:notation>HS-HP-HI-052</skos:notation>
        <dcterms:identifier>HS-HP-HI-052</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Corridor Deductible</rdfs:label>
        <skos:definition xml:lang="en">A deductible structure in which a middle range of costs requires patient cost-sharing, while costs below and above that range are more fully covered.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Corridor Cost-Sharing</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Middle-Range Deductible</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Corridor Deductible</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
