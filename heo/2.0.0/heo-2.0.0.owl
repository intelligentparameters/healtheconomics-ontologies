        <owl:versionInfo>1.0.3</owl:versionInfo>
        <skos:altLabel xml:lang="en">Capacity Utilization</skos:altLabel>
        <skos:definition xml:lang="en">Capacity utilisation is the share of available health care capacity, such as staffed beds, theatre sessions or scanner time, that is used over a period.</skos:definition>
        <skos:prefLabel xml:lang="en">Capacity Utilisation</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/capacity-management"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/capacity-planning"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/capacity"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-5"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/capacity-utilisation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
