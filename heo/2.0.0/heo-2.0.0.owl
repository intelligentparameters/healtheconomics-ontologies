    <!-- https://healtheconomics.wiki/concept/common-comparator -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/common-comparator">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/comparator"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/comparator"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/connected-network"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/network-meta-analysis"/>
        <skos:notation>HE-ES-ESM-006</skos:notation>
        <dcterms:identifier>HE-ES-ESM-006</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-09</dcterms:modified>
        <dcterms:source>Jansen et al. 2011</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Common Comparator</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">A common comparator is a treatment, such as placebo or standard care, that two other treatments were each tested against, anchoring an indirect comparison.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Common Reference Treatment</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Shared Comparator</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Common Comparator</skos:prefLabel>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/common-comparator"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/comparator"/>
        <dcterms:identifier>HEO-L-f0601be05da7</dcterms:identifier>
        <linkRationale xml:lang="en">A common comparator is a comparator (both definitions)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/common-comparator"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
