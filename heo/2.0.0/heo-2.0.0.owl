    <!-- https://healtheconomics.wiki/concept/geographic-access -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/geographic-access">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/accessibility"/>
        <skos:notation>HS-HP-HE-017</skos:notation>
        <dcterms:identifier>HS-HP-HE-017</dcterms:identifier>
        <dcterms:source>Penchansky R, Thomas JW. The concept of access: definition and relationship to consumer satisfaction. Medical Care. 1981;19(2):127-140. doi:10.1097/00005650-198102000-00001.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Geographic Access</rdfs:label>
        <skos:altLabel xml:lang="en">Spatial Access</skos:altLabel>
        <skos:definition xml:lang="en">A healthcare access dimension concerning the physical distance and travel time required for individuals to reach services.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Physical Access</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Geographic Access</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
