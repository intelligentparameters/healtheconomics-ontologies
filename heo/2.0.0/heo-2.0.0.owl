    <!-- https://healtheconomics.wiki/concept/patient-heterogeneity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/patient-heterogeneity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/microsimulation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/microsimulation"/>
        <skos:notation>HE-EM-MS-006</skos:notation>
        <dcterms:identifier>HE-EM-MS-006</dcterms:identifier>
        <dcterms:source>Barton, Bryan &amp; Robinson 2004</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Patient Heterogeneity</rdfs:label>
        <skos:definition xml:lang="en">Variation among individual patients in characteristics such as age or disease severity that leads to different treatment responses or underlying risk.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Patient Variation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Population Heterogeneity</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Patient Heterogeneity</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/between-subject-variation"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/heterogeneous-treatment-effect"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/population"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/patient-heterogeneity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/microsimulation"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-ee8b3f425b9e</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Modelling &gt; Microsimulation: catalogue subdomain Economic Modelling is one of the subdomains; placed under Microsimulation, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/patient-heterogeneity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/between-subject-variation"/>
        <dcterms:identifier>HEO-L-984d30f8cee6</dcterms:identifier>
        <linkRationale xml:lang="en">Differences between patients produce between-subject variation</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
