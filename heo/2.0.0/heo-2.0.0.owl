    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/medication-possession-ratio -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/medication-possession-ratio">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/adherence-outcome"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/adherence-outcome"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/medication-adherence"/>
        <skos:notation>PP-PC-MA-003</skos:notation>
        <dcterms:identifier>PP-PC-MA-003</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Raebel et al. 2013</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Medication Possession Ratio</rdfs:label>
        <owl:versionInfo>1.0.4</owl:versionInfo>
        <skos:altLabel xml:lang="en">MPR</skos:altLabel>
        <skos:definition xml:lang="en">The medication possession ratio (MPR) is the total days&apos; supply dispensed divided by the days in the period. Unlike PDC, it can exceed 1 unless capped.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Possession Ratio</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Medication Possession Ratio</skos:prefLabel>
        <abbreviation xml:lang="en">MPR</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/proportion-of-days-covered"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/pharmacy-data"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/medication-possession-ratio"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/adherence-outcome"/>
        <dcterms:identifier>HEO-L-fdd90694c97a</dcterms:identifier>
        <linkRationale xml:lang="en">MPR is a measure of following a regimen</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
