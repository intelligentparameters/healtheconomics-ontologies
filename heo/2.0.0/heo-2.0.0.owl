    <!-- https://healtheconomics.wiki/concept/network-meta-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/network-meta-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/indirect-treatment-comparison"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/meta-analysis"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q70470634"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/indirect-treatment-comparison"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/meta-analysis"/>
        <skos:notation>HE-ES-ESM-040</skos:notation>
        <dcterms:identifier>HE-ES-ESM-040</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Lu &amp; Ades 2004</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Network Meta-Analysis</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Mixed Treatment Comparison</skos:altLabel>
        <skos:altLabel xml:lang="en">Multiple-Treatments Meta-Analysis</skos:altLabel>
        <skos:altLabel xml:lang="en">NMA</skos:altLabel>
        <skos:definition xml:lang="en">Network meta-analysis (NMA) compares three or more treatments in one analysis, pooling direct and indirect trial evidence to inform HTA decisions.</skos:definition>
        <skos:hiddenLabel xml:lang="en">MTC</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Network Meta-Analysis</skos:prefLabel>
        <abbreviation xml:lang="en">NMA</abbreviation>
        <assumes rdf:resource="https://healtheconomics.wiki/concept/consistency"/>
