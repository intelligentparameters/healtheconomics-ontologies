    <!-- https://healtheconomics.wiki/concept/best-in-class -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/best-in-class">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/therapeutic-class"/>
        <skos:notation>HE-PE-TI-002</skos:notation>
        <dcterms:identifier>HE-PE-TI-002</dcterms:identifier>
        <dcterms:source>DiMasi JA, Grabowski HG, Hansen RW. Innovation in the pharmaceutical industry: new estimates of R&amp;D costs. Journal of Health Economics. 2016;47:20-33. doi:10.1016/j.jhealeco.2016.01.012.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Best-in-Class</rdfs:label>
        <skos:definition xml:lang="en">A designation for the most effective or otherwise superior treatment within its therapeutic class, unlike a first-in-class treatment with a wholly new mechanism.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Class-Leading Treatment</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Superior-in-Class Agent</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Best-in-Class</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/first-in-class"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/best-in-class"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-cb9659ca3699</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Pharmacoeconomics &gt; Therapeutic Innovation: new therapy types raise assessment questions for HTA bodies</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/best-in-class"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/therapeutic-class"/>
        <dcterms:identifier>HEO-L-8e7ee149ef55</dcterms:identifier>
        <linkRationale xml:lang="en">A best-in-class drug is by definition one of the members that make up its therapeutic class</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
