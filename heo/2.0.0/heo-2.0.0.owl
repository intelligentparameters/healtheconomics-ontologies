    <!-- https://healtheconomics.wiki/concept/negative-externality -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/negative-externality">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/externality"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/externality"/>
        <skos:notation>HE-EE-ME-046</skos:notation>
        <dcterms:identifier>HE-EE-ME-046</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-24</dcterms:modified>
        <dcterms:source>Pigou 1920</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Negative Externality</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">External Cost</skos:altLabel>
        <skos:definition xml:lang="en">A cost imposed on a third party by an economic activity, not reflected in its market price, leading to overproduction relative to the social optimum.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Negative Spillover</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Negative Externality</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/positive-externality"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/market-failure"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/negative-externality"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/externality"/>
        <dcterms:identifier>HEO-L-22fbfe823f8b</dcterms:identifier>
        <linkRationale xml:lang="en">An externality that is a cost</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
