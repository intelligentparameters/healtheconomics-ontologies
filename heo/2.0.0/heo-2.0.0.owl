    <!-- https://healtheconomics.wiki/concept/unitary-system -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/unitary-system">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-system"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
