    <!-- https://healtheconomics.wiki/concept/prevention-economics -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/prevention-economics">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
