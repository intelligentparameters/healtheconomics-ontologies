    <!-- https://healtheconomics.wiki/concept/benefit-package -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/benefit-package">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
