        <uses rdf:resource="https://healtheconomics.wiki/concept/kappa-statistic"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/test-retest-reliability"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
