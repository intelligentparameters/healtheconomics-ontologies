    <!-- https://healtheconomics.wiki/concept/likelihood-ratio-test -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/likelihood-ratio-test">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/hypothesis-testing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/hypothesis-testing"/>
        <skos:notation>HE-EM-MV-037</skos:notation>
        <dcterms:identifier>HE-EM-MV-037</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-24</dcterms:modified>
        <dcterms:source>Neyman &amp; Pearson 1933</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Likelihood Ratio Test</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Deviance Test</skos:altLabel>
        <skos:altLabel xml:lang="en">LRT</skos:altLabel>
        <skos:definition xml:lang="en">A statistical test comparing the fit of two nested models by their ratio of likelihoods, used to judge whether added parameters improve fit.</skos:definition>
        <skos:prefLabel xml:lang="en">Likelihood Ratio Test</skos:prefLabel>
        <abbreviation xml:lang="en">LRT</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-9"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/chi-square-distribution"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/degrees-of-freedom"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/likelihood-ratio-test"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/hypothesis-testing"/>
        <dcterms:identifier>HEO-L-110c4e22deb6</dcterms:identifier>
        <linkRationale xml:lang="en">LRT tests nested models, a hypothesis test</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/likelihood-ratio-test"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
