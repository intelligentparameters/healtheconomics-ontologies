    <!-- https://healtheconomics.wiki/concept/preventive-intervention -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/preventive-intervention">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
