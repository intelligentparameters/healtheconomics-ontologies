    <!-- https://healtheconomics.wiki/concept/severity-criterion -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/severity-criterion">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/decision-criteria"/>
        <skos:notation>HS-HP-HTA-194</skos:notation>
        <dcterms:identifier>HS-HP-HTA-194</dcterms:identifier>
        <dcterms:source>NICE 2022</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Severity Criterion</rdfs:label>
        <skos:definition xml:lang="en">A standard giving additional weight to interventions addressing more severe conditions, reflecting a preference for prioritising the greatest health shortfall.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Disease-Burden Criterion</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Severity Weighting</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Severity Criterion</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/proportional-shortfall"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/severity-criterion"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
