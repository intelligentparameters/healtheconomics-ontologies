        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#produces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/private-insurance-premium"/>
        <dcterms:identifier>HEO-L-48491102a7e1</dcterms:identifier>
