    <!-- https://healtheconomics.wiki/concept/outlier-payment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/outlier-payment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/prospective-payment"/>
        <skos:notation>HS-HP-PP-065</skos:notation>
        <dcterms:identifier>HS-HP-PP-065</dcterms:identifier>
        <dcterms:source>Fetter et al. 1980</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Outlier Payment</rdfs:label>
        <skos:definition xml:lang="en">A supplemental payment made in addition to standard prospective payment for a case whose actual cost or stay substantially exceeds expectations.</skos:definition>
        <skos:hiddenLabel xml:lang="en">High-Cost Case Payment</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Outlier Adjustment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Outlier Payment</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/outlier-payment"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <dcterms:identifier>HEO-L-e98f7e8dcfbb</dcterms:identifier>
        <linkRationale xml:lang="en">An outlier payment is an additional payment to providers</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/outlier-payment"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/prospective-payment"/>
        <dcterms:identifier>HEO-L-be36eba56469</dcterms:identifier>
        <linkRationale xml:lang="en">Outlier payments are a component of prospective payment systems that pay a fixed rate per case</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/outpatient-cost -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/outpatient-cost">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/direct-medical-cost"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/direct-medical-cost"/>
        <skos:notation>HS-DC-HC-012</skos:notation>
        <dcterms:identifier>HS-DC-HC-012</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Outpatient Cost</rdfs:label>
        <skos:altLabel xml:lang="en">Outpatient Care Cost</skos:altLabel>
        <skos:definition xml:lang="en">The expense of healthcare services delivered without an overnight hospital stay, such as clinic visits, diagnostic testing, and same-day procedures.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Ambulatory Cost</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Outpatient Cost</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/outpatient-cost"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/direct-medical-cost"/>
        <dcterms:identifier>HEO-L-cd542c68053c</dcterms:identifier>
        <linkRationale xml:lang="en">Outpatient services are medical care, so their cost is a direct medical cost</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


