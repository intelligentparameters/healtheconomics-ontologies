    <!-- https://healtheconomics.wiki/concept/transition-reward -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/transition-reward">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/markov-model"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/markov-model"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/markov-model"/>
        <skos:notation>HE-EM-MM-028</skos:notation>
        <dcterms:identifier>HE-EM-MM-028</dcterms:identifier>
        <dcterms:source>Sonnenberg FA, Beck JR. Markov models in medical decision making: a practical guide. Medical Decision Making. 1993;13(4):322-338. doi:10.1177/0272989X9301300409.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Transition Reward</rdfs:label>
        <skos:definition xml:lang="en">A cost or outcome value applied at the moment a patient moves between two health states, unlike a state reward accrued over time.</skos:definition>
        <skos:hiddenLabel xml:lang="en">One-Off Transition Value</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Transition Payoff</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Transition Reward</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/state-reward"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-3"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/transition-reward"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/markov-model"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-96836f7fcc82</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Markov and state transition models in subdomain Economic Modelling; placed under Markov Model, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/transition-reward"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/markov-model"/>
        <dcterms:identifier>HEO-L-8aeeaec67f2f</dcterms:identifier>
        <linkRationale xml:lang="en">Only link; transition rewards are a component of the payoff structure of a Markov model</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
