    <!-- https://healtheconomics.wiki/concept/orphan-drug-pricing -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/orphan-drug-pricing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:notation>HS-DC-DP-055</skos:notation>
        <dcterms:identifier>HS-DC-DP-055</dcterms:identifier>
        <dcterms:source>FDA, Orphan Drug Act</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Orphan Drug Pricing</rdfs:label>
        <skos:definition xml:lang="en">The pricing strategies applied to rare disease treatments, frequently priced far higher per patient than common-condition treatments given the smaller patient population.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Orphan Pricing</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Rare-Disease Drug Pricing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Orphan Drug Pricing</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/orphan-drug-pricing"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <dcterms:identifier>HEO-L-2887bb20945d</dcterms:identifier>
        <linkRationale xml:lang="en">Orphan drug pricing is a kind of drug pricing</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/orphan-drug-threshold -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/orphan-drug-threshold">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
