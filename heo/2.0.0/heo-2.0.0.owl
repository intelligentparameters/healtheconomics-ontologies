    <!-- https://healtheconomics.wiki/concept/presenteeism -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/presenteeism">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1756074"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/productivity-cost"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/work-productivity-outcome"/>
        <skos:notation>HE-EE-PM-023</skos:notation>
        <dcterms:identifier>HE-EE-PM-023</dcterms:identifier>
        <dcterms:source>Goetzel et al. 2004</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Presenteeism</rdfs:label>
        <skos:definition xml:lang="en">Reduced productivity from an employee who is physically present at work but performing below their normal capacity due to illness or injury.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Reduced On-Job Productivity</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Working While Unwell</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Presenteeism</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/presenteeism"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-a10db5e06511</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Productivity Measurement: productivity losses are valued as productivity costs (Productivity and indirect costs)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/presenteeism"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/productivity-cost"/>
        <dcterms:identifier>HEO-L-44a089d2d7b7</dcterms:identifier>
        <linkRationale xml:lang="en">Presenteeism is a component of lost work output (both definitions)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/presenteeism"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
