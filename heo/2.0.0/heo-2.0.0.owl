    <!-- https://healtheconomics.wiki/concept/discrimination-assessment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/discrimination-assessment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
