    <!-- https://healtheconomics.wiki/concept/active-life-expectancy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/active-life-expectancy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/disability-free-expectancy"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-expectancy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/disability-free-expectancy"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-expectancy"/>
        <skos:notation>HE-EE-HU-002</skos:notation>
        <dcterms:identifier>HE-EE-HU-002</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-03</dcterms:modified>
        <dcterms:source>Katz et al. 1983</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Active Life Expectancy</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">ALE</skos:altLabel>
        <skos:definition xml:lang="en">Active life expectancy (ALE) is the average number of years a person of a given age can expect to live free of dependency in activities of daily living.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Healthy Active Years</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Active Life Expectancy</skos:prefLabel>
        <abbreviation xml:lang="en">ALE</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/life-expectancy"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/outcomes#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/activities-of-daily-living"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/multi-state-life-table"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/sullivan-method"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/active-life-expectancy"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
