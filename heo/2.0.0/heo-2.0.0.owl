    <!-- https://healtheconomics.wiki/concept/safety -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/safety">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:notation>HS-HP-HTA-187</skos:notation>
        <dcterms:identifier>HS-HP-HTA-187</dcterms:identifier>
        <dcterms:source>U.S. Food and Drug Administration. Guidance for Industry: Patient-Reported Outcome Measures-Use in Medical Product Development to Support Labeling Claims. FDA; 2009.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Safety</rdfs:label>
        <skos:definition xml:lang="en">The degree to which an intervention avoids causing unintended harm, assessed through systematic monitoring and reporting of adverse events.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Freedom from Harm</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Harm Avoidance</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Safety</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/efficacy"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
