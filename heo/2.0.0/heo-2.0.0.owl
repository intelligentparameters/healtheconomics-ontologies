        <skos:hiddenLabel xml:lang="en">Trial Selection</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Study Selection</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/inclusion-criteria"/>
    </owl:NamedIndividual>
