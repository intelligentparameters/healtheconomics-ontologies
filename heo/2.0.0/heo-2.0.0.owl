    <!-- https://healtheconomics.wiki/concept/sampling-error -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/sampling-error">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/random-error"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q3306280"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/random-error"/>
        <skos:notation>HE-DS-BV-032</skos:notation>
        <dcterms:identifier>HE-DS-BV-032</dcterms:identifier>
        <dcterms:source>Groves et al. 2009</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Sampling Error</rdfs:label>
        <skos:definition xml:lang="en">The difference between a sample statistic and the true population value arising purely from studying a finite sample rather than the whole population.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Random Sampling Variation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Sample Variability</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Sampling Error</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/systematic-error"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/sampling-error"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/random-error"/>
        <dcterms:identifier>HEO-L-472df3f87e2c</dcterms:identifier>
        <linkRationale xml:lang="en">Sampling error arises from chance, a random error.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
