    <!-- https://healtheconomics.wiki/concept/capacity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/capacity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/capacity-utilisation"/>
        <skos:notation>HS-HP-HSC-002</skos:notation>
        <dcterms:identifier>HS-HP-HSC-002</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Valdmanis et al. 2004</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Capacity</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Capacity is the maximum output, such as patients treated or scans per week, that a health service can sustain with its fixed staff, beds and equipment.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Maximum Output</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Throughput Limit</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Capacity</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/throughput"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/capacity-planning"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/capacity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-8d0de902ee33</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health System Capacity: organisation and delivery of care is the Health Systems subdomain (Organisation and governance)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/capacity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/capacity-utilisation"/>
        <dcterms:identifier>HEO-L-14debcf0b3d8</dcterms:identifier>
        <linkRationale xml:lang="en">Capacity is the denominator of capacity utilisation (used over available)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
