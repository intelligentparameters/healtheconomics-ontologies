        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/between-study-heterogeneity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isPropertyOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/meta-analysis"/>
        <dcterms:identifier>HEO-L-ee957f5e06b8</dcterms:identifier>
