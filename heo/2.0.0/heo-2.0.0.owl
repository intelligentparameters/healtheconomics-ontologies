        <informs rdf:resource="https://healtheconomics.wiki/concept/multi-criteria-decision-analysis"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
