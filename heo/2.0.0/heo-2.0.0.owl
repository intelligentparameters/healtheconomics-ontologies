        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Choice of Comparator</skos:altLabel>
        <skos:definition xml:lang="en">Comparator selection is the HTA step that decides which existing treatments a new technology is compared with, usually current care or what it replaces.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Comparator Choice</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Comparator Selection</skos:prefLabel>
