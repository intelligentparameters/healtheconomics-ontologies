        <dcterms:identifier>HEO-L-c9b6a1048876</dcterms:identifier>
        <linkRationale xml:lang="en">The secondary attack rate is the attack rate among susceptible contacts.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
