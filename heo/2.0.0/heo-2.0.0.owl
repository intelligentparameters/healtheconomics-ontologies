    <!-- https://healtheconomics.wiki/concept/drug-clearance -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/drug-clearance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
