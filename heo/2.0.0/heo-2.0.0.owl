        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Responsiveness</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Sensitivity to Change</skos:altLabel>
        <skos:definition xml:lang="en">The ability of an outcome measurement instrument to detect change over time in the construct it is intended to measure, in a specified population and context of use.</skos:definition>
