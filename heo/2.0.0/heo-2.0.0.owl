        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Health Workforce</rdfs:label>
        <skos:altLabel xml:lang="en">Health Human Resources</skos:altLabel>
        <skos:altLabel xml:lang="en">Healthcare Workforce</skos:altLabel>
        <skos:definition xml:lang="en">The collective body of individuals engaged in actions whose primary intent is to enhance health, covering physicians, nurses, and other professionals.</skos:definition>
        <skos:prefLabel xml:lang="en">Health Workforce</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/workforce-policy"/>
