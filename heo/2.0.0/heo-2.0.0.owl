        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/habit-formation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/behavioural-economics"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-3fe0632a56ef</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Economic Evaluation &gt; Behavioral Economics: behavioural economics enters health economics mainly through policy design (incentives, nudges); placed under Behavioural Economics, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
