    <!-- https://healtheconomics.wiki/concept/explicit-rationing -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/explicit-rationing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/rationing-approach"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/rationing-approach"/>
        <skos:notation>HS-HP-HTA-088</skos:notation>
        <dcterms:identifier>HS-HP-HTA-088</dcterms:identifier>
        <dcterms:source>Mechanic 1995</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Explicit Rationing</rdfs:label>
        <skos:definition xml:lang="en">An approach in which decisions about what will and will not be funded are made openly, according to publicly disclosed criteria.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Open Rationing</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Transparent Rationing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Explicit Rationing</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/implicit-rationing"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/explicit-rationing"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/rationing-approach"/>
        <dcterms:identifier>HEO-L-afc64c5264db</dcterms:identifier>
        <linkRationale xml:lang="en">The object definition names explicit rationing as one approach</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/explicit-rationing"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/implicit-rationing"/>
        <dcterms:identifier>HEO-L-3e74886d5ca3</dcterms:identifier>
        <linkRationale xml:lang="en">Explicit versus implicit rationing; reverse in queue-r3-10, keep one at merge</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/exploratory-endpoint -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/exploratory-endpoint">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-endpoint"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/clinical-endpoint"/>
        <skos:notation>HE-ES-CTM-034</skos:notation>
        <dcterms:identifier>HE-ES-CTM-034</dcterms:identifier>
        <dcterms:source>Friedman LM, Furberg CD, DeMets DL, Reboussin DM, Granger CB. Fundamentals of Clinical Trials. 5th ed. Springer; 2015. doi:10.1007/978-3-319-18539-2.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Exploratory Endpoint</rdfs:label>
        <skos:altLabel xml:lang="en">Exploratory Outcome</skos:altLabel>
        <skos:definition xml:lang="en">A trial outcome examined for hypothesis-generating purposes, without the rigorous statistical control applied to primary and secondary endpoints.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Hypothesis-Generating Endpoint</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Exploratory Endpoint</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/primary-endpoint"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/secondary-endpoint"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/exploratory-endpoint"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/clinical-endpoint"/>
        <dcterms:identifier>HEO-L-b0b8480d9495</dcterms:identifier>
        <linkRationale xml:lang="en">An exploratory endpoint is a trial outcome</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/exploratory-endpoint"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/primary-endpoint"/>
        <dcterms:identifier>HEO-L-d710fbb52a49</dcterms:identifier>
        <linkRationale xml:lang="en">Exploratory endpoints are hypothesis-generating, unlike the powered primary endpoint</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/exploratory-endpoint"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
