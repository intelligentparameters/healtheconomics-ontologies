    <!-- https://healtheconomics.wiki/concept/rapid-update -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/rapid-update">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-update"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/guidance-update"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/evidence-update"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/guidance-update"/>
        <skos:notation>HS-HP-HTA-167</skos:notation>
        <dcterms:identifier>HS-HP-HTA-167</dcterms:identifier>
        <dcterms:source>Elliott et al. 2014</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Rapid Update</rdfs:label>
        <skos:definition xml:lang="en">An expedited revision to previously published guidance, incorporating important new evidence more quickly than a standard review cycle allows.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Expedited Update</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Fast Guidance Refresh</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Rapid Update</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
