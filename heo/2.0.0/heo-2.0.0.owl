    <!-- https://healtheconomics.wiki/concept/queue-management -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/queue-management">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-HP-HSC-006</skos:notation>
        <dcterms:identifier>HS-HP-HSC-006</dcterms:identifier>
        <dcterms:source>Law &amp; Kelton 2000</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Queue Management</rdfs:label>
        <skos:definition xml:lang="en">The strategies and systems used to organise and prioritise patients waiting for access to a limited healthcare resource.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Queue Control</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Waiting-Line Management</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Queue Management</skos:prefLabel>
        <manages rdf:resource="https://healtheconomics.wiki/concept/waiting-list"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/waiting-time"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/queuing-model"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/queue-management"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-ffc517928291</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health System Capacity: organisation and delivery of care is the Health Systems subdomain (Organisation and governance)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/queue-management"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#manages"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/waiting-list"/>
        <dcterms:identifier>HEO-L-c32038e7e11f</dcterms:identifier>
        <linkRationale xml:lang="en">Capacity management matches beds and staff; queue management organises waiting patients, i.e. the waiting list.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
