        <dcterms:identifier>HEO-L-9607c36b1d02</dcterms:identifier>
        <linkRationale xml:lang="en">Simple patient access schemes are confidential discounts</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
