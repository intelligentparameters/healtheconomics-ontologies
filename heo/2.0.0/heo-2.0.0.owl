        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Policy Termination</rdfs:label>
        <skos:definition xml:lang="en">The formal discontinuation of an existing policy or programme, typically when judged ineffective, unnecessary, or superseded by an alternative.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Policy Cessation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Policy Wind-Down</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Policy Termination</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
