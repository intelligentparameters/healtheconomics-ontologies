    <!-- https://healtheconomics.wiki/concept/technology-innovation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/technology-innovation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/innovation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/innovation"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/technical-change-in-healthcare"/>
        <precedes rdf:resource="https://healtheconomics.wiki/concept/diffusion"/>
        <skos:notation>HE-PE-TI-034</skos:notation>
        <dcterms:identifier>HE-PE-TI-034</dcterms:identifier>
        <dcterms:source>Christensen, Raynor &amp; McDonald 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Technology Innovation</rdfs:label>
        <skos:definition xml:lang="en">The development and introduction of new technologies improving disease diagnosis, treatment, or management, spanning incremental and radical, disruptive advances.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Health-Tech Innovation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Medical Innovation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Technology Innovation</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/intensity-growth"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/health-technology"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/technology-innovation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/innovation"/>
        <dcterms:identifier>HEO-L-1e99be9b123f</dcterms:identifier>
        <linkRationale xml:lang="en">Technology innovation is innovation in health technology.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/technology-innovation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/technical-change-in-healthcare"/>
        <dcterms:identifier>HEO-L-6c2a83c57c9a</dcterms:identifier>
        <linkRationale xml:lang="en">Technical change covers both development and adoption of technology; innovation is its development part, so Technology Innovation partOf Technical Change.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
