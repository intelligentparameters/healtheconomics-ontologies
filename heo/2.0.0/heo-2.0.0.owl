        <skos:prefLabel xml:lang="en">Clawback</skos:prefLabel>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/clawback"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-containment"/>
        <dcterms:identifier>HEO-L-20fc83776865</dcterms:identifier>
        <linkRationale xml:lang="en">Returning spending above a cap holds down spending (both definitions)</linkRationale>
