    <!-- https://healtheconomics.wiki/concept/operational-efficiency -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/operational-efficiency">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/efficiency"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q7097774"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/efficiency"/>
        <skos:notation>HS-SS_HSP-043</skos:notation>
        <dcterms:identifier>HS-SS_HSP-043</dcterms:identifier>
        <dcterms:source>Horngren, Datar &amp; Rajan 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Operational Efficiency</rdfs:label>
        <skos:altLabel xml:lang="en">Operating Efficiency</skos:altLabel>
        <skos:definition xml:lang="en">A measure of how effectively an organisation converts available resources into patient care activity, avoiding unnecessary waste or delay.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Process Efficiency</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Operational Efficiency</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/operational-efficiency"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/efficiency"/>
        <dcterms:identifier>HEO-L-b4176e4e67a8</dcterms:identifier>
        <linkRationale xml:lang="en">Operational efficiency is efficiency in converting resources into care activity</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/operational-waste -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/operational-waste">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/waste-in-healthcare"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/waste-in-healthcare"/>
        <skos:notation>HS-NHS-HQ-046</skos:notation>
        <dcterms:identifier>HS-NHS-HQ-046</dcterms:identifier>
        <dcterms:source>Berwick &amp; Hackbarth 2012</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Operational Waste</rdfs:label>
        <skos:definition xml:lang="en">Inefficiencies within an organisation&apos;s day-to-day operations that consume resources without producing corresponding value, such as unnecessary delays.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Operational Inefficiency</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Process Waste</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Operational Waste</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/operational-efficiency"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/operational-waste"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/waste-in-healthcare"/>
        <dcterms:identifier>HEO-L-58560cc41493</dcterms:identifier>
        <linkRationale xml:lang="en">Operational inefficiency is one of the named components of waste in healthcare (object definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/operational-waste"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/operational-efficiency"/>
        <dcterms:identifier>HEO-L-b8c6e97a7458</dcterms:identifier>
