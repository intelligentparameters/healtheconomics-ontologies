        <dcterms:identifier>HE-HF-HI-030</dcterms:identifier>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Voluntary Health Insurance</rdfs:label>
        <skos:altLabel xml:lang="en">VHI</skos:altLabel>
        <skos:definition xml:lang="en">In health economics, health insurance bought at the discretion of individuals or employers rather than mandated by the state, often supplementing public cover.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Discretionary Health Cover</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Voluntary Health Insurance</skos:prefLabel>
        <abbreviation xml:lang="en">VHI</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/social-health-insurance"/>
