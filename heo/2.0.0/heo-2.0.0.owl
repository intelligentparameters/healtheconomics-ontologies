    <!-- https://healtheconomics.wiki/concept/vaccine-effectiveness -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/vaccine-effectiveness">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/effectiveness"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/effectiveness"/>
        <skos:notation>HE-PE-ID-076</skos:notation>
        <dcterms:identifier>HE-PE-ID-076</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Institute of Medicine. Initial National Priorities for Comparative Effectiveness Research. National Academies Press; 2009. doi:10.17226/12648.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Vaccine Effectiveness</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">The degree to which a vaccine reduces disease risk under real-world conditions in a general population, unlike efficacy measured under trial conditions.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Field Effectiveness</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Real-World Vaccine Effect</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Vaccine Effectiveness</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/vaccine-efficacy"/>
