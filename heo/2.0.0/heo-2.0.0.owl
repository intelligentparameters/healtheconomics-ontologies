        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/structural-validity-instrument"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/measurement-property"/>
        <dcterms:identifier>HEO-L-c90ca9359a36</dcterms:identifier>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/structural-validity-instrument"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
