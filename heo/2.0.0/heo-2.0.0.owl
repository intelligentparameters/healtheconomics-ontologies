        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Run Chart Analysis</rdfs:label>
        <skos:definition xml:lang="en">The process of interpreting a run chart to identify meaningful trends or patterns in a process or outcome measure over time.</skos:definition>
