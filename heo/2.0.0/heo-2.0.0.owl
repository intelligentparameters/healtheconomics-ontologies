    <!-- https://healtheconomics.wiki/concept/structure-measure -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/structure-measure">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/quality-indicator"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/quality-indicator"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/structural-quality"/>
        <skos:notation>HS-NHS-HQ-078</skos:notation>
        <dcterms:identifier>HS-NHS-HQ-078</dcterms:identifier>
        <dcterms:source>Donabedian A. Evaluating the quality of medical care. Milbank Memorial Fund Quarterly. 1966;44(3):166-206. doi:10.2307/3348969.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Structure Measure</rdfs:label>
        <skos:altLabel xml:lang="en">Structure Indicator</skos:altLabel>
        <skos:definition xml:lang="en">A metric assessing resources and organisational characteristics available to deliver care, such as staffing or equipment, unlike process or outcomes.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Input Measure</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Structure Measure</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
