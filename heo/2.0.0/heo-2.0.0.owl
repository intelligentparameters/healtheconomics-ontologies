        <dcterms:source>Joint Commission, Sentinel Event Policy</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Wrong Site Surgery</rdfs:label>
        <skos:definition xml:lang="en">A serious, generally preventable safety event where a procedure is performed on the wrong body part, patient, or is entirely the wrong procedure.</skos:definition>
        <skos:prefLabel xml:lang="en">Wrong Site Surgery</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/patient-safety"/>
