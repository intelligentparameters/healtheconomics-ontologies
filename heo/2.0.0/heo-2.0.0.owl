        <rdfs:label xml:lang="en">Nash Equilibrium</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">A Nash equilibrium is a set of strategies, one per player, from which no player, such as a payer, provider or patient, gains by changing strategy alone.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Strategic Equilibrium</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Nash Equilibrium</skos:prefLabel>
