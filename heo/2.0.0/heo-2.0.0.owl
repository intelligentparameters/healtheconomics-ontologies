        <dcterms:identifier>HE-EE-WE-013</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Lorenz 1905</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Lorenz Curve</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A graph plotting the cumulative share of total income against the cumulative share of population, ranked poorest to richest, showing distribution.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Lorenz Diagram</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Lorenz Curve</skos:prefLabel>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/concentration-index"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/lorenz-curve"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/data-visualisation"/>
        <dcterms:identifier>HEO-L-8478f0120719</dcterms:identifier>
        <linkRationale xml:lang="en">A Lorenz curve is a graph</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/lorenz-curve"/>
