    <!-- https://healtheconomics.wiki/concept/hospital-hta-unit -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/hospital-hta-unit">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:notation>HS-HP-HTA-246</skos:notation>
        <dcterms:identifier>HS-HP-HTA-246</dcterms:identifier>
        <dcterms:source>Kidholm et al. 2012</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Hospital HTA Unit</rdfs:label>
        <skos:definition xml:lang="en">A functional unit within an individual hospital conducting localised, often simplified assessments for institution-specific decisions such as adopting new equipment.</skos:definition>
