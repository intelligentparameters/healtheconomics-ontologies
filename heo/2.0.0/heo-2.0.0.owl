    <!-- https://healtheconomics.wiki/concept/ambulatory-surgery-centre -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/ambulatory-surgery-centre">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
