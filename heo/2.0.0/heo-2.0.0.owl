    <!-- https://healtheconomics.wiki/concept/pragmatic-trial -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/pragmatic-trial">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/effectiveness-study"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/randomised-controlled-trial"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/effectiveness-study"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/randomised-controlled-trial"/>
        <skos:notation>HE-ES-CER-022</skos:notation>
        <dcterms:identifier>HE-ES-CER-022</dcterms:identifier>
        <dcterms:source>Schwartz &amp; Lellouch 1967</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Pragmatic Trial</rdfs:label>
        <skos:altLabel xml:lang="en">Effectiveness Trial</skos:altLabel>
        <skos:definition xml:lang="en">A trial designed to evaluate a treatment under conditions resembling routine clinical practice, using broad eligibility and outcomes relevant to real-world decisions.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Real-World Trial</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Pragmatic Trial</skos:prefLabel>
        <produces rdf:resource="https://healtheconomics.wiki/concept/real-world-evidence"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/pragmatic-trial-design"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/pragmatic-trial"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/effectiveness-study"/>
        <dcterms:identifier>HEO-L-1f97ac2c1501</dcterms:identifier>
        <linkRationale xml:lang="en">A pragmatic trial measures effectiveness under routine conditions</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
