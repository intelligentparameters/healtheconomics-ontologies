    <!-- https://healtheconomics.wiki/concept/administrative-barrier -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/administrative-barrier">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/access-barrier"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/access-barrier"/>
        <skos:notation>HS-HP-HE-006</skos:notation>
        <dcterms:identifier>HS-HP-HE-006</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Herd et al. 2023</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Administrative Barrier</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">An administrative barrier is a paperwork, enrolment, renewal or approval requirement that deters or delays use of healthcare.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Bureaucratic Barrier</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Procedural Barrier</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Red Tape</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Administrative Barrier</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/health-inequity"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/unmet-need"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-policy#step-4"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/administrative-barrier"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/access-barrier"/>
        <dcterms:identifier>HEO-L-d574074d3569</dcterms:identifier>
        <linkRationale xml:lang="en">A paperwork requirement that delays care is an access barrier</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/administrative-barrier"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
