    <!-- https://healtheconomics.wiki/concept/rule-of-rescue -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/rule-of-rescue">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <skos:notation>HS-HP-HTA-186</skos:notation>
        <dcterms:identifier>HS-HP-HTA-186</dcterms:identifier>
        <dcterms:source>Jonsen 1986</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Rule of Rescue</rdfs:label>
        <skos:definition xml:lang="en">An ethical intuition describing the strong societal impulse to devote resources to rescuing identifiable individuals in immediate danger, even against cost-effectiveness logic.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Identifiable Victim Effect</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Rescue Principle</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Rule of Rescue</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/coverage-decision"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/rule-of-rescue"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-91f818d3a5b2</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health Technology Assessment: HTA concepts belong to the HTA subdomain</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/rule-of-rescue"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <dcterms:identifier>HEO-L-b88ee66bf116</dcterms:identifier>
        <linkRationale xml:lang="en">The rule of rescue runs against cost-effectiveness logic (per its definition).</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/rule-of-rescue"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/coverage-decision"/>
        <dcterms:identifier>HEO-L-4b449a8f7f13</dcterms:identifier>
