        <informs rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/topic-identification"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
