    <!-- https://healtheconomics.wiki/concept/exponential-distribution -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/exponential-distribution">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/probability-distribution"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/probability-distribution"/>
        <skos:notation>HE-EM-SM-018</skos:notation>
        <dcterms:identifier>HE-EM-SM-018</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
