    <!-- https://healtheconomics.wiki/concept/recall-period-selection -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/recall-period-selection">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
