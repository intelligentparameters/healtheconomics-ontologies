        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/safety-profile"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/medication-safety"/>
