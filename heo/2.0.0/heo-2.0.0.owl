        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Ratio Scaling</rdfs:label>
        <skos:definition xml:lang="en">A measurement approach in which respondents express one stimulus&apos;s magnitude relative to another as a numerical ratio, such as twice as severe.</skos:definition>
