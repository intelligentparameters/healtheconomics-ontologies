        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:altLabel xml:lang="en">Digital Health Implementation</skos:altLabel>
        <skos:definition xml:lang="en">Digital implementation is the work of putting a digital health technology into routine care with workflow redesign, integration, training and governance.</skos:definition>
