        <partOf rdf:resource="https://healtheconomics.wiki/concept/clinical-audit"/>
        <skos:notation>HS-HP-HTA-020</skos:notation>
        <dcterms:identifier>HS-HP-HTA-020</dcterms:identifier>
        <dcterms:source>National Institute for Health and Care Excellence. NICE technology appraisal and highly specialised technologies guidance: the manual (PMG36). Published 2022; updated 2026.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Audit Criterion</rdfs:label>
        <skos:definition xml:lang="en">A specific, measurable standard used to assess whether clinical practice conforms to an established guideline or expected performance level.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Audit Measure</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Audit Standard</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Audit Criterion</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
