        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Medication Safety</rdfs:label>
        <skos:definition xml:lang="en">Freedom from preventable harm associated with medication use, covering safe practice throughout prescribing, dispensing, administration, and monitoring.</skos:definition>
