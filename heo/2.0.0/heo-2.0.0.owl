    <!-- https://healtheconomics.wiki/concept/gaussian-quadrature -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/gaussian-quadrature">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
