        <uses rdf:resource="https://healtheconomics.wiki/concept/audit-and-feedback"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/antibiotic-stewardship"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/quality-improvement"/>
        <dcterms:identifier>HEO-L-6612776db1eb</dcterms:identifier>
        <linkRationale xml:lang="en">A coordinated programme to improve prescribing is a quality improvement programme</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
