        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">RS Index</skos:altLabel>
        <skos:definition xml:lang="en">An index measuring the redistributive effect of a tax or transfer system, calculated as the difference between pre-tax and post-tax income Gini coefficients.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Redistributive Effect Index</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Reynolds-Smolensky</skos:prefLabel>
        <abbreviation xml:lang="en">RS Index</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/kakwani-index"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-policy#step-4"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/gini-coefficient"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/reynolds-smolensky"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
