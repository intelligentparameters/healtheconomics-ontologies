    <!-- https://healtheconomics.wiki/concept/price-spillover -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/price-spillover">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/externality"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/externality"/>
        <skos:notation>HS-DC-DP-075</skos:notation>
        <dcterms:identifier>HS-DC-DP-075</dcterms:identifier>
        <dcterms:source>Danzon 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Price Spillover</rdfs:label>
        <skos:definition xml:lang="en">The effect by which a pricing decision for a drug in one market influences its price elsewhere, most notably through reference pricing links.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cross-Border Price Effect</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Price Contagion</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Price Spillover</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/price-spillover"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/externality"/>
        <dcterms:identifier>HEO-L-b9931526887c</dcterms:identifier>
        <linkRationale xml:lang="en">A price decision in one market imposes uncompensated effects on other markets</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/price-strategy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/price-strategy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
