    <!-- https://healtheconomics.wiki/concept/do-not-do -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/do-not-do">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
