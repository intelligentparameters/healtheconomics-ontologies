        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/microsimulation"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/monte-carlo-simulation"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/numerical-method"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-12"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/expected-value"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
