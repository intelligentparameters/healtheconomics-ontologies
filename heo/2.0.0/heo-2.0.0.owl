        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/effect-size"/>
        <dcterms:identifier>HEO-L-8e99b6e5f639</dcterms:identifier>
        <linkRationale xml:lang="en">generic link; an effect estimate is a study estimated value of an effect size measure</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
