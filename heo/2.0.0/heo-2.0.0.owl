    <!-- https://healtheconomics.wiki/concept/oligopoly-behaviour -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/oligopoly-behaviour">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
