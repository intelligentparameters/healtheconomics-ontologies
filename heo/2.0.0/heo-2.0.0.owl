    <!-- https://healtheconomics.wiki/concept/physician-hospital-organization -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/physician-hospital-organization">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/integrated-care"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/integrated-care"/>
        <skos:notation>HS-HP-IC-027</skos:notation>
        <dcterms:identifier>HS-HP-IC-027</dcterms:identifier>
        <dcterms:source>Kongstvedt 2012</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Physician Hospital Organization</rdfs:label>
        <skos:altLabel xml:lang="en">PHO</skos:altLabel>
        <skos:definition xml:lang="en">An arrangement joining physicians and a hospital to jointly contract with payers, while participating physicians remain in independent practice.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Joint Provider Venture</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Physician Hospital Organization</skos:prefLabel>
        <abbreviation xml:lang="en">PHO</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/independent-practice-association"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/physician-hospital-organization"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/integrated-care"/>
        <dcterms:identifier>HEO-L-c8c4797c0847</dcterms:identifier>
        <linkRationale xml:lang="en">A PHO is a contractual form of physician and hospital integration for coordinated care</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/physician-hospital-organization"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/independent-practice-association"/>
        <dcterms:identifier>HEO-L-eb21798a914e</dcterms:identifier>
