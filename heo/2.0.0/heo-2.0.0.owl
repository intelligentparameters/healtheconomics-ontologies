    <!-- https://healtheconomics.wiki/concept/anti-kickback-statute -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/anti-kickback-statute">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/regulation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/regulation"/>
        <skos:notation>HS-HP-HSR-004</skos:notation>
        <dcterms:identifier>HS-HP-HSR-004</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>US, Anti-Kickback Statute (42 U.S.C. § 1320a-7b)</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Anti-Kickback Statute</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">AKS</skos:altLabel>
        <skos:altLabel xml:lang="en">Federal Anti-Kickback Law</skos:altLabel>
        <skos:definition xml:lang="en">The Anti-Kickback Statute (AKS) is a US criminal law banning paying or receiving anything of value for referrals of care paid by federal health programmes.</skos:definition>
        <skos:prefLabel xml:lang="en">Anti-Kickback Statute</skos:prefLabel>
        <abbreviation xml:lang="en">AKS</abbreviation>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/overutilization"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/stark-law"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/anti-kickback-statute"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/regulation"/>
        <dcterms:identifier>HEO-L-bc00cb26b0fb</dcterms:identifier>
        <linkRationale xml:lang="en">AKS is a current US federal statute governing conduct of private actors</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/anti-kickback-statute"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#addresses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/overutilization"/>
        <dcterms:identifier>HEO-L-6b038048b37e</dcterms:identifier>
        <linkRationale xml:lang="en">AKS targets payments for referrals to curb overutilisation; it does not directly lower informational supplier-induced demand</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/anti-kickback-statute"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/stark-law"/>
        <dcterms:identifier>HEO-L-0fe386b09a2f</dcterms:identifier>
