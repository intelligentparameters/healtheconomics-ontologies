    <!-- https://healtheconomics.wiki/concept/clinical-efficiency -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/clinical-efficiency">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/technical-efficiency"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/technical-efficiency"/>
        <skos:notation>HS-SS_HSP-013</skos:notation>
        <dcterms:identifier>HS-SS_HSP-013</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-09</dcterms:modified>
        <dcterms:source>Cylus et al. 2016</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Clinical Efficiency</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Clinical efficiency is the extent to which clinicians and teams achieve good patient outcomes with the least staff time, tests, drugs and bed-days.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Care Efficiency</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Clinical Resource Efficiency</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Clinical Efficiency</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/health-system-efficiency"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/clinical-efficiency"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/technical-efficiency"/>
        <dcterms:identifier>HEO-L-908e3499c786</dcterms:identifier>
        <linkRationale xml:lang="en">Fewest inputs for given outcomes is technical efficiency (both definitions)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/clinical-efficiency"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-system-efficiency"/>
        <dcterms:identifier>HEO-L-af4a6d2a8f89</dcterms:identifier>
