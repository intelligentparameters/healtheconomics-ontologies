    <!-- https://healtheconomics.wiki/concept/advanced-therapy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/advanced-therapy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/biologic"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q718658"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
