    <!-- https://healtheconomics.wiki/concept/length-of-stay-management -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/length-of-stay-management">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/capacity-management"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/capacity-management"/>
        <skos:notation>HS-SS_HD-018</skos:notation>
        <dcterms:identifier>HS-SS_HD-018</dcterms:identifier>
        <dcterms:source>World Health Organization. Everybody&apos;s Business: Strengthening Health Systems to Improve Health Outcomes-WHO&apos;s Framework for Action. WHO; 2007.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Length Of Stay Management</rdfs:label>
        <skos:altLabel xml:lang="en">LOS Management</skos:altLabel>
        <skos:definition xml:lang="en">Strategies used to appropriately manage and, where clinically suitable, reduce hospitalisation duration, through care coordination and discharge planning.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Stay Reduction</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Length Of Stay Management</skos:prefLabel>
        <abbreviation xml:lang="en">LOS Management</abbreviation>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/length-of-stay"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/discharge-management"/>
    </owl:NamedIndividual>
