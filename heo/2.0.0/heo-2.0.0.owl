    <!-- https://healtheconomics.wiki/concept/cost-containment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cost-containment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-HP-EXP-001</skos:notation>
        <dcterms:identifier>HS-HP-EXP-001</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</dcterms:modified>
        <dcterms:source>Carrin &amp; Hanvoravongchai 2003</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cost Containment</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Cost Control</skos:altLabel>
        <skos:definition xml:lang="en">Cost containment is the use of policies such as budget caps, payment controls and patient charges to hold down the level or growth of health spending.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cost Curbing</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Spending Growth Control</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cost Containment</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/cost-savings"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/cost-shifting"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/deficit-reduction"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/healthcare-cost-growth"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/budget-cap"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cost-containment"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
