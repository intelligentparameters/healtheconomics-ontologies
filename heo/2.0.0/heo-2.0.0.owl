        <skos:hiddenLabel xml:lang="en">Medical Speciality Area</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Treatment Area</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Therapeutic Area</skos:prefLabel>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/drug-development"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
