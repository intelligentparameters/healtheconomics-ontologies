    <!-- https://healtheconomics.wiki/concept/out-of-pocket-share -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/out-of-pocket-share">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <skos:notation>HS-HP-HF-048</skos:notation>
        <dcterms:identifier>HS-HP-HF-048</dcterms:identifier>
        <dcterms:source>WHO, Health Financing for Universal Coverage</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Out-of-Pocket Share</rdfs:label>
        <skos:altLabel xml:lang="en">OOP Financing Share</skos:altLabel>
        <skos:altLabel xml:lang="en">OOP Share</skos:altLabel>
        <skos:definition xml:lang="en">The proportion of total healthcare expenditure within a country paid directly by patients, rather than through pooled financing mechanisms.</skos:definition>
        <skos:prefLabel xml:lang="en">Out-of-Pocket Share</skos:prefLabel>
        <abbreviation xml:lang="en">OOP Financing Share</abbreviation>
        <abbreviation xml:lang="en">OOP Share</abbreviation>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/out-of-pocket-share"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-4e97cc64a461</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health Financing: wiki topic Health financing and insurance sits in Health Systems; placed under Health System Financing, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/out-of-pocket-share"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isPropertyOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <dcterms:identifier>HEO-L-a7ff62b87d3b</dcterms:identifier>
        <linkRationale xml:lang="en">A spending share is not a financing system; it is a characteristic describing the financing mix</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/out-of-sample -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/out-of-sample">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-ES-SA-145</skos:notation>
        <dcterms:identifier>HE-ES-SA-145</dcterms:identifier>
        <dcterms:source>Stone 1974</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Out-of-Sample</rdfs:label>
        <skos:definition xml:lang="en">Describing performance calculated using data not used in a model&apos;s original construction, giving a more realistic assessment of likely real-world accuracy.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Holdout Sample</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Test-Set Evaluation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Out-of-Sample</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/model-validation"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/test-set"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/out-of-sample"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-270743bc49f4</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Statistical Analysis: catalogue subdomain Evidence Synthesis is one of the subdomains</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/out-of-sample"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#informs"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/model-validation"/>
        <dcterms:identifier>HEO-L-2eef95b2923a</dcterms:identifier>
        <linkRationale xml:lang="en">Out-of-sample performance gives a realistic accuracy check used in validation (subject definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/out-of-sample"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/test-set"/>
        <dcterms:identifier>HEO-L-55bdbac0ae33</dcterms:identifier>
        <linkRationale xml:lang="en">Out-of-sample performance is computed on data held out from fitting, the test set.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/outbreak-cost -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/outbreak-cost">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-burden"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/economic-burden"/>
        <skos:notation>HE-PE-ID-048</skos:notation>
        <dcterms:identifier>HE-PE-ID-048</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Outbreak Cost</rdfs:label>
        <skos:altLabel xml:lang="en">Cost of Outbreak</skos:altLabel>
        <skos:definition xml:lang="en">The total economic burden of an infectious disease outbreak, covering direct healthcare costs, public health response spending, and productivity losses.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Epidemic Cost</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Outbreak Cost</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/outbreak-cost"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-burden"/>
        <dcterms:identifier>HEO-L-4e3c78bac57c</dcterms:identifier>
        <linkRationale xml:lang="en">Outbreak cost is the economic burden of an outbreak, not a field of economic evaluation</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/outbreak-investigation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/outbreak-investigation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
