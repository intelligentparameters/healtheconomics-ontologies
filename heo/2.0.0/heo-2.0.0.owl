        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</dcterms:modified>
        <dcterms:source>Jachimowicz et al. 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Default Effect</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:altLabel xml:lang="en">Default Bias</skos:altLabel>
        <skos:definition xml:lang="en">The default effect is the tendency to stay with a pre-selected option, so opt-out schemes for organ donation or HIV testing raise uptake over opt-in.</skos:definition>
        <skos:prefLabel xml:lang="en">Default Effect</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/active-choice"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/uptake-rate"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/default-intervention"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/default-effect-concept"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cognitive-bias-concept"/>
        <dcterms:identifier>HEO-L-c7123ae2a4bb</dcterms:identifier>
        <linkRationale xml:lang="en">A systematic judgement error from a mental shortcut</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/default-effect-concept"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/active-choice"/>
