    <!-- https://healtheconomics.wiki/concept/retrospective-data -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/retrospective-data">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/real-world-data"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/real-world-data"/>
        <skos:notation>HE-ES-ES-039</skos:notation>
        <dcterms:identifier>HE-ES-ES-039</dcterms:identifier>
        <dcterms:source>Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams &amp; Wilkins; 2008.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Retrospective Data</rdfs:label>
        <skos:definition xml:lang="en">Data collected by looking backward from a defined point, reconstructed from existing records rather than gathered as events occur.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Back-Looking Data</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Historical Data</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Retrospective Data</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/retrospective-data"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/real-world-data"/>
        <dcterms:identifier>HEO-L-023d5cedd3bb</dcterms:identifier>
        <linkRationale xml:lang="en">Retrospective data reconstructed from existing records are real-world data.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/retrospective-evaluation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/retrospective-evaluation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/observational-study"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/observational-study"/>
        <skos:notation>HE-EE-EM-011</skos:notation>
        <dcterms:identifier>HE-EE-EM-011</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Retrospective Evaluation</rdfs:label>
        <skos:definition xml:lang="en">An economic evaluation using data collected before the study began, such as historical records or claims, rather than data gathered specifically for it.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Backward-Looking Evaluation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Look-Back Evaluation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Retrospective Evaluation</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/retrospective-data"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/retrospective-evaluation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/observational-study"/>
        <dcterms:identifier>HEO-L-2755d5bf3c5e</dcterms:identifier>
        <linkRationale xml:lang="en">Using existing records without assignment is an observational design.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/retrospective-evaluation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/retrospective-data"/>
        <dcterms:identifier>HEO-L-8cf1d7696132</dcterms:identifier>
        <linkRationale xml:lang="en">Retrospective evaluation draws on retrospective data.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/retrospective-payment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/retrospective-payment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <skos:notation>HS-HP-PP-091</skos:notation>
