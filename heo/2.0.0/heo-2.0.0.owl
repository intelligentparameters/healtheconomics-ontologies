    <!-- https://healtheconomics.wiki/concept/process-innovation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/process-innovation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/innovation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/innovation"/>
        <skos:notation>HE-PE-TI-025</skos:notation>
        <dcterms:identifier>HE-PE-TI-025</dcterms:identifier>
        <dcterms:source>Christensen, Raynor &amp; McDonald 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Process Innovation</rdfs:label>
        <skos:definition xml:lang="en">An innovation improving how a good or service is produced or delivered, rather than changing the underlying product itself.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Delivery Innovation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Operational Innovation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Process Innovation</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/technology-innovation"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/process-innovation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/innovation"/>
        <dcterms:identifier>HEO-L-d688dc6357d5</dcterms:identifier>
        <linkRationale xml:lang="en">Process innovation is a kind of innovation.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/process-innovation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/technology-innovation"/>
        <dcterms:identifier>HEO-L-e34a2fc96c21</dcterms:identifier>
        <linkRationale xml:lang="en">Process versus product (technology) innovation is the standard pair.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/process-mapping -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/process-mapping">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:notation>HS-HP-SS-027</skos:notation>
        <dcterms:identifier>HS-HP-SS-027</dcterms:identifier>
        <dcterms:source>American Society for Quality</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Process Mapping</rdfs:label>
        <skos:definition xml:lang="en">The creation of a detailed visual representation of the steps, decision points, and participants involved in a workflow or care process.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Process Flow Mapping</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Workflow Mapping</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Process Mapping</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/quality-improvement"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/flow-chart"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/process-mapping"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
