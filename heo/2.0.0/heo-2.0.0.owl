    <!-- https://healtheconomics.wiki/concept/medical-products-block -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/medical-products-block">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
