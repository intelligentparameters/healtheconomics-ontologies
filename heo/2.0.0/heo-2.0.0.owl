    <!-- https://healtheconomics.wiki/concept/network-meta-analysis-hta -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/network-meta-analysis-hta">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
