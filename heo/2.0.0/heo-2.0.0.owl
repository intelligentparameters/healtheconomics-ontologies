    <!-- https://healtheconomics.wiki/concept/tragedy-of-the-commons -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/tragedy-of-the-commons">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/market-failure"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/market-failure"/>
        <skos:notation>HE-EE-CRE-007</skos:notation>
        <dcterms:identifier>HE-EE-CRE-007</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-03</dcterms:modified>
        <dcterms:source>Hardin 1968</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Tragedy of the Commons</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">The tragedy of the commons is the overuse of a shared resource, such as antibiotic effectiveness, when each user keeps the gain but the cost falls on all.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Common-Pool Overuse</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Commons Problem</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Tragedy of the Commons</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/antimicrobial-resistance"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/tragedy-of-the-commons"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/market-failure"/>
        <dcterms:identifier>HEO-L-e80f410af3bf</dcterms:identifier>
        <linkRationale xml:lang="en">Overuse of a shared resource is an externality, a standard form of market failure.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/tragedy-of-the-commons"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/antimicrobial-resistance"/>
        <dcterms:identifier>HEO-L-1ffff78ce69a</dcterms:identifier>
        <linkRationale xml:lang="en">Overuse of shared antibiotic effectiveness drives resistance.</linkRationale>
