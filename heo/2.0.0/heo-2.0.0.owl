    <!-- https://healtheconomics.wiki/concept/third-party-payer -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/third-party-payer">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/healthcare-payer"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q132560290"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/healthcare-payer"/>
        <skos:notation>HS-HP-HI-195</skos:notation>
        <dcterms:identifier>HS-HP-HI-195</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Third-Party Payer</rdfs:label>
        <skos:definition xml:lang="en">An entity, other than the patient or provider, that finances healthcare costs on behalf of a covered individual, such as an insurer.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Insurer-Payer</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Third-Party Reimburser</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Third-Party Payer</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/out-of-pocket-payment"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/moral-hazard"/>
        <performs rdf:resource="https://healtheconomics.wiki/concept/reimbursement"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/third-party-payer"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/healthcare-payer"/>
        <dcterms:identifier>HEO-L-7c8290373a22</dcterms:identifier>
        <linkRationale xml:lang="en">A third-party payer is a healthcare payer.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
