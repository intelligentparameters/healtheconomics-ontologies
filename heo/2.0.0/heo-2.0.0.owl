    <!-- https://healtheconomics.wiki/concept/ex-ante-moral-hazard -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/ex-ante-moral-hazard">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/moral-hazard"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/moral-hazard"/>
        <skos:notation>HE-EE-HI-001</skos:notation>
        <dcterms:identifier>HE-EE-HI-001</dcterms:identifier>
        <dcterms:source>Pauly 1968</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Ex Ante Moral Hazard</rdfs:label>
        <skos:definition xml:lang="en">A change in behaviour occurring before a loss event because of insurance coverage, such as reduced investment in preventive health behaviours.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Pre-Loss Moral Hazard</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Preventive Moral Hazard</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Ex Ante Moral Hazard</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/ex-post-moral-hazard"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/ex-ante-moral-hazard"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/moral-hazard"/>
        <dcterms:identifier>HEO-L-f68aa8ac511b</dcterms:identifier>
        <linkRationale xml:lang="en">Ex ante moral hazard is a kind of moral hazard</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/ex-ante-moral-hazard"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/ex-post-moral-hazard"/>
        <dcterms:identifier>HEO-L-946186824d9b</dcterms:identifier>
        <linkRationale xml:lang="en">Behaviour before the loss versus use after it are the two forms of moral hazard</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/ex-post-evaluation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/ex-post-evaluation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-evaluation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/economic-evaluation"/>
        <skos:notation>HE-EE-EM-002</skos:notation>
        <dcterms:identifier>HE-EE-EM-002</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Ex-Post Evaluation</rdfs:label>
        <skos:definition xml:lang="en">An economic evaluation conducted after an intervention has been implemented, using observed data on its actual costs and outcomes.</skos:definition>
        <skos:hiddenLabel xml:lang="en">After-Implementation Evaluation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Outcome-Based Evaluation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Ex-Post Evaluation</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/real-world-data"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/ex-post-evaluation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-evaluation"/>
        <dcterms:identifier>HEO-L-ec0a4f39c0f7</dcterms:identifier>
        <linkRationale xml:lang="en">Ex-post evaluation is an economic evaluation</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/ex-post-evaluation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
