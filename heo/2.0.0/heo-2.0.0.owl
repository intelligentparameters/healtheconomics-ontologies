    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/budget-impact">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/budget-impact-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/budget-impact-analysis"/>
        <skos:notation>HE-EE-BIA-011</skos:notation>
        <dcterms:identifier>HE-EE-BIA-011</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Sullivan et al. 2014</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Budget Impact</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Budgetary Impact</skos:altLabel>
        <skos:definition xml:lang="en">Budget impact is the change in spending a budget holder can expect from adopting a health technology or policy, estimated by budget impact analysis.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Spending Impact</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Budget Impact</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/coverage-decision"/>
