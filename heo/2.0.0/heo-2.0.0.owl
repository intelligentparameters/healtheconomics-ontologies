    <!-- https://healtheconomics.wiki/concept/safety-signal -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/safety-signal">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-development"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/drug-development"/>
        <precedes rdf:resource="https://healtheconomics.wiki/concept/safety-review"/>
        <skos:notation>HE-PE-DD-066</skos:notation>
