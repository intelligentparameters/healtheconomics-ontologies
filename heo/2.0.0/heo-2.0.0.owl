    <!-- https://healtheconomics.wiki/concept/opportunity-loss -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/opportunity-loss">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/value-of-information"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q2472132"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/value-of-information"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/evpi"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/expected-loss"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/value-of-information"/>
        <skos:notation>HE-EM-VI-021</skos:notation>
        <dcterms:identifier>HE-EM-VI-021</dcterms:identifier>
        <dcterms:source>Raiffa &amp; Schlaifer 1961</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Opportunity Loss</rdfs:label>
        <skos:definition xml:lang="en">The difference in value between the outcome of the optimal decision and the outcome of the decision actually made under uncertainty.</skos:definition>
        <skos:hiddenLabel xml:lang="en">EOL</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Loss from Wrong Decision</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Opportunity Loss</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-11"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/opportunity-loss"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/value-of-information"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-6ee56e8ba965</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Value of information in subdomain Economic Modelling; placed under Value of Information, the concept named by its wiki topic</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/opportunity-loss"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evpi"/>
        <dcterms:identifier>HEO-L-b1ce64cdd8fd</dcterms:identifier>
        <linkRationale xml:lang="en">EVPI equals the expected opportunity loss of the current decision</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
