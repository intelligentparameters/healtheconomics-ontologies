        <dcterms:source>Brealey, Myers &amp; Allen 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Working Capital</rdfs:label>
        <skos:definition xml:lang="en">The difference between an organisation&apos;s current assets and current liabilities, representing the resources available to fund day-to-day operations.</skos:definition>
        <skos:prefLabel xml:lang="en">Working Capital</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/cash-budget"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/financial-management"/>
