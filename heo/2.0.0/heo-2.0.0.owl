        <dcterms:source>Delbecq &amp; Van de Ven 1971</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Nominal Group Technique</rdfs:label>
        <skos:altLabel xml:lang="en">NGT</skos:altLabel>
        <skos:definition xml:lang="en">A structured method eliciting and prioritising group ideas through individual silent generation followed by structured discussion and ranked voting.</skos:definition>
