        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Waiting-Line Model</skos:altLabel>
        <skos:definition xml:lang="en">A queuing model is a mathematical representation of how arrivals, service times, capacity, and service rules generate waiting, congestion, and throughput in a service system.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Queue Simulation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Queuing Model</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-7"/>
