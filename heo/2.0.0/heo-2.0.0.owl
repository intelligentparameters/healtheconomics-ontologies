        <dcterms:identifier>HS-HP-PP-081</dcterms:identifier>
        <dcterms:source>Fetter et al. 1980</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Prospective Payment</rdfs:label>
        <skos:altLabel xml:lang="en">PPS</skos:altLabel>
        <skos:definition xml:lang="en">A methodology establishing a fixed reimbursement in advance of care delivery, based on diagnosis or procedure type, rather than actual incurred costs.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Fixed Prospective Rate</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Prospective Payment</skos:prefLabel>
        <abbreviation xml:lang="en">PPS</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/retrospective-payment"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/diagnosis-related-group"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/healthcare-resource-group"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/prospective-payment"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <dcterms:identifier>HEO-L-94e403d913ff</dcterms:identifier>
        <linkRationale xml:lang="en">Prospective payment is a provider payment method.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
