    <!-- https://healtheconomics.wiki/concept/transition-matrix -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/transition-matrix">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/markov-model"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q176583"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/markov-model"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/markov-chain"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/markov-model"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/cohort-trace"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/steady-state"/>
        <skos:notation>HE-EM-MM-027</skos:notation>
        <dcterms:identifier>HE-EM-MM-027</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Sonnenberg &amp; Beck 1993</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Transition Matrix</rdfs:label>
        <owl:versionInfo>1.0.3</owl:versionInfo>
        <skos:definition xml:lang="en">A transition matrix is the table of probabilities of moving between, or staying in, health states in one cycle of a Markov model, with rows summing to one.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Markov Transition Table</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Probability Matrix</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Transition Matrix</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
