    <!-- https://healtheconomics.wiki/concept/nocebo-effect -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/nocebo-effect">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1332954"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:notation>HE-ES-CTM-054</skos:notation>
        <dcterms:identifier>HE-ES-CTM-054</dcterms:identifier>
        <dcterms:source>Barsky et al. 2002</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Nocebo Effect</rdfs:label>
        <skos:altLabel xml:lang="en">Nocebo Response</skos:altLabel>
        <skos:definition xml:lang="en">A phenomenon in which a patient experiences a harmful outcome purely from their expectation of harm, rather than any pharmacological effect.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Negative Expectation Effect</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Nocebo Effect</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/placebo-effect"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/adverse-event"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/nocebo-effect"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-6d60c30fdf95</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Evidence Synthesis &gt; Clinical Trial Methods: catalogue subdomain Evidence Synthesis is one of the subdomains</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/nocebo-effect"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
