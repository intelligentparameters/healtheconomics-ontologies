        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Urgent Care</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Urgent care is same-day treatment for illness or injury that needs prompt attention but is not an emergency, often given outside an emergency department.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Same-Day Care</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Urgent Treatment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Urgent Care</skos:prefLabel>
