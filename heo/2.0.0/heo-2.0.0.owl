        <dcterms:source>WHO 2001</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Functional Status</rdfs:label>
        <skos:definition xml:lang="en">A measure of an individual&apos;s ability to perform physical, cognitive, and social activities relevant to independent living.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Functional Ability</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Functional Health</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Functional Status</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/functional-status"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-f338df4843b9</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Population Health Outcomes: health and functional status are outcome measures</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/functional-status"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-status"/>
        <dcterms:identifier>HEO-L-213f64224833</dcterms:identifier>
        <linkRationale xml:lang="en">Functional status is one dimension of overall health status (both definitions)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
