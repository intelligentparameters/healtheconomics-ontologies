        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Flexible Parametric Survival Model</skos:altLabel>
        <skos:altLabel xml:lang="en">RP Spline Model</skos:altLabel>
        <skos:definition xml:lang="en">A class of flexible parametric survival models using restricted cubic splines to represent a transformed survival or hazard function while remaining fully parametric.</skos:definition>
        <skos:prefLabel xml:lang="en">Royston-Parmar Model</skos:prefLabel>
        <abbreviation xml:lang="en">RP Spline Model</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/cox-proportional-hazards"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-5"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/parametric-survival"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/restricted-cubic-spline"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/royston-parmar-model"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/flexible-parametric-model"/>
        <dcterms:identifier>HEO-L-dc1cebe9a38f</dcterms:identifier>
        <linkRationale xml:lang="en">Royston-Parmar is the standard flexible parametric model.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
