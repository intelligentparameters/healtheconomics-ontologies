        <skos:hiddenLabel xml:lang="en">Shared-Savings Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Accountable Care</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
