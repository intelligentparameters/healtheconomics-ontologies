        <skos:hiddenLabel xml:lang="en">Profit Ratio</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Profitability Ratio</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/liquidity-ratio"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
