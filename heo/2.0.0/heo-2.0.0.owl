        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/treatment-gap"/>
        <dcterms:identifier>HEO-L-35b992f04103</dcterms:identifier>
        <linkRationale xml:lang="en">Stigma is a recognised driver of the gap between need and treatment, especially in mental health</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
