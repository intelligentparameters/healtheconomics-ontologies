    <!-- https://healtheconomics.wiki/concept/experience-rating -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/experience-rating">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/risk-rating"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/risk-rating"/>
        <skos:notation>HS-HP-HI-079</skos:notation>
        <dcterms:identifier>HS-HP-HI-079</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563?643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Experience Rating</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A method setting premiums based on the actual historical claims experience of a specific individual or group, rather than a community average.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Claims-Based Rating</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Experience-Based Premiums</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Experience Rating</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-systems#step-2"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/premium"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
