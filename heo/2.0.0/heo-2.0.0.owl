    <!-- https://healtheconomics.wiki/concept/rehabilitation-economics -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/rehabilitation-economics">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
