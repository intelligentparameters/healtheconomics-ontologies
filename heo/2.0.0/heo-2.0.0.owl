    <!-- https://healtheconomics.wiki/concept/self-insurance -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/self-insurance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/risk-retention"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q4406896"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/risk-retention"/>
        <skos:notation>HS-HP-HI-176</skos:notation>
        <dcterms:identifier>HS-HP-HI-176</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Self-Insurance</rdfs:label>
        <skos:definition xml:lang="en">An arrangement where an organisation retains financial responsibility for its own risk, such as employee healthcare claims, rather than transferring it.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Own-Risk Retention</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Self-Insured Arrangement</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Self-Insurance</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/risk-transfer"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/stop-loss"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/self-insurance"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/risk-retention"/>
        <dcterms:identifier>HEO-L-afc73360f594</dcterms:identifier>
        <linkRationale xml:lang="en">Retaining one&apos;s own risk is risk retention.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/self-insurance"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/risk-transfer"/>
        <dcterms:identifier>HEO-L-9c70bc3a89f5</dcterms:identifier>
        <linkRationale xml:lang="en">Retaining risk contrasts with shifting it to another party.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
