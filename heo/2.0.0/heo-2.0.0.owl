    <!-- https://healtheconomics.wiki/concept/incremental-effectiveness -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/incremental-effectiveness">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/icer"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/incremental-cost-utility-ratio"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/incremental-net-monetary-benefit"/>
        <skos:notation>HE-EE-CEA-070</skos:notation>
        <dcterms:identifier>HE-EE-CEA-070</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Drummond et al. 2015 | NICE PMG36 | NICE Economic evaluation | CADTH Guidelines 4th edition | Second Panel on Cost-Effectiveness in Health and Medicine | CHEERS 2022</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Incremental Effectiveness</rdfs:label>
        <owl:versionInfo>1.2.1</owl:versionInfo>
        <skos:definition xml:lang="en">Incremental effectiveness is the difference in health outcomes between an intervention and its comparator, calculated in a consistent outcome unit and comparison direction.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Additional Effectiveness</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Incremental Health Gain</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Incremental Effectiveness</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-3"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/incremental-effectiveness"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-effectiveness-analysis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-9fff83c45e8e</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Cost effectiveness analysis in subdomain Economic Evaluation; placed under Cost-Effectiveness Analysis, the concept named by its wiki topic</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/incremental-effectiveness"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
