    <!-- https://healtheconomics.wiki/concept/process-quality-indicator -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/process-quality-indicator">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/process-measure"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/process-measure"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/process-quality"/>
        <skos:notation>HS-NHS-HQ-060</skos:notation>
        <dcterms:identifier>HS-NHS-HQ-060</dcterms:identifier>
        <dcterms:source>Donabedian A. Evaluating the quality of medical care. Milbank Memorial Fund Quarterly. 1966;44(3):166-206. doi:10.2307/3348969.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Process Quality Indicator</rdfs:label>
        <skos:altLabel xml:lang="en">Process-of-Care Indicator</skos:altLabel>
        <skos:definition xml:lang="en">A measurable metric assessing whether recommended, evidence-based care steps were actually delivered to eligible patients, such as preventive screening rates.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Process Quality Metric</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Process Quality Indicator</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
