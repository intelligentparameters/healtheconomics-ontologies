        <skos:prefLabel xml:lang="en">Personal Health Record</skos:prefLabel>
        <abbreviation xml:lang="en">PHR</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/electronic-health-record"/>
