        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/incidence"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1106825"/>
