        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Blood Incompatibility</rdfs:label>
        <skos:definition xml:lang="en">A serious, generally preventable safety event where a patient receives a transfusion incompatible with their blood type, risking severe immune reaction.</skos:definition>
        <skos:hiddenLabel xml:lang="en">ABO Incompatibility</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Transfusion Incompatibility</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Blood Incompatibility</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
