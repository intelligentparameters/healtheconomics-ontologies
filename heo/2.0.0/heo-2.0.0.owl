        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/cohort-design -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cohort-design">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/observational-study"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/observational-study"/>
        <skos:notation>HE-ES-CTM-016</skos:notation>
        <dcterms:identifier>HE-ES-CTM-016</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-09</dcterms:modified>
        <dcterms:source>Vandenbroucke et al. 2007</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cohort Design</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Cohort Study Design</skos:altLabel>
        <skos:definition xml:lang="en">A cohort design is an observational study that follows people grouped by exposure or treatment forward from a common start to compare later outcomes.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Prospective Design</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cohort Design</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/randomised-controlled-trial"/>
