        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">DFBETAS</rdfs:label>
        <skos:altLabel xml:lang="en">Standardised DFBETA</skos:altLabel>
        <skos:definition xml:lang="en">A standardised version of the DFBETA diagnostic, scaled by its standard error, allowing influence of observations to be compared consistently across models.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Scaled Coefficient Change</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">DFBETAS</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
