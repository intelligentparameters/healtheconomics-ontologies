    <!-- https://healtheconomics.wiki/concept/network-adequacy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/network-adequacy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:notation>HS-HP-HI-123</skos:notation>
        <dcterms:identifier>HS-HP-HI-123</dcterms:identifier>
        <dcterms:source>Kongstvedt 2012</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Network Adequacy</rdfs:label>
        <skos:definition xml:lang="en">A regulatory standard requiring a plan&apos;s provider network include enough providers, within reasonable distance and wait time, to meet enrollee needs.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Adequate Provider Access</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Network Sufficiency</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Network Adequacy</skos:prefLabel>
        <benchmarkFor rdf:resource="https://healtheconomics.wiki/concept/narrow-network"/>
        <benchmarkFor rdf:resource="https://healtheconomics.wiki/concept/provider-network"/>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/access-to-care"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
