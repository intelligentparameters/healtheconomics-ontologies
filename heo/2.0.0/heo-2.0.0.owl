        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Pharmacovigilance</rdfs:label>
        <skos:altLabel xml:lang="en">Drug Safety Monitoring</skos:altLabel>
        <skos:definition xml:lang="en">The science and activities relating to detecting, assessing, understanding, and preventing adverse effects of a medicine throughout its entire lifecycle.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Safety Surveillance</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Pharmacovigilance</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/adverse-drug-reaction"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/medication-safety"/>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/safety"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/black-box-warning"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/safety-signal"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/case-report"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/post-marketing-surveillance"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/pharmacovigilance"/>
