        <skos:notation>HE-EM-UA-023</skos:notation>
        <dcterms:identifier>HE-EM-UA-023</dcterms:identifier>
        <dcterms:source>Saltelli et al. 2008</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Factor Prioritisation</rdfs:label>
        <skos:definition xml:lang="en">A global sensitivity analysis technique ranking input parameters by how much of a model&apos;s output variance each is responsible for.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Parameter Importance Ranking</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Variance-Based Ranking</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Factor Prioritisation</skos:prefLabel>
        <counterpartOf rdf:resource="https://healtheconomics.wiki/concept/evppi"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/sobol-indices"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/factor-prioritisation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/global-sensitivity-analysis"/>
        <dcterms:identifier>HEO-L-ebdcc4371465</dcterms:identifier>
        <linkRationale xml:lang="en">Factor prioritisation is a GSA setting</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/factor-prioritisation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#counterpartOf"/>
