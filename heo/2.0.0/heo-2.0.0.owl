        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Price Monitoring</rdfs:label>
        <skos:definition xml:lang="en">The ongoing tracking of a drug&apos;s price over time and across markets, used to assess trends and inform policy or negotiation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Price Surveillance</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Price Tracking</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Price Monitoring</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/price-negotiation"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/pricing-policy"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
