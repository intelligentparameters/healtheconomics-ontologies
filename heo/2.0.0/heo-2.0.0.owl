    <!-- https://healtheconomics.wiki/concept/monitoring-cost -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/monitoring-cost">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/direct-cost"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/direct-cost"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/drug-cost"/>
        <skos:notation>HS-DC-DMS-002</skos:notation>
        <dcterms:identifier>HS-DC-DMS-002</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Monitoring Cost</rdfs:label>
        <skos:definition xml:lang="en">The expense of tracking a patient&apos;s treatment response and screening for adverse effects, covering laboratory tests, imaging, and clinical visits.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Drug Monitoring Expense</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Surveillance Cost</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Monitoring Cost</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
