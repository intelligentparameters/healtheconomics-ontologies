    <!-- https://healtheconomics.wiki/concept/confounding-by-aggregation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/confounding-by-aggregation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/confounding"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/ecological-bias"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/confounding"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/ecological-bias"/>
        <skos:notation>HE-DS-BV-007</skos:notation>
        <dcterms:identifier>HE-DS-BV-007</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Greenland &amp; Morgenstern 1989</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Confounding by Aggregation</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Confounding by aggregation is bias when group-level data, such as regional or trial averages, mix differences between groups into an exposure&apos;s effect.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Aggregation Confounding</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Group-Level Confounding</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Confounding by Aggregation</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/effect-modification"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/simpson-paradox"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/confounding-by-aggregation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
