    <!-- https://healtheconomics.wiki/concept/positive-externality -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/positive-externality">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/externality"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/externality"/>
        <skos:notation>HE-EE-ME-051</skos:notation>
        <dcterms:identifier>HE-EE-ME-051</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Pigou 1920</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Positive Externality</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">External Benefit</skos:altLabel>
        <skos:definition xml:lang="en">A benefit conferred on a third party by an economic activity, not reflected in its market price, leading to underproduction relative to the social optimum.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Beneficial Spillover</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Positive Externality</skos:prefLabel>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/positive-externality"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/externality"/>
        <dcterms:identifier>HEO-L-bff311795044</dcterms:identifier>
        <linkRationale xml:lang="en">A positive externality is a kind of externality</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/positive-feedback -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/positive-feedback">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/feedback-loop"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/feedback-loop"/>
        <skos:notation>HE-EM-DM-081</skos:notation>
        <dcterms:identifier>HE-EM-DM-081</dcterms:identifier>
        <dcterms:source>Sterman 2000</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Positive Feedback</rdfs:label>
        <skos:altLabel xml:lang="en">Reinforcing Loop</skos:altLabel>
        <skos:definition xml:lang="en">A causal relationship in which a change in one variable triggers effects that reinforce the original change, tending to accelerate the system&apos;s trajectory.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Amplifying Feedback</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Positive Feedback</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/positive-feedback"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/feedback-loop"/>
        <dcterms:identifier>HEO-L-b1ac332f8c99</dcterms:identifier>
        <linkRationale xml:lang="en">Positive feedback is a reinforcing feedback loop</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/positive-likelihood-ratio -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/positive-likelihood-ratio">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/likelihood-ratio"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/likelihood-ratio"/>
        <skos:notation>HE-ES-RM-022</skos:notation>
        <dcterms:identifier>HE-ES-RM-022</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Sackett et al. 1991</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Positive Likelihood Ratio</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">LR+</skos:altLabel>
        <skos:altLabel xml:lang="en">Positive LR</skos:altLabel>
        <skos:definition xml:lang="en">A diagnostic test measure expressing how much a positive result increases the odds that a patient truly has the condition tested for.</skos:definition>
        <skos:prefLabel xml:lang="en">Positive Likelihood Ratio</skos:prefLabel>
        <abbreviation xml:lang="en">LR+</abbreviation>
        <abbreviation xml:lang="en">Positive LR</abbreviation>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/positive-likelihood-ratio"/>
