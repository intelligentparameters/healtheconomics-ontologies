        <skos:altLabel xml:lang="en">BIA</skos:altLabel>
        <skos:altLabel xml:lang="en">Budget Impact Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Budget impact analysis (BIA) estimates how adopting a new health technology would change spending for a particular budget holder over the next few years.</skos:definition>
        <skos:prefLabel xml:lang="en">Budget Impact Analysis</skos:prefLabel>
        <abbreviation xml:lang="en">BIA</abbreviation>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-6"/>
