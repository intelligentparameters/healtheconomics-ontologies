    <!-- https://healtheconomics.wiki/concept/central-limit-theorem -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/central-limit-theorem">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <skos:notation>HE-ES-SA-022</skos:notation>
        <dcterms:identifier>HE-ES-SA-022</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-09</dcterms:modified>
        <dcterms:source>Briggs et al. 2012</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Central Limit Theorem</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">CLT</skos:altLabel>
        <skos:definition xml:lang="en">The central limit theorem states that the mean of many independent observations with finite variance is approximately normal, whatever their distribution.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Central Limit Law</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Central Limit Theorem</skos:prefLabel>
        <abbreviation xml:lang="en">CLT</abbreviation>
        <assumes rdf:resource="https://healtheconomics.wiki/concept/variance"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/psa"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/asymptotic-normality"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/confidence-interval"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/central-limit-theorem"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-47ae065390e3</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Statistical methods in subdomain Evidence Synthesis; placed under Statistical Method, the concept named by its wiki topic</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/central-limit-theorem"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#assumes"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/variance"/>
        <dcterms:identifier>HEO-L-fcf0d8ee8654</dcterms:identifier>
