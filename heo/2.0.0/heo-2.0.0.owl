        <dcterms:identifier>HE-PE-DF-001</dcterms:identifier>
        <dcterms:source>Rowland &amp; Tozer 2010</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Dosage Form</rdfs:label>
        <skos:definition xml:lang="en">The physical form in which a drug product is manufactured and given to a patient, such as a tablet, capsule, injection, or patch.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Drug Form</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Pharmaceutical Presentation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Dosage Form</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/administration-cost"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/medicinal-product"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/dosage-form"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-c7acddb90539</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Economics &gt; Pharmacoeconomics &gt; Drug Formulation: dosage forms and routes are set in development and licensing (Drug development and regulation)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/dosage-form"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/administration-cost"/>
        <dcterms:identifier>HEO-L-7735319916df</dcterms:identifier>
        <linkRationale xml:lang="en">Tablet versus injection or infusion drives administration cost (Treatment Administration Cost varies by route).</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
