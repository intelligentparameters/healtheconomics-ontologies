    <!-- https://healtheconomics.wiki/concept/volume-based-pricing -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/volume-based-pricing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:notation>HS-DC-DP-108</skos:notation>
        <dcterms:identifier>HS-DC-DP-108</dcterms:identifier>
        <dcterms:source>Carlson JJ, Sullivan SD, Garrison LP, Neumann PJ, Veenstra DL. Linking payment to health outcomes: a taxonomy and examination of performance-based reimbursement schemes. Health Policy. 2010;96(3):179-190.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Volume-Based Pricing</rdfs:label>
        <skos:definition xml:lang="en">A pricing structure where the price paid per unit depends on total quantity purchased or used, typically decreasing as volume increases.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Quantity-Based Pricing</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Volume Pricing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Volume-Based Pricing</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/value-based-pricing"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/volume-based-pricing"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <dcterms:identifier>HEO-L-f9c7cae261f9</dcterms:identifier>
        <linkRationale xml:lang="en">It is drug pricing.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/volume-based-pricing"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/value-based-pricing"/>
        <dcterms:identifier>HEO-L-8bfece6a1e5c</dcterms:identifier>
        <linkRationale xml:lang="en">Volume-based and value-based pricing are alternative pricing bases.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
