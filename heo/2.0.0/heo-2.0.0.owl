    <!-- https://healtheconomics.wiki/concept/survivorship -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/survivorship">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:notation>HE-PE-OP-011</skos:notation>
        <dcterms:identifier>HE-PE-OP-011</dcterms:identifier>
        <dcterms:source>DeVita, Lawrence &amp; Rosenberg 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Survivorship</rdfs:label>
        <skos:altLabel xml:lang="en">Cancer Survivor</skos:altLabel>
        <skos:definition xml:lang="en">The state of living with, through, and beyond a cancer diagnosis, covering the period from diagnosis onward regardless of ongoing treatment.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Life After Cancer</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Post-Treatment Patient</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Post-Treatment Phase</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Survivorship</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <setsScopeOf rdf:resource="https://healtheconomics.wiki/concept/survivorship-care"/>
    </owl:NamedIndividual>
