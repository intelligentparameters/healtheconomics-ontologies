    <!-- https://healtheconomics.wiki/concept/black-box-warning -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/black-box-warning">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-development"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q879952"/>
