        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/target-validation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-development"/>
