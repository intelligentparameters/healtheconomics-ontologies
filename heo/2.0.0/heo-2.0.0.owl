        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Influential Observation</rdfs:label>
        <skos:altLabel xml:lang="en">Influential Point</skos:altLabel>
        <skos:definition xml:lang="en">A data point that, if removed, would substantially change a statistical analysis&apos;s results, such as a regression model&apos;s estimated coefficients.</skos:definition>
