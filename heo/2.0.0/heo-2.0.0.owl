    <!-- https://healtheconomics.wiki/concept/confirmatory-factor-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/confirmatory-factor-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
