    <!-- https://healtheconomics.wiki/concept/underuse -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/underuse">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <skos:notation>HS-NHS-HQ-082</skos:notation>
        <dcterms:identifier>HS-NHS-HQ-082</dcterms:identifier>
        <dcterms:source>Chassin &amp; Galvin 1998</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Underuse</rdfs:label>
        <skos:altLabel xml:lang="en">Underutilisation</skos:altLabel>
        <skos:definition xml:lang="en">The failure to provide a service that would have produced a favourable outcome, representing a missed opportunity for beneficial care.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Missed Effective Care</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Underuse</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/clinical-practice-variation"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/quality-gap"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/unmet-need"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/underuse"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-e34c413c5b5a</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; NHS Productivity &gt; Healthcare Quality: wiki topic Performance, productivity and quality sits in Health Systems; placed under Quality of Care, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/underuse"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/clinical-practice-variation"/>
        <dcterms:identifier>HEO-L-92ed1edda3b4</dcterms:identifier>
        <linkRationale xml:lang="en">Variation is the observed pattern; underuse is one cause of unwarranted variation (Wennberg 2010)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
