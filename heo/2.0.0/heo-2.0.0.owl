    <!-- https://healtheconomics.wiki/concept/price-parity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/price-parity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/price-linkage"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/price-linkage"/>
        <skos:notation>HS-DC-DP-071</skos:notation>
        <dcterms:identifier>HS-DC-DP-071</dcterms:identifier>
        <dcterms:source>Danzon 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Price Parity</rdfs:label>
        <skos:definition xml:lang="en">A contractual or policy requirement ensuring a drug&apos;s price in one market does not exceed, or fall below, its price elsewhere.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cross-Market Price Equality</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Uniform Pricing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Price Parity</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/differential-pricing"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/price-parity"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/price-linkage"/>
        <dcterms:identifier>HEO-L-6a493b15cef5</dcterms:identifier>
        <linkRationale xml:lang="en">Price parity links a price to prices elsewhere, a form of price linkage</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/price-parity"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/differential-pricing"/>
        <dcterms:identifier>HEO-L-edce9cd2eff0</dcterms:identifier>
        <linkRationale xml:lang="en">Equal prices across markets versus different prices by market.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/price-premium -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/price-premium">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:notation>HS-DC-DP-072</skos:notation>
        <dcterms:identifier>HS-DC-DP-072</dcterms:identifier>
        <dcterms:source>Danzon 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Price Premium</rdfs:label>
        <skos:definition xml:lang="en">The additional amount a manufacturer charges for a treatment relative to an existing comparator, reflecting the treatment&apos;s demonstrated incremental clinical benefit.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Pricing Premium</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Value Premium</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Price Premium</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/incremental-cost"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/price-premium"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-01ce865755c8</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Drug Costs &gt; Drug Pricing: wiki topic Pricing and market access sits in Health Policy; placed under Drug Pricing, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/price-premium"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/incremental-cost"/>
        <dcterms:identifier>HEO-L-d73930646eea</dcterms:identifier>
        <linkRationale xml:lang="en">A price premium is charged relative to the existing comparator (subject definition); it raises cost versus that comparator</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/price-protection -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/price-protection">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:notation>HS-DC-DP-073</skos:notation>
        <dcterms:identifier>HS-DC-DP-073</dcterms:identifier>
        <dcterms:source>Danzon 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Price Protection</rdfs:label>
        <skos:definition xml:lang="en">A contractual clause limiting or preventing future price increases beyond an agreed threshold for a specified period, giving payers cost certainty.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Price Guarantee</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Price-Increase Cap</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Price Protection</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/price-growth"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/price-revision"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/rebate"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/price-protection"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-d52ad51fc542</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Drug Costs &gt; Drug Pricing: wiki topic Pricing and market access sits in Health Policy; placed under Drug Pricing, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/price-protection"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/price-growth"/>
        <dcterms:identifier>HEO-L-c9c2ebfda2df</dcterms:identifier>
        <linkRationale xml:lang="en">Limits future price increases for a set period.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
