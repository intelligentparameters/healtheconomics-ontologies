    <!-- https://healtheconomics.wiki/concept/peer-review -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/peer-review">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <skos:notation>HS-NHS-HQ-054</skos:notation>
        <dcterms:identifier>HS-NHS-HQ-054</dcterms:identifier>
        <dcterms:source>Donabedian A. Evaluating the quality of medical care. Milbank Memorial Fund Quarterly. 1966;44(3):166-206. doi:10.2307/3348969.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Peer Review</rdfs:label>
        <skos:altLabel xml:lang="en">Refereeing</skos:altLabel>
        <skos:definition xml:lang="en">A process in which providers evaluate the quality of care delivered by professional colleagues, for improvement, credentialing, or disciplinary purposes.</skos:definition>
        <skos:prefLabel xml:lang="en">Peer Review</skos:prefLabel>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/peer-review"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-edd329b0e39e</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; NHS Productivity &gt; Healthcare Quality: wiki topic Performance, productivity and quality sits in Health Systems; placed under Quality of Care, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/peer-review"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#evaluates"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <dcterms:identifier>HEO-L-bb7e6cc04a47</dcterms:identifier>
        <linkRationale xml:lang="en">Only link; the object is model quality assurance, while the subject definition is clinical peer review of care quality</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/peer-review-hta -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/peer-review-hta">
