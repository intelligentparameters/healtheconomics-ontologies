    <!-- https://healtheconomics.wiki/concept/present-value -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/present-value">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/discounting"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1100466"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/discounting"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/benefit-cost-ratio"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/net-present-value"/>
        <skos:notation>HE-EE-DC-011</skos:notation>
        <dcterms:identifier>HE-EE-DC-011</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Brealey, Myers &amp; Allen 2019</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Present Value</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Discounted Value</skos:altLabel>
        <skos:altLabel xml:lang="en">Present Worth</skos:altLabel>
        <skos:definition xml:lang="en">The current worth of a future sum of money or cash flow stream, found by discounting each future amount using a specified discount rate.</skos:definition>
        <skos:prefLabel xml:lang="en">Present Value</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-2"/>
