    <!-- https://healtheconomics.wiki/concept/health-production-function -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/health-production-function">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/demand-for-health"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/demand-for-health"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/grossman-model"/>
        <skos:notation>HE-EE-EPR-017</skos:notation>
        <dcterms:identifier>HE-EE-EPR-017</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-03</dcterms:modified>
        <dcterms:source>Grossman 2000</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Health Production Function</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">A health production function shows how medical care, other market goods and own time produce health, with education raising efficiency (Grossman model).</skos:definition>
        <skos:hiddenLabel xml:lang="en">Health Output Function</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Production of Health</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Health Production Function</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/healthcare-production-function"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/derived-demand-for-healthcare"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/health"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/health-behaviour"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/health-investment"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/health-production-function"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/demand-for-health"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-dc9a3539b6f5</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: curated: demand-for-health theory (Grossman), filed with Demand for Health, review B</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/health-production-function"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/grossman-model"/>
        <dcterms:identifier>HEO-L-d5edc6a60fb1</dcterms:identifier>
        <linkRationale xml:lang="en">The health production function is a component equation of the Grossman model</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/health-production-function"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/healthcare-production-function"/>
        <dcterms:identifier>HEO-L-d81907546ecf</dcterms:identifier>
        <linkRationale xml:lang="en">Grossman distinguishes producing health from producing care; keep this direction of the symmetric pair.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/health-production-function"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isFoundationFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/derived-demand-for-healthcare"/>
        <dcterms:identifier>HEO-L-15526d709681</dcterms:identifier>
        <linkRationale xml:lang="en">Derived demand rests on care being an input to the health production function.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/health-production-function"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#produces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health"/>
        <dcterms:identifier>HEO-L-e711cea8c6ea</dcterms:identifier>
        <linkRationale xml:lang="en">Grossman production function yields health as output; health is the basic object of the discipline.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
