        <skos:notation>HS-HP-HI-096</skos:notation>
        <dcterms:identifier>HS-HP-HI-096</dcterms:identifier>
        <dcterms:source>US, Internal Revenue Code Section 125</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Health Reimbursement Arrangement</rdfs:label>
        <skos:altLabel xml:lang="en">HRA</skos:altLabel>
        <skos:definition xml:lang="en">A US employer-funded account reimbursing employees for qualified medical expenses tax-free, with unused funds typically staying with the employer.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Employer Health Account</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Health Reimbursement Arrangement</skos:prefLabel>
        <abbreviation xml:lang="en">HRA</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/health-savings-account"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/cost-sharing"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/health-reimbursement-arrangement"/>
