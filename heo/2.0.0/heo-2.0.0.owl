    <!-- https://healtheconomics.wiki/concept/15d -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/15d">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/utility-based-measure"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/utility-based-measure"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/health-related-quality-of-life"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/health-state-utility-value"/>
        <skos:notation>HE-EE-HU-001</skos:notation>
        <dcterms:identifier>HE-EE-HU-001</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Sintonen 2001</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">15D</rdfs:label>
        <owl:versionInfo>1.0.5</owl:versionInfo>
        <skos:altLabel xml:lang="en">15-D</skos:altLabel>
        <skos:altLabel xml:lang="en">15-Dimensional Instrument</skos:altLabel>
        <skos:definition xml:lang="en">A generic, multi-attribute quality of life instrument measuring fifteen health dimensions, each scored on five levels, combined into a single utility index.</skos:definition>
        <skos:prefLabel xml:lang="en">15D</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/eq-5d"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/outcomes#step-2"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/15d"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/utility-based-measure"/>
        <dcterms:identifier>HEO-L-d15cbc29e763</dcterms:identifier>
        <linkRationale xml:lang="en">15D yields a single utility index from preference weights, matching Utility-Based Measure</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/15d"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-related-quality-of-life"/>
        <dcterms:identifier>HEO-L-294252aba221</dcterms:identifier>
        <linkRationale xml:lang="en">15D is a generic HRQoL instrument; its definition lists the health dimensions it quantifies</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/15d"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#measures"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-state-utility-value"/>
