        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">A closed-form analytical method solves a health economic model with a formula, such as a matrix inverse, instead of by simulation or random sampling.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Analytic Solution</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Closed-Form Method</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Closed-Form Analytical Method</skos:prefLabel>
