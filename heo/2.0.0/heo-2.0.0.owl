    <!-- https://healtheconomics.wiki/concept/cost-description -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cost-description">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/partial-economic-evaluation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/partial-economic-evaluation"/>
        <skos:notation>HE-EE-CA-020</skos:notation>
        <dcterms:identifier>HE-EE-CA-020</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cost Description</rdfs:label>
        <skos:definition xml:lang="en">A study that reports the costs associated with a health condition or intervention without comparing them to an alternative or to outcomes.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cost Reporting Study</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Descriptive Costing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cost Description</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/cost-outcome-description"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
