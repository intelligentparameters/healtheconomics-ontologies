    <!-- https://healtheconomics.wiki/concept/precision-therapy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/precision-therapy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/targeted-therapy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/targeted-therapy"/>
        <skos:notation>HE-PE-DT-032</skos:notation>
        <dcterms:identifier>HE-PE-DT-032</dcterms:identifier>
        <dcterms:source>Hamburg &amp; Collins 2010</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Precision Therapy</rdfs:label>
        <skos:definition xml:lang="en">A treatment targeting a specific molecular or genetic feature of a patient&apos;s disease, closely related to personalised therapy but emphasising the biological targeting mechanism.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Biomarker-Directed Therapy</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Molecularly Targeted Treatment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Precision Therapy</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/precision-therapy"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/targeted-therapy"/>
        <dcterms:identifier>HEO-L-2e720b5633e4</dcterms:identifier>
        <linkRationale xml:lang="en">A precision therapy targets a molecular feature of the disease, which is a targeted therapy by definition</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/preclinical-development -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/preclinical-development">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-development"/>
