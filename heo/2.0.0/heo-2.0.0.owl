    <!-- https://healtheconomics.wiki/concept/aggregate-data-meta-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/aggregate-data-meta-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/meta-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/meta-analysis"/>
        <skos:notation>HE-ES-ESM-001</skos:notation>
        <dcterms:identifier>HE-ES-ESM-001</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>DerSimonian R, Laird N. Meta-analysis in clinical trials. Controlled Clinical Trials. 1986;7(3):177?188. doi:10.1016/0197-2456(86)90046-2.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Aggregate Data Meta-Analysis</rdfs:label>
        <owl:versionInfo>1.0.4</owl:versionInfo>
        <skos:altLabel xml:lang="en">AD Meta-Analysis</skos:altLabel>
        <skos:definition xml:lang="en">Aggregate data meta-analysis pools study-level summary results, such as effect estimates and standard errors, from several studies into one estimate.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Summary Data Meta-Analysis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Aggregate Data Meta-Analysis</skos:prefLabel>
        <abbreviation xml:lang="en">AD Meta-Analysis</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/individual-patient-data-meta-analysis"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-4"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/fixed-effect-model"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/heterogeneity-assessment"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/random-effects-model"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/aggregate-data-meta-analysis"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/meta-analysis"/>
        <dcterms:identifier>HEO-L-af3d0e59c1cc</dcterms:identifier>
