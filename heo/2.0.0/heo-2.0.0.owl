    <!-- https://healtheconomics.wiki/concept/trial-population -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/trial-population">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/population"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
