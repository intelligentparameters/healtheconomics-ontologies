        <dcterms:identifier>HEO-L-8071c71e282d</dcterms:identifier>
        <linkRationale xml:lang="en">A time-inhomogeneous model is a Markov model.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
