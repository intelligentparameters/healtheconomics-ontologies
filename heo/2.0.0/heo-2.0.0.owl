    <!-- https://healtheconomics.wiki/concept/ethical-criterion -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/ethical-criterion">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/decision-criteria"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/decision-criteria"/>
        <skos:notation>HS-HP-HTA-077</skos:notation>
        <dcterms:identifier>HS-HP-HTA-077</dcterms:identifier>
        <dcterms:source>Daniels &amp; Sabin 1997</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Ethical Criterion</rdfs:label>
        <skos:altLabel xml:lang="en">Ethics Criterion</skos:altLabel>
        <skos:definition xml:lang="en">A standard reflecting a specific ethical principle, such as fairness or patient autonomy, used to inform an assessment or policy decision.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Ethical Decision Standard</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Ethical Criterion</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/health-technology-assessment"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
