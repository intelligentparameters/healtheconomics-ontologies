    <!-- https://healtheconomics.wiki/concept/cost-adjustment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cost-adjustment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <skos:notation>HE-EE-CA-017</skos:notation>
        <dcterms:identifier>HE-EE-CA-017</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cost Adjustment</rdfs:label>
        <skos:definition xml:lang="en">The process of modifying a cost estimate to allow for inflation, currency differences, or changes in clinical practice, so costs from different periods can be compared.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cost Re-Basing</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Cost Uplift</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cost Adjustment</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/consumer-price-index"/>
    </owl:NamedIndividual>
    <owl:Axiom>
