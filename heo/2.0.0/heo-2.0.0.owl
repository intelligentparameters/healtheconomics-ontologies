    <!-- https://healtheconomics.wiki/concept/evidence-gap -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/evidence-gap">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/uncertainty"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q116797305"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/uncertainty"/>
        <skos:notation>HE-ES-EA-016</skos:notation>
        <dcterms:identifier>HE-ES-EA-016</dcterms:identifier>
        <dcterms:source>Guyatt GH, Oxman AD, Vist GE, et al. GRADE: an emerging consensus on rating quality of evidence and strength of recommendations. BMJ. 2008;336:924-926. doi:10.1136/bmj.39489.470347.AD.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Evidence Gap</rdfs:label>
        <skos:altLabel xml:lang="en">Research Gap</skos:altLabel>
        <skos:definition xml:lang="en">An area of clinical or health economic uncertainty where insufficient or absent research evidence exists to confidently answer a relevant question.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Missing-Evidence Area</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Evidence Gap</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/evidence-gap"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/uncertainty"/>
        <dcterms:identifier>HEO-L-6c384f148ef9</dcterms:identifier>
        <linkRationale xml:lang="en">An evidence gap is uncertainty from missing evidence</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


