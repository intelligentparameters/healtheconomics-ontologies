        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:altLabel xml:lang="en">Digital Healthcare</skos:altLabel>
        <skos:definition xml:lang="en">Digital health is the use of digital technologies, such as apps, wearables, telemedicine and AI, to improve health and the delivery of health care.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Health Digitalisation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">eHealth</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Digital Health</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/universal-health-coverage"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/real-world-data"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/digital-health"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
