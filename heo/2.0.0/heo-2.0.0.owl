        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Patient Flow Model</rdfs:label>
        <skos:definition xml:lang="en">A discrete event simulation or related model representing how patients move through a healthcare facility, capturing waiting times and resource bottlenecks.</skos:definition>
        <skos:hiddenLabel xml:lang="en">DES Patient-Flow Model</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Flow Simulation Model</skos:hiddenLabel>
