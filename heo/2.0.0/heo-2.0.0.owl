        <skos:hiddenLabel xml:lang="en">Health Status Change</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Health Outcome</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
