    <!-- https://healtheconomics.wiki/concept/queuing-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/queuing-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/discrete-event-simulation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/discrete-event-simulation"/>
        <skos:notation>HE-EM-DES-012</skos:notation>
        <dcterms:identifier>HE-EM-DES-012</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Erlang 1909</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
