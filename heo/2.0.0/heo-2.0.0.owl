        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Peripheral Artery Disease</rdfs:label>
        <skos:altLabel xml:lang="en">PAD</skos:altLabel>
