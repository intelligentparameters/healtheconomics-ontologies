    <!-- https://healtheconomics.wiki/concept/determinant-of-health -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/determinant-of-health">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/epidemiology"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/epidemiology"/>
        <skos:notation>HE-ES-EP-050</skos:notation>
        <dcterms:identifier>HE-ES-EP-050</dcterms:identifier>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Determinant of Health</rdfs:label>
        <skos:definition xml:lang="en">In health economics and public health, a factor that influences the health of individuals or populations, spanning behavioural, social, environmental and biological causes, and shaping the burden of disease that interventions and policy aim to reduce.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Factor Influencing Health</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Health Determinant</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Determinant of Health</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/population-health"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
