    <!-- https://healtheconomics.wiki/concept/reinsurance-design -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/reinsurance-design">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
