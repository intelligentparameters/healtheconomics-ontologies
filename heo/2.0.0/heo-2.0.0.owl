    <!-- https://healtheconomics.wiki/concept/durable-response -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/durable-response">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/sustained-outcome"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/tumour-response"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/sustained-outcome"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/tumour-response"/>
        <skos:notation>HE-ES-CO-021</skos:notation>
        <dcterms:identifier>HE-ES-CO-021</dcterms:identifier>
        <dcterms:source>FDA 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Durable Response</rdfs:label>
        <skos:altLabel xml:lang="en">Sustained Response</skos:altLabel>
        <skos:definition xml:lang="en">A treatment response that persists for an extended, clinically meaningful period rather than being followed by rapid relapse or progression.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Lasting Response</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Long-Lasting Response</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Maintained Response</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Prolonged Response</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Durable Response</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/durable-response"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/sustained-outcome"/>
        <dcterms:identifier>HEO-L-3a043a7645b0</dcterms:identifier>
        <linkRationale xml:lang="en">a durable response is an outcome that persists</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/durable-response"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/tumour-response"/>
        <dcterms:identifier>HEO-L-4d5eeecc8863</dcterms:identifier>
        <linkRationale xml:lang="en">a durable response is a lasting tumour response</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/duration-cap -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/duration-cap">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/treatment-capping"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/treatment-capping"/>
        <skos:notation>HS-DC-DP-027</skos:notation>
        <dcterms:identifier>HS-DC-DP-027</dcterms:identifier>
        <dcterms:source>Carlson JJ, Sullivan SD, Garrison LP, Neumann PJ, Veenstra DL. Linking payment to health outcomes: a taxonomy and examination of performance-based reimbursement schemes. Health Policy. 2010;96(3):179-190.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Duration Cap</rdfs:label>
        <skos:definition xml:lang="en">A contractual limit on the number of treatment cycles or the total time for which a payer will reimburse a specific treatment.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cycle Cap</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Reimbursement Time Limit</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Duration Cap</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/drug-cost"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
