        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/horizon-scanning"/>
        <skos:notation>HS-HP-HS-012</skos:notation>
        <dcterms:identifier>HS-HP-HS-012</dcterms:identifier>
        <dcterms:source>Elshaug et al. 2012</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Low-Value Care</rdfs:label>
        <skos:altLabel xml:lang="en">Low-Value Service</skos:altLabel>
        <skos:definition xml:lang="en">Healthcare services providing little or no clinical benefit relative to cost, or carrying harm risk exceeding likely benefit.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Wasteful Care</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Low-Value Care</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/clinical-waste"/>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/overutilization"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/clinical-efficiency"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
