    <!-- https://healtheconomics.wiki/concept/latin-hypercube-sampling -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/latin-hypercube-sampling">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/variance-reduction"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q6496514"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/variance-reduction"/>
        <skos:notation>HE-EM-UA-032</skos:notation>
        <dcterms:identifier>HE-EM-UA-032</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-10-28</dcterms:modified>
        <dcterms:source>McKay, Beckman &amp; Conover 1979</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Latin Hypercube Sampling</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A sampling technique dividing each input&apos;s range into equally probable intervals and sampling each exactly once, giving more even coverage than simple random sampling.</skos:definition>
        <skos:prefLabel xml:lang="en">Latin Hypercube Sampling</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-10"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/latin-hypercube-sampling"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/variance-reduction"/>
        <dcterms:identifier>HEO-L-ec4cde8362cd</dcterms:identifier>
        <linkRationale xml:lang="en">Even coverage lowers MC error</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


