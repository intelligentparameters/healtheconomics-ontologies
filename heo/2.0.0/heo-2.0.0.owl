    <!-- https://healtheconomics.wiki/concept/ambulatory-care -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/ambulatory-care">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
