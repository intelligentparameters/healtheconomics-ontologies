        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">ACER</skos:altLabel>
        <skos:definition xml:lang="en">The average cost-effectiveness ratio (ACER) is an option&apos;s cost per unit of health effect, in total or against doing nothing, without comparing options.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Average Cost-Effectiveness</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Cost-Effectiveness Ratio</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Average Cost-Effectiveness Ratio</skos:prefLabel>
        <abbreviation xml:lang="en">ACER</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/icer"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/marginal-cost-effectiveness"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-3"/>
