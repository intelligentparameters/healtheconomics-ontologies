    <!-- https://healtheconomics.wiki/concept/patient-access -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/patient-access">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/access-to-care"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/access-to-care"/>
        <skos:notation>HS-HP-HE-025</skos:notation>
        <dcterms:identifier>HS-HP-HE-025</dcterms:identifier>
        <dcterms:source>Penchansky R, Thomas JW. The concept of access: definition and relationship to consumer satisfaction. Medical Care. 1981;19(2):127-140. doi:10.1097/00005650-198102000-00001.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Patient Access</rdfs:label>
        <skos:definition xml:lang="en">A general term for patients&apos; ability to obtain needed healthcare services, treatments, or medications, covering the full classical access framework.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Access for Patients</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Patient Care Access</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Patient Access</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/patient-access"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/access-to-care"/>
        <dcterms:identifier>HEO-L-19b322af755b</dcterms:identifier>
        <linkRationale xml:lang="en">Patient access is access to care seen from the patient side</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/patient-access-programme -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/patient-access-programme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
        <skos:notation>HS-DC-DP-059</skos:notation>
        <dcterms:identifier>HS-DC-DP-059</dcterms:identifier>
        <dcterms:source>Carlson JJ, Sullivan SD, Garrison LP, Neumann PJ, Veenstra DL. Linking payment to health outcomes: a taxonomy and examination of performance-based reimbursement schemes. Health Policy. 2010;96(3):179-190.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Patient Access Programme</rdfs:label>
        <skos:altLabel xml:lang="en">PAP</skos:altLabel>
        <skos:definition xml:lang="en">A scheme helping eligible patients afford or obtain a treatment, sometimes involving direct financial assistance, discounted pricing, or expedited coverage.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Access Programme</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Patient Access Programme</skos:prefLabel>
        <abbreviation xml:lang="en">PAP</abbreviation>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/access-barrier"/>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/patient-access"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/patient-access-programme"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/drug-pricing"/>
