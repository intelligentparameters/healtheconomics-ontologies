    <!-- https://healtheconomics.wiki/concept/autoregressive-correlation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/autoregressive-correlation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/working-correlation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/working-correlation"/>
        <skos:notation>HE-ES-SA-008</skos:notation>
        <dcterms:identifier>HE-ES-SA-008</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
