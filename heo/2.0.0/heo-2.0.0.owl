    <!-- https://healtheconomics.wiki/concept/long-term-care-cost -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/long-term-care-cost">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/direct-cost"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/direct-cost"/>
        <skos:notation>HS-DC-HC-010</skos:notation>
        <dcterms:identifier>HS-DC-HC-010</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Long-Term Care Cost</rdfs:label>
        <skos:altLabel xml:lang="en">LTC Cost</skos:altLabel>
        <skos:definition xml:lang="en">The expense of ongoing support services for people with chronic illness, disability, or age-related decline, spanning home-based and residential settings.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Continuing Care Expense</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Long-Term Care Cost</skos:prefLabel>
        <abbreviation xml:lang="en">LTC Cost</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/informal-care-cost"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/long-term-care-cost"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/direct-cost"/>
        <dcterms:identifier>HEO-L-d986731db40b</dcterms:identifier>
        <linkRationale xml:lang="en">Long-term care includes personal and residential support that is not medical care, so Direct Medical Cost is too narrow; it is a direct cost of care</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/long-term-care-cost"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/informal-care-cost"/>
        <dcterms:identifier>HEO-L-b529bf0b2b6e</dcterms:identifier>
        <linkRationale xml:lang="en">Formal paid long-term care versus the value of unpaid care is the standard split in care cost studies</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/long-term-care-economics -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/long-term-care-economics">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
