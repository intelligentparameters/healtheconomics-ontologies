    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/subgroup-cost-effectiveness -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/subgroup-cost-effectiveness">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/icer"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/icer"/>
        <skos:notation>HE-EE-CEA-064</skos:notation>
        <dcterms:identifier>HE-EE-CEA-064</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Subgroup Cost-Effectiveness</rdfs:label>
        <skos:altLabel xml:lang="en">Subgroup CEA</skos:altLabel>
        <skos:definition xml:lang="en">An estimate of an intervention&apos;s ICER calculated for a specific patient subgroup rather than for the overall study population.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Stratified Cost-Effectiveness</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Subgroup Cost-Effectiveness</skos:prefLabel>
        <abbreviation xml:lang="en">Subgroup CEA</abbreviation>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/subgroup-cost-effectiveness"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/icer"/>
        <dcterms:identifier>HEO-L-bbe3c4bd12bd</dcterms:identifier>
        <linkRationale xml:lang="en">The definition calls it an ICER estimate for a subgroup, so a kind of ICER rather than of the analysis.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/subgroup-structure -->

