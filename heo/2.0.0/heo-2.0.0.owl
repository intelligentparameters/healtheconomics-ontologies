    <!-- https://healtheconomics.wiki/concept/cost-variance -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cost-variance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/budget-variance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/budget-variance"/>
        <skos:notation>HE-EE-CA-028</skos:notation>
        <dcterms:identifier>HE-EE-CA-028</dcterms:identifier>
        <dcterms:source>Horngren, Datar &amp; Rajan 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cost Variance</rdfs:label>
        <skos:definition xml:lang="en">The difference between expected and actual cost for a given activity or service, often signalling inefficiency or changing input prices.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Actual-vs-Budget Cost Gap</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Cost Deviation</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cost Variance</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cost-variance"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/budget-variance"/>
        <dcterms:identifier>HEO-L-9249a9271837</dcterms:identifier>
        <linkRationale xml:lang="en">A cost variance is the expected-versus-actual difference on the cost side; budget variance covers budgeted versus actual spending or revenue</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/costs -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/costs">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-economics"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-economics"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/health-economics"/>
        <skos:notation>HE-EE-CA-093</skos:notation>
        <dcterms:identifier>HE-EE-CA-093</dcterms:identifier>
        <dcterms:source>HealthEconomics.wiki subdomain page https://healtheconomics.wiki/subdomain/costs (read 16 Oct 2026)</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Costs</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/subdomain/costs"/>
        <skos:altLabel xml:lang="en">Health Economic Costing</skos:altLabel>
        <skos:definition xml:lang="en">Costs is the area of health economics that measures the resources used in health care, and the wider resources lost to illness, and values them in money for economic evaluation.</skos:definition>
        <skos:editorialNote xml:lang="en">In HEO this concept is the wiki subdomain Costs, directly under Health Economics. Concepts in that subdomain with no is-type-of parent are classified under it or under a concept within it.</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Costs</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/costs"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-economics"/>
