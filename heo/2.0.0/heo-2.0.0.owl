        <rdfs:label xml:lang="en">Mental Health Policy</rdfs:label>
        <skos:altLabel xml:lang="en">MH Policy</skos:altLabel>
        <skos:definition xml:lang="en">Government or organisational policy governing the financing, delivery, and regulation of mental health services, covering insurance parity and community funding.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Psychiatric Policy</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Mental Health Policy</skos:prefLabel>
        <abbreviation xml:lang="en">MH Policy</abbreviation>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
