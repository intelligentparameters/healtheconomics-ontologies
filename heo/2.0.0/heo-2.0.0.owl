    <!-- https://healtheconomics.wiki/concept/established-technology -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/established-technology">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-technology"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-technology"/>
        <skos:notation>HS-HP-HS-007</skos:notation>
        <dcterms:identifier>HS-HP-HS-007</dcterms:identifier>
        <dcterms:source>Elshaug et al. 2012</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Established Technology</rdfs:label>
        <skos:definition xml:lang="en">A technology in routine clinical use for an extended period, with a well-developed evidence base and generally accepted role in care.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Mature Technology</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Routine-Use Technology</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Established Technology</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/emerging-technology"/>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/obsolete-technology"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/established-technology"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-technology"/>
        <dcterms:identifier>HEO-L-e6c629c6f591</dcterms:identifier>
        <linkRationale xml:lang="en">An established technology is a health technology</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
