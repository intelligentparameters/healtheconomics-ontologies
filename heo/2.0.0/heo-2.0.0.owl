    <!-- https://healtheconomics.wiki/concept/governance-standards -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/governance-standards">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/human-subjects-protection"/>
        <skos:notation>HS-HP-HSG-013</skos:notation>
        <dcterms:identifier>HS-HP-HSG-013</dcterms:identifier>
        <dcterms:source>National Commission, Belmont Report 1979</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Governance Standards</rdfs:label>
        <skos:definition xml:lang="en">The policies and oversight mechanisms established to ensure research is conducted responsibly and in accordance with ethical and regulatory requirements.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Governance Framework</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Oversight Standards</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Governance Standards</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/compliance"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/governance-standards"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-e9156e8c85f4</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Health System Governance: organisation and delivery of care is the Health Systems subdomain (Organisation and governance)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/governance-standards"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/human-subjects-protection"/>
        <dcterms:identifier>HEO-L-1a28ca7f9c99</dcterms:identifier>
        <linkRationale xml:lang="en">Research governance policies are oversight mechanisms of human subjects protection, not part of a branch of ethics</linkRationale>
