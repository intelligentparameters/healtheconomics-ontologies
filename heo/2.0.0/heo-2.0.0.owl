        <dcterms:identifier>HE-ES-CTM-021</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-21</dcterms:modified>
        <dcterms:source>Friedman LM, Furberg CD, DeMets DL, Reboussin DM, Granger CB. Fundamentals of Clinical Trials. 5th ed. Springer; 2015. doi:10.1007/978-3-319-18539-2.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Crossover Trial</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">Cross-Over Trial</skos:altLabel>
        <skos:definition xml:lang="en">A trial in which participants sequentially receive two or more treatments under comparison, with each participant&apos;s response compared against their own.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Within-Subject Trial</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Crossover Trial</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-1"/>
