        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <skos:notation>HS-HP-HSM-019</skos:notation>
        <dcterms:identifier>HS-HP-HSM-019</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Single Payer System</rdfs:label>
        <skos:altLabel xml:lang="en">Single-Payer</skos:altLabel>
        <skos:definition xml:lang="en">A financing model where a single public entity finances healthcare for an entire population, while care may still be delivered by mixed providers.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Single Payer</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Single Payer System</skos:prefLabel>
        <abbreviation xml:lang="en">Single-Payer</abbreviation>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/universal-health-coverage"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/single-payer-system"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <dcterms:identifier>HEO-L-3e196991d647</dcterms:identifier>
        <linkRationale xml:lang="en">Single payer is a model of raising and pooling health funds.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
