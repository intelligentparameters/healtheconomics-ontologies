    <!-- https://healtheconomics.wiki/concept/time-varying-covariate -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/time-varying-covariate">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
