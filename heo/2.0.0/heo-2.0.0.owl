    <!-- https://healtheconomics.wiki/concept/innovation-premium -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/innovation-premium">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/price-premium"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/price-premium"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/launch-price"/>
        <skos:notation>HS-DC-DP-039</skos:notation>
        <dcterms:identifier>HS-DC-DP-039</dcterms:identifier>
        <dcterms:source>Danzon 2018</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Innovation Premium</rdfs:label>
        <skos:definition xml:lang="en">The additional price a manufacturer charges for a genuinely novel treatment relative to existing alternatives, reflecting incremental clinical benefit and development investment.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Innovation Price Premium</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Novelty Premium</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Innovation Premium</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/innovation-premium"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/price-premium"/>
        <dcterms:identifier>HEO-L-cdae9b888d22</dcterms:identifier>
        <linkRationale xml:lang="en">An innovation premium is a price premium</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/innovation-premium"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/launch-price"/>
        <dcterms:identifier>HEO-L-1323e8ddcae4</dcterms:identifier>
        <linkRationale xml:lang="en">The premium is the portion of the launch price above existing alternatives (subject definition)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/innovative-treatment -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/innovative-treatment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/innovation"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/treatment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/innovation"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/treatment"/>
        <skos:notation>HS-HP-HTA-115</skos:notation>
        <dcterms:identifier>HS-HP-HTA-115</dcterms:identifier>
        <dcterms:source>Christensen, Raynor &amp; McDonald 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Innovative Treatment</rdfs:label>
        <skos:definition xml:lang="en">A technology introducing a genuinely novel approach to a condition, unlike an incremental modification of an existing treatment.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Novel Treatment</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Pioneering Treatment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Innovative Treatment</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/incremental-innovation"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
