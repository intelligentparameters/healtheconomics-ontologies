        <linkRationale xml:lang="en">Several anti-TNF and other mAbs are standard RA treatments (Biologic treats RA already).</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/monopoly -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/monopoly">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/market-structure"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q17243"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
