    <!-- https://healtheconomics.wiki/concept/risk-equalization -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/risk-equalization">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/risk-sharing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/risk-sharing"/>
        <skos:notation>HS-HP-HI-164</skos:notation>
        <dcterms:identifier>HS-HP-HI-164</dcterms:identifier>
        <dcterms:source>Ellis 2008</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Risk Equalization</rdfs:label>
        <skos:altLabel xml:lang="en">Risk Equalisation</skos:altLabel>
        <skos:definition xml:lang="en">A mechanism in multi-payer systems redistributing funds among competing insurers based on their enrolled populations&apos; relative risk profile.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Risk-Adjusted Transfer</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Risk Equalization</skos:prefLabel>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/risk-selection"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/risk-adjustment"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/risk-score"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/risk-equalization"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/risk-sharing"/>
        <dcterms:identifier>HEO-L-99e4ed3e0268</dcterms:identifier>
        <linkRationale xml:lang="en">Equalisation redistributes risk across insurers, a risk-sharing arrangement.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/risk-equalization"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#reduces"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/risk-selection"/>
        <dcterms:identifier>HEO-L-03139fd9077e</dcterms:identifier>
        <linkRationale xml:lang="en">Equalisation removes the reward for enrolling healthier members.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
