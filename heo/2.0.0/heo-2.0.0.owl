    <!-- https://healtheconomics.wiki/concept/mantel-haenszel-method -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/mantel-haenszel-method">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/fixed-effect-model"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/fixed-effect-model"/>
        <skos:notation>HE-ES-ESM-071</skos:notation>
        <dcterms:identifier>HE-ES-ESM-071</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</dcterms:modified>
        <dcterms:source>Deeks et al. 2024</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Mantel-Haenszel Method</rdfs:label>
        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:altLabel xml:lang="en">MH Method</skos:altLabel>
        <skos:definition xml:lang="en">The Mantel-Haenszel method pools 2x2 tables from trials or strata into one fixed-effect odds ratio, risk ratio or risk difference for HTA meta-analysis.</skos:definition>
        <skos:hiddenLabel xml:lang="en">CMH Test</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Cochran-Mantel-Haenszel Test</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Mantel-Haenszel Test</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Mantel-Haenszel Method</skos:prefLabel>
        <abbreviation xml:lang="en">MH Method</abbreviation>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/confounding"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/odds-ratio"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/risk-ratio"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/contingency-table"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/mantel-haenszel-method"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/fixed-effect-model"/>
        <dcterms:identifier>HEO-L-265e0856f638</dcterms:identifier>
        <linkRationale xml:lang="en">The subject definition says it gives a fixed-effect estimate</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/mantel-haenszel-method"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#addresses"/>
