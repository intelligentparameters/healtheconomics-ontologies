        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Retrospective Payment</rdfs:label>
        <skos:altLabel xml:lang="en">Retrospective Reimbursement</skos:altLabel>
        <skos:definition xml:lang="en">A methodology reimbursing a provider based on actual costs or charges incurred, determined after care has been provided, unlike prospective payment.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cost-Reimbursement Payment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Retrospective Payment</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
