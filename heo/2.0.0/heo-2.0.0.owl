        <owl:versionInfo>1.0.1</owl:versionInfo>
        <skos:definition xml:lang="en">A credence good is a good or service whose quality or need a buyer cannot judge even after use, such as medical care, where the expert seller knows more.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Credence Product</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Trust Good</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Credence Good</skos:prefLabel>
