    <!-- https://healtheconomics.wiki/concept/low-performer-identification -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/low-performer-identification">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
