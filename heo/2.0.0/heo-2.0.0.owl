    <!-- https://healtheconomics.wiki/concept/stewardship -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/stewardship">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-governance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-governance"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/health-system"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/health-system-building-blocks"/>
        <skos:notation>HS-SS-HSG-007</skos:notation>
        <dcterms:identifier>HS-SS-HSG-007</dcterms:identifier>
        <dcterms:source>World Health Organization. Everybody&apos;s Business: Strengthening Health Systems to Improve Health Outcomes-WHO&apos;s Framework for Action. WHO; 2007.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Stewardship</rdfs:label>
        <skos:definition xml:lang="en">A core health system building block encompassing overarching responsibility for policy formulation, regulation, and accountability across the system&apos;s actors.</skos:definition>
        <skos:hiddenLabel xml:lang="en">System Direction</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">System Oversight</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Stewardship</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/stewardship"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-governance"/>
        <dcterms:identifier>HEO-L-3cebcee2ac6b</dcterms:identifier>
        <linkRationale xml:lang="en">Stewardship is the overarching governance responsibility of government, one form of health governance.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
