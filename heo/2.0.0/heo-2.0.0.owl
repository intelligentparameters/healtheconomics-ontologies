    <!-- https://healtheconomics.wiki/concept/outlier-identification -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/outlier-identification">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-system-performance"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-system-performance"/>
        <skos:notation>HS-SS_HSP-044</skos:notation>
        <dcterms:identifier>HS-SS_HSP-044</dcterms:identifier>
        <dcterms:source>Fetter et al. 1980</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Outlier Identification</rdfs:label>
        <skos:altLabel xml:lang="en">Outlier Detection</skos:altLabel>
        <skos:definition xml:lang="en">The process of identifying data points, cases, or providers whose performance substantially deviates from an expected pattern, flagging further investigation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Anomaly Detection</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Outlier Identification</skos:prefLabel>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/outlier"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/statistical-process-control"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/studentized-residual"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/outlier-identification"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-system-performance"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-0f680b4a81c8</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Systems Strengthening &gt; Health System Performance: health system strengthening is the Health Systems subdomain; placed under Health System Performance, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/outlier-identification"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#evaluates"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/outlier"/>
        <dcterms:identifier>HEO-L-b49cdb5c0b19</dcterms:identifier>
        <linkRationale xml:lang="en">The process assesses data points or providers to judge whether they are outliers</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/outlier-identification"/>
