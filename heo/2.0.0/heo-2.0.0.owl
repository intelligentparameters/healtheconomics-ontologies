        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Biosimilar Approval</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Biosimilar approval is the regulatory licensing of a biosimilar shown to be highly similar to an approved reference biologic, so the two can compete.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Biosimilar Authorisation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Biosimilar Licensing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Biosimilar Approval</skos:prefLabel>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/biosimilar"/>
