        <skos:altLabel xml:lang="en">CFA</skos:altLabel>
        <skos:definition xml:lang="en">Confirmatory factor analysis (CFA) tests whether data fit a prespecified model linking health questionnaire items to the latent factors they measure.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Confirmatory Factor Modelling</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Confirmatory Factor Analysis</skos:prefLabel>
