    <!-- https://healtheconomics.wiki/concept/healthy-year-equivalent -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/healthy-year-equivalent">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-adjusted-life-year"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-adjusted-life-year"/>
        <skos:notation>HE-EE-QALY-004</skos:notation>
        <dcterms:identifier>HE-EE-QALY-004</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-23</dcterms:modified>
        <dcterms:source>Mehrez &amp; Gafni 1989</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
