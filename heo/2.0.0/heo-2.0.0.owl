        <dcterms:identifier>HE-ES-EA-050</dcterms:identifier>
        <dcterms:source>Mokkink et al. 2010</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cross-Cultural Validity</rdfs:label>
        <skos:definition xml:lang="en">Cross-cultural validity is how far items in a translated or culturally adapted health questionnaire, such as the EQ-5D, perform like the original version.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cross-Cultural Equivalence</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Measurement Invariance</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cross-Cultural Validity</skos:prefLabel>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/prom"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
