    <!-- https://healtheconomics.wiki/concept/time-with-symptoms -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/time-with-symptoms">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/quality-adjusted-time-without-symptoms"/>
        <skos:notation>HE-ES-CO-088</skos:notation>
        <dcterms:identifier>HE-ES-CO-088</dcterms:identifier>
        <dcterms:source>Gelber et al. 1989</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Time with Symptoms</rdfs:label>
        <skos:definition xml:lang="en">A phase within the Q-TWiST framework representing the period during which a patient experiences symptoms of disease progression or treatment toxicity.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Symptomatic Time</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Time in Symptomatic State</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Time with Symptoms</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/time-without-symptoms-of-progression"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/time-with-symptoms"/>
