    <!-- https://healtheconomics.wiki/concept/concentration-curve -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/concentration-curve">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/data-visualisation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/data-visualisation"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/concentration-index"/>
        <skos:notation>HS-HP-HE-010</skos:notation>
        <dcterms:identifier>HS-HP-HE-010</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>O&apos;Donnell et al. 2008</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Concentration Curve</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">A concentration curve plots the cumulative share of a health variable against the cumulative share of the population ranked from poorest to richest.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Cumulative-Share Curve</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Lorenz-Type Curve</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Concentration Curve</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/lorenz-curve"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-policy#step-4"/>
        <represents rdf:resource="https://healtheconomics.wiki/concept/health-inequality"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/concentration-curve"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/data-visualisation"/>
        <dcterms:identifier>HEO-L-57d67f48b32e</dcterms:identifier>
        <linkRationale xml:lang="en">A graph of a distribution</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/concentration-curve"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/concentration-index"/>
        <dcterms:identifier>HEO-L-28c7c1fd22e8</dcterms:identifier>
        <linkRationale xml:lang="en">The concentration index is twice the area between the concentration curve and the diagonal</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
