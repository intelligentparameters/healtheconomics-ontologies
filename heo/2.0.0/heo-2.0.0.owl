        <dcterms:identifier>HS-SS_HSP-037</dcterms:identifier>
        <dcterms:source>Donabedian A. Evaluating the quality of medical care. Milbank Memorial Fund Quarterly. 1966;44(3):166-206. doi:10.2307/3348969.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Low Performer Identification</rdfs:label>
        <skos:definition xml:lang="en">The process of systematically identifying providers whose performance falls notably below relevant benchmarks, to prioritise targeted improvement support.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Low-Outlier Flagging</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Underperformer Detection</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Low Performer Identification</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/high-performer-identification"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/quality-indicator"/>
    </owl:NamedIndividual>
