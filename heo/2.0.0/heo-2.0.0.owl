    <!-- https://healtheconomics.wiki/concept/area-under-curve-approach -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/area-under-curve-approach">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/extrapolation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/extrapolation"/>
        <skos:notation>HE-EM-SM-002</skos:notation>
        <dcterms:identifier>HE-EM-SM-002</dcterms:identifier>
        <dcterms:source>Latimer 2013</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Area Under Curve Approach</rdfs:label>
        <skos:altLabel xml:lang="en">AUC Method</skos:altLabel>
        <skos:definition xml:lang="en">A survival extrapolation method fitting a parametric distribution to observed data and calculating the area under the resulting curve to estimate mean survival.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Restricted Mean Survival Approach</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Area Under Curve Approach</skos:prefLabel>
        <abbreviation xml:lang="en">AUC Method</abbreviation>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-6"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/curve-fitting"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/parametric-survival-model"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/trapezoidal-rule"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/area-under-curve-approach"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/extrapolation"/>
        <dcterms:identifier>HEO-L-97eebbfae59a</dcterms:identifier>
        <linkRationale xml:lang="en">A method for projecting mean survival beyond follow-up is an extrapolation method</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
