        <dcterms:identifier>HS-HP-PP-078</dcterms:identifier>
        <dcterms:source>McClellan et al. 2010</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Population-Based Payment</rdfs:label>
        <skos:definition xml:lang="en">A methodology reimbursing a provider based on the overall health needs and outcomes of a defined population, rather than individual services delivered.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Per-Capita Provider Payment</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Population Payment</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Population Payment Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Population-Based Payment</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
