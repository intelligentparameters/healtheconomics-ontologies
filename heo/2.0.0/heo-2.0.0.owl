    <!-- https://healtheconomics.wiki/concept/structural-quality -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/structural-quality">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <skos:notation>HS-HP-HQ-045</skos:notation>
        <dcterms:identifier>HS-HP-HQ-045</dcterms:identifier>
        <dcterms:source>Donabedian A. Evaluating the quality of medical care. Milbank Memorial Fund Quarterly. 1966;44(3):166-206. doi:10.2307/3348969.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Structural Quality</rdfs:label>
        <skos:definition xml:lang="en">A healthcare quality dimension focused on available resources and organisational characteristics, such as staffing and equipment, unlike process or outcomes.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Facility-Level Quality</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Structure-of-Care Quality</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Structural Quality</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/structural-quality"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-1385233cfb4d</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: catalogue Health Systems &gt; Health Policy &gt; Healthcare Quality: wiki topic Performance, productivity and quality sits in Health Systems; placed under Quality of Care, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/structural-quality"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/quality-of-care"/>
        <dcterms:identifier>HEO-L-11a99063d873</dcterms:identifier>
        <linkRationale xml:lang="en">Structure is one of the three Donabedian dimensions of quality of care, a component rather than a kind.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/structural-sensitivity-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/structural-sensitivity-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/sensitivity-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/sensitivity-analysis"/>
        <skos:notation>HE-EM-UA-072</skos:notation>
        <dcterms:identifier>HE-EM-UA-072</dcterms:identifier>
        <dcterms:source>Bojke et al. 2009</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Structural Sensitivity Analysis</rdfs:label>
        <skos:altLabel xml:lang="en">Structural SA</skos:altLabel>
        <skos:definition xml:lang="en">A sensitivity analysis testing how results change under alternative structural assumptions, such as a different survival extrapolation function, rather than parameter values.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Model-Structure Sensitivity</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Structural Sensitivity Analysis</skos:prefLabel>
        <abbreviation xml:lang="en">Structural SA</abbreviation>
        <evaluates rdf:resource="https://healtheconomics.wiki/concept/structural-uncertainty"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-10"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/scenario-analysis"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/structural-sensitivity-analysis"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/sensitivity-analysis"/>
        <dcterms:identifier>HEO-L-a598f0fa12cb</dcterms:identifier>
        <linkRationale xml:lang="en">It is sensitivity analysis applied to structural assumptions.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/structural-sensitivity-analysis"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#evaluates"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/structural-uncertainty"/>
        <dcterms:identifier>HEO-L-c6a797ddeee1</dcterms:identifier>
        <linkRationale xml:lang="en">Structural sensitivity analysis assesses the impact of structural uncertainty on results.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/structural-sensitivity-analysis"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#uses"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/scenario-analysis"/>
        <dcterms:identifier>HEO-L-92995a9e41f7</dcterms:identifier>
