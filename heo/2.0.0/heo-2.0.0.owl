        <dcterms:identifier>HEO-L-c6794ca19bdd</dcterms:identifier>
        <linkRationale xml:lang="en">Chi-square with k degrees of freedom is a gamma with shape k/2 and scale 2</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
