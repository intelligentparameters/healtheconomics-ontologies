        <dcterms:identifier>HE-ES-CTM-033</dcterms:identifier>
        <dcterms:source>Friedman LM, Furberg CD, DeMets DL, Reboussin DM, Granger CB. Fundamentals of Clinical Trials. 5th ed. Springer; 2015. doi:10.1007/978-3-319-18539-2.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Exclusion Criteria</rdfs:label>
        <skos:definition xml:lang="en">The specific characteristics that disqualify an otherwise eligible individual from a trial, such as a comorbidity that might confound results.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Disqualifying Characteristics</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Trial Exclusion Rules</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Exclusion Criteria</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/inclusion-criteria"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
