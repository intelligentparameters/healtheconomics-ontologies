        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/implementation-research"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/knowledge-translation"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/dissemination-research"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
