    <!-- https://healtheconomics.wiki/concept/conditional-probability -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/conditional-probability">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/probability"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q327069"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/probability"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/expected-value"/>
        <skos:notation>HE-EM-MP-007</skos:notation>
        <dcterms:identifier>HE-EM-MP-007</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Grinstead and Snell 2006</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Conditional Probability</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Conditional probability is the chance of an event given that another has occurred; health economic models use it for branch and transition probabilities.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Conditional Chance</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Probability Given an Event</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Conditional Probability</skos:prefLabel>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-4"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/conditional-probability"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/probability"/>
        <dcterms:identifier>HEO-L-06db7826cd70</dcterms:identifier>
        <linkRationale xml:lang="en">A probability given another event</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
