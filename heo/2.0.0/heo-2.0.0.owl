    <!-- https://healtheconomics.wiki/concept/out-of-pocket-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/out-of-pocket-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <skos:notation>HS-HP-HSM-016</skos:notation>
        <dcterms:identifier>HS-HP-HSM-016</dcterms:identifier>
        <dcterms:source>Xu et al. 2003</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Out-of-Pocket Model</rdfs:label>
        <skos:altLabel xml:lang="en">OOP Health System</skos:altLabel>
        <skos:definition xml:lang="en">A financing arrangement in which patients pay directly for care at the point of service, with little or no pooled prepayment to spread risk.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Direct-Payment Health System</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Out-of-Pocket Model</skos:prefLabel>
        <abbreviation xml:lang="en">OOP Health System</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/single-payer-system"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/out-of-pocket-payment"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/user-fee"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/out-of-pocket-model"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-system-financing"/>
        <dcterms:identifier>HEO-L-5cb1d5f96d9c</dcterms:identifier>
        <linkRationale xml:lang="en">A financing arrangement is not a health system; it is a mode of health system financing (as for Single Payer System)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
