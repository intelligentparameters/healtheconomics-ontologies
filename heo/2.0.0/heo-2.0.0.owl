    <!-- https://healtheconomics.wiki/concept/quality-adjusted-expectancy -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/quality-adjusted-expectancy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcome-measure"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/outcome-measure"/>
        <skos:notation>HE-EE-HU-061</skos:notation>
        <dcterms:identifier>HE-EE-HU-061</dcterms:identifier>
        <dcterms:source>Weinstein &amp; Stason 1977</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Quality-Adjusted Expectancy</rdfs:label>
        <skos:altLabel xml:lang="en">QALE</skos:altLabel>
        <skos:altLabel xml:lang="en">Quality-Adjusted Life Expectancy</skos:altLabel>
        <skos:definition xml:lang="en">A summary population health measure expressing expected remaining years of life weighted by health-related quality of life during those years.</skos:definition>
        <skos:prefLabel xml:lang="en">Quality-Adjusted Expectancy</skos:prefLabel>
        <abbreviation xml:lang="en">QALE</abbreviation>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
