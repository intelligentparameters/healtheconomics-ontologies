        <skos:notation>HE-ES-CTM-045</skos:notation>
        <dcterms:identifier>HE-ES-CTM-045</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-25</dcterms:modified>
        <dcterms:source>Friedman LM, Furberg CD, DeMets DL, Reboussin DM, Granger CB. Fundamentals of Clinical Trials. 5th ed. Springer; 2015. doi:10.1007/978-3-319-18539-2.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Intention-to-Treat Analysis</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">ITT Analysis</skos:altLabel>
        <skos:definition xml:lang="en">Intention-to-treat analysis compares outcomes according to participants’ original randomised assignments, irrespective of subsequent treatment receipt or adherence, while explicitly addressing missing outcome data.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Intention to Treat</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Intention-to-Treat Analysis</skos:prefLabel>
        <abbreviation xml:lang="en">ITT Analysis</abbreviation>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-1"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/intention-to-treat-population"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/intention-to-treat-analysis"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/statistical-method"/>
        <dcterms:identifier>HEO-L-2be14277115a</dcterms:identifier>
        <linkRationale xml:lang="en">An analysis principle, consistent with Completer Analysis</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
