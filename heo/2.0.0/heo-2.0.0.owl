        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/resource"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-good"/>
        <dcterms:identifier>HEO-L-02fa183e0f4a</dcterms:identifier>
        <linkRationale xml:lang="en">A resource is a scarce input subject to allocation choices, an economic good.</linkRationale>
