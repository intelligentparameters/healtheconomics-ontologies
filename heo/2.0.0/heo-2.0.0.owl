    <!-- https://healtheconomics.wiki/concept/healthcare-production-function -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/healthcare-production-function">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/cost-function"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/marginal-cost"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/technical-efficiency"/>
        <skos:notation>HE-EE-EPR-018</skos:notation>
        <dcterms:identifier>HE-EE-EPR-018</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Cylus, Papanicolas &amp; Smith 2016</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Healthcare Production Function</rdfs:label>
        <owl:versionInfo>1.0.3</owl:versionInfo>
        <skos:definition xml:lang="en">A healthcare production function gives the maximum care output, such as visits or hospital episodes, obtainable from given staff, capital and technology.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Care Output Function</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Medical Production Function</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Healthcare Production Function</skos:prefLabel>
        <assumes rdf:resource="https://healtheconomics.wiki/concept/diminishing-returns"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/expansion-path"/>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/producer-theory"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/resource"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/healthcare-production-function"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-systems"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-d1d13f98af52</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: curated: production of care output is Performance, productivity and quality, review B</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/healthcare-production-function"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#usedToCalculate"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/cost-function"/>
        <dcterms:identifier>HEO-L-d424c930eaa1</dcterms:identifier>
        <linkRationale xml:lang="en">By duality the cost function is derived from the production function and input prices</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
