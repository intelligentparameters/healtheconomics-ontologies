        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/cost-sharing"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/health-reimbursement-arrangement"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/health-savings-account"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/high-deductible-health-plan"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
