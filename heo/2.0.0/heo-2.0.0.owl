    <!-- https://healtheconomics.wiki/concept/stratified-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/stratified-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/subgroup-analysis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/subgroup-analysis"/>
        <skos:notation>HE-EE-CEA-062</skos:notation>
        <dcterms:identifier>HE-EE-CEA-062</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Stratified Analysis</rdfs:label>
        <skos:definition xml:lang="en">An economic evaluation reporting cost-effectiveness results separately for distinct population subgroups, such as by disease severity or age, rather than one pooled result.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Stratified Estimation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Stratum-Specific Analysis</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Stratified Analysis</skos:prefLabel>
        <addresses rdf:resource="https://healtheconomics.wiki/concept/patient-heterogeneity"/>
        <produces rdf:resource="https://healtheconomics.wiki/concept/subgroup-cost-effectiveness"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/stratified-analysis"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/subgroup-analysis"/>
        <dcterms:identifier>HEO-L-2659ccf3bbec</dcterms:identifier>
        <linkRationale xml:lang="en">Reporting results separately by subgroup is a form of subgroup analysis.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/stratified-analysis"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#addresses"/>
