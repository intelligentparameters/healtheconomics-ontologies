        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <dcterms:identifier>HEO-L-d4f27e4fa3ba</dcterms:identifier>
        <linkRationale xml:lang="en">VHI is health insurance.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
