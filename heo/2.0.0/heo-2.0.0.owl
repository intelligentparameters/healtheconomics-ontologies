        <skos:notation>HE-EE-HU-055</skos:notation>
        <dcterms:identifier>HE-EE-HU-055</dcterms:identifier>
        <dcterms:source>Torrance GW. Measurement of health state utilities for economic appraisal. Journal of Health Economics. 1986;5(1):1-30. doi:10.1016/0167-6296(86)90020-2.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Paired Comparison</rdfs:label>
        <skos:definition xml:lang="en">A health state valuation method in which respondents are shown two states at a time and indicate which they prefer, building up a ranking.</skos:definition>
