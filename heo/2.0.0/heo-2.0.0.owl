        <dcterms:source>U.S. Food and Drug Administration. Guidance for Industry: Patient-Reported Outcome Measures-Use in Medical Product Development to Support Labeling Claims. FDA; 2009.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Physical Function</rdfs:label>
        <skos:altLabel xml:lang="en">Physical Functioning</skos:altLabel>
        <skos:definition xml:lang="en">A dimension of health-related quality of life capturing an individual&apos;s ability to perform physical activities, such as walking or climbing stairs.</skos:definition>
