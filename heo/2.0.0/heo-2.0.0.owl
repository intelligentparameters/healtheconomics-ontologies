        <dcterms:identifier>HS-SS_DH-031</dcterms:identifier>
        <dcterms:source>Kaushal, Shojania &amp; Bates 2003</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Electronic Medical Record</rdfs:label>
        <skos:altLabel xml:lang="en">EMR</skos:altLabel>
