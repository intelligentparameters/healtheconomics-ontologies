    <!-- https://healtheconomics.wiki/concept/research-incentive -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/research-incentive">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/economic-incentive"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/economic-incentive"/>
        <skos:notation>HS-HP-HSG-028</skos:notation>
        <dcterms:identifier>HS-HP-HSG-028</dcterms:identifier>
        <dcterms:source>National Commission, Belmont Report 1979</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Research Incentive</rdfs:label>
        <skos:definition xml:lang="en">A payment or benefit offered to encourage study participation, carefully calibrated to avoid becoming an undue inducement that compromises consent.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Innovation Incentive</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Research Incentive</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/undue-inducement"/>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/recruitment"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/research-incentive"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/economic-incentive"/>
        <dcterms:identifier>HEO-L-14e69043a22f</dcterms:identifier>
        <linkRationale xml:lang="en">Definition: a payment to encourage participation, calibrated to avoid undue inducement.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-15</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
