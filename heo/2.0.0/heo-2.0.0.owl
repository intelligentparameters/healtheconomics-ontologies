    <!-- https://healtheconomics.wiki/concept/choice-model-estimate -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/choice-model-estimate">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
