    <!-- https://healtheconomics.wiki/concept/prevalence-difference -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/prevalence-difference">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/health-inequality"/>
        <skos:notation>HE-ES-RM-027</skos:notation>
        <dcterms:identifier>HE-ES-RM-027</dcterms:identifier>
        <dcterms:source>Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams &amp; Wilkins; 2008.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Prevalence Difference</rdfs:label>
        <skos:definition xml:lang="en">The absolute difference in the prevalence of a condition between two groups, giving a direct measure of disparity in disease burden.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Absolute Prevalence Gap</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Prevalence Disparity</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Prevalence Difference</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/prevalence-ratio"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-2"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/prevalence-difference"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/evidence-synthesis"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-bc87fda41cba</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Epidemiology and risk measures in subdomain Evidence Synthesis</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
