    <!-- https://healtheconomics.wiki/concept/adverse-drug-reaction -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/adverse-drug-reaction">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/adverse-drug-event"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/adverse-event"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q45959"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/adverse-drug-event"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/adverse-event"/>
        <skos:notation>HE-ES-RWE-001</skos:notation>
        <dcterms:identifier>HE-ES-RWE-001</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>ICH E2A 1994</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Adverse Drug Reaction</rdfs:label>
        <owl:versionInfo>1.0.3</owl:versionInfo>
        <skos:altLabel xml:lang="en">ADR</skos:altLabel>
        <skos:definition xml:lang="en">An adverse drug reaction (ADR) is a noxious, unintended response to a medicine, where a causal link to the drug is at least a reasonable possibility.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Adverse Effect</skos:hiddenLabel>
