    <!-- https://healtheconomics.wiki/concept/negative-recommendation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/negative-recommendation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/recommendation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/recommendation"/>
        <skos:notation>HS-HP-HTA-135</skos:notation>
        <dcterms:identifier>HS-HP-HTA-135</dcterms:identifier>
        <dcterms:source>National Institute for Health and Care Excellence. NICE technology appraisal and highly specialised technologies guidance: the manual (PMG36). Published 2022; updated 2026.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Negative Recommendation</rdfs:label>
        <skos:altLabel xml:lang="en">Exclusion</skos:altLabel>
        <skos:definition xml:lang="en">A body&apos;s formal decision not to recommend a technology for funding, based on unacceptable cost-effectiveness at the reviewed price.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Do-Not-Reimburse Recommendation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Negative Coverage Decision</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Non-Recommendation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Rejection</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Negative Recommendation</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/positive-recommendation"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/reimbursement-decision"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
