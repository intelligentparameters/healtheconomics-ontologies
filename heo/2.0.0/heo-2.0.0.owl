    <!-- https://healtheconomics.wiki/concept/bioequivalence -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/bioequivalence">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q864940"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:notation>HS-DC-GC-002</skos:notation>
        <dcterms:identifier>HS-DC-GC-002</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>ICH 2024 (M13A, FDA final version October 2024)</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Bioequivalence</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Bioequivalence means two products with the same active ingredient have rates and extents of absorption within preset limits, the basis of generic approval.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Bioequivalent</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Bioequivalence</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/abbreviated-new-drug-application"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/generic-drug"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <uses rdf:resource="https://healtheconomics.wiki/concept/confidence-interval"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/crossover-design"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/pharmacokinetics"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/bioequivalence"/>
