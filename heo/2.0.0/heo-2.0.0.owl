    <!-- https://healtheconomics.wiki/concept/access-to-care -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/access-to-care">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <skos:notation>HS-HP-HE-004</skos:notation>
        <dcterms:identifier>HS-HP-HE-004</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Penchansky R, Thomas JW. The concept of access: definition and relationship to consumer satisfaction. Medical Care. 1981;19(2):127?140. doi:10.1097/00005650-198102000-00001.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Access to Care</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:altLabel xml:lang="en">Access to Healthcare</skos:altLabel>
        <skos:altLabel xml:lang="en">Healthcare Access</skos:altLabel>
        <skos:altLabel xml:lang="en">System Access</skos:altLabel>
        <skos:definition xml:lang="en">Access to care is the opportunity to obtain appropriate healthcare when needed, given the availability, location, cost and acceptability of services.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Care Reachability</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Patient Reach</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Access to Care</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/universal-health-coverage"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/health-policy#step-4"/>
        <isPropertyOf rdf:resource="https://healtheconomics.wiki/concept/health-system"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/access-to-care"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-policy"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-af0b816c3fbe</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Equity and inequality in subdomain Health Policy</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/access-to-care"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contributesTo"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/universal-health-coverage"/>
        <dcterms:identifier>HEO-L-0e998a3126a3</dcterms:identifier>
        <linkRationale xml:lang="en">Access is a goal UHC aims for, not a constituent of it; better access drives coverage</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/access-to-care"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isPropertyOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-system"/>
