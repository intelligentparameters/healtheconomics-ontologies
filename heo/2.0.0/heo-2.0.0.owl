    <!-- https://healtheconomics.wiki/concept/age-weighting -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/age-weighting">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/discounting"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
