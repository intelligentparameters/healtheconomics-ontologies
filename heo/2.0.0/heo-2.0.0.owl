        <rdfs:label xml:lang="en">Bond Financing</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Bond financing is borrowing for health by issuing bonds, debt repaid with interest over many years, so hospitals and other large costs can be paid for now.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Debt Financing</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Healthcare Bonds</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Bond Financing</skos:prefLabel>
