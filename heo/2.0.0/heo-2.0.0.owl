    <!-- https://healtheconomics.wiki/concept/acute-coronary-syndrome -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/acute-coronary-syndrome">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
