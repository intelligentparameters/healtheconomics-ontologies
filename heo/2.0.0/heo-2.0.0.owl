    <!-- https://healtheconomics.wiki/concept/stratified-sampling -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/stratified-sampling">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/random-sampling"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/random-sampling"/>
        <skos:notation>HE-EM-UA-071</skos:notation>
        <dcterms:identifier>HE-EM-UA-071</dcterms:identifier>
        <dcterms:source>Neyman 1934</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Stratified Sampling</rdfs:label>
        <skos:altLabel xml:lang="en">Stratification Design</skos:altLabel>
        <skos:altLabel xml:lang="en">Stratified Random Sampling</skos:altLabel>
        <skos:definition xml:lang="en">A sampling technique dividing a population into distinct subgroups, called strata, and drawing a separate sample from each to ensure adequate representation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Proportional Sampling</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Stratification Scheme</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Stratum Design</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Stratified Sampling</skos:prefLabel>
        <isFoundationFor rdf:resource="https://healtheconomics.wiki/concept/latin-hypercube-sampling"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-10"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/stratified-sampling"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/random-sampling"/>
        <dcterms:identifier>HEO-L-e1d9bc19423b</dcterms:identifier>
        <linkRationale xml:lang="en">The random sampling article treats stratified random samples as one of the probability sampling designs with known selection probabilities.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/stratified-sampling"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#isFoundationFor"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/latin-hypercube-sampling"/>
        <dcterms:identifier>HEO-L-d39b3581a74c</dcterms:identifier>
        <linkRationale xml:lang="en">Latin hypercube sampling extends stratification to each input range, building on stratified sampling.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/streamlined-authority -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/streamlined-authority">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/reimbursement-restriction"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/reimbursement-restriction"/>
        <skos:notation>HS-HP-HTA-205</skos:notation>
        <dcterms:identifier>HS-HP-HTA-205</dcterms:identifier>
        <dcterms:source>National Institute for Health and Care Excellence. NICE technology appraisal and highly specialised technologies guidance: the manual (PMG36). Published 2022; updated 2026.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Streamlined Authority</rdfs:label>
        <skos:definition xml:lang="en">A simplified or expedited decision-making pathway applied to certain technologies, such as those with well-established evidence, reducing review time.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Simplified Authority Listing</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Streamlined Code Prescribing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Streamlined Authority</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/restricted-listing"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/streamlined-authority"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/reimbursement-restriction"/>
        <dcterms:identifier>HEO-L-c6fe827e8e14</dcterms:identifier>
        <linkRationale xml:lang="en">Streamlined authority is a level of restriction on subsidised use, so a reimbursement restriction.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
