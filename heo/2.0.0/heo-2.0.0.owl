    <!-- https://healtheconomics.wiki/concept/attack-rate-ratio -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/attack-rate-ratio">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/relative-risk"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/relative-risk"/>
        <skos:notation>HE-ES-RM-005</skos:notation>
        <dcterms:identifier>HE-ES-RM-005</dcterms:identifier>
        <dcterms:source>Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams &amp; Wilkins; 2008.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Attack Rate Ratio</rdfs:label>
        <skos:definition xml:lang="en">A measure comparing the attack rate of a disease between two groups within an outbreak, such as those exposed and unexposed to a source.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Attack Rate Comparison</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Relative Attack Rate</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Attack Rate Ratio</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/outbreak-investigation"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-2"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/attack-rate-ratio"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/relative-risk"/>
        <dcterms:identifier>HEO-L-3b595b82f59c</dcterms:identifier>
        <linkRationale xml:lang="en">A ratio of attack rates between exposed and unexposed is a relative risk</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
