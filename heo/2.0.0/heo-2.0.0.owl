    <!-- https://healtheconomics.wiki/concept/orphan-exclusivity -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/orphan-exclusivity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/market-exclusivity"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/market-exclusivity"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/orphan-drug-incentives"/>
        <skos:notation>HE-PE-DD-030</skos:notation>
        <dcterms:identifier>HE-PE-DD-030</dcterms:identifier>
        <dcterms:source>FDA, Orphan Drug Act</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Orphan Exclusivity</rdfs:label>
        <skos:altLabel xml:lang="en">Orphan Drug Exclusivity</skos:altLabel>
        <skos:altLabel xml:lang="en">Orphan Market Exclusivity</skos:altLabel>
        <skos:definition xml:lang="en">A market exclusivity period following orphan drug approval during which regulators generally will not approve a similar competing product for the same rare indication.</skos:definition>
        <skos:prefLabel xml:lang="en">Orphan Exclusivity</skos:prefLabel>
        <promotes rdf:resource="https://healtheconomics.wiki/concept/orphan-drug"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
