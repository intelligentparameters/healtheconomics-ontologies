    <!-- https://healtheconomics.wiki/concept/white-box-model -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/white-box-model">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/health-economic-model"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-economic-model"/>
        <skos:notation>HE-EM-MV-092</skos:notation>
        <dcterms:identifier>HE-EM-MV-092</dcterms:identifier>
        <dcterms:source>Eddy DM, Hollingworth W, Caro JJ, et al. Model transparency and validation: a report of the ISPOR-SMDM Modeling Good Research Practices Task Force-7. Value in Health. 2012;15(6):843-850. doi:10.1016/j.jval.2012.04.012.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">White Box Model</rdfs:label>
        <skos:altLabel xml:lang="en">Glass-Box Model</skos:altLabel>
        <skos:definition xml:lang="en">A model whose complete internal structure, assumptions, and calculations are fully transparent and accessible to external reviewers, the opposite of a black box.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Transparent Model</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">White Box Model</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/white-box-model"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/health-economic-model"/>
        <dcterms:identifier>HEO-L-999dfc309c7b</dcterms:identifier>
        <linkRationale xml:lang="en">A white box model is a fully transparent health economic model.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


