        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/anchoring"/>
        <skos:notation>HE-DS-BV-003</skos:notation>
        <dcterms:identifier>HE-DS-BV-003</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Tversky &amp; Kahneman 1974; Bojke et al. 2021</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Anchoring Bias in Elicitation</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Anchoring bias in elicitation is an expert&apos;s insufficient adjustment from a starting value, giving shifted, too-narrow distributions for model inputs.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Elicitation Anchoring</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Expert Anchoring Bias</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Anchoring Bias in Elicitation</skos:prefLabel>
        <contributesTo rdf:resource="https://healtheconomics.wiki/concept/overconfidence"/>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-4"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <threatensValidityOf rdf:resource="https://healtheconomics.wiki/concept/expert-elicitation"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/anchoring-bias-in-elicitation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/anchoring"/>
        <dcterms:identifier>HEO-L-4bc324c2aafc</dcterms:identifier>
