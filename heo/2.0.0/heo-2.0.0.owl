        <dcterms:identifier>HEO-L-cfbfb0b4a217</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: curated: review B: licensed indication is a regulatory concept (Drug development and regulation)</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/indication"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
