    <!-- https://healtheconomics.wiki/concept/standard-of-care -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/standard-of-care">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/comparator"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/comparator"/>
        <skos:notation>HE-EE-CEA-061</skos:notation>
        <dcterms:identifier>HE-EE-CEA-061</dcterms:identifier>
        <dcterms:source>Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Standard of Care</rdfs:label>
        <skos:altLabel xml:lang="en">SoC</skos:altLabel>
        <skos:definition xml:lang="en">The treatment widely accepted by clinical practice as the appropriate baseline for a given condition, commonly used as the comparator in an economic evaluation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Current Standard Treatment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Standard of Care</skos:prefLabel>
        <abbreviation xml:lang="en">SoC</abbreviation>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
