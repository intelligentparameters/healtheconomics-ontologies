        <dcterms:identifier>HS-HP-HD-070</dcterms:identifier>
        <dcterms:source>AHA, American Hospital Association</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Long-Term Care</rdfs:label>
        <skos:altLabel xml:lang="en">LTC</skos:altLabel>
        <skos:definition xml:lang="en">Ongoing support and personal care for people with chronic illness, disability, or age-related functional decline, spanning home and residential settings.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Continuing Care</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Long-Term Care</skos:prefLabel>
        <abbreviation xml:lang="en">LTC</abbreviation>
