        <skos:altLabel xml:lang="en">Time-to-Event Regression</skos:altLabel>
        <skos:definition xml:lang="en">A modelling approach estimating the relationship between predictor variables and a time-to-event outcome, including the Cox model and parametric survival models.</skos:definition>
