        <dcterms:identifier>HEO-L-8328de3e0626</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Health financing and insurance in subdomain Health Systems; placed under Health System Financing, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/programme-budgeting"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#precedes"/>
