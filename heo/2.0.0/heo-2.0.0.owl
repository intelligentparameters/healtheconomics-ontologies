    <!-- https://healtheconomics.wiki/concept/equal-value-of-life-year-gained -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/equal-value-of-life-year-gained">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcome-measure"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/outcome-measure"/>
        <skos:notation>HE-EE-QALY-001</skos:notation>
        <dcterms:identifier>HE-EE-QALY-001</dcterms:identifier>
        <dcterms:source>ICER 2023</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Equal Value of Life Year Gained</rdfs:label>
        <skos:altLabel xml:lang="en">evLYG</skos:altLabel>
        <skos:definition xml:lang="en">An alternative to the QALY that values every extra year of life gained equally, regardless of the quality of life experienced during it.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Equal-Value Life-Year</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Equal Value of Life Year Gained</skos:prefLabel>
        <abbreviation xml:lang="en">evLYG</abbreviation>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/qaly"/>
        <informs rdf:resource="https://healtheconomics.wiki/concept/value-assessment"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/equal-value-of-life-year-gained"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/outcome-measure"/>
        <dcterms:identifier>HEO-L-d2f70b0042c7</dcterms:identifier>
        <linkRationale xml:lang="en">EVLYG is a metric quantifying health outcome</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/equal-value-of-life-year-gained"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/qaly"/>
        <dcterms:identifier>HEO-L-a14dc2c2ca36</dcterms:identifier>
        <linkRationale xml:lang="en">EVLYG is defined as an alternative to the QALY that ignores quality</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
