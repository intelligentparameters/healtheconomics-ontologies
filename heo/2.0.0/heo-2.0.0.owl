        <dcterms:identifier>HEO-L-c1ba255ae723</dcterms:identifier>
        <linkRationale xml:lang="en">Fieller&apos;s method is a technique whose output is the interval, not an input quantity</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/final-outcome -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/final-outcome">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome"/>
        <skos:notation>HS-HP-CO-002</skos:notation>
        <dcterms:identifier>HS-HP-CO-002</dcterms:identifier>
        <dcterms:source>Prentice 1989</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Final Outcome</rdfs:label>
        <skos:altLabel xml:lang="en">True Endpoint</skos:altLabel>
        <skos:definition xml:lang="en">A clinical outcome measure directly reflecting a patient&apos;s health status or survival, such as death, unlike a surrogate or intermediate outcome.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Definitive Outcome</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Final Outcome</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/surrogate-endpoint"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/final-outcome"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/clinical-outcome"/>
        <dcterms:identifier>HEO-L-224e3443c830</dcterms:identifier>
        <linkRationale xml:lang="en">Death and survival are clinical outcomes in how a patient survives</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/final-outcome"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/surrogate-endpoint"/>
        <dcterms:identifier>HEO-L-4769dc201ff0</dcterms:identifier>
        <linkRationale xml:lang="en">Final outcomes are defined in opposition to surrogate endpoints</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/final-recommendation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/final-recommendation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/recommendation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/recommendation"/>
        <skos:notation>HS-HP-HTA-090</skos:notation>
        <dcterms:identifier>HS-HP-HTA-090</dcterms:identifier>
        <dcterms:source>National Institute for Health and Care Excellence. NICE technology appraisal and highly specialised technologies guidance: the manual (PMG36). Published 2022; updated 2026.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Final Recommendation</rdfs:label>
        <skos:definition xml:lang="en">The concluding, binding decision issued by an assessment body following its full appraisal process, determining a technology&apos;s funding status.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Binding Recommendation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Final Guidance</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Final Recommendation</skos:prefLabel>
        <informs rdf:resource="https://healtheconomics.wiki/concept/coverage-decision"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/final-recommendation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
