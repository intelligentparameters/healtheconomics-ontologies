    <!-- https://healtheconomics.wiki/concept/lifetime-maximum -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/lifetime-maximum">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/benefit-limit"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/benefit-limit"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/health-insurance"/>
        <skos:notation>HS-HP-HI-108</skos:notation>
        <dcterms:identifier>HS-HP-HI-108</dcterms:identifier>
        <dcterms:source>Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Lifetime Maximum</rdfs:label>
        <skos:altLabel xml:lang="en">Lifetime Limit</skos:altLabel>
        <skos:definition xml:lang="en">A cap on the total amount an insurance plan will pay toward covered costs over an individual&apos;s entire coverage duration.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Lifetime Benefit Cap</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Lifetime Maximum</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/annual-limit"/>
        <reduces rdf:resource="https://healtheconomics.wiki/concept/financial-protection"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/lifetime-maximum"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/benefit-limit"/>
        <dcterms:identifier>HEO-L-5d98955d4c91</dcterms:identifier>
        <linkRationale xml:lang="en">A plan payment cap, like Annual Limit; not cost sharing</linkRationale>
