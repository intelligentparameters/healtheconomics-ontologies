    <!-- https://healtheconomics.wiki/concept/cycle -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/cycle">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/markov-model"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/markov-model"/>
        <partOf rdf:resource="https://healtheconomics.wiki/concept/markov-model"/>
        <skos:notation>HE-EM-MM-004</skos:notation>
        <dcterms:identifier>HE-EM-MM-004</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-24</dcterms:modified>
        <dcterms:source>Sonnenberg FA, Beck JR. Markov models in medical decision making: a practical guide. Medical Decision Making. 1993;13(4):322?338. doi:10.1177/0272989X9301300409.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cycle</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A cycle is a defined time interval during which a discrete-time state-transition model updates health-state occupancy and accumulates relevant outcomes and costs.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Markov Time Unit</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Model Time Interval</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Cycle</skos:prefLabel>
        <optionalConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-3"/>
        <prerequisiteFor rdf:resource="https://healtheconomics.wiki/concept/half-cycle-correction"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cycle"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/markov-model"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-16</dcterms:created>
        <dcterms:identifier>HEO-L-0c32d8ce40ab</dcterms:identifier>
        <linkRationale xml:lang="en">Placement: wiki topic Markov and state transition models in subdomain Economic Modelling; placed under Markov Model, the concept named by its catalogue Level 3</linkRationale>
        <linkReviewStatus>unreviewed</linkReviewStatus>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cycle"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#partOf"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/markov-model"/>
        <dcterms:identifier>HEO-L-647ca43a95d7</dcterms:identifier>
        <linkRationale xml:lang="en">The cycle is the time unit of a Markov model&apos;s structure (both definitions)</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/cycle"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#prerequisiteFor"/>
