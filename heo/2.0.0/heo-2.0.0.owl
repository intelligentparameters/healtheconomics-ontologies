    <!-- https://healtheconomics.wiki/concept/shared-savings -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/shared-savings">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <skos:notation>HS-HP-PP-094</skos:notation>
        <dcterms:identifier>HS-HP-PP-094</dcterms:identifier>
        <dcterms:source>Carlson JJ, Sullivan SD, Garrison LP, Neumann PJ, Veenstra DL. Linking payment to health outcomes: a taxonomy and examination of performance-based reimbursement schemes. Health Policy. 2010;96(3):179-190.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Shared Savings</rdfs:label>
        <skos:definition xml:lang="en">An arrangement in which a provider receives a portion of cost savings achieved relative to a predetermined spending benchmark for a population.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Savings Distribution</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Savings Sharing</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Shared Savings</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/shared-savings"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/provider-payment"/>
        <dcterms:identifier>HEO-L-ba8f2caf7fff</dcterms:identifier>
        <linkRationale xml:lang="en">Shared savings is a way of paying providers.</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/concept/shared-savings-programme -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/shared-savings-programme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
