    <!-- https://healtheconomics.wiki/concept/multi-objective-optimisation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/multi-objective-optimisation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/optimisation"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q2052203"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/optimisation"/>
        <skos:notation>HE-EM-DM-066</skos:notation>
        <dcterms:identifier>HE-EM-DM-066</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-24</dcterms:modified>
        <dcterms:source>Deb 2001</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Multi-Objective Optimisation</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:altLabel xml:lang="en">MOO</skos:altLabel>
        <skos:altLabel xml:lang="en">Pareto Optimisation</skos:altLabel>
        <skos:definition xml:lang="en">An optimisation approach used when a decision involves competing objectives, such as maximising benefit while minimising cost, producing a set of trade-off solutions.</skos:definition>
        <skos:prefLabel xml:lang="en">Multi-Objective Optimisation</skos:prefLabel>
