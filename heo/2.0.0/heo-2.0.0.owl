        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/decision-criteria"/>
        <dcterms:identifier>HEO-L-8012d7044947</dcterms:identifier>
        <linkRationale xml:lang="en">A decision criterion</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
