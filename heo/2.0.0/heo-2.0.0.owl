    <!-- https://healtheconomics.wiki/concept/semi-fixed-cost -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/semi-fixed-cost">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/cost"/>
        <skos:notation>HE-EE-CA-072</skos:notation>
        <dcterms:identifier>HE-EE-CA-072</dcterms:identifier>
        <dcterms:source>Horngren, Datar &amp; Rajan 2015</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
