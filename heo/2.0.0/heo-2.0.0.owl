        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/health-spending"/>
        <usedToCalculate rdf:resource="https://healtheconomics.wiki/concept/shared-savings"/>
        <skos:notation>HS-HP-PP-098</skos:notation>
        <dcterms:identifier>HS-HP-PP-098</dcterms:identifier>
        <dcterms:source>Carlson JJ, Sullivan SD, Garrison LP, Neumann PJ, Veenstra DL. Linking payment to health outcomes: a taxonomy and examination of performance-based reimbursement schemes. Health Policy. 2010;96(3):179-190.</dcterms:source>
