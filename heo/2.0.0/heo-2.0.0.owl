    <!-- https://healtheconomics.wiki/concept/persistence-outcome -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/persistence-outcome">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <classifiedUnder rdf:resource="https://healtheconomics.wiki/concept/outcomes"/>
        <measures rdf:resource="https://healtheconomics.wiki/concept/medication-persistence"/>
        <skos:notation>HE-ES-CO-057</skos:notation>
        <dcterms:identifier>HE-ES-CO-057</dcterms:identifier>
        <dcterms:source>Osterberg &amp; Blaschke 2005</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Persistence Outcome</rdfs:label>
        <skos:altLabel xml:lang="en">Treatment Persistence</skos:altLabel>
        <skos:definition xml:lang="en">A measure of how long a patient continues taking a prescribed medication before stopping, distinct from adherence to the regimen while still taking it.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Persistence Endpoint</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Persistence Outcome</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/adherence-outcome"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/persistence-outcome"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#classifiedUnder"/>
