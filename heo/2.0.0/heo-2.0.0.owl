        <uses rdf:resource="https://healtheconomics.wiki/concept/meta-analysis"/>
        <uses rdf:resource="https://healtheconomics.wiki/concept/network-meta-analysis"/>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
