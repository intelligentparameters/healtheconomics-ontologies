    <!-- https://healtheconomics.wiki/concept/disease-progression -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/disease-progression">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
