        <dcterms:identifier>HE-EE-CBA-014</dcterms:identifier>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-10</dcterms:modified>
        <dcterms:source>Boardman AE, Greenberg DH, Vining AR, Weimer DL. Cost-Benefit Analysis: Concepts and Practice. 5th ed. Cambridge University Press; 2018. https://doi.org/10.1017/9781108235594 | HM Treasury. The Green Book 2026. https://www.gov.uk/government/publications/the-green-book-appraisal-and-evaluation-in-central-government/the-green-book-2026 | Centers for Disease Control and Prevention. Cost-Benefit Analysis. https://www.cdc.gov/polaris/php/economics/cost-benefit.html | World Health Organization. A framework for the quantification and economic valuation of health outcomes. 2023. https://www.who.int/publications/i/item/9789240057906</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Cost-Benefit Analysis</rdfs:label>
        <owl:versionInfo>1.5.22</owl:versionInfo>
        <skos:altLabel xml:lang="en">Benefit-Cost Analysis</skos:altLabel>
        <skos:altLabel xml:lang="en">CBA</skos:altLabel>
        <skos:definition xml:lang="en">Cost-benefit analysis values the costs and benefits of healthcare options in money, so they can be compared by their net benefit, usually to society.</skos:definition>
        <skos:prefLabel xml:lang="en">Cost-Benefit Analysis</skos:prefLabel>
        <abbreviation xml:lang="en">CBA</abbreviation>
        <assumes rdf:resource="https://healtheconomics.wiki/concept/kaldor-hicks-efficiency"/>
