        <rdfs:label xml:lang="en">Reference Product</rdfs:label>
        <skos:altLabel xml:lang="en">Originator Product</skos:altLabel>
        <skos:definition xml:lang="en">The originally approved biologic against which a biosimilar is compared during development, required to show high similarity with no meaningful clinical differences.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Reference Biologic</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Reference Product</skos:prefLabel>
        <benchmarkFor rdf:resource="https://healtheconomics.wiki/concept/biosimilar"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
