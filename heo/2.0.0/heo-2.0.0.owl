        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/informed-consent"/>
        <skos:notation>HS-HP-HD-127</skos:notation>
        <dcterms:identifier>HS-HP-HD-127</dcterms:identifier>
        <dcterms:source>Faden &amp; Beauchamp 1986</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Written Consent</rdfs:label>
        <skos:definition xml:lang="en">A formal process in which a patient&apos;s agreement to treatment is documented through their signature on a written consent form.</skos:definition>
        <skos:prefLabel xml:lang="en">Written Consent</skos:prefLabel>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
