    <!-- https://healtheconomics.wiki/concept/full-capitation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/full-capitation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/capitation"/>
        <skos:inScheme rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <isTypeOf rdf:resource="https://healtheconomics.wiki/concept/capitation"/>
        <skos:notation>HS-HP-PP-053</skos:notation>
        <dcterms:identifier>HS-HP-PP-053</dcterms:identifier>
        <dcterms:source>Kongstvedt 2012</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Full Capitation</rdfs:label>
        <skos:altLabel xml:lang="en">Global Capitation</skos:altLabel>
        <skos:altLabel xml:lang="en">Global Payment</skos:altLabel>
        <skos:definition xml:lang="en">A capitation arrangement in which a provider assumes complete financial risk for essentially all a patient&apos;s healthcare costs, unlike partial capitation.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Comprehensive Capitation</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Comprehensive Payment</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Total Cost of Care Payment</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Full Capitation</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/partial-capitation"/>
        <reviewStatus xml:lang="en">Dictionary entry, not yet expert verified</reviewStatus>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/full-capitation"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/capitation"/>
        <dcterms:identifier>HEO-L-b7778ea20904</dcterms:identifier>
        <linkRationale xml:lang="en">Full capitation is capitation</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
        <linkReviewer>AI-assisted review (Claude) for HealthEconomics.wiki; curator sign-off pending</linkReviewer>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/full-capitation"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heo#contrastsWith"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/concept/partial-capitation"/>
        <dcterms:identifier>HEO-L-780962a2540e</dcterms:identifier>
        <linkRationale xml:lang="en">Full and partial capitation are defined against each other</linkRationale>
        <linkReviewDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</linkReviewDate>
        <linkReviewStatus>machine-reviewed</linkReviewStatus>
