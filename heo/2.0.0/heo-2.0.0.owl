    <!-- https://healtheconomics.wiki/concept/multi-criteria-decision-analysis -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/multi-criteria-decision-analysis">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:broader rdf:resource="https://healtheconomics.wiki/concept/trade-off-analysis"/>
