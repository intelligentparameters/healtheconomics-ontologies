    <!-- https://healtheconomics.wiki/concept/breakthrough-designation -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/breakthrough-designation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
