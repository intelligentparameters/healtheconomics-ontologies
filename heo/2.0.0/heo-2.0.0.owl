    <!-- https://healtheconomics.wiki/concept/usual-customary-reasonable -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/concept/usual-customary-reasonable">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
