        <skos:altLabel xml:lang="en">Step Cost</skos:altLabel>
        <skos:altLabel xml:lang="en">Step-Fixed Cost</skos:altLabel>
        <skos:altLabel xml:lang="en">Stepped Cost</skos:altLabel>
        <skos:definition xml:lang="en">A cost that stays fixed within a certain range of activity but rises in discrete steps once a threshold is crossed.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Lumpy Cost</skos:hiddenLabel>
