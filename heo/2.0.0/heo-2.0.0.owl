        <rdfs:label xml:lang="en">Weighted Log-Rank</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition xml:lang="en">A survival-curve comparison test that weights each event-time observed-minus-expected count to emphasize a prespecified pattern of differences over follow-up.</skos:definition>
        <skos:hiddenLabel xml:lang="en">G-Rho Family Test</skos:hiddenLabel>
