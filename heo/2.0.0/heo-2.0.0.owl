        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heo"/>
        <rdfs:label xml:lang="en">Expected Value</rdfs:label>
        <owl:versionInfo>1.0.2</owl:versionInfo>
        <skos:definition xml:lang="en">Expected value is the probability-weighted mean of an uncertain outcome, such as a cost or QALY total, across all its possible values.</skos:definition>
        <skos:hiddenLabel xml:lang="en">Mean Outcome</skos:hiddenLabel>
        <skos:hiddenLabel xml:lang="en">Probability-Weighted Average</skos:hiddenLabel>
        <skos:prefLabel xml:lang="en">Expected Value</skos:prefLabel>
        <contrastsWith rdf:resource="https://healtheconomics.wiki/concept/median"/>
        <coreConceptIn rdf:resource="https://healtheconomics.wiki/knowledge-map/economic-modelling#step-2"/>
        <prerequisiteFor rdf:resource="https://healtheconomics.wiki/concept/law-of-large-numbers"/>
        <reviewStatus xml:lang="en">Expert verified</reviewStatus>
        <verifiedBy>Dr Darrin Baines</verifiedBy>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/concept/expected-value"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
