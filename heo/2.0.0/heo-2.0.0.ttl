    dcterms:identifier "HS-HP-HTA-194" ;
    dcterms:source "NICE 2022" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:broader hewc:health-technology-assessment ;
    skos:definition "A standard giving additional weight to interventions addressing more severe conditions, reflecting a preference for prioritising the greatest health shortfall."@en ;
    skos:hiddenLabel "Disease-Burden Criterion"@en,
        "Severity Weighting"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HS-HP-HTA-194" ;
    skos:prefLabel "Severity Criterion"@en ;
    heo:classifiedUnder hewc:health-technology-assessment ;
    heo:partOf hewc:decision-criteria ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en ;
    heo:uses hewc:proportional-shortfall .

hewc:signal-detection a skos:Concept ;
    rdfs:label "Signal Detection"@en ;
    dcterms:identifier "HE-ES-RWE-014" ;
    dcterms:source "Edwards & Aronson 2000" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:broader hewc:real-world-evidence ;
    skos:definition "The process of identifying a potential new safety concern from surveillance data, typically from a disproportionate reporting pattern warranting investigation."@en ;
    skos:hiddenLabel "Pharmacovigilance Signalling"@en,
        "Safety Signal Identification"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-ES-RWE-014" ;
    skos:prefLabel "Signal Detection"@en ;
    heo:classifiedUnder hewc:real-world-evidence ;
    heo:partOf hewc:pharmacovigilance ;
    heo:precedes hewc:risk-evaluation,
        hewc:signal-evaluation ;
    heo:produces hewc:safety-signal ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en ;
    heo:uses hewc:post-marketing-surveillance .

hewc:small-study-effects a skos:Concept ;
    rdfs:label "Small Study Effects"@en ;
    dcterms:identifier "HE-EM-UA-066" ;
    dcterms:source "Sterne, Gavaghan & Egger 2000" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:broader hewc:economic-modelling ;
    skos:definition "A pattern in meta-analysis where smaller studies tend to report systematically larger treatment effects than larger studies, possibly reflecting publication bias."@en ;
    skos:hiddenLabel "Small Trial Effect"@en,
        "Small-Study Bias"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-EM-UA-066" ;
    skos:prefLabel "Small Study Effects"@en ;
    heo:classifiedUnder hewc:economic-modelling ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en ;
    heo:threatensValidityOf hewc:meta-analysis .

hewc:structural-quality a skos:Concept ;
    rdfs:label "Structural Quality"@en ;
    dcterms:identifier "HS-HP-HQ-045" ;
    dcterms:source "Donabedian A. Evaluating the quality of medical care. Milbank Memorial Fund Quarterly. 1966;44(3):166-206. doi:10.2307/3348969." ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:broader hewc:quality-of-care ;
    skos:definition "A healthcare quality dimension focused on available resources and organisational characteristics, such as staffing and equipment, unlike process or outcomes."@en ;
    skos:hiddenLabel "Facility-Level Quality"@en,
        "Structure-of-Care Quality"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HS-HP-HQ-045" ;
    skos:prefLabel "Structural Quality"@en ;
    heo:classifiedUnder hewc:quality-of-care ;
    heo:partOf hewc:quality-of-care ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en .

hewc:structured-expert-judgment a skos:Concept ;
    rdfs:label "Structured Expert Judgment"@en ;
    dcterms:identifier "HE-EM-VI-032" ;
    dcterms:source "Cooke 1991" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:altLabel "SEJ"@en ;
    skos:broader hewc:expert-elicitation ;
    skos:definition "A formal, methodologically rigorous approach to eliciting and combining expert opinion, with explicit protocols for framing, elicitation, and aggregation."@en ;
    skos:hiddenLabel "Classical Model Elicitation"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-EM-VI-032" ;
    skos:prefLabel "Structured Expert Judgment"@en ;
