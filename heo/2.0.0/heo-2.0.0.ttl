    heo:classifiedUnder hewc:evidence-synthesis ;
    heo:isFoundationFor hewc:public-health ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en ;
    heo:uses hewc:causal-inference,
        hewc:disease-surveillance,
        hewc:incidence .

hewc:health-economics a skos:Concept ;
    rdfs:label "Health Economics"@en ;
    dcterms:identifier "HE-FD-HE-001" ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:source "Culyer & Newhouse 2000" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.1" ;
    skos:altLabel "Economics of Health"@en,
        "Health Care Economics"@en ;
    skos:definition "Health economics studies how scarce resources are best used to provide healthcare and improve health, and how the costs and benefits are shared in society."@en ;
    skos:exactMatch <http://www.wikidata.org/entity/Q31218> ;
    skos:hiddenLabel "Health Economic Analysis"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-FD-HE-001" ;
    skos:prefLabel "Health Economics"@en ;
    skos:topConceptOf <https://healtheconomics.wiki/ontologies/heo> ;
    heo:evaluates hewc:health-system ;
    heo:informs hewc:health-policy,
        hewc:health-technology-assessment,
        hewc:resource-allocation ;
    heo:reviewStatus "Expert verified"@en ;
    heo:uses hewc:economic-evaluation,
        hewc:grossman-model,
        hewc:opportunity-cost,
        hewc:qaly,
        hewc:welfare-economics ;
    heo:verifiedBy "Dr Darrin Baines" .

heo:threatensValidityOf a owl:AnnotationProperty ;
