    heo:isTypeOf hewc:simulation-model,
        hewc:state-transition-model ;
    heo:produces hewc:cohort-trace,
        hewc:state-occupancy ;
    heo:reviewStatus "Expert verified"@en ;
    heo:uses hewc:transition-probability ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:clinical-trial a skos:Concept ;
