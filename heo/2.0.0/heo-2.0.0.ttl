    skos:hiddenLabel "Continued Viability"@en,
        "Enduring Capacity"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HS-HP-HF-077" ;
    skos:prefLabel "Sustainability"@en ;
    heo:classifiedUnder hewc:health-system-financing ;
    heo:isPropertyOf hewc:health-system ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en .

heo:manages a owl:AnnotationProperty ;
    rdfs:label "Manages"@en ;
    rdfs:comment "Descriptive link for people to read (no inference)."@en ;
    skos:definition "Subject is an activity, role, organisation or system that administers, organises or controls Object. For example, Waiting List Management manages Waiting List."@en ;
    skos:example "FDA Manages Investigational Device Exemption"@en ;
    skos:scopeNote "A conceptual association between meanings, not a measured effect in any population or setting. Actual effects, and the evidence for them, are described in RHEO and in the sources on the concept pages."@en ;
    heo:applicationUse heo:Navigation .

