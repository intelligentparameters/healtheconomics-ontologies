        hewc:mechanism-design,
        hewc:principal-agent-problem,
        hewc:supplier-induced-demand ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en .

hewc:allocation-concealment a skos:Concept ;
    rdfs:label "Allocation Concealment"@en ;
    dcterms:identifier "HE-ES-CTM-004" ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:source "Hopewell et al. 2025" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.4" ;
    skos:altLabel "Concealed Allocation"@en,
        "Concealment of Allocation"@en ;
    skos:broader hewc:evidence-synthesis ;
    skos:definition "Allocation concealment hides the next assignment in a randomised trial from recruiters until allocation, protecting the treatment effects that inform HTA."@en ;
    skos:hiddenLabel "Allocation Masking"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-ES-CTM-004" ;
    skos:prefLabel "Allocation Concealment"@en ;
    heo:classifiedUnder hewc:evidence-synthesis ;
    heo:coreConceptIn <https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-1> ;
    heo:partOf hewc:randomization ;
    heo:precedes hewc:blinding ;
    heo:reduces hewc:selection-bias ;
    heo:reviewStatus "Expert verified"@en ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:analytical-method a skos:Concept ;
    rdfs:label "Closed-Form Analytical Method"@en ;
    dcterms:identifier "HE-EM-UA-001" ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:source "Sonnenberg & Beck 1993" ;
