hewc:cost-effectiveness-policy a skos:Concept ;
    rdfs:label "Cost-Effectiveness Policy"@en ;
    dcterms:identifier "HS-HP-PA-003" ;
    dcterms:source "Claxton et al. 2015" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
