    heo:classifiedUnder hewc:evidence-assessment ;
    heo:isPropertyOf hewc:health-economic-model ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en .

hewc:treatment-network a skos:Concept ;
    rdfs:label "Treatment Network"@en ;
    dcterms:identifier "HE-ES-ESM-062" ;
    dcterms:source "Dias et al. 2013" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:broader hewc:evidence-synthesis ;
    skos:definition "The complete set of treatments and connecting trials forming the basis for a network meta-analysis, typically shown as nodes and connecting lines."@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-ES-ESM-062" ;
    skos:prefLabel "Treatment Network"@en ;
    heo:classifiedUnder hewc:evidence-synthesis ;
    heo:partOf hewc:network-meta-analysis ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en ;
    heo:setsScopeOf hewc:treatment-ranking .

hewc:treatment-ranking a skos:Concept ;
    rdfs:label "Treatment Ranking"@en ;
    dcterms:identifier "HE-ES-ESM-063" ;
    dcterms:source "Salanti, Ades & Ioannidis 2011" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:broader hewc:evidence-synthesis ;
    skos:definition "The ordering of treatments in a network meta-analysis by estimated relative effectiveness, often summarised using measures such as SUCRA or P-scores."@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-ES-ESM-063" ;
    skos:prefLabel "Treatment Ranking"@en ;
    heo:classifiedUnder hewc:evidence-synthesis ;
    heo:informs hewc:treatment-selection ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en .

hewc:unbundled-payment a skos:Concept ;
