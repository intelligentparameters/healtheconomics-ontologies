hewc:discounting-health a skos:Concept ;
    rdfs:label "Discounting Health"@en ;
    dcterms:identifier "HE-EE-DC-006" ;
    dcterms:source "Parsonage & Neuburger 1992" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:broader hewc:discounting ;
    skos:definition "The application of a discount rate to future health outcomes within an economic evaluation, converting them into a common present-day value."@en ;
    skos:hiddenLabel "Health Outcome Discounting"@en,
        "Present-Valuing Benefits"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-EE-DC-006" ;
    skos:prefLabel "Discounting Health"@en ;
