    skos:prefLabel "Cohort Study"@en ;
    heo:isTypeOf hewc:longitudinal-design,
        hewc:observational-study ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en .

hewc:cointervention a skos:Concept ;
    rdfs:label "Cointervention"@en ;
    dcterms:identifier "HE-ES-CTM-114" ;
    dcterms:modified "2026-10-14"^^xsd:date ;
    dcterms:source "Hopewell et al. 2025" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.1" ;
    skos:altLabel "Co-intervention"@en ;
    skos:broader hewc:intervention ;
    skos:definition "A cointervention (co-intervention) is a treatment other than the one under study that trial participants receive; unequal use across arms can bias results."@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-ES-CTM-114" ;
    skos:prefLabel "Cointervention"@en ;
