        "Inpatient Intake Count"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HS-NHS-HSP-002" ;
    skos:prefLabel "Hospital Admissions"@en ;
    heo:classifiedUnder hewc:health-system-performance ;
    heo:measures hewc:service-utilisation ;
