    heo:contrastsWith hewc:net-present-value ;
    heo:coreConceptIn <https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-5> ;
    heo:counterpartOf hewc:return-on-investment ;
    heo:informs hewc:resource-allocation ;
    heo:reviewStatus "Expert verified"@en ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:benefit-incidence a skos:Concept ;
    rdfs:label "Benefit Incidence"@en ;
    dcterms:identifier "HS-HP-HE-009" ;
    dcterms:modified "2026-10-10"^^xsd:date ;
