hewc:community-rating a skos:Concept ;
    rdfs:label "Community Rating"@en ;
    dcterms:identifier "HS-HP-HI-041" ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:source "Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563?643. doi:10.1016/S1574-0064(00)80170-5." ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.2" ;
    skos:broader hewc:premium-setting ;
    skos:definition "Community rating is a health insurance pricing rule that stops premiums varying with health or claims, allowing at most limited variation by age or area."@en ;
    skos:hiddenLabel "Community-Rated Premium"@en,
        "Uniform Premium Setting"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HS-HP-HI-041" ;
    skos:prefLabel "Community Rating"@en ;
    heo:contrastsWith hewc:experience-rating,
        hewc:medical-underwriting,
        hewc:risk-rating ;
    heo:contributesTo hewc:adverse-selection,
        hewc:death-spiral,
        hewc:risk-selection ;
    heo:coreConceptIn <https://healtheconomics.wiki/knowledge-map/health-systems#step-2> ;
    heo:isTypeOf hewc:premium-setting ;
    heo:promotes hewc:risk-pooling ;
    heo:reviewStatus "Expert verified"@en ;
    heo:setsScopeOf hewc:premium-design ;
    heo:verifiedBy "Dr Darrin Baines" .

