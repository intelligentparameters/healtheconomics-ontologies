hewc:shadow-price-of-budget a skos:Concept ;
    rdfs:label "Shadow Price of Budget"@en ;
    dcterms:identifier "HE-EE-CA-074" ;
    dcterms:source "Weinstein & Zeckhauser 1973" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:broader hewc:shadow-price ;
