    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-PE-OO-018" ;
    skos:prefLabel "Progression-Free Survival"@en ;
    heo:abbreviation "PFS"@en ;
    heo:coreConceptIn <https://healtheconomics.wiki/knowledge-map/outcomes#step-1> ;
    heo:counterpartOf hewc:relapse-free-survival ;
    heo:isTypeOf hewc:surrogate-endpoint ;
    heo:measures hewc:disease-progression ;
    heo:reviewStatus "Expert verified"@en ;
    heo:usedToCalculate hewc:quality-adjusted-time-without-symptoms,
        hewc:time-without-symptoms-of-progression ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:random-error a skos:Concept ;
    rdfs:label "Random Error"@en ;
    dcterms:identifier "HE-DS-BV-026" ;
    dcterms:source "Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams & Wilkins; 2008." ;
