hewc:adoption-curve a skos:Concept ;
    rdfs:label "Health Technology Adoption Curve"@en ;
    dcterms:identifier "HS-HP-SS-002" ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:source "Dunn et al. 2012" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.5" ;
    skos:altLabel "Diffusion Curve"@en ;
    skos:broader hewc:budget-impact-analysis ;
    skos:definition "A health technology adoption curve shows how use of a new medicine or device grows over time, usually S-shaped: slow, then rapid, then levelling off."@en ;
