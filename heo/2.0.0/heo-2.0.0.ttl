    skos:prefLabel "Cost Outcome Description"@en ;
    heo:isTypeOf hewc:partial-economic-evaluation ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en .

hewc:coverage-error a skos:Concept ;
    rdfs:label "Coverage Error"@en ;
    dcterms:identifier "HE-DS-BV-009" ;
    dcterms:modified "2026-10-11"^^xsd:date ;
    dcterms:source "Mohorko et al. 2013" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.1" ;
    skos:broader hewc:non-sampling-error ;
    skos:definition "Coverage error arises when the sampling frame of a health survey or register misses part of the target population or includes people outside it."@en ;
    skos:hiddenLabel "Coverage Bias"@en,
        "Frame Error"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-DS-BV-009" ;
    skos:prefLabel "Coverage Error"@en ;
    heo:contrastsWith hewc:sampling-error ;
    heo:contributesTo hewc:selection-bias ;
    heo:isTypeOf hewc:non-sampling-error ;
    heo:reviewStatus "Expert verified"@en ;
    heo:verifiedBy "Dr Darrin Baines" .

