hewc:ceiling-effect a skos:Concept ;
    rdfs:label "Ceiling Effect"@en ;
    dcterms:identifier "HE-EE-HU-008" ;
    dcterms:modified "2026-10-09"^^xsd:date ;
    dcterms:source "Terwee et al. 2007" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.3" ;
    skos:broader hewc:measurement-error ;
    skos:definition "A ceiling effect is a measurement limitation in which many respondents score at the top of a health scale, so further improvement cannot be detected."@en ;
    skos:exactMatch <http://www.wikidata.org/entity/Q1181915> ;
    skos:hiddenLabel "Ceiling Limitation"@en,
        "Score Ceiling"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-EE-HU-008" ;
    skos:prefLabel "Ceiling Effect"@en ;
    heo:contrastsWith hewc:floor-effect ;
    heo:isTypeOf hewc:measurement-error ;
    heo:reduces hewc:responsiveness ;
    heo:reviewStatus "Expert verified"@en ;
    heo:threatensValidityOf hewc:eq-5d-3l,
        hewc:patient-reported-outcome ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:certification a skos:Concept ;
    rdfs:label "Certification"@en ;
    dcterms:identifier "HS-HP-HSR-007" ;
