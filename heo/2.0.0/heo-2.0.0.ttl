    skos:definition "Bootstrap standard error is the standard deviation of an estimate, such as mean trial cost, recalculated across many resamples of the observed data."@en ;
    skos:hiddenLabel "Resampled Standard Error"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-ES-SA-016" ;
    skos:prefLabel "Bootstrap Standard Error"@en ;
    heo:contrastsWith hewc:delta-method,
        hewc:jackknife-standard-error,
        hewc:robust-standard-error ;
