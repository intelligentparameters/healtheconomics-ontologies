hewc:controllable-cost a skos:Concept ;
    rdfs:label "Controllable Cost"@en ;
    dcterms:identifier "HE-EE-CA-015" ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:source "Franklin et al. 2019" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.2" ;
    skos:broader hewc:cost ;
    skos:definition "Controllable cost is a health service cost that a named budget holder can influence within the budget period, such as ward overtime or agency staffing."@en ;
    skos:hiddenLabel "Manageable Cost"@en,
        "Manager-Influenced Cost"@en ;
