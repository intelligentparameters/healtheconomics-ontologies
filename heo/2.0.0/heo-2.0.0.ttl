    skos:prefLabel "Price Indexation"@en ;
    heo:isTypeOf hewc:price-control ;
    heo:partOf hewc:drug-pricing ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en ;
    heo:uses hewc:health-price-index .

hewc:price-monitoring a skos:Concept ;
    rdfs:label "Price Monitoring"@en ;
    dcterms:identifier "HS-DC-DP-069" ;
    dcterms:source "Danzon 2018" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:broader hewc:drug-pricing ;
    skos:definition "The ongoing tracking of a drug's price over time and across markets, used to assess trends and inform policy or negotiation."@en ;
    skos:hiddenLabel "Price Surveillance"@en,
        "Price Tracking"@en ;
