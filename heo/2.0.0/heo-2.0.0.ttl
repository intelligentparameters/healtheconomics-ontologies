    owl:versionInfo "1.0.47" ;
    skos:broader hewc:simulation-model,
        hewc:state-transition-model ;
    skos:definition "A Markov model is a memoryless state-transition model used in economic evaluation: people move between health states each cycle, accruing costs and QALYs."@en ;
    skos:exactMatch <http://www.wikidata.org/entity/Q6771326> ;
    skos:hiddenLabel "Markov State Model"@en,
