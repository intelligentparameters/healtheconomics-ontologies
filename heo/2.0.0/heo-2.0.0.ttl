    heo:partOf hewc:cost-effectiveness-analysis ;
    heo:precedes hewc:icer ;
    heo:reviewStatus "Expert verified"@en ;
    heo:uses hewc:dominance ;
    heo:verifiedBy "Dr Darrin Baines" .

