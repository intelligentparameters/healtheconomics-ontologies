    rdfs:label "Informs"@en ;
    rdfs:comment "Descriptive link for people to read (no inference)."@en ;
    skos:definition "Subject provides information input to the decision/process Object (epistemic). (Absorbs former supports.)"@en ;
    skos:example "Economic Evaluation Informs Health Technology Assessment"@en ;
    heo:applicationUse heo:Navigation .

hewc:health-technology-assessment a skos:Concept ;
    rdfs:label "Health Technology Assessment"@en ;
    dcterms:identifier "HS-HP-HTA-100" ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:source "O’Rourke B, Oortwijn W, Schuller T, International Joint Task Group. The new definition of health technology assessment. Int J Technol Assess Health Care. 2020;36(3):187–190. doi:10.1017/S0266462320000215 | WHO. Health Technology Assessment of Medical Devices. 2nd ed. 2025. https://www.who.int/publications/i/item/9789240110878 | NICE. Health Technology Evaluations: The Manual. PMG36. https://www.nice.org.uk/process/pmg36 | European Commission. Implementation of Regulation (EU) 2021/2282. https://health.ec.europa.eu/health-technology-assessment/implementation-regulation-health-technology-assessment_en" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    rdfs:seeAlso <https://healtheconomics.wiki/subdomain/health-technology-assessment> ;
    owl:versionInfo "1.5.5" ;
    skos:altLabel "HTA"@en ;
    skos:broader hewc:health-economics ;
    skos:definition "Health technology assessment (HTA) evaluates the clinical, economic, social and ethical effects of a drug, test, device or procedure to guide its use."@en ;
    skos:editorialNote "In HEO this concept is the wiki subdomain Health Technology Assessment, directly under Health Economics. Concepts in that subdomain with no is-type-of parent are classified under it or under a concept within it."@en ;
    skos:exactMatch <http://www.wikidata.org/entity/Q1420413> ;
    skos:hiddenLabel "Technology Assessment"@en,
        "Technology Evaluation"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HS-HP-HTA-100" ;
    skos:prefLabel "Health Technology Assessment"@en ;
    heo:abbreviation "HTA"@en ;
    heo:addresses hewc:technological-imperative ;
    heo:classifiedUnder hewc:health-economics ;
    heo:coreConceptIn <https://healtheconomics.wiki/knowledge-map/health-technology-assessment#step-1> ;
    heo:evaluates hewc:added-therapeutic-value,
        hewc:added-value,
        hewc:clinical-utility,
        hewc:health-technology,
        hewc:safety ;
    heo:informs hewc:coverage-decision,
        hewc:decision,
        hewc:evidence-based-decision-making,
        hewc:health-policy ;
    heo:produces hewc:asmr-rating,
        hewc:draft-recommendation,
        hewc:guidance-document,
        hewc:hta-report,
        hewc:negative-recommendation,
        hewc:only-in-research,
        hewc:positive-recommendation,
        hewc:recommendation,
        hewc:smr-rating ;
    heo:reviewStatus "Expert verified"@en ;
    heo:uses hewc:deliberative-process,
        hewc:diagnostic-efficacy-hierarchy,
        hewc:health-economic-model,
        hewc:hta-core-model,
        hewc:network-meta-analysis-hta,
        hewc:real-world-evidence ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:health-systems a skos:Concept ;
    rdfs:label "Health Systems"@en ;
    dcterms:identifier "HS_SS_HS-024" ;
    dcterms:source "HealthEconomics.wiki subdomain page https://healtheconomics.wiki/subdomain/health-systems (read 16 Oct 2026)" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    rdfs:seeAlso <https://healtheconomics.wiki/subdomain/health-systems> ;
    skos:altLabel "Health Systems Economics"@en ;
    skos:broader hewc:health-economics ;
    skos:definition "Health systems is the area of health economics that studies how care is financed and organised, how providers are paid and how efficiently services turn resources into health."@en ;
    skos:editorialNote "In HEO this concept is the wiki subdomain Health Systems, directly under Health Economics. Concepts in that subdomain with no is-type-of parent are classified under it or under a concept within it."@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HS_SS_HS-024" ;
    skos:prefLabel "Health Systems"@en ;
    heo:classifiedUnder hewc:health-economics ;
    heo:partOf hewc:health-economics ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en .

heo:partOf a owl:ObjectProperty ;
    rdfs:label "Part of"@en ;
    rdfs:comment "Aligned in intent to ro:part_of. Object property with inverse heo:hasPart."@en ;
    owl:inverseOf heo:hasPart ;
    skos:definition "Subject is a component/constituent of Object."@en ;
    skos:example "Levels of Care Part of Health System"@en ;
    heo:applicationUse heo:FormalInference,
        heo:Navigation .

heo:contrastsWith a owl:AnnotationProperty ;
    rdfs:label "Contrasts with"@en ;
    rdfs:comment "Descriptive link for people to read (no inference)."@en ;
    skos:definition "Subject and Object are opposing or mutually-alternative concepts. Sub-property of skos:related."@en ;
    skos:example "Health Depreciation Contrasts with Health Investment"@en ;
    heo:applicationUse heo:Navigation .

heo:uses a owl:AnnotationProperty ;
    rdfs:label "Uses"@en ;
    rdfs:comment "Descriptive link for people to read (no inference)."@en ;
    skos:definition "Subject employs Object as a technique, model, or input."@en ;
    skos:example "Health in All Policies Uses Intersectoral Action"@en ;
    heo:applicationUse heo:Navigation .

heo:classifiedUnder a owl:ObjectProperty ;
    rdfs:label "classified under"@en ;
    rdfs:subPropertyOf skos:broader ;
    skos:definition "Places a concept in the subject structure of HealthEconomics.wiki (Health Economics, its subdomains and the concepts under them) when the concept has no is-type-of parent. It is a placement for finding and browsing, not a claim that the concept is a type of the concept it sits under."@en ;
    skos:example "Literature Search classified under Evidence Synthesis"@en ;
    skos:scopeNote "Placement comes from the wiki's live topic pages and, for concepts no topic lists, from the catalogue Level 1, 2 and 3 fields through a published mapping table. Each heo:classifiedUnder link is also stated as skos:broader, so SKOS tools that do not reason still show one tree. To read only is-type-of links, take the skos:broader links that are not also heo:classifiedUnder links."@en ;
    heo:applicationUse heo:Navigation .

skos:broader a owl:ObjectProperty .

skos:Concept a owl:Class .

<https://healtheconomics.wiki/ontologies/heo> a owl:Ontology,
        skos:ConceptScheme ;
    dcterms:created "2026-09-30"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    dcterms:description "A vocabulary of health economics concepts, with definitions and typed links between them, taken from HealthEconomics.wiki. Each concept is identified by a stable URI that serves as its permanent identifier. Concepts are SKOS concepts arranged by skos:broader under one top concept, Health Economics, and the wiki's subdomains; a concept with no is-type-of parent is placed in that subject structure with heo:classifiedUnder. Six relationships (part of, measures, used to calculate, treats, risk factor for, precedes) are OWL object properties with named inverses, and the others are descriptive annotation properties. HEO identifies concepts; its companion RHEO defines types classified within the Basic Formal Ontology. A concept and a type never share an identifier."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-11-08"^^xsd:date ;
    dcterms:publisher "Intelligent Parameters Ltd" ;
    dcterms:title "Health Economics Ontology (HEO)"@en ;
    vann:preferredNamespacePrefix "heo" ;
    vann:preferredNamespaceUri "https://healtheconomics.wiki/ontologies/heo#" ;
    rdfs:comment "Address policy: concepts live at https://healtheconomics.wiki/concept/<slug> (prefix hewc:); HEO's own terms at https://healtheconomics.wiki/ontologies/heo# (prefix heo:). Each prefix stands for one address only."@en,
        "Every link between two concepts has a permanent identifier (HEO-L-...), recorded as an OWL axiom annotation (dcterms:identifier); the ID is made from the two concepts and the link type, so it stays the same across versions. Concepts also record the learning pathway framework steps they sit on (heo:coreConceptIn, heo:optionalConceptIn)."@en,
        "Release 1.3.0 holds 4009 concepts in use and 1192 deprecated concepts kept so their URIs never break. Review status is recorded on each concept (heo:reviewStatus). In this release 1280 concepts with a full article are expert verified and 2729 dictionary entries are not yet expert verified. Inclusion in HEO does not mean that a concept has been expert verified."@en,
        "Version 1.3.1 changes the file layout only. Every concept, definition and relationship is the same as in 1.3.0. The OWL file is now written in the standard flat layout, with the ontology header, property declarations and concepts at the top level."@en ;
    rdfs:comment "Version 2.0.0 moves every HEO address from https://healtheconomics.wiki/ontology/heo to https://healtheconomics.wiki/ontologies/heo, so the ontology identifier, its version identifier and HEO's own terms (prefix heo:) match the ontology page on the site. Concept addresses (https://healtheconomics.wiki/concept/<slug>) do not change. Every concept, definition and relationship is the same as in 1.3.1. The old /ontology/ addresses are retired and are not redirected." ;
    rdfs:seeAlso <https://healtheconomics.wiki/> ;
    owl:priorVersion <https://healtheconomics.wiki/ontology/heo/1.3.1> ;
    owl:versionIRI <https://healtheconomics.wiki/ontologies/heo/2.0.0> ;
    owl:versionInfo "2.0.0" ;
    skos:editorialNote "Reading convention (1.1.0): every link between two HEO concepts is a conceptual or methodological association between meanings, never an unrestricted factual claim about particular people, organisations or events. Links such as treats, risk factor for and performs carry a scope note saying how to read them and point to the RHEO relations for real-world statements. Application contract: each HEO link type has heo:applicationUse values (navigation, learning, formal inference). skos:broader is the navigation tree and holds two kinds of link, is-type-of links (heo:isTypeOf, also used for formal inference) and placement links (heo:classifiedUnder, navigation only); skos:related is used only for navigation. Learning activities use only links whose heo:linkReviewStatus is machine-reviewed or curator-approved; navigation may show unreviewed links but marks them as unreviewed. A link whose subject is a named organisation, law or instrument (for example NICE or FDA) is a dated factual claim: it needs a source and a review date, and a link true only in the past is marked historical."@en ;
    skos:hasTopConcept hewc:health-economics ;
    skos:prefLabel "Health Economics Ontology (HEO)"@en ;
    skos:scopeNote "HEO concepts are units of meaning in health economics: what a term means and how it relates to other terms. They are not the real-world things those terms are about. Patients, care episodes, resources and other real-world entities and processes are described in the companion reality ontology RHEO. Links between HEO concepts state conceptual or methodological relations, not claims about events in the world or about the effects of treatments. Policy (Darrin Baines, 15 Oct 2026): HEO identifies concepts; RHEO defines types classified within the Basic Formal Ontology. A concept and its associated RHEO type have different identities, even when their names are similar: an HEO concept URI is never used as a RHEO type identifier, and each connection between them is stated explicitly in the RHEO to HEO mapping file."@en ;
    foaf:homepage <https://healtheconomics.wiki/ontologies/heo> .

