    heo:optionalConceptIn <https://healtheconomics.wiki/knowledge-map/economic-modelling#step-12> ;
    heo:produces hewc:expected-value ;
    heo:reviewStatus "Expert verified"@en ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:annualisation a skos:Concept ;
    rdfs:label "Annualisation"@en ;
    dcterms:identifier "HE-EE-CA-091" ;
    dcterms:modified "2026-10-14"^^xsd:date ;
    dcterms:source "Turner et al. 2023" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.0" ;
    skos:broader hewc:costs ;
    skos:definition "Annualisation is the conversion of a capital outlay into an equal yearly cost over the asset's useful life, using an annuity factor and the discount rate."@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-EE-CA-091" ;
    skos:prefLabel "Annualisation"@en ;
    heo:classifiedUnder hewc:costs ;
    heo:reviewStatus "Expert verified"@en ;
    heo:uses hewc:capital-cost,
        hewc:discount-rate,
        hewc:present-value ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:antithetic-variates a skos:Concept ;
    rdfs:label "Antithetic Variates"@en ;
    dcterms:identifier "HE-EM-UA-002" ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:source "Hammersley & Morton 1956" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.3" ;
    skos:altLabel "Antithetic Sampling"@en ;
    skos:broader hewc:variance-reduction ;
    skos:definition "Antithetic variates are a variance reduction method that pairs each random draw with its mirror image so errors tend to cancel in Monte Carlo simulation."@en ;
    skos:hiddenLabel "Antithetic Variables"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-EM-UA-002" ;
