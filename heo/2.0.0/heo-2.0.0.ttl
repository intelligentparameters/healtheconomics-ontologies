hewc:progression-free-survival a skos:Concept ;
    rdfs:label "Progression-Free Survival"@en ;
    dcterms:identifier "HE-PE-OO-018" ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source "Latimer 2013" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.0" ;
    skos:altLabel "PFS"@en ;
    skos:broader hewc:surrogate-endpoint ;
