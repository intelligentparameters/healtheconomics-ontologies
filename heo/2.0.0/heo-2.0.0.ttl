    skos:prefLabel "Average Cost Estimation"@en ;
    heo:contrastsWith hewc:marginal-cost-estimation ;
    heo:isTypeOf hewc:unit-cost-estimation ;
    heo:produces hewc:average-cost ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en .

