    heo:measures hewc:added-therapeutic-value ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en .

hewc:between-subject-variation a skos:Concept ;
    rdfs:label "Between-Subject Variation"@en ;
    dcterms:identifier "HE-ES-SA-013" ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:source "Fitzmaurice et al. 2011" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.2" ;
    skos:altLabel "Between-Person Variability"@en,
        "Inter-Individual Variation"@en ;
    skos:broader hewc:variance ;
    skos:definition "Between-subject variation is how much costs or outcomes differ from one patient to another, as opposed to variation in one person's repeated measurements."@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-ES-SA-013" ;
    skos:prefLabel "Between-Subject Variation"@en ;
    heo:contrastsWith hewc:parameter-uncertainty,
        hewc:within-subject-variation ;
    heo:counterpartOf hewc:first-order-uncertainty ;
    heo:isTypeOf hewc:variance ;
    heo:optionalConceptIn <https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3> ;
    heo:reviewStatus "Expert verified"@en ;
    heo:usedToCalculate hewc:intraclass-correlation ;
    heo:verifiedBy "Dr Darrin Baines" .

