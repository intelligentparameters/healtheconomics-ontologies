hewc:bayesian-analysis a skos:Concept ;
    rdfs:label "Bayesian Analysis"@en ;
    dcterms:identifier "HE-ES-SA-010" ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:source "Spiegelhalter 2004" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.2" ;
    skos:altLabel "Bayesian Inference"@en ;
    skos:broader hewc:statistical-method ;
    skos:definition "Bayesian analysis updates a prior distribution with data via Bayes' theorem to give a posterior, used in HTA for evidence synthesis and decision models."@en ;
    skos:hiddenLabel "Bayesian Statistics"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-ES-SA-010" ;
    skos:prefLabel "Bayesian Analysis"@en ;
    heo:assumes hewc:coherence ;
    heo:contrastsWith hewc:frequentist-analysis ;
    heo:coreConceptIn <https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3> ;
    heo:isTypeOf hewc:statistical-method ;
    heo:produces hewc:credible-interval,
        hewc:posterior-distribution,
        hewc:posterior-odds,
        hewc:posterior-probability ;
    heo:reviewStatus "Expert verified"@en ;
    heo:uses hewc:bayes-theorem,
        hewc:gibbs-sampling,
        hewc:markov-chain-monte-carlo,
        hewc:prior-distribution,
        hewc:prior-odds ;
    heo:verifiedBy "Dr Darrin Baines" .

