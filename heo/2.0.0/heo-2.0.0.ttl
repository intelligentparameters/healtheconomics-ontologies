    heo:isTypeOf hewc:discounting ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en ;
    heo:uses hewc:discount-rate .

hewc:discrimination-barrier a skos:Concept ;
    rdfs:label "Discrimination Barrier"@en ;
    dcterms:identifier "HS-SS-EQ-001" ;
    dcterms:source "Whitehead 1992" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:broader hewc:access-barrier ;
    skos:definition "An obstacle to healthcare arising from unfair treatment based on characteristics such as race, ethnicity, or disability, rather than clinical need."@en ;
    skos:hiddenLabel "Bias-Based Access Barrier"@en,
        "Discriminatory Barrier"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HS-SS-EQ-001" ;
    skos:prefLabel "Discrimination Barrier"@en ;
    heo:isTypeOf hewc:access-barrier ;
    heo:reduces hewc:access-to-care,
        hewc:health-equity ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en .

hewc:disease-control-rate a skos:Concept ;
    rdfs:label "Disease Control Rate"@en ;
    dcterms:identifier "HE-PE-OO-008" ;
    dcterms:source "Eisenhauer et al. 2009" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:altLabel "DCR"@en ;
    skos:broader hewc:outcomes ;
    skos:definition "A cancer outcome measure combining complete response, partial response, and stable disease rates, characterising the proportion whose disease did not progress."@en ;
    skos:hiddenLabel "Non-Progression Proportion"@en ;
