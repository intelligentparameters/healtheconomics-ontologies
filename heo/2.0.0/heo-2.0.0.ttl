    skos:definition "A closed-form analytical method solves a health economic model with a formula, such as a matrix inverse, instead of by simulation or random sampling."@en ;
    skos:hiddenLabel "Analytic Solution"@en,
        "Closed-Form Method"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
