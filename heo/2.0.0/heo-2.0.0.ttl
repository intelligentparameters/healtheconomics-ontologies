    skos:hiddenLabel "Care Reachability"@en,
        "Patient Reach"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HS-HP-HE-004" ;
    skos:prefLabel "Access to Care"@en ;
    heo:classifiedUnder hewc:health-policy ;
    heo:contributesTo hewc:universal-health-coverage ;
    heo:coreConceptIn <https://healtheconomics.wiki/knowledge-map/health-policy#step-4> ;
    heo:isPropertyOf hewc:health-system ;
    heo:reviewStatus "Expert verified"@en ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:coverage-decision a skos:Concept ;
    rdfs:label "Coverage Decision"@en ;
    dcterms:identifier "HS-HP-HTA-053" ;
    dcterms:modified "2026-10-11"^^xsd:date ;
    dcterms:source "Fontrier et al. 2022" ;
