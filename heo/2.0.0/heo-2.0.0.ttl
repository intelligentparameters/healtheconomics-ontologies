    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-EE-BIA-017" ;
    skos:prefLabel "Budget Overrun"@en ;
    heo:isTypeOf hewc:budget-variance ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en .

hewc:burden-of-illness a skos:Concept ;
