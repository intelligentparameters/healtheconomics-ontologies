    heo:usedToCalculate hewc:readmission-rate .

hewc:agency-relationship a skos:Concept ;
    rdfs:label "Principal-Agent Relationship"@en ;
    dcterms:identifier "HE-EE-ME-003" ;
    dcterms:source "Jensen & Meckling 1976" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:altLabel "Agency Relationship"@en ;
    skos:broader hewc:economic-foundations ;
    skos:definition "An arrangement in which one party, the agent, acts on behalf of another, the principal, whose interests may diverge due to differing incentives or information."@en ;
    skos:hiddenLabel "Agency Arrangement"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-EE-ME-003" ;
    skos:prefLabel "Principal-Agent Relationship"@en ;
