    heo:isTypeOf hewc:expert-elicitation ;
    heo:measures hewc:parameter-uncertainty ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en ;
    heo:uses hewc:seed-question .

hewc:study-level-covariate a skos:Concept ;
    rdfs:label "Study-Level Covariate"@en ;
    dcterms:identifier "HE-ES-ESM-056" ;
    dcterms:source "Dias et al. 2013" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:altLabel "Trial-Level Covariate"@en ;
    skos:broader hewc:evidence-synthesis ;
    skos:definition "A characteristic recorded at the level of an entire study, such as average patient age, used in meta-regression to explain heterogeneity."@en ;
    skos:hiddenLabel "Aggregate Covariate"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-ES-ESM-056" ;
    skos:prefLabel "Study-Level Covariate"@en ;
    heo:classifiedUnder hewc:evidence-synthesis ;
    heo:contributesTo hewc:between-study-heterogeneity ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en .

hewc:surrogate-decision-maker a skos:Concept ;
