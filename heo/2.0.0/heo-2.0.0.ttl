    skos:notation "HE-ES-CTM-026" ;
    skos:prefLabel "Dependent Censoring"@en ;
    heo:contrastsWith hewc:independent-censoring ;
    heo:contributesTo hewc:selection-bias ;
    heo:counterpartOf hewc:missing-not-at-random ;
    heo:isTypeOf hewc:censoring ;
    heo:optionalConceptIn <https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-1> ;
    heo:reviewStatus "Expert verified"@en ;
    heo:verifiedBy "Dr Darrin Baines" .

