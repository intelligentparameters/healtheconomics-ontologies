    skos:notation "HE-ES-SA-251" ;
    skos:prefLabel "Continuous Data"@en ;
    heo:classifiedUnder hewc:evidence-synthesis ;
    heo:prerequisiteFor hewc:linear-regression ;
    heo:reviewStatus "Expert verified"@en ;
    heo:usedToCalculate hewc:effect-size,
        hewc:mean,
        hewc:standard-deviation ;
    heo:verifiedBy "Dr Darrin Baines" .

