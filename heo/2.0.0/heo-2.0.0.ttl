    heo:reviewStatus "Expert verified"@en ;
    heo:usedToCalculate hewc:expected-value ;
    heo:uses hewc:conditional-probability ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:claims-adjudication a skos:Concept ;
