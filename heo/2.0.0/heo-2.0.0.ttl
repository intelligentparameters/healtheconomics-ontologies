    skos:broader hewc:statistical-method ;
    skos:definition "The delta method approximates the variance of a function of estimated parameters, such as an ICER or mean survival, using a first-order Taylor expansion."@en ;
    skos:exactMatch <http://www.wikidata.org/entity/Q1132714> ;
    skos:hiddenLabel "Delta Approximation"@en,
        "First-Order Approximation"@en,
