hewc:dominated-alternative a skos:Concept ;
    rdfs:label "Dominated Alternative"@en ;
    dcterms:identifier "HE-EE-CEA-022" ;
    dcterms:source "Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015." ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:altLabel "Dominated Option"@en ;
    skos:broader hewc:cost-effectiveness-analysis ;
    skos:definition "An intervention that is both more costly and less effective than another option, or a combination of options, and so should not be selected."@en ;
    skos:hiddenLabel "Inferior Alternative"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-EE-CEA-022" ;
    skos:prefLabel "Dominated Alternative"@en ;
