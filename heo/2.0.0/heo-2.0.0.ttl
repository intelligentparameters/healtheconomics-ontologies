    dcterms:identifier "HS-HP-HD-110" ;
    dcterms:source "Appelbaum & Grisso 1988" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:altLabel "Substitute Decision-Maker"@en ;
    skos:broader hewc:health-systems ;
    skos:definition "An individual authorised to make healthcare decisions on behalf of a patient lacking the capacity to make their own."@en ;
    skos:hiddenLabel "Patient Representative"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HS-HP-HD-110" ;
    skos:prefLabel "Surrogate Decision-Maker"@en ;
    heo:classifiedUnder hewc:health-systems ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en ;
    heo:uses hewc:best-interest-standard,
        hewc:substituted-judgment .

hewc:test-set a skos:Concept ;
    rdfs:label "Test Set"@en ;
    dcterms:identifier "HE-ES-SA-215" ;
    dcterms:source "Hastie, Tibshirani & Friedman 2009" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:altLabel "Holdout Set"@en,
        "Test Data"@en ;
    skos:broader hewc:evidence-synthesis ;
    skos:definition "A subset of data withheld from model building, used afterward to evaluate how well the model performs on data it has not seen."@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-ES-SA-215" ;
    skos:prefLabel "Test Set"@en ;
    heo:classifiedUnder hewc:evidence-synthesis ;
    heo:contrastsWith hewc:training-set ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en .

hewc:time-without-symptoms-of-progression a skos:Concept ;
    rdfs:label "Time Without Symptoms of Progression"@en ;
    dcterms:identifier "HE-EE-QALY-010" ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source "Gelber et al. 1989" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.0" ;
    skos:altLabel "TWiST"@en ;
    skos:broader hewc:outcomes ;
    skos:definition "A phase within the Q-TWiST framework covering the period free of significant treatment toxicity or disease progression symptoms, typically weighted highest."@en ;
    skos:hiddenLabel "Symptom-Free Progression-Free Time"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-EE-QALY-010" ;
    skos:prefLabel "Time Without Symptoms of Progression"@en ;
    heo:abbreviation "TWiST"@en ;
    heo:classifiedUnder hewc:outcomes ;
    heo:optionalConceptIn <https://healtheconomics.wiki/knowledge-map/outcomes#step-3> ;
    heo:partOf hewc:quality-adjusted-time-without-symptoms ;
    heo:reviewStatus "Expert verified"@en ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:transparency a skos:Concept ;
    rdfs:label "Transparency"@en ;
    dcterms:identifier "HE-ES-EA-042" ;
    dcterms:source "Eddy DM, Hollingworth W, Caro JJ, et al. Model transparency and validation: a report of the ISPOR-SMDM Modeling Good Research Practices Task Force-7. Value in Health. 2012;15(6):843-850. doi:10.1016/j.jval.2012.04.012." ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:broader hewc:evidence-assessment ;
