hewc:cure-fraction-model a skos:Concept ;
    rdfs:label "Cure Fraction Model"@en ;
    dcterms:identifier "HE-EM-SM-012" ;
    dcterms:modified "2026-09-21"^^xsd:date ;
    dcterms:source "Boag 1949" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.0" ;
    skos:altLabel "Split-Population Model"@en ;
    skos:broader hewc:cure-model ;
    skos:definition "A survival model separating a population into a cured subgroup facing only background mortality and an uncured subgroup remaining at risk of the disease event."@en ;
    skos:hiddenLabel "Cured-Fraction Survival Model"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-EM-SM-012" ;
    skos:prefLabel "Cure Fraction Model"@en ;
    heo:isTypeOf hewc:cure-model ;
    heo:optionalConceptIn <https://healtheconomics.wiki/knowledge-map/economic-modelling#step-5> ;
    heo:reviewStatus "Expert verified"@en ;
    heo:uses hewc:background-mortality,
        hewc:cure-fraction ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:cure-rate-model a skos:Concept ;
    rdfs:label "Cure Rate Model"@en ;
    dcterms:identifier "HE-EM-SM-014" ;
    dcterms:modified "2026-10-03"^^xsd:date ;
    dcterms:source "Latimer & Rutherford 2024" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.2" ;
    skos:broader hewc:cure-model ;
