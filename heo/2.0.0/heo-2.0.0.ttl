hewc:confounding-by-indication a skos:Concept ;
    rdfs:label "Confounding by Indication"@en ;
    dcterms:identifier "HE-DS-BV-008" ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:source "Lund et al. 2015" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.2" ;
    skos:altLabel "Indication Bias"@en ;
    skos:broader hewc:confounding ;
    skos:definition "Confounding by indication is bias in observational treatment studies arising when the reason a patient is treated also affects their risk of the outcome."@en ;
    skos:hiddenLabel "Channelling Bias"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-DS-BV-008" ;
    skos:prefLabel "Confounding by Indication"@en ;
