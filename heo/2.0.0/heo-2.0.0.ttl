hewc:dominance-analysis a skos:Concept ;
    rdfs:label "Dominance Analysis"@en ;
    dcterms:identifier "HE-EE-CEA-021" ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source "Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015." ;
