hewc:tarone-ware-test a skos:Concept ;
    rdfs:label "Tarone-Ware Test"@en ;
    dcterms:identifier "HE-EM-SM-085" ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source "Tarone & Ware 1977" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.0" ;
    skos:altLabel "Tarone-Ware Statistic"@en ;
    skos:broader hewc:weighted-log-rank ;
    skos:definition "A test comparing survival distributions using a weighting scheme between the log-rank and Peto tests, a compromise depending on when treatment differences emerge."@en ;
    skos:hiddenLabel "Tarone-Ware Weighting"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-EM-SM-085" ;
    skos:prefLabel "Tarone-Ware Test"@en ;
    heo:contrastsWith hewc:log-rank-test,
        hewc:wilcoxon-test ;
    heo:isTypeOf hewc:weighted-log-rank ;
    heo:optionalConceptIn <https://healtheconomics.wiki/knowledge-map/economic-modelling#step-5> ;
    heo:reviewStatus "Expert verified"@en ;
    heo:verifiedBy "Dr Darrin Baines" .

