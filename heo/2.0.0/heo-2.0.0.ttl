        hewc:scenario-analysis ;
    heo:classifiedUnder hewc:economic-modelling ;
    heo:contrastsWith hewc:best-case-scenario ;
    heo:coreConceptIn <https://healtheconomics.wiki/knowledge-map/economic-modelling#step-10> ;
    heo:partOf hewc:economic-evaluation ;
    heo:reviewStatus "Expert verified"@en ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:behavioural-theory a skos:Concept ;
