hewc:first-order-index a skos:Concept ;
    rdfs:label "First-Order Index"@en ;
    dcterms:identifier "HE-EM-UA-067" ;
    dcterms:modified "2026-09-23"^^xsd:date ;
    dcterms:source "Sobol 2001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.0" ;
    skos:altLabel "First-Order Sensitivity Index"@en,
        "First-Order Sobol Index"@en,
        "S1"@en,
        "Sobol First-Order Index"@en ;
    skos:broader hewc:sobol-indices ;
    skos:definition "A first-order index in variance-based sensitivity analysis is the fraction of model-output variance explained by changes in the conditional mean when one uncertain input varies on its own under the specified input distribution."@en ;
    skos:hiddenLabel "Main-Effect Sensitivity Index"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-EM-UA-067" ;
    skos:prefLabel "First-Order Index"@en ;
    heo:abbreviation "S1"@en ;
    heo:contrastsWith hewc:total-effect-index ;
    heo:isTypeOf hewc:sobol-indices ;
    heo:measures hewc:parameter-importance ;
    heo:optionalConceptIn <https://healtheconomics.wiki/knowledge-map/economic-modelling#step-10> ;
    heo:reviewStatus "Expert verified"@en ;
    heo:verifiedBy "Dr Darrin Baines" .

