    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HS-HP-HD-030" ;
    skos:prefLabel "Consent Capacity"@en ;
    heo:classifiedUnder hewc:health-systems ;
    heo:contrastsWith hewc:competence ;
    heo:partOf hewc:informed-consent ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en .

