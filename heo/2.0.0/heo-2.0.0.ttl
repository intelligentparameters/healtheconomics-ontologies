    heo:reviewStatus "Dictionary entry, not yet expert verified"@en .

hewc:sampling-error a skos:Concept ;
    rdfs:label "Sampling Error"@en ;
    dcterms:identifier "HE-DS-BV-032" ;
    dcterms:source "Groves et al. 2009" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:broader hewc:random-error ;
    skos:definition "The difference between a sample statistic and the true population value arising purely from studying a finite sample rather than the whole population."@en ;
    skos:exactMatch <http://www.wikidata.org/entity/Q3306280> ;
    skos:hiddenLabel "Random Sampling Variation"@en,
        "Sample Variability"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-DS-BV-032" ;
    skos:prefLabel "Sampling Error"@en ;
    heo:contrastsWith hewc:systematic-error ;
    heo:isTypeOf hewc:random-error ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en .

hewc:scree-plot a skos:Concept ;
    rdfs:label "Scree Plot"@en ;
    dcterms:identifier "HE-ES-SA-190" ;
    dcterms:source "Cattell 1966" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:broader hewc:data-visualisation ;
    skos:definition "A graphical tool in factor analysis plotting eigenvalues in descending order to identify a visible point where they level off."@en ;
    skos:exactMatch <http://www.wikidata.org/entity/Q60526233> ;
    skos:hiddenLabel "Eigenvalue Plot"@en,
        "Scree Diagram"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-ES-SA-190" ;
    skos:prefLabel "Scree Plot"@en ;
    heo:isTypeOf hewc:data-visualisation ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en ;
