    skos:altLabel "DTM"@en ;
    skos:broader hewc:transmission-model ;
    skos:definition "A dynamic transmission model represents how an infectious disease spreads through a population while the risk of infection changes with the number and characteristics of infectious people."@en ;
    skos:hiddenLabel "Dynamic Infection Model"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-EM-DM-027" ;
