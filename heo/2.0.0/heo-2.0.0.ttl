    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-DS-BV-026" ;
    skos:prefLabel "Random Error"@en ;
    heo:classifiedUnder hewc:evidence-synthesis ;
    heo:contrastsWith hewc:systematic-error ;
    heo:contributesTo hewc:regression-to-mean ;
    heo:reduces hewc:precision ;
