    skos:prefLabel "Common Cost Allocation"@en ;
    heo:addresses hewc:joint-cost ;
    heo:isTypeOf hewc:cost-allocation ;
    heo:partOf hewc:cost-finding ;
    heo:reviewStatus "Expert verified"@en ;
    heo:usedToCalculate hewc:unit-cost ;
    heo:uses hewc:cost-driver ;
    heo:verifiedBy "Dr Darrin Baines" .

