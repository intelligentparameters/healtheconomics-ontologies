heo:isFoundationFor a owl:AnnotationProperty ;
    rdfs:label "Is foundation for"@en ;
    rdfs:comment "Descriptive link for people to read (no inference)."@en ;
    skos:definition "Subject is a basic idea on which Object is built. For example, Scarcity is the foundation for Opportunity Cost."@en ;
    skos:example "Mean Squared Error Is foundation for Bias-Variance Tradeoff"@en ;
    heo:applicationUse heo:Learning,
        heo:Navigation .

heo:reduces a owl:AnnotationProperty ;
    rdfs:label "Reduces"@en ;
    rdfs:comment "Descriptive link for people to read (no inference)."@en ;
    skos:definition "Subject lowers, caps or restricts the amount, frequency or use of Object. The negative counterpart of contributesTo. For example, Premium Subsidy reduces Premium."@en ;
    skos:example "Health Information Block Reduces Interoperability"@en ;
    skos:scopeNote "A conceptual association between meanings, not a measured effect in any population or setting. Actual effects, and the evidence for them, are described in RHEO and in the sources on the concept pages."@en ;
    heo:applicationUse heo:Navigation .

heo:setsScopeOf a owl:AnnotationProperty ;
    rdfs:label "Sets the scope of"@en ;
    rdfs:comment "Descriptive link for people to read (no inference)."@en ;
    skos:definition "Subject determines what falls inside Object, or the conditions under which Object applies. For example, Perspective sets the scope of Cost (which costs are counted)."@en ;
    skos:example "Market Structure Sets the scope of Cost Shifting"@en ;
    heo:applicationUse heo:Navigation .

heo:evaluates a owl:AnnotationProperty ;
    rdfs:label "Evaluates"@en ;
    rdfs:comment "Descriptive link for people to read (no inference)."@en ;
    skos:definition "Subject appraises or assesses Object (e.g. HTA evaluates Health Technology)."@en ;
    skos:example "Hypertension Control Rate Evaluates Hypertension Management"@en ;
    heo:applicationUse heo:Navigation .

hewc:economic-modelling a skos:Concept ;
    rdfs:label "Economic Modelling"@en ;
    dcterms:identifier "HE-EM-DM-108" ;
    dcterms:source "HealthEconomics.wiki subdomain page https://healtheconomics.wiki/subdomain/economic-modelling (read 16 Oct 2026)" ;
