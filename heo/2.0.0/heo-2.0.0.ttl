hewc:dose-reduction a skos:Concept ;
    rdfs:label "Dose Reduction"@en ;
    dcterms:identifier "HE-PE-DT-012" ;
    dcterms:source "DeVita, Lawrence & Rosenberg 2019" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:broader hewc:evidence-synthesis ;
    skos:definition "A decrease in the amount of medication given relative to the originally planned dose, typically in response to observed toxicity."@en ;
