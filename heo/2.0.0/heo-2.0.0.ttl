    dcterms:identifier "HS-HP-PP-033" ;
    dcterms:source "CMS, Medicare Payment Systems" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:broader hewc:cost-containment ;
