hewc:reporting-bias a skos:Concept ;
    rdfs:label "Reporting Bias"@en ;
    dcterms:identifier "HE-DS-BV-028" ;
    dcterms:source "Chan et al. 2004" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
