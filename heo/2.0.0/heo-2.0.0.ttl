    skos:notation "HE-EM-MV-077" ;
    skos:prefLabel "System Testing"@en ;
    heo:contrastsWith hewc:unit-testing ;
    heo:isTypeOf hewc:software-verification,
        hewc:testing ;
    heo:partOf hewc:technical-verification ;
    heo:precedes hewc:acceptance-testing ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en .

