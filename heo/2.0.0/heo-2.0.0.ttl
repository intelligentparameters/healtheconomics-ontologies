    heo:coreConceptIn <https://healtheconomics.wiki/knowledge-map/economic-modelling#step-9> ;
    heo:evaluates hewc:parametric-survival-model ;
    heo:measures hewc:goodness-of-fit ;
    heo:reviewStatus "Expert verified"@en ;
    heo:uses hewc:maximum-likelihood-estimation ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:before-and-after-study a skos:Concept ;
