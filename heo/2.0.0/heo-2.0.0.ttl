hewc:derived-demand-for-healthcare a skos:Concept ;
    rdfs:label "Derived Demand for Healthcare"@en ;
    dcterms:identifier "HE-EE-ME-018" ;
    dcterms:modified "2026-10-02"^^xsd:date ;
