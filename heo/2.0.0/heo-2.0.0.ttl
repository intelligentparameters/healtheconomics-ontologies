hewc:confidential-discount a skos:Concept ;
    rdfs:label "Confidential Discount"@en ;
    dcterms:identifier "HS-DC-DP-016" ;
    dcterms:source "Carlson JJ, Sullivan SD, Garrison LP, Neumann PJ, Veenstra DL. Linking payment to health outcomes: a taxonomy and examination of performance-based reimbursement schemes. Health Policy. 2010;96(3):179-190." ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:broader hewc:discount ;
    skos:definition "A price reduction negotiated privately between a manufacturer and payer, keeping a higher public list price while offering a lower net price."@en ;
    skos:hiddenLabel "Private Discount"@en,
        "Undisclosed Rebate"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HS-DC-DP-016" ;
    skos:prefLabel "Confidential Discount"@en ;
    heo:contrastsWith hewc:rebate ;
    heo:isTypeOf hewc:discount ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en ;
    heo:usedToCalculate hewc:confidential-price .

hewc:confidential-pricing a skos:Concept ;
    rdfs:label "Confidential Pricing"@en ;
    dcterms:identifier "HS-DC-DP-018" ;
    dcterms:modified "2026-10-10"^^xsd:date ;
