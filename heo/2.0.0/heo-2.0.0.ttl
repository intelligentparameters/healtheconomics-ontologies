    owl:versionInfo "1.0.2" ;
    skos:altLabel "Bounded Rationality"@en ;
    skos:broader hewc:behavioural-economics ;
    skos:definition "The bounded rationality concept holds that patients, clinicians and payers with limited information, time and computation settle for good enough options."@en ;
    skos:hiddenLabel "Satisficing"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-EE-BE-005" ;
