    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-ES-SA-046" ;
    skos:prefLabel "Delta Method"@en ;
    heo:assumes hewc:asymptotic-normality ;
    heo:contrastsWith hewc:bootstrapping,
        hewc:fieller-method ;
    heo:isTypeOf hewc:statistical-method ;
