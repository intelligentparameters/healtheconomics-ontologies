hewc:prevalence-difference a skos:Concept ;
    rdfs:label "Prevalence Difference"@en ;
    dcterms:identifier "HE-ES-RM-027" ;
    dcterms:source "Rothman KJ, Greenland S, Lash TL. Modern Epidemiology. 3rd ed. Lippincott Williams & Wilkins; 2008." ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:broader hewc:evidence-synthesis ;
    skos:definition "The absolute difference in the prevalence of a condition between two groups, giving a direct measure of disparity in disease burden."@en ;
    skos:hiddenLabel "Absolute Prevalence Gap"@en,
        "Prevalence Disparity"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-ES-RM-027" ;
    skos:prefLabel "Prevalence Difference"@en ;
    heo:classifiedUnder hewc:evidence-synthesis ;
    heo:contrastsWith hewc:prevalence-ratio ;
    heo:measures hewc:health-inequality ;
    heo:optionalConceptIn <https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-2> ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en .

hewc:price-cut a skos:Concept ;
    rdfs:label "Price Cut"@en ;
    dcterms:identifier "HS-DC-DP-064" ;
    dcterms:source "Danzon 2018" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:broader hewc:price-revision ;
    skos:definition "A reduction in a drug's price, whether voluntary or mandated, affecting a treatment's ongoing cost-effectiveness and overall budget impact."@en ;
    skos:hiddenLabel "Mandated Price Decrease"@en,
        "Price Lowering"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HS-DC-DP-064" ;
    skos:prefLabel "Price Cut"@en ;
    heo:contributesTo hewc:price-erosion ;
    heo:isTypeOf hewc:price-revision ;
    heo:reduces hewc:price ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en .

hewc:price-indexation a skos:Concept ;
    rdfs:label "Price Indexation"@en ;
    dcterms:identifier "HS-DC-DP-067" ;
    dcterms:source "Danzon 2018" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:broader hewc:price-control ;
    skos:definition "A mechanism tying a drug's allowed price increases to a specified inflation index, limiting growth to a predictable, generally modest rate."@en ;
    skos:hiddenLabel "Indexed Pricing"@en,
        "Price Linking"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
