    skos:notation "HE-PE-TI-032" ;
    skos:prefLabel "Symptomatic Treatment"@en ;
    heo:contrastsWith hewc:curative-therapy ;
    heo:isTypeOf hewc:supportive-therapy ;
    heo:partOf hewc:palliative-care ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en .

hewc:synthetic-control a skos:Concept ;
    rdfs:label "Synthetic Control"@en ;
    dcterms:identifier "HE-ES-SA-211" ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source "Abadie & Gardeazabal 2003" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.0" ;
    skos:broader hewc:statistical-method ;
    skos:definition "A quasi-experimental method constructing a weighted combination of untreated units to serve as a comparison group resembling a treated unit before intervention."@en ;
    skos:hiddenLabel "Data-Derived Control"@en,
        "Synthetic Comparator"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-ES-SA-211" ;
    skos:prefLabel "Synthetic Control"@en ;
    heo:classifiedUnder hewc:statistical-method ;
    heo:contrastsWith hewc:randomised-controlled-trial ;
    heo:optionalConceptIn <https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3> ;
    heo:reviewStatus "Expert verified"@en ;
    heo:uses hewc:real-world-data ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:system-testing a skos:Concept ;
    rdfs:label "System Testing"@en ;
    dcterms:identifier "HE-EM-MV-077" ;
    dcterms:source "Eddy DM, Hollingworth W, Caro JJ, et al. Model transparency and validation: a report of the ISPOR-SMDM Modeling Good Research Practices Task Force-7. Value in Health. 2012;15(6):843-850. doi:10.1016/j.jval.2012.04.012." ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:broader hewc:software-verification,
