    heo:classifiedUnder hewc:health-system-financing ;
    heo:partOf hewc:uncompensated-care ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en .

hewc:balance-billing-protection a skos:Concept ;
    rdfs:label "Balance Billing Protection"@en ;
    dcterms:identifier "HS-HP-HI-018" ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:source "US, No Surprises Act (Public Law 116-260, Division BB, Title I); 45 CFR Part 149" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.2" ;
    skos:broader hewc:regulation ;
    skos:definition "Balance billing protection is a legal rule that stops providers billing insured patients above in-network cost sharing, as under the US No Surprises Act."@en ;
    skos:hiddenLabel "No-Balance-Bill Rule"@en,
        "Surprise-Billing Protection"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HS-HP-HI-018" ;
    skos:prefLabel "Balance Billing Protection"@en ;
    heo:contributesTo hewc:financial-protection ;
    heo:isTypeOf hewc:regulation ;
    heo:reduces hewc:balance-billing,
        hewc:surprise-billing ;
    heo:reviewStatus "Expert verified"@en ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:balancing-measure a skos:Concept ;
