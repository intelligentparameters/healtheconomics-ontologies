    dcterms:identifier "HS-HP-SS-030" ;
    dcterms:source "Learned et al. 1969" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:altLabel "SWOT"@en,
        "Strengths-Weaknesses-Opportunities-Threats"@en ;
    skos:broader hewc:health-systems ;
    skos:definition "A strategic planning framework structuring an evaluation of internal strengths and weaknesses alongside external opportunities and threats."@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HS-HP-SS-030" ;
    skos:prefLabel "SWOT Analysis"@en ;
    heo:abbreviation "SWOT"@en ;
    heo:classifiedUnder hewc:health-systems ;
    heo:informs hewc:health-system-strengthening,
        hewc:market-access-strategy ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en .

hewc:symptom-frequency a skos:Concept ;
    rdfs:label "Symptom Frequency"@en ;
    dcterms:identifier "HE-ES-CO-083" ;
    dcterms:source "U.S. Food and Drug Administration. Guidance for Industry: Patient-Reported Outcome Measures-Use in Medical Product Development to Support Labeling Claims. FDA; 2009." ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:broader hewc:outcomes ;
    skos:definition "A dimension of symptom assessment capturing how often a particular symptom occurs over a defined recall period, distinct from its severity."@en ;
    skos:hiddenLabel "Symptom Occurrence"@en,
        "Symptom Rate"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-ES-CO-083" ;
    skos:prefLabel "Symptom Frequency"@en ;
    heo:classifiedUnder hewc:outcomes ;
    heo:contributesTo hewc:symptom-burden ;
    heo:partOf hewc:symptom-assessment ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en .

hewc:symptomatic-treatment a skos:Concept ;
