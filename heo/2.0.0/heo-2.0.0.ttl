hewc:efficiency-evaluation a skos:Concept ;
    rdfs:label "Efficiency Evaluation"@en ;
    dcterms:identifier "HE-EE_EA-017" ;
    dcterms:source "Farrell MJ. The measurement of productive efficiency. Journal of the Royal Statistical Society: Series A. 1957;120(3):253-290. doi:10.2307/2343100." ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:altLabel "Efficiency Assessment"@en ;
    skos:broader hewc:health-systems ;
