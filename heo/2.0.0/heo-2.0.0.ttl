    skos:notation "HS-HP-PP-009" ;
    skos:prefLabel "Billed Charges"@en ;
    heo:classifiedUnder hewc:provider-payment ;
    heo:contrastsWith hewc:allowed-amount ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en ;
    heo:usedToCalculate hewc:cost-to-charge-ratio .

hewc:biosimilar-uptake a skos:Concept ;
