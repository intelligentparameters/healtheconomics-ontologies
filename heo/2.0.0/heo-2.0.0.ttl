    skos:hiddenLabel "CapEx"@en,
        "Capital Expenditure"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-EE-CA-007" ;
    skos:prefLabel "Capital Cost"@en ;
    heo:isTypeOf hewc:fixed-cost ;
    heo:reviewStatus "Expert verified"@en ;
    heo:usedToCalculate hewc:total-cost,
        hewc:unit-cost ;
