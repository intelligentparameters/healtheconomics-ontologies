    skos:broader hewc:statistical-method ;
    skos:definition "Cluster analysis is an unsupervised method that sorts patients, providers or countries into groups whose members are more alike than those in other groups."@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-ES-SA-026" ;
    skos:prefLabel "Cluster Analysis"@en ;
    heo:contrastsWith hewc:latent-class-analysis ;
    heo:isTypeOf hewc:statistical-method ;
    heo:optionalConceptIn <https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3> ;
    heo:reviewStatus "Expert verified"@en ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:cluster-effect a skos:Concept ;
    rdfs:label "Cluster Effect"@en ;
    dcterms:identifier "HE-ES-SA-027" ;
    dcterms:modified "2026-10-09"^^xsd:date ;
    dcterms:source "Gomes et al. 2012" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.2" ;
    skos:altLabel "Clustering Effect"@en ;
    skos:broader hewc:evidence-synthesis ;
    skos:definition "A cluster effect is the tendency of patients in the same practice or hospital to have similar outcomes and costs, so their data are not independent."@en ;
    skos:exactMatch <http://www.wikidata.org/entity/Q383056> ;
    skos:hiddenLabel "Intracluster Correlation"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-ES-SA-027" ;
    skos:prefLabel "Cluster Effect"@en ;
    heo:classifiedUnder hewc:evidence-synthesis ;
    heo:contributesTo hewc:design-effect ;
    heo:reviewStatus "Expert verified"@en ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:cluster-randomization a skos:Concept ;
    rdfs:label "Cluster Randomization"@en ;
    dcterms:identifier "HE-ES-CTM-015" ;
    dcterms:modified "2026-10-09"^^xsd:date ;
    dcterms:source "Gomes et al. 2012" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.2" ;
    skos:altLabel "Cluster Randomisation"@en,
        "Group Randomisation"@en ;
    skos:broader hewc:randomization ;
    skos:definition "Cluster randomization allocates groups, such as hospitals or GP practices, to trial arms, so clinical and economic analyses must allow for clustering."@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-ES-CTM-015" ;
    skos:prefLabel "Cluster Randomization"@en ;
    heo:contrastsWith hewc:block-randomization ;
    heo:isTypeOf hewc:randomization ;
    heo:optionalConceptIn <https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-1> ;
    heo:reviewStatus "Expert verified"@en ;
    heo:uses hewc:design-effect,
        hewc:intraclass-correlation ;
    heo:verifiedBy "Dr Darrin Baines" .

