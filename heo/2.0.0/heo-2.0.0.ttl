hewc:coercion a skos:Concept ;
    rdfs:label "Coercion"@en ;
    dcterms:identifier "HS-HP-HSG-005" ;
    dcterms:modified "2026-10-09"^^xsd:date ;
    dcterms:source "National Commission 1979" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.2" ;
    skos:broader hewc:health-systems ;
    skos:definition "Coercion in health research is a threat of harm used to make someone take part against their will, so their consent is not voluntary and not valid."@en ;
    skos:hiddenLabel "Compelled Participation"@en,
        "Undue Pressure"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HS-HP-HSG-005" ;
    skos:prefLabel "Coercion"@en ;
    heo:classifiedUnder hewc:health-systems ;
    heo:contrastsWith hewc:undue-inducement ;
    heo:reviewStatus "Expert verified"@en ;
    heo:threatensValidityOf hewc:informed-consent ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:cognitively-impaired-research a skos:Concept ;
    rdfs:label "Cognitively Impaired Research"@en ;
    dcterms:identifier "HS-HP-HSG-006" ;
    dcterms:modified "2026-10-09"^^xsd:date ;
    dcterms:source "National Commission, Belmont Report 1979" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.2" ;
    skos:broader hewc:health-systems ;
    skos:definition "Cognitively impaired research is research with people whose impaired capacity may prevent valid consent, so proxy involvement and extra safeguards apply."@en ;
    skos:hiddenLabel "Diminished-Capacity Research"@en,
        "Research with Impaired Capacity"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HS-HP-HSG-006" ;
    skos:prefLabel "Cognitively Impaired Research"@en ;
    heo:classifiedUnder hewc:health-systems ;
    heo:reviewStatus "Expert verified"@en ;
    heo:uses hewc:capacity-assessment,
        hewc:surrogate-decision-maker ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:common-comparator a skos:Concept ;
    rdfs:label "Common Comparator"@en ;
    dcterms:identifier "HE-ES-ESM-006" ;
    dcterms:modified "2026-10-09"^^xsd:date ;
    dcterms:source "Jansen et al. 2011" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.2" ;
    skos:broader hewc:comparator ;
    skos:definition "A common comparator is a treatment, such as placebo or standard care, that two other treatments were each tested against, anchoring an indirect comparison."@en ;
    skos:hiddenLabel "Common Reference Treatment"@en,
        "Shared Comparator"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-ES-ESM-006" ;
    skos:prefLabel "Common Comparator"@en ;
    heo:isTypeOf hewc:comparator ;
    heo:partOf hewc:connected-network,
        hewc:network-meta-analysis ;
    heo:reviewStatus "Expert verified"@en ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:common-cost-allocation a skos:Concept ;
    rdfs:label "Common Cost Allocation"@en ;
    dcterms:identifier "HE-EE-CM-007" ;
    dcterms:modified "2026-10-09"^^xsd:date ;
    dcterms:source "Mogyorosy & Smith 2005" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.2" ;
    skos:broader hewc:cost-allocation ;
