        hewc:first-generic-entry,
        hewc:subsequent-generic-entry ;
    heo:promotes hewc:generic-drug ;
    heo:reviewStatus "Expert verified"@en ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:acceptability a skos:Concept ;
    rdfs:label "Acceptability of Healthcare"@en ;
    dcterms:identifier "HS-HP-HE-001" ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:source "Penchansky R, Thomas JW. The concept of access: definition and relationship to consumer satisfaction. Medical Care. 1981;19(2):127?140. doi:10.1097/00005650-198102000-00001." ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.2" ;
    skos:broader hewc:health-policy ;
    skos:definition "Acceptability is the dimension of access concerned with whether people find health services culturally, socially and personally appropriate enough to use."@en ;
    skos:hiddenLabel "Cultural Fit"@en,
        "Patient-Provider Fit"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HS-HP-HE-001" ;
    skos:prefLabel "Acceptability of Healthcare"@en ;
    heo:classifiedUnder hewc:health-policy ;
