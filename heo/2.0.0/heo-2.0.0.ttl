        hewc:special-access-scheme ;
    heo:promotes hewc:access-to-care ;
    heo:reviewStatus "Expert verified"@en ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:composite-endpoint a skos:Concept ;
