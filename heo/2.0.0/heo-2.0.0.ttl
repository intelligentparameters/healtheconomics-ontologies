        hewc:choice-architecture-intervention,
        hewc:decision-fatigue-concept,
        hewc:heuristics-concept,
        hewc:salience-intervention ;
    heo:reviewStatus "Expert verified"@en ;
    heo:verifiedBy "Dr Darrin Baines" .

