    heo:optionalConceptIn <https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3> ;
    heo:reviewStatus "Expert verified"@en ;
    heo:usedToCalculate hewc:confidence-interval ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:budget-cap a skos:Concept ;
    rdfs:label "Budget Cap"@en ;
    dcterms:identifier "HS-DC-DP-009" ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:source "Braendle & Colombier 2020" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.2" ;
    skos:altLabel "Budget Ceiling"@en,
        "Global Cap"@en,
        "Sector Cap"@en,
        "Spending Cap"@en ;
    skos:broader hewc:budget-constraint ;
    skos:definition "Budget cap is a preset ceiling on what a payer will spend on a sector, provider or medicines bill, enforced by fixed budgets, tariff cuts or rebates."@en ;
    skos:hiddenLabel "Aggregate Spending Cap"@en,
        "Payer Spending Limit"@en,
        "Programme Spending Cap"@en,
        "Reimbursement Cap"@en,
        "Sector Spending Limit"@en,
        "Sectoral Ceiling"@en,
        "Total Expenditure Ceiling"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HS-DC-DP-009" ;
    skos:prefLabel "Budget Cap"@en ;
    heo:contrastsWith hewc:volume-cap ;
    heo:isTypeOf hewc:budget-constraint ;
    heo:reviewStatus "Expert verified"@en ;
    heo:setsScopeOf hewc:clawback ;
    heo:uses hewc:fixed-budget ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:budget-overrun a skos:Concept ;
