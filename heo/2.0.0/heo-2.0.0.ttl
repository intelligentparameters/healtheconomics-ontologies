    skos:prefLabel "Value Score"@en ;
    heo:isTypeOf hewc:composite-measure ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en .

hewc:vertical-equity a skos:Concept ;
    rdfs:label "Vertical Equity"@en ;
    dcterms:identifier "HE-EE-WE-025" ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:source "Wagstaff & van Doorslaer 2000" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.2" ;
    skos:broader hewc:equity ;
    skos:definition "Vertical equity is the principle that those in greater need should get appropriately more care, and those more able to pay should pay more."@en ;
    skos:hiddenLabel "Unequal-Treatment-of-Unequals Equity"@en,
        "Vertical Fairness"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-EE-WE-025" ;
    skos:prefLabel "Vertical Equity"@en ;
    heo:contrastsWith hewc:vertical-inequity ;
    heo:coreConceptIn <https://healtheconomics.wiki/knowledge-map/health-policy#step-4> ;
    heo:isFoundationFor hewc:equity-weighted-analysis,
        hewc:progressive-financing ;
    heo:isTypeOf hewc:equity ;
    heo:reviewStatus "Expert verified"@en ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:volume-based-pricing a skos:Concept ;
    rdfs:label "Volume-Based Pricing"@en ;
    dcterms:identifier "HS-DC-DP-108" ;
    dcterms:source "Carlson JJ, Sullivan SD, Garrison LP, Neumann PJ, Veenstra DL. Linking payment to health outcomes: a taxonomy and examination of performance-based reimbursement schemes. Health Policy. 2010;96(3):179-190." ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:broader hewc:drug-pricing ;
    skos:definition "A pricing structure where the price paid per unit depends on total quantity purchased or used, typically decreasing as volume increases."@en ;
    skos:hiddenLabel "Quantity-Based Pricing"@en,
        "Volume Pricing"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HS-DC-DP-108" ;
    skos:prefLabel "Volume-Based Pricing"@en ;
    heo:contrastsWith hewc:value-based-pricing ;
    heo:isTypeOf hewc:drug-pricing ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en .

hewc:volume-control a skos:Concept ;
    rdfs:label "Volume Control"@en ;
    dcterms:identifier "HS-HP-HF-081" ;
    dcterms:source "Musgrave & Musgrave 1989" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:broader hewc:cost-containment ;
    skos:definition "Mechanisms used to manage or limit the total quantity of healthcare services delivered, such as capacity constraints or global budget caps."@en ;
    skos:hiddenLabel "Quantity Control"@en,
        "Volume Management"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HS-HP-HF-081" ;
    skos:prefLabel "Volume Control"@en ;
    heo:isTypeOf hewc:cost-containment ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en .

hewc:waiting-list a skos:Concept ;
    rdfs:label "Waiting List"@en ;
    dcterms:identifier "HS-HP-HSC-009" ;
    dcterms:source "Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015." ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:altLabel "Wait List"@en ;
    skos:broader hewc:health-systems ;
    skos:definition "An ordered list of patients awaiting a healthcare service, such as elective surgery, that exceeds available capacity to provide it."@en ;
    skos:hiddenLabel "Queue"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HS-HP-HSC-009" ;
    skos:prefLabel "Waiting List"@en ;
    heo:classifiedUnder hewc:health-systems ;
    heo:contributesTo hewc:waiting-time ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en .

hewc:whistleblower a skos:Concept ;
    rdfs:label "Whistleblower"@en ;
    dcterms:identifier "HS-HP-HSR-063" ;
    dcterms:source "US, False Claims Act (31 U.S.C. § 3729)" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:altLabel "Whistle-Blower"@en ;
    skos:broader hewc:health-systems ;
    skos:definition "An individual reporting suspected fraud, compliance violations, or misconduct within an organisation to an appropriate authority, sometimes via a lawsuit."@en ;
    skos:hiddenLabel "Disclosure of Wrongdoing"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HS-HP-HSR-063" ;
    skos:prefLabel "Whistleblower"@en ;
    heo:classifiedUnder hewc:health-systems ;
    heo:informs hewc:compliance-programme ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en .

heo:treats a owl:ObjectProperty ;
    rdfs:label "Treats"@en ;
    rdfs:comment "Object property with inverse heo:treatedBy."@en ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/RO_0000057>,
        <https://healtheconomics.wiki/ontologies/rheo/RHEO_1000001>,
        <https://healtheconomics.wiki/ontologies/rheo/RHEO_1000003>,
        <https://healtheconomics.wiki/ontologies/rheo/RHEO_1000029> ;
    owl:inverseOf heo:treatedBy ;
    skos:definition "Subject is used to treat the condition Object."@en ;
    skos:example "Monoclonal Antibody Treats Rheumatoid Arthritis"@en ;
    skos:scopeNote "A conceptual association, not a claim about a particular patient or provider. Read 'Cardiac Resynchronization treats Heart Failure' as: treating heart failure is part of what the concept Cardiac Resynchronization means. The concept itself treats no one; actual patients, devices and episodes of care are described in RHEO."@en ;
    heo:applicationUse heo:FormalInference,
        heo:Navigation .

hewc:abbreviated-new-drug-application a skos:Concept ;
