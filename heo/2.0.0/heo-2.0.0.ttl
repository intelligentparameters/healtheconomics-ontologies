    heo:reviewStatus "Expert verified"@en ;
    heo:usedToCalculate hewc:expected-net-benefit-of-sampling,
        hewc:optimal-sample-size,
        hewc:optimal-study-design ;
    heo:uses hewc:bayes-theorem,
