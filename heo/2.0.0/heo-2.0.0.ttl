        hewc:parameter-input ;
    heo:reviewStatus "Expert verified"@en ;
    heo:usedToCalculate hewc:absolute-risk-reduction,
        hewc:relative-risk ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:begg-test a skos:Concept ;
    rdfs:label "Begg Test"@en ;
    dcterms:identifier "HE-ES-ESM-003" ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:source "Begg & Mazumdar 1994" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.2" ;
    skos:altLabel "Begg Rank Correlation Test"@en,
        "Begg and Mazumdar Test"@en ;
    skos:broader hewc:publication-bias-assessment ;
    skos:definition "The Begg test is a rank correlation test (Kendall's tau) for small-study effects in a meta-analysis, a possible sign of publication bias."@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-ES-ESM-003" ;
    skos:prefLabel "Begg Test"@en ;
    heo:contrastsWith hewc:egger-test ;
    heo:counterpartOf hewc:funnel-plot ;
    heo:evaluates hewc:meta-analysis,
        hewc:small-study-effects ;
    heo:isTypeOf hewc:publication-bias-assessment ;
    heo:optionalConceptIn <https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-4> ;
    heo:reviewStatus "Expert verified"@en ;
    heo:uses hewc:kendall-tau ;
    heo:verifiedBy "Dr Darrin Baines" .

