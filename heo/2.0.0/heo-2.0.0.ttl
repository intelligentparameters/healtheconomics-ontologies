    heo:optionalConceptIn <https://healtheconomics.wiki/knowledge-map/economic-modelling#step-5> ;
    heo:produces hewc:cure-fraction ;
    heo:reviewStatus "Expert verified"@en ;
    heo:uses hewc:background-mortality ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:cytogenetic-response a skos:Concept ;
    rdfs:label "Cytogenetic Response"@en ;
    dcterms:identifier "HE-ES-CO-015" ;
    dcterms:source "Baccarani et al. 2013" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
