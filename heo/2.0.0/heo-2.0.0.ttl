hewc:pigouvian-subsidy a skos:Concept ;
    rdfs:label "Pigouvian Subsidy"@en ;
    dcterms:identifier "HE-EE-EP-022" ;
    dcterms:modified "2026-10-03"^^xsd:date ;
    dcterms:source "Goodkin-Gold et al. 2020" ;
