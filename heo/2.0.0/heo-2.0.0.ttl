    dcterms:identifier "HE-PE-OO-014" ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source "Latimer 2013" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.0" ;
    skos:altLabel "OS"@en ;
    skos:broader hewc:clinical-outcome ;
    skos:definition "Overall survival is the time from a prespecified origin, such as randomization, diagnosis, or treatment initiation, until death from any cause, with participants not known to have died censored at their last date known alive."@en ;
