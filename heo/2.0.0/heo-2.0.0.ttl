heo:abbreviation a owl:AnnotationProperty ;
    rdfs:label "abbreviation"@en ;
    rdfs:subPropertyOf skos:altLabel ;
    skos:definition "An acronym or short form of the concept's preferred name. Every abbreviation is also an alternative label."@en .

heo:applicationUse a owl:AnnotationProperty ;
    rdfs:label "application use"@en ;
    skos:definition "What applications may use this link type for: navigation (shown and followed by people), learning (drives learning order and activities) or formal inference (used by an OWL reasoner)."@en .

heo:coreConceptIn a owl:AnnotationProperty ;
    rdfs:label "core concept in"@en ;
    skos:definition "The concept is a core (must-learn) concept in this step of a learning pathway's framework."@en .

heo:isTypeOf a owl:ObjectProperty ;
    rdfs:label "is type of"@en ;
    rdfs:subPropertyOf skos:broader ;
    skos:definition "The subject concept is a kind of the object concept (the wiki's is type of link). Every heo:isTypeOf link is also stated as skos:broader."@en ;
    skos:example "Logistic Regression is type of Generalized Linear Model"@en ;
    heo:applicationUse heo:FormalInference,
        heo:Navigation .

heo:linkRationale a owl:AnnotationProperty ;
    rdfs:label "link rationale"@en ;
    skos:definition "Why the link holds, in one short line a reviewer can check."@en .

heo:linkReviewDate a owl:AnnotationProperty ;
    rdfs:label "link review date"@en ;
    skos:definition "When this link was last reviewed."@en .

heo:linkReviewStatus a owl:AnnotationProperty ;
    rdfs:label "link review status"@en ;
    skos:definition "Review status of this link, separate from the review of the two concepts it joins: unreviewed (not yet checked on its own), machine-reviewed (checked by an AI-assisted review against the link type's definition and both concepts' definitions, awaiting curator sign-off), curator-approved (checked and approved by a named curator)."@en .

heo:linkReviewer a owl:AnnotationProperty ;
    rdfs:label "link reviewer"@en ;
    skos:definition "Who reviewed this link."@en .

heo:optionalConceptIn a owl:AnnotationProperty ;
    rdfs:label "optional concept in"@en ;
    skos:definition "The concept is an optional concept in this step of a learning pathway's framework."@en .

heo:reviewStatus a owl:AnnotationProperty ;
    rdfs:label "review status"@en ;
    skos:definition "Whether the concept's page has been reviewed and verified by a named expert on HealthEconomics.wiki."@en .

heo:verifiedBy a owl:AnnotationProperty ;
    rdfs:label "verified by"@en ;
    skos:definition "The expert who last verified the concept's page."@en .

skos:ConceptScheme a owl:Class .

skos:altLabel a owl:AnnotationProperty .

hewc:anxiety-disorder-cost a skos:Concept ;
    rdfs:label "Anxiety Disorder Cost"@en ;
    dcterms:identifier "HE-PE-MH-004" ;
    dcterms:source "Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015." ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:broader hewc:economic-burden ;
    skos:definition "The total economic burden of anxiety disorders, covering direct treatment costs, lost workplace productivity, and broader impacts on quality of life."@en ;
    skos:hiddenLabel "Anxiety Burden"@en,
        "Cost of Anxiety"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-PE-MH-004" ;
    skos:prefLabel "Anxiety Disorder Cost"@en ;
    heo:isTypeOf hewc:economic-burden ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en .

hewc:cervical-cancer-screening a skos:Concept ;
    rdfs:label "Cervical Cancer Screening"@en ;
    dcterms:identifier "HE-PE-OP-006" ;
    dcterms:source "US Preventive Services Task Force" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:altLabel "Cervical Screening"@en ;
    skos:broader hewc:cancer-screening ;
    skos:definition "A public health strategy using cytology or HPV testing to detect precancerous changes or early cervical cancer, credited with substantially reducing incidence."@en ;
    skos:hiddenLabel "Pap Smear Screening"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-PE-OP-006" ;
    skos:prefLabel "Cervical Cancer Screening"@en ;
    heo:isTypeOf hewc:cancer-screening ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en .

