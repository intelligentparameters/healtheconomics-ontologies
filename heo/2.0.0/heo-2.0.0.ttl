    owl:versionInfo "1.0.2" ;
    skos:altLabel "Corrective Subsidy"@en ;
    skos:broader hewc:externality-correction,
        hewc:subsidy ;
    skos:definition "A Pigouvian subsidy is a payment for an activity that benefits others, set equal to its marginal external benefit at the socially efficient level."@en ;
    skos:hiddenLabel "Externality Subsidy"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-EE-EP-022" ;
    skos:prefLabel "Pigouvian Subsidy"@en ;
    heo:contrastsWith hewc:pigouvian-tax ;
    heo:isTypeOf hewc:externality-correction,
        hewc:subsidy ;
    heo:promotes hewc:positive-externality ;
    heo:reduces hewc:market-failure ;
    heo:reviewStatus "Expert verified"@en ;
    heo:verifiedBy "Dr Darrin Baines" .

