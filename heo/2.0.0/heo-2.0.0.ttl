hewc:markov-model a skos:Concept ;
    rdfs:label "Markov Model"@en ;
    dcterms:identifier "HE-EM-MM-014" ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:source "Sonnenberg & Beck 1993" ;
