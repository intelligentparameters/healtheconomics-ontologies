    skos:altLabel "Discharge Destination"@en ;
    skos:broader hewc:health-systems ;
    skos:definition "The specific destination a patient transitions to upon leaving hospital, such as home, a nursing facility, or hospice care."@en ;
    skos:hiddenLabel "Discharge Setting"@en ;
