    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:broader hewc:perspective ;
    skos:definition "An analytic viewpoint including only costs and outcomes relevant to private organisations, such as insurers or employers, excluding costs borne by public payers."@en ;
    skos:hiddenLabel "Commercial Viewpoint"@en,
