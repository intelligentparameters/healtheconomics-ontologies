    heo:uses hewc:bayesian-analysis,
        hewc:interim-analysis,
        hewc:monte-carlo-simulation,
        hewc:posterior-probability,
        hewc:prior-distribution ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:bayesian-analysis-cea a skos:Concept ;
    rdfs:label "Bayesian Analysis CEA"@en ;
    dcterms:identifier "HE-EM-UA-005" ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:source "O'Hagan & Stevens 2001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.2" ;
    skos:altLabel "Bayesian Cost-Effectiveness Analysis"@en ;
    skos:broader hewc:bayesian-analysis,
        hewc:cost-effectiveness-analysis ;
    skos:definition "Bayesian cost-effectiveness analysis updates prior evidence on costs and health effects with new data to estimate net benefit and decision uncertainty."@en ;
    skos:hiddenLabel "Bayesian CEA"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-EM-UA-005" ;
    skos:prefLabel "Bayesian Analysis CEA"@en ;
    heo:contrastsWith hewc:bootstrapping ;
    heo:isFoundationFor hewc:value-of-information ;
    heo:isTypeOf hewc:bayesian-analysis,
        hewc:cost-effectiveness-analysis ;
    heo:optionalConceptIn <https://healtheconomics.wiki/knowledge-map/economic-modelling#step-10> ;
    heo:produces hewc:ceac ;
    heo:reviewStatus "Expert verified"@en ;
    heo:uses hewc:markov-chain-monte-carlo,
        hewc:network-meta-analysis,
        hewc:prior-distribution,
        hewc:psa ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:bayesian-information-criterion a skos:Concept ;
    rdfs:label "Bayesian Information Criterion"@en ;
    dcterms:identifier "HE-EM-MV-004" ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:source "Schwarz 1978" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.2" ;
    skos:altLabel "BIC"@en,
        "Schwarz Criterion"@en ;
    skos:broader hewc:model-validation ;
    skos:definition "Bayesian information criterion (BIC) ranks models fitted to the same data, such as HTA survival curves, by fit with a penalty that grows with sample size."@en ;
    skos:exactMatch <http://www.wikidata.org/entity/Q1988242> ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-EM-MV-004" ;
    skos:prefLabel "Bayesian Information Criterion"@en ;
    heo:abbreviation "BIC"@en ;
    heo:classifiedUnder hewc:model-validation ;
