heo:calculatedFrom a owl:ObjectProperty ;
    rdfs:label "Calculated from"@en ;
    skos:definition "Inverse of 'Used to calculate'."@en ;
    heo:applicationUse heo:FormalInference,
        heo:Navigation .

heo:dependsOn a owl:AnnotationProperty ;
    rdfs:label "Depends on"@en ;
    rdfs:comment "Descriptive link for people to read (no inference). Aligned in intent to ro:depends_on."@en ;
    skos:definition "Subject functionally/logically depends on Object; Object must hold for Subject. (Absorbs former requires.)"@en ;
    skos:example "Network Meta-Analysis Depends on Connected Network"@en ;
    heo:applicationUse heo:Learning,
        heo:Navigation .

heo:follows a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "Follows"@en ;
    skos:definition "Inverse of 'Precedes'."@en ;
    heo:applicationUse heo:FormalInference,
        heo:Navigation .

heo:hasPart a owl:ObjectProperty ;
    rdfs:label "Has part"@en ;
    skos:definition "Inverse of 'Part of'."@en ;
    heo:applicationUse heo:FormalInference,
        heo:Navigation .

heo:hasRiskFactor a owl:ObjectProperty ;
    rdfs:label "Has risk factor"@en ;
    skos:definition "Inverse of 'Risk factor for'."@en ;
    heo:applicationUse heo:FormalInference,
        heo:Navigation .

heo:measuredBy a owl:ObjectProperty ;
    rdfs:label "Measured by"@en ;
    skos:definition "Inverse of 'Measures'."@en ;
    heo:applicationUse heo:FormalInference,
        heo:Navigation .

heo:treatedBy a owl:ObjectProperty ;
    rdfs:label "Treated by"@en ;
    skos:definition "Inverse of 'Treats'."@en ;
    heo:applicationUse heo:FormalInference,
        heo:Navigation .

