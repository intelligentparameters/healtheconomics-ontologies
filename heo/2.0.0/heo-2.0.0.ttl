hewc:simpson-rule a skos:Concept ;
    rdfs:label "Simpson Rule"@en ;
    dcterms:identifier "HE-EM-DM-089" ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source "Press et al. 2007" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.0" ;
    skos:altLabel "Simpson's Rule"@en ;
    skos:broader hewc:numerical-integration ;
    skos:definition "Simpson rule is a closed Newton-Cotes numerical integration formula that approximates a definite integral over pairs of equal subintervals by integrating quadratic interpolants through successive triples of function values."@en ;
    skos:hiddenLabel "Parabolic Integration"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-EM-DM-089" ;
    skos:prefLabel "Simpson Rule"@en ;
    heo:contrastsWith hewc:trapezoidal-rule ;
    heo:isTypeOf hewc:numerical-integration ;
    heo:optionalConceptIn <https://healtheconomics.wiki/knowledge-map/economic-modelling#step-12> ;
    heo:reviewStatus "Expert verified"@en ;
    heo:verifiedBy "Dr Darrin Baines" .

