hewc:baumol-effect a skos:Concept ;
    rdfs:label "Baumol Effect"@en ;
    dcterms:identifier "HE-EE-ME-006" ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:source "Baumol 1967" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.2" ;
    skos:altLabel "Baumol Cost Disease"@en,
        "Cost Disease"@en ;
    skos:broader hewc:cost-driver ;
    skos:definition "The Baumol effect is the rising relative cost of labour-intensive services such as health care as their pay tracks faster productivity growth elsewhere."@en ;
    skos:hiddenLabel "Service-Sector Cost Disease"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-EE-ME-006" ;
    skos:prefLabel "Baumol Effect"@en ;
    heo:contrastsWith hewc:aging-driven-cost-growth,
        hewc:technology-driven-cost-growth ;
    heo:contributesTo hewc:health-spending-as-gdp-share,
        hewc:healthcare-cost-growth ;
    heo:isTypeOf hewc:cost-driver ;
    heo:reviewStatus "Expert verified"@en ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:benefit-cost-ratio a skos:Concept ;
