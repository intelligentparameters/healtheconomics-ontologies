    skos:notation "HE-EE-CA-008" ;
    skos:prefLabel "Cash Flow"@en ;
    heo:classifiedUnder hewc:costs ;
    heo:informs hewc:cash-budget ;
    heo:reviewStatus "Expert verified"@en ;
