        hewc:treatment-switching ;
    heo:contributesTo hewc:performance-bias ;
    heo:isTypeOf hewc:intervention ;
    heo:reviewStatus "Expert verified"@en ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:communality a skos:Concept ;
    rdfs:label "Communality"@en ;
    dcterms:identifier "HE-ES-SA-030" ;
    dcterms:modified "2026-10-09"^^xsd:date ;
    dcterms:source "SAS Institute 2011" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.2" ;
    skos:broader hewc:statistical-method ;
    skos:definition "Communality is the proportion of an observed variable's variance explained by the common factors in a factor analysis, the complement of its uniqueness."@en ;
    skos:hiddenLabel "Common Variance"@en,
        "Shared Variance Proportion"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-ES-SA-030" ;
    skos:prefLabel "Communality"@en ;
