    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:broader hewc:partial-economic-evaluation ;
    skos:definition "A study that reports both the costs and outcomes of an intervention without directly comparing them against an alternative."@en ;
    skos:hiddenLabel "Cost and Outcome Report"@en,
