    skos:prefLabel "Controllable Cost"@en ;
    heo:contrastsWith hewc:uncontrollable-cost ;
    heo:isTypeOf hewc:cost ;
    heo:reviewStatus "Expert verified"@en ;
    heo:setsScopeOf hewc:budget-control ;
    heo:verifiedBy "Dr Darrin Baines" .

