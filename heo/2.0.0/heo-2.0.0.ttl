    skos:hiddenLabel "Chromosomal Response"@en,
        "Cytogenetic Remission"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-ES-CO-015" ;
    skos:prefLabel "Cytogenetic Response"@en ;
    heo:contrastsWith hewc:molecular-response ;
    heo:isTypeOf hewc:surrogate-endpoint,
        hewc:treatment-response ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en .

hewc:day-limit a skos:Concept ;
    rdfs:label "Day Limit"@en ;
    dcterms:identifier "HS-HP-HI-061" ;
    dcterms:source "Cutler DM, Zeckhauser RJ. The anatomy of health insurance. In: Culyer AJ, Newhouse JP, eds. Handbook of Health Economics. Vol 1A. Elsevier; 2000:563-643. doi:10.1016/S1574-0064(00)80170-5." ;
