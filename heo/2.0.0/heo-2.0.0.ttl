    skos:prefLabel "Burden of Illness"@en ;
    heo:informs hewc:health-technology-assessment,
        hewc:priority-setting ;
    heo:isTypeOf hewc:disease-burden ;
    heo:reviewStatus "Expert verified"@en ;
    heo:uses hewc:cost-of-illness-study,
        hewc:daly ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:capital-cost a skos:Concept ;
