    heo:partOf hewc:health-economic-model ;
    heo:reviewStatus "Expert verified"@en ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:asymptotic-normality a skos:Concept ;
    rdfs:label "Asymptotic Normality"@en ;
    dcterms:identifier "HE-ES-SA-007" ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:source "Fisher 1922" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.2" ;
    skos:broader hewc:statistical-method ;
    skos:definition "Asymptotic normality means an estimator's sampling distribution is approximately normal in large samples, the basis of Wald confidence intervals."@en ;
    skos:hiddenLabel "Asymptotic Gaussianity"@en,
        "Large-Sample Normality"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-ES-SA-007" ;
    skos:prefLabel "Asymptotic Normality"@en ;
    heo:classifiedUnder hewc:statistical-method ;
    heo:contrastsWith hewc:bootstrapping ;
    heo:isPropertyOf hewc:maximum-likelihood-estimation ;
    heo:optionalConceptIn <https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-3> ;
    heo:reviewStatus "Expert verified"@en ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:automatic-substitution a skos:Concept ;
