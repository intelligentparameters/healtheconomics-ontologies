hewc:cumulative-hazard a skos:Concept ;
    rdfs:label "Cumulative Hazard"@en ;
    dcterms:identifier "HE-EM-SM-010" ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:source "Collett 2015" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.3" ;
    skos:altLabel "Integrated Hazard"@en ;
    skos:broader hewc:economic-modelling ;
    skos:definition "Cumulative hazard, H(t), is the hazard rate summed over time in survival models. Survival equals exp(-H(t)), and unlike a probability H(t) can exceed 1."@en ;
    skos:hiddenLabel "Accumulated Hazard"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-EM-SM-010" ;
    skos:prefLabel "Cumulative Hazard"@en ;
    heo:classifiedUnder hewc:economic-modelling ;
    heo:contrastsWith hewc:cumulative-incidence ;
    heo:coreConceptIn <https://healtheconomics.wiki/knowledge-map/economic-modelling#step-5> ;
    heo:reviewStatus "Expert verified"@en ;
    heo:usedToCalculate hewc:cox-snell-residual,
        hewc:survival-function,
        hewc:transition-probability ;
    heo:verifiedBy "Dr Darrin Baines" .

