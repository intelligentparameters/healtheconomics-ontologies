hewc:efficiency-frontier-analysis a skos:Concept ;
    rdfs:label "Efficiency Frontier Analysis"@en ;
    dcterms:identifier "HE-EE_EA-018" ;
    dcterms:source "Farrell MJ. The measurement of productive efficiency. Journal of the Royal Statistical Society: Series A. 1957;120(3):253-290. doi:10.2307/2343100." ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:broader hewc:efficiency-evaluation ;
    skos:definition "A method identifying the best-observed combinations of inputs and outputs among comparable units, forming a frontier against which all others are benchmarked."@en ;
    skos:hiddenLabel "Input-Output Frontier Study"@en,
        "Unit Efficiency Benchmarking"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-EE_EA-018" ;
    skos:prefLabel "Efficiency Frontier Analysis"@en ;
    heo:isTypeOf hewc:efficiency-evaluation ;
    heo:produces hewc:efficiency-index ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en ;
    heo:uses hewc:data-envelopment-analysis .

hewc:efficiency-incentive a skos:Concept ;
    rdfs:label "Efficiency Incentive"@en ;
    dcterms:identifier "HS-NHS-PM-007" ;
    dcterms:source "Carlson JJ, Sullivan SD, Garrison LP, Neumann PJ, Veenstra DL. Linking payment to health outcomes: a taxonomy and examination of performance-based reimbursement schemes. Health Policy. 2010;96(3):179-190." ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:broader hewc:economic-incentive ;
    skos:definition "A financial reward or payment adjustment encouraging a provider to deliver care using fewer resources while maintaining or improving quality."@en ;
    skos:hiddenLabel "Efficiency Reward"@en,
        "Productivity Incentive"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HS-NHS-PM-007" ;
    skos:prefLabel "Efficiency Incentive"@en ;
    heo:isTypeOf hewc:economic-incentive ;
    heo:partOf hewc:value-based-payment ;
    heo:promotes hewc:operational-efficiency ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en .

hewc:efficiency-index a skos:Concept ;
    rdfs:label "Efficiency Index"@en ;
    dcterms:identifier "HS-NHS-PM-008" ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source "Charnes, Cooper & Rhodes 1978" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.0" ;
    skos:broader hewc:health-systems ;
    skos:definition "An efficiency index is a specified numerical measure that compares a unit’s resource use and valued output with a defined benchmark or estimated production frontier."@en ;
    skos:hiddenLabel "Efficiency Score"@en,
        "Relative Efficiency Measure"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HS-NHS-PM-008" ;
    skos:prefLabel "Efficiency Index"@en ;
    heo:classifiedUnder hewc:health-systems ;
    heo:coreConceptIn <https://healtheconomics.wiki/knowledge-map/health-systems#step-5> ;
    heo:measures hewc:efficiency ;
    heo:reviewStatus "Expert verified"@en ;
    heo:verifiedBy "Dr Darrin Baines" .

