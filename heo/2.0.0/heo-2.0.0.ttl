hewc:economic-foundations a skos:Concept ;
    rdfs:label "Economic Foundations"@en ;
    dcterms:identifier "HE-FD-EF-001" ;
    dcterms:source "Gillespie 2014; Begg 2013; Samuelson 1947; Arrow 1963; Grossman 1972" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:altLabel "Economic Theory"@en,
        "Foundations of Economics"@en ;
    skos:broader hewc:health-economics ;
    skos:definition "Economic foundations is the area of health economics that covers the economic theory health economists rely on, from scarcity, opportunity cost, demand, supply and elasticity to markets and market failure, welfare economics and the demand for health and health capital."@en ;
    skos:editorialNote "In HEO this concept is the wiki subdomain Economic Foundations, directly under Health Economics. Concepts in that subdomain with no is-type-of parent are classified under it or under a concept within it."@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-FD-EF-001" ;
    skos:prefLabel "Economic Foundations"@en ;
    heo:classifiedUnder hewc:health-economics ;
    heo:partOf hewc:health-economics ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en .

hewc:access-to-care a skos:Concept ;
    rdfs:label "Access to Care"@en ;
    dcterms:identifier "HS-HP-HE-004" ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:source "Penchansky R, Thomas JW. The concept of access: definition and relationship to consumer satisfaction. Medical Care. 1981;19(2):127?140. doi:10.1097/00005650-198102000-00001." ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
