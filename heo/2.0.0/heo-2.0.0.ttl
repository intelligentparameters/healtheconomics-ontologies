hewc:cost-consequence-analysis a skos:Concept ;
    rdfs:label "Cost-Consequence Analysis"@en ;
    dcterms:identifier "HE-EE-CA-029" ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:source "Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015. | Mauskopf JA, Paul JE, Grant DM, Stergachis A. The role of cost-consequence analysis in healthcare decision-making. PharmacoEconomics. 1998;13(3):277–288. doi:10.2165/00019053-199813030-00002. | Office for Health Improvement and Disparities. Cost consequence analysis: health economic studies. 2020. https://www.gov.uk/guidance/cost-consequence-analysis-health-economic-studies | Husereau D, et al. Consolidated Health Economic Evaluation Reporting Standards 2022 (CHEERS 2022) Statement. BMJ. 2022;376:e067975. doi:10.1136/bmj-2021-067975." ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.5.27" ;
    skos:altLabel "CCA"@en ;
    skos:broader hewc:economic-evaluation ;
    skos:definition "Cost-consequence analysis sets out the costs and each separate outcome of healthcare options side by side, without combining them into one result."@en ;
    skos:hiddenLabel "Disaggregated Cost-Outcome Analysis"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-EE-CA-029" ;
    skos:prefLabel "Cost-Consequence Analysis"@en ;
    heo:abbreviation "CCA"@en ;
    heo:contrastsWith hewc:cost-benefit-analysis,
        hewc:cost-effectiveness-analysis ;
    heo:informs hewc:multi-criteria-decision-analysis ;
    heo:isTypeOf hewc:economic-evaluation ;
    heo:optionalConceptIn <https://healtheconomics.wiki/knowledge-map/economic-evaluation#step-1> ;
