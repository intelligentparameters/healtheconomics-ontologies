    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.3" ;
    skos:broader hewc:choice-theory ;
    skos:definition "Consumer choice is the economic theory of how people choose goods and services, including health care, to best satisfy their preferences within a budget."@en ;
