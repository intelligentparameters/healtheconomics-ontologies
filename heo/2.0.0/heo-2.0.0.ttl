    owl:versionInfo "1.0.2" ;
    skos:broader hewc:integrated-care ;
    skos:definition "Clinical integration is the coordination of a patient's care across professionals, services and settings so that it runs as one continuous process."@en ;
    skos:hiddenLabel "Clinical Service Integration"@en,
        "Integrated Clinical Delivery"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HS-SS_IC-001" ;
    skos:prefLabel "Clinical Integration"@en ;
