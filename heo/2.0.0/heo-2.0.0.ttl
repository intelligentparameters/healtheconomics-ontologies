        "Pretest-Posttest Design"@en ;
    skos:broader hewc:quasi-experimental-design ;
    skos:definition "A before-and-after study compares outcomes or costs measured before and after a health intervention or policy change, in one group or with a control group."@en ;
    skos:hiddenLabel "Controlled Before-After Study"@en,
        "Uncontrolled Before-After Study"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-ES-CER-029" ;
    skos:prefLabel "Before-and-After Study"@en ;
    heo:contrastsWith hewc:interrupted-time-series ;
