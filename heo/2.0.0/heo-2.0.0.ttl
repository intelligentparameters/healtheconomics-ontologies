hewc:cash-flow a skos:Concept ;
    rdfs:label "Cash Flow"@en ;
    dcterms:identifier "HE-EE-CA-008" ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:source "IFRS Foundation 2026 (IAS 7)" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.2" ;
    skos:altLabel "Cashflow"@en ;
    skos:broader hewc:costs ;
