        "Regressive Benefit Bias"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-EE-HE-012" ;
    skos:prefLabel "Pro-Rich Bias"@en ;
    heo:classifiedUnder hewc:health-policy ;
