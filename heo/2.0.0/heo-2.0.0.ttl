    heo:reviewStatus "Dictionary entry, not yet expert verified"@en .

hewc:average-cost-estimation a skos:Concept ;
    rdfs:label "Average Cost Estimation"@en ;
    dcterms:identifier "HE-EE-CM-004" ;
    dcterms:source "Drummond MF, Sculpher MJ, Claxton K, Stoddart GL, Torrance GW. Methods for the Economic Evaluation of Health Care Programmes. 4th ed. Oxford University Press; 2015." ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:broader hewc:unit-cost-estimation ;
    skos:definition "The process of estimating cost per unit of service by dividing total observed cost by units delivered, without separating fixed and variable components."@en ;
    skos:hiddenLabel "Average Costing"@en,
        "Mean Cost Estimation"@en ;
