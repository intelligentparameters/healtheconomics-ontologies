hewc:confounder a skos:Concept ;
    rdfs:label "Confounder"@en ;
    dcterms:identifier "HE-DS-BV-006" ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:source "VanderWeele 2019" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.2" ;
    skos:altLabel "Confounding Factor"@en,
        "Confounding Variable"@en ;
    skos:broader hewc:evidence-synthesis ;
    skos:definition "A confounder is a variable, such as disease severity, that affects both the treatment a patient receives and the outcome, biasing unadjusted comparisons."@en ;
    skos:exactMatch <http://www.wikidata.org/entity/Q1125472> ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-DS-BV-006" ;
    skos:prefLabel "Confounder"@en ;
    heo:classifiedUnder hewc:evidence-synthesis ;
    heo:contrastsWith hewc:instrumental-variable ;
    heo:contributesTo hewc:confounding ;
    heo:isFoundationFor hewc:unmeasured-confounding ;
    heo:reviewStatus "Expert verified"@en ;
    heo:threatensValidityOf hewc:causal-inference ;
    heo:verifiedBy "Dr Darrin Baines" .

