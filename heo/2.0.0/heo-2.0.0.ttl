hewc:appropriate-care a skos:Concept ;
    rdfs:label "Appropriate Care"@en ;
    dcterms:identifier "HS-HP-HTA-016" ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:source "Fitch et al. 2001" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.2" ;
    skos:broader hewc:health-systems ;
    skos:definition "Appropriate care is care whose expected benefit exceeds its harms by a clear margin, avoiding overuse and underuse that reduce health system efficiency."@en ;
    skos:hiddenLabel "Appropriate Treatment"@en,
        "Evidence-Concordant Care"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HS-HP-HTA-016" ;
    skos:prefLabel "Appropriate Care"@en ;
    heo:classifiedUnder hewc:health-systems ;
    heo:contrastsWith hewc:low-value-care,
        hewc:overutilization,
        hewc:underuse ;
    heo:contributesTo hewc:allocative-efficiency,
        hewc:quality-of-care ;
    heo:coreConceptIn <https://healtheconomics.wiki/knowledge-map/health-systems#step-5> ;
    heo:reviewStatus "Expert verified"@en ;
    heo:verifiedBy "Dr Darrin Baines" .

