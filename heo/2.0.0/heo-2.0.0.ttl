    dcterms:identifier "HS-HP-HE-007" ;
    dcterms:source "Penchansky R, Thomas JW. The concept of access: definition and relationship to consumer satisfaction. Medical Care. 1981;19(2):127-140. doi:10.1097/00005650-198102000-00001." ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:altLabel "Service Availability"@en ;
    skos:broader hewc:health-policy ;
    skos:definition "One of the five classical access dimensions, referring to the adequacy of healthcare provider and service supply relative to population need."@en ;
    skos:hiddenLabel "Supply Adequacy"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HS-HP-HE-007" ;
    skos:prefLabel "Availability of Healthcare"@en ;
    heo:classifiedUnder hewc:health-policy ;
    heo:partOf hewc:access-to-care ;
    heo:reviewStatus "Dictionary entry, not yet expert verified"@en .

hewc:average-sales-price a skos:Concept ;
    rdfs:label "Average Sales Price"@en ;
    dcterms:identifier "HS-DC-DP-005" ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:source "MedPAC 2025" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.2" ;
    skos:broader hewc:price ;
    skos:definition "Average sales price (ASP) is a manufacturer's average US price for a drug in a quarter, net of most discounts and rebates; it sets Medicare Part B payment."@en ;
    skos:hiddenLabel "ASP Benchmark"@en,
        "Medicare Net Price"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HS-DC-DP-005" ;
    skos:prefLabel "Average Sales Price"@en ;
    heo:contrastsWith hewc:list-price ;
    heo:isTypeOf hewc:price ;
    heo:reviewStatus "Expert verified"@en ;
    heo:usedToCalculate hewc:drug-cost,
        hewc:reimbursement ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:average-treatment-effect a skos:Concept ;
    rdfs:label "Average Treatment Effect"@en ;
    dcterms:identifier "HE-ES-CER-003" ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:source "Rubin 1974" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.2" ;
    skos:altLabel "ATE"@en ;
    skos:broader hewc:treatment-effect ;
    skos:definition "The average treatment effect (ATE) is the mean change in costs or health outcomes if a whole population received a treatment rather than its comparator."@en ;
    skos:exactMatch <http://www.wikidata.org/entity/Q4828276> ;
    skos:hiddenLabel "Population Average Effect"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-ES-CER-003" ;
    skos:prefLabel "Average Treatment Effect"@en ;
    heo:abbreviation "ATE"@en ;
    heo:contrastsWith hewc:heterogeneous-treatment-effect ;
    heo:coreConceptIn <https://healtheconomics.wiki/knowledge-map/evidence-synthesis#step-5> ;
    heo:isTypeOf hewc:treatment-effect ;
    heo:reviewStatus "Expert verified"@en ;
    heo:usedToCalculate hewc:icer,
        hewc:incremental-net-monetary-benefit ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:bad-debt a skos:Concept ;
    rdfs:label "Bad Debt"@en ;
    dcterms:identifier "HS-HP-HF-002" ;
    dcterms:source "Horngren, Datar & Rajan 2015" ;
