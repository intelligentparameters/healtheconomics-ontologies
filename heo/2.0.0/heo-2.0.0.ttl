hewc:attrition a skos:Concept ;
    rdfs:label "Attrition"@en ;
    dcterms:identifier "HE-ES-CTM-005" ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:source "Higgins et al. 2011" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.2" ;
    skos:broader hewc:evidence-synthesis ;
    skos:definition "Attrition is the loss of participants from a trial or cohort study before follow-up ends, leaving outcome, cost and QALY data incomplete and open to bias."@en ;
    skos:hiddenLabel "Participant Dropout"@en,
        "Sample Loss"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-ES-CTM-005" ;
    skos:prefLabel "Attrition"@en ;
