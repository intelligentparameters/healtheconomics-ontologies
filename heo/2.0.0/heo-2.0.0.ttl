    heo:uses hewc:akaike-information-criterion,
        hewc:cubic-spline,
        hewc:maximum-likelihood-estimation,
        hewc:parametric-survival-model,
        hewc:regression-analysis ;
    heo:verifiedBy "Dr Darrin Baines" .

