    heo:verifiedBy "Dr Darrin Baines" .

hewc:between-study-heterogeneity a skos:Concept ;
    rdfs:label "Between-Study Heterogeneity"@en ;
    dcterms:identifier "HE-ES-ESM-004" ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:source "Higgins et al. 2003" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.2" ;
    skos:broader hewc:evidence-synthesis ;
    skos:definition "Between-study heterogeneity is variation in effects across trials in a meta-analysis beyond chance, so one pooled effect may not fit every HTA setting."@en ;
    skos:hiddenLabel "Heterogeneity"@en,
        "Inter-Study Variation"@en,
        "Study Heterogeneity"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
