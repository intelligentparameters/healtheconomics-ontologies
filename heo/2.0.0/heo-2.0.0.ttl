hewc:dependent-censoring a skos:Concept ;
    rdfs:label "Dependent Censoring"@en ;
    dcterms:identifier "HE-ES-CTM-026" ;
    dcterms:modified "2026-10-02"^^xsd:date ;
    dcterms:source "Latimer & Abrams 2014" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.3" ;
    skos:altLabel "Informative Censoring"@en,
        "Non-Ignorable Censoring"@en ;
    skos:broader hewc:censoring ;
    skos:definition "Dependent censoring occurs when the chance of being censored is linked to a patient's risk of the event, so standard survival estimates can be biased."@en ;
