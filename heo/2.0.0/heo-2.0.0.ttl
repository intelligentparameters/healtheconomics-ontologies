    heo:contrastsWith hewc:therapeutic-interchange ;
    heo:contributesTo hewc:biosimilar-uptake ;
    heo:isTypeOf hewc:drug-substitution ;
    heo:promotes hewc:generic-drug ;
    heo:reviewStatus "Expert verified"@en ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:bayesian-adaptive-design a skos:Concept ;
    rdfs:label "Bayesian Adaptive Design"@en ;
    dcterms:identifier "HE-ES-CTM-007" ;
    dcterms:modified "2026-10-10"^^xsd:date ;
    dcterms:source "Berry 2006" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    owl:versionInfo "1.0.3" ;
    skos:altLabel "Bayesian Adaptive Clinical Trial"@en,
        "Bayesian Adaptive Trial"@en ;
    skos:broader hewc:adaptive-trial-design ;
    skos:definition "Bayesian adaptive design is a clinical trial design in which pre-set rules on posterior or predictive probabilities trigger changes such as early stopping."@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-ES-CTM-007" ;
    skos:prefLabel "Bayesian Adaptive Design"@en ;
