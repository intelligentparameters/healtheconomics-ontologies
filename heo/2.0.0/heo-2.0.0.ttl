hewc:relative-survival-model a skos:Concept ;
    rdfs:label "Relative Survival Model"@en ;
    dcterms:identifier "HE-EM-SM-070" ;
    dcterms:modified "2026-09-25"^^xsd:date ;
    dcterms:source "Ederer, Axtell & Cutler 1961" ;
