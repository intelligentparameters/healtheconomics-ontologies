hewc:costs a skos:Concept ;
    rdfs:label "Costs"@en ;
    dcterms:identifier "HE-EE-CA-093" ;
    dcterms:source "HealthEconomics.wiki subdomain page https://healtheconomics.wiki/subdomain/costs (read 16 Oct 2026)" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    rdfs:seeAlso <https://healtheconomics.wiki/subdomain/costs> ;
    skos:altLabel "Health Economic Costing"@en ;
    skos:broader hewc:health-economics ;
    skos:definition "Costs is the area of health economics that measures the resources used in health care, and the wider resources lost to illness, and values them in money for economic evaluation."@en ;
