        hewc:loan-financing ;
    heo:reviewStatus "Expert verified"@en ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:break-even-point a skos:Concept ;
    rdfs:label "Break-Even Point"@en ;
    dcterms:identifier "HE-EE-CBA-006" ;
    dcterms:source "Horngren, Datar & Rajan 2015" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:altLabel "Breakeven Point"@en ;
    skos:broader hewc:cost-benefit-analysis ;
    skos:definition "The level of output or activity at which total revenue equals total cost, so an organisation neither gains nor loses money."@en ;
