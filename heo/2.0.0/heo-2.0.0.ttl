    dcterms:identifier "HE-PE-TI-032" ;
    dcterms:source "Katzung 2017" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:broader hewc:supportive-therapy ;
