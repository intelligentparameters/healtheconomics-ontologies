    heo:measures hewc:vaccination-externalities ;
    heo:represents hewc:herd-immunity ;
    heo:reviewStatus "Expert verified"@en ;
    heo:uses hewc:basic-reproduction-number,
        hewc:compartmental-model,
        hewc:contact-rate,
