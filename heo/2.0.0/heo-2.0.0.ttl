    heo:reviewStatus "Expert verified"@en ;
    heo:usedToCalculate hewc:attack-rate,
        hewc:herd-immunity-threshold ;
    heo:verifiedBy "Dr Darrin Baines" .

hewc:benefit-transfer a skos:Concept ;
