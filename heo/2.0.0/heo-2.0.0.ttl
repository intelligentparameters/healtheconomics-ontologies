    skos:broader hewc:cognitive-bias-concept,
        hewc:heuristics-concept ;
    skos:definition "A cognitive heuristic in which perceived probability is based on how easily examples come to mind rather than actual frequency."@en ;
    skos:hiddenLabel "Ease-of-Recall Heuristic"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-EE-BE-002" ;
