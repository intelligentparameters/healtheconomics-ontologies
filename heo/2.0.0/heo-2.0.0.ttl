hewc:quality-uncertainty a skos:Concept ;
    rdfs:label "Quality Uncertainty"@en ;
    dcterms:identifier "HE-EE-ME-060" ;
    dcterms:source "Akerlof 1970" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
    skos:broader hewc:information-asymmetry ;
