    rdfs:label "Decision Relevance Period"@en ;
    dcterms:identifier "HE-EM-VI-035" ;
    dcterms:source "Claxton & Posnett 1996" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heo> ;
