    skos:altLabel "Probability Node"@en ;
    skos:broader hewc:decision-tree ;
    skos:definition "A chance node is a point in a decision tree where an uncertain event, not a choice, decides the pathway, and its branch probabilities sum to one."@en ;
    skos:hiddenLabel "Random Node"@en ;
    skos:inScheme <https://healtheconomics.wiki/ontologies/heo> ;
    skos:notation "HE-EM-DM-008" ;
