obo:IAO_0000112 a owl:AnnotationProperty ;
    rdfs:label "example of usage"@en ;
    rdfs:isDefinedBy obo:iao.owl .

obo:IAO_0000115 a owl:AnnotationProperty ;
    rdfs:label "definition"@en ;
    rdfs:isDefinedBy obo:iao.owl .

obo:IAO_0000116 a owl:AnnotationProperty ;
    rdfs:label "editor note"@en ;
    rdfs:isDefinedBy obo:iao.owl .

obo:IAO_0000117 a owl:AnnotationProperty ;
    rdfs:label "term editor"@en ;
    rdfs:isDefinedBy obo:iao.owl .

obo:IAO_0000118 a owl:AnnotationProperty ;
    rdfs:label "alternative label"@en ;
    rdfs:isDefinedBy obo:iao.owl .

obo:IAO_0000119 a owl:AnnotationProperty ;
    rdfs:label "definition source"@en ;
    rdfs:isDefinedBy obo:iao.owl .

obo:IAO_0000231 a owl:AnnotationProperty ;
    rdfs:label "has obsolescence reason"@en .

obo:IAO_0000412 a owl:AnnotationProperty ;
    rdfs:label "imported from"@en ;
    rdfs:isDefinedBy obo:iao.owl .

obo:OBI_0000417 a owl:ObjectProperty ;
    rdfs:label "achieves_planned_objective"@en ;
    obo:IAO_0000115 "This relation obtains between a planned process and a objective specification when the criteria specified in the objective specification are met at the end of the planned process."@en ;
    obo:IAO_0000116 "OBI's label is kept as served. The relation links a task performance to the objective specification of its task when the objective was met."@en ;
    obo:IAO_0000412 obo:obi.owl .

obo:RO_0017002 a owl:ObjectProperty ;
    rdfs:label "information specifies"@en ;
    obo:IAO_0000115 "A relation between information and an entity such that the information serves as a rule or guide if the entity is an occurrent, or the information serves as a model if the entity is a continuant."@en ;
    obo:IAO_0000116 "RO records this relation as an exact match of the Common Core Ontologies relation 'prescribes', the relation Duncan et al. 2024 recommend for linking a plan specification to the process it guides."@en ;
    obo:IAO_0000412 obo:ro.owl ;
    owl:inverseOf obo:RO_0017010 .

dcterms:bibliographicCitation a owl:AnnotationProperty ;
    rdfs:label "bibliographic citation"@en .

dcterms:contributor a owl:AnnotationProperty ;
