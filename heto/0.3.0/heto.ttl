        rheo:0000032,
        rheo:0000117 ;
    heto:3000004 rheo:0000032 ;
    heto:3000005 rheo:0000031,
        rheo:0000153 ;
    heto:3000006 heto:0000041 ;
    heto:3000007 "An economic model version or its probabilistic results and, where used, the decision maker's cost-effectiveness threshold."@en ;
    heto:3000008 "Incremental results, such as ICERs or net monetary benefit."@en .

heto:0000041 a owl:Class ;
    rdfs:label "economic modeller role"@en ;
    obo:IAO_0000115 "A health economics practitioner role that is realised when its bearer designs, builds, runs or checks an economic model."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Baines D. Defining tasks in HETO. Brief to the curator, 15 October 2026 (practitioner role for adding discounting)" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:subClassOf heto:0000040 .

heto:0000040 a owl:Class ;
    rdfs:label "health economics practitioner role"@en ;
    obo:IAO_0000115 "A role borne by a person that is realised when that person carries out health economics work, such as framing, costing, modelling, analysing or reporting an economic evaluation."@en ;
    obo:IAO_0000116 "Roles only. People are RHEO persons (Homo sapiens) and organisations are OBI organizations; neither is placed in this hierarchy. A person bears the role; the role is realised in a task performance."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial (HETO 0.1.0)" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:subClassOf obo:BFO_0000023 .

heto:0000001 a owl:Class ;
    rdfs:label "task specification"@en ;
    obo:IAO_0000115 "A plan specification that describes a reusable, defined unit of health economics work, stating the result the work is meant to achieve and the main actions directed towards it, independently of any particular practitioner, project or software."@en ;
    obo:IAO_0000116 "Each named task in the HETO catalogue is one individual of this class or of one of its subclasses, with its own URI. The specification is information. A particular practitioner doing the work is a separate process, a health economics task performance, linked to the specification by 'specified by information' (RO_0017010), as Duncan et al. 2024 propose for plan specifications. A calendar reminder, a topic heading or one person's to-do item is not by itself a task specification."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Baines D. Defining tasks in HETO. Brief to the curator, 15 October 2026; IAO plan specification (IAO_0000104)" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty heto:1000006 ;
            owl:someValuesFrom obo:IAO_0000007 ],
        [ a owl:Restriction ;
            owl:onProperty heto:1000005 ;
            owl:someValuesFrom obo:IAO_0000005 ],
        obo:IAO_0000104 .

obo:IAO_0000005 a owl:Class ;
    rdfs:label "objective specification"@en ;
    obo:IAO_0000115 "A directive information entity that describes an intended process endpoint. When part of a plan specification the concretization is realized in a planned process in which the bearer tries to effect the world so that the process endpoint is achieved."@en ;
    obo:IAO_0000116 "Used in HETO for the intended result of a task, one objective specification per task specification."@en ;
    obo:IAO_0000412 obo:iao.owl ;
    rdfs:subClassOf obo:IAO_0000033 .

obo:IAO_0000007 a owl:Class ;
    rdfs:label "action specification"@en ;
    obo:IAO_0000115 "A directive information entity that describes an action the bearer will take."@en ;
    obo:IAO_0000116 "Used in HETO for the main actions of a task. Detailed implementation steps belong in guidance, not here."@en ;
    obo:IAO_0000412 obo:iao.owl ;
    rdfs:subClassOf obo:IAO_0000033 .

<https://orcid.org/0009-0006-0231-3731> rdfs:label "Michelle Ashley" .


<https://healtheconomics.wiki/ontologies/heto> <http://www.w3.org/2002/07/owl#priorVersion> <https://healtheconomics.wiki/ontology/heto/0.2.0/heto.owl> ;
    <http://www.w3.org/2000/01/rdf-schema#comment> "Version 0.3.0 moves every HETO address from https://healtheconomics.wiki/ontology/heto to https://healtheconomics.wiki/ontologies/heto, so the ontology identifier, its version identifier and its terms match the ontology page on the site. Every class, property, definition and axiom is the same as in 0.2.0, and the imports now point to the family releases made at the same time (HEO 2.0.0, RHEO 0.4.0, OHEO 0.3.0, HETO 0.3.0, HEAO 0.2.0, HEMO 0.2.0, HELO 0.2.0, HEIRO 0.2.0). The old /ontology/ addresses are retired and are not redirected."@en .
