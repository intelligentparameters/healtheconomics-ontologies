    heto:3000007 "The model structure, trial reports, published studies and patient-level or survival data."@en ;
    heto:3000008 "Transition probability and treatment effect estimates assigned to the model parameters, with their uncertainty."@en .

heto:4000020 a owl:NamedIndividual,
        heto:0000012 ;
    rdfs:label "Value resource use"@en ;
    obo:IAO_0000115 "A task specification for multiplying the quantity of each resource used by its unit cost, and adding the results, to give the cost of each option or of each modelled health state from the stated perspective."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Drummond et al. 2015" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
