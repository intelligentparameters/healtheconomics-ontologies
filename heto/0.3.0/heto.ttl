    heto:3000007 "The decision question, the options to be compared, and the clinical, cost and outcome evidence available."@en ;
    heto:3000008 "The results of the evaluation with their uncertainty, and a report of its methods and results."@en .

heto:4000002 a owl:NamedIndividual,
        heto:0000010 ;
    rdfs:label "Define the decision problem"@en ;
    obo:IAO_0000115 "A task specification for stating the decision an economic evaluation is to inform, including the population, the options compared, the outcomes, the perspective and the time horizon, before any analysis begins."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Drummond et al. 2015" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    heto:1000001 heto:4000003,
        heto:4000004 ;
    heto:1000003 heto:4000005 ;
    heto:1000005 heto:4100201 ;
    heto:1000006 heto:4200201,
        heto:4200202,
        heto:4200203,
        heto:4200204 ;
    heto:3000003 obo:IAO_0000310 ;
    heto:3000004 rheo:0000004,
        rheo:0000025,
        rheo:0000026 ;
    heto:3000006 heto:0000040 ;
    heto:3000007 "The policy or clinical question, the technologies of interest and any scope issued by the decision maker."@en ;
    heto:3000008 "A decision problem specification."@en .

heto:4000003 a owl:NamedIndividual,
        heto:0000010 ;
    rdfs:label "Define the evaluation perspective"@en ;
    obo:IAO_0000115 "A task specification for stating whose costs and health outcomes an economic evaluation counts, such as those falling on the health system or on society as a whole, so that resources and outcomes are included consistently."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Drummond et al. 2015" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    heto:1000003 heto:4000007 ;
    heto:1000005 heto:4100301 ;
    heto:1000006 heto:4200301,
        heto:4200302 ;
    heto:3000002 rheo:0000123 ;
    heto:3000003 rheo:0000025 ;
    heto:3000004 rheo:0000072 ;
    heto:3000006 heto:0000040 ;
    heto:3000007 "The decision problem and any methods guidance from the decision maker."@en ;
    heto:3000008 "A perspective specification."@en .

heto:4000004 a owl:NamedIndividual,
        heto:0000010 ;
