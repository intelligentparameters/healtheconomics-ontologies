    heto:3000005 rheo:0000150,
        rheo:0000151 ;
    heto:3000006 heto:0000040 ;
    heto:3000007 "Resource use estimates, unit cost estimates and the perspective."@en ;
    heto:3000008 "Cost estimates for each option or modelled health state, in a stated currency and price year."@en .

obo:BFO_0000051 a owl:ObjectProperty ;
    rdfs:label "has part"@en ;
    obo:IAO_0000115 "a core relation that holds between a whole and its part"@en ;
    obo:IAO_0000412 obo:ro.owl ;
    owl:inverseOf obo:BFO_0000050 .

heto:0000010 a owl:Class ;
    rdfs:label "decision problem framing task specification"@en ;
    obo:IAO_0000115 "A task specification whose intended result is a statement of the decision an economic evaluation will inform, or of one element of it such as the perspective or the time horizon."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Drummond et al. 2015" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:subClassOf heto:0000001 .

heto:0000012 a owl:Class ;
    rdfs:label "costing task specification"@en ;
    obo:IAO_0000115 "A task specification whose intended result is the identification, measurement or valuation of the resources used by the options compared in an economic evaluation."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Drummond et al. 2015" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:subClassOf heto:0000001 .

heto:4000007 a owl:NamedIndividual,
        heto:0000012 ;
    rdfs:label "Estimate resource use"@en ;
    obo:IAO_0000115 "A task specification for identifying and measuring the quantities of resources, such as staff time, medicines and hospital stays, used with each option or in each modelled health state, in natural units."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Drummond et al. 2015" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    heto:1000003 heto:4000008 ;
    heto:1000005 heto:4100701 ;
