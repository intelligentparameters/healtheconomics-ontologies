foaf:homepage a owl:AnnotationProperty ;
    rdfs:label "homepage"@en .

heto:0000002 a owl:Class ;
    rdfs:label "composite task specification"@en ;
    obo:IAO_0000115 "A task specification that has one or more other task specifications as subtasks, so that it describes a larger undertaking made up of smaller units of work."@en ;
    obo:IAO_0000116 "Defined class. Do not assert it. A reasoner places a task specification here when it has a subtask, so the level of a task is worked out from the decomposition and no fixed depth is imposed."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Baines D. Defining tasks in HETO. Brief to the curator, 15 October 2026 (levels of work)" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:subClassOf heto:0000001 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( heto:0000001 [ a owl:Restriction ;
                        owl:onProperty heto:1000001 ;
                        owl:someValuesFrom heto:0000001 ] ) ] .

heto:0000030 a owl:Class ;
    rdfs:label "health economics task performance"@en ;
    obo:IAO_0000115 "A planned process in which one or more people carry out health economics work as a task specification in the HETO catalogue prescribes, whether or not the work achieves its objective."@en ;
    obo:IAO_0000116 "A performance is linked to the task specification that prescribes it by 'specified by information' (RO_0017010). That link holds even when the work fails or departs from the specification, which is why HETO uses it rather than requiring a plan that concretizes the specification (Duncan et al. 2024). The kinds of process involved, such as a RHEO model run, are recorded on the task specification with 'has process type'."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "COB planned process (COB_0000082); Duncan et al. 2024" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0017010 ;
            owl:someValuesFrom heto:0000001 ],
        obo:COB_0000082 .

heto:1000003 a owl:ObjectProperty ;
    rdfs:label "normally precedes"@en ;
    obo:IAO_0000115 "Relates two task specifications when the work the first describes is usually done, at least in a first version, before the work the second describes begins. This is ordering. It states usual practice, not a rule, and work is often revisited."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial (HETO 0.1.0); Baines D. Defining tasks in HETO. Brief to the curator, 15 October 2026 (classification, decomposition and ordering)" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain heto:0000001 ;
    rdfs:range heto:0000001 ;
    owl:inverseOf heto:1000004 .

heto:3000001 a owl:AnnotationProperty ;
    rdfs:label "obsolete requires concept"@en ;
    obo:IAO_0000115 "Obsolete. In HETO 0.1.0 this related a task specification to a HEO concept a person needs to understand to do the work."@en ;
    obo:IAO_0000116 "Made obsolete in 0.2.0. HEO concepts are not real things, so HETO's logical links now go to RHEO and OHEO types (involves type and its sub-properties). The task-to-concept links are kept, for learning and navigation only, as skos:relatedMatch rows in heto-mappings.sssom.tsv, their one home."@en ;
    obo:IAO_0000119 "Darrin Baines, decision of 17 October 2026, approved by Michelle Ashley" ;
    obo:IAO_0000231 obo:OMO_0001000 ;
    oboInOwl:consider heto:3000002 ;
    owl:deprecated true .

heto:3000003 a owl:AnnotationProperty ;
    rdfs:label "has input type"@en ;
    obo:IAO_0000115 "Relates a task specification to a class whose instances are usual inputs to the work."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial (HETO 0.1.0)" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:subPropertyOf heto:3000002 .

heto:3000004 a owl:AnnotationProperty ;
    rdfs:label "has output type"@en ;
    obo:IAO_0000115 "Relates a task specification to a class whose instances are usual outputs of the work."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial (HETO 0.1.0)" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:subPropertyOf heto:3000002 .

heto:3000005 a owl:AnnotationProperty ;
    rdfs:label "has process type"@en ;
    obo:IAO_0000115 "Relates a task specification to a class of process in which the work, or a main part of it, is carried out. The value is a subclass of BFO process. It names a process type; a particular performance is recorded separately."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial (HETO 0.1.0)" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:subPropertyOf heto:3000002 .

heto:3000006 a owl:AnnotationProperty ;
    rdfs:label "has practitioner role"@en ;
    obo:IAO_0000115 "Relates a task specification to the role class whose bearers usually carry out the work. The value is a subclass of health economics practitioner role."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial (HETO 0.1.0)" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> .

heto:3000007 a owl:AnnotationProperty ;
    rdfs:label "inputs description"@en ;
    obo:IAO_0000115 "A plain-language statement of the usual inputs to the work a task specification describes."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial (HETO 0.1.0)" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> .

heto:3000008 a owl:AnnotationProperty ;
    rdfs:label "expected output description"@en ;
    obo:IAO_0000115 "A plain-language statement of the usual result the work a task specification describes produces."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial (HETO 0.1.0)" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> .

heto:3000009 a owl:AnnotationProperty ;
    rdfs:label "has guidance resource"@en ;
    obo:IAO_0000115 "Relates a task specification to a separate resource, such as a methods guide or a teaching page, that gives detailed guidance on doing the work. The value is the resource's URL, labelled with its name, its version or date, and the date the link was checked. HETO does not take any figure or rule from the resource."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial (HETO 0.1.0)" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> .

heto:4000017 a owl:NamedIndividual,
        heto:0000017 ;
    rdfs:label "Prepare the economic evidence for a health technology assessment submission"@en ;
    obo:IAO_0000115 "A task specification for assembling the economic evidence for a technology, including the economic evaluation, its model and supporting documents, in the form set by the health technology assessment body that will appraise it."@en ;
    obo:IAO_0000116 "Definition is HealthEconomics.wiki editorial wording, for Darrin Baines to confirm. The evaluation it contains can also be part of other undertakings, such as an assessment group's own evaluation or a publication."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial (HETO 0.1.0)" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    heto:1000001 heto:4000001 ;
    heto:1000005 heto:4101701 ;
    heto:1000006 heto:4201701,
        heto:4201702 ;
    heto:3000002 rheo:0000062,
        rheo:0000083 ;
    heto:3000003 obo:IAO_0000310,
        rheo:0000028,
        rheo:0000032 ;
    heto:3000004 obo:IAO_0000310 ;
    heto:3000006 heto:0000040 ;
    heto:3000007 "The economic evaluation, its model, and the methods guidance and templates of the assessment body."@en ;
    heto:3000008 "The economic sections of a submission dossier and the accompanying model."@en .

obo:OMO_0001000 a owl:NamedIndividual ;
    rdfs:label "out of scope"@en .

<https://healtheconomics.wiki/ontologies/heto> a owl:Ontology ;
    dcterms:bibliographicCitation "Baines D, Ashley M. Health Economics Task Ontology (HETO), version 0.2.0. Intelligent Parameters Ltd; 2026. https://healtheconomics.wiki/ontologies/heto/0.3.0/heto.owl. Licence CC BY 4.0." ;
    dcterms:created "2026-10-17"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    dcterms:description "HETO, the Health Economics Task Ontology, describes recognisable units of health economics work, such as adding discounting to an economic model or running a probabilistic sensitivity analysis, and connects each one to the real things it works on, as RHEO and OHEO define them. A HETO task is a reusable specification of a defined unit of work. It states an intended result and the main actions directed towards it, independently of any particular practitioner, project or software. Following the Information Artifact Ontology, a task specification is a plan specification (IAO_0000104) with an objective specification and action specifications as parts. Each named task in the pilot catalogue is an individual with its own URI; subclasses of task specification classify kinds of task. A particular performance of the work is a separate planned process (health economics task performance), linked to the specification it follows by 'specified by information' (RO_0017010), as Duncan et al. 2024 recommend. Three relations are kept apart. Classification (rdf:type) says what kind of task something is; decomposition (has subtask specification) says which smaller tasks make up a larger one; ordering (normally precedes) says which work is usually done first. Policy (decided by Darrin Baines, 17 October 2026). HEO is a thesaurus of concepts, which are not real things; RHEO and OHEO define the real things of health economics within BFO 2020; HETO describes work on those real things, so its logical links go to RHEO and OHEO only. Each task names the RHEO or OHEO types of its inputs, outputs and processes, and the HETO role of the person who does it. HEO concepts are not linked from heto.ttl. They appear only in heto-mappings.sssom.tsv, as secondary skos:relatedMatch rows for learning and navigation, which state no requirement and no identity. No HETO class uses a HEO concept URI. Requirements on the catalogue and on records of task performances are SHACL shapes in heto-shapes.ttl."@en ;
    dcterms:issued "2026-10-17"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-20"^^xsd:date ;
    dcterms:publisher "Intelligent Parameters Ltd" ;
    dcterms:title "Health Economics Task Ontology (HETO)"@en ;
    vann:preferredNamespacePrefix "heto" ;
    vann:preferredNamespaceUri "https://healtheconomics.wiki/ontologies/heto/HETO_" ;
    rdfs:comment "Pilot release (status alpha) for review by its creators and invited reviewers before the task list is expanded. HETO imports RHEO 0.4.0 with its uncertainty module and OHEO 0.3.0, and through them BFO 2020 (ISO/IEC 21838-2); the BFO, IAO, COB, OBI and RO terms RHEO declares are not declared again. The other reused terms (IAO objective specification and action specification, RO has part, information specifies and specified by information, OBI achieves planned objective) are declared with their official label and definition as served by the EBI Ontology Lookup Service on 2026-10-16 (IAO 2026-03-30, RO 2026-09-04, OBI 2026-07-27), with one parent the source asserts where it asserts one. Consult the source ontologies for their full axioms."@en ;
    rdfs:seeAlso <https://healtheconomics.wiki/ontologies/heo>,
        <https://healtheconomics.wiki/ontologies/oheo>,
        <https://healtheconomics.wiki/ontologies/rheo> ;
    owl:imports <https://healtheconomics.wiki/ontologies/oheo/0.3.0/oheo.owl>,
        <https://healtheconomics.wiki/ontologies/rheo/0.4.0/rheo-uncertainty.owl>,
        <https://healtheconomics.wiki/ontologies/rheo/0.4.0/rheo.owl> ;

    owl:versionIRI <https://healtheconomics.wiki/ontologies/heto/0.3.0/heto.owl> ;
    owl:versionInfo "0.3.0 (alpha)" ;
    foaf:homepage <https://healtheconomics.wiki/ontologies/heto> .

heto:0000013 a owl:Class ;
    rdfs:label "health outcome valuation task specification"@en ;
    obo:IAO_0000115 "A task specification whose intended result is a value placed on health outcomes or health states, such as the utility values given to the states of an economic model."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Brazier et al. 2017" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:subClassOf heto:0000001 .

heto:0000015 a owl:Class ;
    rdfs:label "model validation task specification"@en ;
    obo:IAO_0000115 "A task specification whose intended result is evidence on whether an economic model is technically correct, credible and fit for its decision purpose."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Eddy et al. 2012; Vemer et al. 2016" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:subClassOf heto:0000001 .

heto:0000016 a owl:Class ;
    rdfs:label "results analysis task specification"@en ;
    obo:IAO_0000115 "A task specification whose intended result is a comparison of the costs and health outcomes of the options in an economic evaluation, such as incremental cost-effectiveness ratios or net benefit."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Drummond et al. 2015" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:subClassOf heto:0000001 .

heto:1000001 a owl:ObjectProperty ;
    rdfs:label "has subtask specification"@en ;
    obo:IAO_0000115 "Relates a task specification to another task specification that describes a smaller unit of the work it describes. This is decomposition. A subtask is a part of the larger task, not a kind of it."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial (HETO 0.1.0); Baines D. Defining tasks in HETO. Brief to the curator, 15 October 2026 (classification, decomposition and ordering)" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain heto:0000001 ;
    rdfs:range heto:0000001 ;
    rdfs:subPropertyOf obo:BFO_0000051 ;
    owl:inverseOf heto:1000002 .

heto:1000002 a owl:ObjectProperty ;
    rdfs:label "subtask specification of"@en ;
    obo:IAO_0000115 "Relates a task specification to a larger task specification of which it describes a part of the work."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial (HETO 0.1.0); Baines D. Defining tasks in HETO. Brief to the curator, 15 October 2026 (classification, decomposition and ordering)" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain heto:0000001 ;
    rdfs:range heto:0000001 ;
    rdfs:subPropertyOf obo:BFO_0000050 .

heto:1000004 a owl:ObjectProperty ;
    rdfs:label "normally preceded by"@en ;
    obo:IAO_0000115 "Relates two task specifications when the work the second describes is usually done, at least in a first version, before the work the first describes begins."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial (HETO 0.1.0); Baines D. Defining tasks in HETO. Brief to the curator, 15 October 2026 (classification, decomposition and ordering)" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain heto:0000001 ;
    rdfs:range heto:0000001 .

heto:1000005 a owl:ObjectProperty ;
    rdfs:label "has objective specification"@en ;
    obo:IAO_0000115 "Relates a plan specification to an objective specification that is part of it and states the intended result of the work."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial (HETO 0.1.0); Baines D. Defining tasks in HETO. Brief to the curator, 15 October 2026 (classification, decomposition and ordering)" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain obo:IAO_0000104 ;
    rdfs:range obo:IAO_0000005 ;
    rdfs:subPropertyOf obo:BFO_0000051 .

heto:1000006 a owl:ObjectProperty ;
    rdfs:label "has action specification"@en ;
    obo:IAO_0000115 "Relates a plan specification to an action specification that is part of it and states one of the main actions of the work."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial (HETO 0.1.0); Baines D. Defining tasks in HETO. Brief to the curator, 15 October 2026 (classification, decomposition and ordering)" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain obo:IAO_0000104 ;
    rdfs:range obo:IAO_0000007 ;
    rdfs:subPropertyOf obo:BFO_0000051 .

heto:4000001 a owl:NamedIndividual,
        heto:0000001 ;
    rdfs:label "Conduct a model-based economic evaluation"@en ;
    obo:IAO_0000115 "A task specification for comparing the costs and health outcomes of two or more options for a stated decision problem by means of an economic model, so that a decision maker can judge which option offers better value."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Drummond et al. 2015" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    heto:1000001 heto:4000002,
        heto:4000005,
        heto:4000011,
        heto:4000012,
        heto:4000013,
        heto:4000016 ;
    heto:1000005 heto:4100101 ;
    heto:1000006 heto:4200101,
        heto:4200102,
        heto:4200103,
        heto:4200104 ;
    heto:3000002 rheo:0000027 ;
    heto:3000003 rheo:0000022,
        rheo:0000025,
        rheo:0000035 ;
    heto:3000004 obo:IAO_0000310,
        rheo:0000032 ;
    heto:3000005 rheo:0000031 ;
