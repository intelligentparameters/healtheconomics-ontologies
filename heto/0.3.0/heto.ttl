    heto:3000007 "The economic model version, its base-case results and descriptions of the uncertainty in its inputs."@en ;
    heto:3000008 "Sensitivity analysis results."@en .

heto:4000018 a owl:NamedIndividual,
        heto:0000011 ;
    rdfs:label "Estimate transition probabilities and treatment effects"@en ;
    obo:IAO_0000115 "A task specification for estimating, from clinical evidence, the probabilities of moving between the states of an economic model and the effects of each option on them, including any extrapolation beyond the observed follow-up, as inputs to the model."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Briggs, Claxton and Sculpher 2006" ;
