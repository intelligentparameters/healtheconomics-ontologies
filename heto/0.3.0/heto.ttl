        rheo:0000030,
        rheo:0000032 ;
    heto:3000004 obo:IAO_0000310 ;
    heto:3000006 heto:0000040 ;
    heto:3000007 "The decision problem specification, the model version with its documentation and parameter assignments, and all results."@en ;
    heto:3000008 "A report of the economic evaluation."@en .

heto:0000011 a owl:Class ;
    rdfs:label "economic model development task specification"@en ;
    obo:IAO_0000115 "A task specification whose intended result is an economic model, or a part or feature of one such as its structure or its calculations."@en ;
    obo:IAO_0000116 "Classification only. Whether a task is part of developing a model is recorded with 'has subtask specification', not by placing it under this class."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Briggs, Claxton and Sculpher 2006" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:subClassOf heto:0000001 .

heto:0000014 a owl:Class ;
    rdfs:label "uncertainty analysis task specification"@en ;
    obo:IAO_0000115 "A task specification whose intended result is a description of how uncertainty in inputs, assumptions or model structure affects the results or the decision of an economic evaluation."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Briggs, Claxton and Sculpher 2006" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:subClassOf heto:0000001 .

heto:3000002 a owl:AnnotationProperty ;
    rdfs:label "involves type"@en ;
    obo:IAO_0000115 "Relates a task specification to a class, defined in RHEO, OHEO or a reused ontology, whose instances the work uses, produces, acts on or takes place as. The value is a class URI, never a HEO concept."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial (HETO 0.1.0)" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> .

heto:4000012 a owl:NamedIndividual,
        heto:0000016 ;
    rdfs:label "Calculate incremental cost-effectiveness results"@en ;
    obo:IAO_0000115 "A task specification for comparing the expected costs and health outcomes of the options in an economic evaluation, ruling out dominated and extendedly dominated options and calculating incremental cost-effectiveness ratios or net benefit for the rest."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Drummond et al. 2015" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    heto:1000003 heto:4000013 ;
    heto:1000005 heto:4101201 ;
    heto:1000006 heto:4201201,
        heto:4201202,
        heto:4201203 ;
