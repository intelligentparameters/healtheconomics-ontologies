        rheo:0000071,
        rheo:0000072 ;
    heto:3000004 rheo:0000015 ;
    heto:3000006 heto:0000040 ;
    heto:3000007 "The perspective, the model structure, and records or published sources of resource use."@en ;
    heto:3000008 "Resource use estimates in natural units."@en .

heto:4000016 a owl:NamedIndividual,
        heto:0000017 ;
    rdfs:label "Report an economic evaluation"@en ;
    obo:IAO_0000115 "A task specification for writing a full and transparent account of the methods, inputs, results and uncertainty of an economic evaluation, so that readers and decision makers can judge and reproduce it."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Husereau et al. 2022" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
