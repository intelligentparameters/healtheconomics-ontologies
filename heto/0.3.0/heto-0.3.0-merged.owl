    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_3000001 -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_3000001">
        <obo:IAO_0000115 xml:lang="en">Obsolete. In HETO 0.1.0 this related a task specification to a HEO concept a person needs to understand to do the work.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Made obsolete in 0.2.0. HEO concepts are not real things, so HETO&apos;s logical links now go to RHEO and OHEO types (involves type and its sub-properties). The task-to-concept links are kept, for learning and navigation only, as skos:relatedMatch rows in heto-mappings.sssom.tsv, their one home.</obo:IAO_0000116>
        <obo:IAO_0000119>Darrin Baines, decision of 17 October 2026, approved by Michelle Ashley</obo:IAO_0000119>
        <obo:IAO_0000231 rdf:resource="http://purl.obolibrary.org/obo/OMO_0001000"/>
        <oboInOwl:consider rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_3000002"/>
        <rdfs:label xml:lang="en">obsolete requires concept</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_3000002 -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_3000002">
        <obo:IAO_0000115 xml:lang="en">Relates a task specification to a class, defined in RHEO, OHEO or a reused ontology, whose instances the work uses, produces, acts on or takes place as. The value is a class URI, never a HEO concept.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>HealthEconomics.wiki editorial (HETO 0.1.0)</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">involves type</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_3000003 -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_3000003">
        <obo:IAO_0000115 xml:lang="en">Relates a task specification to a class whose instances are usual inputs to the work.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>HealthEconomics.wiki editorial (HETO 0.1.0)</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">has input type</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_3000002"/>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_3000004 -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_3000004">
        <obo:IAO_0000115 xml:lang="en">Relates a task specification to a class whose instances are usual outputs of the work.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>HealthEconomics.wiki editorial (HETO 0.1.0)</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">has output type</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_3000002"/>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_3000005 -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_3000005">
        <obo:IAO_0000115 xml:lang="en">Relates a task specification to a class of process in which the work, or a main part of it, is carried out. The value is a subclass of BFO process. It names a process type; a particular performance is recorded separately.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>HealthEconomics.wiki editorial (HETO 0.1.0)</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">has process type</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_3000002"/>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_3000006 -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_3000006">
        <obo:IAO_0000115 xml:lang="en">Relates a task specification to the role class whose bearers usually carry out the work. The value is a subclass of health economics practitioner role.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>HealthEconomics.wiki editorial (HETO 0.1.0)</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">has practitioner role</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_3000007 -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_3000007">
        <obo:IAO_0000115 xml:lang="en">A plain-language statement of the usual inputs to the work a task specification describes.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>HealthEconomics.wiki editorial (HETO 0.1.0)</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">inputs description</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_3000008 -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_3000008">
        <obo:IAO_0000115 xml:lang="en">A plain-language statement of the usual result the work a task specification describes produces.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>HealthEconomics.wiki editorial (HETO 0.1.0)</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">expected output description</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_3000009 -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_3000009">
        <obo:IAO_0000115 xml:lang="en">Relates a task specification to a separate resource, such as a methods guide or a teaching page, that gives detailed guidance on doing the work. The value is the resource&apos;s URL, labelled with its name, its version or date, and the date the link was checked. HETO does not take any figure or rule from the resource.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>HealthEconomics.wiki editorial (HETO 0.1.0)</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">has guidance resource</rdfs:label>
    </owl:AnnotationProperty>
    


