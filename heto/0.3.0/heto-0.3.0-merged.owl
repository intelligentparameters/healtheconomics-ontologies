    <!-- http://purl.obolibrary.org/obo/BFO_0000050 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/BFO_0000050">
        <owl:inverseOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
        <obo:IAO_0000115 xml:lang="en">a core relation that holds between a part and its whole</obo:IAO_0000115>
        <obo:IAO_0000119>RO (http://purl.obolibrary.org/obo/ro.owl)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo.owl"/>
        <rdfs:label xml:lang="en">part of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000051 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/BFO_0000051">
        <obo:IAO_0000115 xml:lang="en">a core relation that holds between a whole and its part</obo:IAO_0000115>
        <obo:IAO_0000119>RO (http://purl.obolibrary.org/obo/ro.owl)</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ro.owl"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo.owl"/>
        <rdfs:label xml:lang="en">has part</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0000417 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/OBI_0000417">
        <obo:IAO_0000115 xml:lang="en">This relation obtains between a planned process and a objective specification when the criteria specified in the objective specification are met at the end of the planned process.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">OBI&apos;s label is kept as served. The relation links a task performance to the objective specification of its task when the objective was met.</obo:IAO_0000116>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/obi.owl"/>
        <rdfs:label xml:lang="en">achieves_planned_objective</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0017002 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0017002">
        <owl:inverseOf rdf:resource="http://purl.obolibrary.org/obo/RO_0017010"/>
        <obo:IAO_0000115 xml:lang="en">A relation between information and an entity such that the information serves as a rule or guide if the entity is an occurrent, or the information serves as a model if the entity is a continuant.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">RO records this relation as an exact match of the Common Core Ontologies relation &apos;prescribes&apos;, the relation Duncan et al. 2024 recommend for linking a plan specification to the process it guides.</obo:IAO_0000116>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ro.owl"/>
        <rdfs:label xml:lang="en">information specifies</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0017010 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0017010">
        <obo:IAO_0000115 xml:lang="en">Inverse of information specifies.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">HETO uses this relation from a health economics task performance to the task specification that prescribes it. It holds whether or not the performance succeeds.</obo:IAO_0000116>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ro.owl"/>
        <rdfs:label xml:lang="en">specified by information</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_1000001 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_1000001">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
        <owl:inverseOf rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_1000002"/>
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000001"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000001"/>
        <obo:IAO_0000115 xml:lang="en">Relates a task specification to another task specification that describes a smaller unit of the work it describes. This is decomposition. A subtask is a part of the larger task, not a kind of it.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>HealthEconomics.wiki editorial (HETO 0.1.0); Baines D. Defining tasks in HETO. Brief to the curator, 15 October 2026 (classification, decomposition and ordering)</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">has subtask specification</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_1000002 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_1000002">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000001"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000001"/>
        <obo:IAO_0000115 xml:lang="en">Relates a task specification to a larger task specification of which it describes a part of the work.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>HealthEconomics.wiki editorial (HETO 0.1.0); Baines D. Defining tasks in HETO. Brief to the curator, 15 October 2026 (classification, decomposition and ordering)</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">subtask specification of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_1000003 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_1000003">
        <owl:inverseOf rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_1000004"/>
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000001"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000001"/>
        <obo:IAO_0000115 xml:lang="en">Relates two task specifications when the work the first describes is usually done, at least in a first version, before the work the second describes begins. This is ordering. It states usual practice, not a rule, and work is often revisited.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>HealthEconomics.wiki editorial (HETO 0.1.0); Baines D. Defining tasks in HETO. Brief to the curator, 15 October 2026 (classification, decomposition and ordering)</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">normally precedes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_1000004 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_1000004">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000001"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000001"/>
        <obo:IAO_0000115 xml:lang="en">Relates two task specifications when the work the second describes is usually done, at least in a first version, before the work the first describes begins.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>HealthEconomics.wiki editorial (HETO 0.1.0); Baines D. Defining tasks in HETO. Brief to the curator, 15 October 2026 (classification, decomposition and ordering)</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">normally preceded by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_1000005 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_1000005">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/IAO_0000005"/>
        <obo:IAO_0000115 xml:lang="en">Relates a plan specification to an objective specification that is part of it and states the intended result of the work.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>HealthEconomics.wiki editorial (HETO 0.1.0); Baines D. Defining tasks in HETO. Brief to the curator, 15 October 2026 (classification, decomposition and ordering)</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">has objective specification</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_1000006 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_1000006">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/IAO_0000007"/>
        <obo:IAO_0000115 xml:lang="en">Relates a plan specification to an action specification that is part of it and states one of the main actions of the work.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>HealthEconomics.wiki editorial (HETO 0.1.0); Baines D. Defining tasks in HETO. Brief to the curator, 15 October 2026 (classification, decomposition and ordering)</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">has action specification</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_1000008 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000008">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000099"/>
        <obo:IAO_0000115 xml:lang="en">Relates an outcome measurement instrument to its health state classification system.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">has descriptive system</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_1000010 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000010">
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
        <obo:IAO_0000115 xml:lang="en">Relates a scoring algorithm or a value set to the outcome measurement instrument whose responses it scores.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">scores instrument</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_1000012 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000012">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000107"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
        <obo:IAO_0000115 xml:lang="en">Relates a mapping function to the instrument whose score or utility it predicts.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">maps to instrument</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_1000034 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000034">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000105"/>
        <obo:IAO_0000115 xml:lang="en">Relates an outcome measurement instrument to a value set that has been published for its descriptive system. An instrument with one is a preference-based measure.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">has published value set</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_1000012 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000012">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000030"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000029"/>
        <obo:IAO_0000115 xml:lang="en">Relates a parameter assignment to the model parameter it sets.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">assigns parameter</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_1000013 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000013">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000030"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000028"/>
        <obo:IAO_0000115 xml:lang="en">Relates a parameter assignment to the economic model version in which it applies.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">for model version</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_1000017 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000017">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000031"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000028"/>
        <obo:IAO_0000115 xml:lang="en">Relates a model run to the economic model version it executes.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">executes model version</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_1000098 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000098">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">Relates a parameter assignment to the estimate it selects or the assumption it adopts. The parent of &apos;selects estimate&apos; and &apos;adopts assumption&apos;.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has basis</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.obolibrary.org/obo/BFO_0000001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000001">
        <obo:IAO_0000115 xml:lang="en">An entity is anything that exists or has existed or will exist.</obo:IAO_0000115>
        <obo:IAO_0000119>BFO 2020 (ISO/IEC 21838-2:2021) (elucidation)</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <dc:identifier>001-BFO</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <rdfs:label xml:lang="en">entity</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) An entity is anything that exists or has existed or will exist</skos:definition>
        <skos:example xml:lang="en">Julius Caesar; the Second World War; your body mass index; Verdi&apos;s Requiem</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <obo:IAO_0000115 xml:lang="en">A continuant is an entity that persists, endures, or continues to exist through time while maintaining its identity.</obo:IAO_0000115>
        <obo:IAO_0000119>BFO 2020 (ISO/IEC 21838-2:2021) (elucidation)</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <dc:identifier>008-BFO</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <rdfs:label xml:lang="en">continuant</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) A continuant is an entity that persists, endures, or continues to exist through time while maintaining its identity</skos:definition>
        <skos:example xml:lang="en">A human being; a tennis ball; a cave; a region of space; someone&apos;s temperature</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000003 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
        <obo:IAO_0000115 xml:lang="en">An occurrent is an entity that unfolds itself in time or it is the start or end of such an entity or it is a temporal or spatiotemporal region.</obo:IAO_0000115>
        <obo:IAO_0000119>BFO 2020 (ISO/IEC 21838-2:2021) (elucidation)</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <dc:identifier>077-BFO</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <rdfs:label xml:lang="en">occurrent</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) An occurrent is an entity that unfolds itself in time or it is the start or end of such an entity or it is a temporal or spatiotemporal region</skos:definition>
        <skos:example xml:lang="en">As for process, history, process boundary, spatiotemporal region, zero-dimensional temporal region, one-dimensional temporal region, temporal interval, temporal instant.</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <obo:IAO_0000115 xml:lang="en">b is an independent continuant =Def b is a continuant &amp; there is no c such that b specifically depends on c or b generically depends on c.</obo:IAO_0000115>
        <obo:IAO_0000119>BFO 2020 (ISO/IEC 21838-2:2021)</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <dc:identifier>017-BFO</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <rdfs:label xml:lang="en">independent continuant</rdfs:label>
        <skos:definition xml:lang="en">b is an independent continuant =Def b is a continuant &amp; there is no c such that b specifically depends on c or b generically depends on c</skos:definition>
        <skos:example xml:lang="en">An atom; a molecule; an organism; a heart; a chair; the bottom right portion of a human torso; a leg; the interior of your mouth; a spatial region; an orchestra</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000015 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000015">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <obo:IAO_0000115 xml:lang="en">p is a process means p is an occurrent that has some temporal proper part and for some time t, p has some material entity as participant.</obo:IAO_0000115>
        <obo:IAO_0000119>BFO 2020 (ISO/IEC 21838-2:2021) (elucidation)</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <dc:identifier>083-BFO</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <rdfs:label xml:lang="en">process</rdfs:label>
        <skos:altLabel xml:lang="en">event</skos:altLabel>
        <skos:definition xml:lang="en">(Elucidation) p is a process means p is an occurrent that has some temporal proper part and for some time t, p has some material entity as participant</skos:definition>
        <skos:example xml:lang="en">An act of selling; the life of an organism; a process of sleeping; a process of cell-division; a beating of the heart; a process of meiosis; the taxiing of an aircraft; the programming of a computer</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000017 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000017">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000020"/>
        <obo:IAO_0000115 xml:lang="en">A realizable entity is a specifically dependent continuant that inheres in some independent continuant which is not a spatial region &amp; which is of a type some instances of which are realized in processes of a correlated type.</obo:IAO_0000115>
        <obo:IAO_0000119>BFO 2020 (ISO/IEC 21838-2:2021) (elucidation)</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <dc:identifier>058-BFO</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <rdfs:label xml:lang="en">realizable entity</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) A realizable entity is a specifically dependent continuant that inheres in some independent continuant which is not a spatial region &amp; which is of a type some instances of which are realized in processes of a correlated type</skos:definition>
        <skos:example xml:lang="en">The role of being a doctor; the role of this boundary to delineate where Utah and Colorado meet; the function of your reproductive organs; the disposition of your blood to coagulate; the disposition of this piece of metal to conduct electricity</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000020 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <obo:IAO_0000115 xml:lang="en">b is a specifically dependent continuant =Def b is a continuant &amp; there is some independent continuant c which is not a spatial region &amp; which is such that b specifically depends on c.</obo:IAO_0000115>
        <obo:IAO_0000119>BFO 2020 (ISO/IEC 21838-2:2021)</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <dc:identifier>050-BFO</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <rdfs:label xml:lang="en">specifically dependent continuant</rdfs:label>
        <skos:definition xml:lang="en">b is a specifically dependent continuant =Def b is a continuant &amp; there is some independent continuant c which is not a spatial region &amp; which is such that b specifically depends on c</skos:definition>
        <skos:example xml:lang="en">(with multiple bearers) John&apos;s love for Mary; the ownership relation between John and this statue; the relation of authority between John and his subordinates</skos:example>
        <skos:example xml:lang="en">(with one bearer) The mass of this tomato; the pink colour of a medium rare piece of grilled filet mignon at its centre; the smell of this portion of mozzarella; the disposition of this fish to decay; the role of being a doctor; the function of this heart to pump blood; the shape of this hole</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000023 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000023">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
        <obo:IAO_0000115 xml:lang="en">A role b is a realizable entity such that b exists because there is some single bearer that is in some special physical, social, or institutional set of circumstances in which this bearer does not have to be &amp; b is not such that, if it ceases to exist, then the physical make-up of the bearer is thereby changed.</obo:IAO_0000115>
        <obo:IAO_0000119>BFO 2020 (ISO/IEC 21838-2:2021) (elucidation)</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <dc:identifier>061-BFO</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <rdfs:label xml:lang="en">role</rdfs:label>
        <skos:altLabel xml:lang="en">externally-grounded realizable entity</skos:altLabel>
        <skos:definition xml:lang="en">(Elucidation) A role b is a realizable entity such that b exists because there is some single bearer that is in some special physical, social, or institutional set of circumstances in which this bearer does not have to be &amp; b is not such that, if it ceases to exist, then the physical make-up of the bearer is thereby changed</skos:definition>
        <skos:example xml:lang="en">The priest role; the student role; the role of subject in a clinical trial; the role of a stone in marking a property boundary; the role of a boundary to demarcate two neighbouring administrative territories; the role of a building in serving as a military target</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000031 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000031">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <obo:IAO_0000115 xml:lang="en">A generically dependent continuant is an entity that exists in virtue of the fact that there is at least one of what may be multiple copies which is the content or the pattern that multiple copies would share.</obo:IAO_0000115>
        <obo:IAO_0000119>BFO 2020 (ISO/IEC 21838-2:2021) (elucidation)</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <dc:identifier>074-BFO</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <rdfs:label xml:lang="en">generically dependent continuant</rdfs:label>
        <skos:altLabel xml:lang="en">g-dependent continuant</skos:altLabel>
        <skos:definition xml:lang="en">(Elucidation) A generically dependent continuant is an entity that exists in virtue of the fact that there is at least one of what may be multiple copies which is the content or the pattern that multiple copies would share</skos:definition>
        <skos:example xml:lang="en">The pdf file on your laptop; the pdf file that is a copy thereof on my laptop; the sequence of this protein molecule; the sequence that is a copy thereof in that protein molecule; the content that is shared by a string of dots and dashes written on a page and the transmitted Morse code signal; the content of a sentence; an engineering blueprint</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/COB_0000082 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/COB_0000082">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000115 xml:lang="en">A process that is initiated by an agent who intends to carry out a plan to achieve an objective through one or more actions as described in a plan specification.</obo:IAO_0000115>
        <obo:IAO_0000119>OBI (http://purl.obolibrary.org/obo/obi.owl)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/obi.owl"/>
        <rdfs:label xml:lang="en">planned process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000005 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000005">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <obo:IAO_0000115 xml:lang="en">A directive information entity that describes an intended process endpoint. When part of a plan specification the concretization is realized in a planned process in which the bearer tries to effect the world so that the process endpoint is achieved.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Used in HETO for the intended result of a task, one objective specification per task specification.</obo:IAO_0000116>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/iao.owl"/>
        <rdfs:label xml:lang="en">objective specification</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000007 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <obo:IAO_0000115 xml:lang="en">A directive information entity that describes an action the bearer will take.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Used in HETO for the main actions of a task. Detailed implementation steps belong in guidance, not here.</obo:IAO_0000116>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/iao.owl"/>
        <rdfs:label xml:lang="en">action specification</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000027 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that is intended to be one or more truthful statement(s) about something (modulo, e.g., measurement precision or other systematic errors) and is constructed/acquired by a method which reliably tends to produce (approximately) truthful statements.</obo:IAO_0000115>
        <obo:IAO_0000119>IAO (http://purl.obolibrary.org/obo/iao.owl)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/iao.owl"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">data entity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000030 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000030">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <obo:IAO_0000115 xml:lang="en">A generically dependent continuant that is about some thing.</obo:IAO_0000115>
        <obo:IAO_0000119>IAO (http://purl.obolibrary.org/obo/iao.owl)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/iao.owl"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">information content entity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000033 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000033">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity whose concretizations indicate to their bearer how to realize them in a process.</obo:IAO_0000115>
        <obo:IAO_0000119>IAO (http://purl.obolibrary.org/obo/iao.owl)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/iao.owl"/>
        <rdfs:label xml:lang="en">directive information entity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000064 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000064">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
        <obo:IAO_0000115 xml:lang="en">A plan specification which describes the inputs and output of mathematical functions as well as workflow of execution for achieving an predefined objective. Algorithms are realized usually by means of implementation as computer programs for execution by automata.</obo:IAO_0000115>
        <obo:IAO_0000119>IAO (http://purl.obolibrary.org/obo/iao.owl)</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/iao.owl"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/iao.owl"/>
        <rdfs:label xml:lang="en">algorithm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000104 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000104">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <obo:IAO_0000115 xml:lang="en">A directive information entity with action specifications and objective specifications as parts, and that may be concretized as a realizable entity that, if realized, is realized in a process in which the bearer tries to achieve the objectives by taking the actions specified.</obo:IAO_0000115>
        <obo:IAO_0000119>IAO (http://purl.obolibrary.org/obo/iao.owl)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/iao.owl"/>
        <rdfs:label xml:lang="en">plan specification</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000109 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000109">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000032"/>
        <obo:IAO_0000115 xml:lang="en">A measurement datum is an information content entity that is a recording of the output of a measurement such as produced by a device.</obo:IAO_0000115>
        <obo:IAO_0000119>IAO (http://purl.obolibrary.org/obo/iao.owl)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/iao.owl"/>
        <rdfs:label xml:lang="en">measurement datum</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000310 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000310">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">A collection of information content entities intended to be understood together as a whole</obo:IAO_0000115>
        <obo:IAO_0000119>IAO (http://purl.obolibrary.org/obo/iao.owl)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/iao.owl"/>
        <rdfs:label xml:lang="en">document</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0001930 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0001930">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001933"/>
        <obo:IAO_0000115 xml:lang="en">A value specification that is specifies one category out of a fixed number of nominal categories</obo:IAO_0000115>
        <obo:IAO_0000119>OBI (http://purl.obolibrary.org/obo/obi.owl)</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/obi.owl"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/obi.owl"/>
        <rdfs:label xml:lang="en">categorical value specification</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0001933 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0001933">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that specifies a value within a classification scheme or on a quantitative scale.</obo:IAO_0000115>
        <obo:IAO_0000119>OBI (http://purl.obolibrary.org/obo/obi.owl)</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/obi.owl"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/obi.owl"/>
        <rdfs:label xml:lang="en">value specification</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0500000 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0500000">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
        <obo:IAO_0000115 xml:lang="en">A plan specification comprised of protocols (which may specify how and what kinds of data will be gathered) that are executed as part of an investigation and is realized during a study design execution.</obo:IAO_0000115>
        <obo:IAO_0000119>OBI (http://purl.obolibrary.org/obo/obi.owl)</obo:IAO_0000119>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/obi.owl"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/obi.owl"/>
        <rdfs:label xml:lang="en">study design</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/STATO_0000039 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/STATO_0000039">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <obo:IAO_0000115 xml:lang="en">a statistic is a measurement datum to describe a dataset or a variable. It is generated by a calculation on set of observed data.</obo:IAO_0000115>
        <obo:IAO_0000119>STATO (http://purl.obolibrary.org/obo/stato.owl)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/stato.owl"/>
        <rdfs:label xml:lang="en">statistic</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/STATO_0000471 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/STATO_0000471">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/STATO_0000039"/>
        <obo:IAO_0000115 xml:lang="en">a estimate is a data item which is computed from a dataset to provide an approximated value (an estimator) for a &apos;statistical parameter&apos; (a &apos;characteristics/parameter&apos; of the true underlying distribution) of a real population.</obo:IAO_0000115>
        <obo:IAO_0000119>STATO (http://purl.obolibrary.org/obo/stato.owl)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/stato.owl"/>
        <rdfs:label xml:lang="en">estimate</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/STATO_0000599 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/STATO_0000599">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/STATO_0000471"/>
        <obo:IAO_0000115 xml:lang="en">a point estimate is a data item which provides a particular value evaluating a population parameter</obo:IAO_0000115>
        <obo:IAO_0000119>STATO (http://purl.obolibrary.org/obo/stato.owl)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/stato.owl"/>
        <rdfs:label xml:lang="en">point estimate</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_0000001 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_0000001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_1000005"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/IAO_0000005"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_1000006"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/IAO_0000007"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A plan specification that describes a reusable, defined unit of health economics work, stating the result the work is meant to achieve and the main actions directed towards it, independently of any particular practitioner, project or software.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Each named task in the HETO catalogue is one individual of this class or of one of its subclasses, with its own URI. The specification is information. A particular practitioner doing the work is a separate process, a health economics task performance, linked to the specification by &apos;specified by information&apos; (RO_0017010), as Duncan et al. 2024 propose for plan specifications. A calendar reminder, a topic heading or one person&apos;s to-do item is not by itself a task specification.</obo:IAO_0000116>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>Baines D. Defining tasks in HETO. Brief to the curator, 15 October 2026; IAO plan specification (IAO_0000104)</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">task specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_0000002 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_0000002">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_0000001"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_1000001"/>
                        <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000001"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000001"/>
        <obo:IAO_0000115 xml:lang="en">A task specification that has one or more other task specifications as subtasks, so that it describes a larger undertaking made up of smaller units of work.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Defined class. Do not assert it. A reasoner places a task specification here when it has a subtask, so the level of a task is worked out from the decomposition and no fixed depth is imposed.</obo:IAO_0000116>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>Baines D. Defining tasks in HETO. Brief to the curator, 15 October 2026 (levels of work)</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">composite task specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_0000010 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_0000010">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000001"/>
        <obo:IAO_0000115 xml:lang="en">A task specification whose intended result is a statement of the decision an economic evaluation will inform, or of one element of it such as the perspective or the time horizon.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">decision problem framing task specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_0000011 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_0000011">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000001"/>
        <obo:IAO_0000115 xml:lang="en">A task specification whose intended result is an economic model, or a part or feature of one such as its structure or its calculations.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Classification only. Whether a task is part of developing a model is recorded with &apos;has subtask specification&apos;, not by placing it under this class.</obo:IAO_0000116>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>Briggs, Claxton and Sculpher 2006</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">economic model development task specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_0000012 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_0000012">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000001"/>
        <obo:IAO_0000115 xml:lang="en">A task specification whose intended result is the identification, measurement or valuation of the resources used by the options compared in an economic evaluation.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">costing task specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_0000013 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_0000013">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000001"/>
        <obo:IAO_0000115 xml:lang="en">A task specification whose intended result is a value placed on health outcomes or health states, such as the utility values given to the states of an economic model.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">health outcome valuation task specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_0000014 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_0000014">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000001"/>
        <obo:IAO_0000115 xml:lang="en">A task specification whose intended result is a description of how uncertainty in inputs, assumptions or model structure affects the results or the decision of an economic evaluation.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>Briggs, Claxton and Sculpher 2006</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">uncertainty analysis task specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_0000015 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_0000015">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000001"/>
        <obo:IAO_0000115 xml:lang="en">A task specification whose intended result is evidence on whether an economic model is technically correct, credible and fit for its decision purpose.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>Eddy et al. 2012; Vemer et al. 2016</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">model validation task specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_0000016 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_0000016">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000001"/>
        <obo:IAO_0000115 xml:lang="en">A task specification whose intended result is a comparison of the costs and health outcomes of the options in an economic evaluation, such as incremental cost-effectiveness ratios or net benefit.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">results analysis task specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_0000017 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_0000017">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000001"/>
        <obo:IAO_0000115 xml:lang="en">A task specification whose intended result is a written account of health economics work for readers, reviewers or decision makers.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>Husereau et al. 2022</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">reporting task specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_0000030 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_0000030">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0000082"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0017010"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A planned process in which one or more people carry out health economics work as a task specification in the HETO catalogue prescribes, whether or not the work achieves its objective.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">A performance is linked to the task specification that prescribes it by &apos;specified by information&apos; (RO_0017010). That link holds even when the work fails or departs from the specification, which is why HETO uses it rather than requiring a plan that concretizes the specification (Duncan et al. 2024). The kinds of process involved, such as a RHEO model run, are recorded on the task specification with &apos;has process type&apos;.</obo:IAO_0000116>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>COB planned process (COB_0000082); Duncan et al. 2024</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">health economics task performance</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_0000040 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_0000040">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <obo:IAO_0000115 xml:lang="en">A role borne by a person that is realised when that person carries out health economics work, such as framing, costing, modelling, analysing or reporting an economic evaluation.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Roles only. People are RHEO persons (Homo sapiens) and organisations are OBI organizations; neither is placed in this hierarchy. A person bears the role; the role is realised in a task performance.</obo:IAO_0000116>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>HealthEconomics.wiki editorial (HETO 0.1.0)</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">health economics practitioner role</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_0000041 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_0000041">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000040"/>
        <obo:IAO_0000115 xml:lang="en">A health economics practitioner role that is realised when its bearer designs, builds, runs or checks an economic model.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>Baines D. Defining tasks in HETO. Brief to the curator, 15 October 2026 (practitioner role for adding discounting)</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">economic modeller role</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000001 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that names a category of health or health-related consequence, such as physical functioning or mortality, under which outcomes are grouped for selection, measurement, reporting and synthesis.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">A domain says what is measured, not how. OHEO follows the COMET outcome taxonomy, which Dodd et al. describe as &apos;intended for the classification of what, rather than how, outcomes are measured&apos;. Instruments that measure a domain are linked with &apos;has outcome domain&apos;.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from Dodd et al. 2018</obo:IAO_0000119>
        <dcterms:source>Dodd S, Clarke M, Becker L, Mavergames C, Fish R, Williamson PR. A taxonomy has been developed for outcomes in medical research to help improve knowledge discovery. J Clin Epidemiol. 2018;96:84-92. doi:10.1016/j.jclinepi.2017.12.020</dcterms:source>
        <oboInOwl:hasRelatedSynonym xml:lang="en">outcome area</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">outcome category</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">outcome domain</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000053 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000053">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000112 xml:lang="en">Change from baseline in EQ-5D-5L index at 12 months, mean, England value set.</obo:IAO_0000112>
        <obo:IAO_0000115 xml:lang="en">An information content entity that specifies an outcome to be measured or estimated by stating its domain and, where relevant, the measure, the metric, the method of aggregation and the time point.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The five elements follow the ClinicalTrials.gov outcome measure framework. An estimand (RHEO) points to the outcome specification that supplies its variable.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from Zarin et al. 2011</obo:IAO_0000119>
        <dcterms:source>Zarin DA, Tse T, Williams RJ, Califf RM, Ide NC. The ClinicalTrials.gov results database: update and key issues. N Engl J Med. 2011;364(9):852-60.</dcterms:source>
        <oboInOwl:hasDbXref>NCIT:C25212</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">endpoint</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">outcome measure definition</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">outcome</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">outcome specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000080 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000080">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that is an agreed, standardised set of outcomes that should be measured and reported, as a minimum, in all clinical trials in a specific area of health or health care.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Link outcomes with &apos;includes outcome&apos; and recommended instruments with &apos;recommends instrument&apos;.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Williamson et al. 2017 (COMET Handbook)</obo:IAO_0000119>
        <dcterms:source>Williamson PR, Altman DG, Bagley H, et al. The COMET Handbook: version 1.0. Trials. 2017;18(Suppl 3):280.</dcterms:source>
        <oboInOwl:hasExactSynonym xml:lang="en">COS</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">core outcome set</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000080"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">COS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <obo:IAO_0000115 xml:lang="en">A directive information entity that specifies how to obtain a score or classification for an outcome from a patient, a clinician, an observer or a performance task, including its items, response options and scoring rules. Each named instrument in OHEO, such as the EQ-5D-5L, is a class whose instances are the instrument&apos;s versions, such as one language and format version.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">An instrument is the specification. Administering it is an outcome assessment process; one person&apos;s result is an outcome measurement datum, a RHEO state observation or a RHEO utility measurement record. OHEO identifies three things separately: the instrument (its class, such as EQ-5D-5L), the instrument version (an instance of that class, such as one language and format version) and the value set (an instance of a value set class). The record rules check that a record names each one.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from Mokkink et al. 2010 (COSMIN)</obo:IAO_0000119>
        <dcterms:source>Mokkink LB, Terwee CB, Patrick DL, et al. The COSMIN study reached international consensus on taxonomy, terminology, and definitions of measurement properties for health-related patient-reported outcomes. J Clin Epidemiol. 2010;63(7):737-45.</dcterms:source>
        <oboInOwl:hasDbXref>NCIT:C142378</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">COA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">clinical outcome assessment</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">questionnaire</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">outcome measure</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">scale</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">outcome measurement instrument</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">COA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000090 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000090">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000034"/>
                        <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000105"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000008"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000099"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An outcome measurement instrument for which at least one value set has been published, so that each health state its descriptive system describes can be given a utility on a scale on which full health is 1 and dead is 0. The utilities belong to the value set, not to the instrument.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Defined class (0.2.0): an instrument is classified here by the reasoner when it has a published value set. The basis of indirect utility assessment for QALYs. A preference-based measure and its value set are different things: the instrument describes a health state, the value set values it.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <dcterms:source>Brazier J, Ratcliffe J, Salomon JA, Tsuchiya A. Measuring and Valuing Health Benefits for Economic Evaluation. 2nd ed. Oxford: Oxford University Press; 2017.</dcterms:source>
        <oboInOwl:hasExactSynonym xml:lang="en">MAUI</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">multi-attribute utility instrument</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">preference-based instrument</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">utility instrument</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">preference-based measure</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000090"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">MAUI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000096 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000096">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that is a single question, statement or task in an outcome measurement instrument, together with its response options.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from Mokkink et al. 2010 (COSMIN)</obo:IAO_0000119>
        <oboInOwl:hasRelatedSynonym xml:lang="en">question</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">instrument item</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000097 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000097">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000112 xml:lang="en">The &apos;anxiety/depression&apos; dimension of the EQ-5D-5L.</obo:IAO_0000112>
        <obo:IAO_0000115 xml:lang="en">An information content entity that is a part of an outcome measurement instrument describing one aspect of health, such as mobility or pain, by an ordered set of levels or a group of items.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">attribute</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">health dimension</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">subscale</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">instrument dimension</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000098 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000098">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000112 xml:lang="en">&apos;I have slight problems in walking about&apos;.</obo:IAO_0000112>
        <obo:IAO_0000115 xml:lang="en">An information content entity that is one of the ordered response categories of an instrument dimension or item.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">response level</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000099 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000099">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000065"/>
        <obo:IAO_0000112 xml:lang="en">The EQ-5D-5L descriptive system, with 3,125 health states.</obo:IAO_0000112>
        <obo:IAO_0000115 xml:lang="en">A classification scheme version that is the descriptive system of a preference-based measure, defining each health state as one combination of levels across its dimensions.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">A person&apos;s response is a RHEO state observation under this scheme, and the profile they report (for example 21121) is a RHEO health state classification profile.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">descriptive system</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">health state descriptive system</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">health state classification system</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000100 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000100">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <obo:IAO_0000115 xml:lang="en">A directive information entity that states the period of time a respondent should consider when answering an instrument, such as &apos;today&apos; or &apos;the past 4 weeks&apos;.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Most instruments record this as the &apos;has recall period&apos; value rather than as a separate entity.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>FDA 2009</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">recall period specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000101 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000101">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000064"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000105"/>
        <obo:IAO_0000115 xml:lang="en">An algorithm that converts responses to an outcome measurement instrument into one or more scores or classifications.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from Mokkink et al. 2010 (COSMIN)</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">scoring function</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">scoring rule</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">scoring algorithm</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000102 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000102">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that represents preferences over health states or health outcomes by assigning a number to each, so that more preferred states have higher numbers.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">utility function</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000103 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000103">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000102"/>
        <obo:IAO_0000115 xml:lang="en">A utility function that assigns a utility to outcomes described by several attributes, by combining preference weights for the level of each attribute.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Torrance et al. 1996</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">MAU function</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">multi-attribute utility</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">multi-attribute utility function</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000105 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000105">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000103"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000010"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A multi-attribute utility function that assigns a utility to every health state of a health state classification system, estimated from preferences elicited from a stated population by a stated valuation method. Each named value set in OHEO is a class whose instances are its published releases.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">A value set is a valuation, kept apart from the instrument whose descriptive system it values. In 0.1.0 it was also under scoring algorithm; its scoring role is stated by &apos;scores instrument&apos;.</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">A value set is a valuation, not part of the instrument: the same EQ-5D-5L responses give different utilities under different value sets, so a utility record must name both. Link to the instrument with &apos;scores instrument&apos;, to the elicitation method with &apos;has valuation method&apos; and to the population with &apos;elicited in population&apos;. A correction or re-estimation of a value set is a new release, which is a new instance.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <dcterms:source>Brazier J, Ratcliffe J, Salomon JA, Tsuchiya A. Measuring and Valuing Health Benefits for Economic Evaluation. 2nd ed. Oxford: Oxford University Press; 2017.</dcterms:source>
        <oboInOwl:hasExactSynonym xml:lang="en">utility tariff</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">preference weights</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">scoring algorithm (preference-based)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">tariff</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">value set</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000106 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000106">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that is a number in a value set giving the change in utility associated with one level of one dimension, or with an interaction between levels.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">dimension level weight</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">value set coefficient</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">preference weight</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000107 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000107">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000064"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000012"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An algorithm that predicts a score on a target instrument, usually a utility, from responses or scores on a source instrument, estimated from data in which both were collected.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Wailoo et al. 2017</obo:IAO_0000119>
        <dcterms:source>Wailoo AJ, Hernandez-Alava M, Manca A, et al. Mapping to estimate health-state utility from non-preference-based outcome measures: an ISPOR Good Practices for Outcomes Research Task Force report. Value Health. 2017;20(1):18-27.</dcterms:source>
        <oboInOwl:hasExactSynonym xml:lang="en">mapping algorithm</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">transfer-to-utility function</oboInOwl:hasNarrowSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">mapping function</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000109 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000109">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that classifies a score by which comparisons and arithmetic operations on its values are meaningful.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Stevens 1946</obo:IAO_0000119>
        <dcterms:source>Stevens SS. On the theory of scales of measurement. Science. 1946;103(2684):677-80.</dcterms:source>
        <oboInOwl:hasExactSynonym xml:lang="en">level of measurement</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">measurement scale type</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000114 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000114">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <obo:IAO_0000115 xml:lang="en">A directive information entity that states rules for assigning a person to an outcome category, such as a tumour response category or an adverse event grade.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">outcome classification criteria</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000188 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000188">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that states how an instrument is administered, such as self-completion on paper, electronic self-completion, interview or proxy completion.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Coons et al. 2009; FDA 2009</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">mode of administration</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">instrument administration mode</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000194 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000194">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0000082"/>
        <obo:IAO_0000115 xml:lang="en">A planned process in which people&apos;s preferences between outcomes, health states or attributes are obtained and quantified.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">preference measurement</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">preference elicitation process</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000196 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000196">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000194"/>
        <obo:IAO_0000115 xml:lang="en">A preference elicitation process that obtains values or orderings for health states, from which utilities on a scale on which full health is 1 and dead is 0 are taken directly or estimated by modelling.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">health state valuation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">utility elicitation</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">health state valuation process</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000223 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000223">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0500000"/>
        <obo:IAO_0000115 xml:lang="en">A study design for a preference elicitation study, stating the states or alternatives to be valued, the elicitation tasks, the sample and the analysis.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">valuation protocol</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">valuation study design</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000229 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000229">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that is the group of alternatives presented to a respondent in one choice task.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Reed Johnson et al. 2013</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">choice set</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000260 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000260">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000011"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000012"/>
        <obo:IAO_0000115 xml:lang="en">An economic evaluation estimate of a summary measure that combines length of life with a weight for the quality of health or the disability experienced, expressed either as healthy time lived or gained, as with QALYs, or as healthy time lost, as with DALYs.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Gold et al. 2002</obo:IAO_0000119>
        <dcterms:source>Gold MR, Stevenson D, Fryback DG. HALYS and QALYS and DALYS, oh my: similarities and differences in summary measures of population health. Annu Rev Public Health. 2002;23:115-34.</dcterms:source>
        <oboInOwl:hasRelatedSynonym xml:lang="en">HALY</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">health-adjusted life year</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">health-adjusted life year estimate</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000260"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">HALY</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000327 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000327">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <obo:IAO_0000115 xml:lang="en">A directive information entity that states the methods an economic evaluation must use to meet the standard of a decision-making body or methods panel, so that results are comparable across analyses.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The named profiles are individuals of this class (0.2.0). Their requirements are published as SHACL shapes in oheo-reference-case-shapes.ttl, one shape for each profile, and an analysis that claims conformance to a profile is checked against its shape.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>NICE 2022 (PMG36)</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">methods reference case</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">reference case</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">reference case profile</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000328 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000328">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <obo:IAO_0000115 xml:lang="en">A directive information entity that states one rule a reference case profile sets for how health outcomes are measured, valued, sourced or discounted.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Specific requirements are constraints in the SHACL shapes of oheo-reference-case-shapes.ttl. The 45 requirement classes of 0.1.0 are obsolete.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>NICE 2022 (PMG36)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">outcome reference case requirement</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000385 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000385">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001930"/>
        <obo:IAO_0000115 xml:lang="en">A categorical value specification that places an outcome measurement instrument in one category of a classification of instruments, such as generic or condition-specific design, or health profile scoring.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">An OHEO modelling term; its definition source is editorial by design.</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">Used with &apos;has instrument classification&apos; so that generic, condition-specific and health profile instruments are defined classes, inferred by the reasoner, rather than second asserted parents.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">instrument classification value</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000004 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that states the criteria, such as condition, severity, age range and care setting, defining the persons to whom an estimate, a study or a decision applies.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">A specification, not the group of persons itself: criteria-defined populations include future patients. The actual persons in a study can be added later as an OBI population (OBI_0000181).</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">population specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000011 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000011">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/STATO_0000599"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000020"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">A point estimate of a quantity used in an economic evaluation, such as a utility, a cost, a probability or a relative effect.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Which estimate a model uses is recorded separately, in a parameter assignment, so that one estimate can serve several models and a model can change its choice without changing the estimate. The context a usable estimate must carry is set by the record rules.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">economic evaluation estimate</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000012 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000012">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000011"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000090"/>
        <obo:IAO_0000112 xml:lang="en">Mean EQ-5D-3L utility of 0.78 for stable disease, UK value set.</obo:IAO_0000112>
        <obo:IAO_0000115 xml:lang="en">An economic evaluation estimate of the preference-based value of a health state on a scale on which full health is 1 and dead is 0, obtained by a stated valuation method and, for indirect methods, a stated instrument and value set.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">utility estimate</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000013 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000013">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000011"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000074"/>
        <obo:IAO_0000115 xml:lang="en">An economic evaluation estimate of the monetary value of resources consumed, valued from a stated perspective, in a stated currency and price year.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">May be negative, for example an incremental cost or a cost offset.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">cost estimate</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000014 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000014">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000013"/>
        <obo:IAO_0000115 xml:lang="en">A cost estimate for one unit of a resource or of a health care process, such as one hospital bed day or one consultation.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">unit cost estimate</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000015 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000015">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000011"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000071"/>
        <obo:IAO_0000115 xml:lang="en">An economic evaluation estimate of the quantity of a resource or a health care process used per person or per event over a stated period, in natural units.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">resource use estimate</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000016 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000016">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000011"/>
        <obo:IAO_0000115 xml:lang="en">An economic evaluation estimate of the probability that a kind of clinical event occurs, either within a stated time interval or per event, in a stated population.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">A probability over a time interval always needs that interval: the same rate gives different probabilities over different intervals.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Briggs et al. 2006</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">probability estimate</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000017 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000017">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000011"/>
        <obo:IAO_0000112 xml:lang="en">1.8 emergency admissions per patient-year among adults with moderate Merrow&apos;s disease (fictional).</obo:IAO_0000112>
        <obo:IAO_0000115 xml:lang="en">An economic evaluation estimate of the number of clinical events of a kind per unit of person-time in a stated population.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Briggs et al. 2006</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">event rate estimate</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000018 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000018">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000011"/>
        <obo:IAO_0000115 xml:lang="en">An economic evaluation estimate of the effect of an intervention relative to a comparator, expressed as a ratio or a difference, such as a hazard ratio or a relative risk.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Briggs et al. 2006</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">relative effect estimate</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000019 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000141"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000142"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that describes the uncertainty about an estimate or an assumed value, as a standard error, as an interval with its level, or as a probability distribution with its parameters.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Briggs et al. 2006</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">uncertainty specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000020 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that states a value or a condition adopted in an analysis without direct estimation from data, together with its justification.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">An assumption is not an estimate. Recording it separately lets an analyst list every result that depends on a judgement rather than on data. An assumed value may still carry a range for sensitivity analysis.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">modelling assumption</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000021 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000021">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000064"/>
        <obo:IAO_0000115 xml:lang="en">A state description that describes a health state of a person, such as stable disease or the EQ-5D profile 21121, that is observed, valued or modelled.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">A description, not the state of a person: a utility estimate values the state as described.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">health state description</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000022 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000022">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000310"/>
        <obo:IAO_0000115 xml:lang="en">A document from which an economic evaluation estimate is taken, such as a trial report, a published study, a national cost schedule or a registry report.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">evidence source document</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000025 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000025">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that states the decision an economic evaluation is to inform: the population, the options compared, the outcomes, the perspective, the setting and the time horizon.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">decision problem specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000026 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000026">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
        <obo:IAO_0000115 xml:lang="en">A plan specification describing a health care intervention or programme that is one of the options compared in an economic evaluation.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Being the comparator is not a kind of intervention: it is the place an intervention specification takes in a particular decision problem (see has comparator).</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">intervention specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000027 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000028"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that represents a decision problem mathematically and combines evidence and assumptions to estimate the costs and outcomes of the options compared.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Briggs et al. 2006</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">economic model</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000028 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000028">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that is a fixed, identified state of an economic model, with a defined structure and set of parameters, that can be run to produce results.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The spreadsheet or program file is the bearer that concretises a version; it is not part of the version&apos;s definition.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">economic model version</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000029 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000029">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that is a named input quantity of an economic model version, such as the utility of a health state or a transition probability.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The parameter is the input slot, not its value. Close to STATO model parameter (STATO_0000034), which is defined for statistical models.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">model parameter</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000030 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000030">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000012"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000029"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000013"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000028"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000098"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000011"/>
                            <rdf:Description rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000020"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000012"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000013"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000098"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An information content entity recording that, in a stated economic model version, a stated model parameter takes the value of one stated economic evaluation estimate or one stated modelling assumption, with the reason for the choice.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">OWL axioms (0.3.0): at most one basis, one parameter and one model version, and at least one of each. Under open-world semantics a missing basis is not an error for a reasoner, and two bases of the same kind are read as the same thing; an estimate and an assumption as two bases contradict, because estimates and assumptions are disjoint. Completeness (exactly one basis, units, population, time interval, justification, analysis) is checked by the record rules in rheo-shapes.ttl.</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">The assignment separates the evidence (the estimate) from the modelling decision to use it. A value computed from several inputs (a treatment-arm probability, an inflated cost) is recorded as a derived estimate, and the assignment selects that.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">parameter assignment</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000031 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000031">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0000082"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000017"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000028"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000017"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A planned process in which an economic model version is executed with a set of parameter assignments to produce results for a stated analysis, such as the base case or a scenario.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">model run</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000032 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000032">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000090"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000092"/>
        <obo:IAO_0000115 xml:lang="en">A data entity produced by a model run, such as a total cost, total quality-adjusted life years or an incremental cost-effectiveness ratio, for a stated option or comparison.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">model result</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000033 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000033">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000021"/>
        <obo:IAO_0000112 xml:lang="en">The EQ-5D-3L profile 21121.</obo:IAO_0000112>
        <obo:IAO_0000115 xml:lang="en">A health state description given as a combination of levels on the dimensions of a health state classification system, such as the EQ-5D profile 21121.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">health state classification profile</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000034 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000034">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000021"/>
        <obo:IAO_0000115 xml:lang="en">A health state description used as a state of an economic model, such as stable disease or progressed disease in a cohort model, that stands for the clinical or classification state descriptions it approximates.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">A model state is a component of an economic model. It is not a stage of disease, and no person is ever in it. Utilities measured in people value clinical or classification state descriptions; a model state points to the state it approximates with &apos;model state represents&apos;.</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">Tunnel states, which count time spent since an event, are model states: record them as model states that represent a clinical state (model state represents), not as states of a classification used for observation.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Briggs et al. 2006</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">model state</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000035 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000035">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that is a collection of patient-level or aggregate data from which an economic evaluation estimate is calculated, such as a trial dataset or an extract of routine data.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Used when an estimate comes from an analysis of data rather than from a published document.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">evidence dataset</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000062 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000062">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0000082"/>
        <obo:IAO_0000115 xml:lang="en">A planned process in which a decision-making body considers evidence, including economic evaluations, and decides whether a health technology should be funded and on what terms.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">health technology assessment decision process</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000064 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000064">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that describes one of the states into which persons or other entities can be classified at a time, such as stable disease, infected, vaccinated, current smoker, waiting for treatment or a deprivation quintile.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">state description</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000065 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000065">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that is a fixed, identified set of mutually exclusive and jointly exhaustive state descriptions used to classify persons or other entities at a time.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">When a scheme changes (a state is added, split, merged or renamed), a new version is issued, and the revision can be recorded with a classification revision record. A revision changes the description, not the entities described: a difference between states recorded under two versions is not by itself evidence that an entity changed or that a new possibility opened.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">classification scheme version</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000071 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000071">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000109"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000074"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000090"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000092"/>
        <obo:IAO_0000115 xml:lang="en">A measurement datum recording the quantity of a kind of resource used in a stated health care, social care or informal care process, in stated units.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">resource use record</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000072 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000072">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000075"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000083"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000093"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000117"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000134"/>
        <obo:IAO_0000115 xml:lang="en">A directive information entity stating whose resources and outcomes an economic evaluation counts, such as the health and personal social services system or society as a whole, by listing the kinds of resource included.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">perspective specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000073 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000073">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0000082"/>
        <obo:IAO_0000115 xml:lang="en">A planned process in which a monetary value is attached to recorded resource use, to care processes, to absences from work or to other cost records, from a stated perspective, producing cost records.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">A general class. Its kinds are unit cost valuation (a quantity multiplied by a unit cost), cost aggregation, cost adjustment, cost comparison and cost estimation. RHEO records the valuation as a real process done by an analyst or a system, and the cost records it produces as information, with the perspective and the assumptions of the valuation recorded with them.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">costing process</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000074 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000074">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000090"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000092"/>
        <obo:IAO_0000115 xml:lang="en">A data entity recording a value produced by a costing process, from a stated perspective: in money, in a stated currency and price year, such as the cost of one recorded resource use, an episode total, an adjusted or discounted cost, an incremental cost or an estimated cost; or, for a health opportunity cost, in health units such as QALYs.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">A cost record is not a cost estimate (RHEO_0000013): the record says what a valuation produced, the estimate is an input of a model. When an estimated cost record is used as a model input, record a cost estimate that is derived from it (taken from the dataset or derived from the record) and assign that estimate.</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">The record of a valuation, not a property of the resources. Which kind of costing produced it is shown by its links: &apos;values resource use&apos; and &apos;uses unit cost&apos; for a unit cost valuation; &apos;sums cost record&apos; for a total; &apos;adjusts cost record&apos; and &apos;uses adjustment factor&apos; for an adjustment; &apos;compares cost record&apos; with &apos;cost of alternative&apos; and &apos;compared with alternative&apos; for an incremental cost; has estimation method for an estimate. The record rules check each kind.</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">Who bears the cost is stated with &apos;borne by&apos;. A perspective that lists the bearers it counts (&apos;counts costs borne by&apos;) rejects a cost record borne by anyone else; a perspective without such a list counts every bearer (as a societal perspective does).</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">cost record</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000075 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000075">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000083"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000093"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000117"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000134"/>
        <obo:IAO_0000115 xml:lang="en">A directive information entity, issued by an organization, that sets the amount to be paid for a stated kind of care process in a stated period, such as a national price for an emergency admission.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">tariff</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000082 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000082">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000011"/>
        <obo:IAO_0000115 xml:lang="en">An economic evaluation estimate of the rate at which amounts in one currency or price year convert to another, such as an exchange rate or a purchasing power parity conversion factor.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">currency conversion estimate</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000083 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000083">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000093"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000117"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000134"/>
        <obo:IAO_0000115 xml:lang="en">A directive information entity issued by a decision-making body after a health technology assessment decision process, stating whether and on what terms a technology is to be funded.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">health technology assessment recommendation</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000090 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000090">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000109"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000092"/>
        <obo:IAO_0000115 xml:lang="en">A measurement datum recording a person&apos;s preference-based health state value at a stated time, obtained with a stated instrument and value set.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Records of individual people over time; a utility estimate (RHEO_0000012) is a summary across people.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">utility measurement record</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000091 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000091">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0000082"/>
        <obo:IAO_0000115 xml:lang="en">A planned process in which quality-adjusted life years are calculated from utility values and the time over which they apply, with or without discounting.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">QALY calculation process</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000092 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000092">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <obo:IAO_0000115 xml:lang="en">A data entity recording the quality-adjusted life years accrued by a person or a group over a stated period, undiscounted or discounted at a stated annual rate.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">QALY record</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000093 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000093">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000117"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000134"/>
        <obo:IAO_0000115 xml:lang="en">A directive information entity stating the annual discount rates for costs and for health outcomes and the base year to which future values are discounted.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">discounting specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000117 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000117">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000134"/>
        <obo:IAO_0000115 xml:lang="en">A directive information entity stating a value against which a decision maker compares the results of an economic evaluation, such as a cost-effectiveness threshold per QALY gained.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">decision threshold specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000119 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000119">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <obo:IAO_0000115 xml:lang="en">A data entity recording the value of an economic indicator for a country or other geographic area over a stated period, such as GDP per capita at purchasing power parity.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">economic indicator record</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000121 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000121">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that identifies a kind of item that resource use and cost records count or value, optionally with a code from a classification.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Use one of its two subclasses: care process type specification for a kind of care process, resource type specification for a kind of resource unit. Replaces RHEO_0000006, which covered both.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">costed item type specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000123 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000123">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000121"/>
        <obo:IAO_0000115 xml:lang="en">A costed item type specification that identifies a kind of resource unit that is consumed, occupied or used in care, such as a hospital bed day, a 28-day pack of a medicine, a vaccine dose or an hour of staff or carer time, optionally with a code from a classification.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">resource type specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000134 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000134">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <obo:IAO_0000115 xml:lang="en">A directive information entity, part of an economic model version or adopted for recording under a classification scheme version, stating which transitions between states are allowed, such as that no transition leaves the state dead, or that treatment cannot restart after it has stopped.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Absorption is a property of a state&apos;s use in a model or a recording scheme, not of the state description: one model may treat stopping treatment as absorbing because its structure excludes restarting, while another allows it.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">transition specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000141 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000141">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000142"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that describes the uncertainty of two or more quantities together, stating how their values vary jointly, such as a Dirichlet distribution over the transitions from one state, a multivariate normal over regression coefficients, or independent draws taken in one draw set.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Each quantity&apos;s own uncertainty specification is linked as a marginal.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Briggs et al. 2006</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo/uncertainty"/>
        <rdfs:label xml:lang="en">joint uncertainty specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000142 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000142">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity stating the correlation or covariance between two uncertain quantities, with its value and kind, such as a rank correlation of 0.5 imposed between two utilities.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Briggs et al. 2006</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo/uncertainty"/>
        <rdfs:label xml:lang="en">correlation specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000143 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000143">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <obo:IAO_0000115 xml:lang="en">A data entity that is an identified set of values sampled together in a probabilistic analysis, such as the 1,000 iterations of a probabilistic sensitivity analysis, with the number of draws and the random seed.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Quantities drawn in the same draw set are sampled together in each iteration: recording two marginal distributions does not say this.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Briggs et al. 2006</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo/uncertainty"/>
        <rdfs:label xml:lang="en">draw set</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000150 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000150">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000073"/>
        <obo:IAO_0000115 xml:lang="en">A costing process in which the quantity of each recorded resource use, or of a recorded absence from work, is multiplied by a stated unit cost, producing one cost record for each record valued.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Micro-costing (unit costs of individual items such as staff minutes and consumables) and gross costing (unit costs of whole care processes such as an admission) are both unit cost valuations; they differ in the level of the item valued (review B, 0.3.0).</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">unit cost valuation process</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000151 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000151">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000073"/>
        <obo:IAO_0000115 xml:lang="en">A costing process in which cost records are added together into a total, such as the cost of a care episode, a patient&apos;s annual cost or the cost of a programme.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">cost aggregation process</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000152 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000152">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000073"/>
        <obo:IAO_0000115 xml:lang="en">A costing process in which a cost record is converted to another currency, inflated or deflated to another price year, or discounted to a base year, using a stated factor.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The kind of adjustment is stated with has adjustment kind (inflation, deflation, currency conversion or discounting); the record rules check that the currency, price year and discounting fit the kind.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">cost adjustment process</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000153 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000153">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000073"/>
        <obo:IAO_0000115 xml:lang="en">A costing process in which the costs of two alternatives are compared, producing an incremental cost record, such as the difference in mean cost between a new treatment and standard care.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">cost comparison process</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.obolibrary.org/obo/OMO_0001000 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/OMO_0001000">
        <rdfs:label xml:lang="en">out of scope</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_4000001 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_4000001">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000001"/>
        <heto1:HETO_1000001 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000002"/>
        <heto1:HETO_1000001 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000005"/>
        <heto1:HETO_1000001 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000011"/>
        <heto1:HETO_1000001 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000012"/>
        <heto1:HETO_1000001 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000013"/>
        <heto1:HETO_1000001 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000016"/>
        <heto1:HETO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4100101"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4200101"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4200102"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4200103"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4200104"/>
        <obo:IAO_0000115 xml:lang="en">A task specification for comparing the costs and health outcomes of two or more options for a stated decision problem by means of an economic model, so that a decision maker can judge which option offers better value.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">Conduct a model-based economic evaluation</rdfs:label>
        <heto1:HETO_3000002 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000027"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000022"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000025"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000035"/>
        <heto1:HETO_3000004 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000310"/>
        <heto1:HETO_3000004 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000032"/>
        <heto1:HETO_3000005 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000031"/>
        <heto1:HETO_3000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000040"/>
        <heto1:HETO_3000007 xml:lang="en">The decision question, the options to be compared, and the clinical, cost and outcome evidence available.</heto1:HETO_3000007>
        <heto1:HETO_3000008 xml:lang="en">The results of the evaluation with their uncertainty, and a report of its methods and results.</heto1:HETO_3000008>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_4000002 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_4000002">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000010"/>
        <heto1:HETO_1000001 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000003"/>
        <heto1:HETO_1000001 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000004"/>
        <heto1:HETO_1000003 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000005"/>
        <heto1:HETO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4100201"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4200201"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4200202"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4200203"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4200204"/>
        <obo:IAO_0000115 xml:lang="en">A task specification for stating the decision an economic evaluation is to inform, including the population, the options compared, the outcomes, the perspective and the time horizon, before any analysis begins.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">Define the decision problem</rdfs:label>
        <heto1:HETO_3000003 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000310"/>
        <heto1:HETO_3000004 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000004"/>
        <heto1:HETO_3000004 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000025"/>
        <heto1:HETO_3000004 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000026"/>
        <heto1:HETO_3000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000040"/>
        <heto1:HETO_3000007 xml:lang="en">The policy or clinical question, the technologies of interest and any scope issued by the decision maker.</heto1:HETO_3000007>
        <heto1:HETO_3000008 xml:lang="en">A decision problem specification.</heto1:HETO_3000008>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_4000003 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_4000003">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000010"/>
        <heto1:HETO_1000003 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000007"/>
        <heto1:HETO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4100301"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4200301"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4200302"/>
        <obo:IAO_0000115 xml:lang="en">A task specification for stating whose costs and health outcomes an economic evaluation counts, such as those falling on the health system or on society as a whole, so that resources and outcomes are included consistently.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">Define the evaluation perspective</rdfs:label>
        <heto1:HETO_3000002 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000123"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000025"/>
        <heto1:HETO_3000004 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000072"/>
        <heto1:HETO_3000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000040"/>
        <heto1:HETO_3000007 xml:lang="en">The decision problem and any methods guidance from the decision maker.</heto1:HETO_3000007>
        <heto1:HETO_3000008 xml:lang="en">A perspective specification.</heto1:HETO_3000008>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_4000004 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_4000004">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000010"/>
        <heto1:HETO_1000003 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000006"/>
        <heto1:HETO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4100401"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4200401"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4200402"/>
        <obo:IAO_0000115 xml:lang="en">A task specification for choosing the period over which an economic evaluation counts costs and health outcomes, long enough to capture the differences between the options compared.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">Set the time horizon</rdfs:label>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000025"/>
        <heto1:HETO_3000004 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000025"/>
        <heto1:HETO_3000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000040"/>
        <heto1:HETO_3000007 xml:lang="en">The decision problem and the evidence on how long the effects of the options last.</heto1:HETO_3000007>
        <heto1:HETO_3000008 xml:lang="en">The time horizon, recorded in the decision problem specification.</heto1:HETO_3000008>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_4000005 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_4000005">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000011"/>
        <heto1:HETO_1000001 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000006"/>
        <heto1:HETO_1000001 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000007"/>
        <heto1:HETO_1000001 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000008"/>
        <heto1:HETO_1000001 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000009"/>
        <heto1:HETO_1000001 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000010"/>
        <heto1:HETO_1000001 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000018"/>
        <heto1:HETO_1000001 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000020"/>
        <heto1:HETO_1000003 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000011"/>
        <heto1:HETO_1000003 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000012"/>
        <heto1:HETO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4100501"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4200501"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4200502"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4200503"/>
        <obo:IAO_0000115 xml:lang="en">A task specification for building an economic model that represents a stated decision problem and combines evidence and assumptions to estimate the costs and health outcomes of the options compared.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>Briggs, Claxton and Sculpher 2006</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">Develop an economic model</rdfs:label>
        <heto1:HETO_3000002 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000027"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000012"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000013"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000014"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000015"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000016"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000018"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000022"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000025"/>
        <heto1:HETO_3000004 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000020"/>
        <heto1:HETO_3000004 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000028"/>
        <heto1:HETO_3000004 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000029"/>
        <heto1:HETO_3000004 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000030"/>
        <heto1:HETO_3000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000041"/>
        <heto1:HETO_3000007 xml:lang="en">The decision problem specification and the estimates of clinical effects, resource use, unit costs, costs and utilities, with their sources.</heto1:HETO_3000007>
        <heto1:HETO_3000008 xml:lang="en">An economic model version ready to be run.</heto1:HETO_3000008>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_4000006 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_4000006">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000011"/>
        <heto1:HETO_1000003 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000007"/>
        <heto1:HETO_1000003 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000009"/>
        <heto1:HETO_1000003 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000010"/>
        <heto1:HETO_1000003 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000018"/>
        <heto1:HETO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4100601"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4200601"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4200602"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4200603"/>
        <obo:IAO_0000115 xml:lang="en">A task specification for deciding how an economic model will represent the decision problem, including the modelling technique, the health states or events, the pathways between them and the main assumptions, before the model is built.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>Roberts et al. 2012</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">Conceptualise the model structure</rdfs:label>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000022"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000025"/>
        <heto1:HETO_3000004 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000020"/>
        <heto1:HETO_3000004 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000034"/>
        <heto1:HETO_3000004 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000134"/>
        <heto1:HETO_3000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000041"/>
        <heto1:HETO_3000007 xml:lang="en">The decision problem specification, clinical evidence and expert advice on the disease and its care.</heto1:HETO_3000007>
        <heto1:HETO_3000008 xml:lang="en">A documented model structure with its states, allowed transitions and structural assumptions.</heto1:HETO_3000008>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_4000007 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_4000007">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000012"/>
        <heto1:HETO_1000003 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000008"/>
        <heto1:HETO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4100701"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4200701"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4200702"/>
        <obo:IAO_0000115 xml:lang="en">A task specification for identifying and measuring the quantities of resources, such as staff time, medicines and hospital stays, used with each option or in each modelled health state, in natural units.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">Estimate resource use</rdfs:label>
        <heto1:HETO_3000002 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000123"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000022"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000034"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000035"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000071"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000072"/>
        <heto1:HETO_3000004 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000015"/>
        <heto1:HETO_3000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000040"/>
        <heto1:HETO_3000007 xml:lang="en">The perspective, the model structure, and records or published sources of resource use.</heto1:HETO_3000007>
        <heto1:HETO_3000008 xml:lang="en">Resource use estimates in natural units.</heto1:HETO_3000008>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_4000008 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_4000008">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000012"/>
        <heto1:HETO_1000003 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000020"/>
        <heto1:HETO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4100801"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4200801"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4200802"/>
        <obo:IAO_0000115 xml:lang="en">A task specification for choosing the cost of one unit of each resource used in an economic evaluation, from sources that fit the perspective, the setting and the price year of the analysis.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">Select unit costs</rdfs:label>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000022"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000072"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000075"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000082"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000119"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000123"/>
        <heto1:HETO_3000004 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000014"/>
        <heto1:HETO_3000005 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000152"/>
        <heto1:HETO_3000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000040"/>
        <heto1:HETO_3000007 xml:lang="en">The list of resources counted, the perspective, and national or local cost sources.</heto1:HETO_3000007>
        <heto1:HETO_3000008 xml:lang="en">Unit cost estimates with their source, currency and price year.</heto1:HETO_3000008>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_4000009 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_4000009">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000013"/>
        <heto1:HETO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4100901"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4200901"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4200902"/>
        <obo:IAO_0000115 xml:lang="en">A task specification for choosing a health state utility value for each state of an economic model, from evidence obtained with a stated valuation method, so that quality-adjusted life years can be calculated.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">Assign utility values to model health states</rdfs:label>
        <heto1:HETO_3000002 rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000196"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000105"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000022"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000033"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000034"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000090"/>
        <heto1:HETO_3000004 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000012"/>
        <heto1:HETO_3000004 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000019"/>
        <heto1:HETO_3000004 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000030"/>
        <heto1:HETO_3000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000040"/>
        <heto1:HETO_3000007 xml:lang="en">The model health states and published or trial-based utility evidence.</heto1:HETO_3000007>
        <heto1:HETO_3000008 xml:lang="en">Utility estimates assigned to the model health states.</heto1:HETO_3000008>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_4000010 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_4000010">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000011"/>
        <heto1:HETO_1000003 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000012"/>
        <heto1:HETO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4101001"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4201001"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4201002"/>
        <obo:IAO_0000115 xml:lang="en">A task specification for incorporating discounting into an economic model so that future costs and health outcomes are expressed in present-value terms using specified discount rates.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>Baines D. Defining tasks in HETO. Brief to the curator, 15 October 2026; Drummond et al. 2015</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">Add discounting to an economic model</rdfs:label>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000028"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000074"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000092"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000093"/>
        <heto1:HETO_3000004 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000028"/>
        <heto1:HETO_3000004 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000074"/>
        <heto1:HETO_3000004 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000092"/>
        <heto1:HETO_3000005 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000091"/>
        <heto1:HETO_3000005 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000152"/>
        <heto1:HETO_3000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000041"/>
        <heto1:HETO_3000007 xml:lang="en">Modelled costs and outcomes over time, specified rates and applicable guidance.</heto1:HETO_3000007>
        <heto1:HETO_3000008 xml:lang="en">The model incorporating discounted costs and outcomes.</heto1:HETO_3000008>
        <heto1:HETO_3000009 rdf:resource="https://www.nice.org.uk/process/pmg36/chapter/economic-evaluation"/>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_4000011 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_4000011">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000015"/>
        <heto1:HETO_1000003 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000012"/>
        <heto1:HETO_1000003 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000016"/>
        <heto1:HETO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4101101"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4201101"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4201102"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4201103"/>
        <obo:IAO_0000115 xml:lang="en">A task specification for checking that an economic model is free of technical errors, represents the decision problem credibly and gives results that are plausible against other evidence, so that it is fit for its decision purpose. The checks are repeated through the project, from the conceptual model to the final results.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>Eddy et al. 2012; Vemer et al. 2016</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">Validate an economic model</rdfs:label>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000022"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000028"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000032"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000035"/>
        <heto1:HETO_3000004 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000310"/>
        <heto1:HETO_3000005 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000031"/>
        <heto1:HETO_3000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000041"/>
        <heto1:HETO_3000007 xml:lang="en">The economic model version, its documentation and independent data where available.</heto1:HETO_3000007>
        <heto1:HETO_3000008 xml:lang="en">A record of the validation checks performed and their findings.</heto1:HETO_3000008>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_4000012 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_4000012">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000016"/>
        <heto1:HETO_1000003 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000013"/>
        <heto1:HETO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4101201"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4201201"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4201202"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4201203"/>
        <obo:IAO_0000115 xml:lang="en">A task specification for comparing the expected costs and health outcomes of the options in an economic evaluation, ruling out dominated and extendedly dominated options and calculating incremental cost-effectiveness ratios or net benefit for the rest.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">Calculate incremental cost-effectiveness results</rdfs:label>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000028"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000032"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000117"/>
        <heto1:HETO_3000004 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000032"/>
        <heto1:HETO_3000005 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000031"/>
        <heto1:HETO_3000005 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000153"/>
        <heto1:HETO_3000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000041"/>
        <heto1:HETO_3000007 xml:lang="en">An economic model version or its probabilistic results and, where used, the decision maker&apos;s cost-effectiveness threshold.</heto1:HETO_3000007>
        <heto1:HETO_3000008 xml:lang="en">Incremental results, such as ICERs or net monetary benefit.</heto1:HETO_3000008>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_4000013 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_4000013">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000014"/>
        <heto1:HETO_1000001 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000014"/>
        <heto1:HETO_1000001 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000015"/>
        <heto1:HETO_1000001 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000019"/>
        <heto1:HETO_1000003 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000016"/>
        <heto1:HETO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4101301"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4201301"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4201302"/>
        <obo:IAO_0000115 xml:lang="en">A task specification for testing whether the results and the decision of an economic evaluation change when uncertain inputs, assumptions or structural choices are varied.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>Briggs, Claxton and Sculpher 2006</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">Conduct sensitivity analysis</rdfs:label>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000019"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000028"/>
        <heto1:HETO_3000004 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000032"/>
        <heto1:HETO_3000005 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000031"/>
        <heto1:HETO_3000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000041"/>
        <heto1:HETO_3000007 xml:lang="en">The economic model version, its base-case results and descriptions of the uncertainty in its inputs.</heto1:HETO_3000007>
        <heto1:HETO_3000008 xml:lang="en">Sensitivity analysis results.</heto1:HETO_3000008>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_4000014 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_4000014">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000014"/>
        <heto1:HETO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4101401"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4201401"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4201402"/>
        <obo:IAO_0000115 xml:lang="en">A task specification for re-running an economic model with chosen inputs set to alternative fixed values, one or a few at a time, to see which inputs drive the results.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000118 xml:lang="en">Run a DSA</obo:IAO_0000118>
        <obo:IAO_0000119>Briggs, Claxton and Sculpher 2006</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">Run a deterministic sensitivity analysis</rdfs:label>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000019"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000028"/>
        <heto1:HETO_3000004 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000032"/>
        <heto1:HETO_3000005 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000031"/>
        <heto1:HETO_3000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000041"/>
        <heto1:HETO_3000007 xml:lang="en">The economic model version and plausible ranges for its inputs.</heto1:HETO_3000007>
        <heto1:HETO_3000008 xml:lang="en">Deterministic sensitivity analysis results, such as a table or a tornado diagram.</heto1:HETO_3000008>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_4000015 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_4000015">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000014"/>
        <heto1:HETO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4101501"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4201501"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4201502"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4201503"/>
        <obo:IAO_0000115 xml:lang="en">A task specification for running an economic model many times with all uncertain inputs drawn jointly from probability distributions, to estimate expected costs and outcomes and the probability that each option is cost-effective across a range of threshold values.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000118 xml:lang="en">Run a PSA</obo:IAO_0000118>
        <obo:IAO_0000119>Briggs, Claxton and Sculpher 2006</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">Run a probabilistic sensitivity analysis</rdfs:label>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000019"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000028"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000141"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000142"/>
        <heto1:HETO_3000004 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000032"/>
        <heto1:HETO_3000004 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000143"/>
        <heto1:HETO_3000005 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000031"/>
        <heto1:HETO_3000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000041"/>
        <heto1:HETO_3000007 xml:lang="en">The economic model version and the evidence on the uncertainty of each parameter.</heto1:HETO_3000007>
        <heto1:HETO_3000008 xml:lang="en">The set of simulated results and their summaries.</heto1:HETO_3000008>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_4000016 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_4000016">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000017"/>
        <heto1:HETO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4101601"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4201601"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4201602"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4201603"/>
        <obo:IAO_0000115 xml:lang="en">A task specification for writing a full and transparent account of the methods, inputs, results and uncertainty of an economic evaluation, so that readers and decision makers can judge and reproduce it.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>Husereau et al. 2022</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">Report an economic evaluation</rdfs:label>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000025"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000028"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000030"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000032"/>
        <heto1:HETO_3000004 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000310"/>
        <heto1:HETO_3000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000040"/>
        <heto1:HETO_3000007 xml:lang="en">The decision problem specification, the model version with its documentation and parameter assignments, and all results.</heto1:HETO_3000007>
        <heto1:HETO_3000008 xml:lang="en">A report of the economic evaluation.</heto1:HETO_3000008>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_4000017 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_4000017">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000017"/>
        <heto1:HETO_1000001 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000001"/>
        <heto1:HETO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4101701"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4201701"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4201702"/>
        <obo:IAO_0000115 xml:lang="en">A task specification for assembling the economic evidence for a technology, including the economic evaluation, its model and supporting documents, in the form set by the health technology assessment body that will appraise it.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Definition is HealthEconomics.wiki editorial wording, for Darrin Baines to confirm. The evaluation it contains can also be part of other undertakings, such as an assessment group&apos;s own evaluation or a publication.</obo:IAO_0000116>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>HealthEconomics.wiki editorial (HETO 0.1.0)</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">Prepare the economic evidence for a health technology assessment submission</rdfs:label>
        <heto1:HETO_3000002 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000062"/>
        <heto1:HETO_3000002 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000083"/>
        <heto1:HETO_3000003 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000310"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000028"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000032"/>
        <heto1:HETO_3000004 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000310"/>
        <heto1:HETO_3000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000040"/>
        <heto1:HETO_3000007 xml:lang="en">The economic evaluation, its model, and the methods guidance and templates of the assessment body.</heto1:HETO_3000007>
        <heto1:HETO_3000008 xml:lang="en">The economic sections of a submission dossier and the accompanying model.</heto1:HETO_3000008>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_4000018 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_4000018">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000011"/>
        <heto1:HETO_1000003 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000012"/>
        <heto1:HETO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4101801"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4201801"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4201802"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4201803"/>
        <obo:IAO_0000115 xml:lang="en">A task specification for estimating, from clinical evidence, the probabilities of moving between the states of an economic model and the effects of each option on them, including any extrapolation beyond the observed follow-up, as inputs to the model.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>Briggs, Claxton and Sculpher 2006</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">Estimate transition probabilities and treatment effects</rdfs:label>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000022"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000035"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000134"/>
        <heto1:HETO_3000004 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000016"/>
        <heto1:HETO_3000004 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000017"/>
        <heto1:HETO_3000004 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000018"/>
        <heto1:HETO_3000004 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000019"/>
        <heto1:HETO_3000004 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000030"/>
        <heto1:HETO_3000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000041"/>
        <heto1:HETO_3000007 xml:lang="en">The model structure, trial reports, published studies and patient-level or survival data.</heto1:HETO_3000007>
        <heto1:HETO_3000008 xml:lang="en">Transition probability and treatment effect estimates assigned to the model parameters, with their uncertainty.</heto1:HETO_3000008>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_4000019 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_4000019">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000014"/>
        <heto1:HETO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4101901"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4201901"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4201902"/>
        <obo:IAO_0000115 xml:lang="en">A task specification for re-running an economic model under alternative assumptions or structural choices, such as another survival extrapolation or another source of evidence, to see whether the results or the decision change.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>Briggs, Claxton and Sculpher 2006</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">Run scenario analyses</rdfs:label>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000020"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000028"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000030"/>
        <heto1:HETO_3000004 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000032"/>
        <heto1:HETO_3000005 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000031"/>
        <heto1:HETO_3000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000041"/>
        <heto1:HETO_3000007 xml:lang="en">The economic model version and the alternative assumptions or structures to test.</heto1:HETO_3000007>
        <heto1:HETO_3000008 xml:lang="en">Scenario analysis results.</heto1:HETO_3000008>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_4000020 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_4000020">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000012"/>
        <heto1:HETO_1000003 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4000012"/>
        <heto1:HETO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4102001"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4202001"/>
        <heto1:HETO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4202002"/>
        <obo:IAO_0000115 xml:lang="en">A task specification for multiplying the quantity of each resource used by its unit cost, and adding the results, to give the cost of each option or of each modelled health state from the stated perspective.</obo:IAO_0000115>
        <obo:IAO_0000117>Michelle Ashley (drafted with Claude)</obo:IAO_0000117>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">Value resource use</rdfs:label>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000014"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000015"/>
        <heto1:HETO_3000003 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000072"/>
        <heto1:HETO_3000004 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000013"/>
        <heto1:HETO_3000005 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000150"/>
        <heto1:HETO_3000005 rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000151"/>
        <heto1:HETO_3000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_0000040"/>
        <heto1:HETO_3000007 xml:lang="en">Resource use estimates, unit cost estimates and the perspective.</heto1:HETO_3000007>
        <heto1:HETO_3000008 xml:lang="en">Cost estimates for each option or modelled health state, in a stated currency and price year.</heto1:HETO_3000008>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_4100101 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_4100101">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/IAO_0000005"/>
        <obo:IAO_0000115 xml:lang="en">An objective specification that states the intended result of the task specification Conduct a model-based economic evaluation, which is to estimate and compare the expected costs and health outcomes of the options in the decision problem, with the uncertainty around them.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial (HETO 0.3.0), from the catalogue entry of its task</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">Estimate and compare the expected costs and health outcomes of the options in the decision problem, with the uncertainty around them</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_4100201 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_4100201">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/IAO_0000005"/>
        <obo:IAO_0000115 xml:lang="en">An objective specification that states the intended result of the task specification Define the decision problem, which is to agree a written statement of the decision problem that the evaluation and any model will address.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial (HETO 0.3.0), from the catalogue entry of its task</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">Agree a written statement of the decision problem that the evaluation and any model will address</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_4100301 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_4100301">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/IAO_0000005"/>
        <obo:IAO_0000115 xml:lang="en">An objective specification that states the intended result of the task specification Define the evaluation perspective, which is to state the perspective of the evaluation and the kinds of cost and outcome it includes.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial (HETO 0.3.0), from the catalogue entry of its task</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">State the perspective of the evaluation and the kinds of cost and outcome it includes</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_4100401 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_4100401">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/IAO_0000005"/>
        <obo:IAO_0000115 xml:lang="en">An objective specification that states the intended result of the task specification Set the time horizon, which is to state a time horizon that captures all relevant differences in costs and outcomes between the options.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial (HETO 0.3.0), from the catalogue entry of its task</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">State a time horizon that captures all relevant differences in costs and outcomes between the options</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_4100501 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_4100501">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/IAO_0000005"/>
        <obo:IAO_0000115 xml:lang="en">An objective specification that states the intended result of the task specification Develop an economic model, which is to produce an economic model version, with its structure and parameters, that can be run to estimate costs and outcomes for each option.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial (HETO 0.3.0), from the catalogue entry of its task</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">Produce an economic model version, with its structure and parameters, that can be run to estimate costs and outcomes for each option</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_4100601 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_4100601">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/IAO_0000005"/>
        <obo:IAO_0000115 xml:lang="en">An objective specification that states the intended result of the task specification Conceptualise the model structure, which is to agree a model structure that represents the disease process and the decision problem well enough to inform the decision.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial (HETO 0.3.0), from the catalogue entry of its task</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">Agree a model structure that represents the disease process and the decision problem well enough to inform the decision</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_4100701 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_4100701">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/IAO_0000005"/>
        <obo:IAO_0000115 xml:lang="en">An objective specification that states the intended result of the task specification Estimate resource use, which is to obtain an estimate of the quantity of each relevant resource used, per person or per event, for each option or state.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial (HETO 0.3.0), from the catalogue entry of its task</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">Obtain an estimate of the quantity of each relevant resource used, per person or per event, for each option or state</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_4100801 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_4100801">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/IAO_0000005"/>
        <obo:IAO_0000115 xml:lang="en">An objective specification that states the intended result of the task specification Select unit costs, which is to attach a unit cost, with its source, currency and price year, to each kind of resource counted.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial (HETO 0.3.0), from the catalogue entry of its task</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">Attach a unit cost, with its source, currency and price year, to each kind of resource counted</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_4100901 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_4100901">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/IAO_0000005"/>
        <obo:IAO_0000115 xml:lang="en">An objective specification that states the intended result of the task specification Assign utility values to model health states, which is to give each model health state a utility value, with its source and uncertainty, on a scale on which full health is 1 and dead is 0, with values below 0 for states worse than dead.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial (HETO 0.3.0), from the catalogue entry of its task</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">Give each model health state a utility value, with its source and uncertainty, on a scale on which full health is 1 and dead is 0, with values below 0 for states worse than dead</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_4101001 -->

