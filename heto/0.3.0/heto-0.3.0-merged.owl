    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_4201902 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_4201902">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/IAO_0000007"/>
        <obo:IAO_0000115 xml:lang="en">An action specification that is a main step of the task specification Run scenario analyses, directing the practitioner to re-run the model under each scenario and compare the results with the base case.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial (HETO 0.3.0), from the catalogue entry of its task</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">Re-run the model under each scenario and compare the results with the base case</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_4202001 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_4202001">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/IAO_0000007"/>
        <obo:IAO_0000115 xml:lang="en">An action specification that is a main step of the task specification Value resource use, directing the practitioner to multiply each resource use estimate by the unit cost of that resource.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial (HETO 0.3.0), from the catalogue entry of its task</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">Multiply each resource use estimate by the unit cost of that resource</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heto/HETO_4202002 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heto/HETO_4202002">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/IAO_0000007"/>
        <obo:IAO_0000115 xml:lang="en">An action specification that is a main step of the task specification Value resource use, directing the practitioner to add the costs for each option or health state.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial (HETO 0.3.0), from the catalogue entry of its task</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:label xml:lang="en">Add the costs for each option or health state</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000386 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000386">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000385"/>
        <obo:IAO_0000115 xml:lang="en">An instrument classification value for an instrument designed for use across conditions and populations.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">generic design</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000387 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000387">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000385"/>
        <obo:IAO_0000115 xml:lang="en">An instrument classification value for an instrument designed for people with a particular condition or treatment.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">condition-specific design</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000388 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000388">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000385"/>
        <obo:IAO_0000115 xml:lang="en">An instrument classification value for an instrument that reports separate scores for several aspects of health rather than one index.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">health profile scoring</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000390 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000390">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000327"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000115 xml:lang="en">A reference case profile setting the methods NICE requires for measuring, valuing and discounting health effects, as set by its 2022 manual (PMG36) and amended by the interim methods statement of 27 August 2026 (PMG51), which adopts the EQ-5D-5L value set.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Checked against the full text of PMG51 (read on 18 October 2026). PMG51 makes the EQ-5D-5L descriptive system with the UK EQ-5D-5L value set (Rowen et al. 2026) NICE&apos;s preferred approach in adults, and that value set should derive all adult utility values in reference-case analyses (1.6, 1.7, Appendix A 4.3.6). It applies to TA, HST and HealthTech evaluations and to guidelines (PMG20).</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">EQ-5D-3L value set utilities must not be used in sensitivity or scenario analyses (1.13). Non-UK EQ-5D-5L value sets are never preferred over mapping to the UK value set (FAQ 17). NICE recommends no specific measure for children and young people, so these value set rules do not apply to EQ-5D-Y data (1.7, FAQ 19).</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">PMG51 applies prospectively, to topics whose invitation to participate (TA, HST), launch (HealthTech) or selection (guidelines) came after 27 August 2026. Topics started before keep the PMG36 approach (1.17, 1.18, FAQ 16). The rules therefore key on the analysis&apos;s topic start date (OHEO_2000035).</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">The 5L value set is also used for general population utilities and the QALY shortfall behind the severity modifier, whose cut-offs are unchanged from PMG36 table 6.1 (1.12, FAQ 21). The discount rate of 3.5% and the use of QALYs are those of PMG36. Costs and NICE&apos;s cost-effectiveness threshold are RHEO matters and are not checked here.</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">When only EQ-5D-3L data exist, they are mapped to EQ-5D-5L utilities with the NICE DSU response mapping model on the EEPRU dataset (Hernández Alava, Pudney and Wailoo 2023), with the Rowen 2026 value set applied as a separate step. Using mapped 3L data, 5L literature values or non-EQ-5D measures mapped to the 5L value set is a departure from the reference case (1.10, 1.11, Appendix A 4.3.8 to 4.3.10).</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000118 xml:lang="en">NICE reference case for health effects (2026)</obo:IAO_0000118>
        <obo:IAO_0000119>NICE 2026 (PMG51, Interim methods statement: implementing the EQ-5D-5L value set, 27 August 2026); NICE 2022 (PMG36)</obo:IAO_0000119>
        <dcterms:issued>2026-08-27</dcterms:issued>
        <oboInOwl:hasExactSynonym xml:lang="en">NICE PMG51 reference case</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">NICE reference case</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">NICE reference case for health effects (PMG36 as amended by PMG51, 2026)</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/ontologies/oheo/reference-case-shapes#NICE_PMG51_2026"/>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000391 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000391">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000327"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000115 xml:lang="en">A reference case profile setting the methods NICE required for measuring, valuing and discounting health effects in its 2022 manual (PMG36), before the adoption of the EQ-5D-5L value set.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Superseded for new topics by PMG51 (27 August 2026). Topics started before that date keep these rules, so the profile stays valid for them (PMG51 1.17, 1.18).</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">Under PMG36, utilities came from the EQ-5D-3L UK value set (Dolan 1997); EQ-5D-5L responses were mapped to it with the NICE DSU mapping (Hernández Alava et al. 2017) using the EEPRU dataset (Hernández Alava et al. 2023), and the EQ-5D-5L value set for England (Devlin et al. 2018) was not recommended (old PMG36 4.3.16, as quoted in PMG51). The value set rules do not apply to EQ-5D-Y data.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000118 xml:lang="en">NICE reference case for health effects (2022)</obo:IAO_0000118>
        <obo:IAO_0000119>NICE 2022 (PMG36)</obo:IAO_0000119>
        <dcterms:issued>2022-01-31</dcterms:issued>
        <oboInOwl:hasExactSynonym xml:lang="en">NICE PMG36 reference case</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">NICE reference case for health effects (PMG36, 2022)</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/ontologies/oheo/reference-case-shapes#NICE_PMG36_2022"/>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000392 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000392">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000327"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">A reference case profile setting the methods the Second Panel on Cost-Effectiveness in Health and Medicine recommends for cost-effectiveness analyses in the United States.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Facts carried over from 0.1.0 and not re-checked for this release.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Sanders et al. 2016</obo:IAO_0000119>
        <dcterms:issued>2016</dcterms:issued>
        <oboInOwl:hasExactSynonym xml:lang="en">Second Panel reference case</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">Second Panel reference case for health effects</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/ontologies/oheo/reference-case-shapes#SecondPanel_2016"/>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000393 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000393">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000327"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">A reference case profile setting the methods Canada&apos;s Drug Agency (CDA-AMC, formerly CADTH) requires for measuring, valuing and discounting health effects in economic evaluations.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Carer health effects are included where they are meaningful; spillovers beyond patients and informal carers go in non-reference-case analyses. Sensitivity analyses at 0% and 3%.</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">Facts carried over from 0.1.0 and not re-checked for this release.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>CADTH 2017 (Guidelines for the Economic Evaluation of Health Technologies: Canada, 4th edition)</obo:IAO_0000119>
        <dcterms:issued>2017</dcterms:issued>
        <oboInOwl:hasRelatedSynonym xml:lang="en">CADTH reference case</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">CDA-AMC reference case for health effects</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/ontologies/oheo/reference-case-shapes#CDA_AMC_2017"/>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000394 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000394">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000327"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">A reference case profile setting the methods the Pharmaceutical Benefits Advisory Committee (Australia) requires for measuring, valuing and discounting health effects in submissions.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Facts carried over from 0.1.0 and not re-checked for this release.</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">QALYs apply where a cost-utility analysis is presented, which PBAC prefers when life is extended or quality of life improves. Sensitivity analyses at 3.5% and 0%; PBAC consulted on its discount rate in 2022.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>PBAC 2016 (Guidelines for preparing submissions to the PBAC, version 5.0); PBAC reviewed its base discount rate in July 2022, so the current rate needs checking</obo:IAO_0000119>
        <dcterms:issued>2016</dcterms:issued>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">PBAC base case for health effects</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/ontologies/oheo/reference-case-shapes#PBAC_2016"/>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000395 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000395">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000327"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">A reference case profile setting the methods the Institute for Quality and Efficiency in Health Care (Germany) uses for health effects in its assessments of the relation of benefits to costs.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Facts carried over from 0.1.0 and not re-checked for this release.</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">The base case perspective is that of the community of people insured by statutory health insurance. Sensitivity analyses at 0%, 5%, 7% and 10%.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>IQWiG General Methods (the 0.1.0 draft cited version 6.1, 2022; version 7.0, 2023, is current and has not been checked)</obo:IAO_0000119>
        <dcterms:issued>2022</dcterms:issued>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">IQWiG approach to health effects in economic evaluation</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/ontologies/oheo/reference-case-shapes#IQWiG_2022"/>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000396 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000396">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000327"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000115 xml:lang="en">A reference case profile setting the methods the Institute for Clinical and Economic Review (United States) uses for measuring, valuing and discounting health effects.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Checked by reviewer B on 16 October 2026 against ICER&apos;s reference case document: 3% for costs and outcomes; EQ-5D-5L preferred if available, with no measure required. QALYs are reported with the equal value of life-years gained.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>ICER&apos;s Reference Case for Economic Evaluations: Elements and Rationale (current as of 23 October 2025)</obo:IAO_0000119>
        <dcterms:issued>2025</dcterms:issued>
        <oboInOwl:hasExactSynonym xml:lang="en">ICER reference case</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">ICER reference case for health effects</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/ontologies/oheo/reference-case-shapes#ICER_2025"/>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000397 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000397">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000327"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">A reference case profile setting the methods the Haute Autorité de Santé (France) requires for measuring, valuing and discounting health effects.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">At publication the French value set was Andrade et al. 2020, applied from age 16. A cost-utility analysis is accompanied by a cost-effectiveness analysis in life-years.</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">Facts carried over from 0.1.0 and not re-checked for this release.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HAS 2020 (Choix méthodologiques pour l&apos;évaluation économique à la HAS); the guide page shows an update of 8 July 2026 that has not been checked</obo:IAO_0000119>
        <dcterms:issued>2020</dcterms:issued>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">HAS reference case for health effects</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/ontologies/oheo/reference-case-shapes#HAS_2020"/>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000398 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000398">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000327"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">A reference case profile setting the methods the National Health Care Institute (Zorginstituut Nederland) requires for measuring, valuing and discounting health effects.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Facts carried over from 0.1.0 and not re-checked for this release.</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">The societal perspective includes unrelated medical costs in life-years gained.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>ZIN 2024 (Richtlijn voor het uitvoeren van economische evaluaties in de gezondheidszorg, versie 2024)</obo:IAO_0000119>
        <dcterms:issued>2024</dcterms:issued>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">ZIN reference case for health effects</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/ontologies/oheo/reference-case-shapes#ZIN_2024"/>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000399 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000399">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000327"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">A reference case profile setting the methods the Dental and Pharmaceutical Benefits Agency (Sweden) requires for measuring, valuing and discounting health effects.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Facts carried over from 0.1.0 and not re-checked for this release.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>TLV 2017</obo:IAO_0000119>
        <dcterms:issued>2017</dcterms:issued>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">TLV reference case for health effects</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/ontologies/oheo/reference-case-shapes#TLV_2017"/>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000401 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000401">
