rc:HAS_2020_advice a sh:NodeShape ;
    rdfs:label "Advice and unchecked rules of the HAS reference case for health effects"@en ;
    dcterms:source "HAS 2020 (Choix méthodologiques pour l'évaluation économique à la HAS); the guide page shows an update of 8 July 2026 that has not been checked" ;
    rdfs:isDefinedBy oheo:0000397 ;
    sh:severity sh:Warning ;
    sh:targetSubjectsOf oheo:1000036 ;
    sh:sparql [
        sh:message "HAS reference case for health effects: health effects are expressed in QALYs, and the analysis reports no QALY record." ;
        sh:select """
            PREFIX oheo: <https://healtheconomics.wiki/ontologies/oheo/OHEO_>
            PREFIX rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_>
            PREFIX obo:  <http://purl.obolibrary.org/obo/>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            SELECT $this WHERE { { $this oheo:1000036 oheo:0000397 . } FILTER NOT EXISTS { $this obo:OBI_0000299 ?q . ?q a rheo:0000092 } }""" ] ;
    sh:sparql [
        sh:message "HAS reference case for health effects: discounted QALYs use an annual rate of 2.5% for the first 30 years, then 1.5% (as recorded in 0.1.0; not rechecked) for health effects; {?q} uses {?value}." ;
        sh:select """
            PREFIX oheo: <https://healtheconomics.wiki/ontologies/oheo/OHEO_>
            PREFIX rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_>
            PREFIX obo:  <http://purl.obolibrary.org/obo/>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            SELECT $this ?q ?value WHERE { { $this oheo:1000036 oheo:0000397 . } { $this obo:OBI_0000299 ?q . } { ?q a rheo:0000092 ; rheo:2000062 true ; rheo:2000031 ?value . } FILTER (ABS(?value - 0.025) > 0.0000001 && ABS(?value - 0.015) > 0.0000001) }""" ] ;
    sh:sparql [
        sh:message "HAS reference case for health effects: adult EQ-5D utilities in the reference case use the EQ-5D-5L France value set (Andrade 2020); {?u} uses {?value}." ;
        sh:select """
            PREFIX oheo: <https://healtheconomics.wiki/ontologies/oheo/OHEO_>
            PREFIX rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_>
            PREFIX obo:  <http://purl.obolibrary.org/obo/>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            SELECT $this ?u ?value WHERE { { $this oheo:1000036 oheo:0000397 . } { $this obo:OBI_0000293 ?u . } { ?u oheo:1000013 ?v . } { ?u oheo:1000014 ?value . } FILTER EXISTS { ?v a/rdfs:subClassOf* oheo:0000122 } FILTER NOT EXISTS { ?v a/rdfs:subClassOf* ?y . FILTER (?y IN (oheo:0000125, oheo:0000324)) } FILTER NOT EXISTS { ?value a/rdfs:subClassOf* ?ok . FILTER (?ok IN (oheo:0000300)) } }""" ] ;
    sh:sparql [
        sh:message "HAS reference case for health effects: the preferred instrument in adults is the EQ-5D-5L; {?u} comes from another instrument, which needs evidence that the preferred one is not appropriate (content validity, construct validity, responsiveness)." ;
        sh:select """
            PREFIX oheo: <https://healtheconomics.wiki/ontologies/oheo/OHEO_>
            PREFIX rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_>
            PREFIX obo:  <http://purl.obolibrary.org/obo/>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            SELECT $this ?u WHERE { { $this oheo:1000036 oheo:0000397 . } { $this obo:OBI_0000293 ?u . } { ?u oheo:1000013 ?v . } FILTER NOT EXISTS { ?v a/rdfs:subClassOf* oheo:0000124 } FILTER NOT EXISTS { ?u oheo:1000038 ?f } FILTER NOT EXISTS { ?v a/rdfs:subClassOf* ?y . FILTER (?y IN (oheo:0000125, oheo:0000324)) } }""" ] .

