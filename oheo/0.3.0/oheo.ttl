    oheo:9000001 20 .

oheo:0000028 a owl:Class ;
    rdfs:label "skin and subcutaneous tissue outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the physiological or clinical outcome area, covering outcomes associated with the skin and subcutaneous tissue system or condition group, such as lesion clearance or wound healing."@en ;
    obo:IAO_0000116 "Physiological domains follow MedDRA System Organ Classes, as in the COMET taxonomy."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
