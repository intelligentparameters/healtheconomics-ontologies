oheo:9000002 a owl:AnnotationProperty ;
    rdfs:label "names a published artefact"@en ;
    obo:IAO_0000115 "True for a class that stands for one named, published artefact, such as the EQ-5D-5L, the EQ-5D-3L UK value set (Dolan 1997) or RECIST 1.1, whose instances are its versions or releases, rather than for a general kind such as patient-reported outcome measure. The record rules use it to check that a record names the instrument version and value set it used."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> .

obo:BFO_0000051 a owl:ObjectProperty ;
    rdfs:label "has part"@en ;
    obo:IAO_0000115 "a core relation that holds between a whole and its part"@en ;
    obo:IAO_0000119 "RO (http://purl.obolibrary.org/obo/ro.owl)" ;
    obo:IAO_0000412 obo:ro.owl .

obo:OAE_0000001 a owl:Class ;
    rdfs:label "adverse event"@en ;
    obo:IAO_0000115 "a pathological bodily process that occurs after a medical intervention. An adverse event is likely caused by the medical intervention; however, such a causal association is not required to be an adverse event."@en ;
    obo:IAO_0000119 "OAE (http://purl.obolibrary.org/obo/oae.owl)" ;
    obo:IAO_0000412 obo:oae.owl ;
    rdfs:isDefinedBy obo:oae.owl ;
    rdfs:subClassOf obo:OGMS_0000061 .

obo:OBI_0001930 a owl:Class ;
    rdfs:label "categorical value specification"@en ;
    obo:IAO_0000115 "A value specification that is specifies one category out of a fixed number of nominal categories"@en ;
    obo:IAO_0000119 "OBI (http://purl.obolibrary.org/obo/obi.owl)" ;
    obo:IAO_0000412 obo:obi.owl ;
    rdfs:isDefinedBy obo:obi.owl ;
    rdfs:subClassOf obo:OBI_0001933 .

obo:OBI_0001933 a owl:Class ;
    rdfs:label "value specification"@en ;
    obo:IAO_0000115 "An information content entity that specifies a value within a classification scheme or on a quantitative scale."@en ;
    obo:IAO_0000119 "OBI (http://purl.obolibrary.org/obo/obi.owl)" ;
    obo:IAO_0000412 obo:obi.owl ;
    rdfs:isDefinedBy obo:obi.owl ;
    rdfs:subClassOf obo:IAO_0000030 .

obo:OBI_0500000 a owl:Class ;
    rdfs:label "study design"@en ;
    obo:IAO_0000115 "A plan specification comprised of protocols (which may specify how and what kinds of data will be gathered) that are executed as part of an investigation and is realized during a study design execution."@en ;
    obo:IAO_0000119 "OBI (http://purl.obolibrary.org/obo/obi.owl)" ;
    obo:IAO_0000412 obo:obi.owl ;
    rdfs:isDefinedBy obo:obi.owl ;
    rdfs:subClassOf obo:IAO_0000104 .

obo:OGMS_0000060 a owl:Class ;
    rdfs:label "bodily process"@en ;
    obo:IAO_0000116 "OGMS (release 2021-08-19) gives this class no textual definition; none is supplied here."@en ;
    obo:IAO_0000119 "OGMS (http://purl.obolibrary.org/obo/ogms.owl)" ;
    obo:IAO_0000412 obo:ogms.owl ;
    rdfs:isDefinedBy obo:ogms.owl ;
    rdfs:subClassOf obo:BFO_0000015 .

obo:OGMS_0000061 a owl:Class ;
    rdfs:label "pathological bodily process"@en ;
    obo:IAO_0000115 "A bodily process that is clinically abnormal."@en ;
    obo:IAO_0000119 "OGMS (http://purl.obolibrary.org/obo/ogms.owl)" ;
    obo:IAO_0000412 obo:ogms.owl ;
    rdfs:isDefinedBy obo:ogms.owl ;
    rdfs:subClassOf obo:OGMS_0000060 .

obo:STATO_0000107 a owl:Class ;
    rdfs:label "statistical model"@en ;
    obo:IAO_0000115 "a statistical model is an information content entity which is a formalization of relationships between variables in the form of mathematical equations. A statistical model describes how one or more random variables are related to one or more other variables. The model is statistical as the variables are not deterministically but stochastically related."@en ;
    obo:IAO_0000116 "Also asserted under information content entity in STATO; only one parent is declared here. Consult STATO for its full axioms."@en ;
    obo:IAO_0000119 "STATO (http://purl.obolibrary.org/obo/stato.owl)" ;
    obo:IAO_0000412 obo:stato.owl ;
    rdfs:isDefinedBy obo:stato.owl ;
    rdfs:subClassOf obo:IAO_0000027 .

obo:STATO_0000573 a owl:Class ;
    rdfs:label "average value"@en ;
    obo:IAO_0000115 """The arithmetic mean is defined as the sum of the numerical values of each and every observation divided by the total number of observations. S The arithmetic mean A is defined by the formula

A=sum[Ai] / n where i ranges from 1 to n and Ai represents the value of individual observations.

The arithmetic mean is significantly affected by extreme values and outliers. A better measure of central tendency is the median (http://purl.obolibrary.org/obo/STATO_0000574)."""@en ;
    obo:IAO_0000119 "STATO (http://purl.obolibrary.org/obo/stato.owl)" ;
    obo:IAO_0000412 obo:stato.owl ;
    rdfs:isDefinedBy obo:stato.owl ;
    rdfs:subClassOf obo:STATO_0000029 .

obo:STATO_0000574 a owl:Class ;
    rdfs:label "center value"@en ;
    obo:IAO_0000115 "The median is that value of the variate which divides the total frequency into two halves. The median is measure of central tendency of data. It is obtained by arranging the observations in order from smallest to largest value. If there is an odd number of observations, the median is the middle value. If there is an even number of observations, the median is the average of the two middle values."@en ;
    obo:IAO_0000116 "Also asserted under quartile in STATO; only one parent is declared here. Consult STATO for its full axioms."@en ;
    obo:IAO_0000119 "STATO (http://purl.obolibrary.org/obo/stato.owl)" ;
    obo:IAO_0000412 obo:stato.owl ;
    rdfs:isDefinedBy obo:stato.owl ;
    rdfs:subClassOf obo:STATO_0000029 .

obo:STATO_0000613 a owl:Class ;
    rdfs:label "difference"@en ;
    obo:IAO_0000115 "A statistic that is a subtraction of one quantity from another."@en ;
    obo:IAO_0000119 "STATO (http://purl.obolibrary.org/obo/stato.owl)" ;
    obo:IAO_0000412 obo:stato.owl ;
    rdfs:isDefinedBy obo:stato.owl ;
    rdfs:subClassOf obo:STATO_0000039 .

obo:STATO_0000614 a owl:Class ;
    rdfs:label "absolute difference"@en ;
    obo:IAO_0000115 """A statistic that is a subtraction of one quantity from another, with no modification of the resulting value.

As a type of statistic, "Absolute Difference" is the actual difference between two quantities and can be positive or negative depending on the order of subtraction. The term "Absolute Difference" should not be confused with the mathematical term 'absolute value' which is a numerical value without a negative sign."""@en ;
    obo:IAO_0000119 "STATO (http://purl.obolibrary.org/obo/stato.owl)" ;
    obo:IAO_0000412 obo:stato.owl ;
    rdfs:isDefinedBy obo:stato.owl ;
    rdfs:subClassOf obo:STATO_0000613 .

obo:STATO_0000658 a owl:Class ;
    rdfs:label "mean time-to-event"@en ;
    obo:IAO_0000115 "A mean of values in which each value is the duration of time between the start of observation and the occurrence of an event."@en ;
    obo:IAO_0000119 "STATO (http://purl.obolibrary.org/obo/stato.owl)" ;
    obo:IAO_0000412 obo:stato.owl ;
    rdfs:isDefinedBy obo:stato.owl ;
    rdfs:subClassOf obo:STATO_0000573 .

oboInOwl:SynonymTypeProperty a owl:AnnotationProperty .

oboInOwl:hasBroadSynonym a owl:AnnotationProperty ;
    rdfs:label "has_broad_synonym"@en .

oheo:0000007 a owl:Class ;
    rdfs:label "blood and lymphatic system outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the physiological or clinical outcome area, covering outcomes associated with the blood and lymphatic system system or condition group, such as anaemia or neutropenia."@en ;
    obo:IAO_0000116 "Physiological domains follow MedDRA System Organ Classes, as in the COMET taxonomy."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    oboInOwl:hasExactSynonym "Blood and lymphatic system outcomes"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000003 ;
    oheo:9000001 2 .

oheo:0000009 a owl:Class ;
    rdfs:label "congenital, familial and genetic outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the physiological or clinical outcome area, covering outcomes associated with the congenital, familial and genetic system or condition group, such as congenital anomalies."@en ;
    obo:IAO_0000116 "Physiological domains follow MedDRA System Organ Classes, as in the COMET taxonomy."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    oboInOwl:hasExactSynonym "Congenital, familial and genetic outcomes"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000003 ;
    oheo:9000001 4 .

oheo:0000010 a owl:Class ;
    rdfs:label "endocrine outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the physiological or clinical outcome area, covering outcomes associated with the endocrine system or condition group, such as outcomes associated with endocrine disorders, such as thyroid function."@en ;
    obo:IAO_0000116 "Physiological domains follow MedDRA System Organ Classes, as in the COMET taxonomy."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    oboInOwl:hasExactSynonym "Endocrine outcomes"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000003 ;
    oheo:9000001 5 .

oheo:0000013 a owl:Class ;
    rdfs:label "gastrointestinal outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the physiological or clinical outcome area, covering outcomes associated with the gastrointestinal system or condition group, such as nausea, bleeding or bowel function."@en ;
    obo:IAO_0000116 "Physiological domains follow MedDRA System Organ Classes, as in the COMET taxonomy."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    oboInOwl:hasExactSynonym "Gastrointestinal outcomes"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000003 ;
    oheo:9000001 8 .

oheo:0000015 a owl:Class ;
    rdfs:label "hepatobiliary outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the physiological or clinical outcome area, covering outcomes associated with the hepatobiliary system or condition group, such as liver function or gallstone disease."@en ;
    obo:IAO_0000116 "Physiological domains follow MedDRA System Organ Classes, as in the COMET taxonomy."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    oboInOwl:hasExactSynonym "Hepatobiliary outcomes"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000003 ;
    oheo:9000001 10 .

oheo:0000016 a owl:Class ;
    rdfs:label "immune system outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the physiological or clinical outcome area, covering outcomes associated with the immune system system or condition group, such as allergic reactions or immune response."@en ;
    obo:IAO_0000116 "Physiological domains follow MedDRA System Organ Classes, as in the COMET taxonomy."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    oboInOwl:hasExactSynonym "Immune system outcomes"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000003 ;
    oheo:9000001 11 .

oheo:0000017 a owl:Class ;
    rdfs:label "infection and infestation outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the physiological or clinical outcome area, covering outcomes associated with the infection and infestation system or condition group, such as infection rates or clearance of infection."@en ;
    obo:IAO_0000116 "Physiological domains follow MedDRA System Organ Classes, as in the COMET taxonomy."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    oboInOwl:hasExactSynonym "Infection and infestation outcomes"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000003 ;
    oheo:9000001 12 .

oheo:0000018 a owl:Class ;
    rdfs:label "injury and poisoning outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the physiological or clinical outcome area, covering outcomes associated with the injury and poisoning system or condition group, such as fractures, falls injuries or poisoning."@en ;
    obo:IAO_0000116 "Physiological domains follow MedDRA System Organ Classes, as in the COMET taxonomy."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    oboInOwl:hasExactSynonym "Injury and poisoning outcomes"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000003 ;
    oheo:9000001 13 .

oheo:0000019 a owl:Class ;
    rdfs:label "metabolism and nutrition outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the physiological or clinical outcome area, covering outcomes associated with the metabolism and nutrition system or condition group, such as glycaemic control or nutritional status."@en ;
    obo:IAO_0000116 "Physiological domains follow MedDRA System Organ Classes, as in the COMET taxonomy."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    oboInOwl:hasExactSynonym "Metabolism and nutrition outcomes"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000003 ;
    oheo:9000001 14 .

oheo:0000024 a owl:Class ;
    rdfs:label "renal and urinary outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the physiological or clinical outcome area, covering outcomes associated with the renal and urinary system or condition group, such as kidney function or urinary continence."@en ;
    obo:IAO_0000116 "Physiological domains follow MedDRA System Organ Classes, as in the COMET taxonomy."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    oboInOwl:hasExactSynonym "Renal and urinary outcomes"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000003 ;
    oheo:9000001 19 .

oheo:0000029 a owl:Class ;
    rdfs:label "vascular outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the physiological or clinical outcome area, covering outcomes associated with the vascular system or condition group, such as blood pressure, thrombosis or peripheral arterial disease."@en ;
    obo:IAO_0000116 "Physiological domains follow MedDRA System Organ Classes, as in the COMET taxonomy."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    oboInOwl:hasExactSynonym "Vascular outcomes"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000003 ;
    oheo:9000001 24 .

oheo:0000037 a owl:Class ;
    rdfs:label "delivery of care outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the life impact outcome area, covering the appropriateness and acceptability of an intervention, including satisfaction and preference, adherence, withdrawal from treatment, and process, implementation and service outcomes."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    oboInOwl:hasExactSynonym "Delivery of care"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000004 ;
    oheo:9000001 32 .

oheo:0000040 a owl:Class ;
    rdfs:label "hospital outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the resource use outcome area, covering the use of hospital services, such as admissions, readmissions and length of stay."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    oboInOwl:hasRelatedSynonym "Hospital"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000005 ;
    oheo:9000001 35 .

oheo:0000041 a owl:Class ;
    rdfs:label "need for further intervention outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the resource use outcome area, covering the need for additional treatment, such as further surgery, rescue medication or a change of therapy."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    oboInOwl:hasExactSynonym "Need for further intervention"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000005 ;
    oheo:9000001 36 .

oheo:0000052 a owl:Class ;
    rdfs:label "work productivity outcome domain"@en ;
    obo:IAO_0000115 "An economic outcome domain covering paid and unpaid work lost or impaired because of ill health, including absenteeism and presenteeism."@en ;
    obo:IAO_0000116 "OHEO extension below the COMET taxonomy, added for health economic use."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000039 .

oheo:0000056 a owl:Class ;
    rdfs:label "surrogate endpoint specification"@en ;
    obo:IAO_0000115 "An intermediate outcome specification used in a study as a substitute for a final outcome, on the basis that change in it is expected to predict change in the final outcome."@en ;
    obo:IAO_0000116 "Use 'is surrogate for' to link to the final outcome it stands in for. NICE expects evidence that the surrogate relationship holds before a surrogate drives a cost-effectiveness estimate."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from FDA-NIH Biomarker Working Group 2016 (BEST Resource)" ;
    dcterms:source "FDA-NIH Biomarker Working Group. BEST (Biomarkers, EndpointS, and other Tools) Resource. Silver Spring (MD): Food and Drug Administration; Bethesda (MD): National Institutes of Health; 2016." ;
    oboInOwl:hasExactSynonym "surrogate outcome"@en ;
    oboInOwl:hasRelatedSynonym "surrogate marker"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000055 .

oheo:0000057 a owl:Class ;
    rdfs:label "biomarker endpoint specification"@en ;
    obo:IAO_0000115 "An intermediate outcome specification based on a biological marker, such as a laboratory value or an imaging finding, which serves as a surrogate endpoint only where its relation to a final outcome has been established."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from FDA-NIH Biomarker Working Group 2016 (BEST Resource)" ;
    dcterms:source "FDA-NIH Biomarker Working Group. BEST (Biomarkers, EndpointS, and other Tools) Resource. Silver Spring (MD): Food and Drug Administration; Bethesda (MD): National Institutes of Health; 2016." ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000055 .

oheo:0000059 a owl:Class ;
    rdfs:label "composite endpoint specification"@en ;
    obo:IAO_0000115 "An outcome specification in which a person has the outcome if they experience any one of two or more component outcomes, such as death, myocardial infarction or stroke."@en ;
    obo:IAO_0000116 "Components are linked with 'has component outcome'. Under COMET, a composite is classified in the domain of every component."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "ICH E9 1998" ;
    oboInOwl:hasDbXref "NCIT:C170561" ;
    oboInOwl:hasExactSynonym "combined endpoint"@en,
        "composite outcome"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oheo:1000006 ;
            owl:someValuesFrom oheo:0000053 ],
        oheo:0000053 .

oheo:0000061 a owl:Class ;
    rdfs:label "overall survival outcome specification"@en ;
    obo:IAO_0000115 "A time-to-event outcome specification in which overall survival is the time from a stated origin, such as randomisation, to death from any cause."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "FDA 2018" ;
    oboInOwl:hasDbXref "NCIT:C125201" ;
    oboInOwl:hasExactSynonym "OS"@en,
        "overall survival"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000043 ],
        [ a owl:Restriction ;
            owl:hasValue "time to event" ;
            owl:onProperty oheo:2000013 ],
        oheo:0000060 .

oheo:0000062 a owl:Class ;
    rdfs:label "progression-free survival outcome specification"@en ;
    obo:IAO_0000115 "A time-to-event outcome specification in which progression-free survival is the time from a stated origin to objectively defined disease progression or death from any cause, whichever occurs first."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "FDA 2018" ;
    oboInOwl:hasDbXref "NCIT:C28234" ;
    oboInOwl:hasExactSynonym "PFS"@en,
        "progression-free survival"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000021 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000043 ],
        [ a owl:Restriction ;
            owl:hasValue "time to event" ;
            owl:onProperty oheo:2000013 ],
        oheo:0000060 .

oheo:0000063 a owl:Class ;
    rdfs:label "event-free survival outcome specification"@en ;
    obo:IAO_0000115 "A time-to-event outcome specification in which event-free survival is the time from a stated origin to the first of a prespecified set of events, which usually includes death."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "FDA 2018" ;
    oboInOwl:hasDbXref "NCIT:C96340" ;
    oboInOwl:hasExactSynonym "EFS"@en,
        "event-free survival"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "time to event" ;
            owl:onProperty oheo:2000013 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000043 ],
        oheo:0000060 .

oheo:0000064 a owl:Class ;
    rdfs:label "relapse-free survival outcome specification"@en ;
    obo:IAO_0000115 "A time-to-event outcome specification in which relapse-free survival is the time from completion of curative-intent treatment, or from remission, to disease relapse or death."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    oboInOwl:hasExactSynonym "RFS"@en,
        "relapse-free survival"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "time to event" ;
            owl:onProperty oheo:2000013 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000043 ],
        oheo:0000060 .

oheo:0000065 a owl:Class ;
    rdfs:label "disease-free survival outcome specification"@en ;
    obo:IAO_0000115 "A time-to-event outcome specification in which disease-free survival is the time from a stated origin after curative-intent treatment to recurrence of disease or death from any cause."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "FDA 2018" ;
    oboInOwl:hasDbXref "NCIT:C17751" ;
    oboInOwl:hasExactSynonym "DFS"@en,
        "disease-free survival"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000021 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000043 ],
        [ a owl:Restriction ;
            owl:hasValue "time to event" ;
            owl:onProperty oheo:2000013 ],
        oheo:0000060 .

oheo:0000069 a owl:Class ;
    rdfs:label "objective response rate outcome specification"@en ;
    obo:IAO_0000115 "A response outcome specification whose summary is the proportion of people with a complete or partial tumour response under stated response criteria, such as RECIST 1.1."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Eisenhauer et al. 2009; FDA 2018" ;
    oboInOwl:hasExactSynonym "ORR"@en,
        "objective response rate"@en,
        "overall response rate"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000021 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000016 ;
            owl:someValuesFrom oheo:0000114 ],
        [ a owl:Restriction ;
            owl:hasValue "proportion" ;
            owl:onProperty oheo:2000014 ],
        oheo:0000068 .

oheo:0000070 a owl:Class ;
    rdfs:label "disease control rate outcome specification"@en ;
    obo:IAO_0000115 "A response outcome specification whose summary is the proportion of people with a complete response, a partial response or stable disease under stated response criteria."@en ;
    obo:IAO_0000116 "No agreed standard definition exists (for the clinical benefit rate the minimum duration varies by trial), so the definition keeps 'stated' criteria and time; an OHEO working definition."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    oboInOwl:hasExactSynonym "DCR"@en,
        "disease control rate"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000021 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000016 ;
            owl:someValuesFrom oheo:0000114 ],
        [ a owl:Restriction ;
            owl:hasValue "proportion" ;
            owl:onProperty oheo:2000014 ],
        oheo:0000068 .

oheo:0000071 a owl:Class ;
    rdfs:label "clinical benefit rate outcome specification"@en ;
    obo:IAO_0000115 "A response outcome specification whose summary is the proportion of people with a complete response, a partial response or stable disease lasting at least a stated minimum time."@en ;
    obo:IAO_0000116 "No agreed standard definition exists (for the clinical benefit rate the minimum duration varies by trial), so the definition keeps 'stated' criteria and time; an OHEO working definition."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    oboInOwl:hasExactSynonym "CBR"@en,
        "clinical benefit rate"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000021 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000016 ;
            owl:someValuesFrom oheo:0000114 ],
        [ a owl:Restriction ;
            owl:hasValue "proportion" ;
            owl:onProperty oheo:2000014 ],
        oheo:0000068 .

oheo:0000073 a owl:Class ;
    rdfs:label "health-related quality of life outcome specification"@en ;
    obo:IAO_0000115 "An outcome specification for health-related quality of life measured with a patient-reported or preference-based instrument."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    oboInOwl:hasBroadSynonym "quality of life outcome"@en ;
    oboInOwl:hasExactSynonym "HRQoL endpoint"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000048 ],
        oheo:0000053 .

oheo:0000075 a owl:Class ;
    rdfs:label "primary outcome specification"@en ;
    obo:IAO_0000115 "An outcome specification designated in a study protocol as the main outcome on which the study's conclusions and sample size are based."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "ICH E9 1998" ;
    oboInOwl:hasDbXref "NCIT:C94496" ;
    oboInOwl:hasExactSynonym "primary endpoint"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000053 .

oheo:0000077 a owl:Class ;
    rdfs:label "secondary outcome specification"@en ;
    obo:IAO_0000115 "An outcome specification designated in a study protocol as supporting the primary outcome or addressing additional questions."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "ICH E9 1998" ;
    oboInOwl:hasDbXref "NCIT:C139173" ;
    oboInOwl:hasExactSynonym "secondary endpoint"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000053 .

oheo:0000088 a owl:Class ;
    rdfs:label "condition-specific outcome measurement instrument"@en ;
    obo:IAO_0000115 "An outcome measurement instrument designed for people with a particular condition or treatment, covering the aspects of health most relevant to them."@en ;
    obo:IAO_0000116 "Defined class (0.2.0): an instrument is classified here by the reasoner when it has the classification value 'condition-specific design'."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Brazier et al. 2017" ;
    oboInOwl:hasExactSynonym "condition-specific measure"@en,
        "disease-specific instrument"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000082 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( oheo:0000082 [ a owl:Restriction ;
                        owl:hasValue oheo:0000387 ;
                        owl:onProperty oheo:1000035 ] ) ] .

oheo:0000096 a owl:Class ;
    rdfs:label "instrument item"@en ;
    obo:IAO_0000115 "An information content entity that is a single question, statement or task in an outcome measurement instrument, together with its response options."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Mokkink et al. 2010 (COSMIN)" ;
    oboInOwl:hasRelatedSynonym "question"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf obo:IAO_0000030 .

oheo:0000098 a owl:Class ;
    rdfs:label "response level"@en ;
    obo:IAO_0000112 "'I have slight problems in walking about'."@en ;
    obo:IAO_0000115 "An information content entity that is one of the ordered response categories of an instrument dimension or item."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Brazier et al. 2017" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf obo:IAO_0000030 .

oheo:0000100 a owl:Class ;
    rdfs:label "recall period specification"@en ;
    obo:IAO_0000115 "A directive information entity that states the period of time a respondent should consider when answering an instrument, such as 'today' or 'the past 4 weeks'."@en ;
    obo:IAO_0000116 "Most instruments record this as the 'has recall period' value rather than as a separate entity."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "FDA 2009" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf obo:IAO_0000033 .

oheo:0000103 a owl:Class ;
    rdfs:label "multi-attribute utility function"@en ;
    obo:IAO_0000115 "A utility function that assigns a utility to outcomes described by several attributes, by combining preference weights for the level of each attribute."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Torrance et al. 1996" ;
    oboInOwl:hasExactSynonym "MAU function"@en ;
    oboInOwl:hasRelatedSynonym "multi-attribute utility"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000102 .

oheo:0000110 a owl:Class ;
    rdfs:label "nominal scale"@en ;
    obo:IAO_0000115 "A measurement scale type whose values are categories with no order."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Stevens 1946" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000109 .

oheo:0000111 a owl:Class ;
    rdfs:label "ordinal scale"@en ;
    obo:IAO_0000115 "A measurement scale type whose values can be ranked but whose differences do not represent equal amounts of the underlying quantity."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Stevens 1946" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000109 .

oheo:0000112 a owl:Class ;
    rdfs:label "interval scale"@en ;
    obo:IAO_0000115 "A measurement scale type whose equal differences between values represent equal amounts of the underlying quantity, but whose zero is arbitrary."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Stevens 1946" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000109 .

oheo:0000113 a owl:Class ;
    rdfs:label "ratio scale"@en ;
    obo:IAO_0000115 "A measurement scale type with equal intervals and a true zero, so that ratios of values are meaningful."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Stevens 1946" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000109 .

oheo:0000118 a owl:Class ;
    rdfs:label "complete response"@en ;
    obo:IAO_0000115 "A tumour response category in which all target and non-target lesions have disappeared under the stated criteria."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Eisenhauer et al. 2009" ;
    oboInOwl:hasDbXref "NCIT:C159715" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000117 .

oheo:0000119 a owl:Class ;
    rdfs:label "partial response"@en ;
    obo:IAO_0000115 "A tumour response category in which target lesions have shrunk by at least a stated amount, under RECIST 1.1 at least 30% in the sum of diameters."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Eisenhauer et al. 2009" ;
    oboInOwl:hasDbXref "NCIT:C159547" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000117 .

oheo:0000120 a owl:Class ;
    rdfs:label "stable disease"@en ;
    obo:IAO_0000115 "A tumour response category in which change in target lesions is too small to qualify as partial response or progressive disease."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Eisenhauer et al. 2009" ;
    oboInOwl:hasDbXref "NCIT:C159546" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000117 .

oheo:0000121 a owl:Class ;
    rdfs:label "progressive disease"@en ;
    obo:IAO_0000115 "A tumour response category in which target lesions have grown by at least a stated amount or new lesions have appeared, under RECIST 1.1 at least 20% and 5 mm in the sum of diameters."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Eisenhauer et al. 2009" ;
    oboInOwl:hasDbXref "NCIT:C159716" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000117 .

