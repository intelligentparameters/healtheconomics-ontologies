oheo:0000164 a owl:Class ;
    rdfs:label "Lawton IADL Scale"@en ;
    obo:IAO_0000115 "An instrument of eight items rating independence in instrumental activities of daily living, such as shopping, cooking and managing finances."@en ;
    obo:IAO_0000116 "Covers instrumental activities of daily living, a sibling of the activities of daily living domain, so the reasoner does not classify it as an activities of daily living instrument."@en,
        "The Lawton IADL Scale is completed by the person, by an informant or by an interviewer recording what is reported (Lawton and Brody 1969), so the instrument sits directly under outcome measurement instrument and each version records its reporter with 'has reporter type' (0.2.0 fix pass). The reporter-type classes are disjoint, so a version cannot be both self-reported and proxy-reported."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Lawton and Brody 1969" ;
    dcterms:source "Lawton MP, Brody EM. Assessment of older people: self-maintaining and instrumental activities of daily living. Gerontologist. 1969;9(3):179-86." ;
    oboInOwl:hasDbXref "NCIT:C181894" ;
    oboInOwl:hasExactSynonym "Lawton Instrumental Activities of Daily Living Scale"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue 0.0 ;
            owl:onProperty oheo:2000006 ],
