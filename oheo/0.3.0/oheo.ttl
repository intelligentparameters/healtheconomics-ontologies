    oheo:9000002 true .

oheo:0000163 a owl:Class ;
    rdfs:label "Katz Index of Independence in Activities of Daily Living"@en ;
    obo:IAO_0000115 "An activities of daily living instrument of six items: bathing, dressing, toileting, transferring, continence and feeding."@en ;
    obo:IAO_0000116 "The Katz Index is completed by a clinician or from an informant's report, so the instrument sits directly under outcome measurement instrument and each version records its reporter with 'has reporter type' (0.2.0 fix pass). The reporter-type classes are disjoint, so a version cannot be both self-reported and proxy-reported."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Katz et al. 1963" ;
