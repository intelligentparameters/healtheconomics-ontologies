oheo:0000162 a owl:Class ;
    rdfs:label "Barthel Index"@en ;
    obo:IAO_0000115 "An activities of daily living instrument of ten items rating independence in self-care and mobility."@en ;
    obo:IAO_0000116 "The Barthel Index is completed by a clinician, by the person or by an informant, so the instrument sits directly under outcome measurement instrument and each version records its reporter with 'has reporter type' (0.2.0 fix pass). The reporter-type classes are disjoint, so a version cannot be both self-reported and proxy-reported."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Mahoney and Barthel 1965" ;
    dcterms:source "Mahoney FI, Barthel DW. Functional evaluation: the Barthel Index. Md State Med J. 1965;14:61-5." ;
    oboInOwl:hasDbXref "NCIT:C131914" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "higher is better" ;
            owl:onProperty oheo:2000008 ],
