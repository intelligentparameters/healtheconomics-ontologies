    oboInOwl:hasRelatedSynonym "subscale"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf obo:IAO_0000030 .

oheo:0000099 a owl:Class ;
    rdfs:label "health state classification system"@en ;
    obo:IAO_0000112 "The EQ-5D-5L descriptive system, with 3,125 health states."@en ;
    obo:IAO_0000115 "A classification scheme version that is the descriptive system of a preference-based measure, defining each health state as one combination of levels across its dimensions."@en ;
    obo:IAO_0000116 "A person's response is a RHEO state observation under this scheme, and the profile they report (for example 21121) is a RHEO health state classification profile."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Brazier et al. 2017" ;
    oboInOwl:hasExactSynonym "descriptive system"@en,
        "health state descriptive system"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf rheo:0000065 .

