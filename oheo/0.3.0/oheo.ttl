            owl:someValuesFrom oheo:0000204 ],
        [ a owl:Restriction ;
            owl:hasValue "adult general population of the United Kingdom" ;
            owl:onProperty oheo:2000012 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000010 ;
            owl:someValuesFrom oheo:0000124 ],
        oheo:0000175 ;
    oheo:9000002 true .

