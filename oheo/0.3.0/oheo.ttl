obo:OBI_0000789 a owl:Class ;
    rdfs:label "survival rate"@en ;
    obo:IAO_0000115 "A measurement data that represents the percentage of people or animals in a study or treatment group who are alive for a given period of time after diagnosis or initiation of monitoring."@en ;
    obo:IAO_0000119 "OBI (http://purl.obolibrary.org/obo/obi.owl)" ;
    obo:IAO_0000412 obo:obi.owl ;
    rdfs:isDefinedBy obo:obi.owl ;
    rdfs:subClassOf obo:IAO_0000109 .

obo:STATO_0000100 a owl:Class ;
    rdfs:label "standardized mean difference"@en ;
    obo:IAO_0000115 """standardized mean difference is statistic computed by forming the difference between two means, divided by an estimate of the within-group standard deviation.
It is used to provide an estimation of the effect size between two treatments when the predictor (independent variable) is categorical and the response(dependent) variable is continuous.

A standardized mean difference is a statistic that is a difference between two means, divided by a statistical measure of dispersion. 

The term Standardized Mean Difference is a description of the concept without an explicit type of statistical measure of dispersion. If the statistical measure of dispersion is specified, then a type (child term) of Standardized Mean Difference is preferred."""@en ;
    obo:IAO_0000116 "Also asserted under difference in STATO; only one parent is declared here. Consult STATO for its full axioms."@en ;
    obo:IAO_0000119 "STATO (http://purl.obolibrary.org/obo/stato.owl)" ;
    obo:IAO_0000412 obo:stato.owl ;
    rdfs:isDefinedBy obo:stato.owl ;
    rdfs:subClassOf obo:STATO_0000085 .

obo:STATO_0000182 a owl:Class ;
    rdfs:label "odds ratio"@en ;
    obo:IAO_0000115 """Odds ratio is a ratio that measures effect size, that is the strength of association between 2 dichotomous variables, one describing an exposure and one describing an outcome.
It represents the odds that an outcome will occur given a particular exposure, compared to the odds of the outcome occurring in the absence of that exposure ( the probability of the event occuring divided by the probability of an event not occurring). The odds ratio is a ratio of describing the strength of association or non-independence between two binary data values by forming the ratio of the odds for the first group and the odds for the second group. Odds ratio are used when one wants to compare the odds of something occurring to two different groups."""@en ;
    obo:IAO_0000116 "Also asserted under dimensionless ratio, ratio-based measure of association in STATO; only one parent is declared here. Consult STATO for its full axioms."@en ;
    obo:IAO_0000119 "STATO (http://purl.obolibrary.org/obo/stato.owl)" ;
    obo:IAO_0000412 obo:stato.owl ;
    rdfs:isDefinedBy obo:stato.owl ;
    rdfs:subClassOf obo:STATO_0000085 .

obo:STATO_0000245 a owl:Class ;
    rdfs:label "relative risk"@en ;
    obo:IAO_0000115 "Relative risk is a measurement datum which denotes the risk of an 'event' relative to an 'exposure'. Relative risk is calculated by forming the ratio of the probability of the event occurring in the exposed group versus the probability of this event occurring in the non-exposed group."@en ;
    obo:IAO_0000116 "Also asserted under risk in STATO; only one parent is declared here. Consult STATO for its full axioms."@en ;
    obo:IAO_0000119 "STATO (http://purl.obolibrary.org/obo/stato.owl)" ;
    obo:IAO_0000412 obo:stato.owl ;
    rdfs:isDefinedBy obo:stato.owl ;
    rdfs:subClassOf obo:STATO_0000085 .

obo:STATO_0000457 a owl:Class ;
    rdfs:label "mean difference"@en ;
    obo:IAO_0000115 """The mean difference, or difference in means, measures the absolute difference between the mean value in two different groups.

The mean difference is a subtraction of one mean from another.

The primary use of this term is in analyzing between-group differences"""@en ;
    obo:IAO_0000119 "STATO (http://purl.obolibrary.org/obo/stato.owl)" ;
    obo:IAO_0000412 obo:stato.owl ;
    rdfs:isDefinedBy obo:stato.owl ;
    rdfs:subClassOf obo:STATO_0000614 .

obo:STATO_0000607 a owl:Class ;
    rdfs:label "proportion"@en ;
    obo:IAO_0000115 "a proportion is a ratio which corresponds to the fraction of the total presenting a particular feature"@en ;
    obo:IAO_0000119 "STATO (http://purl.obolibrary.org/obo/stato.owl)" ;
    obo:IAO_0000412 obo:stato.owl ;
    rdfs:isDefinedBy obo:stato.owl ;
    rdfs:subClassOf obo:STATO_0000184 .

obo:STATO_0000645 a owl:Class ;
    rdfs:label "rate"@en ;
    obo:IAO_0000115 "A ratio in which the numerator represents any quantity and the denominator represents an interval of time."@en ;
    obo:IAO_0000119 "STATO (http://purl.obolibrary.org/obo/stato.owl)" ;
    obo:IAO_0000412 obo:stato.owl ;
    rdfs:isDefinedBy obo:stato.owl ;
    rdfs:subClassOf obo:STATO_0000184 .

obo:STATO_0000659 a owl:Class ;
    rdfs:label "median time-to-event"@en ;
    obo:IAO_0000115 "A median of values in which each value is the duration of time between the start of observation and the occurrence of an event."@en ;
    obo:IAO_0000119 "STATO (http://purl.obolibrary.org/obo/stato.owl)" ;
    obo:IAO_0000412 obo:stato.owl ;
    rdfs:isDefinedBy obo:stato.owl ;
    rdfs:subClassOf obo:STATO_0000574 .

obo:STATO_0000677 a owl:Class ;
    rdfs:label "hazard ratio"@en ;
    obo:IAO_0000115 "A measure of association that is the ratio of the hazard rate of an event in one group to the hazard rate of the same event in another group."@en ;
    obo:IAO_0000119 "STATO (http://purl.obolibrary.org/obo/stato.owl)" ;
    obo:IAO_0000412 obo:stato.owl ;
    rdfs:isDefinedBy obo:stato.owl ;
    rdfs:subClassOf obo:STATO_0000184 .

