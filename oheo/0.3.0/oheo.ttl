    oheo:9000001 18 .

oheo:0000025 a owl:Class ;
    rdfs:label "reproductive system and breast outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the physiological or clinical outcome area, covering outcomes associated with the reproductive system and breast system or condition group, such as fertility or sexual function."@en ;
    obo:IAO_0000116 "Physiological domains follow MedDRA System Organ Classes, as in the COMET taxonomy."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
