            owl:hasValue 8 ;
            owl:onProperty oheo:2000001 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000046 ],
        [ a owl:Restriction ;
            owl:hasValue 8.0 ;
            owl:onProperty oheo:2000007 ],
        oheo:0000082 ;
    oheo:9000002 true .

