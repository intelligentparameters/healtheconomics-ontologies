oheo:0000047 a owl:Class ;
    rdfs:label "activity limitation outcome domain"@en ;
    obo:IAO_0000115 "A physical functioning outcome domain covering difficulties a person has in carrying out tasks or actions, as described in the WHO International Classification of Functioning, Disability and Health."@en ;
    obo:IAO_0000116 "OHEO extension below the COMET taxonomy, added for health economic use."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from WHO 2001 (ICF)" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000030 .

oheo:0000054 a owl:Class ;
    rdfs:label "final outcome specification"@en ;
    obo:IAO_0000115 "An outcome specification for an outcome that directly reflects how a person feels, functions or survives, rather than standing in for it."@en ;
    obo:IAO_0000116 "Health economic models value final outcomes, usually as QALYs. 'Clinical benefit' and 'patient outcome' on HealthEconomics.wiki map here."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from FDA-NIH Biomarker Working Group 2016 (BEST Resource)" ;
    dcterms:source "FDA-NIH Biomarker Working Group. BEST (Biomarkers, EndpointS, and other Tools) Resource. Silver Spring (MD): Food and Drug Administration; Bethesda (MD): National Institutes of Health; 2016." ;
    oboInOwl:hasExactSynonym "true endpoint"@en ;
    oboInOwl:hasRelatedSynonym "clinical outcome"@en,
        "patient-relevant outcome"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000053 .

oheo:0000058 a owl:Class ;
    rdfs:label "minimal residual disease endpoint specification"@en ;
    obo:IAO_0000115 "A biomarker endpoint specification based on the amount of disease still detectable by highly sensitive methods after treatment has produced an apparent complete response."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "FDA 2020" ;
    oboInOwl:hasExactSynonym "MRD endpoint"@en ;
    oboInOwl:hasRelatedSynonym "MRD negativity rate"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000057 .

oheo:0000066 a owl:Class ;
    rdfs:label "cause-specific survival outcome specification"@en ;
    obo:IAO_0000115 "A time-to-event outcome specification in which cause-specific survival is the time from a stated origin to death from the disease of interest, with deaths from other causes treated as censoring or competing events."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    oboInOwl:hasExactSynonym "cause-specific survival"@en,
        "disease-specific survival"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "time to event" ;
            owl:onProperty oheo:2000013 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000043 ],
        oheo:0000060 .

oheo:0000067 a owl:Class ;
    rdfs:label "symptom-free survival outcome specification"@en ;
    obo:IAO_0000115 "A time-to-event outcome specification in which symptom-free survival is the time from a stated origin to the onset or return of clinically significant symptoms or death."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    oboInOwl:hasExactSynonym "symptom-free survival"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000043 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000050 ],
        [ a owl:Restriction ;
            owl:hasValue "time to event" ;
            owl:onProperty oheo:2000013 ],
        oheo:0000060 .

oheo:0000072 a owl:Class ;
    rdfs:label "safety outcome specification"@en ;
    obo:IAO_0000115 "An outcome specification for the occurrence, frequency or severity of adverse events."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    oboInOwl:hasExactSynonym "safety endpoint"@en ;
    oboInOwl:hasRelatedSynonym "adverse event outcome"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000044 ],
        oheo:0000053 .

oheo:0000074 a owl:Class ;
    rdfs:label "health utility outcome specification"@en ;
    obo:IAO_0000115 "A health-related quality of life outcome specification whose variable is a utility obtained from a preference-based measure and a stated value set."@en ;
    obo:IAO_0000116 "The natural input to a QALY calculation. The value set should be stated, because the same responses give different utilities under different value sets."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000073 .

oheo:0000076 a owl:Class ;
    rdfs:label "co-primary outcome specification"@en ;
    obo:IAO_0000115 "A primary outcome specification that is one of two or more outcomes all designated as primary in the same protocol."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "ICH E9 1998" ;
    oboInOwl:hasExactSynonym "co-primary endpoint"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000075 .

oheo:0000078 a owl:Class ;
    rdfs:label "key secondary outcome specification"@en ;
    obo:IAO_0000115 "A secondary outcome specification designated for confirmatory testing, usually within a prespecified testing hierarchy."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "EMA 2002 (CPMP/EWP/908/99)" ;
    oboInOwl:hasExactSynonym "key secondary endpoint"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000077 .

oheo:0000079 a owl:Class ;
    rdfs:label "exploratory outcome specification"@en ;
    obo:IAO_0000115 "An outcome specification designated in a study protocol for hypothesis generation rather than confirmatory testing."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    oboInOwl:hasDbXref "NCIT:C170559" ;
    oboInOwl:hasExactSynonym "exploratory endpoint"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000053 .

oheo:0000081 a owl:Class ;
    rdfs:label "routine care outcome standard set"@en ;
    obo:IAO_0000115 "A core outcome set agreed for measuring outcomes in routine clinical practice for a condition, rather than in trials, so that providers can compare results."@en ;
    obo:IAO_0000116 "Standard sets of the International Consortium for Health Outcomes Measurement are examples."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Porter et al. 2016" ;
    oboInOwl:hasExactSynonym "standard set"@en ;
    oboInOwl:hasNarrowSynonym "ICHOM standard set"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000080 .

oheo:0000087 a owl:Class ;
    rdfs:label "generic outcome measurement instrument"@en ;
    obo:IAO_0000115 "An outcome measurement instrument designed for use across conditions and populations, so that results can be compared between them."@en ;
    obo:IAO_0000116 "Defined class (0.2.0): an instrument is classified here by the reasoner when it has the classification value 'generic design'. In 0.1.0 this was a second asserted parent."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Brazier et al. 2017" ;
    oboInOwl:hasExactSynonym "generic measure"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000082 ;
    owl:disjointWith oheo:0000088 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( oheo:0000082 [ a owl:Restriction ;
                        owl:hasValue oheo:0000386 ;
                        owl:onProperty oheo:1000035 ] ) ] .

oheo:0000089 a owl:Class ;
    rdfs:label "health profile instrument"@en ;
    obo:IAO_0000115 "An outcome measurement instrument that reports separate scores for several aspects of health rather than a single preference-weighted index."@en ;
    obo:IAO_0000116 "Defined class (0.2.0): an instrument is classified here by the reasoner when it has the classification value 'health profile scoring'."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Brazier et al. 2017" ;
    oboInOwl:hasExactSynonym "profile measure"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000082 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( oheo:0000082 [ a owl:Restriction ;
                        owl:hasValue oheo:0000388 ;
                        owl:onProperty oheo:1000035 ] ) ] .

oheo:0000091 a owl:Class ;
    rdfs:label "generic preference-based measure"@en ;
    obo:IAO_0000115 "A preference-based measure designed for use across conditions and populations."@en ;
    obo:IAO_0000116 "Defined class (0.2.0): a preference-based measure with the classification value 'generic design'."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Brazier et al. 2017" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000090 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( oheo:0000082 [ a owl:Restriction ;
                        owl:onProperty oheo:1000034 ;
                        owl:someValuesFrom oheo:0000105 ] [ a owl:Restriction ;
                        owl:hasValue oheo:0000386 ;
                        owl:onProperty oheo:1000035 ] ) ] .

oheo:0000092 a owl:Class ;
    rdfs:label "condition-specific preference-based measure"@en ;
    obo:IAO_0000115 "A preference-based measure whose descriptive system is designed for a particular condition, often derived from a condition-specific profile instrument."@en ;
    obo:IAO_0000116 "Defined class (0.2.0): a preference-based measure with the classification value 'condition-specific design'."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Brazier et al. 2017" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000090 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( oheo:0000082 [ a owl:Restriction ;
                        owl:onProperty oheo:1000034 ;
                        owl:someValuesFrom oheo:0000105 ] [ a owl:Restriction ;
                        owl:hasValue oheo:0000387 ;
                        owl:onProperty oheo:1000035 ] ) ] .

oheo:0000093 a owl:Class ;
    rdfs:label "wellbeing or capability instrument"@en ;
    obo:IAO_0000115 "An outcome measurement instrument that covers the wellbeing and capability outcome domain, measuring wellbeing or capability beyond health, such as autonomy, attachment or control over daily life."@en ;
    obo:IAO_0000116 "Defined class (0.2.0): an instrument is classified here by the reasoner when it covers the wellbeing and capability outcome domain."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Coast et al. 2008; Al-Janabi et al. 2012" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000049 ],
        oheo:0000082 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( oheo:0000082 [ a owl:Restriction ;
                        owl:onProperty oheo:1000001 ;
                        owl:someValuesFrom oheo:0000049 ] ) ] .

oheo:0000094 a owl:Class ;
    rdfs:label "activities of daily living instrument"@en ;
    obo:IAO_0000115 "An outcome measurement instrument that covers the activities of daily living outcome domain, assessing a person's independence in basic self-care tasks."@en ;
    obo:IAO_0000116 "Defined class (0.2.0): an instrument is classified here by the reasoner when it covers the activities of daily living outcome domain. Instruments for instrumental activities of daily living, such as the Lawton IADL Scale, cover a sibling domain and are not classified here."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000045 ],
        oheo:0000082 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( oheo:0000082 [ a owl:Restriction ;
                        owl:onProperty oheo:1000001 ;
                        owl:someValuesFrom oheo:0000045 ] ) ] .

oheo:0000095 a owl:Class ;
    rdfs:label "obsolete instrument family"@en ;
    obo:IAO_0000115 "OBSOLETE. An information content entity that groups versions and variants of an outcome measurement instrument that share a name, developer and core content, such as the EQ-5D family."@en ;
    obo:IAO_0000116 "Made obsolete in 0.2.0. An instrument family is not a kind of instrument: a version of the EQ-5D-5L is not a family. The family is now the named instrument class itself (EQ-5D, Health Utilities Index, AQoL), whose subclasses are its members."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    oboInOwl:consider oheo:0000122,
        oheo:0000130,
        oheo:0000134 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    owl:deprecated true .

oheo:0000104 a owl:Class ;
    rdfs:label "single-attribute utility function"@en ;
    obo:IAO_0000115 "A utility function that assigns a utility to outcomes described by a single attribute."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Keeney and Raiffa 1976" ;
    oboInOwl:hasRelatedSynonym "single attribute utility"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000102 .

oheo:0000115 a owl:Class ;
    rdfs:label "RECIST 1.1"@en ;
    obo:IAO_0000115 "A set of outcome classification criteria for solid tumours that classify change in measurable disease on imaging as complete response, partial response, stable disease or progressive disease."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Eisenhauer et al. 2009" ;
    dcterms:source "Eisenhauer EA, Therasse P, Bogaerts J, et al. New response evaluation criteria in solid tumours: revised RECIST guideline (version 1.1). Eur J Cancer. 2009;45(2):228-47." ;
    oboInOwl:hasExactSynonym "Response Evaluation Criteria in Solid Tumours version 1.1"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000114 ;
    oheo:9000002 true .

oheo:0000116 a owl:Class ;
    rdfs:label "CTCAE version 5.0"@en ;
    obo:IAO_0000115 "A set of outcome classification criteria that grade the severity of adverse events from grade 1 (mild) to grade 5 (death related to the adverse event)."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "National Cancer Institute 2017" ;
    dcterms:source "National Cancer Institute. Common Terminology Criteria for Adverse Events (CTCAE) Version 5.0. 2017." ;
    oboInOwl:hasExactSynonym "Common Terminology Criteria for Adverse Events v5.0"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000114 ;
    oheo:9000002 true .

oheo:0000126 a owl:Class ;
    rdfs:label "obsolete SF instrument family"@en ;
    obo:IAO_0000115 "OBSOLETE. An instrument family of short-form health surveys derived from the Medical Outcomes Study, including the SF-36, the SF-12 and the preference-based SF-6D."@en ;
    obo:IAO_0000116 "Made obsolete in 0.2.0. The SF instruments are not one kind: the SF-36 and SF-12 are health profiles and the SF-6D is a preference-based measure. Their relation is recorded with 'derived from instrument'."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Ware and Sherbourne 1992" ;
    oboInOwl:consider oheo:0000127,
        oheo:0000128,
        oheo:0000129,
        oheo:0000312 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    owl:deprecated true .

oheo:0000198 a owl:Class ;
    rdfs:label "indirect health state valuation process"@en ;
    obo:IAO_0000115 "A health state valuation process in which a person's responses to a preference-based measure are converted to a utility using an existing value set, without the person valuing states themselves."@en ;
    obo:IAO_0000116 "The usual source of utilities for QALYs in trials. Inputs: a RHEO state observation and a value set; output: a RHEO utility measurement record."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Brazier et al. 2017" ;
    oboInOwl:hasExactSynonym "indirect utility assessment"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oheo:1000014 ;
            owl:someValuesFrom oheo:0000105 ],
        oheo:0000196 .

oheo:0000199 a owl:Class ;
    rdfs:label "utility mapping process"@en ;
    obo:IAO_0000115 "A health state valuation process in which utilities are predicted from responses to another instrument by applying a mapping function."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Wailoo et al. 2017" ;
    oboInOwl:hasRelatedSynonym "cross-walking"@en,
        "mapping"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000196 .

oheo:0000210 a owl:Class ;
    rdfs:label "magnitude estimation"@en ;
    obo:IAO_0000115 "A ratio scaling process in which the respondent assigns numbers to health states in proportion to their perceived magnitude relative to a reference state."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Brazier et al. 2017" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000209 .

oheo:0000212 a owl:Class ;
    rdfs:label "conjoint analysis"@en ;
    obo:IAO_0000115 "A stated preference elicitation process that estimates how much each attribute of a good or service contributes to its value, from respondents' ratings, rankings or choices of described alternatives."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Bridges et al. 2011" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000195 .

oheo:0000216 a owl:Class ;
    rdfs:label "point allocation"@en ;
    obo:IAO_0000115 "A stated preference elicitation process in which respondents divide a fixed number of points, often 100, among outcomes or criteria to show their relative importance."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    oboInOwl:hasExactSynonym "constant-sum scaling"@en,
        "point allocation method"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000195 .

oheo:0000219 a owl:Class ;
    rdfs:label "willingness-to-pay elicitation"@en ;
    obo:IAO_0000115 "A contingent valuation in which respondents state the most they would pay for a stated gain."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Drummond et al. 2015" ;
    oboInOwl:hasExactSynonym "WTP elicitation"@en ;
    oboInOwl:hasRelatedSynonym "willingness-to-pay estimation"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000218 .

oheo:0000220 a owl:Class ;
    rdfs:label "willingness-to-accept elicitation"@en ;
    obo:IAO_0000115 "A contingent valuation in which respondents state the least compensation they would accept for a stated loss."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Drummond et al. 2015" ;
    oboInOwl:hasExactSynonym "WTA elicitation"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000218 .

oheo:0000222 a owl:Class ;
    rdfs:label "meta-regression benefit transfer"@en ;
    obo:IAO_0000115 "A benefit transfer in which a meta-regression across original studies predicts the value for the new context from its characteristics."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Johnston et al. 2015" ;
    oboInOwl:hasExactSynonym "meta-regression transfer"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000221 .

oheo:0000224 a owl:Class ;
    rdfs:label "EQ-VT protocol"@en ;
    obo:IAO_0000115 "A valuation study design for EQ-5D-5L value sets that combines composite time trade-off and discrete choice tasks in computer-assisted interviews."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Oppe et al. 2014" ;
    dcterms:source "Oppe M, Devlin NJ, van Hout B, Krabbe PF, de Charro F. A program of methodological research to arrive at the new international EQ-5D-5L valuation protocol. Value Health. 2014;17(4):445-53." ;
    oboInOwl:hasExactSynonym "EuroQol Valuation Technology"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000223 .

oheo:0000226 a owl:Class ;
    rdfs:label "orthogonal design"@en ;
    obo:IAO_0000115 "A choice experiment design in which attribute levels vary independently of each other across choice sets."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Reed Johnson et al. 2013" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000225 .

oheo:0000228 a owl:Class ;
    rdfs:label "D-efficient design"@en ;
    obo:IAO_0000115 "An efficient design chosen to minimise the determinant of the expected variance-covariance matrix of the model parameters."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Reed Johnson et al. 2013" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000227 .

oheo:0000239 a owl:Class ;
    rdfs:label "internal consistency evaluation"@en ;
    obo:IAO_0000115 "A reliability evaluation that assesses the degree of interrelatedness among the items of a scale."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Mokkink et al. 2010 (COSMIN)" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000238 .

oheo:0000240 a owl:Class ;
    rdfs:label "test-retest reliability evaluation"@en ;
    obo:IAO_0000115 "A reliability evaluation that assesses the agreement between scores obtained on separate occasions from people whose health has not changed."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Mokkink et al. 2010 (COSMIN)" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000238 .

oheo:0000241 a owl:Class ;
    rdfs:label "measurement error evaluation"@en ;
    obo:IAO_0000115 "A reliability evaluation that assesses the systematic and random error in a person's score that is not attributable to true change."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Mokkink et al. 2010 (COSMIN)" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000238 .

oheo:0000243 a owl:Class ;
    rdfs:label "content validity evaluation"@en ;
    obo:IAO_0000115 "A validity evaluation that assesses the degree to which the content of an instrument adequately reflects the construct to be measured."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Mokkink et al. 2010 (COSMIN)" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000242 .

oheo:0000245 a owl:Class ;
    rdfs:label "structural validity evaluation"@en ;
    obo:IAO_0000115 "A construct validity evaluation that assesses the degree to which scores adequately reflect the dimensionality of the construct."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Mokkink et al. 2010 (COSMIN)" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000244 .

oheo:0000246 a owl:Class ;
    rdfs:label "cross-cultural validity evaluation"@en ;
    obo:IAO_0000115 "A construct validity evaluation that assesses the degree to which a translated or culturally adapted instrument performs like the original."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Mokkink et al. 2010 (COSMIN)" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000244 .

oheo:0000247 a owl:Class ;
    rdfs:label "criterion validity evaluation"@en ;
    obo:IAO_0000115 "A validity evaluation that assesses the degree to which scores adequately reflect a gold standard."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Mokkink et al. 2010 (COSMIN)" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000242 .

oheo:0000248 a owl:Class ;
    rdfs:label "responsiveness evaluation"@en ;
    obo:IAO_0000115 "A measurement property evaluation that assesses the ability of an instrument to detect change over time in the construct measured."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Mokkink et al. 2010 (COSMIN)" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000237 .

oheo:0000249 a owl:Class ;
    rdfs:label "interpretability evaluation"@en ;
    obo:IAO_0000115 "A measurement property evaluation that assesses the degree to which qualitative meaning can be assigned to scores or changes in scores, such as a minimal important difference or floor and ceiling effects."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Mokkink et al. 2010 (COSMIN)" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000237 .

oheo:0000252 a owl:Class ;
    rdfs:label "anchor-based minimal important difference estimate"@en ;
    obo:IAO_0000115 "A minimal important difference estimate obtained by relating score changes to an external anchor, such as a patient's global rating of change."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Revicki et al. 2008" ;
    oboInOwl:hasRelatedSynonym "anchor-based MID"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000251 .

oheo:0000253 a owl:Class ;
    rdfs:label "distribution-based minimal important difference estimate"@en ;
    obo:IAO_0000115 "A minimal important difference estimate obtained from the spread of scores or the reliability of the instrument, such as half a standard deviation."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Revicki et al. 2008" ;
    oboInOwl:hasRelatedSynonym "distribution-based MID"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000251 .

oheo:0000262 a owl:Class ;
    rdfs:label "incremental QALY estimate"@en ;
    obo:IAO_0000115 "A QALY estimate of the difference in QALYs between an intervention and its comparator."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Drummond et al. 2015" ;
    oboInOwl:hasRelatedSynonym "QALY gain"@en,
        "QALYs gained"@en,
        "incremental QALYs"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000261 .

oheo:0000270 a owl:Class ;
    rdfs:label "absolute QALY shortfall estimate"@en ;
    obo:IAO_0000115 "A QALY shortfall estimate expressed as the number of future QALYs lost."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "NICE 2022 (PMG36)" ;
    oboInOwl:hasRelatedSynonym "absolute shortfall"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000269 .

oheo:0000271 a owl:Class ;
    rdfs:label "proportional QALY shortfall estimate"@en ;
    obo:IAO_0000115 "A QALY shortfall estimate expressed as the proportion of expected future QALYs lost."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "NICE 2022 (PMG36)" ;
    oboInOwl:hasRelatedSynonym "proportional shortfall"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000269 .

oheo:0000279 a owl:Class ;
    rdfs:label "part-worth utility estimate"@en ;
    obo:IAO_0000115 "A choice model estimate of the contribution of one attribute level to the overall utility of an alternative."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Drummond et al. 2015" ;
    oboInOwl:hasRelatedSynonym "part-worth"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000277 .

oheo:0000280 a owl:Class ;
    rdfs:label "marginal rate of substitution estimate"@en ;
    obo:IAO_0000115 "A choice model estimate of the amount of one attribute a respondent would give up for a unit increase in another, holding utility constant."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Drummond et al. 2015" ;
    oboInOwl:hasRelatedSynonym "marginal rate of substitution"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000277 .

oheo:0000287 a owl:Class ;
    rdfs:label "Sullivan method"@en ;
    obo:IAO_0000115 "A health expectancy calculation process that divides the person-years of a period life table into healthy and unhealthy years using age-specific prevalence of the health state."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Sullivan 1971" ;
    dcterms:source "Sullivan DF. A single index of mortality and morbidity. HSMHA Health Rep. 1971;86(4):347-54." ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000286 .

oheo:0000288 a owl:Class ;
    rdfs:label "multi-state life table method"@en ;
    obo:IAO_0000115 "A health expectancy calculation process that uses transition rates between living states and death to estimate expected time in each state."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Robine et al. 2003" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000286 .

oheo:0000329 a owl:Class ;
    rdfs:label "obsolete requirement: QALYs as the measure of health effect"@en ;
    obo:IAO_0000115 "OBSOLETE. An outcome reference case requirement that health effects are expressed in quality-adjusted life years."@en ;
    obo:IAO_0000116 "Made obsolete in 0.2.0. Reference case requirements are now published as SHACL shapes (oheo-reference-case-shapes.ttl), one shape for each reference case profile, because an OWL class with 'some' restrictions cannot check that an analysis meets a requirement. The requirement this class stated is a constraint in the shape of each profile that set it."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    obo:IAO_0000231 obo:OMO_0001000 ;
    oboInOwl:consider oheo:0000328 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:seeAlso <https://healtheconomics.wiki/ontologies/oheo/reference-case-shapes> ;
    owl:deprecated true .

oheo:0000330 a owl:Class ;
    rdfs:label "obsolete requirement: QALYs and evLYG as the measures of health effect"@en ;
    obo:IAO_0000115 "OBSOLETE. An outcome reference case requirement that health effects are reported both in quality-adjusted life years and in equal value life-years gained."@en ;
    obo:IAO_0000116 "Made obsolete in 0.2.0. Reference case requirements are now published as SHACL shapes (oheo-reference-case-shapes.ttl), one shape for each reference case profile, because an OWL class with 'some' restrictions cannot check that an analysis meets a requirement. The requirement this class stated is a constraint in the shape of each profile that set it."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    obo:IAO_0000231 obo:OMO_0001000 ;
    oboInOwl:consider oheo:0000328 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:seeAlso <https://healtheconomics.wiki/ontologies/oheo/reference-case-shapes> ;
    owl:deprecated true .

oheo:0000331 a owl:Class ;
    rdfs:label "obsolete requirement: QALYs and life-years as the measures of health effect"@en ;
    obo:IAO_0000115 "OBSOLETE. An outcome reference case requirement that health effects are reported in quality-adjusted life years, with an accompanying analysis in life-years gained."@en ;
