oheo:0000169 a owl:Class ;
    rdfs:label "Expanded Disability Status Scale"@en ;
    obo:IAO_0000115 "A clinician-reported outcome measure that grades disability in multiple sclerosis from 0 (normal neurological examination) to 10 (death due to multiple sclerosis)."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Kurtzke 1983" ;
    dcterms:source "Kurtzke JF. Rating neurologic impairment in multiple sclerosis: an expanded disability status scale (EDSS). Neurology. 1983;33(11):1444-52." ;
    oboInOwl:hasDbXref "NCIT:C98302" ;
    oboInOwl:hasExactSynonym "EDSS"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "higher is worse" ;
            owl:onProperty oheo:2000008 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000022 ],
        [ a owl:Restriction ;
            owl:hasValue 0.0 ;
            owl:onProperty oheo:2000006 ],
        [ a owl:Restriction ;
            owl:hasValue 10.0 ;
            owl:onProperty oheo:2000007 ],
        [ a owl:Restriction ;
            owl:hasValue oheo:0000387 ;
            owl:onProperty oheo:1000035 ],
        oheo:0000084 ;
    oheo:9000002 true .

oheo:0000171 a owl:Class ;
    rdfs:label "six-minute walk test"@en ;
    obo:IAO_0000115 "A performance outcome measure in which a person walks as far as possible in six minutes on a flat course, recorded as distance in metres."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "American Thoracic Society 2002" ;
    dcterms:source "ATS Committee on Proficiency Standards for Clinical Pulmonary Function Laboratories. ATS statement: guidelines for the six-minute walk test. Am J Respir Crit Care Med. 2002;166(1):111-7." ;
    oboInOwl:hasDbXref "NCIT:C115789" ;
    oboInOwl:hasExactSynonym "6-minute walk test"@en,
        "6MWT"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000030 ],
        [ a owl:Restriction ;
            owl:hasValue "higher is better" ;
            owl:onProperty oheo:2000008 ],
        [ a owl:Restriction ;
            owl:hasValue oheo:0000386 ;
            owl:onProperty oheo:1000035 ],
        oheo:0000086 ;
    oheo:9000002 true .

oheo:0000172 a owl:Class ;
    rdfs:label "Timed Up and Go test"@en ;
    obo:IAO_0000115 "A performance outcome measure timing how long a person takes to rise from a chair, walk three metres, turn, walk back and sit down."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Podsiadlo and Richardson 1991" ;
    dcterms:source "Podsiadlo D, Richardson S. The timed 'Up & Go': a test of basic functional mobility for frail elderly persons. J Am Geriatr Soc. 1991;39(2):142-8." ;
    oboInOwl:hasDbXref "NCIT:C115795" ;
    oboInOwl:hasExactSynonym "TUG"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue oheo:0000386 ;
            owl:onProperty oheo:1000035 ],
        [ a owl:Restriction ;
            owl:hasValue "higher is worse" ;
            owl:onProperty oheo:2000008 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000030 ],
        oheo:0000086 ;
    oheo:9000002 true .

oheo:0000173 a owl:Class ;
    rdfs:label "Short Physical Performance Battery"@en ;
    obo:IAO_0000115 "A performance outcome measure combining balance, gait speed and chair stand tests, scored from 0 to 12."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Guralnik et al. 1994" ;
    dcterms:source "Guralnik JM, Simonsick EM, Ferrucci L, et al. A short physical performance battery assessing lower extremity function. J Gerontol. 1994;49(2):M85-94." ;
    oboInOwl:hasExactSynonym "SPPB"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000030 ],
        [ a owl:Restriction ;
            owl:hasValue "higher is better" ;
            owl:onProperty oheo:2000008 ],
        [ a owl:Restriction ;
            owl:hasValue oheo:0000386 ;
            owl:onProperty oheo:1000035 ],
        [ a owl:Restriction ;
            owl:hasValue 0.0 ;
            owl:onProperty oheo:2000006 ],
        [ a owl:Restriction ;
            owl:hasValue 12.0 ;
            owl:onProperty oheo:2000007 ],
        oheo:0000086 ;
    oheo:9000002 true .

oheo:0000180 a owl:Class ;
    rdfs:label "SF-6D UK value set (Brazier 2002)"@en ;
    obo:IAO_0000115 "An SF-6D value set elicited by standard gamble from a sample of the UK general population."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Brazier et al. 2002" ;
    dcterms:source "Brazier et al. 2002" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "UK general population" ;
            owl:onProperty oheo:2000012 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000031 ;
            owl:someValuesFrom oheo:0000200 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000010 ;
            owl:someValuesFrom oheo:0000129 ],
        oheo:0000105 ;
    oheo:9000002 true .

oheo:0000181 a owl:Class ;
    rdfs:label "HUI2 value set (Torrance 1996)"@en ;
    obo:IAO_0000115 "A value set for HUI2 health states, a multi-attribute utility function elicited from a sample of the general population of Hamilton, Ontario."@en ;
    obo:IAO_0000116 "The worst health state utility was carried over from 0.1.0 and has not been checked against the paper, so the record rules only warn when a utility falls below it."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Torrance et al. 1996" ;
    dcterms:source "Torrance et al. 1996" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oheo:1000031 ;
            owl:someValuesFrom oheo:0000200 ],
        [ a owl:Restriction ;
            owl:hasValue "general population of Hamilton, Canada" ;
            owl:onProperty oheo:2000012 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000010 ;
            owl:someValuesFrom oheo:0000131 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000031 ;
            owl:someValuesFrom oheo:0000205 ],
        [ a owl:Restriction ;
            owl:hasValue -0.03 ;
            owl:onProperty oheo:2000009 ],
        oheo:0000105 ;
    oheo:9000002 true .

oheo:0000182 a owl:Class ;
    rdfs:label "HUI3 value set (Feeny 2002)"@en ;
    obo:IAO_0000115 "A value set for HUI3 health states, a multi-attribute utility function elicited from a sample of the general population of Hamilton, Ontario, ranging from -0.36 to 1."@en ;
    obo:IAO_0000116 "The worst health state utility was carried over from 0.1.0 and has not been checked against the paper, so the record rules only warn when a utility falls below it."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Feeny et al. 2002" ;
    dcterms:source "Feeny et al. 2002" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oheo:1000031 ;
            owl:someValuesFrom oheo:0000205 ],
        [ a owl:Restriction ;
            owl:hasValue "general population of Hamilton, Canada" ;
            owl:onProperty oheo:2000012 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000031 ;
            owl:someValuesFrom oheo:0000200 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000010 ;
            owl:someValuesFrom oheo:0000132 ],
        [ a owl:Restriction ;
            owl:hasValue -0.36 ;
            owl:onProperty oheo:2000009 ],
        oheo:0000105 ;
    oheo:9000002 true .

oheo:0000183 a owl:Class ;
    rdfs:label "CHU9D UK value set (Stevens 2012)"@en ;
    obo:IAO_0000115 "A CHU9D value set elicited by standard gamble from a sample of the UK adult general population."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Stevens 2012" ;
    dcterms:source "Stevens K. Valuation of the Child Health Utility 9D Index. Pharmacoeconomics. 2012;30(8):729-47." ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oheo:1000010 ;
            owl:someValuesFrom oheo:0000137 ],
        [ a owl:Restriction ;
            owl:hasValue "UK adult general population" ;
            owl:onProperty oheo:2000012 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000031 ;
            owl:someValuesFrom oheo:0000200 ],
        oheo:0000105 ;
    oheo:9000002 true .

oheo:0000184 a owl:Class ;
    rdfs:label "ICECAP-A UK index values (Flynn 2015)"@en ;
    obo:IAO_0000115 "A capability or care-related index value set of capability index values for ICECAP-A states, elicited by best-worst scaling from a sample of the UK general population, running from no capability (0) to full capability (1)."@en ;
    obo:IAO_0000116 "Values run from 0 (no capability) to 1 (full capability) rather than from dead to full health."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Flynn et al. 2015" ;
    dcterms:source "Flynn TN, Huynh E, Peters TJ, et al. Scoring the ICECAP-A capability instrument. Estimation of a UK general population tariff. Health Econ. 2015;24(3):258-69." ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "UK general population" ;
            owl:onProperty oheo:2000012 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000010 ;
            owl:someValuesFrom oheo:0000139 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000031 ;
            owl:someValuesFrom oheo:0000215 ],
        oheo:0000400 ;
    oheo:9000002 true .

oheo:0000188 a owl:Class ;
    rdfs:label "instrument administration mode"@en ;
    obo:IAO_0000115 "An information content entity that states how an instrument is administered, such as self-completion on paper, electronic self-completion, interview or proxy completion."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Coons et al. 2009; FDA 2009" ;
    oboInOwl:hasExactSynonym "mode of administration"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf obo:IAO_0000030 .

oheo:0000203 a owl:Class ;
    rdfs:label "lead-time time trade-off"@en ;
    obo:IAO_0000115 "A time trade-off in which a period of full health is added before both alternatives, so that states worse than dead can be valued in the same task as states better than dead."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Robinson and Spencer 2006; Devlin et al. 2011" ;
    oboInOwl:hasExactSynonym "LT-TTO"@en,
        "lead-time TTO"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000201 .

oheo:0000206 a owl:Class ;
    rdfs:label "person trade-off"@en ;
    obo:IAO_0000115 "A direct health state valuation process in which the respondent states how many people in one health state they consider equivalent, in social value, to a given number of people in another state."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Nord 1995" ;
    dcterms:source "Nord E. The person-trade-off approach to valuing health care programs. Med Decis Making. 1995;15(3):201-8." ;
    oboInOwl:hasExactSynonym "PTO"@en,
        "equivalence of numbers"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000197 .

oheo:0000208 a owl:Class ;
    rdfs:label "paired comparison"@en ;
    obo:IAO_0000115 "A direct health state valuation process in which the respondent is shown two health states at a time and says which they prefer."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Brazier et al. 2017" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000197 .

oheo:0000209 a owl:Class ;
    rdfs:label "ratio scaling"@en ;
    obo:IAO_0000115 "A direct health state valuation process in which the respondent states how many times better or worse one health state is than another."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Brazier et al. 2017" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000197 .

oheo:0000211 a owl:Class ;
    rdfs:label "discrete choice experiment with duration"@en ;
    obo:IAO_0000115 "A direct health state valuation process that uses discrete choice tasks in which survival duration is an attribute, so that values can be anchored on the scale on which dead is 0."@en ;
    obo:IAO_0000116 "It uses the tasks of a discrete choice experiment; it is classified here by its purpose, valuing health states on the scale on which dead is 0, beside time trade-off and standard gamble."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Bansback et al. 2012" ;
    dcterms:source "Bansback N, Brazier J, Tsuchiya A, Anis A. Using a discrete choice experiment to estimate health state utility values. J Health Econ. 2012;31(1):306-18." ;
    oboInOwl:hasExactSynonym "DCE with duration"@en,
        "DCE-TTO"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000197 .

oheo:0000217 a owl:Class ;
    rdfs:label "monetary valuation process"@en ;
    obo:IAO_0000115 "A preference elicitation process that expresses the value of a health outcome or other non-market good in money."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Drummond et al. 2015" ;
    oboInOwl:hasExactSynonym "monetary valuation"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000194 .

oheo:0000225 a owl:Class ;
    rdfs:label "choice experiment design"@en ;
    obo:IAO_0000115 "A valuation study design that sets out the attributes, levels and choice sets presented in a choice experiment."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Reed Johnson et al. 2013" ;
    oboInOwl:hasExactSynonym "experimental design (choice)"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000223 .

oheo:0000231 a owl:Class ;
    rdfs:label "multinomial logit model"@en ;
    obo:IAO_0000115 "A choice model that assumes identical preferences across respondents and independent, identically distributed extreme value errors."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Train 2009" ;
    oboInOwl:hasExactSynonym "MNL"@en ;
    oboInOwl:hasRelatedSynonym "conditional logit model"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000230 .

oheo:0000244 a owl:Class ;
    rdfs:label "construct validity evaluation"@en ;
    obo:IAO_0000115 "A validity evaluation that assesses the degree to which scores are consistent with hypotheses about relationships with other measures or differences between groups."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Mokkink et al. 2010 (COSMIN)" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000242 .

oheo:0000254 a owl:Class ;
    rdfs:label "standardised response mean"@en ;
    obo:IAO_0000115 "A measurement property estimate of responsiveness equal to the mean change in score divided by the standard deviation of the change."@en ;
    obo:IAO_0000116 "It is also an effect size statistic (STATO effect size estimate); that was a second parent in 0.1.0."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Husted et al. 2000" ;
    oboInOwl:hasExactSynonym "SRM"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000250 .

oheo:0000256 a owl:Class ;
    rdfs:label "test-retest reliability coefficient"@en ;
    obo:IAO_0000115 "A measurement property estimate of test-retest reliability, usually an intraclass correlation coefficient, from repeated measurements in people whose health is stable."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Mokkink et al. 2010 (COSMIN)" ;
    oboInOwl:hasNarrowSynonym "ICC"@en,
        "intraclass correlation coefficient"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000250 .

oheo:0000261 a owl:Class ;
    rdfs:label "QALY estimate"@en ;
    obo:IAO_0000115 "A health-adjusted life year estimate in which each period of time is weighted by the utility of the health state lived in, so that a year in full health counts as one."@en ;
    obo:IAO_0000116 "RHEO's QALY record holds QALYs accrued by a person or group; this estimate is a summary used as a model input or reported as a result."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Drummond et al. 2015" ;
    oboInOwl:hasRelatedSynonym "QALY"@en,
        "quality-adjusted life year"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000260 .

oheo:0000264 a owl:Class ;
    rdfs:label "years of life lost estimate"@en ;
    obo:IAO_0000115 "An economic evaluation estimate of the years of life lost to premature death, calculated against a reference life expectancy at the age of death."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Murray 1994" ;
    oboInOwl:hasRelatedSynonym "YLL"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf rheo:0000011 .

oheo:0000265 a owl:Class ;
    rdfs:label "years lived with disability estimate"@en ;
    obo:IAO_0000115 "An economic evaluation estimate of non-fatal health loss, calculated from the number of cases or prevalence, the duration and a disability weight."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Murray 1994" ;
    oboInOwl:hasRelatedSynonym "YLD"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf rheo:0000011 .

oheo:0000284 a owl:Class ;
    rdfs:label "value of a statistical life year estimate"@en ;
    obo:IAO_0000115 "A monetary valuation estimate of the value of one statistical life year, derived from willingness to pay for reductions in mortality risk."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Drummond et al. 2015" ;
    oboInOwl:hasRelatedSynonym "VOLY"@en,
        "VSLY"@en,
        "value of statistical life year"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000278 .

oheo:0000312 a owl:Class ;
    rdfs:label "SF-6Dv2"@en ;
    obo:IAO_0000115 "A patient-reported outcome measure whose six-dimension health state classification system is derived from SF-36 version 2 responses, revised to reduce the floor effects and level overlap of the original SF-6D."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Brazier et al. 2020" ;
    dcterms:source "Brazier JE, Mulhern BJ, Bjorner JB, et al. Developing a new version of the SF-6D health state classification system from the SF-36v2: SF-6Dv2. Med Care. 2020;58(6):557-65." ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue oheo:0000386 ;
            owl:onProperty oheo:1000035 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000014 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000033 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000048 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000031 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000032 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000030 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000018 ;
            owl:someValuesFrom oheo:0000127 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000034 ;
            owl:someValuesFrom oheo:0000105 ],
        [ a owl:Restriction ;
            owl:hasValue 6 ;
            owl:onProperty oheo:2000002 ],
        oheo:0000083 ;
    oheo:9000002 true .

oheo:0000315 a owl:Class ;
    rdfs:label "ReQoL-20"@en ;
    obo:IAO_0000115 "A patient-reported outcome measure of 20 items measuring recovery-focused quality of life for people with mental health difficulties."@en ;
    obo:IAO_0000116 "Its developers describe it as generic across mental health conditions; OHEO classes it as condition-specific for mental health, like the ReQoL-UI."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Keetharuth et al. 2018" ;
    dcterms:source "Keetharuth et al. 2018" ;
    oboInOwl:hasExactSynonym "Recovering Quality of Life-20"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "past week" ;
            owl:onProperty oheo:2000005 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000033 ],
        [ a owl:Restriction ;
            owl:hasValue oheo:0000388 ;
            owl:onProperty oheo:1000035 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000026 ],
        [ a owl:Restriction ;
            owl:hasValue "higher is better" ;
            owl:onProperty oheo:2000008 ],
        [ a owl:Restriction ;
            owl:hasValue oheo:0000387 ;
            owl:onProperty oheo:1000035 ],
        [ a owl:Restriction ;
            owl:hasValue 20 ;
            owl:onProperty oheo:2000001 ],
        oheo:0000083 ;
    oheo:9000002 true .

oheo:0000317 a owl:Class ;
    rdfs:label "WEMWBS"@en ;
    obo:IAO_0000115 "A mental wellbeing patient-reported outcome measure of 14 positively worded items about thoughts and feelings over the last two weeks, scored from 14 to 70."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Tennant et al. 2007" ;
    dcterms:source "Tennant R, Hiller L, Fishwick R, et al. The Warwick-Edinburgh Mental Well-being Scale (WEMWBS): development and UK validation. Health Qual Life Outcomes. 2007;5:63." ;
    oboInOwl:hasExactSynonym "Warwick-Edinburgh Mental Wellbeing Scale"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000049 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000033 ],
        [ a owl:Restriction ;
            owl:hasValue 14.0 ;
            owl:onProperty oheo:2000006 ],
        [ a owl:Restriction ;
            owl:hasValue 14 ;
            owl:onProperty oheo:2000001 ],
        [ a owl:Restriction ;
            owl:hasValue 70.0 ;
            owl:onProperty oheo:2000007 ],
        [ a owl:Restriction ;
            owl:hasValue oheo:0000386 ;
            owl:onProperty oheo:1000035 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000049 ],
        [ a owl:Restriction ;
            owl:hasValue "higher is better" ;
            owl:onProperty oheo:2000008 ],
        [ a owl:Restriction ;
            owl:hasValue "past 2 weeks" ;
            owl:onProperty oheo:2000005 ],
        oheo:0000083 ;
    oheo:9000002 true .

oheo:0000322 a owl:Class ;
    rdfs:label "PedsQL 4.0 Generic Core Scales"@en ;
    obo:IAO_0000115 "A generic paediatric health profile instrument of 23 items in four scales (physical, emotional, social and school functioning), with child self-report and parent proxy-report forms, scored from 0 to 100."@en ;
    obo:IAO_0000116 "The PedsQL 4.0 Generic Core Scales have child self-report and parent proxy-report forms, so the instrument sits directly under outcome measurement instrument and each version records its reporter with 'has reporter type' (0.2.0 fix pass). The reporter-type classes are disjoint, so a version cannot be both self-reported and proxy-reported."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Varni et al. 2001" ;
    dcterms:source "Varni JW, Seid M, Kurtin PS. PedsQL 4.0: reliability and validity of the Pediatric Quality of Life Inventory version 4.0 generic core scales in healthy and patient populations. Med Care. 2001;39(8):800-12." ;
    oboInOwl:hasBroadSynonym "Pediatric Quality of Life Inventory"@en,
        "PedsQL"@en ;
    oboInOwl:hasDbXref "NCIT:C121522" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "higher is better" ;
            owl:onProperty oheo:2000008 ],
        [ a owl:Restriction ;
            owl:hasValue 4 ;
            owl:onProperty oheo:2000002 ],
        [ a owl:Restriction ;
            owl:hasValue oheo:0000388 ;
            owl:onProperty oheo:1000035 ],
        [ a owl:Restriction ;
            owl:hasValue oheo:0000386 ;
            owl:onProperty oheo:1000035 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000048 ],
        [ a owl:Restriction ;
            owl:hasValue 23 ;
            owl:onProperty oheo:2000001 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000031 ],
        [ a owl:Restriction ;
            owl:hasValue 0.0 ;
            owl:onProperty oheo:2000006 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000033 ],
        [ a owl:Restriction ;
            owl:hasValue "children and adolescents (2 to 18 years)" ;
            owl:onProperty oheo:2000011 ],
        [ a owl:Restriction ;
            owl:hasValue 100.0 ;
            owl:onProperty oheo:2000007 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000030 ],
        oheo:0000082 ;
    oheo:9000002 true .

oheo:0000325 a owl:Class ;
    rdfs:label "COPD Assessment Test"@en ;
    obo:IAO_0000115 "A COPD-specific patient-reported outcome measure of eight items on the impact of the disease, scored from 0 to 40."@en ;
    obo:IAO_0000116 "Reports a single total score, so it is not classed as a health profile instrument (0.2.0 fix pass)."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Jones et al. 2009" ;
    dcterms:source "Jones PW, Harding G, Berry P, et al. Development and first validation of the COPD Assessment Test. Eur Respir J. 2009;34(3):648-54." ;
    oboInOwl:hasDbXref "NCIT:C125756" ;
    oboInOwl:hasExactSynonym "CAT"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue "higher is worse" ;
            owl:onProperty oheo:2000008 ],
        [ a owl:Restriction ;
            owl:hasValue oheo:0000387 ;
            owl:onProperty oheo:1000035 ],
        [ a owl:Restriction ;
            owl:hasValue 0.0 ;
            owl:onProperty oheo:2000006 ],
        [ a owl:Restriction ;
            owl:hasValue 8 ;
            owl:onProperty oheo:2000001 ],
        [ a owl:Restriction ;
            owl:hasValue 40.0 ;
            owl:onProperty oheo:2000007 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000027 ],
        oheo:0000083 ;
    oheo:9000002 true .

oheo:1000013 a owl:ObjectProperty ;
    rdfs:label "obtained with instrument version"@en ;
    obo:IAO_0000115 "Relates an outcome measurement datum, a RHEO state observation, a RHEO utility measurement record or a measurement property estimate to the instrument version used to obtain it. The value is an instance of a named instrument class, such as one language and format version of the EQ-5D-5L; its class identifies the instrument."@en ;
    obo:IAO_0000116 "RHEO's text field 'has instrument version' (RHEO_2000077) holds what EuroQol calls a version, such as 3L or 5L; OHEO models those as named instruments (EQ-5D-3L, EQ-5D-5L). OHEO's instrument version is one copy of a named instrument, such as one language and format version. The record rules accept RHEO text that names the instrument, its family, or the copy's version label."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000118 "obtained with instrument"@en ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:range oheo:0000082 .

obo:IAO_0000122 a owl:NamedIndividual ;
    rdfs:label "ready for release"@en .

obo:STATO_0000085 a owl:Class ;
    rdfs:label "effect size estimate"@en ;
    obo:IAO_0000115 "effect size estimate is a data item about the direction and strength of the consequences of a causative agent as explored by statistical methods. Those methods produce estimates of the effect size, e.g. confidence interval"@en ;
    obo:IAO_0000119 "STATO (http://purl.obolibrary.org/obo/stato.owl)" ;
    obo:IAO_0000412 obo:stato.owl ;
    rdfs:isDefinedBy obo:stato.owl ;
    rdfs:subClassOf obo:STATO_0000471 .

obo:STATO_0000184 a owl:Class ;
    rdfs:label "ratio"@en ;
    obo:IAO_0000115 "A ratio is a data item which is formed with two numbers r and s is written r/s, where r is the numerator and s is the denominator. The ratio of r to s is equivalent to the quotient r/s."@en ;
    obo:IAO_0000119 "STATO (http://purl.obolibrary.org/obo/stato.owl)" ;
    obo:IAO_0000412 obo:stato.owl ;
    rdfs:isDefinedBy obo:stato.owl ;
    rdfs:subClassOf obo:STATO_0000039 .

oboInOwl:hasNarrowSynonym a owl:AnnotationProperty ;
    rdfs:label "has_narrow_synonym"@en .

oheo:0000008 a owl:Class ;
    rdfs:label "cardiac outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the physiological or clinical outcome area, covering outcomes associated with the cardiac system or condition group, such as myocardial infarction, heart failure or arrhythmia."@en ;
    obo:IAO_0000116 "Physiological domains follow MedDRA System Organ Classes, as in the COMET taxonomy."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    oboInOwl:hasExactSynonym "Cardiac outcomes"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000003 ;
    oheo:9000001 3 .

oheo:0000022 a owl:Class ;
    rdfs:label "nervous system outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the physiological or clinical outcome area, covering outcomes associated with the nervous system system or condition group, such as stroke, seizures or neuropathy."@en ;
    obo:IAO_0000116 "Physiological domains follow MedDRA System Organ Classes, as in the COMET taxonomy."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    oboInOwl:hasExactSynonym "Nervous system outcomes"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000003 ;
    oheo:9000001 17 .

oheo:0000027 a owl:Class ;
    rdfs:label "respiratory, thoracic and mediastinal outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the physiological or clinical outcome area, covering outcomes associated with the respiratory, thoracic and mediastinal system or condition group, such as lung function, exacerbations or breathlessness."@en ;
    obo:IAO_0000116 "Physiological domains follow MedDRA System Organ Classes, as in the COMET taxonomy."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    oboInOwl:hasExactSynonym "Respiratory, thoracic and mediastinal outcomes"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000003 ;
    oheo:9000001 22 .

oheo:0000050 a owl:Class ;
    rdfs:label "symptom outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the physiological or clinical outcome area, covering symptoms a person experiences, such as pain, fatigue or breathlessness, considered across body systems."@en ;
    obo:IAO_0000116 "An OHEO extension of the COMET outcome taxonomy (Dodd et al. 2018), not one of its 38 domains."@en,
        "OHEO extension below the COMET taxonomy, added for health economic use. COMET classifies a named symptom under its body system; this grouping supports symptom burden and symptom-free survival outcomes."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000003 .

oheo:0000068 a owl:Class ;
    rdfs:label "response outcome specification"@en ;
    obo:IAO_0000115 "An outcome specification whose variable is whether a person meets stated criteria for response to treatment, summarised as the proportion of people who respond."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    oboInOwl:hasExactSynonym "response endpoint"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000053 .

oheo:0000085 a owl:Class ;
    rdfs:label "observer-reported outcome measure"@en ;
    obo:IAO_0000115 "An outcome measurement instrument completed by someone other than the patient or a health professional, such as a parent or carer, reporting signs or behaviours they can observe."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from FDA-NIH Biomarker Working Group 2016 (BEST Resource)" ;
    oboInOwl:hasDbXref "NCIT:C142620" ;
    oboInOwl:hasExactSynonym "ObsRO"@en ;
    oboInOwl:hasRelatedSynonym "proxy-reported outcome measure"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000082 .

oheo:0000106 a owl:Class ;
    rdfs:label "preference weight"@en ;
    obo:IAO_0000115 "An information content entity that is a number in a value set giving the change in utility associated with one level of one dimension, or with an interaction between levels."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Brazier et al. 2017" ;
    oboInOwl:hasExactSynonym "dimension level weight"@en,
        "value set coefficient"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf obo:IAO_0000030 .

oheo:0000108 a owl:Class ;
    rdfs:label "crosswalk"@en ;
    obo:IAO_0000115 "A mapping function that converts responses or values on one instrument to values on another instrument of the same family, such as EQ-5D-5L to EQ-5D-3L."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "van Hout et al. 2012" ;
    oboInOwl:hasExactSynonym "instrument crosswalk"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000107 .

oheo:0000129 a owl:Class ;
    rdfs:label "SF-6D"@en ;
    obo:IAO_0000115 "A patient-reported outcome measure whose six-dimension health state classification system is derived from SF-36 or SF-12 responses, defining 18,000 health states in its original version."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Brazier et al. 2002" ;
    dcterms:source "Brazier J, Roberts J, Deverill M. The estimation of a preference-based measure of health from the SF-36. J Health Econ. 2002;21(2):271-92." ;
    oboInOwl:hasExactSynonym "SF6D"@en,
        "Short Form 6D"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue 18000 ;
            owl:onProperty oheo:2000004 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000034 ;
            owl:someValuesFrom oheo:0000180 ],
        [ a owl:Restriction ;
            owl:hasValue 6 ;
            owl:onProperty oheo:2000002 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000032 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000018 ;
            owl:someValuesFrom oheo:0000127 ],
        [ a owl:Restriction ;
            owl:hasValue oheo:0000386 ;
            owl:onProperty oheo:1000035 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000031 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000014 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000048 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000033 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000030 ],
        oheo:0000083 ;
    oheo:9000002 true .

oheo:0000134 a owl:Class ;
    rdfs:label "AQoL"@en ;
    obo:IAO_0000115 "A patient-reported outcome measure of the Assessment of Quality of Life family of Australian multi-attribute utility instruments, from AQoL-4D to AQoL-8D."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Richardson et al. 2014" ;
    oboInOwl:hasExactSynonym "Assessment of Quality of Life"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue oheo:0000386 ;
            owl:onProperty oheo:1000035 ],
        oheo:0000083 ;
    oheo:9000002 true .

oheo:0000136 a owl:Class ;
    rdfs:label "Quality of Well-Being Scale"@en ;
    obo:IAO_0000115 "A generic preference-based patient-reported outcome measure that combines mobility, physical activity, social activity and symptoms into a single index of well-being."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Kaplan and Anderson 1988" ;
    dcterms:source "Kaplan RM, Anderson JP. A general health policy model: update and applications. Health Serv Res. 1988;23(2):203-35." ;
    oboInOwl:hasExactSynonym "QWB"@en ;
    oboInOwl:hasNarrowSynonym "QWB-SA"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oheo:1000034 ;
            owl:someValuesFrom oheo:0000105 ],
        [ a owl:Restriction ;
            owl:hasValue oheo:0000386 ;
            owl:onProperty oheo:1000035 ],
        oheo:0000083 ;
    oheo:9000002 true .

oheo:0000174 a owl:Class ;
    rdfs:label "EQ-5D-3L value set"@en ;
    obo:IAO_0000115 "A value set that assigns a utility to each of the 243 EQ-5D-3L health states."@en ;
    obo:IAO_0000116 "A kind of value set, not one value set: each value set for this instrument is a subclass."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Devlin and Brooks 2017" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oheo:1000010 ;
            owl:someValuesFrom oheo:0000123 ],
        oheo:0000105 .

oheo:0000196 a owl:Class ;
    rdfs:label "health state valuation process"@en ;
    obo:IAO_0000115 "A preference elicitation process that obtains values or orderings for health states, from which utilities on a scale on which full health is 1 and dead is 0 are taken directly or estimated by modelling."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Brazier et al. 2017" ;
    oboInOwl:hasExactSynonym "health state valuation"@en ;
    oboInOwl:hasRelatedSynonym "utility elicitation"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000194 .

oheo:0000215 a owl:Class ;
    rdfs:label "best-worst scaling"@en ;
    obo:IAO_0000115 "A stated preference elicitation process in which respondents choose the best and the worst item, attribute level or profile in each set presented."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Flynn et al. 2007" ;
    oboInOwl:hasExactSynonym "BWS"@en ;
    oboInOwl:hasNarrowSynonym "MaxDiff"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000195 .

oheo:0000218 a owl:Class ;
    rdfs:label "contingent valuation"@en ;
    obo:IAO_0000115 "A monetary valuation process in which respondents state, in a described hypothetical market, the most they would pay for a benefit or the least they would accept as compensation for a loss, a stated preference task."@en ;
    obo:IAO_0000116 "Contingent valuation is a stated preference method; that was a second parent in 0.1.0 and is now carried by the definition."@en,
        "Open to anchoring bias from starting bids and payment card ranges."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Drummond et al. 2015" ;
    oboInOwl:hasExactSynonym "CVM"@en,
        "contingent valuation method"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000217 .

oheo:0000223 a owl:Class ;
    rdfs:label "valuation study design"@en ;
    obo:IAO_0000115 "A study design for a preference elicitation study, stating the states or alternatives to be valued, the elicitation tasks, the sample and the analysis."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    oboInOwl:hasExactSynonym "valuation protocol"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf obo:OBI_0500000 .

oheo:0000230 a owl:Class ;
    rdfs:label "choice model"@en ;
    obo:IAO_0000115 "A statistical model that relates the probability of choosing an alternative to its attributes under a random utility framework."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Train 2009" ;
    oboInOwl:hasExactSynonym "discrete choice model"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf obo:STATO_0000107 .

oheo:0000238 a owl:Class ;
    rdfs:label "reliability evaluation"@en ;
    obo:IAO_0000115 "A measurement property evaluation that assesses the degree to which scores for people who have not changed are the same for repeated measurement."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Mokkink et al. 2010 (COSMIN)" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000237 .

oheo:0000242 a owl:Class ;
    rdfs:label "validity evaluation"@en ;
    obo:IAO_0000115 "A measurement property evaluation that assesses the degree to which an instrument measures the construct it claims to measure."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Mokkink et al. 2010 (COSMIN)" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000237 .

oheo:0000269 a owl:Class ;
    rdfs:label "QALY shortfall estimate"@en ;
    obo:IAO_0000115 "An economic evaluation estimate of the future QALYs that people with a condition are expected to lose compared with people of the same age and sex without it, under current care."@en ;
    obo:IAO_0000116 "NICE uses absolute and proportional shortfall to apply its severity modifier."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "NICE 2022 (PMG36)" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf rheo:0000011 .

oheo:0000277 a owl:Class ;
    rdfs:label "choice model estimate"@en ;
    obo:IAO_0000115 "An economic evaluation estimate of a preference parameter, or a quantity derived from preference parameters, obtained by fitting a choice model to stated or revealed choices."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Train 2009" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf rheo:0000011 .

oheo:0000286 a owl:Class ;
    rdfs:label "health expectancy calculation process"@en ;
    obo:IAO_0000115 "A planned process in which a health expectancy is calculated by combining mortality data with data on the prevalence or incidence of health states."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Robine et al. 2003" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf obo:COB_0000082 .

oheo:0000290 a owl:Class ;
    rdfs:label "Q-TWiST health state"@en ;
    obo:IAO_0000115 "A health state description of one of the three periods into which Q-TWiST analysis partitions survival."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Glasziou et al. 1990" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf rheo:0000021 .

oheo:0000295 a owl:Class ;
    rdfs:label "life-years gained estimate"@en ;
    obo:IAO_0000115 "An economic evaluation estimate of the difference in expected years of life between an intervention and its comparator, without adjustment for quality of life."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Drummond et al. 2015" ;
    oboInOwl:hasRelatedSynonym "LY"@en,
        "LYG"@en,
        "life-years gained"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf rheo:0000011 .

oheo:1000039 a owl:ObjectProperty ;
    rdfs:label "has published index value set"@en ;
    obo:IAO_0000115 "Relates an outcome measurement instrument to a capability or care-related index value set published for its descriptive system. Such an instrument is not thereby a preference-based measure."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain oheo:0000082 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:range oheo:0000400 .

oheo:2000010 a owl:DatatypeProperty ;
    rdfs:label "has licence holder"@en ;
    obo:IAO_0000115 "The organisation that holds the licence for use of an instrument."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:range xsd:string .

oheo:2000014 a owl:DatatypeProperty ;
    rdfs:label "has aggregation method"@en ;
    obo:IAO_0000115 "The summary used to aggregate an outcome across people, such as mean, median, proportion or hazard ratio."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:range xsd:string .

oheo:0000034 a owl:Class ;
    rdfs:label "cognitive functioning outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the life impact outcome area, covering a person's mental processes, such as memory, attention, concentration and problem solving."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    oboInOwl:hasExactSynonym "Cognitive functioning"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000004 ;
    oheo:9000001 29 .

oheo:0000090 a owl:Class ;
    rdfs:label "preference-based measure"@en ;
    obo:IAO_0000115 "An outcome measurement instrument for which at least one value set has been published, so that each health state its descriptive system describes can be given a utility on a scale on which full health is 1 and dead is 0. The utilities belong to the value set, not to the instrument."@en ;
    obo:IAO_0000116 "Defined class (0.2.0): an instrument is classified here by the reasoner when it has a published value set. The basis of indirect utility assessment for QALYs. A preference-based measure and its value set are different things: the instrument describes a health state, the value set values it."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Brazier et al. 2017" ;
    dcterms:source "Brazier J, Ratcliffe J, Salomon JA, Tsuchiya A. Measuring and Valuing Health Benefits for Economic Evaluation. 2nd ed. Oxford: Oxford University Press; 2017." ;
    oboInOwl:hasExactSynonym "MAUI"@en,
        "multi-attribute utility instrument"@en,
        "preference-based instrument"@en,
        "utility instrument"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oheo:1000008 ;
            owl:someValuesFrom oheo:0000099 ],
        oheo:0000082 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( oheo:0000082 [ a owl:Restriction ;
                        owl:onProperty oheo:1000034 ;
                        owl:someValuesFrom oheo:0000105 ] ) ] .

oheo:0000102 a owl:Class ;
    rdfs:label "utility function"@en ;
    obo:IAO_0000115 "An information content entity that represents preferences over health states or health outcomes by assigning a number to each, so that more preferred states have higher numbers."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Drummond et al. 2015" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf obo:IAO_0000030 .

oheo:0000117 a owl:Class ;
    rdfs:label "tumour response category"@en ;
    obo:IAO_0000115 "A state description that classifies a person's tumour response at an assessment under stated response criteria."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Eisenhauer et al. 2009" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf rheo:0000064 .

oheo:0000130 a owl:Class ;
    rdfs:label "Health Utilities Index"@en ;
    obo:IAO_0000115 "An outcome measurement instrument of the Health Utilities Index family developed at McMaster University, comprising the HUI2 and HUI3 classification systems."@en ;
    obo:IAO_0000116 "The family also includes HUI1 (Torrance 1982), which OHEO does not yet model."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Torrance et al. 1996" ;
    oboInOwl:hasDbXref "NCIT:C156124" ;
    oboInOwl:hasExactSynonym "HUI"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue oheo:0000386 ;
            owl:onProperty oheo:1000035 ],
        oheo:0000082 ;
    oheo:9000002 true .

oheo:0000189 a owl:Class ;
    rdfs:label "outcome measurement datum"@en ;
    obo:IAO_0000115 "A measurement datum recording the value of an outcome for one person at a stated time, obtained with a stated instrument version or under stated criteria. A health state profile is recorded instead as a RHEO state observation, and a utility as a RHEO utility measurement record."@en ;
    obo:IAO_0000116 "An OHEO modelling term; its definition source is editorial by design."@en,
        "Instrument scores name their instrument version (instrument score record); tumour response and adverse event records name their classification criteria; a time-to-event record needs neither (0.2.0 fix pass)."@en,
        "Records concern one person. Summaries across people are estimates. OHEO declares this class disjoint from the RHEO state observation, utility measurement record, QALY record and DALY record, so that each record has one type where the two ontologies are used together."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    oboInOwl:hasExactSynonym "outcome record"@en ;
    oboInOwl:hasRelatedSynonym "individual outcome value"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf obo:IAO_0000109 ;
    owl:disjointWith rheo:0000066,
        rheo:0000090,
        rheo:0000092,
        rheo:0000094 .

oheo:0000205 a owl:Class ;
    rdfs:label "visual analogue scale rating"@en ;
    obo:IAO_0000115 "A direct health state valuation process in which the respondent marks the position of a health state on a line anchored by best and worst imaginable health."@en ;
    obo:IAO_0000116 "A rating, not a choice: VAS values are not utilities without transformation."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Brazier et al. 2017" ;
    oboInOwl:hasRelatedSynonym "VAS"@en,
        "rating scale"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000197 .

oheo:0000272 a owl:Class ;
    rdfs:label "health expectancy estimate"@en ;
    obo:IAO_0000115 "An economic evaluation estimate of the average number of years a person of a given age can expect to live in a stated state of health."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Robine et al. 2003" ;
    oboInOwl:hasRelatedSynonym "health expectancy"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf rheo:0000011 .

oheo:1000011 a owl:ObjectProperty ;
    rdfs:label "maps from instrument"@en ;
    obo:IAO_0000115 "Relates a mapping function to the instrument whose responses or scores it takes as input."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain oheo:0000107 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:range oheo:0000082 .

oheo:1000016 a owl:ObjectProperty ;
    rdfs:label "uses classification criteria"@en ;
    obo:IAO_0000115 "Relates an outcome specification or outcome measurement datum to the outcome classification criteria used to assign outcome categories."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:range oheo:0000114 .

oheo:0000005 a owl:Class ;
    rdfs:label "resource use outcome area"@en ;
    obo:IAO_0000115 "An outcome domain grouping outcomes that concern the use of health, social care and societal resources, including economic, hospital, further intervention and carer burden outcomes."@en ;
    obo:IAO_0000116 "One of the five core areas of the COMET outcome taxonomy."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000001 .

oheo:0000020 a owl:Class ;
    rdfs:label "musculoskeletal and connective tissue outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the physiological or clinical outcome area, covering outcomes associated with the musculoskeletal and connective tissue system or condition group, such as joint pain, stiffness or bone density."@en ;
    obo:IAO_0000116 "Physiological domains follow MedDRA System Organ Classes, as in the COMET taxonomy."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    oboInOwl:hasExactSynonym "Musculoskeletal and connective tissue outcomes"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000003 ;
    oheo:9000001 15 .

oheo:0000045 a owl:Class ;
    rdfs:label "activities of daily living outcome domain"@en ;
    obo:IAO_0000115 "A physical functioning outcome domain covering basic self-care tasks, such as bathing, dressing, toileting, transferring and eating."@en ;
    obo:IAO_0000116 "OHEO extension below the COMET taxonomy, added for health economic use."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Katz et al. 1963" ;
    oboInOwl:hasRelatedSynonym "ADL"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000030 .

oheo:0000080 a owl:Class ;
    rdfs:label "core outcome set"@en ;
    obo:IAO_0000115 "An information content entity that is an agreed, standardised set of outcomes that should be measured and reported, as a minimum, in all clinical trials in a specific area of health or health care."@en ;
    obo:IAO_0000116 "Link outcomes with 'includes outcome' and recommended instruments with 'recommends instrument'."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Williamson et al. 2017 (COMET Handbook)" ;
    dcterms:source "Williamson PR, Altman DG, Bagley H, et al. The COMET Handbook: version 1.0. Trials. 2017;18(Suppl 3):280." ;
    oboInOwl:hasExactSynonym "COS"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf obo:IAO_0000030 .

oheo:0000086 a owl:Class ;
    rdfs:label "performance outcome measure"@en ;
    obo:IAO_0000115 "An outcome measurement instrument in which the patient performs a defined task according to instructions and the performance is measured, such as distance walked in a set time."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from FDA-NIH Biomarker Working Group 2016 (BEST Resource)" ;
    oboInOwl:hasDbXref "NCIT:C142632" ;
    oboInOwl:hasExactSynonym "PerfO"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000082 .

oheo:0000107 a owl:Class ;
    rdfs:label "mapping function"@en ;
    obo:IAO_0000115 "An algorithm that predicts a score on a target instrument, usually a utility, from responses or scores on a source instrument, estimated from data in which both were collected."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Wailoo et al. 2017" ;
    dcterms:source "Wailoo AJ, Hernandez-Alava M, Manca A, et al. Mapping to estimate health-state utility from non-preference-based outcome measures: an ISPOR Good Practices for Outcomes Research Task Force report. Value Health. 2017;20(1):18-27." ;
    oboInOwl:hasExactSynonym "mapping algorithm"@en ;
    oboInOwl:hasNarrowSynonym "transfer-to-utility function"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oheo:1000012 ;
            owl:someValuesFrom oheo:0000082 ],
        obo:IAO_0000064 .

oheo:0000122 a owl:Class ;
    rdfs:label "EQ-5D"@en ;
    obo:IAO_0000115 "An outcome measurement instrument of the EuroQol EQ-5D family, whose members describe health on five dimensions (mobility, self-care, usual activities, pain or discomfort and anxiety or depression) and include a visual analogue scale for self-rated health."@en ;
    obo:IAO_0000116 "NICE prefers the EQ-5D in adults (PMG36, 2022) and, for topics started on or after 27 August 2026, the EQ-5D-5L with the UK EQ-5D-5L value set (PMG51). NICE recommends no specific measure for children and young people (PMG51 1.7)."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "EuroQol Group 1990" ;
    dcterms:source "EuroQol Group. EuroQol: a new facility for the measurement of health-related quality of life. Health Policy. 1990;16(3):199-208." ;
    oboInOwl:hasExactSynonym "EQ5D"@en,
        "EuroQol 5D"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000033 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000032 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000030 ],
        [ a owl:Restriction ;
            owl:hasValue "higher is better" ;
            owl:onProperty oheo:2000008 ],
        [ a owl:Restriction ;
            owl:hasValue "today" ;
            owl:onProperty oheo:2000005 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000048 ],
        [ a owl:Restriction ;
            owl:hasValue oheo:0000386 ;
            owl:onProperty oheo:1000035 ],
        [ a owl:Restriction ;
            owl:hasValue "EuroQol Research Foundation" ;
            owl:onProperty oheo:2000010 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000014 ],
        [ a owl:Restriction ;
            owl:hasValue 5 ;
            owl:onProperty oheo:2000002 ],
        oheo:0000082 ;
    oheo:9000002 true .

oheo:0000127 a owl:Class ;
    rdfs:label "SF-36"@en ;
    obo:IAO_0000115 "A patient-reported outcome measure of 36 items scored on eight scales, from physical functioning to mental health, summarised as physical and mental component scores."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Ware and Sherbourne 1992" ;
    dcterms:source "Ware JE Jr, Sherbourne CD. The MOS 36-item short-form health survey (SF-36). I. Conceptual framework and item selection. Med Care. 1992;30(6):473-83." ;
    oboInOwl:hasDbXref "NCIT:C20078" ;
    oboInOwl:hasExactSynonym "MOS SF-36"@en,
        "Short Form 36"@en ;
    oboInOwl:hasRelatedSynonym "RAND-36"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000048 ],
        [ a owl:Restriction ;
            owl:hasValue 8 ;
            owl:onProperty oheo:2000002 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000036 ],
        [ a owl:Restriction ;
            owl:hasValue oheo:0000386 ;
            owl:onProperty oheo:1000035 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000033 ],
        [ a owl:Restriction ;
            owl:hasValue 36 ;
            owl:onProperty oheo:2000001 ],
        [ a owl:Restriction ;
            owl:hasValue 100.0 ;
            owl:onProperty oheo:2000007 ],
        [ a owl:Restriction ;
            owl:hasValue "higher is better" ;
            owl:onProperty oheo:2000008 ],
        [ a owl:Restriction ;
            owl:hasValue 0.0 ;
            owl:onProperty oheo:2000006 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000031 ],
        [ a owl:Restriction ;
            owl:hasValue "past 4 weeks" ;
            owl:onProperty oheo:2000005 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000030 ],
        [ a owl:Restriction ;
            owl:hasValue oheo:0000388 ;
            owl:onProperty oheo:1000035 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000001 ;
            owl:someValuesFrom oheo:0000032 ],
        oheo:0000083 ;
    oheo:9000002 true .

oheo:0000194 a owl:Class ;
    rdfs:label "preference elicitation process"@en ;
    obo:IAO_0000115 "A planned process in which people's preferences between outcomes, health states or attributes are obtained and quantified."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Brazier et al. 2017" ;
    oboInOwl:hasExactSynonym "preference measurement"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf obo:COB_0000082 .

oheo:0000195 a owl:Class ;
    rdfs:label "stated preference elicitation process"@en ;
    obo:IAO_0000115 "A preference elicitation process in which respondents state their preferences in answer to hypothetical questions, rather than revealing them through actual choices."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Brazier et al. 2017" ;
    oboInOwl:hasExactSynonym "stated preference method"@en ;
    oboInOwl:hasRelatedSynonym "SP"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000194 .

oheo:0000237 a owl:Class ;
    rdfs:label "measurement property evaluation"@en ;
    obo:IAO_0000115 "An investigation that assesses a measurement property of an outcome measurement instrument in a stated population and context of use."@en ;
    obo:IAO_0000116 "Subclasses follow the COSMIN taxonomy of reliability, validity and responsiveness, plus interpretability."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Mokkink et al. 2010 (COSMIN)" ;
    dcterms:source "Mokkink LB, Terwee CB, Patrick DL, et al. The COSMIN study reached international consensus on taxonomy, terminology, and definitions of measurement properties for health-related patient-reported outcomes. J Clin Epidemiol. 2010;63(7):737-45." ;
    oboInOwl:hasExactSynonym "psychometric evaluation"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf obo:OBI_0000066 .

oheo:0000251 a owl:Class ;
    rdfs:label "minimal important difference estimate"@en ;
    obo:IAO_0000115 "A measurement property estimate of the smallest change in an instrument score that patients perceive as important."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Jaeschke et al. 1989" ;
    dcterms:source "Jaeschke R, Singer J, Guyatt GH. Measurement of health status. Ascertaining the minimal clinically important difference. Control Clin Trials. 1989;10(4):407-15." ;
    oboInOwl:hasRelatedSynonym "MCID"@en,
        "MID"@en,
        "minimal clinically important difference"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000250 .

oheo:0000278 a owl:Class ;
    rdfs:label "monetary valuation estimate"@en ;
    obo:IAO_0000115 "An economic evaluation estimate that expresses the value of a health outcome or a change in risk in money, obtained from stated or revealed preferences."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Drummond et al. 2015" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf rheo:0000011 .

oheo:0000400 a owl:Class ;
    rdfs:label "capability or care-related index value set"@en ;
    obo:IAO_0000115 "A utility function that assigns an index value to every state of a capability or care-related descriptive system, anchored at the worst and best states of that system rather than at dead and full health, so its values cannot weight time in QALYs."@en ;
    obo:IAO_0000116 "Sibling of value set (0.2.0 fix pass). ICECAP index values run from no capability (0) to full capability (1) (Flynn et al. 2015); CarerQol weights are not anchored on dead either (Hoefman et al. 2014). ASCOT preference weights are anchored on dead (Netten et al. 2012) and stay under value set. A QALY record may not rest on these values."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Flynn et al. 2015; Hoefman et al. 2014" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000102 ;
    owl:disjointWith oheo:0000105 .

oheo:1000012 a owl:ObjectProperty ;
    rdfs:label "maps to instrument"@en ;
    obo:IAO_0000115 "Relates a mapping function to the instrument whose score or utility it predicts."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain oheo:0000107 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:range oheo:0000082 .

oheo:2000011 a owl:DatatypeProperty ;
    rdfs:label "has intended age range"@en ;
    obo:IAO_0000115 "The age range of the people for whom an instrument is intended."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:range xsd:string .

oheo:0000032 a owl:Class ;
    rdfs:label "role functioning outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the life impact outcome area, covering a person's ability to carry out roles such as paid work, study, household tasks and caring."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    oboInOwl:hasExactSynonym "Role functioning"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000004 ;
    oheo:9000001 27 .

oheo:0000109 a owl:Class ;
    rdfs:label "measurement scale type"@en ;
    obo:IAO_0000115 "An information content entity that classifies a score by which comparisons and arithmetic operations on its values are meaningful."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Stevens 1946" ;
    dcterms:source "Stevens SS. On the theory of scales of measurement. Science. 1946;103(2684):677-80." ;
    oboInOwl:hasExactSynonym "level of measurement"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf obo:IAO_0000030 .

oheo:0000200 a owl:Class ;
    rdfs:label "standard gamble"@en ;
    obo:IAO_0000115 "A direct health state valuation process in which the respondent chooses between a health state for certain and a gamble between full health and death, and the probability of full health is varied until they are indifferent."@en ;
    obo:IAO_0000116 "The utility of the state equals the probability of full health at indifference. Grounded in expected utility theory; responses can include risk attitude."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Brazier et al. 2017" ;
    oboInOwl:hasExactSynonym "SG"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000197 .

oheo:0000250 a owl:Class ;
    rdfs:label "measurement property estimate"@en ;
    obo:IAO_0000115 "An estimate that quantifies a measurement property or an interpretability characteristic of an outcome measurement instrument in a stated population."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Mokkink et al. 2010 (COSMIN)" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf obo:STATO_0000471 .

obo:IAO_0000125 a owl:NamedIndividual ;
    rdfs:label "pending final vetting"@en .

oheo:0000031 a owl:Class ;
    rdfs:label "social functioning outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the life impact outcome area, covering a person's ability to take part in social relationships and social activities."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    oboInOwl:hasExactSynonym "Social functioning"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000004 ;
    oheo:9000001 26 .

oheo:0000043 a owl:Class ;
    rdfs:label "mortality or survival outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the death outcome area, covering overall and cause-specific mortality and survival, and composite survival outcomes that include death."@en ;
    obo:IAO_0000116 "Composite outcomes that include death, such as disease-free survival, are classified both here and in the physiological domain of the disease concerned (Dodd et al. 2018)."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    oboInOwl:hasExactSynonym "Mortality/survival"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000002 ;
    oheo:9000001 1 .

oheo:0000060 a owl:Class ;
    rdfs:label "time-to-event outcome specification"@en ;
    obo:IAO_0000115 "An outcome specification whose variable is the time from a stated origin to the first occurrence of a stated event, with rules for censoring people in whom the event is not observed."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    oboInOwl:hasExactSynonym "event-time outcome"@en,
        "survival endpoint"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000053 .

oheo:0000084 a owl:Class ;
    rdfs:label "clinician-reported outcome measure"@en ;
    obo:IAO_0000115 "An outcome measurement instrument completed by a trained health professional who uses clinical judgement to rate observable signs, behaviours or manifestations of a condition."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from FDA-NIH Biomarker Working Group 2016 (BEST Resource)" ;
    oboInOwl:hasDbXref "NCIT:C142453" ;
    oboInOwl:hasExactSynonym "ClinRO"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000082 .

oheo:0000214 a owl:Class ;
    rdfs:label "discrete choice experiment"@en ;
    obo:IAO_0000115 "A choice experiment in which respondents complete repeated choice tasks, each choosing one alternative from a choice set described by attributes and levels."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Bridges et al. 2011" ;
    dcterms:source "Bridges JF, Hauber AB, Marshall D, et al. Conjoint analysis applications in health: a checklist. A report of the ISPOR Good Research Practices for Conjoint Analysis Task Force. Value Health. 2011;14(4):403-13." ;
    oboInOwl:hasDbXref "NCIT:C184753" ;
    oboInOwl:hasExactSynonym "DCE"@en ;
    oboInOwl:hasRelatedSynonym "CBC"@en,
        "choice-based conjoint"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000213 .

oheo:1000018 a owl:ObjectProperty ;
    rdfs:label "derived from instrument"@en ;
    obo:IAO_0000115 "Relates an outcome measurement instrument to an earlier instrument from whose items or classification it was derived."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain oheo:0000082 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:range oheo:0000082 .

oheo:2000013 a owl:DatatypeProperty ;
    rdfs:label "has outcome metric"@en ;
    obo:IAO_0000115 "The form of the outcome variable, such as value at a time point, change from baseline or time to event."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:range xsd:string .

oheo:0000001 a owl:Class ;
    rdfs:label "outcome domain"@en ;
    obo:IAO_0000115 "An information content entity that names a category of health or health-related consequence, such as physical functioning or mortality, under which outcomes are grouped for selection, measurement, reporting and synthesis."@en ;
    obo:IAO_0000116 "A domain says what is measured, not how. OHEO follows the COMET outcome taxonomy, which Dodd et al. describe as 'intended for the classification of what, rather than how, outcomes are measured'. Instruments that measure a domain are linked with 'has outcome domain'."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    dcterms:source "Dodd S, Clarke M, Becker L, Mavergames C, Fish R, Williamson PR. A taxonomy has been developed for outcomes in medical research to help improve knowledge discovery. J Clin Epidemiol. 2018;96:84-92. doi:10.1016/j.jclinepi.2017.12.020" ;
    oboInOwl:hasRelatedSynonym "outcome area"@en,
        "outcome category"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf obo:IAO_0000030 .

oheo:0000114 a owl:Class ;
    rdfs:label "outcome classification criteria"@en ;
    obo:IAO_0000115 "A directive information entity that states rules for assigning a person to an outcome category, such as a tumour response category or an adverse event grade."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf obo:IAO_0000033 .

oheo:0000123 a owl:Class ;
    rdfs:label "EQ-5D-3L"@en ;
    obo:IAO_0000115 "An EQ-5D instrument in which each of the five dimensions has three levels, defining 243 health states."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "EuroQol Group 1990" ;
    dcterms:source "EuroQol Group 1990" ;
    oboInOwl:hasDbXref "NCIT:C66957" ;
    oboInOwl:hasExactSynonym "EQ-5D-3-level"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue 243 ;
            owl:onProperty oheo:2000004 ],
        [ a owl:Restriction ;
            owl:hasValue 3 ;
            owl:onProperty oheo:2000003 ],
        [ a owl:Restriction ;
            owl:hasValue 5 ;
            owl:onProperty oheo:2000002 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000034 ;
            owl:someValuesFrom oheo:0000174 ],
        oheo:0000122 ;
    oheo:9000002 true .

oheo:0000197 a owl:Class ;
    rdfs:label "direct health state valuation process"@en ;
    obo:IAO_0000115 "A health state valuation process in which respondents value health states themselves by a choice or rating task, a stated preference task."@en ;
    obo:IAO_0000116 "Direct valuation tasks are stated preference tasks; that classification was a second parent in 0.1.0 and is now carried by this definition."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Brazier et al. 2017" ;
    oboInOwl:hasExactSynonym "direct elicitation"@en,
        "direct utility assessment"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000196 .

oheo:0000201 a owl:Class ;
    rdfs:label "time trade-off"@en ;
    obo:IAO_0000115 "A direct health state valuation process in which the respondent chooses between a longer time in a health state and a shorter time in full health, and the shorter time is varied until they are indifferent."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Brazier et al. 2017" ;
    oboInOwl:hasExactSynonym "TTO"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000197 .

oheo:0000204 a owl:Class ;
    rdfs:label "composite time trade-off"@en ;
    obo:IAO_0000115 "A time trade-off that values states better than dead by conventional time trade-off and states worse than dead by lead-time time trade-off, as in the EQ-VT protocol."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Oppe et al. 2014" ;
    oboInOwl:hasExactSynonym "cTTO"@en,
        "composite TTO"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000201 .

oheo:0000260 a owl:Class ;
    rdfs:label "health-adjusted life year estimate"@en ;
    obo:IAO_0000115 "An economic evaluation estimate of a summary measure that combines length of life with a weight for the quality of health or the disability experienced, expressed either as healthy time lived or gained, as with QALYs, or as healthy time lost, as with DALYs."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Gold et al. 2002" ;
    dcterms:source "Gold MR, Stevenson D, Fryback DG. HALYS and QALYS and DALYS, oh my: similarities and differences in summary measures of population health. Annu Rev Public Health. 2002;23:115-34." ;
    oboInOwl:hasRelatedSynonym "HALY"@en,
        "health-adjusted life year"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf rheo:0000011 ;
    owl:disjointWith rheo:0000012,
        rheo:0000095 .

oheo:0000385 a owl:Class ;
    rdfs:label "instrument classification value"@en ;
    obo:IAO_0000115 "A categorical value specification that places an outcome measurement instrument in one category of a classification of instruments, such as generic or condition-specific design, or health profile scoring."@en ;
    obo:IAO_0000116 "An OHEO modelling term; its definition source is editorial by design."@en,
        "Used with 'has instrument classification' so that generic, condition-specific and health profile instruments are defined classes, inferred by the reasoner, rather than second asserted parents."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf obo:OBI_0001930 .

oheo:0000014 a owl:Class ;
    rdfs:label "general outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the physiological or clinical outcome area, covering outcomes that affect the whole body and cannot be attributed to one body system, such as fatigue, unspecified pain, fever not attributable to infection, weight and global symptom measures."@en ;
    obo:IAO_0000116 "Laboratory parameters should be classified in the physiological domain that captures the reason for the assessment rather than in this domain (Dodd et al. 2018)."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    oboInOwl:hasExactSynonym "General outcomes"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000003 ;
    oheo:9000001 9 .

oheo:0000026 a owl:Class ;
    rdfs:label "psychiatric outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the physiological or clinical outcome area, covering outcomes associated with the psychiatric system or condition group, such as depressive or anxiety symptoms as clinical outcomes."@en ;
    obo:IAO_0000116 "Physiological domains follow MedDRA System Organ Classes, as in the COMET taxonomy."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    oboInOwl:hasExactSynonym "Psychiatric outcomes"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000003 ;
    oheo:9000001 21 .

oheo:2000004 a owl:DatatypeProperty ;
    rdfs:label "has number of health states"@en ;
    obo:IAO_0000115 "The number of distinct health states a health state classification system can describe."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:range xsd:integer .

oheo:2000003 a owl:DatatypeProperty ;
    rdfs:label "has number of response levels"@en ;
    obo:IAO_0000115 "The number of response levels in each dimension of an instrument whose dimensions all have the same number of levels."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:range xsd:integer .

oheo:0000004 a owl:Class ;
    rdfs:label "life impact outcome area"@en ;
    obo:IAO_0000115 "An outcome domain grouping outcomes that concern the impact of health and care on a person's life, including functioning, quality of life, perceived health, delivery of care and personal circumstances."@en ;
    obo:IAO_0000116 "One of the five core areas of the COMET outcome taxonomy."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000001 .

oheo:0000021 a owl:Class ;
    rdfs:label "neoplasm outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the physiological or clinical outcome area, covering physiological function, signs and symptoms caused by benign, malignant and unspecified neoplasms, including solid and non-solid tumours, such as time to recurrence, response rate or clearance of resection margins."@en ;
    obo:IAO_0000116 "Physiological domains follow MedDRA System Organ Classes, as in the COMET taxonomy."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    oboInOwl:hasExactSynonym "Outcomes relating to neoplasms: benign, malignant and unspecified (including cysts and polyps)"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000003 ;
    oheo:9000001 16 .

oheo:0000049 a owl:Class ;
    rdfs:label "wellbeing and capability outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the life impact outcome area, covering a person's wellbeing beyond health, or their capability to do and be the things they value, such as attachment, autonomy and enjoyment."@en ;
    obo:IAO_0000116 "OHEO extension below the COMET taxonomy, added for health economic use. Measured by instruments such as ICECAP-A, ASCOT and EQ-HWB."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Al-Janabi et al. 2012" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000004 .

oheo:0000327 a owl:Class ;
    rdfs:label "reference case profile"@en ;
    obo:IAO_0000115 "A directive information entity that states the methods an economic evaluation must use to meet the standard of a decision-making body or methods panel, so that results are comparable across analyses."@en ;
    obo:IAO_0000116 "The named profiles are individuals of this class (0.2.0). Their requirements are published as SHACL shapes in oheo-reference-case-shapes.ttl, one shape for each profile, and an analysis that claims conformance to a profile is checked against its shape."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "NICE 2022 (PMG36)" ;
    oboInOwl:hasExactSynonym "methods reference case"@en,
        "reference case"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf obo:IAO_0000033 .

oheo:0000053 a owl:Class ;
    rdfs:label "outcome specification"@en ;
    obo:IAO_0000112 "Change from baseline in EQ-5D-5L index at 12 months, mean, England value set."@en ;
    obo:IAO_0000115 "An information content entity that specifies an outcome to be measured or estimated by stating its domain and, where relevant, the measure, the metric, the method of aggregation and the time point."@en ;
    obo:IAO_0000116 "The five elements follow the ClinicalTrials.gov outcome measure framework. An estimand (RHEO) points to the outcome specification that supplies its variable."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Zarin et al. 2011" ;
    dcterms:source "Zarin DA, Tse T, Williams RJ, Califf RM, Ide NC. The ClinicalTrials.gov results database: update and key issues. N Engl J Med. 2011;364(9):852-60." ;
    oboInOwl:hasDbXref "NCIT:C25212" ;
    oboInOwl:hasExactSynonym "endpoint"@en,
        "outcome measure definition"@en ;
    oboInOwl:hasRelatedSynonym "outcome"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf obo:IAO_0000030 .

oheo:2000005 a owl:DatatypeProperty ;
    rdfs:label "has recall period"@en ;
    obo:IAO_0000115 "The period a respondent is asked to consider when answering an instrument."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:range xsd:string .

oheo:0000033 a owl:Class ;
    rdfs:label "emotional functioning or wellbeing outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the life impact outcome area, covering a person's emotional state and psychological wellbeing, such as mood, worry and life satisfaction."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    oboInOwl:hasExactSynonym "Emotional functioning/well-being"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000004 ;
    oheo:9000001 28 .

oheo:0000175 a owl:Class ;
    rdfs:label "EQ-5D-5L value set"@en ;
    obo:IAO_0000115 "A value set that assigns a utility to each of the 3,125 EQ-5D-5L health states."@en ;
    obo:IAO_0000116 "A kind of value set, not one value set: each value set for this instrument is a subclass."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Devlin and Brooks 2017" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oheo:1000010 ;
            owl:someValuesFrom oheo:0000124 ],
        oheo:0000105 .

oheo:0000048 a owl:Class ;
    rdfs:label "health-related quality of life outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the life impact outcome area, covering the physical, psychological and social aspects of life that are affected by a person's health or its treatment."@en ;
    obo:IAO_0000116 "OHEO extension below the COMET taxonomy, added for health economic use. It spans COMET domains 25 to 31; most generic preference-based measures cover it."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Brazier et al. 2017" ;
    oboInOwl:hasRelatedSynonym "HRQL"@en,
        "HRQoL"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000004 .

oheo:1000034 a owl:ObjectProperty ;
    rdfs:label "has published value set"@en ;
    obo:IAO_0000115 "Relates an outcome measurement instrument to a value set that has been published for its descriptive system. An instrument with one is a preference-based measure."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain oheo:0000082 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:range oheo:0000105 .

oheo:1000036 a owl:ObjectProperty ;
    rdfs:label "claims conformance to"@en ;
    obo:IAO_0000115 "Relates an analysis, such as a QALY calculation process or a model run, to the reference case profile whose requirements it claims to meet. The claim is checked by that profile's SHACL shape."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:range oheo:0000327 .

oheo:2000009 a owl:DatatypeProperty ;
    rdfs:label "has worst health state utility"@en ;
    obo:IAO_0000115 "The utility a value set assigns to the worst health state of its classification system."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:range xsd:decimal .

oheo:0000124 a owl:Class ;
    rdfs:label "EQ-5D-5L"@en ;
    obo:IAO_0000115 "An EQ-5D instrument in which each of the five dimensions has five levels, defining 3,125 health states."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Herdman et al. 2011" ;
    dcterms:source "Herdman M, Gudex C, Lloyd A, et al. Development and preliminary testing of the new five-level version of EQ-5D (EQ-5D-5L). Qual Life Res. 2011;20(10):1727-36." ;
    oboInOwl:hasDbXref "NCIT:C102117" ;
    oboInOwl:hasExactSynonym "EQ-5D-5-level"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oheo:1000034 ;
            owl:someValuesFrom oheo:0000175 ],
        [ a owl:Restriction ;
            owl:hasValue 5 ;
            owl:onProperty oheo:2000003 ],
        [ a owl:Restriction ;
            owl:hasValue 3125 ;
            owl:onProperty oheo:2000004 ],
        [ a owl:Restriction ;
            owl:hasValue 5 ;
            owl:onProperty oheo:2000002 ],
        oheo:0000122 ;
    oheo:9000002 true .

oheo:1000031 a owl:ObjectProperty ;
    rdfs:label "value set elicited by"@en ;
    obo:IAO_0000115 "Relates a value set or an index value set to the kind of preference elicitation process by which the preferences it rests on were elicited, such as composite time trade-off. Named so as not to be confused with the RHEO datatype property has valuation method (RHEO_2000023)."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( oheo:0000105 oheo:0000400 ) ] ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:range oheo:0000194 .

oheo:0000105 a owl:Class ;
    rdfs:label "value set"@en ;
    obo:IAO_0000115 "A multi-attribute utility function that assigns a utility to every health state of a health state classification system, estimated from preferences elicited from a stated population by a stated valuation method. Each named value set in OHEO is a class whose instances are its published releases."@en ;
    obo:IAO_0000116 "A value set is a valuation, kept apart from the instrument whose descriptive system it values. In 0.1.0 it was also under scoring algorithm; its scoring role is stated by 'scores instrument'."@en,
        "A value set is a valuation, not part of the instrument: the same EQ-5D-5L responses give different utilities under different value sets, so a utility record must name both. Link to the instrument with 'scores instrument', to the elicitation method with 'has valuation method' and to the population with 'elicited in population'. A correction or re-estimation of a value set is a new release, which is a new instance."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Brazier et al. 2017" ;
    dcterms:source "Brazier J, Ratcliffe J, Salomon JA, Tsuchiya A. Measuring and Valuing Health Benefits for Economic Evaluation. 2nd ed. Oxford: Oxford University Press; 2017." ;
    oboInOwl:hasExactSynonym "utility tariff"@en ;
    oboInOwl:hasRelatedSynonym "preference weights"@en,
        "scoring algorithm (preference-based)"@en,
        "tariff"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oheo:1000010 ;
            owl:someValuesFrom oheo:0000090 ],
        oheo:0000103 ;
    owl:disjointWith oheo:0000101 .

oheo:2000012 a owl:DatatypeProperty ;
    rdfs:label "has valuation population"@en ;
    obo:IAO_0000115 "A description of the population whose preferences were elicited to produce a value set."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:range xsd:string .

oheo:0000003 a owl:Class ;
    rdfs:label "physiological or clinical outcome area"@en ;
    obo:IAO_0000115 "An outcome domain grouping outcomes that concern physiological function, signs, symptoms and disease, classified by the underlying cause or the affected body system."@en ;
    obo:IAO_0000116 "One of the five core areas of the COMET outcome taxonomy."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000001 .

oheo:0000030 a owl:Class ;
    rdfs:label "physical functioning outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the life impact outcome area, covering a person's ability to carry out physical activities, such as mobility, self-care and activities of daily living."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    oboInOwl:hasExactSynonym "Physical functioning"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000004 ;
    oheo:9000001 25 .

oheo:2000002 a owl:DatatypeProperty ;
    rdfs:label "has number of dimensions"@en ;
    obo:IAO_0000115 "The number of dimensions or attributes in an outcome measurement instrument or health state classification system."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:range xsd:integer .

oheo:2000006 a owl:DatatypeProperty ;
    rdfs:label "has minimum score"@en ;
    obo:IAO_0000115 "The lowest possible score of an instrument or scale."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:range xsd:decimal .

oheo:2000007 a owl:DatatypeProperty ;
    rdfs:label "has maximum score"@en ;
    obo:IAO_0000115 "The highest possible score of an instrument or scale."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:range xsd:decimal .

oboInOwl:hasRelatedSynonym a owl:AnnotationProperty ;
    rdfs:label "has_related_synonym"@en .

oheo:0000388 a owl:NamedIndividual,
        oheo:0000385 ;
    rdfs:label "health profile scoring"@en ;
    obo:IAO_0000115 "An instrument classification value for an instrument that reports separate scores for several aspects of health rather than one index."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Brazier et al. 2017" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> .

oheo:1000010 a owl:ObjectProperty ;
    rdfs:label "scores instrument"@en ;
    obo:IAO_0000115 "Relates a scoring algorithm or a value set to the outcome measurement instrument whose responses it scores."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:range oheo:0000082 .

oheo:0000386 a owl:NamedIndividual,
        oheo:0000385 ;
    rdfs:label "generic design"@en ;
    obo:IAO_0000115 "An instrument classification value for an instrument designed for use across conditions and populations."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Brazier et al. 2017" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> .

oheo:0000387 a owl:NamedIndividual,
        oheo:0000385 ;
    rdfs:label "condition-specific design"@en ;
    obo:IAO_0000115 "An instrument classification value for an instrument designed for people with a particular condition or treatment."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Brazier et al. 2017" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> .

oheo:2000008 a owl:DatatypeProperty ;
    rdfs:label "has score direction"@en ;
    obo:IAO_0000115 "Whether higher scores indicate better or worse health: 'higher is better' or 'higher is worse'."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:range xsd:string .

oheo:2000001 a owl:DatatypeProperty ;
    rdfs:label "has number of items"@en ;
    obo:IAO_0000115 "The number of items in an outcome measurement instrument."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:range xsd:integer .

oboInOwl:hasExactSynonym a owl:AnnotationProperty ;
    rdfs:label "has_exact_synonym"@en .

oheo:0000083 a owl:Class ;
    rdfs:label "patient-reported outcome measure"@en ;
    obo:IAO_0000115 "An outcome measurement instrument completed by the respondent reporting on their own health or state, usually the patient and sometimes a carer reporting on their own experience, without interpretation by a clinician or anyone else."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from FDA-NIH Biomarker Working Group 2016 (BEST Resource)" ;
    oboInOwl:hasDbXref "NCIT:C177377" ;
    oboInOwl:hasExactSynonym "PRO instrument"@en,
        "PRO measure"@en,
        "PROM"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000082 .

oheo:0000082 a owl:Class ;
    rdfs:label "outcome measurement instrument"@en ;
    obo:IAO_0000115 "A directive information entity that specifies how to obtain a score or classification for an outcome from a patient, a clinician, an observer or a performance task, including its items, response options and scoring rules. Each named instrument in OHEO, such as the EQ-5D-5L, is a class whose instances are the instrument's versions, such as one language and format version."@en ;
    obo:IAO_0000116 "An instrument is the specification. Administering it is an outcome assessment process; one person's result is an outcome measurement datum, a RHEO state observation or a RHEO utility measurement record. OHEO identifies three things separately: the instrument (its class, such as EQ-5D-5L), the instrument version (an instance of that class, such as one language and format version) and the value set (an instance of a value set class). The record rules check that a record names each one."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Mokkink et al. 2010 (COSMIN)" ;
    dcterms:source "Mokkink LB, Terwee CB, Patrick DL, et al. The COSMIN study reached international consensus on taxonomy, terminology, and definitions of measurement properties for health-related patient-reported outcomes. J Clin Epidemiol. 2010;63(7):737-45." ;
    oboInOwl:hasDbXref "NCIT:C142378" ;
    oboInOwl:hasExactSynonym "COA"@en,
        "clinical outcome assessment"@en ;
    oboInOwl:hasNarrowSynonym "questionnaire"@en ;
    oboInOwl:hasRelatedSynonym "outcome measure"@en,
        "scale"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf obo:IAO_0000033 .

oheo:0000328 a owl:Class ;
    rdfs:label "outcome reference case requirement"@en ;
    obo:IAO_0000115 "A directive information entity that states one rule a reference case profile sets for how health outcomes are measured, valued, sourced or discounted."@en ;
    obo:IAO_0000116 "Specific requirements are constraints in the SHACL shapes of oheo-reference-case-shapes.ttl. The 45 requirement classes of 0.1.0 are obsolete."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "NICE 2022 (PMG36)" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf obo:IAO_0000033 .

obo:OMO_0001000 a owl:NamedIndividual ;
    rdfs:label "out of scope"@en .

obo:OMO_0003000 a owl:AnnotationProperty ;
    rdfs:label "abbreviation"@en ;
    rdfs:isDefinedBy obo:omo.owl ;
    rdfs:subPropertyOf oboInOwl:SynonymTypeProperty .

oheo:1000035 a owl:ObjectProperty ;
    rdfs:label "has instrument classification"@en ;
    obo:IAO_0000115 "Relates an outcome measurement instrument to a value that classifies it, such as generic design."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:domain oheo:0000082 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:range oheo:0000385 .

oheo:1000001 a owl:ObjectProperty ;
    rdfs:label "has outcome domain"@en ;
    obo:IAO_0000115 "Relates an outcome specification, an outcome measurement instrument or a core outcome set to an outcome domain that it covers."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:range oheo:0000001 .

<https://healtheconomics.wiki/ontologies/oheo> a owl:Ontology ;
    dcterms:bibliographicCitation "Baines D, Ashley M. Outcomes Health Economics Ontology (OHEO), version 0.2.0. Intelligent Parameters Ltd; 2026. https://healtheconomics.wiki/ontologies/oheo/0.3.0/oheo.owl. Licence CC BY 4.0." ;
    dcterms:created "2026-10-08" ;
    dcterms:creator <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    dcterms:description "An ontology of health outcomes as they are specified, measured, valued and summarised for health economics and health technology assessment. OHEO keeps four kinds of thing apart: outcome domains (what is measured, aligned to the 38 domains of the COMET outcome taxonomy), outcome measurement instruments (how it is measured; each named instrument is a class whose instances are its versions), valuations (utility functions and value sets, each named value set a class whose instances are its releases), and summary measures (QALY, DALY and related estimates). Outcome specifications, records of individual measurements, valuation methods and the reference cases of decision-making bodies are described with them. Policy (agreed with Darrin Baines, 15 October 2026): HEO identifies concepts; RHEO and OHEO define types classified within BFO 2020 (ISO/IEC 21838-2). A concept and a type have different identifiers even when their names are alike, and no OHEO class uses a HEO concept URI. HEO is the thesaurus of concepts; RHEO and OHEO classify kinds of things and do not overlap where they are used operationally (OHEO declares its records disjoint from the RHEO records they sit beside). SKOS names broker between them: the mappings to HEO concepts and RHEO types are published in oheo-mappings.sssom.tsv with justified, non-exact predicates, and a mapping never states identity. Requirements that records and analyses must meet, including the reference cases of NICE and nine other bodies, are published as SHACL shapes (oheo-shapes.ttl and oheo-reference-case-shapes.ttl), because OWL's open-world semantics cannot treat missing information as an error."@en ;
    dcterms:issued "2026-10-16" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-16" ;
    dcterms:publisher "Intelligent Parameters Ltd" ;
    dcterms:subject "COMET",
        "COSMIN",
        "QALY",
        "core outcome sets",
        "health economics",
        "health outcomes",
        "health technology assessment",
        "health utility",
        "outcome measurement",
        "patient-reported outcome measures" ;
    dcterms:title "Outcomes Health Economics Ontology (OHEO)"@en ;
    vann:preferredNamespacePrefix "oheo" ;
    vann:preferredNamespaceUri "https://healtheconomics.wiki/ontologies/oheo/OHEO_" ;
    rdfs:comment "Pre-1.0 release (status alpha) for review by its creators and invited reviewers; terms, definitions and mappings may still change before version 1.0. OHEO imports RHEO 0.4.0, which imports BFO 2020; the BFO, IAO, OBI, COB and STATO terms that RHEO declares are not declared again here. Other reused terms (from IAO, OBI, STATO, OGMS and OAE) are declared with their official label and definition as served by the EBI Ontology Lookup Service on 16 October 2026, with one of their source-asserted parents; consult the source ontologies for their full axioms."@en ;
    rdfs:seeAlso <https://healtheconomics.wiki/ontologies/heo>,
        <https://healtheconomics.wiki/ontologies/rheo>,
        <https://healtheconomics.wiki/subdomain/outcomes> ;
