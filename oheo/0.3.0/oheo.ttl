oheo:9000001 a owl:AnnotationProperty ;
    rdfs:label "COMET domain number"@en ;
    obo:IAO_0000115 "The number of the domain in the COMET outcome taxonomy (Dodd et al. 2018), from 1 to 38."@en ;
