oheo:0000176 a owl:Class ;
    rdfs:label "EQ-5D-3L UK value set (Dolan 1997)"@en ;
    obo:IAO_0000115 "An EQ-5D-3L value set elicited by time trade-off from a representative sample of the UK general population in the Measurement and Valuation of Health study, ranging from -0.594 to 1."@en ;
    obo:IAO_0000116 "The value set the NICE reference case used under PMG36 (2022), applied directly to EQ-5D-3L data or through the NICE DSU mapping from EQ-5D-5L responses (old PMG36 4.3.16). For topics started on or after 27 August 2026, NICE PMG51 uses the UK EQ-5D-5L value set (Rowen et al. 2026) instead, and EQ-5D-3L value set utilities may not be used in sensitivity or scenario analyses (PMG51 1.13)."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Dolan 1997" ;
    dcterms:source "Dolan P. Modeling valuations for EuroQol health states. Med Care. 1997;35(11):1095-108." ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oheo:1000031 ;
            owl:someValuesFrom oheo:0000201 ],
        [ a owl:Restriction ;
            owl:hasValue -0.594 ;
            owl:onProperty oheo:2000009 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000010 ;
            owl:someValuesFrom oheo:0000123 ],
        [ a owl:Restriction ;
            owl:hasValue "UK general population" ;
            owl:onProperty oheo:2000012 ],
        oheo:0000174 ;
    oheo:9000002 true .

oheo:0000177 a owl:Class ;
    rdfs:label "EQ-5D-3L US value set (Shaw 2005)"@en ;
    obo:IAO_0000115 "An EQ-5D-3L value set elicited by time trade-off from a sample of the US general population."@en ;
    obo:IAO_0000116 "The worst health state utility was carried over from 0.1.0 and has not been checked against the paper, so the record rules only warn when a utility falls below it."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Shaw et al. 2005" ;
    dcterms:source "Shaw JW, Johnson JA, Coons SJ. US valuation of the EQ-5D health states: development and testing of the D1 valuation model. Med Care. 2005;43(3):203-20." ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oheo:1000031 ;
            owl:someValuesFrom oheo:0000201 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000010 ;
            owl:someValuesFrom oheo:0000123 ],
        [ a owl:Restriction ;
            owl:hasValue "US general population" ;
            owl:onProperty oheo:2000012 ],
        [ a owl:Restriction ;
            owl:hasValue -0.109 ;
            owl:onProperty oheo:2000009 ],
        oheo:0000174 ;
    oheo:9000002 true .

oheo:0000178 a owl:Class ;
    rdfs:label "EQ-5D-5L England value set (Devlin 2018)"@en ;
    obo:IAO_0000115 "An EQ-5D-5L value set elicited by composite time trade-off and discrete choice experiment from a sample of the general population in England, ranging from -0.285 to 1."@en ;
    obo:IAO_0000116 "NICE never recommended this value set for reference-case analyses (old PMG36 4.3.16, quoted in PMG51). PMG51 (27 August 2026) adopts the UK EQ-5D-5L value set of Rowen et al. 2026 instead."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Devlin et al. 2018" ;
    dcterms:source "Devlin NJ, Shah KK, Feng Y, Mulhern B, van Hout B. Valuing health-related quality of life: an EQ-5D-5L value set for England. Health Econ. 2018;27(1):7-22." ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oheo:1000010 ;
            owl:someValuesFrom oheo:0000124 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000031 ;
            owl:someValuesFrom oheo:0000204 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000031 ;
            owl:someValuesFrom oheo:0000214 ],
        [ a owl:Restriction ;
            owl:hasValue "general population of England" ;
            owl:onProperty oheo:2000012 ],
        [ a owl:Restriction ;
            owl:hasValue -0.285 ;
            owl:onProperty oheo:2000009 ],
        oheo:0000175 ;
    oheo:9000002 true .

oheo:0000179 a owl:Class ;
    rdfs:label "EQ-5D-5L US value set (Pickard 2019)"@en ;
    obo:IAO_0000115 "An EQ-5D-5L value set elicited by composite time trade-off and discrete choice experiment from a sample of the US general population."@en ;
    obo:IAO_0000116 "The worst health state utility was carried over from 0.1.0 and has not been checked against the paper, so the record rules only warn when a utility falls below it."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Pickard et al. 2019" ;
    dcterms:source "Pickard AS, Law EH, Jiang R, et al. United States valuation of EQ-5D-5L health states using an international protocol. Value Health. 2019;22(8):931-41." ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oheo:1000031 ;
            owl:someValuesFrom oheo:0000204 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000010 ;
            owl:someValuesFrom oheo:0000124 ],
        [ a owl:Restriction ;
            owl:hasValue -0.573 ;
            owl:onProperty oheo:2000009 ],
        [ a owl:Restriction ;
            owl:hasValue "US general population" ;
            owl:onProperty oheo:2000012 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000031 ;
            owl:someValuesFrom oheo:0000214 ],
        oheo:0000175 ;
    oheo:9000002 true .

oheo:0000185 a owl:Class ;
    rdfs:label "EQ-5D-5L to EQ-5D-3L crosswalk (van Hout 2012)"@en ;
    obo:IAO_0000115 "A crosswalk that assigns EQ-5D-3L values to EQ-5D-5L health states using a response mapping estimated from people who completed both instruments."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "van Hout et al. 2012" ;
    dcterms:source "van Hout B, Janssen MF, Feng YS, et al. Interim scoring for the EQ-5D-5L: mapping the EQ-5D-5L to EQ-5D-3L value sets. Value Health. 2012;15(5):708-15." ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oheo:1000011 ;
            owl:someValuesFrom oheo:0000124 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000012 ;
            owl:someValuesFrom oheo:0000123 ],
        oheo:0000108 ;
    oheo:9000002 true .

oheo:0000186 a owl:Class ;
    rdfs:label "EQ-5D-5L to EQ-5D-3L mapping (NICE DSU, Hernandez Alava 2017)"@en ;
    obo:IAO_0000115 "A crosswalk that predicts EQ-5D-3L UK utilities from EQ-5D-5L responses using the NICE Decision Support Unit mapping function, estimated on the EEPRU dataset in which people completed both versions."@en ;
    obo:IAO_0000116 "The mapping NICE PMG36 (2022) asked for when EQ-5D-5L data were collected: EQ-5D-5L responses mapped to the EQ-5D-3L UK value set (old PMG36 4.3.16, quoted in PMG51). Topics started before 27 August 2026 keep this approach (PMG51 1.17, 1.18)."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Hernandez Alava et al. 2017" ;
    dcterms:source "Hernández Alava et al. 2017 (NICE Decision Support Unit report), using the EEPRU dataset (Hernández Alava M, Pudney S, Wailoo A. Pharmacoeconomics. 2023;41(2):199-207), as cited in NICE PMG36 4.3.16 and PMG51." ;
    oboInOwl:hasRelatedSynonym "DSU mapping"@en,
        "EEPRU mapping"@en,
        "Hernández Alava mapping"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oheo:1000012 ;
            owl:someValuesFrom oheo:0000123 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000011 ;
            owl:someValuesFrom oheo:0000124 ],
        oheo:0000108 ;
    oheo:9000002 true .

oheo:0000187 a owl:Class ;
    rdfs:label "outcome assessment process"@en ;
    obo:IAO_0000115 "A planned process in which an outcome measurement instrument is administered to, or a performance task is carried out by, a person and their responses are scored to produce an outcome measurement datum."@en ;
    obo:IAO_0000116 "The process that realises an instrument. Its output is an outcome measurement datum."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    oboInOwl:hasExactSynonym "instrument administration"@en ;
    oboInOwl:hasRelatedSynonym "outcome measurement"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf obo:COB_0000082 .

oheo:0000190 a owl:Class ;
    rdfs:label "instrument score record"@en ;
    obo:IAO_0000112 "SF-36 physical component score of 42.3 at 6 months."@en ;
    obo:IAO_0000115 "An outcome measurement datum recording a score, or set of dimension scores, obtained by applying a scoring algorithm to one person's responses to an instrument."@en ;
    obo:IAO_0000116 "An OHEO modelling term; its definition source is editorial by design."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oheo:1000013 ;
            owl:someValuesFrom oheo:0000082 ],
        oheo:0000189 .

oheo:0000191 a owl:Class ;
    rdfs:label "time-to-event record"@en ;
    obo:IAO_0000115 "An outcome measurement datum recording, for one person, the time from a stated origin to an event of a stated type or to censoring, with an indicator of which occurred."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    oboInOwl:hasExactSynonym "survival time record"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000189 .

oheo:0000192 a owl:Class ;
    rdfs:label "tumour response assessment record"@en ;
    obo:IAO_0000115 "An outcome measurement datum recording the tumour response category assigned to one person at an assessment under stated response criteria."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Eisenhauer et al. 2009" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oheo:1000016 ;
            owl:someValuesFrom oheo:0000114 ],
        oheo:0000189 .

oheo:0000193 a owl:Class ;
    rdfs:label "adverse event record"@en ;
    obo:IAO_0000115 "An outcome measurement datum recording that one person experienced an adverse event of a stated type, with its onset, grade under stated criteria and attribution where known."@en ;
    obo:IAO_0000116 "The record is about an adverse event (OAE), which is a real process in the person."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "ICH E2A 1994" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:IAO_0000136 ;
            owl:someValuesFrom obo:OAE_0000001 ],
        oheo:0000189 .

oheo:0000202 a owl:Class ;
    rdfs:label "conventional time trade-off"@en ;
    obo:IAO_0000115 "A time trade-off in which states better than dead and states worse than dead are valued with different procedures."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Torrance 1986" ;
    oboInOwl:hasExactSynonym "conventional TTO"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000201 .

oheo:0000207 a owl:Class ;
    rdfs:label "health state ranking"@en ;
    obo:IAO_0000115 "A direct health state valuation process in which the respondent puts a set of health states in order of preference."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Brazier et al. 2017" ;
    oboInOwl:hasExactSynonym "ranking method"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000197 .

oheo:0000213 a owl:Class ;
    rdfs:label "choice experiment"@en ;
    obo:IAO_0000115 "A stated preference elicitation process in which respondents choose among systematically varied alternatives described by attributes, and attribute values are estimated from their choices under a random utility model."@en ;
    obo:IAO_0000116 "Placed beside conjoint analysis, not under it, following Louviere, Flynn and Carson 2010 (0.2.0 fix pass)."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Louviere, Flynn and Carson 2010" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000195 .

oheo:0000221 a owl:Class ;
    rdfs:label "benefit transfer"@en ;
    obo:IAO_0000115 "A monetary valuation process that applies value estimates from existing studies to a new but related policy context instead of conducting a new valuation study."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Johnston et al. 2015" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000217 .

oheo:0000227 a owl:Class ;
    rdfs:label "efficient design"@en ;
    obo:IAO_0000115 "A choice experiment design chosen to maximise the statistical information about model parameters for a given number of choice tasks."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Reed Johnson et al. 2013" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000225 .

oheo:0000229 a owl:Class ;
    rdfs:label "choice set"@en ;
    obo:IAO_0000115 "An information content entity that is the group of alternatives presented to a respondent in one choice task."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Reed Johnson et al. 2013" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf obo:IAO_0000030 .

oheo:0000232 a owl:Class ;
    rdfs:label "random parameters logit model"@en ;
    obo:IAO_0000115 "A choice model in which preference parameters vary across respondents according to stated distributions."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Train 2009" ;
    oboInOwl:hasExactSynonym "mixed logit model"@en,
        "random parameter model"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000230 .

oheo:0000233 a owl:Class ;
    rdfs:label "latent class choice model"@en ;
    obo:IAO_0000115 "A choice model that assumes respondents belong to a finite number of unobserved classes with different preferences, and estimates class preferences and membership probabilities."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Train 2009" ;
    oboInOwl:hasBroadSynonym "latent class model"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000230 .

oheo:0000234 a owl:Class ;
    rdfs:label "value set development study"@en ;
    obo:IAO_0000115 "An investigation that designs, conducts and analyses a preference elicitation study in a stated population to produce a value set for a health state classification system."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Brazier et al. 2017" ;
    oboInOwl:hasBroadSynonym "valuation study"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf obo:OBI_0000066 .

oheo:0000235 a owl:Class ;
    rdfs:label "mapping function development study"@en ;
    obo:IAO_0000115 "An investigation that estimates a mapping function from data in which source and target instruments were collected from the same people."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Wailoo et al. 2017" ;
    oboInOwl:hasExactSynonym "mapping study"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf obo:OBI_0000066 .

oheo:0000236 a owl:Class ;
    rdfs:label "core outcome set development study"@en ;
    obo:IAO_0000115 "An investigation that identifies candidate outcomes and reaches agreement among stakeholders, often by Delphi survey and consensus meeting, on a core outcome set."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Williamson et al. 2017 (COMET Handbook)" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf obo:OBI_0000066 .

oheo:0000255 a owl:Class ;
    rdfs:label "internal consistency coefficient"@en ;
    obo:IAO_0000115 "A measurement property estimate of internal consistency, such as Cronbach's alpha, computed from the correlations among the items of a scale."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Mokkink et al. 2010 (COSMIN)" ;
    oboInOwl:hasNarrowSynonym "Cronbach's alpha"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000250 .

oheo:0000257 a owl:Class ;
    rdfs:label "floor effect estimate"@en ;
    obo:IAO_0000115 "A measurement property estimate of the proportion of respondents with the lowest possible score."@en ;
    obo:IAO_0000116 "Terwee et al. treat more than 15% at the floor as a problem."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Terwee et al. 2007" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000250 .

oheo:0000258 a owl:Class ;
    rdfs:label "ceiling effect estimate"@en ;
    obo:IAO_0000115 "A measurement property estimate of the proportion of respondents with the highest possible score."@en ;
    obo:IAO_0000116 "Common for EQ-5D-3L in healthy populations, and one reason for the EQ-5D-5L."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Terwee et al. 2007" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000250 .

oheo:0000259 a owl:Class ;
    rdfs:label "restricted mean survival time"@en ;
    obo:IAO_0000115 "A mean time-to-event in which follow-up is restricted to a stated time horizon, equal to the area under the survival curve up to that horizon."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Royston and Parmar 2013" ;
    oboInOwl:hasExactSynonym "RMST"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf obo:STATO_0000658 .

oheo:0000263 a owl:Class ;
    rdfs:label "DALY estimate"@en ;
    obo:IAO_0000115 "A health-adjusted life year estimate of health lost, equal to years of life lost to premature death plus years lived with disability."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Murray 1994" ;
    oboInOwl:hasRelatedSynonym "DALY"@en,
        "disability-adjusted life year"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000260 .

oheo:0000266 a owl:Class ;
    rdfs:label "healthy-year equivalent estimate"@en ;
    obo:IAO_0000115 "A health-adjusted life year estimate of the number of years in full health that a person considers equivalent to a whole path of health states over time, elicited by a two-stage standard gamble."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Mehrez and Gafni 1989" ;
    dcterms:source "Mehrez A, Gafni A. Quality-adjusted life years, utility theory, and healthy-years equivalents. Med Decis Making. 1989;9(2):142-9." ;
    oboInOwl:hasRelatedSynonym "HYE"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000260 .

oheo:0000267 a owl:Class ;
    rdfs:label "Q-TWiST estimate"@en ;
    obo:IAO_0000115 "A health-adjusted life year estimate that sums time with toxicity, time without symptoms or toxicity, and time after relapse, each weighted by a utility for that state."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Glasziou et al. 1990" ;
    dcterms:source "Glasziou PP, Simes RJ, Gelber RD. Quality adjusted survival analysis. Stat Med. 1990;9(11):1259-76." ;
    oboInOwl:hasRelatedSynonym "Q-TWiST"@en,
        "quality-adjusted time without symptoms or toxicity"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000260 .

oheo:0000268 a owl:Class ;
    rdfs:label "utility decrement estimate"@en ;
    obo:IAO_0000112 "A utility decrement of 0.05 applied for the weeks a grade 3 adverse event lasts."@en ;
    obo:IAO_0000115 "An economic evaluation estimate of the loss of utility associated with an event, a treatment or a health state, relative to a stated baseline."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Brazier et al. 2017" ;
    oboInOwl:hasRelatedSynonym "disutility"@en,
        "utility decrement"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf rheo:0000011 .

oheo:0000273 a owl:Class ;
    rdfs:label "life expectancy estimate"@en ;
    obo:IAO_0000115 "An economic evaluation estimate of the average number of further years a person of a given age is expected to live under stated mortality rates."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Chiang 1984" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf rheo:0000011 .

oheo:0000274 a owl:Class ;
    rdfs:label "health-adjusted life expectancy estimate"@en ;
    obo:IAO_0000115 "A health expectancy estimate in which years of life are weighted by the severity of the health states lived in."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Robine et al. 2003" ;
    oboInOwl:hasRelatedSynonym "HALE"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000272 .

oheo:0000275 a owl:Class ;
    rdfs:label "disability-free life expectancy estimate"@en ;
    obo:IAO_0000115 "A health expectancy estimate of the years a person can expect to live without disability."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Robine et al. 2003" ;
    oboInOwl:hasRelatedSynonym "DFLE"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000272 .

oheo:0000276 a owl:Class ;
    rdfs:label "active life expectancy estimate"@en ;
    obo:IAO_0000115 "A health expectancy estimate of the years a person can expect to live without dependency in activities of daily living."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Katz et al. 1983" ;
    oboInOwl:hasRelatedSynonym "ALE"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000272 .

oheo:0000281 a owl:Class ;
    rdfs:label "willingness-to-pay estimate"@en ;
    obo:IAO_0000115 "A monetary valuation estimate of the most money people would give up for a stated benefit."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Drummond et al. 2015" ;
    oboInOwl:hasRelatedSynonym "WTP"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000278 .

oheo:0000282 a owl:Class ;
    rdfs:label "willingness-to-accept estimate"@en ;
    obo:IAO_0000115 "A monetary valuation estimate of the least compensation people would accept for a stated loss."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Drummond et al. 2015" ;
    oboInOwl:hasRelatedSynonym "WTA"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000278 .

oheo:0000283 a owl:Class ;
    rdfs:label "value of a statistical life estimate"@en ;
    obo:IAO_0000115 "A monetary valuation estimate of the aggregate willingness to pay for mortality risk reductions that together prevent one expected death."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Drummond et al. 2015" ;
    oboInOwl:hasRelatedSynonym "VSL"@en,
        "value of statistical life"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000278 .

oheo:0000285 a owl:Class ;
    rdfs:label "DALY calculation process"@en ;
    obo:IAO_0000115 "A planned process in which disability-adjusted life years are calculated as years of life lost plus years lived with disability."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Murray 1994" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf obo:COB_0000082 .

oheo:0000289 a owl:Class ;
    rdfs:label "Q-TWiST analysis"@en ;
    obo:IAO_0000115 "A planned process in which survival time is partitioned into time with toxicity, time without symptoms or toxicity, and time after relapse, and the periods are weighted by utilities."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Glasziou et al. 1990" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf obo:COB_0000082 .

oheo:0000291 a owl:Class ;
    rdfs:label "toxicity period (TOX)"@en ;
    obo:IAO_0000115 "A Q-TWiST health state covering time with serious treatment toxicity before progression."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Glasziou et al. 1990" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000290 .

oheo:0000292 a owl:Class ;
    rdfs:label "time without symptoms or toxicity (TWiST)"@en ;
    obo:IAO_0000115 "A Q-TWiST health state covering time free of serious toxicity and of symptoms of progression."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Glasziou et al. 1990" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000290 .

oheo:0000293 a owl:Class ;
    rdfs:label "relapse period (REL)"@en ;
    obo:IAO_0000115 "A Q-TWiST health state covering time after relapse or progression."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Glasziou et al. 1990" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000290 .

oheo:0000294 a owl:Class ;
    rdfs:label "equal value life-years gained estimate"@en ;
    obo:IAO_0000115 "A health-adjusted life year estimate in which quality-of-life gains are counted as for QALYs, but every year of life added by an intervention is valued at a fixed quality weight, so that life extension is valued the same whatever a person's health state."@en ;
    obo:IAO_0000116 "ICER's reference case fixes the weight for added life-years at 0.851."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "ICER 2025" ;
    oboInOwl:hasRelatedSynonym "equal value of life years gained"@en,
        "evLYG"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000260 .

oheo:0000296 a owl:Class ;
    rdfs:label "EQ-5D-3L and EQ-5D-5L response mapping (NICE DSU, EEPRU dataset)"@en ;
    obo:IAO_0000115 "A mapping function that predicts responses on the EQ-5D-5L from responses on the EQ-5D-3L, or the reverse, by the response mapping model of the NICE Decision Support Unit estimated on the EEPRU dataset, so that a value set can then be applied to the predicted responses as a separate step."@en ;
    obo:IAO_0000116 "NICE PMG51 (27 August 2026) uses this model when only EQ-5D-3L data exist: the predicted EQ-5D-5L responses are scored with the UK EQ-5D-5L value set (Rowen et al. 2026), and the result counts as a departure from the reference case (PMG51 1.10, Appendix A 4.3.8). The value set applied is recorded on the utility record, not in this class. Before PMG51 the same approach mapped EQ-5D-5L data to the EQ-5D-3L value set (PMG36)."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000118 "EQ-5D-3L to EQ-5D-5L mapping (NICE DSU, Hernandez Alava)"@en ;
    obo:IAO_0000119 "Hernandez Alava et al. 2023" ;
    dcterms:source "Hernández Alava M, Pudney S, Wailoo A. Estimating the relationship between EQ-5D-5L and EQ-5D-3L: results from a UK population study. Pharmacoeconomics. 2023;41(2):199-207." ;
    oboInOwl:hasRelatedSynonym "3L to 5L mapping"@en,
        "reverse DSU mapping"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty oheo:1000011 ;
            owl:someValuesFrom oheo:0000123 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000011 ;
            owl:someValuesFrom oheo:0000124 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000012 ;
            owl:someValuesFrom oheo:0000123 ],
        [ a owl:Restriction ;
            owl:onProperty oheo:1000012 ;
            owl:someValuesFrom oheo:0000124 ],
        oheo:0000108 ;
    oheo:9000002 true .

oheo:0000297 a owl:Class ;
    rdfs:label "EQ-5D-5L UK value set (Rowen 2026)"@en ;
    obo:IAO_0000115 "An EQ-5D-5L value set elicited from a sample of the adult general population of the United Kingdom."@en ;
    obo:IAO_0000116 "NICE PMG51 (27 August 2026) makes the EQ-5D-5L descriptive system with this value set its preferred approach in adults; it should derive all adult utility values in reference-case analyses for topics started on or after that date (PMG51 1.6, 1.7, 1.17, 1.18, Appendix A 4.3.6)."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Rowen et al. 2026" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue -0.567 ;
