    oheo:9000001 23 .

oheo:0000035 a owl:Class ;
    rdfs:label "global quality of life outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the life impact outcome area, covering a person's overall quality of life, assessed as a whole rather than through a single aspect of functioning."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    oboInOwl:hasExactSynonym "Global quality of life"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000004 ;
    oheo:9000001 30 .

oheo:0000036 a owl:Class ;
    rdfs:label "perceived health status outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the life impact outcome area, covering a person's own rating or perception of their health as a whole."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    oboInOwl:hasExactSynonym "Perceived health status"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000004 ;
    oheo:9000001 31 .

oheo:0000038 a owl:Class ;
    rdfs:label "personal circumstances outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the life impact outcome area, covering aspects of a person's life situation affected by health or care, such as housing, finances or independence."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    oboInOwl:hasExactSynonym "Personal circumstances"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000004 ;
    oheo:9000001 33 .

oheo:0000039 a owl:Class ;
    rdfs:label "economic outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the resource use outcome area, covering costs and other economic consequences of illness and care, including productivity losses."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    oboInOwl:hasRelatedSynonym "Economic"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000005 ;
    oheo:9000001 34 .

oheo:0000042 a owl:Class ;
    rdfs:label "societal or carer burden outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the resource use outcome area, covering the burden that illness and care place on carers, families and wider society."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    oboInOwl:hasExactSynonym "Societal/carer burden"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000005 ;
    oheo:9000001 37 .

oheo:0000044 a owl:Class ;
    rdfs:label "adverse events outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the adverse event outcome area, covering outcomes labelled as an unintended consequence of an intervention, such as adverse events or effects, adverse reactions, harm, toxicity and complications."@en ;
    obo:IAO_0000116 "Specifically named adverse events are also classified in the domain for the event type (Dodd et al. 2018)."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    oboInOwl:hasExactSynonym "Adverse events/effects"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000006 ;
    oheo:9000001 38 .

oheo:0000046 a owl:Class ;
    rdfs:label "instrumental activities of daily living outcome domain"@en ;
    obo:IAO_0000115 "A physical functioning outcome domain covering complex tasks needed to live independently, such as shopping, cooking, managing money and using transport."@en ;
    obo:IAO_0000116 "OHEO extension below the COMET taxonomy, added for health economic use."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Lawton and Brody 1969" ;
    oboInOwl:hasRelatedSynonym "IADL"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000030 .

oheo:0000051 a owl:Class ;
    rdfs:label "carer outcome domain"@en ;
    obo:IAO_0000115 "A societal or carer burden outcome domain covering the health, wellbeing and burden of people who provide informal care."@en ;
    obo:IAO_0000116 "An OHEO extension of the COMET outcome taxonomy (Dodd et al. 2018), not one of its 38 domains."@en,
        "OHEO extension below the COMET taxonomy, added for health economic use."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "HealthEconomics.wiki editorial" ;
    oboInOwl:hasExactSynonym "caregiver outcome"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000042 .

oheo:0000055 a owl:Class ;
    rdfs:label "intermediate outcome specification"@en ;
    obo:IAO_0000115 "An outcome specification for an outcome on the causal pathway between an intervention and a final outcome, such as a change in a risk factor or a disease marker."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "Drummond et al. 2015" ;
    oboInOwl:hasExactSynonym "intermediate endpoint"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000053 .

oheo:0000097 a owl:Class ;
    rdfs:label "instrument dimension"@en ;
    obo:IAO_0000112 "The 'anxiety/depression' dimension of the EQ-5D-5L."@en ;
    obo:IAO_0000115 "An information content entity that is a part of an outcome measurement instrument describing one aspect of health, such as mobility or pain, by an ordered set of levels or a group of items."@en ;
