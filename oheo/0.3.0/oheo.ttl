    rdfs:subClassOf obo:STATO_0000039 .

oheo:0000002 a owl:Class ;
    rdfs:label "death outcome area"@en ;
    obo:IAO_0000115 "An outcome domain grouping outcomes that concern whether and when people die, including all-cause and cause-specific mortality and survival."@en ;
    obo:IAO_0000116 "One of the five core areas of the COMET outcome taxonomy."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000001 .

oheo:0000006 a owl:Class ;
    rdfs:label "adverse event outcome area"@en ;
    obo:IAO_0000115 "An outcome domain grouping outcomes that concern unintended consequences of an intervention."@en ;
    obo:IAO_0000116 "One of the five core areas of the COMET outcome taxonomy."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000001 .

oheo:0000011 a owl:Class ;
    rdfs:label "ear and labyrinth outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the physiological or clinical outcome area, covering outcomes associated with the ear and labyrinth system or condition group, such as hearing loss or vertigo."@en ;
    obo:IAO_0000116 "Physiological domains follow MedDRA System Organ Classes, as in the COMET taxonomy."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    oboInOwl:hasExactSynonym "Ear and labyrinth outcomes"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000003 ;
    oheo:9000001 6 .

oheo:0000012 a owl:Class ;
    rdfs:label "eye outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the physiological or clinical outcome area, covering outcomes associated with the eye system or condition group, such as visual acuity or retinal disease."@en ;
    obo:IAO_0000116 "Physiological domains follow MedDRA System Organ Classes, as in the COMET taxonomy."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
    oboInOwl:hasExactSynonym "Eye outcomes"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/oheo> ;
    rdfs:subClassOf oheo:0000003 ;
    oheo:9000001 7 .

oheo:0000023 a owl:Class ;
    rdfs:label "pregnancy, puerperium and perinatal outcome domain"@en ;
    obo:IAO_0000115 "An outcome domain in the physiological or clinical outcome area, covering outcomes associated with the pregnancy, puerperium and perinatal system or condition group, such as preterm birth or birth weight."@en ;
    obo:IAO_0000116 "Physiological domains follow MedDRA System Organ Classes, as in the COMET taxonomy."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    obo:IAO_0000119 "adapted from Dodd et al. 2018" ;
