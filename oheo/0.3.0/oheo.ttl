oheo:2000035 a owl:DatatypeProperty ;
    rdfs:label "has topic start date"@en ;
    obo:IAO_0000112 "2026-09-15"@en ;
    obo:IAO_0000115 "The date on which the appraisal or guideline topic that an analysis belongs to started, such as the date NICE issued its invitation to participate, as an ISO 8601 date (YYYY-MM-DD). Reference case rules that apply prospectively, such as NICE PMG51, key on it."@en ;
    obo:IAO_0000117 <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
