        <rdfs:label xml:lang="en">EQ-5D-5L Netherlands value set (Versteegh 2016)</rdfs:label>
        <ns1:OHEO_9000002 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:OHEO_9000002>
