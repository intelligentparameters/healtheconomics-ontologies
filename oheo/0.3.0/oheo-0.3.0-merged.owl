        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">The form of the outcome variable, such as value at a time point, change from baseline or time to event.</obo:IAO_0000115>
