                <owl:hasValue rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000388"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000001"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">23</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000002"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000006"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000007"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">100</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000008"/>
                <owl:hasValue>higher is better</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000011"/>
                <owl:hasValue>children and adolescents (2 to 18 years)</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A generic paediatric health profile instrument of 23 items in four scales (physical, emotional, social and school functioning), with child self-report and parent proxy-report forms, scored from 0 to 100.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The PedsQL 4.0 Generic Core Scales have child self-report and parent proxy-report forms, so the instrument sits directly under outcome measurement instrument and each version records its reporter with &apos;has reporter type&apos; (0.2.0 fix pass). The reporter-type classes are disjoint, so a version cannot be both self-reported and proxy-reported.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Varni et al. 2001</obo:IAO_0000119>
        <dcterms:source>Varni JW, Seid M, Kurtin PS. PedsQL 4.0: reliability and validity of the Pediatric Quality of Life Inventory version 4.0 generic core scales in healthy and patient populations. Med Care. 2001;39(8):800-12.</dcterms:source>
        <oboInOwl:hasBroadSynonym xml:lang="en">Pediatric Quality of Life Inventory</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym xml:lang="en">PedsQL</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>NCIT:C121522</oboInOwl:hasDbXref>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">PedsQL 4.0 Generic Core Scales</rdfs:label>
        <ns1:OHEO_9000002 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:OHEO_9000002>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000322"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym"/>
        <owl:annotatedTarget xml:lang="en">PedsQL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000323 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000323">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000083"/>
