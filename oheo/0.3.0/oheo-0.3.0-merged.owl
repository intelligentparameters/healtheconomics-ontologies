        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000109"/>
        <obo:IAO_0000115 xml:lang="en">Relates an instrument, a scoring algorithm or a score record to the measurement scale type of the score it yields.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">has measurement scale type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_1000018 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000018">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
