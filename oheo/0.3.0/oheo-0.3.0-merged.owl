    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000167 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000167">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000084"/>
        <rdfs:subClassOf>
