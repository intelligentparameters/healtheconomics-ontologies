        <ns1:OHEO_9000002 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:OHEO_9000002>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000321 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000321">
