        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">obsolete requirement: quality of life reported by patients</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/ontologies/oheo/reference-case-shapes"/>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000354 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000354">
        <obo:IAO_0000115 xml:lang="en">OBSOLETE. An outcome reference case requirement that health effects on informal carers, or other people affected, are counted alongside those on patients, under the conditions the profile states.</obo:IAO_0000115>
