        <dcterms:source>Podsiadlo D, Richardson S. The timed &apos;Up &amp; Go&apos;: a test of basic functional mobility for frail elderly persons. J Am Geriatr Soc. 1991;39(2):142-8.</dcterms:source>
        <oboInOwl:hasDbXref>NCIT:C115795</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">TUG</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">Timed Up and Go test</rdfs:label>
        <ns1:OHEO_9000002 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:OHEO_9000002>
    </owl:Class>
