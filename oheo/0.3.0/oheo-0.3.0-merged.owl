    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000176 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000176">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000174"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000010"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000123"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000031"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000201"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000009"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-0.594</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000012"/>
                <owl:hasValue>UK general population</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An EQ-5D-3L value set elicited by time trade-off from a representative sample of the UK general population in the Measurement and Valuation of Health study, ranging from -0.594 to 1.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The value set the NICE reference case used under PMG36 (2022), applied directly to EQ-5D-3L data or through the NICE DSU mapping from EQ-5D-5L responses (old PMG36 4.3.16). For topics started on or after 27 August 2026, NICE PMG51 uses the UK EQ-5D-5L value set (Rowen et al. 2026) instead, and EQ-5D-3L value set utilities may not be used in sensitivity or scenario analyses (PMG51 1.13).</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Dolan 1997</obo:IAO_0000119>
        <dcterms:source>Dolan P. Modeling valuations for EuroQol health states. Med Care. 1997;35(11):1095-108.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">EQ-5D-3L UK value set (Dolan 1997)</rdfs:label>
        <ns1:OHEO_9000002 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:OHEO_9000002>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000177 -->

