        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has compared condition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_1000030 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000030">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000030"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000034"/>
