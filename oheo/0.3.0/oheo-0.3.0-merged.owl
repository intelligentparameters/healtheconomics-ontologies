    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_1000030 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000030">
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/STATO_0000471"/>
        <obo:IAO_0000115 xml:lang="en">Relates an analysis, or the application of a rule within it, to an estimate whose value it uses, such as the QALY shortfall estimates that decide a severity weight.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">uses estimate</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_1000031 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000031">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000105"/>
                    <rdf:Description rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000400"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000194"/>
        <obo:IAO_0000115 xml:lang="en">Relates a value set or an index value set to the kind of preference elicitation process by which the preferences it rests on were elicited, such as composite time trade-off. Named so as not to be confused with the RHEO datatype property has valuation method (RHEO_2000023).</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">value set elicited by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_1000032 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000032">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/IAO_0000109"/>
        <obo:IAO_0000115 xml:lang="en">Relates a RHEO utility measurement record or an instrument score record to the record of the responses it was calculated from, such as the RHEO state observation of one person&apos;s EQ-5D profile.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">scored from observation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_1000033 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000033">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000092"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000090"/>
        <obo:IAO_0000115 xml:lang="en">Relates a RHEO QALY record to a RHEO utility measurement record whose value and time point it was calculated from.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">calculated from utility record</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_1000034 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000034">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000105"/>
        <obo:IAO_0000115 xml:lang="en">Relates an outcome measurement instrument to a value set that has been published for its descriptive system. An instrument with one is a preference-based measure.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">has published value set</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_1000035 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000035">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000385"/>
        <obo:IAO_0000115 xml:lang="en">Relates an outcome measurement instrument to a value that classifies it, such as generic design.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">has instrument classification</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_1000036 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000036">
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000327"/>
        <obo:IAO_0000115 xml:lang="en">Relates an analysis, such as a QALY calculation process or a model run, to the reference case profile whose requirements it claims to meet. The claim is checked by that profile&apos;s SHACL shape.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">claims conformance to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_1000037 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000037">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000327"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000327"/>
        <obo:IAO_0000115 xml:lang="en">Relates a reference case profile to an earlier profile of the same body that it replaces for new evaluations.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">supersedes reference case profile</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_1000038 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000038">
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000107"/>
        <obo:IAO_0000115 xml:lang="en">Relates a RHEO utility measurement record or utility estimate to the mapping function used to predict it from responses to another instrument.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">mapped with function</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_1000039 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000039">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000400"/>
        <obo:IAO_0000115 xml:lang="en">Relates an outcome measurement instrument to a capability or care-related index value set published for its descriptive system. Such an instrument is not thereby a preference-based measure.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">has published index value set</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_1000040 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000040">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000385"/>
        <obo:IAO_0000115 xml:lang="en">Relates an outcome measurement instrument, usually one version of it, to who completes or rates it: the person themselves, an observer or proxy, or a clinician.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from FDA-NIH Biomarker Working Group 2016 (BEST Resource)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">has reporter type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_1000001 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000001">
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000004"/>
        <obo:IAO_0000115 xml:lang="en">Relates an estimate, an assumption or an estimand to the population specification it is intended to apply to.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">applies to population</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_1000002 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000002">
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000021"/>
        <obo:IAO_0000115 xml:lang="en">Relates a utility estimate or an assumed utility to the health state description it values. A utility measured in people values a clinical or classification state description, not a model state.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">values health state</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_1000003 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000003">
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000005"/>
        <obo:IAO_0000115 xml:lang="en">Relates a probability, rate or relative effect estimate, or an assumption, to the kind of clinical event it concerns.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">concerns event type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_1000004 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000004">
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000121"/>
        <obo:IAO_0000115 xml:lang="en">Relates a cost, resource use or emission factor estimate, a resource use or work absence record, or an assumption, to the costed item type specification (a kind of care process or a kind of resource) that it values or counts.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">concerns costed item type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_1000005 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000005">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000011"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000010"/>
        <obo:IAO_0000115 xml:lang="en">Relates an economic evaluation estimate to the estimand it is an estimate of.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">estimates</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_1000006 -->

