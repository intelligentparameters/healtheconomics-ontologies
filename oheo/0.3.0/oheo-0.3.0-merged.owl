        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000007"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">30</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000008"/>
                <owl:hasValue>higher is worse</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A patient-reported outcome measure of ten items screening for depression in the perinatal period, covering the past seven days and scored from 0 to 30.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Reports a single total score, so it is not classed as a health profile instrument (0.2.0 fix pass).</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Cox et al. 1987</obo:IAO_0000119>
        <dcterms:source>Cox JL, Holden JM, Sagovsky R. Detection of postnatal depression. Development of the 10-item Edinburgh Postnatal Depression Scale. Br J Psychiatry. 1987;150:782-6.</dcterms:source>
        <oboInOwl:hasDbXref>NCIT:C131844</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Edinburgh Postnatal Depression Scale</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">EPDS</rdfs:label>
        <ns1:OHEO_9000002 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:OHEO_9000002>
    </owl:Class>
    


