        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000094"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000100"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000104"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000106"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000112"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000113"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000114"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000128"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000129"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000130"/>
        <obo:IAO_0000115 xml:lang="en">A data entity recording a household&apos;s total consumption expenditure or income over a stated period, in a stated currency.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">household economic record</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000082 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000082">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000011"/>
        <obo:IAO_0000115 xml:lang="en">An economic evaluation estimate of the rate at which amounts in one currency or price year convert to another, such as an exchange rate or a purchasing power parity conversion factor.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">currency conversion estimate</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000083 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000083">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000093"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000103"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000108"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000109"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000117"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000134"/>
        <obo:IAO_0000115 xml:lang="en">A directive information entity issued by a decision-making body after a health technology assessment decision process, stating whether and on what terms a technology is to be funded.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">health technology assessment recommendation</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000084 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000084">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000011"/>
        <obo:IAO_0000115 xml:lang="en">An economic evaluation estimate of how well a diagnostic test classifies people, such as its sensitivity or specificity, in a stated population against a stated reference standard.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">test accuracy estimate</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000090 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000090">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000109"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000092"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000094"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000100"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000104"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000106"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000112"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000113"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000114"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000128"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000129"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000130"/>
        <obo:IAO_0000115 xml:lang="en">A measurement datum recording a person&apos;s preference-based health state value at a stated time, obtained with a stated instrument and value set.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Records of individual people over time; a utility estimate (RHEO_0000012) is a summary across people.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">utility measurement record</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000091 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000091">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0000082"/>
        <obo:IAO_0000115 xml:lang="en">A planned process in which quality-adjusted life years are calculated from utility values and the time over which they apply, with or without discounting.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">QALY calculation process</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000092 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000092">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000094"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000100"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000104"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000106"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000112"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000113"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000114"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000128"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000129"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000130"/>
        <obo:IAO_0000115 xml:lang="en">A data entity recording the quality-adjusted life years accrued by a person or a group over a stated period, undiscounted or discounted at a stated annual rate.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">QALY record</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000093 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000093">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000103"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000108"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000109"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000117"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000134"/>
        <obo:IAO_0000115 xml:lang="en">A directive information entity stating the annual discount rates for costs and for health outcomes and the base year to which future values are discounted.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">discounting specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000094 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000094">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000100"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000104"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000106"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000112"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000113"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000114"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000128"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000129"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000130"/>
        <obo:IAO_0000115 xml:lang="en">A data entity recording the disability-adjusted life years of a person or a group over a stated period, as the sum of years of life lost to premature death and years lived with disability.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Murray 1994</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">DALY record</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000095 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000095">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000011"/>
        <obo:IAO_0000115 xml:lang="en">An economic evaluation estimate of the severity of a health state on a scale on which 0 is full health and 1 is equivalent to death, used to calculate years lived with disability.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Murray 1994</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">disability weight estimate</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000096 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000096">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0000082"/>
        <obo:IAO_0000115 xml:lang="en">A planned process in which an organization delivers an intervention to a population rather than to individual patients, such as distributing insecticide-treated bed nets or running a vaccination campaign.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">public health programme</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000097 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000097">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000027"/>
        <obo:IAO_0000115 xml:lang="en">An object aggregate of persons who bear a health care provider role in a stated organization or care setting at a time, such as the registered nurses of a ward.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Its size is recorded by stock measurements (for example in full-time equivalents) and its changes by flow measurements of joiners and leavers.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">workforce</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000098 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000098">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000078"/>
        <obo:IAO_0000115 xml:lang="en">A price agreement under which the payment for a health technology depends on the outcome observed in each patient or in a group, such as paying only for patients who respond at a stated time.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">outcomes-based agreement</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000099 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000099">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
        <obo:IAO_0000115 xml:lang="en">A plan specification describing one of the groups to which participants in a randomised trial are allocated, and the intervention that group receives.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">trial arm specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000100 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000100">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
