                <owl:hasValue>higher is better</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A performance outcome measure in which a person walks as far as possible in six minutes on a flat course, recorded as distance in metres.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>American Thoracic Society 2002</obo:IAO_0000119>
        <dcterms:source>ATS Committee on Proficiency Standards for Clinical Pulmonary Function Laboratories. ATS statement: guidelines for the six-minute walk test. Am J Respir Crit Care Med. 2002;166(1):111-7.</dcterms:source>
        <oboInOwl:hasDbXref>NCIT:C115789</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">6-minute walk test</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">6MWT</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">six-minute walk test</rdfs:label>
        <ns1:OHEO_9000002 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:OHEO_9000002>
    </owl:Class>
