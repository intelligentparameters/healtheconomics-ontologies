            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An osteoarthritis-specific patient-reported outcome measure of 24 items in three subscales: pain, stiffness and physical function.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Bellamy et al. 1988</obo:IAO_0000119>
        <dcterms:source>Bellamy N, Buchanan WW, Goldsmith CH, Campbell J, Stitt LW. Validation study of WOMAC: a health status instrument for measuring clinically important patient relevant outcomes to antirheumatic drug therapy in patients with osteoarthritis of the hip or knee. J Rheumatol. 1988;15(12):1833-40.</dcterms:source>
        <oboInOwl:hasExactSynonym xml:lang="en">Western Ontario and McMaster Universities Osteoarthritis Index</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">WOMAC</rdfs:label>
        <ns1:OHEO_9000002 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:OHEO_9000002>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000327 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000327">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <obo:IAO_0000115 xml:lang="en">A directive information entity that states the methods an economic evaluation must use to meet the standard of a decision-making body or methods panel, so that results are comparable across analyses.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The named profiles are individuals of this class (0.2.0). Their requirements are published as SHACL shapes in oheo-reference-case-shapes.ttl, one shape for each profile, and an analysis that claims conformance to a profile is checked against its shape.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>NICE 2022 (PMG36)</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">methods reference case</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">reference case</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">reference case profile</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000328 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000328">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <obo:IAO_0000115 xml:lang="en">A directive information entity that states one rule a reference case profile sets for how health outcomes are measured, valued, sourced or discounted.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Specific requirements are constraints in the SHACL shapes of oheo-reference-case-shapes.ttl. The 45 requirement classes of 0.1.0 are obsolete.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>NICE 2022 (PMG36)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">outcome reference case requirement</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000329 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000329">
        <obo:IAO_0000115 xml:lang="en">OBSOLETE. An outcome reference case requirement that health effects are expressed in quality-adjusted life years.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Made obsolete in 0.2.0. Reference case requirements are now published as SHACL shapes (oheo-reference-case-shapes.ttl), one shape for each reference case profile, because an OWL class with &apos;some&apos; restrictions cannot check that an analysis meets a requirement. The requirement this class stated is a constraint in the shape of each profile that set it.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <obo:IAO_0000231 rdf:resource="http://purl.obolibrary.org/obo/OMO_0001000"/>
        <oboInOwl:consider rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000328"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">obsolete requirement: QALYs as the measure of health effect</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/ontologies/oheo/reference-case-shapes"/>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000330 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000330">
        <obo:IAO_0000115 xml:lang="en">OBSOLETE. An outcome reference case requirement that health effects are reported both in quality-adjusted life years and in equal value life-years gained.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Made obsolete in 0.2.0. Reference case requirements are now published as SHACL shapes (oheo-reference-case-shapes.ttl), one shape for each reference case profile, because an OWL class with &apos;some&apos; restrictions cannot check that an analysis meets a requirement. The requirement this class stated is a constraint in the shape of each profile that set it.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <obo:IAO_0000231 rdf:resource="http://purl.obolibrary.org/obo/OMO_0001000"/>
        <oboInOwl:consider rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000328"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">obsolete requirement: QALYs and evLYG as the measures of health effect</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/ontologies/oheo/reference-case-shapes"/>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000331 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000331">
        <obo:IAO_0000115 xml:lang="en">OBSOLETE. An outcome reference case requirement that health effects are reported in quality-adjusted life years, with an accompanying analysis in life-years gained.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Made obsolete in 0.2.0. Reference case requirements are now published as SHACL shapes (oheo-reference-case-shapes.ttl), one shape for each reference case profile, because an OWL class with &apos;some&apos; restrictions cannot check that an analysis meets a requirement. The requirement this class stated is a constraint in the shape of each profile that set it.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <obo:IAO_0000231 rdf:resource="http://purl.obolibrary.org/obo/OMO_0001000"/>
        <oboInOwl:consider rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000328"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">obsolete requirement: QALYs and life-years as the measures of health effect</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/ontologies/oheo/reference-case-shapes"/>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000332 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000332">
        <obo:IAO_0000115 xml:lang="en">OBSOLETE. An outcome reference case requirement that benefits are measured by patient-relevant endpoints (mortality, morbidity and health-related quality of life) and compared with costs on an efficiency frontier, with QALYs as one possible aggregate measure.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Made obsolete in 0.2.0. Reference case requirements are now published as SHACL shapes (oheo-reference-case-shapes.ttl), one shape for each reference case profile, because an OWL class with &apos;some&apos; restrictions cannot check that an analysis meets a requirement. The requirement this class stated is a constraint in the shape of each profile that set it.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <obo:IAO_0000231 rdf:resource="http://purl.obolibrary.org/obo/OMO_0001000"/>
        <oboInOwl:consider rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000328"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">obsolete requirement: patient-relevant endpoints on an efficiency frontier</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/ontologies/oheo/reference-case-shapes"/>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000333 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000333">
        <obo:IAO_0000115 xml:lang="en">OBSOLETE. An outcome reference case requirement that EQ-5D is the preferred measure of health-related quality of life in adults.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Made obsolete in 0.2.0. Reference case requirements are now published as SHACL shapes (oheo-reference-case-shapes.ttl), one shape for each reference case profile, because an OWL class with &apos;some&apos; restrictions cannot check that an analysis meets a requirement. The requirement this class stated is a constraint in the shape of each profile that set it.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <obo:IAO_0000231 rdf:resource="http://purl.obolibrary.org/obo/OMO_0001000"/>
