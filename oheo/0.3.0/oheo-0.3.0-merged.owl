                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000032"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000001"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000033"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000001"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000048"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
