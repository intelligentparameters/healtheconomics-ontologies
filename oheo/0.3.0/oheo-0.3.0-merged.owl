        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <obo:IAO_0000115 xml:lang="en">The time from origin to event or censoring in a time-to-event record, in the unit stated by &apos;has unit label&apos;.</obo:IAO_0000115>
