    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000355 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000355">
        <obo:IAO_0000115 xml:lang="en">OBSOLETE. An outcome reference case requirement that an additional QALY has the same weight whoever receives it, except where a decision modifier applies.</obo:IAO_0000115>
