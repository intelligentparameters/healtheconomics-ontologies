            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A CHU9D value set elicited by standard gamble from a sample of the UK adult general population.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Stevens 2012</obo:IAO_0000119>
        <dcterms:source>Stevens K. Valuation of the Child Health Utility 9D Index. Pharmacoeconomics. 2012;30(8):729-47.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">CHU9D UK value set (Stevens 2012)</rdfs:label>
        <ns1:OHEO_9000002 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:OHEO_9000002>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000184 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000184">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000400"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000010"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000139"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000031"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000215"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000012"/>
                <owl:hasValue>UK general population</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A capability or care-related index value set of capability index values for ICECAP-A states, elicited by best-worst scaling from a sample of the UK general population, running from no capability (0) to full capability (1).</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Values run from 0 (no capability) to 1 (full capability) rather than from dead to full health.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Flynn et al. 2015</obo:IAO_0000119>
        <dcterms:source>Flynn TN, Huynh E, Peters TJ, et al. Scoring the ICECAP-A capability instrument. Estimation of a UK general population tariff. Health Econ. 2015;24(3):258-69.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">ICECAP-A UK index values (Flynn 2015)</rdfs:label>
        <ns1:OHEO_9000002 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:OHEO_9000002>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000185 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000185">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000108"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000011"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000124"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000012"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000123"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A crosswalk that assigns EQ-5D-3L values to EQ-5D-5L health states using a response mapping estimated from people who completed both instruments.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>van Hout et al. 2012</obo:IAO_0000119>
        <dcterms:source>van Hout B, Janssen MF, Feng YS, et al. Interim scoring for the EQ-5D-5L: mapping the EQ-5D-5L to EQ-5D-3L value sets. Value Health. 2012;15(5):708-15.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">EQ-5D-5L to EQ-5D-3L crosswalk (van Hout 2012)</rdfs:label>
        <ns1:OHEO_9000002 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:OHEO_9000002>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000186 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000186">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000108"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000011"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000124"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000012"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000123"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A crosswalk that predicts EQ-5D-3L UK utilities from EQ-5D-5L responses using the NICE Decision Support Unit mapping function, estimated on the EEPRU dataset in which people completed both versions.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The mapping NICE PMG36 (2022) asked for when EQ-5D-5L data were collected: EQ-5D-5L responses mapped to the EQ-5D-3L UK value set (old PMG36 4.3.16, quoted in PMG51). Topics started before 27 August 2026 keep this approach (PMG51 1.17, 1.18).</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Hernandez Alava et al. 2017</obo:IAO_0000119>
        <dcterms:source>Hernández Alava et al. 2017 (NICE Decision Support Unit report), using the EEPRU dataset (Hernández Alava M, Pudney S, Wailoo A. Pharmacoeconomics. 2023;41(2):199-207), as cited in NICE PMG36 4.3.16 and PMG51.</dcterms:source>
        <oboInOwl:hasRelatedSynonym xml:lang="en">DSU mapping</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">EEPRU mapping</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">Hernández Alava mapping</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">EQ-5D-5L to EQ-5D-3L mapping (NICE DSU, Hernandez Alava 2017)</rdfs:label>
        <ns1:OHEO_9000002 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:OHEO_9000002>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000187 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000187">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0000082"/>
        <obo:IAO_0000115 xml:lang="en">A planned process in which an outcome measurement instrument is administered to, or a performance task is carried out by, a person and their responses are scored to produce an outcome measurement datum.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The process that realises an instrument. Its output is an outcome measurement datum.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">instrument administration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">outcome measurement</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">outcome assessment process</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000188 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000188">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that states how an instrument is administered, such as self-completion on paper, electronic self-completion, interview or proxy completion.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Coons et al. 2009; FDA 2009</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">mode of administration</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">instrument administration mode</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000189 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000189">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000109"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000066"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000090"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000092"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000094"/>
        <obo:IAO_0000115 xml:lang="en">A measurement datum recording the value of an outcome for one person at a stated time, obtained with a stated instrument version or under stated criteria. A health state profile is recorded instead as a RHEO state observation, and a utility as a RHEO utility measurement record.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">An OHEO modelling term; its definition source is editorial by design.</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">Instrument scores name their instrument version (instrument score record); tumour response and adverse event records name their classification criteria; a time-to-event record needs neither (0.2.0 fix pass).</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">Records concern one person. Summaries across people are estimates. OHEO declares this class disjoint from the RHEO state observation, utility measurement record, QALY record and DALY record, so that each record has one type where the two ontologies are used together.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">outcome record</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">individual outcome value</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">outcome measurement datum</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000190 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000190">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000189"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000013"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000112 xml:lang="en">SF-36 physical component score of 42.3 at 6 months.</obo:IAO_0000112>
        <obo:IAO_0000115 xml:lang="en">An outcome measurement datum recording a score, or set of dimension scores, obtained by applying a scoring algorithm to one person&apos;s responses to an instrument.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">An OHEO modelling term; its definition source is editorial by design.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">instrument score record</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000191 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000191">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000189"/>
        <obo:IAO_0000115 xml:lang="en">An outcome measurement datum recording, for one person, the time from a stated origin to an event of a stated type or to censoring, with an indicator of which occurred.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">survival time record</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">time-to-event record</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000192 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000192">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000189"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000016"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000114"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An outcome measurement datum recording the tumour response category assigned to one person at an assessment under stated response criteria.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Eisenhauer et al. 2009</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">tumour response assessment record</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000193 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000193">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000189"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OAE_0000001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An outcome measurement datum recording that one person experienced an adverse event of a stated type, with its onset, grade under stated criteria and attribution where known.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The record is about an adverse event (OAE), which is a real process in the person.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>ICH E2A 1994</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">adverse event record</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000194 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000194">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0000082"/>
        <obo:IAO_0000115 xml:lang="en">A planned process in which people&apos;s preferences between outcomes, health states or attributes are obtained and quantified.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">preference measurement</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">preference elicitation process</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000195 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000195">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000194"/>
        <obo:IAO_0000115 xml:lang="en">A preference elicitation process in which respondents state their preferences in answer to hypothetical questions, rather than revealing them through actual choices.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">stated preference method</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">SP</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">stated preference elicitation process</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000195"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">SP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000196 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000196">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000194"/>
        <obo:IAO_0000115 xml:lang="en">A preference elicitation process that obtains values or orderings for health states, from which utilities on a scale on which full health is 1 and dead is 0 are taken directly or estimated by modelling.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">health state valuation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">utility elicitation</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">health state valuation process</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000197 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000197">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000196"/>
        <obo:IAO_0000115 xml:lang="en">A health state valuation process in which respondents value health states themselves by a choice or rating task, a stated preference task.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Direct valuation tasks are stated preference tasks; that classification was a second parent in 0.1.0 and is now carried by this definition.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">direct elicitation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">direct utility assessment</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">direct health state valuation process</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000198 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000198">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000196"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000014"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000105"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A health state valuation process in which a person&apos;s responses to a preference-based measure are converted to a utility using an existing value set, without the person valuing states themselves.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The usual source of utilities for QALYs in trials. Inputs: a RHEO state observation and a value set; output: a RHEO utility measurement record.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">indirect utility assessment</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">indirect health state valuation process</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000199 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000199">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000196"/>
        <obo:IAO_0000115 xml:lang="en">A health state valuation process in which utilities are predicted from responses to another instrument by applying a mapping function.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Wailoo et al. 2017</obo:IAO_0000119>
        <oboInOwl:hasRelatedSynonym xml:lang="en">cross-walking</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">mapping</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">utility mapping process</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000200 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000200">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000197"/>
        <obo:IAO_0000115 xml:lang="en">A direct health state valuation process in which the respondent chooses between a health state for certain and a gamble between full health and death, and the probability of full health is varied until they are indifferent.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The utility of the state equals the probability of full health at indifference. Grounded in expected utility theory; responses can include risk attitude.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">SG</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">standard gamble</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000200"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">SG</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000201 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000201">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000197"/>
        <obo:IAO_0000115 xml:lang="en">A direct health state valuation process in which the respondent chooses between a longer time in a health state and a shorter time in full health, and the shorter time is varied until they are indifferent.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">TTO</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">time trade-off</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000201"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">TTO</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000202 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000202">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000201"/>
        <obo:IAO_0000115 xml:lang="en">A time trade-off in which states better than dead and states worse than dead are valued with different procedures.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Torrance 1986</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">conventional TTO</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">conventional time trade-off</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000203 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000203">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000201"/>
        <obo:IAO_0000115 xml:lang="en">A time trade-off in which a period of full health is added before both alternatives, so that states worse than dead can be valued in the same task as states better than dead.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Robinson and Spencer 2006; Devlin et al. 2011</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">LT-TTO</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">lead-time TTO</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">lead-time time trade-off</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000203"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">LT-TTO</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000204 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000204">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000201"/>
        <obo:IAO_0000115 xml:lang="en">A time trade-off that values states better than dead by conventional time trade-off and states worse than dead by lead-time time trade-off, as in the EQ-VT protocol.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Oppe et al. 2014</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">cTTO</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">composite TTO</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">composite time trade-off</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000204"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">cTTO</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000205 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000205">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000197"/>
        <obo:IAO_0000115 xml:lang="en">A direct health state valuation process in which the respondent marks the position of a health state on a line anchored by best and worst imaginable health.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">A rating, not a choice: VAS values are not utilities without transformation.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <oboInOwl:hasRelatedSynonym xml:lang="en">VAS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">rating scale</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">visual analogue scale rating</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000205"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">VAS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000206 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000206">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000197"/>
        <obo:IAO_0000115 xml:lang="en">A direct health state valuation process in which the respondent states how many people in one health state they consider equivalent, in social value, to a given number of people in another state.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Nord 1995</obo:IAO_0000119>
        <dcterms:source>Nord E. The person-trade-off approach to valuing health care programs. Med Decis Making. 1995;15(3):201-8.</dcterms:source>
        <oboInOwl:hasExactSynonym xml:lang="en">PTO</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">equivalence of numbers</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">person trade-off</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000206"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">PTO</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000207 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000207">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000197"/>
        <obo:IAO_0000115 xml:lang="en">A direct health state valuation process in which the respondent puts a set of health states in order of preference.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">ranking method</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">health state ranking</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000208 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000208">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000197"/>
        <obo:IAO_0000115 xml:lang="en">A direct health state valuation process in which the respondent is shown two health states at a time and says which they prefer.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">paired comparison</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000209 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000209">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000197"/>
        <obo:IAO_0000115 xml:lang="en">A direct health state valuation process in which the respondent states how many times better or worse one health state is than another.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">ratio scaling</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000210 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000210">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000209"/>
        <obo:IAO_0000115 xml:lang="en">A ratio scaling process in which the respondent assigns numbers to health states in proportion to their perceived magnitude relative to a reference state.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">magnitude estimation</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000211 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000211">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000197"/>
        <obo:IAO_0000115 xml:lang="en">A direct health state valuation process that uses discrete choice tasks in which survival duration is an attribute, so that values can be anchored on the scale on which dead is 0.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">It uses the tasks of a discrete choice experiment; it is classified here by its purpose, valuing health states on the scale on which dead is 0, beside time trade-off and standard gamble.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Bansback et al. 2012</obo:IAO_0000119>
        <dcterms:source>Bansback N, Brazier J, Tsuchiya A, Anis A. Using a discrete choice experiment to estimate health state utility values. J Health Econ. 2012;31(1):306-18.</dcterms:source>
        <oboInOwl:hasExactSynonym xml:lang="en">DCE with duration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">DCE-TTO</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">discrete choice experiment with duration</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000211"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">DCE-TTO</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000212 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000212">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000195"/>
        <obo:IAO_0000115 xml:lang="en">A stated preference elicitation process that estimates how much each attribute of a good or service contributes to its value, from respondents&apos; ratings, rankings or choices of described alternatives.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Bridges et al. 2011</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">conjoint analysis</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000213 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000213">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000195"/>
        <obo:IAO_0000115 xml:lang="en">A stated preference elicitation process in which respondents choose among systematically varied alternatives described by attributes, and attribute values are estimated from their choices under a random utility model.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Placed beside conjoint analysis, not under it, following Louviere, Flynn and Carson 2010 (0.2.0 fix pass).</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Louviere, Flynn and Carson 2010</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">choice experiment</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000214 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000214">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000213"/>
        <obo:IAO_0000115 xml:lang="en">A choice experiment in which respondents complete repeated choice tasks, each choosing one alternative from a choice set described by attributes and levels.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Bridges et al. 2011</obo:IAO_0000119>
        <dcterms:source>Bridges JF, Hauber AB, Marshall D, et al. Conjoint analysis applications in health: a checklist. A report of the ISPOR Good Research Practices for Conjoint Analysis Task Force. Value Health. 2011;14(4):403-13.</dcterms:source>
        <oboInOwl:hasDbXref>NCIT:C184753</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">DCE</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">CBC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">choice-based conjoint</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">discrete choice experiment</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000214"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">DCE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000214"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">CBC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000215 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000215">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000195"/>
        <obo:IAO_0000115 xml:lang="en">A stated preference elicitation process in which respondents choose the best and the worst item, attribute level or profile in each set presented.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Flynn et al. 2007</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">BWS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">MaxDiff</oboInOwl:hasNarrowSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">best-worst scaling</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000215"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">BWS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000215"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget xml:lang="en">MaxDiff</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000216 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000216">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000195"/>
        <obo:IAO_0000115 xml:lang="en">A stated preference elicitation process in which respondents divide a fixed number of points, often 100, among outcomes or criteria to show their relative importance.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">constant-sum scaling</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">point allocation method</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">point allocation</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000217 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000217">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000194"/>
        <obo:IAO_0000115 xml:lang="en">A preference elicitation process that expresses the value of a health outcome or other non-market good in money.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">monetary valuation</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">monetary valuation process</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000218 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000218">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000217"/>
        <obo:IAO_0000115 xml:lang="en">A monetary valuation process in which respondents state, in a described hypothetical market, the most they would pay for a benefit or the least they would accept as compensation for a loss, a stated preference task.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Contingent valuation is a stated preference method; that was a second parent in 0.1.0 and is now carried by the definition.</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">Open to anchoring bias from starting bids and payment card ranges.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">CVM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">contingent valuation method</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">contingent valuation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000218"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">CVM</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000219 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000219">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000218"/>
        <obo:IAO_0000115 xml:lang="en">A contingent valuation in which respondents state the most they would pay for a stated gain.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">WTP elicitation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">willingness-to-pay estimation</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">willingness-to-pay elicitation</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000220 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000220">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000218"/>
        <obo:IAO_0000115 xml:lang="en">A contingent valuation in which respondents state the least compensation they would accept for a stated loss.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">WTA elicitation</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">willingness-to-accept elicitation</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000221 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000221">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000217"/>
        <obo:IAO_0000115 xml:lang="en">A monetary valuation process that applies value estimates from existing studies to a new but related policy context instead of conducting a new valuation study.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Johnston et al. 2015</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">benefit transfer</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000222 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000222">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000221"/>
        <obo:IAO_0000115 xml:lang="en">A benefit transfer in which a meta-regression across original studies predicts the value for the new context from its characteristics.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Johnston et al. 2015</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">meta-regression transfer</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">meta-regression benefit transfer</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000223 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000223">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0500000"/>
        <obo:IAO_0000115 xml:lang="en">A study design for a preference elicitation study, stating the states or alternatives to be valued, the elicitation tasks, the sample and the analysis.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">valuation protocol</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">valuation study design</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000224 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000224">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000223"/>
        <obo:IAO_0000115 xml:lang="en">A valuation study design for EQ-5D-5L value sets that combines composite time trade-off and discrete choice tasks in computer-assisted interviews.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Oppe et al. 2014</obo:IAO_0000119>
        <dcterms:source>Oppe M, Devlin NJ, van Hout B, Krabbe PF, de Charro F. A program of methodological research to arrive at the new international EQ-5D-5L valuation protocol. Value Health. 2014;17(4):445-53.</dcterms:source>
        <oboInOwl:hasExactSynonym xml:lang="en">EuroQol Valuation Technology</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">EQ-VT protocol</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000225 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000225">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000223"/>
        <obo:IAO_0000115 xml:lang="en">A valuation study design that sets out the attributes, levels and choice sets presented in a choice experiment.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Reed Johnson et al. 2013</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">experimental design (choice)</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">choice experiment design</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000226 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000226">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000225"/>
        <obo:IAO_0000115 xml:lang="en">A choice experiment design in which attribute levels vary independently of each other across choice sets.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Reed Johnson et al. 2013</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">orthogonal design</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000227 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000227">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000225"/>
        <obo:IAO_0000115 xml:lang="en">A choice experiment design chosen to maximise the statistical information about model parameters for a given number of choice tasks.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Reed Johnson et al. 2013</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">efficient design</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000228 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000228">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000227"/>
        <obo:IAO_0000115 xml:lang="en">An efficient design chosen to minimise the determinant of the expected variance-covariance matrix of the model parameters.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Reed Johnson et al. 2013</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">D-efficient design</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000229 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000229">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that is the group of alternatives presented to a respondent in one choice task.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Reed Johnson et al. 2013</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">choice set</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000230 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000230">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/STATO_0000107"/>
        <obo:IAO_0000115 xml:lang="en">A statistical model that relates the probability of choosing an alternative to its attributes under a random utility framework.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Train 2009</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">discrete choice model</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">choice model</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000231 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000231">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000230"/>
        <obo:IAO_0000115 xml:lang="en">A choice model that assumes identical preferences across respondents and independent, identically distributed extreme value errors.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Train 2009</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">MNL</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">conditional logit model</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">multinomial logit model</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000231"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">MNL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000232 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000232">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000230"/>
        <obo:IAO_0000115 xml:lang="en">A choice model in which preference parameters vary across respondents according to stated distributions.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Train 2009</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">mixed logit model</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">random parameter model</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">random parameters logit model</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000233 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000233">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000230"/>
        <obo:IAO_0000115 xml:lang="en">A choice model that assumes respondents belong to a finite number of unobserved classes with different preferences, and estimates class preferences and membership probabilities.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Train 2009</obo:IAO_0000119>
        <oboInOwl:hasBroadSynonym xml:lang="en">latent class model</oboInOwl:hasBroadSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">latent class choice model</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000234 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000234">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000066"/>
        <obo:IAO_0000115 xml:lang="en">An investigation that designs, conducts and analyses a preference elicitation study in a stated population to produce a value set for a health state classification system.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <oboInOwl:hasBroadSynonym xml:lang="en">valuation study</oboInOwl:hasBroadSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">value set development study</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000235 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000235">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000066"/>
        <obo:IAO_0000115 xml:lang="en">An investigation that estimates a mapping function from data in which source and target instruments were collected from the same people.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Wailoo et al. 2017</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">mapping study</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">mapping function development study</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000236 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000236">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000066"/>
        <obo:IAO_0000115 xml:lang="en">An investigation that identifies candidate outcomes and reaches agreement among stakeholders, often by Delphi survey and consensus meeting, on a core outcome set.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Williamson et al. 2017 (COMET Handbook)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">core outcome set development study</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000237 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000237">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000066"/>
        <obo:IAO_0000115 xml:lang="en">An investigation that assesses a measurement property of an outcome measurement instrument in a stated population and context of use.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Subclasses follow the COSMIN taxonomy of reliability, validity and responsiveness, plus interpretability.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from Mokkink et al. 2010 (COSMIN)</obo:IAO_0000119>
        <dcterms:source>Mokkink LB, Terwee CB, Patrick DL, et al. The COSMIN study reached international consensus on taxonomy, terminology, and definitions of measurement properties for health-related patient-reported outcomes. J Clin Epidemiol. 2010;63(7):737-45.</dcterms:source>
        <oboInOwl:hasExactSynonym xml:lang="en">psychometric evaluation</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">measurement property evaluation</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000238 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000238">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000237"/>
        <obo:IAO_0000115 xml:lang="en">A measurement property evaluation that assesses the degree to which scores for people who have not changed are the same for repeated measurement.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from Mokkink et al. 2010 (COSMIN)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">reliability evaluation</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000239 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000239">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000238"/>
        <obo:IAO_0000115 xml:lang="en">A reliability evaluation that assesses the degree of interrelatedness among the items of a scale.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from Mokkink et al. 2010 (COSMIN)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">internal consistency evaluation</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000240 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000240">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000238"/>
        <obo:IAO_0000115 xml:lang="en">A reliability evaluation that assesses the agreement between scores obtained on separate occasions from people whose health has not changed.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from Mokkink et al. 2010 (COSMIN)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">test-retest reliability evaluation</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000241 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000241">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000238"/>
        <obo:IAO_0000115 xml:lang="en">A reliability evaluation that assesses the systematic and random error in a person&apos;s score that is not attributable to true change.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from Mokkink et al. 2010 (COSMIN)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">measurement error evaluation</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000242 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000242">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000237"/>
        <obo:IAO_0000115 xml:lang="en">A measurement property evaluation that assesses the degree to which an instrument measures the construct it claims to measure.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from Mokkink et al. 2010 (COSMIN)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">validity evaluation</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000243 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000243">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000242"/>
        <obo:IAO_0000115 xml:lang="en">A validity evaluation that assesses the degree to which the content of an instrument adequately reflects the construct to be measured.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from Mokkink et al. 2010 (COSMIN)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">content validity evaluation</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000244 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000244">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000242"/>
        <obo:IAO_0000115 xml:lang="en">A validity evaluation that assesses the degree to which scores are consistent with hypotheses about relationships with other measures or differences between groups.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from Mokkink et al. 2010 (COSMIN)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">construct validity evaluation</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000245 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000245">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000244"/>
        <obo:IAO_0000115 xml:lang="en">A construct validity evaluation that assesses the degree to which scores adequately reflect the dimensionality of the construct.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from Mokkink et al. 2010 (COSMIN)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">structural validity evaluation</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000246 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000246">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000244"/>
        <obo:IAO_0000115 xml:lang="en">A construct validity evaluation that assesses the degree to which a translated or culturally adapted instrument performs like the original.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from Mokkink et al. 2010 (COSMIN)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">cross-cultural validity evaluation</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000247 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000247">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000242"/>
        <obo:IAO_0000115 xml:lang="en">A validity evaluation that assesses the degree to which scores adequately reflect a gold standard.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from Mokkink et al. 2010 (COSMIN)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">criterion validity evaluation</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000248 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000248">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000237"/>
        <obo:IAO_0000115 xml:lang="en">A measurement property evaluation that assesses the ability of an instrument to detect change over time in the construct measured.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from Mokkink et al. 2010 (COSMIN)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">responsiveness evaluation</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000249 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000249">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000237"/>
        <obo:IAO_0000115 xml:lang="en">A measurement property evaluation that assesses the degree to which qualitative meaning can be assigned to scores or changes in scores, such as a minimal important difference or floor and ceiling effects.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from Mokkink et al. 2010 (COSMIN)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">interpretability evaluation</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000250 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000250">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/STATO_0000471"/>
        <obo:IAO_0000115 xml:lang="en">An estimate that quantifies a measurement property or an interpretability characteristic of an outcome measurement instrument in a stated population.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from Mokkink et al. 2010 (COSMIN)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">measurement property estimate</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000251 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000251">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000250"/>
        <obo:IAO_0000115 xml:lang="en">A measurement property estimate of the smallest change in an instrument score that patients perceive as important.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Jaeschke et al. 1989</obo:IAO_0000119>
        <dcterms:source>Jaeschke R, Singer J, Guyatt GH. Measurement of health status. Ascertaining the minimal clinically important difference. Control Clin Trials. 1989;10(4):407-15.</dcterms:source>
        <oboInOwl:hasRelatedSynonym xml:lang="en">MCID</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">MID</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">minimal clinically important difference</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">minimal important difference estimate</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000251"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">MCID</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000251"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">MID</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000252 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000252">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000251"/>
        <obo:IAO_0000115 xml:lang="en">A minimal important difference estimate obtained by relating score changes to an external anchor, such as a patient&apos;s global rating of change.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Revicki et al. 2008</obo:IAO_0000119>
        <oboInOwl:hasRelatedSynonym xml:lang="en">anchor-based MID</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">anchor-based minimal important difference estimate</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000253 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000253">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000251"/>
        <obo:IAO_0000115 xml:lang="en">A minimal important difference estimate obtained from the spread of scores or the reliability of the instrument, such as half a standard deviation.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Revicki et al. 2008</obo:IAO_0000119>
        <oboInOwl:hasRelatedSynonym xml:lang="en">distribution-based MID</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">distribution-based minimal important difference estimate</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000254 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000254">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000250"/>
        <obo:IAO_0000115 xml:lang="en">A measurement property estimate of responsiveness equal to the mean change in score divided by the standard deviation of the change.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">It is also an effect size statistic (STATO effect size estimate); that was a second parent in 0.1.0.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Husted et al. 2000</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">SRM</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">standardised response mean</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000254"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">SRM</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000255 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000255">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000250"/>
        <obo:IAO_0000115 xml:lang="en">A measurement property estimate of internal consistency, such as Cronbach&apos;s alpha, computed from the correlations among the items of a scale.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from Mokkink et al. 2010 (COSMIN)</obo:IAO_0000119>
        <oboInOwl:hasNarrowSynonym xml:lang="en">Cronbach&apos;s alpha</oboInOwl:hasNarrowSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">internal consistency coefficient</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000256 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000256">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000250"/>
        <obo:IAO_0000115 xml:lang="en">A measurement property estimate of test-retest reliability, usually an intraclass correlation coefficient, from repeated measurements in people whose health is stable.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from Mokkink et al. 2010 (COSMIN)</obo:IAO_0000119>
        <oboInOwl:hasNarrowSynonym xml:lang="en">ICC</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">intraclass correlation coefficient</oboInOwl:hasNarrowSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">test-retest reliability coefficient</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000256"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget xml:lang="en">ICC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000257 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000257">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000250"/>
        <obo:IAO_0000115 xml:lang="en">A measurement property estimate of the proportion of respondents with the lowest possible score.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Terwee et al. treat more than 15% at the floor as a problem.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Terwee et al. 2007</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">floor effect estimate</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000258 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000258">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000250"/>
        <obo:IAO_0000115 xml:lang="en">A measurement property estimate of the proportion of respondents with the highest possible score.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Common for EQ-5D-3L in healthy populations, and one reason for the EQ-5D-5L.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Terwee et al. 2007</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">ceiling effect estimate</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000259 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000259">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/STATO_0000658"/>
        <obo:IAO_0000115 xml:lang="en">A mean time-to-event in which follow-up is restricted to a stated time horizon, equal to the area under the survival curve up to that horizon.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Royston and Parmar 2013</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">RMST</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">restricted mean survival time</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000259"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">RMST</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000260 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000260">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000011"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000012"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000095"/>
        <obo:IAO_0000115 xml:lang="en">An economic evaluation estimate of a summary measure that combines length of life with a weight for the quality of health or the disability experienced, expressed either as healthy time lived or gained, as with QALYs, or as healthy time lost, as with DALYs.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Gold et al. 2002</obo:IAO_0000119>
        <dcterms:source>Gold MR, Stevenson D, Fryback DG. HALYS and QALYS and DALYS, oh my: similarities and differences in summary measures of population health. Annu Rev Public Health. 2002;23:115-34.</dcterms:source>
        <oboInOwl:hasRelatedSynonym xml:lang="en">HALY</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">health-adjusted life year</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">health-adjusted life year estimate</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000260"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">HALY</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000261 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000261">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000260"/>
        <obo:IAO_0000115 xml:lang="en">A health-adjusted life year estimate in which each period of time is weighted by the utility of the health state lived in, so that a year in full health counts as one.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">RHEO&apos;s QALY record holds QALYs accrued by a person or group; this estimate is a summary used as a model input or reported as a result.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <oboInOwl:hasRelatedSynonym xml:lang="en">QALY</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">quality-adjusted life year</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">QALY estimate</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000261"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">QALY</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000262 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000262">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000261"/>
        <obo:IAO_0000115 xml:lang="en">A QALY estimate of the difference in QALYs between an intervention and its comparator.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <oboInOwl:hasRelatedSynonym xml:lang="en">QALY gain</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">QALYs gained</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">incremental QALYs</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">incremental QALY estimate</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000263 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000263">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000260"/>
        <obo:IAO_0000115 xml:lang="en">A health-adjusted life year estimate of health lost, equal to years of life lost to premature death plus years lived with disability.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Murray 1994</obo:IAO_0000119>
        <oboInOwl:hasRelatedSynonym xml:lang="en">DALY</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">disability-adjusted life year</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">DALY estimate</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000263"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">DALY</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000264 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000264">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000011"/>
        <obo:IAO_0000115 xml:lang="en">An economic evaluation estimate of the years of life lost to premature death, calculated against a reference life expectancy at the age of death.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Murray 1994</obo:IAO_0000119>
        <oboInOwl:hasRelatedSynonym xml:lang="en">YLL</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">years of life lost estimate</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000264"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">YLL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000265 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000265">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000011"/>
        <obo:IAO_0000115 xml:lang="en">An economic evaluation estimate of non-fatal health loss, calculated from the number of cases or prevalence, the duration and a disability weight.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Murray 1994</obo:IAO_0000119>
        <oboInOwl:hasRelatedSynonym xml:lang="en">YLD</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">years lived with disability estimate</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000265"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">YLD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000266 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000266">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000260"/>
        <obo:IAO_0000115 xml:lang="en">A health-adjusted life year estimate of the number of years in full health that a person considers equivalent to a whole path of health states over time, elicited by a two-stage standard gamble.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Mehrez and Gafni 1989</obo:IAO_0000119>
        <dcterms:source>Mehrez A, Gafni A. Quality-adjusted life years, utility theory, and healthy-years equivalents. Med Decis Making. 1989;9(2):142-9.</dcterms:source>
        <oboInOwl:hasRelatedSynonym xml:lang="en">HYE</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">healthy-year equivalent estimate</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000266"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">HYE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000267 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000267">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000260"/>
        <obo:IAO_0000115 xml:lang="en">A health-adjusted life year estimate that sums time with toxicity, time without symptoms or toxicity, and time after relapse, each weighted by a utility for that state.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Glasziou et al. 1990</obo:IAO_0000119>
        <dcterms:source>Glasziou PP, Simes RJ, Gelber RD. Quality adjusted survival analysis. Stat Med. 1990;9(11):1259-76.</dcterms:source>
        <oboInOwl:hasRelatedSynonym xml:lang="en">Q-TWiST</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">quality-adjusted time without symptoms or toxicity</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">Q-TWiST estimate</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000267"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">Q-TWiST</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000268 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000268">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000011"/>
        <obo:IAO_0000112 xml:lang="en">A utility decrement of 0.05 applied for the weeks a grade 3 adverse event lasts.</obo:IAO_0000112>
        <obo:IAO_0000115 xml:lang="en">An economic evaluation estimate of the loss of utility associated with an event, a treatment or a health state, relative to a stated baseline.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <oboInOwl:hasRelatedSynonym xml:lang="en">disutility</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">utility decrement</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">utility decrement estimate</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000269 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000269">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000011"/>
        <obo:IAO_0000115 xml:lang="en">An economic evaluation estimate of the future QALYs that people with a condition are expected to lose compared with people of the same age and sex without it, under current care.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">NICE uses absolute and proportional shortfall to apply its severity modifier.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>NICE 2022 (PMG36)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">QALY shortfall estimate</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000270 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000270">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000269"/>
        <obo:IAO_0000115 xml:lang="en">A QALY shortfall estimate expressed as the number of future QALYs lost.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>NICE 2022 (PMG36)</obo:IAO_0000119>
        <oboInOwl:hasRelatedSynonym xml:lang="en">absolute shortfall</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">absolute QALY shortfall estimate</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000271 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000271">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000269"/>
        <obo:IAO_0000115 xml:lang="en">A QALY shortfall estimate expressed as the proportion of expected future QALYs lost.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>NICE 2022 (PMG36)</obo:IAO_0000119>
        <oboInOwl:hasRelatedSynonym xml:lang="en">proportional shortfall</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">proportional QALY shortfall estimate</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000272 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000272">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000011"/>
        <obo:IAO_0000115 xml:lang="en">An economic evaluation estimate of the average number of years a person of a given age can expect to live in a stated state of health.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Robine et al. 2003</obo:IAO_0000119>
        <oboInOwl:hasRelatedSynonym xml:lang="en">health expectancy</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">health expectancy estimate</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000273 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000273">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000011"/>
        <obo:IAO_0000115 xml:lang="en">An economic evaluation estimate of the average number of further years a person of a given age is expected to live under stated mortality rates.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Chiang 1984</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">life expectancy estimate</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000274 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000274">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000272"/>
        <obo:IAO_0000115 xml:lang="en">A health expectancy estimate in which years of life are weighted by the severity of the health states lived in.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Robine et al. 2003</obo:IAO_0000119>
        <oboInOwl:hasRelatedSynonym xml:lang="en">HALE</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">health-adjusted life expectancy estimate</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000274"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">HALE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000275 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000275">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000272"/>
        <obo:IAO_0000115 xml:lang="en">A health expectancy estimate of the years a person can expect to live without disability.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Robine et al. 2003</obo:IAO_0000119>
        <oboInOwl:hasRelatedSynonym xml:lang="en">DFLE</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">disability-free life expectancy estimate</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000275"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">DFLE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000276 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000276">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000272"/>
        <obo:IAO_0000115 xml:lang="en">A health expectancy estimate of the years a person can expect to live without dependency in activities of daily living.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Katz et al. 1983</obo:IAO_0000119>
        <oboInOwl:hasRelatedSynonym xml:lang="en">ALE</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">active life expectancy estimate</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000276"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">ALE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000277 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000277">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000011"/>
        <obo:IAO_0000115 xml:lang="en">An economic evaluation estimate of a preference parameter, or a quantity derived from preference parameters, obtained by fitting a choice model to stated or revealed choices.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Train 2009</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">choice model estimate</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000278 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000278">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000011"/>
        <obo:IAO_0000115 xml:lang="en">An economic evaluation estimate that expresses the value of a health outcome or a change in risk in money, obtained from stated or revealed preferences.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">monetary valuation estimate</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000279 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000279">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000277"/>
        <obo:IAO_0000115 xml:lang="en">A choice model estimate of the contribution of one attribute level to the overall utility of an alternative.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <oboInOwl:hasRelatedSynonym xml:lang="en">part-worth</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">part-worth utility estimate</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000280 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000280">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000277"/>
        <obo:IAO_0000115 xml:lang="en">A choice model estimate of the amount of one attribute a respondent would give up for a unit increase in another, holding utility constant.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <oboInOwl:hasRelatedSynonym xml:lang="en">marginal rate of substitution</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">marginal rate of substitution estimate</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000281 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000281">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000278"/>
        <obo:IAO_0000115 xml:lang="en">A monetary valuation estimate of the most money people would give up for a stated benefit.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <oboInOwl:hasRelatedSynonym xml:lang="en">WTP</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">willingness-to-pay estimate</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000281"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">WTP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000282 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000282">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000278"/>
        <obo:IAO_0000115 xml:lang="en">A monetary valuation estimate of the least compensation people would accept for a stated loss.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <oboInOwl:hasRelatedSynonym xml:lang="en">WTA</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">willingness-to-accept estimate</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000282"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">WTA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000283 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000283">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000278"/>
        <obo:IAO_0000115 xml:lang="en">A monetary valuation estimate of the aggregate willingness to pay for mortality risk reductions that together prevent one expected death.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <oboInOwl:hasRelatedSynonym xml:lang="en">VSL</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">value of statistical life</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">value of a statistical life estimate</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000283"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">VSL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000284 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000284">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000278"/>
        <obo:IAO_0000115 xml:lang="en">A monetary valuation estimate of the value of one statistical life year, derived from willingness to pay for reductions in mortality risk.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <oboInOwl:hasRelatedSynonym xml:lang="en">VOLY</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">VSLY</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">value of statistical life year</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">value of a statistical life year estimate</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000284"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">VOLY</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000284"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">VSLY</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000285 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000285">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0000082"/>
        <obo:IAO_0000115 xml:lang="en">A planned process in which disability-adjusted life years are calculated as years of life lost plus years lived with disability.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Murray 1994</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">DALY calculation process</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000286 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000286">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0000082"/>
        <obo:IAO_0000115 xml:lang="en">A planned process in which a health expectancy is calculated by combining mortality data with data on the prevalence or incidence of health states.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Robine et al. 2003</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">health expectancy calculation process</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000287 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000287">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000286"/>
        <obo:IAO_0000115 xml:lang="en">A health expectancy calculation process that divides the person-years of a period life table into healthy and unhealthy years using age-specific prevalence of the health state.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Sullivan 1971</obo:IAO_0000119>
        <dcterms:source>Sullivan DF. A single index of mortality and morbidity. HSMHA Health Rep. 1971;86(4):347-54.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">Sullivan method</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000288 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000288">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000286"/>
        <obo:IAO_0000115 xml:lang="en">A health expectancy calculation process that uses transition rates between living states and death to estimate expected time in each state.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Robine et al. 2003</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">multi-state life table method</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000289 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000289">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0000082"/>
        <obo:IAO_0000115 xml:lang="en">A planned process in which survival time is partitioned into time with toxicity, time without symptoms or toxicity, and time after relapse, and the periods are weighted by utilities.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Glasziou et al. 1990</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">Q-TWiST analysis</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000290 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000290">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000021"/>
        <obo:IAO_0000115 xml:lang="en">A health state description of one of the three periods into which Q-TWiST analysis partitions survival.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Glasziou et al. 1990</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">Q-TWiST health state</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000291 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000291">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000290"/>
        <obo:IAO_0000115 xml:lang="en">A Q-TWiST health state covering time with serious treatment toxicity before progression.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Glasziou et al. 1990</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">toxicity period (TOX)</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000292 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000292">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000290"/>
        <obo:IAO_0000115 xml:lang="en">A Q-TWiST health state covering time free of serious toxicity and of symptoms of progression.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Glasziou et al. 1990</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">time without symptoms or toxicity (TWiST)</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000293 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000293">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000290"/>
        <obo:IAO_0000115 xml:lang="en">A Q-TWiST health state covering time after relapse or progression.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Glasziou et al. 1990</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">relapse period (REL)</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000294 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000294">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000260"/>
        <obo:IAO_0000115 xml:lang="en">A health-adjusted life year estimate in which quality-of-life gains are counted as for QALYs, but every year of life added by an intervention is valued at a fixed quality weight, so that life extension is valued the same whatever a person&apos;s health state.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">ICER&apos;s reference case fixes the weight for added life-years at 0.851.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>ICER 2025</obo:IAO_0000119>
        <oboInOwl:hasRelatedSynonym xml:lang="en">equal value of life years gained</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">evLYG</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">equal value life-years gained estimate</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000294"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">evLYG</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000295 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000295">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000011"/>
        <obo:IAO_0000115 xml:lang="en">An economic evaluation estimate of the difference in expected years of life between an intervention and its comparator, without adjustment for quality of life.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <oboInOwl:hasRelatedSynonym xml:lang="en">LY</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">LYG</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">life-years gained</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">life-years gained estimate</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000295"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">LY</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000295"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">LYG</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000296 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000296">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000108"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000011"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000123"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000011"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000124"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000012"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000123"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000012"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000124"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A mapping function that predicts responses on the EQ-5D-5L from responses on the EQ-5D-3L, or the reverse, by the response mapping model of the NICE Decision Support Unit estimated on the EEPRU dataset, so that a value set can then be applied to the predicted responses as a separate step.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">NICE PMG51 (27 August 2026) uses this model when only EQ-5D-3L data exist: the predicted EQ-5D-5L responses are scored with the UK EQ-5D-5L value set (Rowen et al. 2026), and the result counts as a departure from the reference case (PMG51 1.10, Appendix A 4.3.8). The value set applied is recorded on the utility record, not in this class. Before PMG51 the same approach mapped EQ-5D-5L data to the EQ-5D-3L value set (PMG36).</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000118 xml:lang="en">EQ-5D-3L to EQ-5D-5L mapping (NICE DSU, Hernandez Alava)</obo:IAO_0000118>
        <obo:IAO_0000119>Hernandez Alava et al. 2023</obo:IAO_0000119>
        <dcterms:source>Hernández Alava M, Pudney S, Wailoo A. Estimating the relationship between EQ-5D-5L and EQ-5D-3L: results from a UK population study. Pharmacoeconomics. 2023;41(2):199-207.</dcterms:source>
        <oboInOwl:hasRelatedSynonym xml:lang="en">3L to 5L mapping</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">reverse DSU mapping</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">EQ-5D-3L and EQ-5D-5L response mapping (NICE DSU, EEPRU dataset)</rdfs:label>
        <ns1:OHEO_9000002 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:OHEO_9000002>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000297 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000297">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000175"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000010"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000124"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000031"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000204"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000009"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-0.567</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000012"/>
                <owl:hasValue>adult general population of the United Kingdom</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An EQ-5D-5L value set elicited from a sample of the adult general population of the United Kingdom.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">NICE PMG51 (27 August 2026) makes the EQ-5D-5L descriptive system with this value set its preferred approach in adults; it should derive all adult utility values in reference-case analyses for topics started on or after that date (PMG51 1.6, 1.7, 1.17, 1.18, Appendix A 4.3.6).</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Rowen et al. 2026</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">EQ-5D-5L UK value set (Rowen 2026)</rdfs:label>
        <ns1:OHEO_9000002 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:OHEO_9000002>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000298 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000298">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000175"/>
