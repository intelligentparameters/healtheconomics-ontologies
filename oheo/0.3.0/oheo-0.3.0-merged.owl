        <obo:IAO_0000115 xml:lang="en">An EQ-5D instrument in which each of the five dimensions has three levels, defining 243 health states.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
