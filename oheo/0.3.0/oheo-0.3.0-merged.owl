        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Reilly et al. 1993</obo:IAO_0000119>
        <dcterms:source>Reilly MC, Zbrozek AS, Dukes EM. The validity and reproducibility of a work productivity and activity impairment instrument. Pharmacoeconomics. 1993;4(5):353-65.</dcterms:source>
        <oboInOwl:hasExactSynonym xml:lang="en">Work Productivity and Activity Impairment questionnaire</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">WPAI</rdfs:label>
        <ns1:OHEO_9000002 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:OHEO_9000002>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000160 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000160">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000083"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000001"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000051"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000039"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000400"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000002"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000003"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A preference-based patient-reported outcome measure for informal carers with seven dimensions of care-related quality of life, each with three levels.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">CarerQol-7D utility weights (Hoefman et al. 2014) are a care-related index value set, not anchored on dead.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brouwer et al. 2006</obo:IAO_0000119>
        <dcterms:source>Brouwer WB, van Exel NJ, van Gorp B, Redekop WK. The CarerQol instrument: a new instrument to measure care-related quality of life of informal caregivers for use in economic evaluations. Qual Life Res. 2006;15(6):1005-21.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">CarerQol-7D</rdfs:label>
        <ns1:OHEO_9000002 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:OHEO_9000002>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000161 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000161">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000083"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000001"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000051"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000035"/>
                <owl:hasValue rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000387"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000001"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">22</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000006"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000007"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">88</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000008"/>
                <owl:hasValue>higher is worse</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A patient-reported outcome measure of 22 items, completed by an informal carer about their own experience, measuring the burden of caring.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Zarit, Orr and Zarit 1985</obo:IAO_0000119>
        <dcterms:source>Zarit SH, Orr NK, Zarit JM. The Hidden Victims of Alzheimer&apos;s Disease: Families Under Stress. New York: New York University Press; 1985.</dcterms:source>
        <oboInOwl:hasExactSynonym xml:lang="en">ZBI</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">Zarit Burden Interview</rdfs:label>
        <ns1:OHEO_9000002 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:OHEO_9000002>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000161"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">ZBI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000162 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000162">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000001"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000045"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000001"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000006"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000007"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">100</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000008"/>
                <owl:hasValue>higher is better</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An activities of daily living instrument of ten items rating independence in self-care and mobility.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The Barthel Index is completed by a clinician, by the person or by an informant, so the instrument sits directly under outcome measurement instrument and each version records its reporter with &apos;has reporter type&apos; (0.2.0 fix pass). The reporter-type classes are disjoint, so a version cannot be both self-reported and proxy-reported.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Mahoney and Barthel 1965</obo:IAO_0000119>
        <dcterms:source>Mahoney FI, Barthel DW. Functional evaluation: the Barthel Index. Md State Med J. 1965;14:61-5.</dcterms:source>
        <oboInOwl:hasDbXref>NCIT:C131914</oboInOwl:hasDbXref>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">Barthel Index</rdfs:label>
        <ns1:OHEO_9000002 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:OHEO_9000002>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000163 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000163">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000001"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000045"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000001"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An activities of daily living instrument of six items: bathing, dressing, toileting, transferring, continence and feeding.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The Katz Index is completed by a clinician or from an informant&apos;s report, so the instrument sits directly under outcome measurement instrument and each version records its reporter with &apos;has reporter type&apos; (0.2.0 fix pass). The reporter-type classes are disjoint, so a version cannot be both self-reported and proxy-reported.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Katz et al. 1963</obo:IAO_0000119>
        <dcterms:source>Katz S, Ford AB, Moskowitz RW, et al. Studies of illness in the aged. The index of ADL. JAMA. 1963;185:914-9.</dcterms:source>
        <oboInOwl:hasExactSynonym xml:lang="en">Katz ADL</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">Katz Index of Independence in Activities of Daily Living</rdfs:label>
        <ns1:OHEO_9000002 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:OHEO_9000002>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000164 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000164">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000001"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000046"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000001"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000006"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000007"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">8</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An instrument of eight items rating independence in instrumental activities of daily living, such as shopping, cooking and managing finances.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Covers instrumental activities of daily living, a sibling of the activities of daily living domain, so the reasoner does not classify it as an activities of daily living instrument.</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">The Lawton IADL Scale is completed by the person, by an informant or by an interviewer recording what is reported (Lawton and Brody 1969), so the instrument sits directly under outcome measurement instrument and each version records its reporter with &apos;has reporter type&apos; (0.2.0 fix pass). The reporter-type classes are disjoint, so a version cannot be both self-reported and proxy-reported.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Lawton and Brody 1969</obo:IAO_0000119>
        <dcterms:source>Lawton MP, Brody EM. Assessment of older people: self-maintaining and instrumental activities of daily living. Gerontologist. 1969;9(3):179-86.</dcterms:source>
        <oboInOwl:hasDbXref>NCIT:C181894</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Lawton Instrumental Activities of Daily Living Scale</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">Lawton IADL Scale</rdfs:label>
        <ns1:OHEO_9000002 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:OHEO_9000002>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000165 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000165">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000084"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000001"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000021"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000001"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000030"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000035"/>
                <owl:hasValue rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000387"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000006"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000007"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000008"/>
                <owl:hasValue>higher is worse</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A clinician-reported outcome measure that grades a person&apos;s level of functioning from 0 (fully active) to 5 (dead).</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Oken et al. 1982</obo:IAO_0000119>
        <dcterms:source>Oken MM, Creech RH, Tormey DC, et al. Toxicity and response criteria of the Eastern Cooperative Oncology Group. Am J Clin Oncol. 1982;5(6):649-55.</dcterms:source>
        <oboInOwl:hasDbXref>NCIT:C105721</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">ECOG PS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">WHO performance status</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">ECOG performance status</rdfs:label>
        <ns1:OHEO_9000002 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:OHEO_9000002>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000166 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000166">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000084"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000001"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000021"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
