        <ns1:OHEO_9000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">29</ns1:OHEO_9000001>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000035 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000035">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000004"/>
        <obo:IAO_0000115 xml:lang="en">An outcome domain in the life impact outcome area, covering a person&apos;s overall quality of life, assessed as a whole rather than through a single aspect of functioning.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from Dodd et al. 2018</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">Global quality of life</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">global quality of life outcome domain</rdfs:label>
        <ns1:OHEO_9000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30</ns1:OHEO_9000001>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000036 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000036">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000004"/>
        <obo:IAO_0000115 xml:lang="en">An outcome domain in the life impact outcome area, covering a person&apos;s own rating or perception of their health as a whole.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from Dodd et al. 2018</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">Perceived health status</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">perceived health status outcome domain</rdfs:label>
        <ns1:OHEO_9000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">31</ns1:OHEO_9000001>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000037 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000037">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000004"/>
        <obo:IAO_0000115 xml:lang="en">An outcome domain in the life impact outcome area, covering the appropriateness and acceptability of an intervention, including satisfaction and preference, adherence, withdrawal from treatment, and process, implementation and service outcomes.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from Dodd et al. 2018</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">Delivery of care</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">delivery of care outcome domain</rdfs:label>
        <ns1:OHEO_9000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">32</ns1:OHEO_9000001>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000038 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000038">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000004"/>
        <obo:IAO_0000115 xml:lang="en">An outcome domain in the life impact outcome area, covering aspects of a person&apos;s life situation affected by health or care, such as housing, finances or independence.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from Dodd et al. 2018</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">Personal circumstances</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">personal circumstances outcome domain</rdfs:label>
        <ns1:OHEO_9000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">33</ns1:OHEO_9000001>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000039 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000039">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000005"/>
        <obo:IAO_0000115 xml:lang="en">An outcome domain in the resource use outcome area, covering costs and other economic consequences of illness and care, including productivity losses.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from Dodd et al. 2018</obo:IAO_0000119>
        <oboInOwl:hasRelatedSynonym xml:lang="en">Economic</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">economic outcome domain</rdfs:label>
        <ns1:OHEO_9000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">34</ns1:OHEO_9000001>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000040 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000040">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000005"/>
        <obo:IAO_0000115 xml:lang="en">An outcome domain in the resource use outcome area, covering the use of hospital services, such as admissions, readmissions and length of stay.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from Dodd et al. 2018</obo:IAO_0000119>
        <oboInOwl:hasRelatedSynonym xml:lang="en">Hospital</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">hospital outcome domain</rdfs:label>
        <ns1:OHEO_9000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">35</ns1:OHEO_9000001>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000041 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000041">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000005"/>
        <obo:IAO_0000115 xml:lang="en">An outcome domain in the resource use outcome area, covering the need for additional treatment, such as further surgery, rescue medication or a change of therapy.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from Dodd et al. 2018</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">Need for further intervention</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">need for further intervention outcome domain</rdfs:label>
        <ns1:OHEO_9000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">36</ns1:OHEO_9000001>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000042 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000042">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000005"/>
        <obo:IAO_0000115 xml:lang="en">An outcome domain in the resource use outcome area, covering the burden that illness and care place on carers, families and wider society.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from Dodd et al. 2018</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">Societal/carer burden</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">societal or carer burden outcome domain</rdfs:label>
        <ns1:OHEO_9000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">37</ns1:OHEO_9000001>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000043 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000043">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000002"/>
        <obo:IAO_0000115 xml:lang="en">An outcome domain in the death outcome area, covering overall and cause-specific mortality and survival, and composite survival outcomes that include death.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Composite outcomes that include death, such as disease-free survival, are classified both here and in the physiological domain of the disease concerned (Dodd et al. 2018).</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from Dodd et al. 2018</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">Mortality/survival</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">mortality or survival outcome domain</rdfs:label>
        <ns1:OHEO_9000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</ns1:OHEO_9000001>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000044 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000044">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000006"/>
        <obo:IAO_0000115 xml:lang="en">An outcome domain in the adverse event outcome area, covering outcomes labelled as an unintended consequence of an intervention, such as adverse events or effects, adverse reactions, harm, toxicity and complications.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Specifically named adverse events are also classified in the domain for the event type (Dodd et al. 2018).</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from Dodd et al. 2018</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">Adverse events/effects</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">adverse events outcome domain</rdfs:label>
        <ns1:OHEO_9000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">38</ns1:OHEO_9000001>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000045 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000045">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">A physical functioning outcome domain covering basic self-care tasks, such as bathing, dressing, toileting, transferring and eating.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">OHEO extension below the COMET taxonomy, added for health economic use.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Katz et al. 1963</obo:IAO_0000119>
        <oboInOwl:hasRelatedSynonym xml:lang="en">ADL</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">activities of daily living outcome domain</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000045"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">ADL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000046 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000046">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">A physical functioning outcome domain covering complex tasks needed to live independently, such as shopping, cooking, managing money and using transport.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">OHEO extension below the COMET taxonomy, added for health economic use.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Lawton and Brody 1969</obo:IAO_0000119>
        <oboInOwl:hasRelatedSynonym xml:lang="en">IADL</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">instrumental activities of daily living outcome domain</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000046"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">IADL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000047 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000047">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">A physical functioning outcome domain covering difficulties a person has in carrying out tasks or actions, as described in the WHO International Classification of Functioning, Disability and Health.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">OHEO extension below the COMET taxonomy, added for health economic use.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from WHO 2001 (ICF)</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">activity limitation outcome domain</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000048 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000048">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000004"/>
        <obo:IAO_0000115 xml:lang="en">An outcome domain in the life impact outcome area, covering the physical, psychological and social aspects of life that are affected by a person&apos;s health or its treatment.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">OHEO extension below the COMET taxonomy, added for health economic use. It spans COMET domains 25 to 31; most generic preference-based measures cover it.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <oboInOwl:hasRelatedSynonym xml:lang="en">HRQL</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">HRQoL</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">health-related quality of life outcome domain</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000048"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">HRQL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000048"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">HRQoL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000049 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000049">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000004"/>
        <obo:IAO_0000115 xml:lang="en">An outcome domain in the life impact outcome area, covering a person&apos;s wellbeing beyond health, or their capability to do and be the things they value, such as attachment, autonomy and enjoyment.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">OHEO extension below the COMET taxonomy, added for health economic use. Measured by instruments such as ICECAP-A, ASCOT and EQ-HWB.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from Al-Janabi et al. 2012</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">wellbeing and capability outcome domain</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000050 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000050">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000003"/>
        <obo:IAO_0000115 xml:lang="en">An outcome domain in the physiological or clinical outcome area, covering symptoms a person experiences, such as pain, fatigue or breathlessness, considered across body systems.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">An OHEO extension of the COMET outcome taxonomy (Dodd et al. 2018), not one of its 38 domains.</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">OHEO extension below the COMET taxonomy, added for health economic use. COMET classifies a named symptom under its body system; this grouping supports symptom burden and symptom-free survival outcomes.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">symptom outcome domain</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000051 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000051">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000042"/>
        <obo:IAO_0000115 xml:lang="en">A societal or carer burden outcome domain covering the health, wellbeing and burden of people who provide informal care.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">An OHEO extension of the COMET outcome taxonomy (Dodd et al. 2018), not one of its 38 domains.</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">OHEO extension below the COMET taxonomy, added for health economic use.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">caregiver outcome</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">carer outcome domain</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000052 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000052">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000039"/>
        <obo:IAO_0000115 xml:lang="en">An economic outcome domain covering paid and unpaid work lost or impaired because of ill health, including absenteeism and presenteeism.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">OHEO extension below the COMET taxonomy, added for health economic use.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">work productivity outcome domain</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000053 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000053">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000112 xml:lang="en">Change from baseline in EQ-5D-5L index at 12 months, mean, England value set.</obo:IAO_0000112>
        <obo:IAO_0000115 xml:lang="en">An information content entity that specifies an outcome to be measured or estimated by stating its domain and, where relevant, the measure, the metric, the method of aggregation and the time point.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The five elements follow the ClinicalTrials.gov outcome measure framework. An estimand (RHEO) points to the outcome specification that supplies its variable.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from Zarin et al. 2011</obo:IAO_0000119>
        <dcterms:source>Zarin DA, Tse T, Williams RJ, Califf RM, Ide NC. The ClinicalTrials.gov results database: update and key issues. N Engl J Med. 2011;364(9):852-60.</dcterms:source>
        <oboInOwl:hasDbXref>NCIT:C25212</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">endpoint</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">outcome measure definition</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">outcome</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">outcome specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000054 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000054">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000053"/>
        <obo:IAO_0000115 xml:lang="en">An outcome specification for an outcome that directly reflects how a person feels, functions or survives, rather than standing in for it.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Health economic models value final outcomes, usually as QALYs. &apos;Clinical benefit&apos; and &apos;patient outcome&apos; on HealthEconomics.wiki map here.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from FDA-NIH Biomarker Working Group 2016 (BEST Resource)</obo:IAO_0000119>
        <dcterms:source>FDA-NIH Biomarker Working Group. BEST (Biomarkers, EndpointS, and other Tools) Resource. Silver Spring (MD): Food and Drug Administration; Bethesda (MD): National Institutes of Health; 2016.</dcterms:source>
        <oboInOwl:hasExactSynonym xml:lang="en">true endpoint</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">clinical outcome</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">patient-relevant outcome</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">final outcome specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000055 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000055">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000053"/>
        <obo:IAO_0000115 xml:lang="en">An outcome specification for an outcome on the causal pathway between an intervention and a final outcome, such as a change in a risk factor or a disease marker.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">intermediate endpoint</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">intermediate outcome specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000056 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000056">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000055"/>
        <obo:IAO_0000115 xml:lang="en">An intermediate outcome specification used in a study as a substitute for a final outcome, on the basis that change in it is expected to predict change in the final outcome.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Use &apos;is surrogate for&apos; to link to the final outcome it stands in for. NICE expects evidence that the surrogate relationship holds before a surrogate drives a cost-effectiveness estimate.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from FDA-NIH Biomarker Working Group 2016 (BEST Resource)</obo:IAO_0000119>
        <dcterms:source>FDA-NIH Biomarker Working Group. BEST (Biomarkers, EndpointS, and other Tools) Resource. Silver Spring (MD): Food and Drug Administration; Bethesda (MD): National Institutes of Health; 2016.</dcterms:source>
        <oboInOwl:hasExactSynonym xml:lang="en">surrogate outcome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">surrogate marker</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">surrogate endpoint specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000057 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000057">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000055"/>
        <obo:IAO_0000115 xml:lang="en">An intermediate outcome specification based on a biological marker, such as a laboratory value or an imaging finding, which serves as a surrogate endpoint only where its relation to a final outcome has been established.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from FDA-NIH Biomarker Working Group 2016 (BEST Resource)</obo:IAO_0000119>
        <dcterms:source>FDA-NIH Biomarker Working Group. BEST (Biomarkers, EndpointS, and other Tools) Resource. Silver Spring (MD): Food and Drug Administration; Bethesda (MD): National Institutes of Health; 2016.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">biomarker endpoint specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000058 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000058">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000057"/>
        <obo:IAO_0000115 xml:lang="en">A biomarker endpoint specification based on the amount of disease still detectable by highly sensitive methods after treatment has produced an apparent complete response.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>FDA 2020</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">MRD endpoint</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">MRD negativity rate</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">minimal residual disease endpoint specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000059 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000059">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000053"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000006"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000053"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An outcome specification in which a person has the outcome if they experience any one of two or more component outcomes, such as death, myocardial infarction or stroke.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Components are linked with &apos;has component outcome&apos;. Under COMET, a composite is classified in the domain of every component.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>ICH E9 1998</obo:IAO_0000119>
        <oboInOwl:hasDbXref>NCIT:C170561</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">combined endpoint</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">composite outcome</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">composite endpoint specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000060 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000060">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000053"/>
        <obo:IAO_0000115 xml:lang="en">An outcome specification whose variable is the time from a stated origin to the first occurrence of a stated event, with rules for censoring people in whom the event is not observed.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">event-time outcome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">survival endpoint</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">time-to-event outcome specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000061 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000061">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000060"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000001"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000043"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000013"/>
                <owl:hasValue>time to event</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A time-to-event outcome specification in which overall survival is the time from a stated origin, such as randomisation, to death from any cause.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>FDA 2018</obo:IAO_0000119>
        <oboInOwl:hasDbXref>NCIT:C125201</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">OS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">overall survival</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">overall survival outcome specification</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000061"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">OS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000062 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000062">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000060"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000001"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000021"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000001"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000043"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000013"/>
                <owl:hasValue>time to event</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A time-to-event outcome specification in which progression-free survival is the time from a stated origin to objectively defined disease progression or death from any cause, whichever occurs first.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>FDA 2018</obo:IAO_0000119>
        <oboInOwl:hasDbXref>NCIT:C28234</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">PFS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">progression-free survival</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">progression-free survival outcome specification</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000062"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">PFS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000063 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000063">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000060"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000001"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000043"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000013"/>
                <owl:hasValue>time to event</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A time-to-event outcome specification in which event-free survival is the time from a stated origin to the first of a prespecified set of events, which usually includes death.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>FDA 2018</obo:IAO_0000119>
        <oboInOwl:hasDbXref>NCIT:C96340</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">EFS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">event-free survival</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">event-free survival outcome specification</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000063"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">EFS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000064 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000064">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000060"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000001"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000043"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000013"/>
                <owl:hasValue>time to event</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A time-to-event outcome specification in which relapse-free survival is the time from completion of curative-intent treatment, or from remission, to disease relapse or death.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">RFS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">relapse-free survival</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">relapse-free survival outcome specification</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000064"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">RFS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000065 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000065">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000060"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000001"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000021"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000001"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000043"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000013"/>
                <owl:hasValue>time to event</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A time-to-event outcome specification in which disease-free survival is the time from a stated origin after curative-intent treatment to recurrence of disease or death from any cause.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>FDA 2018</obo:IAO_0000119>
        <oboInOwl:hasDbXref>NCIT:C17751</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">DFS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">disease-free survival</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">disease-free survival outcome specification</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000065"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">DFS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000066 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000066">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000060"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000001"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000043"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000013"/>
                <owl:hasValue>time to event</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A time-to-event outcome specification in which cause-specific survival is the time from a stated origin to death from the disease of interest, with deaths from other causes treated as censoring or competing events.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">cause-specific survival</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">disease-specific survival</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">cause-specific survival outcome specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000067 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000067">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000060"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000001"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000043"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000001"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000050"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000013"/>
                <owl:hasValue>time to event</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A time-to-event outcome specification in which symptom-free survival is the time from a stated origin to the onset or return of clinically significant symptoms or death.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">symptom-free survival</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">symptom-free survival outcome specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000068 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000068">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000053"/>
        <obo:IAO_0000115 xml:lang="en">An outcome specification whose variable is whether a person meets stated criteria for response to treatment, summarised as the proportion of people who respond.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">response endpoint</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">response outcome specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000069 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000069">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000068"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000001"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000021"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000016"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000114"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000014"/>
                <owl:hasValue>proportion</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A response outcome specification whose summary is the proportion of people with a complete or partial tumour response under stated response criteria, such as RECIST 1.1.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Eisenhauer et al. 2009; FDA 2018</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">ORR</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">objective response rate</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">overall response rate</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">objective response rate outcome specification</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000069"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">ORR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000070 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000070">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000068"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000001"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000021"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000016"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000114"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000014"/>
                <owl:hasValue>proportion</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A response outcome specification whose summary is the proportion of people with a complete response, a partial response or stable disease under stated response criteria.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">No agreed standard definition exists (for the clinical benefit rate the minimum duration varies by trial), so the definition keeps &apos;stated&apos; criteria and time; an OHEO working definition.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">DCR</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">disease control rate</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">disease control rate outcome specification</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000070"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">DCR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000071 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000071">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000068"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000001"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000021"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000016"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000114"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000014"/>
                <owl:hasValue>proportion</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A response outcome specification whose summary is the proportion of people with a complete response, a partial response or stable disease lasting at least a stated minimum time.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">No agreed standard definition exists (for the clinical benefit rate the minimum duration varies by trial), so the definition keeps &apos;stated&apos; criteria and time; an OHEO working definition.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">CBR</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">clinical benefit rate</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">clinical benefit rate outcome specification</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000071"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">CBR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000072 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000072">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000053"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000001"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000044"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An outcome specification for the occurrence, frequency or severity of adverse events.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">safety endpoint</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">adverse event outcome</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">safety outcome specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000073 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000073">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000053"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000001"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000048"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An outcome specification for health-related quality of life measured with a patient-reported or preference-based instrument.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <oboInOwl:hasBroadSynonym xml:lang="en">quality of life outcome</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">HRQoL endpoint</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">health-related quality of life outcome specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000074 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000074">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000073"/>
        <obo:IAO_0000115 xml:lang="en">A health-related quality of life outcome specification whose variable is a utility obtained from a preference-based measure and a stated value set.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The natural input to a QALY calculation. The value set should be stated, because the same responses give different utilities under different value sets.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">health utility outcome specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000075 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000075">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000053"/>
        <obo:IAO_0000115 xml:lang="en">An outcome specification designated in a study protocol as the main outcome on which the study&apos;s conclusions and sample size are based.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>ICH E9 1998</obo:IAO_0000119>
        <oboInOwl:hasDbXref>NCIT:C94496</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">primary endpoint</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">primary outcome specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000076 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000076">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000075"/>
        <obo:IAO_0000115 xml:lang="en">A primary outcome specification that is one of two or more outcomes all designated as primary in the same protocol.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>ICH E9 1998</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">co-primary endpoint</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">co-primary outcome specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000077 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000077">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000053"/>
        <obo:IAO_0000115 xml:lang="en">An outcome specification designated in a study protocol as supporting the primary outcome or addressing additional questions.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>ICH E9 1998</obo:IAO_0000119>
        <oboInOwl:hasDbXref>NCIT:C139173</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">secondary endpoint</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">secondary outcome specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000078 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000078">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000077"/>
        <obo:IAO_0000115 xml:lang="en">A secondary outcome specification designated for confirmatory testing, usually within a prespecified testing hierarchy.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>EMA 2002 (CPMP/EWP/908/99)</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">key secondary endpoint</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">key secondary outcome specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000079 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000079">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000053"/>
        <obo:IAO_0000115 xml:lang="en">An outcome specification designated in a study protocol for hypothesis generation rather than confirmatory testing.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <oboInOwl:hasDbXref>NCIT:C170559</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">exploratory endpoint</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">exploratory outcome specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000080 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000080">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that is an agreed, standardised set of outcomes that should be measured and reported, as a minimum, in all clinical trials in a specific area of health or health care.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Link outcomes with &apos;includes outcome&apos; and recommended instruments with &apos;recommends instrument&apos;.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Williamson et al. 2017 (COMET Handbook)</obo:IAO_0000119>
        <dcterms:source>Williamson PR, Altman DG, Bagley H, et al. The COMET Handbook: version 1.0. Trials. 2017;18(Suppl 3):280.</dcterms:source>
        <oboInOwl:hasExactSynonym xml:lang="en">COS</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">core outcome set</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000080"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">COS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000081 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000081">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000080"/>
        <obo:IAO_0000115 xml:lang="en">A core outcome set agreed for measuring outcomes in routine clinical practice for a condition, rather than in trials, so that providers can compare results.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Standard sets of the International Consortium for Health Outcomes Measurement are examples.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Porter et al. 2016</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">standard set</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">ICHOM standard set</oboInOwl:hasNarrowSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">routine care outcome standard set</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <obo:IAO_0000115 xml:lang="en">A directive information entity that specifies how to obtain a score or classification for an outcome from a patient, a clinician, an observer or a performance task, including its items, response options and scoring rules. Each named instrument in OHEO, such as the EQ-5D-5L, is a class whose instances are the instrument&apos;s versions, such as one language and format version.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">An instrument is the specification. Administering it is an outcome assessment process; one person&apos;s result is an outcome measurement datum, a RHEO state observation or a RHEO utility measurement record. OHEO identifies three things separately: the instrument (its class, such as EQ-5D-5L), the instrument version (an instance of that class, such as one language and format version) and the value set (an instance of a value set class). The record rules check that a record names each one.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from Mokkink et al. 2010 (COSMIN)</obo:IAO_0000119>
        <dcterms:source>Mokkink LB, Terwee CB, Patrick DL, et al. The COSMIN study reached international consensus on taxonomy, terminology, and definitions of measurement properties for health-related patient-reported outcomes. J Clin Epidemiol. 2010;63(7):737-45.</dcterms:source>
        <oboInOwl:hasDbXref>NCIT:C142378</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">COA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">clinical outcome assessment</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">questionnaire</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">outcome measure</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">scale</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">outcome measurement instrument</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">COA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000083 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000083">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
        <obo:IAO_0000115 xml:lang="en">An outcome measurement instrument completed by the respondent reporting on their own health or state, usually the patient and sometimes a carer reporting on their own experience, without interpretation by a clinician or anyone else.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from FDA-NIH Biomarker Working Group 2016 (BEST Resource)</obo:IAO_0000119>
        <oboInOwl:hasDbXref>NCIT:C177377</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">PRO instrument</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">PRO measure</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">PROM</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">patient-reported outcome measure</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000083"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">PROM</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000084 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000084">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
        <obo:IAO_0000115 xml:lang="en">An outcome measurement instrument completed by a trained health professional who uses clinical judgement to rate observable signs, behaviours or manifestations of a condition.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from FDA-NIH Biomarker Working Group 2016 (BEST Resource)</obo:IAO_0000119>
        <oboInOwl:hasDbXref>NCIT:C142453</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">ClinRO</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">clinician-reported outcome measure</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000084"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">ClinRO</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000085 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000085">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
        <obo:IAO_0000115 xml:lang="en">An outcome measurement instrument completed by someone other than the patient or a health professional, such as a parent or carer, reporting signs or behaviours they can observe.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from FDA-NIH Biomarker Working Group 2016 (BEST Resource)</obo:IAO_0000119>
        <oboInOwl:hasDbXref>NCIT:C142620</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">ObsRO</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">proxy-reported outcome measure</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">observer-reported outcome measure</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000085"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">ObsRO</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000086 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000086">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
        <obo:IAO_0000115 xml:lang="en">An outcome measurement instrument in which the patient performs a defined task according to instructions and the performance is measured, such as distance walked in a set time.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from FDA-NIH Biomarker Working Group 2016 (BEST Resource)</obo:IAO_0000119>
        <oboInOwl:hasDbXref>NCIT:C142632</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">PerfO</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">performance outcome measure</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000086"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">PerfO</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000087 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000087">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000035"/>
                        <owl:hasValue rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000386"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000088"/>
        <obo:IAO_0000115 xml:lang="en">An outcome measurement instrument designed for use across conditions and populations, so that results can be compared between them.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Defined class (0.2.0): an instrument is classified here by the reasoner when it has the classification value &apos;generic design&apos;. In 0.1.0 this was a second asserted parent.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">generic measure</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">generic outcome measurement instrument</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000088 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000088">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000035"/>
                        <owl:hasValue rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000387"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
        <obo:IAO_0000115 xml:lang="en">An outcome measurement instrument designed for people with a particular condition or treatment, covering the aspects of health most relevant to them.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Defined class (0.2.0): an instrument is classified here by the reasoner when it has the classification value &apos;condition-specific design&apos;.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">condition-specific measure</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">disease-specific instrument</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">condition-specific outcome measurement instrument</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000089 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000089">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000035"/>
                        <owl:hasValue rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000388"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
        <obo:IAO_0000115 xml:lang="en">An outcome measurement instrument that reports separate scores for several aspects of health rather than a single preference-weighted index.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Defined class (0.2.0): an instrument is classified here by the reasoner when it has the classification value &apos;health profile scoring&apos;.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">profile measure</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">health profile instrument</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000090 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000090">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000034"/>
                        <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000105"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000008"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000099"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An outcome measurement instrument for which at least one value set has been published, so that each health state its descriptive system describes can be given a utility on a scale on which full health is 1 and dead is 0. The utilities belong to the value set, not to the instrument.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Defined class (0.2.0): an instrument is classified here by the reasoner when it has a published value set. The basis of indirect utility assessment for QALYs. A preference-based measure and its value set are different things: the instrument describes a health state, the value set values it.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <dcterms:source>Brazier J, Ratcliffe J, Salomon JA, Tsuchiya A. Measuring and Valuing Health Benefits for Economic Evaluation. 2nd ed. Oxford: Oxford University Press; 2017.</dcterms:source>
        <oboInOwl:hasExactSynonym xml:lang="en">MAUI</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">multi-attribute utility instrument</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">preference-based instrument</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">utility instrument</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">preference-based measure</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000090"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">MAUI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000091 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000091">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000034"/>
                        <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000105"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000035"/>
                        <owl:hasValue rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000386"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000090"/>
        <obo:IAO_0000115 xml:lang="en">A preference-based measure designed for use across conditions and populations.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Defined class (0.2.0): a preference-based measure with the classification value &apos;generic design&apos;.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">generic preference-based measure</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000092 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000092">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000034"/>
                        <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000105"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000035"/>
                        <owl:hasValue rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000387"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000090"/>
        <obo:IAO_0000115 xml:lang="en">A preference-based measure whose descriptive system is designed for a particular condition, often derived from a condition-specific profile instrument.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Defined class (0.2.0): a preference-based measure with the classification value &apos;condition-specific design&apos;.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">condition-specific preference-based measure</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000093 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000093">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000001"/>
                        <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000049"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000001"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000049"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An outcome measurement instrument that covers the wellbeing and capability outcome domain, measuring wellbeing or capability beyond health, such as autonomy, attachment or control over daily life.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Defined class (0.2.0): an instrument is classified here by the reasoner when it covers the wellbeing and capability outcome domain.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Coast et al. 2008; Al-Janabi et al. 2012</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">wellbeing or capability instrument</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000094 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000094">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000001"/>
                        <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000045"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000001"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000045"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An outcome measurement instrument that covers the activities of daily living outcome domain, assessing a person&apos;s independence in basic self-care tasks.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Defined class (0.2.0): an instrument is classified here by the reasoner when it covers the activities of daily living outcome domain. Instruments for instrumental activities of daily living, such as the Lawton IADL Scale, cover a sibling domain and are not classified here.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">activities of daily living instrument</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000095 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000095">
        <obo:IAO_0000115 xml:lang="en">OBSOLETE. An information content entity that groups versions and variants of an outcome measurement instrument that share a name, developer and core content, such as the EQ-5D family.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Made obsolete in 0.2.0. An instrument family is not a kind of instrument: a version of the EQ-5D-5L is not a family. The family is now the named instrument class itself (EQ-5D, Health Utilities Index, AQoL), whose subclasses are its members.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <oboInOwl:consider rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000122"/>
        <oboInOwl:consider rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000130"/>
        <oboInOwl:consider rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000134"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">obsolete instrument family</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000096 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000096">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that is a single question, statement or task in an outcome measurement instrument, together with its response options.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from Mokkink et al. 2010 (COSMIN)</obo:IAO_0000119>
        <oboInOwl:hasRelatedSynonym xml:lang="en">question</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">instrument item</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000097 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000097">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000112 xml:lang="en">The &apos;anxiety/depression&apos; dimension of the EQ-5D-5L.</obo:IAO_0000112>
        <obo:IAO_0000115 xml:lang="en">An information content entity that is a part of an outcome measurement instrument describing one aspect of health, such as mobility or pain, by an ordered set of levels or a group of items.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">attribute</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">health dimension</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">subscale</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">instrument dimension</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000098 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000098">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000112 xml:lang="en">&apos;I have slight problems in walking about&apos;.</obo:IAO_0000112>
        <obo:IAO_0000115 xml:lang="en">An information content entity that is one of the ordered response categories of an instrument dimension or item.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">response level</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000099 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000099">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000065"/>
        <obo:IAO_0000112 xml:lang="en">The EQ-5D-5L descriptive system, with 3,125 health states.</obo:IAO_0000112>
        <obo:IAO_0000115 xml:lang="en">A classification scheme version that is the descriptive system of a preference-based measure, defining each health state as one combination of levels across its dimensions.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">A person&apos;s response is a RHEO state observation under this scheme, and the profile they report (for example 21121) is a RHEO health state classification profile.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">descriptive system</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">health state descriptive system</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">health state classification system</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000100 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000100">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <obo:IAO_0000115 xml:lang="en">A directive information entity that states the period of time a respondent should consider when answering an instrument, such as &apos;today&apos; or &apos;the past 4 weeks&apos;.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Most instruments record this as the &apos;has recall period&apos; value rather than as a separate entity.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>FDA 2009</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">recall period specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000101 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000101">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000064"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000105"/>
        <obo:IAO_0000115 xml:lang="en">An algorithm that converts responses to an outcome measurement instrument into one or more scores or classifications.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>adapted from Mokkink et al. 2010 (COSMIN)</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">scoring function</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">scoring rule</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">scoring algorithm</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000102 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000102">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that represents preferences over health states or health outcomes by assigning a number to each, so that more preferred states have higher numbers.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Drummond et al. 2015</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">utility function</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000103 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000103">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000102"/>
        <obo:IAO_0000115 xml:lang="en">A utility function that assigns a utility to outcomes described by several attributes, by combining preference weights for the level of each attribute.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Torrance et al. 1996</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">MAU function</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">multi-attribute utility</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">multi-attribute utility function</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000104 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000104">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000102"/>
        <obo:IAO_0000115 xml:lang="en">A utility function that assigns a utility to outcomes described by a single attribute.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Keeney and Raiffa 1976</obo:IAO_0000119>
        <oboInOwl:hasRelatedSynonym xml:lang="en">single attribute utility</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">single-attribute utility function</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000105 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000105">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000103"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000010"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000400"/>
        <obo:IAO_0000115 xml:lang="en">A multi-attribute utility function that assigns a utility to every health state of a health state classification system, estimated from preferences elicited from a stated population by a stated valuation method. Each named value set in OHEO is a class whose instances are its published releases.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">A value set is a valuation, kept apart from the instrument whose descriptive system it values. In 0.1.0 it was also under scoring algorithm; its scoring role is stated by &apos;scores instrument&apos;.</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">A value set is a valuation, not part of the instrument: the same EQ-5D-5L responses give different utilities under different value sets, so a utility record must name both. Link to the instrument with &apos;scores instrument&apos;, to the elicitation method with &apos;has valuation method&apos; and to the population with &apos;elicited in population&apos;. A correction or re-estimation of a value set is a new release, which is a new instance.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <dcterms:source>Brazier J, Ratcliffe J, Salomon JA, Tsuchiya A. Measuring and Valuing Health Benefits for Economic Evaluation. 2nd ed. Oxford: Oxford University Press; 2017.</dcterms:source>
        <oboInOwl:hasExactSynonym xml:lang="en">utility tariff</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">preference weights</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">scoring algorithm (preference-based)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">tariff</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">value set</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000106 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000106">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that is a number in a value set giving the change in utility associated with one level of one dimension, or with an interaction between levels.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Brazier et al. 2017</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">dimension level weight</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">value set coefficient</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">preference weight</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000107 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000107">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000064"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000012"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An algorithm that predicts a score on a target instrument, usually a utility, from responses or scores on a source instrument, estimated from data in which both were collected.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Wailoo et al. 2017</obo:IAO_0000119>
        <dcterms:source>Wailoo AJ, Hernandez-Alava M, Manca A, et al. Mapping to estimate health-state utility from non-preference-based outcome measures: an ISPOR Good Practices for Outcomes Research Task Force report. Value Health. 2017;20(1):18-27.</dcterms:source>
        <oboInOwl:hasExactSynonym xml:lang="en">mapping algorithm</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">transfer-to-utility function</oboInOwl:hasNarrowSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">mapping function</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000108 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000108">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000107"/>
        <obo:IAO_0000115 xml:lang="en">A mapping function that converts responses or values on one instrument to values on another instrument of the same family, such as EQ-5D-5L to EQ-5D-3L.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>van Hout et al. 2012</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">instrument crosswalk</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">crosswalk</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000109 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000109">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that classifies a score by which comparisons and arithmetic operations on its values are meaningful.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Stevens 1946</obo:IAO_0000119>
        <dcterms:source>Stevens SS. On the theory of scales of measurement. Science. 1946;103(2684):677-80.</dcterms:source>
        <oboInOwl:hasExactSynonym xml:lang="en">level of measurement</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">measurement scale type</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000110 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000110">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000109"/>
        <obo:IAO_0000115 xml:lang="en">A measurement scale type whose values are categories with no order.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Stevens 1946</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">nominal scale</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000111 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000111">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000109"/>
        <obo:IAO_0000115 xml:lang="en">A measurement scale type whose values can be ranked but whose differences do not represent equal amounts of the underlying quantity.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Stevens 1946</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">ordinal scale</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000112 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000112">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000109"/>
        <obo:IAO_0000115 xml:lang="en">A measurement scale type whose equal differences between values represent equal amounts of the underlying quantity, but whose zero is arbitrary.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Stevens 1946</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">interval scale</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000113 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000113">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000109"/>
        <obo:IAO_0000115 xml:lang="en">A measurement scale type with equal intervals and a true zero, so that ratios of values are meaningful.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Stevens 1946</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">ratio scale</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000114 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000114">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <obo:IAO_0000115 xml:lang="en">A directive information entity that states rules for assigning a person to an outcome category, such as a tumour response category or an adverse event grade.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">outcome classification criteria</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000115 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000115">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000114"/>
        <obo:IAO_0000115 xml:lang="en">A set of outcome classification criteria for solid tumours that classify change in measurable disease on imaging as complete response, partial response, stable disease or progressive disease.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Eisenhauer et al. 2009</obo:IAO_0000119>
        <dcterms:source>Eisenhauer EA, Therasse P, Bogaerts J, et al. New response evaluation criteria in solid tumours: revised RECIST guideline (version 1.1). Eur J Cancer. 2009;45(2):228-47.</dcterms:source>
        <oboInOwl:hasExactSynonym xml:lang="en">Response Evaluation Criteria in Solid Tumours version 1.1</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">RECIST 1.1</rdfs:label>
        <ns1:OHEO_9000002 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:OHEO_9000002>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000116 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000116">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000114"/>
        <obo:IAO_0000115 xml:lang="en">A set of outcome classification criteria that grade the severity of adverse events from grade 1 (mild) to grade 5 (death related to the adverse event).</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>National Cancer Institute 2017</obo:IAO_0000119>
        <dcterms:source>National Cancer Institute. Common Terminology Criteria for Adverse Events (CTCAE) Version 5.0. 2017.</dcterms:source>
        <oboInOwl:hasExactSynonym xml:lang="en">Common Terminology Criteria for Adverse Events v5.0</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">CTCAE version 5.0</rdfs:label>
        <ns1:OHEO_9000002 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:OHEO_9000002>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000117 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000117">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000064"/>
        <obo:IAO_0000115 xml:lang="en">A state description that classifies a person&apos;s tumour response at an assessment under stated response criteria.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Eisenhauer et al. 2009</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">tumour response category</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000118 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000118">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000117"/>
        <obo:IAO_0000115 xml:lang="en">A tumour response category in which all target and non-target lesions have disappeared under the stated criteria.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Eisenhauer et al. 2009</obo:IAO_0000119>
        <oboInOwl:hasDbXref>NCIT:C159715</oboInOwl:hasDbXref>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">complete response</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000119 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000119">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000117"/>
        <obo:IAO_0000115 xml:lang="en">A tumour response category in which target lesions have shrunk by at least a stated amount, under RECIST 1.1 at least 30% in the sum of diameters.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Eisenhauer et al. 2009</obo:IAO_0000119>
        <oboInOwl:hasDbXref>NCIT:C159547</oboInOwl:hasDbXref>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">partial response</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000120 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000120">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000117"/>
        <obo:IAO_0000115 xml:lang="en">A tumour response category in which change in target lesions is too small to qualify as partial response or progressive disease.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Eisenhauer et al. 2009</obo:IAO_0000119>
        <oboInOwl:hasDbXref>NCIT:C159546</oboInOwl:hasDbXref>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">stable disease</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000121 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000121">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000117"/>
        <obo:IAO_0000115 xml:lang="en">A tumour response category in which target lesions have grown by at least a stated amount or new lesions have appeared, under RECIST 1.1 at least 20% and 5 mm in the sum of diameters.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Eisenhauer et al. 2009</obo:IAO_0000119>
        <oboInOwl:hasDbXref>NCIT:C159716</oboInOwl:hasDbXref>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">progressive disease</rdfs:label>
    </owl:Class>
    


