        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An observer-reported outcome measure of pain for people who cannot report pain themselves, rating five behaviours (face, legs, activity, cry and consolability) and scored from 0 to 10.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
