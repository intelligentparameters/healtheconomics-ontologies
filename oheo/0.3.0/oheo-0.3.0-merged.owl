            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A performance outcome measure timing how long a person takes to rise from a chair, walk three metres, turn, walk back and sit down.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
