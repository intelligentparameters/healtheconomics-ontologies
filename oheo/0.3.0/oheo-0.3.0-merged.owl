        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000130"/>
        <obo:IAO_0000115 xml:lang="en">A data entity recording a payment: the amount, currency, date, payer, payee and, where relevant, the care process, tariff and payment mechanism it relates to.</obo:IAO_0000115>
