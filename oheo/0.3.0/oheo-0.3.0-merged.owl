                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000035"/>
                <owl:hasValue rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000386"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000002"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000005"/>
                <owl:hasValue>today</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000008"/>
                <owl:hasValue>higher is better</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000010"/>
                <owl:hasValue>EuroQol Research Foundation</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An outcome measurement instrument of the EuroQol EQ-5D family, whose members describe health on five dimensions (mobility, self-care, usual activities, pain or discomfort and anxiety or depression) and include a visual analogue scale for self-rated health.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">NICE prefers the EQ-5D in adults (PMG36, 2022) and, for topics started on or after 27 August 2026, the EQ-5D-5L with the UK EQ-5D-5L value set (PMG51). NICE recommends no specific measure for children and young people (PMG51 1.7).</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>EuroQol Group 1990</obo:IAO_0000119>
        <dcterms:source>EuroQol Group. EuroQol: a new facility for the measurement of health-related quality of life. Health Policy. 1990;16(3):199-208.</dcterms:source>
        <oboInOwl:hasExactSynonym xml:lang="en">EQ5D</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">EuroQol 5D</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">EQ-5D</rdfs:label>
        <ns1:OHEO_9000002 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:OHEO_9000002>
    </owl:Class>
    


