            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A condition-specific preference-based patient-reported outcome measure for cancer with ten dimensions, each with four levels, derived from the EORTC QLQ-C30.</obo:IAO_0000115>
