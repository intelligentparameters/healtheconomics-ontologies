    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_1000013 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000013">
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
        <obo:IAO_0000115 xml:lang="en">Relates an outcome measurement datum, a RHEO state observation, a RHEO utility measurement record or a measurement property estimate to the instrument version used to obtain it. The value is an instance of a named instrument class, such as one language and format version of the EQ-5D-5L; its class identifies the instrument.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">RHEO&apos;s text field &apos;has instrument version&apos; (RHEO_2000077) holds what EuroQol calls a version, such as 3L or 5L; OHEO models those as named instruments (EQ-5D-3L, EQ-5D-5L). OHEO&apos;s instrument version is one copy of a named instrument, such as one language and format version. The record rules accept RHEO text that names the instrument, its family, or the copy&apos;s version label.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000118 xml:lang="en">obtained with instrument</obo:IAO_0000118>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">obtained with instrument version</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_1000014 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000014">
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000105"/>
        <obo:IAO_0000115 xml:lang="en">Relates a RHEO utility measurement record or utility estimate to the value set used to convert instrument responses to utilities. The value is an instance of a named value set class: one release of that value set.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">obtained with value set</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_1000015 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000015">
