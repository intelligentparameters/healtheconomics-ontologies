        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000134"/>
        <obo:IAO_0000115 xml:lang="en">A directive information entity stating how a payer pays for care, such as fee for service, case-based payment, capitation, a block contract or payment out of pocket.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">payment mechanism specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000077 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000077">
