    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_1000049 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000049">
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000072"/>
        <obo:IAO_0000115 xml:lang="en">Relates a cost record, a costing process, a decision problem or an economic model to the perspective specification it follows.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Authoritative for perspective (0.3.0). The text property has perspective label is a label only.</obo:IAO_0000116>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
