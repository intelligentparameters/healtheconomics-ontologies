        <obo:IAO_0000119>adapted from Dodd et al. 2018</obo:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">Outcomes relating to neoplasms: benign, malignant and unspecified (including cysts and polyps)</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">neoplasm outcome domain</rdfs:label>
        <ns1:OHEO_9000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</ns1:OHEO_9000001>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000022 -->

