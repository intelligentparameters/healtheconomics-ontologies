    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_9000001 -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_9000001">
        <obo:IAO_0000115 xml:lang="en">The number of the domain in the COMET outcome taxonomy (Dodd et al. 2018), from 1 to 38.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">COMET domain number</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_9000002 -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_9000002">
        <obo:IAO_0000115 xml:lang="en">True for a class that stands for one named, published artefact, such as the EQ-5D-5L, the EQ-5D-3L UK value set (Dolan 1997) or RECIST 1.1, whose instances are its versions or releases, rather than for a general kind such as patient-reported outcome measure. The record rules use it to check that a record names the instrument version and value set it used.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">names a published artefact</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_9000001 -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_9000001">
        <obo:IAO_0000115 xml:lang="en">OBSOLETE. Linked a RHEO term to the Health Economics Ontology concept closest in meaning.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Made obsolete in 0.2.2. RHEO to HEO mappings are published only in rheo-heo.sssom.tsv, which states for each mapping whether it is a close match or a related match and what kind of entity the RHEO term is.</obo:IAO_0000116>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">obsolete closest HEO concept</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:AnnotationProperty>
    


