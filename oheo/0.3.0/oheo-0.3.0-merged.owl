    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000126">
        <obo:IAO_0000115 xml:lang="en">OBSOLETE. An instrument family of short-form health surveys derived from the Medical Outcomes Study, including the SF-36, the SF-12 and the preference-based SF-6D.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Made obsolete in 0.2.0. The SF instruments are not one kind: the SF-36 and SF-12 are health profiles and the SF-6D is a preference-based measure. Their relation is recorded with &apos;derived from instrument&apos;.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
