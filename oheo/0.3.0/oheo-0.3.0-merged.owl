        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">has number of items</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_2000002 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000002">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <obo:IAO_0000115 xml:lang="en">The number of dimensions or attributes in an outcome measurement instrument or health state classification system.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">has number of dimensions</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_2000003 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000003">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <obo:IAO_0000115 xml:lang="en">The number of response levels in each dimension of an instrument whose dimensions all have the same number of levels.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">has number of response levels</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_2000004 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000004">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <obo:IAO_0000115 xml:lang="en">The number of distinct health states a health state classification system can describe.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">has number of health states</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_2000005 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000005">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">The period a respondent is asked to consider when answering an instrument.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">has recall period</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_2000006 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000006">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <obo:IAO_0000115 xml:lang="en">The lowest possible score of an instrument or scale.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">has minimum score</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_2000007 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000007">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <obo:IAO_0000115 xml:lang="en">The highest possible score of an instrument or scale.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">has maximum score</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_2000008 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000008">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">Whether higher scores indicate better or worse health: &apos;higher is better&apos; or &apos;higher is worse&apos;.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">has score direction</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_2000009 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000009">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <obo:IAO_0000115 xml:lang="en">The utility a value set assigns to the worst health state of its classification system.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">has worst health state utility</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_2000010 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000010">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">The organisation that holds the licence for use of an instrument.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">has licence holder</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_2000011 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000011">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">The age range of the people for whom an instrument is intended.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">has intended age range</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_2000012 -->

