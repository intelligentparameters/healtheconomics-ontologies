        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">is censored</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_2000017 -->

