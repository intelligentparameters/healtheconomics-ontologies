    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000021 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000021">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000003"/>
        <obo:IAO_0000115 xml:lang="en">An outcome domain in the physiological or clinical outcome area, covering physiological function, signs and symptoms caused by benign, malignant and unspecified neoplasms, including solid and non-solid tumours, such as time to recurrence, response rate or clearance of resection margins.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Physiological domains follow MedDRA System Organ Classes, as in the COMET taxonomy.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
