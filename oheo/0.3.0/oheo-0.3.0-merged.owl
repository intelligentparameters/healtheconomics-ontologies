    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000029">
        <obo:IAO_0000115 xml:lang="en">OBSOLETE. Relates an outcome reference case requirement to an information content entity that analyses must report or consider.</obo:IAO_0000115>
