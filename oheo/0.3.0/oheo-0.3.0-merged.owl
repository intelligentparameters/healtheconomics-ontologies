        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000106"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000071"/>
        <obo:IAO_0000115 xml:lang="en">Relates an emissions record to the resource use record whose emissions it records.</obo:IAO_0000115>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">accounts for resource use</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_1000073 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000073">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000106"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000105"/>
        <obo:IAO_0000115 xml:lang="en">Relates an emissions record to the emission factor estimate it applies.</obo:IAO_0000115>
