                <owl:hasValue rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000387"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000006"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000007"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">100</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000008"/>
                <owl:hasValue>higher is better</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A clinician-reported outcome measure that rates a person&apos;s ability to carry out ordinary activities from 100 (normal) to 0 (dead) in steps of ten.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Karnofsky and Burchenal 1949</obo:IAO_0000119>
        <dcterms:source>Karnofsky DA, Burchenal JH. The clinical evaluation of chemotherapeutic agents in cancer. In: MacLeod CM, ed. Evaluation of Chemotherapeutic Agents. New York: Columbia University Press; 1949:191-205.</dcterms:source>
        <oboInOwl:hasDbXref>NCIT:C28013</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">KPS</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">Karnofsky Performance Status</rdfs:label>
        <ns1:OHEO_9000002 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:OHEO_9000002>
    </owl:Class>
