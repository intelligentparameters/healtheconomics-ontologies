        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000129"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000064"/>
        <obo:IAO_0000115 xml:lang="en">Relates a classification revision record to a state description that the revision added and that neither refines, renames nor merges a state of the revised version.</obo:IAO_0000115>
