    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_2000016 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000016">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
