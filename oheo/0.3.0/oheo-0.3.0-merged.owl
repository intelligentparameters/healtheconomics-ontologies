            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A condition-specific preference-based patient-reported outcome measure for mental health built from ReQoL items, combining mental health items with one physical health item so that responses can be scored as utilities.</obo:IAO_0000115>
