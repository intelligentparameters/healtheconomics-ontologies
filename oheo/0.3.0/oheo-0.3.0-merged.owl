        <dcterms:source>Kurtzke JF. Rating neurologic impairment in multiple sclerosis: an expanded disability status scale (EDSS). Neurology. 1983;33(11):1444-52.</dcterms:source>
        <oboInOwl:hasDbXref>NCIT:C98302</oboInOwl:hasDbXref>
