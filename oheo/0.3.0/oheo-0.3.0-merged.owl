    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000337 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000337">
        <obo:IAO_0000115 xml:lang="en">OBSOLETE. An outcome reference case requirement that utilities come from a multi-attribute utility instrument, with no single instrument preferred.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Made obsolete in 0.2.0. Reference case requirements are now published as SHACL shapes (oheo-reference-case-shapes.ttl), one shape for each reference case profile, because an OWL class with &apos;some&apos; restrictions cannot check that an analysis meets a requirement. The requirement this class stated is a constraint in the shape of each profile that set it.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <obo:IAO_0000231 rdf:resource="http://purl.obolibrary.org/obo/OMO_0001000"/>
        <oboInOwl:consider rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000328"/>
