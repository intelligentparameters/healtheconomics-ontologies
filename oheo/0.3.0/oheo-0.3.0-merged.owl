    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_2000015 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000015">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">The time point or period at which an outcome is assessed, as stated in an outcome specification.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
