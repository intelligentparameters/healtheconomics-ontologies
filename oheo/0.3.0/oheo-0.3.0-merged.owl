        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000009"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-0.285</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_2000012"/>
                <owl:hasValue>general population of England</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An EQ-5D-5L value set elicited by composite time trade-off and discrete choice experiment from a sample of the general population in England, ranging from -0.285 to 1.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">NICE never recommended this value set for reference-case analyses (old PMG36 4.3.16, quoted in PMG51). PMG51 (27 August 2026) adopts the UK EQ-5D-5L value set of Rowen et al. 2026 instead.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Devlin et al. 2018</obo:IAO_0000119>
        <dcterms:source>Devlin NJ, Shah KK, Feng Y, Mulhern B, van Hout B. Valuing health-related quality of life: an EQ-5D-5L value set for England. Health Econ. 2018;27(1):7-22.</dcterms:source>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">EQ-5D-5L England value set (Devlin 2018)</rdfs:label>
        <ns1:OHEO_9000002 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ns1:OHEO_9000002>
    </owl:Class>
    


