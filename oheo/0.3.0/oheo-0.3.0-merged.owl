    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000352">
        <obo:IAO_0000115 xml:lang="en">OBSOLETE. An outcome reference case requirement that where utilities or preference weights are used, they come from patients rather than the general public.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Made obsolete in 0.2.0. Reference case requirements are now published as SHACL shapes (oheo-reference-case-shapes.ttl), one shape for each reference case profile, because an OWL class with &apos;some&apos; restrictions cannot check that an analysis meets a requirement. The requirement this class stated is a constraint in the shape of each profile that set it.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>HealthEconomics.wiki editorial</obo:IAO_0000119>
        <obo:IAO_0000231 rdf:resource="http://purl.obolibrary.org/obo/OMO_0001000"/>
        <oboInOwl:consider rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000328"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">obsolete requirement: patient preferences where utilities are used</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/ontologies/oheo/reference-case-shapes"/>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000353 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000353">
        <obo:IAO_0000115 xml:lang="en">OBSOLETE. An outcome reference case requirement that health-related quality of life is reported directly by patients, or by carers when patients cannot report it, rather than by health professionals.</obo:IAO_0000115>
