    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_1000050 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_1000050">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000072"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000121"/>
        <obo:IAO_0000115 xml:lang="en">Relates a perspective specification to a costed item type specification (a kind of resource or care process) that it counts.</obo:IAO_0000115>
