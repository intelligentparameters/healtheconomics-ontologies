                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_1000010"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000123"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A value set that assigns a utility to each of the 243 EQ-5D-3L health states.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">A kind of value set, not one value set: each value set for this instrument is a subclass.</obo:IAO_0000116>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <obo:IAO_0000119>Devlin and Brooks 2017</obo:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">EQ-5D-3L value set</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000175 -->

