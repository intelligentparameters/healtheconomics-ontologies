        <dcterms:source>Zigmond AS, Snaith RP. The hospital anxiety and depression scale. Acta Psychiatr Scand. 1983;67(6):361-70.</dcterms:source>
        <oboInOwl:hasDbXref>NCIT:C103520</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Hospital Anxiety and Depression Scale</oboInOwl:hasExactSynonym>
