    rdfs:label "preferred namespace prefix"@en .

vann:preferredNamespaceUri a owl:AnnotationProperty ;
    rdfs:label "preferred namespace URI"@en .

prov:wasAttributedTo a owl:ObjectProperty ;
    rdfs:label "was attributed to"@en ;
    obo:IAO_0000115 "Attribution is the ascribing of an entity to an agent."@en ;
    obo:IAO_0000116 "Declared as PROV-O states it. HEAO uses it from a valuation provenance record to the person or organization that made or adopted the valuation."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o> .

foaf:homepage a owl:AnnotationProperty ;
    rdfs:label "homepage"@en .

heao:0000002 a owl:Class ;
    rdfs:label "health-adjusted time valuation"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A valuation in which time lived, or time spent in a health state, is converted into health-adjusted time on a health value scale, such as QALYs or DALYs, by applying a preference-based utility weight or a disability weight to each period."@en ;
    obo:IAO_0000116 "RHEO's QALY calculation process and OHEO's DALY calculation process are bridged here. A process that also discounts, such as RHEO scenario s11 QC1, may also be typed time valuation, and one that applies a severity weight may also be typed severity weighting. Scoring a health state to give a utility is health state scoring, not this."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000118 "QALY or DALY valuation"@en,
        "health outcome valuation"@en ;
    obo:IAO_0000119 "Drummond et al. 2015; Murray 1994" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heao> ;
    rdfs:subClassOf heao:0000001 ;
    heao:9000002 "HEMO-HOOK-04" .

heao:0000003 a owl:Class ;
    rdfs:label "preference-based index scoring"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A health state scoring in which a person's health state profile on a preference-based measure is converted into a single utility by applying a value set, without the person valuing health states themselves."@en ;
    obo:IAO_0000116 "This is the only part of instrument use that HEAO treats as valuation. The descriptive questionnaire and its responses are measurement and stay in OHEO and RHEO. OHEO's indirect health state valuation process is bridged here. Utility mapping is not bridged in 0.1.0, because whether predicting a utility with a mapping function is a valuation is open for Darrin Baines."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000118 "indirect utility scoring"@en ;
    obo:IAO_0000119 "Brazier et al. 2017" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heao> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty heao:1000005 ;
            owl:someValuesFrom heao:0000055 ],
        heao:0000079 ;
    heao:9000002 "HEMO-HOOK-03" .

heao:0000005 a owl:Class ;
    rdfs:label "productivity cost valuation"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A resource valuation in which time lost from paid or unpaid productive activity, or reduced output at work, because of ill health or premature death is converted into money, by the human capital method or the friction cost method."@en ;
    obo:IAO_0000116 "Some productivity effects may already be counted in QALYs if respondents consider income when they value health states (Brouwer et al. 1997), so a valuation should say whether they are counted on the cost side, the effect side or neither."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000118 "indirect cost valuation"@en ;
    obo:IAO_0000119 "Koopmanschap et al. 1995; Drummond et al. 2015" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heao> ;
    rdfs:subClassOf heao:0000004 ;
    heao:9000002 "HEMO-HOOK-16" .

heao:0000007 a owl:Class ;
    rdfs:label "price year adjustment"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A monetary revaluation in which an amount of money is moved from one price year to another by applying a price index ratio, as in inflating past unit costs to the price year of an analysis."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000118 "deflation adjustment"@en,
        "inflation adjustment"@en ;
    obo:IAO_0000119 "Turner et al. 2019; Drummond et al. 2015" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heao> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty heao:1000003 ;
            owl:someValuesFrom heao:0000041 ],
        heao:0000006 ;
    heao:9000002 "HEMO-HOOK-09" .

heao:0000009 a owl:Class ;
    rdfs:label "purchasing power parity conversion"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A currency conversion in which a purchasing power parity conversion factor is applied, so that the converted amount buys the same quantity of goods and services in the target country as the original amount bought in the source country."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000118 "PPP conversion"@en ;
    obo:IAO_0000119 "Turner et al. 2019; Drummond et al. 2015" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heao> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty heao:1000003 ;
            owl:someValuesFrom heao:0000043 ],
        heao:0000008 ;
    heao:9000002 "HEMO-HOOK-10" .

heao:0000010 a owl:Class ;
    rdfs:label "time valuation"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A valuation in which an amount of cost or health occurring at a stated time is converted into its present value at a base time by applying a discount factor derived from a discount rate."@en ;
    obo:IAO_0000116 "Discounting is the valuation of timing. Each amount in a stream is one time valuation with its own discount factor, and the present value of the stream is their sum, which is arithmetic. A model that first weights time by utility and then discounts makes a chain of two valuations, so each judgement can be changed on its own."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000118 "discounting"@en ;
    obo:IAO_0000119 "Drummond et al. 2015; Attema et al. 2018" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heao> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty heao:1000003 ;
            owl:someValuesFrom heao:0000044 ],
        heao:0000001 ;
    heao:9000002 "HEMO-HOOK-01" .

heao:0000012 a owl:Class ;
    rdfs:label "health opportunity cost valuation"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A health-money exchange in which a cost falling on a constrained health budget is converted into the health expected to be forgone elsewhere in that system, by dividing it by a money value of a QALY taken to reflect the marginal productivity of the budget, either an estimated supply-side threshold value or a value a decision-making body has adopted for that purpose."@en ;
    obo:IAO_0000116 "The result is a RHEO opportunity cost record in health units, and the cost record carries has health opportunity cost to it. This is how HEAO joins costs to health outcomes. A cost is not an outcome domain, but the health it displaces is an outcome forgone. The amount depends on which money value of a QALY is divided into the cost, so a result at an adopted value is the health forgone at that value, not an estimate of the health actually displaced."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000118 "valuation of health forgone"@en ;
    obo:IAO_0000119 "Claxton et al. 2015; Drummond et al. 2015" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heao> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty heao:1000003 ;
            owl:someValuesFrom heao:0000046 ],
        [ a owl:Restriction ;
            owl:onProperty heao:1000012 ;
            owl:someValuesFrom rheo:0000155 ],
        heao:0000011 ;
    heao:9000002 "HEMO-HOOK-12" .

heao:0000014 a owl:Class ;
    rdfs:label "severity weighting"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An equity weighting in which QALYs gained are weighted according to the severity of the condition, measured by absolute or proportional QALY shortfall, under a severity weighting rule."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000118 "severity modifier application"@en ;
    obo:IAO_0000119 "NICE 2022 (PMG36, last updated 13 October 2026), sections 6.2.13 to 6.2.18 and table 6.1, checked 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heao> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty heao:1000008 ;
            owl:someValuesFrom heao:0000018 ],
        [ a owl:Restriction ;
            owl:onProperty heao:1000003 ;
            owl:someValuesFrom heao:0000050 ],
        heao:0000013 ;
    heao:9000002 "HEMO-HOOK-14" .

heao:0000015 a owl:Class ;
    rdfs:label "value of information analysis"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A valuation in which the expected value of reducing decision uncertainty is assigned, as the expected gain in net benefit from deciding with more information, calculated from a probabilistic analysis at a stated money value of health."@en ;
    obo:IAO_0000116 "The quantity valued is the uncertainty in net benefit, held as the draws of a probabilistic sensitivity analysis. The result is not the product of one quantity and one weight, so the functional form is the expected maximum over options."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000118 "VOI analysis"@en,
        "information valuation"@en ;
    obo:IAO_0000119 "Claxton 1999; Ades et al. 2004; Briggs et al. 2006" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heao> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty heao:1000012 ;
            owl:someValuesFrom heao:0000074 ],
        heao:0000001 ;
    heao:9000002 "HEMO-HOOK-17" .

heao:0000027 a owl:Class ;
    rdfs:label "constant rate discounting method"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A discounting method in which the discount factor for an amount t years after the base time is 1/(1+r)^t, for a constant annual discount rate r."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000118 "exponential discounting method"@en ;
    obo:IAO_0000119 "Drummond et al. 2015; Attema et al. 2018" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heao> ;
    rdfs:subClassOf heao:0000026 ;
    heao:9000002 "HEMO-HOOK-01" .

heao:0000028 a owl:Class ;
    rdfs:label "hyperbolic discounting method"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A non-constant rate discounting method in which the implied discount rate falls continuously as the delay grows, as with a discount factor of 1/(1+at) for a parameter a."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Frederick et al. 2002, footnote 13; Attema et al. 2018" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heao> ;
    rdfs:subClassOf heao:0000102 ;
    heao:9000002 "HEMO-HOOK-02" .

heao:0000033 a owl:Class ;
    rdfs:label "nested Monte Carlo EVPPI method"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A value of information calculation method in which the EVPPI of a subset of parameters is estimated by an outer sample of those parameters and an inner sample of the remaining parameters for each outer draw."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Brennan et al. 2007" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heao> ;
    rdfs:subClassOf heao:0000032 ;
    heao:9000002 "HEMO-HOOK-18" .

heao:0000034 a owl:Class ;
    rdfs:label "regression-based EVPPI method"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A value of information calculation method in which the EVPPI of a subset of parameters is estimated from a single probabilistic sensitivity analysis sample by regressing net benefit on those parameters with a nonparametric regression."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Strong et al. 2014" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heao> ;
    rdfs:subClassOf heao:0000032 ;
    heao:9000002 "HEMO-HOOK-18" .

heao:0000070 a owl:Class ;
    rdfs:label "valued quantity"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An information content entity that is the quantity input of at least one valuation, such as a resource use record, a time spent in a health state or an amount already valued that is valued again."@en ;
    obo:IAO_0000116 "Defined class. Do not assert it. A reasoner places a record here because a valuation uses it as its quantity."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Baines D. Scope of HEAO, anything turned from a unit into a value, HEAO stage 1 design, 17 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heao> ;
    rdfs:subClassOf obo:IAO_0000030 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:IAO_0000030 [ a owl:Restriction ;
                        owl:onProperty heao:1000002 ;
                        owl:someValuesFrom heao:0000001 ] ) ] .

heao:0000071 a owl:Class ;
    rdfs:label "valuation result"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An information content entity that is the output of at least one valuation, such as a cost record, a QALY record, a present value or an expected value of perfect information."@en ;
    obo:IAO_0000116 "Defined class. Do not assert it. A reasoner places a record here because a valuation produced it."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Baines D. Scope of HEAO, anything turned from a unit into a value, HEAO stage 1 design, 17 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heao> ;
    rdfs:subClassOf obo:IAO_0000030 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:IAO_0000030 [ a owl:Restriction ;
                        owl:onProperty heao:1000013 ;
                        owl:someValuesFrom heao:0000001 ] ) ] .

heao:0000072 a owl:Class ;
    rdfs:label "valuation target"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An entity that at least one valuation is about, such as a health state, a kind of resource, a group of patients or a decision."@en ;
    obo:IAO_0000116 "Defined class. Do not assert it. It is a query class only. It classifies health states, kinds of resource, organisations and decisions alike, and says nothing about them beyond the relation to a valuation."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Baines D. Scope of HEAO, anything turned from a unit into a value, HEAO stage 1 design, 17 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heao> ;
    rdfs:subClassOf obo:BFO_0000001 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:BFO_0000001 [ a owl:Restriction ;
                        owl:onProperty heao:1000007 ;
                        owl:someValuesFrom heao:0000001 ] ) ] .

heao:0000080 a owl:Class ;
    rdfs:label "capability index scoring"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A health state scoring in which a person's responses to a capability instrument, such as the ICECAP-A, are converted into a capability index value by applying a capability or care-related index value set, on a scale anchored at no capability and full capability."@en ;
    obo:IAO_0000116 "Its values are on the capability index scale and cannot weight time in QALYs (OHEO_0000400)."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Flynn et al. 2015" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heao> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty heao:1000005 ;
            owl:someValuesFrom heao:0000055 ],
        heao:0000079 ;
    heao:9000002 "HEMO-HOOK-03" .

heao:0000081 a owl:Class ;
    rdfs:label "wellbeing-adjusted time valuation"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A valuation in which a change in life satisfaction, measured on a 0 to 10 scale, is converted into wellbeing-adjusted life years (WELLBYs), one WELLBY being a one-point change in life satisfaction for one person for one year."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000118 "WELLBY valuation"@en ;
    obo:IAO_0000119 "HM Treasury 2021 (Wellbeing guidance for appraisal, supplementary Green Book guidance, July 2021), checked 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heao> ;
    rdfs:subClassOf heao:0000001 ;
    heao:9000002 "HEMO-HOOK-27" .

heao:0000083 a owl:Class ;
    rdfs:label "informal care valuation"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A resource valuation in which the time informal carers spend giving care is converted into money, by the proxy good method, the opportunity cost method, contingent valuation or the well-being valuation method."@en ;
    obo:IAO_0000116 "Effects of caring on carers' own health, valued in QALYs, are a health-adjusted time valuation, not this."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "van den Berg et al. 2004; Koopmanschap et al. 2008" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heao> ;
    rdfs:subClassOf heao:0000004 ;
    heao:9000002 "HEMO-HOOK-28" .

heao:0000084 a owl:Class ;
    rdfs:label "proxy good method"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A market price method in which informal care time is valued at the market price of a close substitute, such as the wage of a professional home carer."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000118 "replacement cost method"@en ;
    obo:IAO_0000119 "Koopmanschap et al. 2008" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heao> ;
    rdfs:subClassOf heao:0000020 ;
    heao:9000002 "HEMO-HOOK-28" .

heao:0000087 a owl:Class ;
    rdfs:label "monetary benefit valuation"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A valuation in which a stated health benefit or other outcome is valued in money as a whole, such as by the willingness to pay elicited by contingent valuation, for use in cost-benefit analysis."@en ;
    obo:IAO_0000116 "OHEO's willingness-to-pay and willingness-to-accept estimates for a stated benefit are results of this kind of valuation."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000118 "cost-benefit valuation"@en ;
    obo:IAO_0000119 "Drummond et al. 2015" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heao> ;
    rdfs:subClassOf heao:0000001 .

heao:0000089 a owl:Class ;
    rdfs:label "size of benefit weighting"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A decision modifier weighting in which the QALYs gained from a technology are weighted according to the size of the incremental QALY gain per patient, under a size of benefit weighting rule."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "NICE 2022 (PMG36, last updated 13 October 2026), sections 6.2.20 to 6.2.24 and table 6.2, checked 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heao> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty heao:1000003 ;
            owl:someValuesFrom heao:0000093 ],
        [ a owl:Restriction ;
            owl:onProperty heao:1000008 ;
            owl:someValuesFrom heao:0000091 ],
        heao:0000088 ;
    heao:9000002 "HEMO-HOOK-25" .

heao:0000094 a owl:Class ;
    rdfs:label "adopted threshold value"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A money value of a QALY adopted by a decision-making body in a decision threshold specification, for comparison with incremental cost-effectiveness ratios and for net benefit, whatever basis it is meant to reflect, such as the £25,000 to £35,000 per QALY that NICE adopts and intends to reflect the opportunity cost of programmes displaced."@en ;
    obo:IAO_0000116 "Not declared disjoint from estimated supply-side threshold value or consumption value of a QALY, because an adopted figure may be meant to reflect either. Empirical supply-side estimates can differ from the figure a body adopts."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000118 "adopted cost-effectiveness threshold"@en,
        "decision threshold value"@en ;
    obo:IAO_0000119 "NICE 2022 (PMG36, last updated 13 October 2026), sections 6.3.4 to 6.3.8, checked 18 October 2026; NICE 2022 (PMG36, last updated 13 October 2026), section 6.3.1, checked 18 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heao> ;
    rdfs:subClassOf heao:0000046 ;
    heao:9000002 "HEMO-HOOK-11" .

heao:0000097 a owl:Class ;
    rdfs:label "partial value function"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A weight function that converts the performance of an option on one criterion of a multi-criteria decision analysis into a score on a common value scale."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Thokala et al. 2016" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heao> ;
    rdfs:subClassOf heao:0000055 ;
    heao:9000002 "HEMO-HOOK-29" .

heao:0000098 a owl:Class ;
    rdfs:label "MCDA weighted sum valuation"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A valuation in which the scores of an option on several criteria are combined into one overall value by weighting each score by its MCDA criterion weight and summing, as in the additive model of multi-criteria decision analysis."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000118 "MCDA valuation"@en ;
    obo:IAO_0000119 "Thokala et al. 2016; Marsh et al. 2016" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heao> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty heao:1000003 ;
            owl:someValuesFrom heao:0000096 ],
        heao:0000001 ;
    heao:9000002 "HEMO-HOOK-29" .

heao:0000103 a owl:Class ;
    rdfs:label "stepped declining rate discounting method"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A non-constant rate discounting method in which the discount rate is constant within stated periods and lower in later periods, so that the rate steps down as the delay grows, as in long-horizon schedules for public sector appraisal."@en ;
    obo:IAO_0000116 "Not hyperbolic. A stepped schedule changes the rate at stated times; hyperbolic discounting lowers it continuously."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000118 "stepped discount rate method"@en ;
    obo:IAO_0000119 "Attema et al. 2018" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heao> ;
    rdfs:subClassOf heao:0000102 ;
    heao:9000002 "HEMO-HOOK-23" .

heao:0000104 a owl:Class ;
    rdfs:label "differential discounting specification"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A discounting specification that states different annual discount rates for costs and for health effects."@en ;
    obo:IAO_0000116 "Differential discounting is a choice of two rates in one specification, not a way of deriving factors, so it is a specification and not a discounting method."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000118 "differential discounting"@en ;
    obo:IAO_0000119 "Attema et al. 2018; Claxton et al. 2011" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heao> ;
    rdfs:subClassOf rheo:0000093 ;
    heao:9000002 "HEMO-HOOK-01" .

heao:1000001 a owl:ObjectProperty ;
    rdfs:label "has valued quantity"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a valuation to the information content entity recording the quantity it values, such as a resource use record, a time in a health state or an amount already valued."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEAO 0.2.0 locked decisions (best practice), 18 October 2026" ;
