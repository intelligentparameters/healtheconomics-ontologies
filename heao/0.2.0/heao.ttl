heao:1000006 a owl:ObjectProperty ;
    rdfs:label "has valuation target"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a valuation to the entity its value is about, such as a health state, a kind of resource, a group of patients or a decision."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEAO 0.2.0 locked decisions (best practice), 18 October 2026" ;
