heao:1000019 a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "revaluation of"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a later valuation to an earlier valuation of the same valued quantity that it replaces, with a different weight, weight function, specification, method, perspective or context. The earlier valuation and its result are kept."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEAO 0.2.0 locked decisions (best practice), 18 October 2026" ;
