    rheo:2000002 "GBP net budget impact a year" ;
    rheo:2000003 "GBP" .

heiro:5000274 a owl:NamedIndividual,
        heiro:0000010 ;
    rdfs:label "PMG36 section 5.10.4, version of 31 March 2026"@en ;
    obo:IAO_0000116 "Read in an archived copy of the page, https://web.archive.org/web/20260809212831id_/https://www.nice.org.uk/process/pmg36/chapter/developing-the-guidance-2"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl> ;
    heiro:1000004 heiro:5000145 ;
    heiro:2000005 "https://web.archive.org/web/20260809212831id_/https://www.nice.org.uk/process/pmg36/chapter/developing-the-guidance-2"^^xsd:anyURI ;
    heiro:2000006 "5.10.4" ;
    heiro:2000007 "NHS England and NHS Improvement may request a longer time to implement the statutory funding requirements for technologies funded through its specialised commissioning budgets. This may happen for medicines when the potential net budget impact is expected to exceed £40 million per year in any of the first 3 financial years of its use in the NHS. NHS England and NHS Improvement will also do this on behalf of clinical commissioning groups, for locally commissioned technologies that NICE has evaluated." .

heiro:5000275 a owl:NamedIndividual,
        heiro:0000010 ;
    rdfs:label "PMG36 section 5.10.4, version of 13 October 2026"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl> ;
    heiro:1000004 heiro:5000148 ;
    heiro:2000005 "https://www.nice.org.uk/process/pmg36/chapter/developing-the-guidance-2#pmg36-5_10_4"^^xsd:anyURI ;
    heiro:2000006 "5.10.4" ;
    heiro:2000007 "NHS England may request a longer time to implement the statutory funding requirements for technologies funded through its specialised commissioning budgets. This may happen if: the potential net budget impact is expected to exceed £40 million a year in any of the first 3 financial years of its use in the NHS, or training, service infrastructure or health service resources are not in place. A national body or a body that is able to represent national interests, currently NHS England, is expected to do this on behalf of integrated care boards (ICBs), for locally commissioned technologies that NICE has evaluated." .

heiro:5000276 a owl:NamedIndividual,
        heiro:0000010 ;
    rdfs:label "PMG51 section 1.17, version of 27 August 2026"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl> ;
    heiro:1000004 heiro:5000151 ;
    heiro:2000005 "https://www.nice.org.uk/process/pmg51/chapter/process-considerations"^^xsd:anyURI ;
    heiro:2000006 "1.17" ;
    heiro:2000007 "The EQ-5D-5L value set must be used for all new topics starting after this interim methods statement is published. For technology appraisals and highly specialised technologies guidance, this means any topic with an invitation to participate issued after the publication of this statement." .

heiro:5000278 a owl:NamedIndividual,
        heiro:0000010 ;
    rdfs:label "PMG51 section 1.18, version of 27 August 2026"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl> ;
    heiro:1000004 heiro:5000151 ;
    heiro:2000005 "https://www.nice.org.uk/process/pmg51/chapter/process-considerations"^^xsd:anyURI ;
    heiro:2000006 "1.18" ;
    heiro:2000007 "This means that, for ongoing topics started before the publication of this interim methods statement, 5L data should continue to be mapped to 3L utility values." .

