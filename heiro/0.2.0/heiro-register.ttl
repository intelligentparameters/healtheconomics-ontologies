    dcterms:creator <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    dcterms:description "The bodies, jurisdictions, guidance documents, guidance versions, provisions, decision rules, listed amendments and check records that HEIRO 0.2.0 states as facts. Every version was found on the body's own page, live or as an archived copy, on 19 October 2026, every provision quotes its source, and every rule names its provision, version and issuer. The bodies are those named on the Institutional Perspectives tab of the healtheconomics.wiki and the issuers of the guidance read."@en ;
    dcterms:issued "2026-10-19"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
