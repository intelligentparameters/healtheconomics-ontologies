heiro:6001095 a owl:NamedIndividual,
        heiro:0000017 ;
    rdfs:label "citation of NICE PMG36 in concept assistive-technology-coverage, Concept Architecture, 2f3484"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro/heiro-wiki.owl> ;
    heiro:1000013 heiro:5000121 ;
    heiro:1000014 heiro:5000145 ;
    heiro:1000025 heiro:4000009 ;
    heiro:2000007 "The NICE manual (PMG36, last updated 31 March 2026) sets a [reference case](/concept/reference-case) in which health effects are expressed in QALYs, the EQ-5D is the preferred adult measure, costs take the NHS and personal social services perspective, and productivity costs are excluded, though they may be shown separately when critical to value." ;
    heiro:2000020 "assistive-technology-coverage" ;
    heiro:2000021 "Concept Architecture" ;
    heiro:2000022 "last updated 31 March 2026" ;
    heiro:2000023 "2026-03-31" ;
    heiro:2000026 "The version of 2026-03-31 is superseded by the version of 2026-10-13" ;
    heiro:2000036 0 ;
    heiro:2000037 "2026-10-19" ;
    heiro:9000001 hewc:assistive-technology-coverage .

