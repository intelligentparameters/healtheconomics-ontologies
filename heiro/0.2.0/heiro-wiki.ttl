heiro:6001628 a owl:NamedIndividual,
        heiro:0000017 ;
    rdfs:label "citation of NICE PMG36 in concept country-specific-value-set, Concept Architecture, 1f0444"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro/heiro-wiki.owl> ;
    heiro:1000013 heiro:5000121 ;
    heiro:1000014 heiro:5000145 ;
    heiro:1000025 heiro:4000009 ;
    heiro:2000007 "PMG36, last updated 31 March 2026, still states in section 4.3.16 that NICE does not recommend the 2018 England 5L value set and that reference-case analyses should use the 3L value set, with 5L responses mapped onto it using the Decision Support Unit model. In August 2026 NICE published an interim methods statement (PMG51) that changes this for new work. The EQ-5D-5L descriptive system and the new UK value set by Rowen and colleagues become NICE's preferred approach for adults, and the UK 5L value set should derive all adult utility values in reference-case analyses." ;
    heiro:2000020 "country-specific-value-set" ;
    heiro:2000021 "Concept Architecture" ;
    heiro:2000022 "last updated 31 March 2026" ;
    heiro:2000023 "2026-03-31" ;
    heiro:2000024 "4.2.16, 4.3.4, 4.3.5, 4.3.9, 4.3.16, 4.10.3, 6.3.4" ;
    heiro:2000026 "The version of 2026-03-31 is superseded by the version of 2026-10-13" ;
    heiro:2000036 6 ;
    heiro:2000037 "2026-10-19" ;
    heiro:2000038 false ;
    heiro:9000001 hewc:country-specific-value-set .

