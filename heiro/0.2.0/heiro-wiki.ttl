heiro:6001777 a owl:NamedIndividual,
        heiro:0000017 ;
    rdfs:label "citation of NICE PMG36 in concept diagnostic-safety, Concept Architecture, 63d6d9"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro/heiro-wiki.owl> ;
    heiro:1000013 heiro:5000121 ;
    heiro:1000014 heiro:5000145 ;
    heiro:1000025 heiro:4000009 ;
    heiro:2000007 "In technology appraisal, safer diagnosis appears through the care pathway. The NICE technology appraisal manual (PMG36, last updated 31 March 2026) notes at section 4.2.8 that a diagnostic technology may improve the speed of correct diagnosis, and asks for such process benefits to be quantified where possible. At section 4.6.12 it treats test accuracy statistics as intermediate measures that predict later health outcomes once placed in a model. Because trials that follow patients from test to final outcome are uncommon, section 4.3.18 says that linked-evidence modelling is usually needed, join" ;
    heiro:2000020 "diagnostic-safety" ;
    heiro:2000021 "Concept Architecture" ;
    heiro:2000022 "last updated 31 March 2026" ;
    heiro:2000023 "2026-03-31" ;
    heiro:2000024 "4.2.8, 4.3.18, 4.6.12, 4.6.13, 6.3.4, 6.3.5, 6.3.6, 6.3.7, 6.3.8" ;
    heiro:2000026 "The version of 2026-03-31 is superseded by the version of 2026-10-13" ;
    heiro:2000036 2 ;
    heiro:2000037 "2026-10-19" ;
    heiro:2000038 false ;
    heiro:9000001 hewc:diagnostic-safety .

