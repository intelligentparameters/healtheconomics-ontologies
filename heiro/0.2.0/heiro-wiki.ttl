heiro:6001682 a owl:NamedIndividual,
        heiro:0000017 ;
    rdfs:label "citation of NICE PMG36 in concept data-extraction, Concept Architecture, dd595a"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro/heiro-wiki.owl> ;
    heiro:1000013 heiro:5000121 ;
    heiro:1000014 heiro:5000145 ;
    heiro:1000025 heiro:4000009 ;
    heiro:2000007 "The NICE technology appraisal manual (PMG36, last updated March 2026) places study selection and data extraction under one heading in section 3.4 and expects evidence on outcomes to come from a systematic review done to a previously prepared protocol. In a [health economic model](/concept/health-economic-model) the same step supplies parameters, and the completed forms let a reviewer trace each input back to its source." ;
    heiro:2000020 "data-extraction" ;
    heiro:2000021 "Concept Architecture" ;
    heiro:2000022 "last updated March 2026" ;
    heiro:2000023 "2026-03" ;
    heiro:2000024 "3.4" ;
    heiro:2000026 "The only PMG36 version of 2026-03, of 2026-03-31, is superseded by the version of 2026-10-13" ;
    heiro:2000036 0 ;
    heiro:2000037 "2026-10-19" ;
    heiro:9000001 hewc:data-extraction .

heiro:6001683 a owl:NamedIndividual,
