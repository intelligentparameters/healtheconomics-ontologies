heiro:6001678 a owl:NamedIndividual,
        heiro:0000017 ;
    rdfs:label "citation of NICE PMG36 in concept data-exclusivity, Concept Architecture, 03d30e"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro/heiro-wiki.owl> ;
    heiro:1000013 heiro:5000121 ;
    heiro:1000014 heiro:5000145 ;
    heiro:1000025 heiro:4000009 ;
    heiro:2000007 "In England, the NICE methods manual (PMG36, last updated 31 March 2026) asks that reference-case analyses use prices that reflect as closely as possible those paid in the NHS, based on price reductions when it is known that one is available across the NHS. It also provides for rapid updates to technology appraisal guidance for medicines after loss of market exclusivity, timed to coincide with NHS Commercial Medicines Unit tenders. In each update the external assessment group checks whether cost was the key factor behind a negative or optimised recommendation." ;
    heiro:2000020 "data-exclusivity" ;
    heiro:2000021 "Concept Architecture" ;
    heiro:2000022 "last updated 31 March 2026" ;
    heiro:2000023 "2026-03-31" ;
    heiro:2000026 "The version of 2026-03-31 is superseded by the version of 2026-10-13" ;
    heiro:2000036 2 ;
    heiro:2000037 "2026-10-19" ;
    heiro:9000001 hewc:data-exclusivity .

heiro:6001681 a owl:NamedIndividual,
        heiro:0000017 ;
    rdfs:label "citation of NICE PMG36 in concept data-exclusivity, Concept Architecture, 4f5cd4"@en ;
