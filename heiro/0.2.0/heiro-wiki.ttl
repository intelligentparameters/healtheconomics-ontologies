        heiro:0000017 ;
    rdfs:label "citation of NICE PMG36 in concept data-pooling, Concept Architecture, 81b329"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro/heiro-wiki.owl> ;
    heiro:1000013 heiro:5000121 ;
    heiro:1000014 heiro:5000145 ;
    heiro:1000025 heiro:4000009 ;
    heiro:2000007 "Each component usually draws on several studies. The NICE technology appraisal manual (PMG36, last updated 31 March 2026) states in paragraph 3.4.8 that combining outcome data through meta-analysis is appropriate if there are enough relevant and valid data using comparable outcome measures. Pooling turns the results of a systematic review into model inputs with a stated uncertainty." ;
    heiro:2000020 "data-pooling" ;
    heiro:2000021 "Concept Architecture" ;
    heiro:2000022 "last updated 31 March 2026" ;
    heiro:2000023 "2026-03-31" ;
    heiro:2000024 "3.4.8, 3.4.10, 3.4.20" ;
    heiro:2000026 "The version of 2026-03-31 is superseded by the version of 2026-10-13" ;
    heiro:2000036 3 ;
    heiro:2000037 "2026-10-19" ;
    heiro:2000038 false ;
    heiro:9000001 hewc:data-pooling .

