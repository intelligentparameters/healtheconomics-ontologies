heiro:6001639 a owl:NamedIndividual,
        heiro:0000017 ;
    rdfs:label "citation of NICE PMG36 in concept coverage-policy, Concept Architecture, 6c5831"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro/heiro-wiki.owl> ;
    heiro:1000013 heiro:5000121 ;
    heiro:1000014 heiro:5000145 ;
    heiro:1000025 heiro:4000009 ;
    heiro:2000007 "The National Institute for Health and Care Excellence (NICE) writes cost-effectiveness into the criterion for the technologies it appraises in England. Its manual (PMG36, last updated 31 March 2026) normally bases a recommendation on the cost-effectiveness estimate when the most plausible [ICER](/concept/icer) is below GBP 25,000 per [QALY](/concept/qaly) gained, and above GBP 35,000 it needs an increasingly stronger case. NICE uses this [cost-effectiveness threshold](/concept/cost-effectiveness-threshold) range because it lacks the information to define the [opportunity cost](/concept/opportu" ;
    heiro:2000020 "coverage-policy" ;
    heiro:2000021 "Concept Architecture" ;
    heiro:2000022 "last updated 31 March 2026" ;
    heiro:2000023 "2026-03-31" ;
    heiro:2000026 "The version of 2026-03-31 is superseded by the version of 2026-10-13" ;
    heiro:2000036 2 ;
    heiro:2000037 "2026-10-19" ;
    heiro:9000001 hewc:coverage-policy .

