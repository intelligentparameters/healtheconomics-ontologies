heiro:6001006 a owl:NamedIndividual,
        heiro:0000017 ;
    rdfs:label "citation of NICE PMG36 in concept adverse-event, Concept Architecture, f1e2e2"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro/heiro-wiki.owl> ;
    heiro:1000013 heiro:5000121 ;
    heiro:1000014 heiro:5000145 ;
    heiro:1000025 heiro:4000011 ;
    heiro:2000007 "Several provisions of the NICE manual (PMG36, 2022, updated 2026) apply to adverse events. They expect adverse events to be counted where they change costs or health, and shown in the results." ;
    heiro:2000020 "adverse-event" ;
    heiro:2000021 "Concept Architecture" ;
    heiro:2000022 "updated 2026" ;
    heiro:2000023 "2026" ;
    heiro:2000026 "PMG36 had 2 versions in 2026 (2026-03-31, 2026-10-13), one of them the current version, so the citation should give the full date. The other dated PMG36 citation in the same record names the version of 2026-03-31" ;
    heiro:2000036 0 ;
    heiro:2000037 "2026-10-19" ;
    heiro:9000001 hewc:adverse-event .

