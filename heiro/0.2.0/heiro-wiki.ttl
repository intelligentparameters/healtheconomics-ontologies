heiro:6001908 a owl:NamedIndividual,
        heiro:0000017 ;
    rdfs:label "citation of NICE PMG36 in concept explanatory-trial, Concept Architecture, 51c2ff"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro/heiro-wiki.owl> ;
    heiro:1000013 heiro:5000121 ;
    heiro:1000014 heiro:5000148 ;
    heiro:1000025 heiro:4000010 ;
    heiro:2000007 "The NICE manual (PMG36, 2022, last updated October 2026) treats high-quality randomised trials against relevant comparators as the most valid evidence of relative efficacy, but lists among their limitations that results may not generalise because of the comparator, population, setting or treatment pathway. It judges external validity by whether results apply to wider patient groups and routine clinical practice." ;
    heiro:2000020 "explanatory-trial" ;
    heiro:2000021 "Concept Architecture" ;
    heiro:2000022 "last updated October 2026" ;
    heiro:2000023 "2026-10" ;
    heiro:2000026 "The only PMG36 version of 2026-10 is the current one, of 2026-10-13" ;
    heiro:2000036 6 ;
    heiro:2000037 "2026-10-19" ;
    heiro:9000001 hewc:explanatory-trial .

