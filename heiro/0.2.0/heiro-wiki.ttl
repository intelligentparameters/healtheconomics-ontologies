heiro:6002259 a owl:NamedIndividual,
        heiro:0000017 ;
    rdfs:label "citation of NICE PMG36 in concept time-preference, Concept Architecture, 5d0dd4"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro/heiro-wiki.owl> ;
    heiro:1000013 heiro:5000121 ;
    heiro:1000014 heiro:5000145 ;
    heiro:1000025 heiro:4000009 ;
    heiro:2000007 "The NICE manual (PMG36, last updated 31 March 2026) states in section 4.5.1 that, for the [reference case](/concept/reference-case), \"costs and health effects should be discounted at the same rate of 3.5% per year\". Section 4.5.3 lets the committee consider 1.5% a year for both costs and health effects only when all three of its criteria are met, and section 4.5 states these rates without breaking them into time preference, risk and growth." ;
    heiro:2000020 "time-preference" ;
    heiro:2000021 "Concept Architecture" ;
    heiro:2000022 "last updated 31 March 2026" ;
    heiro:2000023 "2026-03-31" ;
    heiro:2000024 "4.5, 4.5.1, 4.5.3" ;
    heiro:2000026 "The version of 2026-03-31 is superseded by the version of 2026-10-13" ;
    heiro:2000036 2 ;
    heiro:2000037 "2026-10-19" ;
    heiro:9000001 hewc:time-preference .

