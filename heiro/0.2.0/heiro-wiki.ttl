heiro:6001738 a owl:NamedIndividual,
        heiro:0000017 ;
    rdfs:label "citation of NICE PMG36 in concept decommissioning, Concept Architecture, 442b76"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro/heiro-wiki.owl> ;
    heiro:1000013 heiro:5000121 ;
    heiro:1000014 heiro:5000145 ;
    heiro:1000025 heiro:4000009 ;
    heiro:2000007 "Every funded service displaces something else under a fixed budget. The NICE technology appraisal manual (PMG36, last updated 31 March 2026) states that, given the fixed budget of the NHS, the appropriate maximum acceptable ICER is that of the opportunity cost of programmes displaced by new, more costly technologies. The same reasoning applies in reverse. If an existing service costs far more per QALY than the care displaced at the margin, withdrawing it and reinvesting the money raises population health." ;
    heiro:2000020 "decommissioning" ;
    heiro:2000021 "Concept Architecture" ;
    heiro:2000022 "last updated 31 March 2026" ;
    heiro:2000023 "2026-03-31" ;
    heiro:2000024 "6.3.9" ;
    heiro:2000026 "The version of 2026-03-31 is superseded by the version of 2026-10-13" ;
    heiro:2000036 1 ;
    heiro:2000037 "2026-10-19" ;
    heiro:2000038 false ;
    heiro:9000001 hewc:decommissioning .

