    heiro:1000013 heiro:5000121 ;
    heiro:1000025 heiro:4000012 ;
    heiro:2000007 "PMG36 bases reference-case analyses on the prices paid in the NHS, including patient access schemes, so a list price above the break-even price does not show that the net price is too high." ;
    heiro:2000020 "HE-ER-BEA-004" ;
    heiro:2000021 "Content" ;
    heiro:2000026 "Mentions of PMG36 in the text with no version date, and no dated PMG36 citation in the same record" ;
    heiro:2000036 0 ;
    heiro:2000037 "2026-10-19" ;
    heiro:9000001 hewc:break-even-analysis ;
    heiro:9000002 hemo:5000464 .

