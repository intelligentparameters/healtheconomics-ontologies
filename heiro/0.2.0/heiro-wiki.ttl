heiro:6001167 a owl:NamedIndividual,
        heiro:0000017 ;
    rdfs:label "citation of NICE PMG36 in concept benefit-package, Concept Architecture, 964763"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro/heiro-wiki.owl> ;
    heiro:1000013 heiro:5000121 ;
    heiro:1000014 heiro:5000145 ;
    heiro:1000025 heiro:4000009 ;
    heiro:2000007 "In England, regulation 7 of the 2013 NICE regulations requires NHS commissioners to fund a technology recommended in a NICE technology appraisal, normally within 3 months of publication. The NICE manual PMG36 (last updated 31 March 2026) says that below a most plausible ICER of GBP 25,000 per [QALY](/concept/qaly) gained, the decision is normally based on the cost-effectiveness estimate and acceptability as an effective use of NHS resources. Since 24 March 2026 the Secretary of State may direct NICE on the threshold to apply." ;
    heiro:2000020 "benefit-package" ;
    heiro:2000021 "Concept Architecture" ;
    heiro:2000022 "last updated 31 March 2026" ;
    heiro:2000023 "2026-03-31" ;
    heiro:2000026 "The version of 2026-03-31 is superseded by the version of 2026-10-13" ;
    heiro:2000036 0 ;
    heiro:2000037 "2026-10-19" ;
    heiro:9000001 hewc:benefit-package .

