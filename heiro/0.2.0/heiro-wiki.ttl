heiro:6001085 a owl:NamedIndividual,
        heiro:0000017 ;
    rdfs:label "citation of NICE PMG36 in concept assent, Concept Architecture, 5058e6"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro/heiro-wiki.owl> ;
    heiro:1000013 heiro:5000121 ;
    heiro:1000014 heiro:5000145 ;
    heiro:1000025 heiro:4000009 ;
    heiro:2000007 "Trial-based economic evaluations collect [health-related quality of life](/concept/health-related-quality-of-life) data, and assent shapes who supplies them. NICE's health technology evaluations manual (PMG36, last updated 31 March 2026) asks analysts to consider alternative quality of life measures for people under 18 and to report whether measures were completed by children themselves or by parents, carers or clinicians, and the children's ages. These choices affect the [health state utility values](/concept/health-state-utility-value) behind [QALYs](/concept/qaly)." ;
    heiro:2000020 "assent" ;
    heiro:2000021 "Concept Architecture" ;
    heiro:2000022 "last updated 31 March 2026" ;
    heiro:2000023 "2026-03-31" ;
    heiro:2000026 "The version of 2026-03-31 is superseded by the version of 2026-10-13" ;
    heiro:2000036 0 ;
    heiro:2000037 "2026-10-19" ;
    heiro:9000001 hewc:assent .

