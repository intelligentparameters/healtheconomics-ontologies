heiro:6001635 a owl:NamedIndividual,
        heiro:0000017 ;
    rdfs:label "citation of NICE PMG36 in concept coverage-decision, Concept Architecture, 13bc42"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro/heiro-wiki.owl> ;
    heiro:1000013 heiro:5000121 ;
    heiro:1000014 heiro:5000145 ;
    heiro:1000025 heiro:4000009 ;
    heiro:2000007 "The NICE manual (PMG36, updated 31 March 2026) states that below a most plausible [ICER](/concept/icer) of GBP 25,000 per QALY gained, the decision to recommend is normally based on the cost-effectiveness estimate. Between GBP 25,000 and GBP 35,000 the committee refers explicitly to factors such as uncertainty, uncaptured benefits and health inequalities, and above GBP 35,000 it needs an increasingly stronger case. When decision-making modifiers such as severity are applied, [net health benefit](/concept/net-health-benefit) is presented at both GBP 25,000 and GBP 35,000 per QALY to show the op" ;
    heiro:2000020 "coverage-decision" ;
    heiro:2000021 "Concept Architecture" ;
    heiro:2000022 "updated 31 March 2026" ;
    heiro:2000023 "2026-03-31" ;
    heiro:2000026 "The version of 2026-03-31 is superseded by the version of 2026-10-13" ;
    heiro:2000036 0 ;
    heiro:2000037 "2026-10-19" ;
    heiro:9000001 hewc:coverage-decision .

heiro:6001636 a owl:NamedIndividual,
        heiro:0000017 ;
