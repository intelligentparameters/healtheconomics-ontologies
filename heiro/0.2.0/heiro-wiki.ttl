heiro:6002364 a owl:NamedIndividual,
        heiro:0000017 ;
    rdfs:label "citation of NICE PMG36 in formula module record HE-ER-BMA-007, Content, c9b118"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro/heiro-wiki.owl> ;
    heiro:1000013 heiro:5000121 ;
    heiro:1000025 heiro:4000011 ;
    heiro:2000007 "A prior derived for log odds ratios is not automatically suitable for another measure, and the general healthcare prior is far wider than the one tailored to all-cause mortality. The NICE manual (PMG36, 2022, updated 2026) recommends distributions tailored to particular outcomes and disease areas, with the source noted and justified and a sensitivity analysis of candidate priors." ;
    heiro:2000020 "HE-ER-BMA-007" ;
    heiro:2000021 "Content" ;
    heiro:2000022 "updated 2026" ;
    heiro:2000023 "2026" ;
    heiro:2000026 "PMG36 had 2 versions in 2026 (2026-03-31, 2026-10-13), one of them the current version, so the citation should give the full date" ;
    heiro:2000036 0 ;
    heiro:2000037 "2026-10-19" ;
    heiro:9000001 hewc:bayesian-meta-analysis ;
    heiro:9000002 hemo:5000382 .

heiro:6002368 a owl:NamedIndividual,
