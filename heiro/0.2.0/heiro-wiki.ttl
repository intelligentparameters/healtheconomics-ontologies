heiro:6002076 a owl:NamedIndividual,
        heiro:0000017 ;
    rdfs:label "citation of NICE PMG36 in concept opportunity-cost, Concept Architecture, 92cab6"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro/heiro-wiki.owl> ;
    heiro:1000013 heiro:5000121 ;
    heiro:1000014 heiro:5000145 ;
    heiro:1000025 heiro:4000009 ;
    heiro:2000007 "NICE's manual (PMG36, last updated 31 March 2026) states in section 6.3.1 that the appropriate maximum acceptable ICER is the opportunity cost of programmes displaced by new, more costly technologies, and sections 6.3.4 to 6.3.8 set the [cost-effectiveness threshold](/concept/cost-effectiveness-threshold) as a range of GBP 25,000 to GBP 35,000 per QALY gained. The range is presented as a proxy for opportunity cost but sits well above the empirical estimates of k, which are in 2008, 2003 to 2012 and 2016 prices, and the gap remains after allowing for inflation since then." ;
    heiro:2000020 "opportunity-cost" ;
    heiro:2000021 "Concept Architecture" ;
    heiro:2000022 "last updated 31 March 2026" ;
    heiro:2000023 "2026-03-31" ;
    heiro:2000024 "4.4.1, 6.2.25, 6.3.1, 6.3.2, 6.3.4, 6.3.5, 6.3.6, 6.3.7, 6.3.8" ;
    heiro:2000026 "The version of 2026-03-31 is superseded by the version of 2026-10-13" ;
    heiro:2000036 3 ;
    heiro:2000037 "2026-10-19" ;
    heiro:2000038 false ;
    heiro:9000001 hewc:opportunity-cost .

