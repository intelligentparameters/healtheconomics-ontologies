heiro:6001281 a owl:NamedIndividual,
        heiro:0000017 ;
    rdfs:label "citation of NICE PMG36 in concept caregiver-quality-of-life, Concept Architecture, ef776e"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro/heiro-wiki.owl> ;
    heiro:1000013 heiro:5000121 ;
    heiro:1000014 heiro:5000145 ;
    heiro:1000025 heiro:4000009 ;
    heiro:2000007 "The current manual is the NICE technology appraisal and highly specialised technologies guidance manual (PMG36), published January 2022 and last updated March 2026. Its [reference case](/concept/reference-case) takes as the [perspective](/concept/perspective) on outcomes all relevant health effects, whether for patients or, when relevant, other people (mainly carers), while costs are those of the NHS and personal social services (section 4.2.7). Section 4.3.17 asks evaluations to consider carer health effects when relevant, and to show both that the condition has a substantial effect on carers" ;
    heiro:2000020 "caregiver-quality-of-life" ;
    heiro:2000021 "Concept Architecture" ;
    heiro:2000022 "last updated March 2026" ;
    heiro:2000023 "2026-03" ;
    heiro:2000024 "4.2.7, 4.3.3, 4.3.17, 6.3.4" ;
    heiro:2000026 "The only PMG36 version of 2026-03, of 2026-03-31, is superseded by the version of 2026-10-13" ;
    heiro:2000036 4 ;
    heiro:2000037 "2026-10-19" ;
