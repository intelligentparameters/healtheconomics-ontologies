heiro:6001114 a owl:NamedIndividual,
        heiro:0000017 ;
    rdfs:label "citation of NICE PMG36 in concept average-cost, Concept Architecture, 59748d"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro/heiro-wiki.owl> ;
    heiro:1000013 heiro:5000121 ;
    heiro:1000014 heiro:5000145 ;
    heiro:1000025 heiro:4000009 ;
    heiro:2000007 "Average unit costs are the standard inputs for valuing resource use in a model, and the NICE manual (PMG36, last updated 31 March 2026) accepts them while setting limits. Section 4.4.9 calls healthcare resource groups a valuable source for estimating resource use, notes that the national average unit cost of an HRG is reported through the annual reference cost collection, and says using these costs can reduce the need for local [micro-costing](/concept/micro-costing). Section 4.4.10 adds that HRG data may not be appropriate when the new technology and the comparator fall under the same HRG, or" ;
    heiro:2000020 "average-cost" ;
    heiro:2000021 "Concept Architecture" ;
    heiro:2000022 "last updated 31 March 2026" ;
    heiro:2000023 "2026-03-31" ;
    heiro:2000024 "4.4.9, 4.4.10, 4.4.20, 4.4.21" ;
    heiro:2000026 "The version of 2026-03-31 is superseded by the version of 2026-10-13" ;
    heiro:2000036 2 ;
    heiro:2000037 "2026-10-19" ;
    heiro:2000038 false ;
    heiro:9000001 hewc:average-cost .

