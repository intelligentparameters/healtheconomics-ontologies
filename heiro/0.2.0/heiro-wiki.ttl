heiro:6001277 a owl:NamedIndividual,
        heiro:0000017 ;
    rdfs:label "citation of NICE PMG36 in concept caregiver-burden, Concept Architecture, 0ecb60"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro/heiro-wiki.owl> ;
    heiro:1000013 heiro:5000121 ;
    heiro:1000014 heiro:5000145 ;
    heiro:1000025 heiro:4000009 ;
    heiro:2000007 "The NICE manual for technology appraisal and highly specialised technologies (PMG36, last updated 31 March 2026) treats carer health and carer time differently. Its [reference case](/concept/reference-case) (section 4.2.7) sets the perspective on outcomes as all relevant health effects, whether for patients or, when relevant, other people (mainly carers), while the perspective on costs is the NHS and personal social services (PSS). Section 4.3.17 asks that, when carer health effects are presented, evidence shows that the condition substantially affects carers' health-related quality of life an" ;
    heiro:2000020 "caregiver-burden" ;
    heiro:2000021 "Concept Architecture" ;
    heiro:2000022 "last updated 31 March 2026" ;
    heiro:2000023 "2026-03-31" ;
    heiro:2000024 "4.2.7, 4.3.17" ;
    heiro:2000026 "The version of 2026-03-31 is superseded by the version of 2026-10-13" ;
    heiro:2000036 1 ;
    heiro:2000037 "2026-10-19" ;
    heiro:2000038 false ;
    heiro:9000001 hewc:caregiver-burden .

