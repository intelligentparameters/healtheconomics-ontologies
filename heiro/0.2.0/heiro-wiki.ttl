heiro:6000982 a owl:NamedIndividual,
        heiro:0000017 ;
    rdfs:label "citation of NICE PMG36 in concept adaptive-trial-design, Concept Architecture, 3b9673"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro/heiro-wiki.owl> ;
    heiro:1000013 heiro:5000121 ;
    heiro:1000014 heiro:5000145 ;
    heiro:1000025 heiro:4000009 ;
    heiro:2000007 "Adaptive designs get no specific treatment in the NICE manual (PMG36, updated March 2026), so a [health technology assessment](/concept/health-technology-assessment) applies its general evidence and uncertainty requirements. The DSU checklist TSD 7 asks for early-stopped trials to enter a synthesis unadjusted when the stopping rules were prespecified. TSD 7's advice concerns pooling trials in a synthesis. Where an economic evaluation rests on a single adaptive trial, the FDA guidance and ACE point towards reporting estimates that allow for the design alongside the conventional ones." ;
    heiro:2000020 "adaptive-trial-design" ;
    heiro:2000021 "Concept Architecture" ;
    heiro:2000022 "updated March 2026" ;
    heiro:2000023 "2026-03" ;
    heiro:2000026 "The only PMG36 version of 2026-03, of 2026-03-31, is superseded by the version of 2026-10-13" ;
    heiro:2000036 0 ;
    heiro:2000037 "2026-10-19" ;
    heiro:9000001 hewc:adaptive-trial-design .

heiro:6000983 a owl:NamedIndividual,
        heiro:0000017 ;
