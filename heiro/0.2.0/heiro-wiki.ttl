    rdfs:label "citation of NICE PMG36 in concept uncertainty, Concept Architecture, 5623b1"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro/heiro-wiki.owl> ;
    heiro:1000013 heiro:5000121 ;
    heiro:1000014 heiro:5000145 ;
    heiro:1000025 heiro:4000009 ;
    heiro:2000007 "Section 4.7 of PMG36 (last updated March 2026) asks submissions for an overall assessment of the relative effect of different types of uncertainty, highlighting those unlikely to be reduced by further evidence or expert input. The model should quantify decision uncertainty, defined as the probability that a different decision would be reached if the true cost effectiveness of each technology could be known before deciding." ;
    heiro:2000020 "uncertainty" ;
    heiro:2000021 "Concept Architecture" ;
    heiro:2000022 "last updated March 2026" ;
    heiro:2000023 "2026-03" ;
    heiro:2000024 "4.7" ;
    heiro:2000026 "The only PMG36 version of 2026-03, of 2026-03-31, is superseded by the version of 2026-10-13" ;
    heiro:2000036 2 ;
    heiro:2000037 "2026-10-19" ;
    heiro:9000001 hewc:uncertainty .

