    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro/heiro-wiki.owl> ;
    heiro:1000013 heiro:5000121 ;
    heiro:1000014 heiro:5000145 ;
    heiro:1000025 heiro:4000009 ;
    heiro:2000007 "The NICE manual (PMG36, last updated 31 March 2026) states in section 4.5.1 that for the [reference case](/concept/reference-case) costs and health effects should be discounted at the same rate of 3.5% per year, and section 4.5.3 allows the committee to consider 1.5% a year for both when all of its criteria are met; both are constant rates." ;
    heiro:2000020 "hyperbolic-discounting" ;
    heiro:2000021 "Concept Architecture" ;
    heiro:2000022 "last updated 31 March 2026" ;
    heiro:2000023 "2026-03-31" ;
    heiro:2000024 "4.5.1, 4.5.3" ;
    heiro:2000026 "The version of 2026-03-31 is superseded by the version of 2026-10-13" ;
    heiro:2000036 1 ;
    heiro:2000037 "2026-10-19" ;
    heiro:2000038 false ;
    heiro:9000001 hewc:hyperbolic-discounting .

