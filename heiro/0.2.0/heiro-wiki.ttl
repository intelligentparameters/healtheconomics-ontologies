heiro:6002147 a owl:NamedIndividual,
        heiro:0000017 ;
    rdfs:label "citation of NICE PMG36 in concept property-rights, Concept Architecture, 9b5b2a"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro/heiro-wiki.owl> ;
    heiro:1000013 heiro:5000121 ;
    heiro:1000014 heiro:5000145 ;
    heiro:1000025 heiro:4000009 ;
    heiro:2000007 "Economic evaluation takes the rights regime as part of the setting. The price in a [health technology assessment](/concept/health-technology-assessment) reflects exclusivity, and the NICE manual (PMG36, last updated 31 March 2026) provides for rapid updates of medicines guidance after loss of market exclusivity, checking whether cost was the key factor in a negative or optimised recommendation. A result reached under patent protection may not hold once generics or biosimilars arrive." ;
    heiro:2000020 "property-rights" ;
    heiro:2000021 "Concept Architecture" ;
    heiro:2000022 "last updated 31 March 2026" ;
    heiro:2000023 "2026-03-31" ;
    heiro:2000026 "The version of 2026-03-31 is superseded by the version of 2026-10-13" ;
    heiro:2000036 0 ;
    heiro:2000037 "2026-10-19" ;
    heiro:9000001 hewc:property-rights .

