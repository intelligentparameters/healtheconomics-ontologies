heiro:6001142 a owl:NamedIndividual,
        heiro:0000017 ;
    rdfs:label "citation of NICE PMG36 in concept bayesian-adaptive-design, Concept Architecture, da2386"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro/heiro-wiki.owl> ;
    heiro:1000013 heiro:5000121 ;
    heiro:1000014 heiro:5000145 ;
    heiro:1000025 heiro:4000011 ;
    heiro:2000007 "The NICE manual (PMG36, 2022, updated 2026) does not mention Bayesian or adaptive trial designs, so its general requirements on evidence and uncertainty apply. The NICE Decision Support Unit's evidence synthesis checklist (TSD 7) states that trials stopped early under prespecified stopping rules should be included in an evidence synthesis without adjustment for early stopping." ;
    heiro:2000020 "bayesian-adaptive-design" ;
    heiro:2000021 "Concept Architecture" ;
    heiro:2000022 "updated 2026" ;
    heiro:2000023 "2026" ;
    heiro:2000024 "3.4.19, 6.4.14" ;
    heiro:2000026 "PMG36 had 2 versions in 2026 (2026-03-31, 2026-10-13), one of them the current version, so the citation should give the full date. The other dated PMG36 citation in the same record names the version of 2026-03-31" ;
    heiro:2000036 2 ;
    heiro:2000037 "2026-10-19" ;
    heiro:2000038 false ;
    heiro:9000001 hewc:bayesian-adaptive-design .

