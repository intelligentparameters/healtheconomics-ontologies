heiro:6001241 a owl:NamedIndividual,
        heiro:0000017 ;
    rdfs:label "citation of NICE PMG36 in concept burden-of-illness, Concept Architecture, 242c74"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro/heiro-wiki.owl> ;
    heiro:1000013 heiro:5000121 ;
    heiro:1000014 heiro:5000145 ;
    heiro:1000025 heiro:4000009 ;
    heiro:2000007 "Population burden multiplies how many people are affected by how badly each is affected. Health technology assessment usually cares about the second factor separately, as severity. The NICE technology appraisal manual (PMG36, last updated 31 March 2026) defines severity as the future health lost by people living with the condition with standard care in the NHS, and measures it by [absolute shortfall](/concept/absolute-shortfall) and [proportional shortfall](/concept/proportional-shortfall) in QALYs against the general population of the same age and sex. QALY weights of 1.2 and 1.7 apply at set" ;
    heiro:2000020 "burden-of-illness" ;
    heiro:2000021 "Concept Architecture" ;
    heiro:2000022 "last updated 31 March 2026" ;
    heiro:2000023 "2026-03-31" ;
