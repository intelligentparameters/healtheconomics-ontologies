heiro:6000984 a owl:NamedIndividual,
        heiro:0000017 ;
    rdfs:label "citation of NICE PMG36 in concept added-therapeutic-value, Concept Architecture, 28f8fc"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro/heiro-wiki.owl> ;
    heiro:1000013 heiro:5000121 ;
    heiro:1000014 heiro:5000145 ;
    heiro:1000025 heiro:4000009 ;
    heiro:2000007 "A cost-effectiveness system asks a different question. The NICE manual (PMG36, last updated March 2026) turns clinical effectiveness into QALYs and costs and judges the [ICER](/concept/icer) against its [cost-effectiveness threshold](/concept/cost-effectiveness-threshold). Below a most plausible ICER of 25,000 GBP per QALY the decision normally rests on the estimate, and above 35,000 GBP the committee needs an increasingly stronger case. The clinical gain enters through the QALY estimate and is traded against cost, so modest added benefit can be recommended at a low enough price." ;
    heiro:2000020 "added-therapeutic-value" ;
    heiro:2000021 "Concept Architecture" ;
    heiro:2000022 "last updated March 2026" ;
    heiro:2000023 "2026-03" ;
    heiro:2000026 "The only PMG36 version of 2026-03, of 2026-03-31, is superseded by the version of 2026-10-13" ;
    heiro:2000036 0 ;
    heiro:2000037 "2026-10-19" ;
    heiro:9000001 hewc:added-therapeutic-value .

heiro:6000985 a owl:NamedIndividual,
