heiro:6001775 a owl:NamedIndividual,
        heiro:0000017 ;
    rdfs:label "citation of NICE PMG36 in concept diagnostic-model, Concept Architecture, 238414"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro/heiro-wiki.owl> ;
    heiro:1000013 heiro:5000121 ;
    heiro:1000014 heiro:5000145 ;
    heiro:1000025 heiro:4000009 ;
    heiro:2000007 "The numbers below are illustrative. A diagnostic model guides referral of 1,000 primary care patients with suspected disease, of whom 80 (8%) have it. Referral for specialist assessment costs GBP 300. A case referred early gains 0.08 QALY, valued at GBP 25,000 per QALY, the lower end of the range in the NICE technology appraisal manual (PMG36, updated 31 March 2026). The benefit and harm of referral, and the threshold they imply, are as follows." ;
    heiro:2000020 "diagnostic-model" ;
    heiro:2000021 "Concept Architecture" ;
    heiro:2000022 "updated 31 March 2026" ;
    heiro:2000023 "2026-03-31" ;
    heiro:2000026 "The version of 2026-03-31 is superseded by the version of 2026-10-13" ;
    heiro:2000036 0 ;
    heiro:2000037 "2026-10-19" ;
    heiro:9000001 hewc:diagnostic-model .

