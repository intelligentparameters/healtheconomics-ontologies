heiro:6001188 a owl:NamedIndividual,
        heiro:0000017 ;
    rdfs:label "citation of NICE PMG36 in concept between-study-heterogeneity, Concept Architecture, b08fcb"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro/heiro-wiki.owl> ;
    heiro:1000013 heiro:5000121 ;
    heiro:1000014 heiro:5000145 ;
    heiro:1000025 heiro:4000009 ;
    heiro:2000007 "The NICE technology appraisal and highly specialised technologies manual (PMG36, last updated 31 March 2026) asks, in section 3.4.10, for statistical pooling to be accompanied by an assessment of heterogeneity, which a random-effects model can take into account only to some extent, with the degree and reasons explored as fully as possible." ;
    heiro:2000020 "between-study-heterogeneity" ;
    heiro:2000021 "Concept Architecture" ;
    heiro:2000022 "last updated 31 March 2026" ;
