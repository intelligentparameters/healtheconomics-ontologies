heiro:6001186 a owl:NamedIndividual,
        heiro:0000017 ;
    rdfs:label "citation of NICE PMG36 in concept between-patient-analysis, Concept Architecture, fb5a07"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro/heiro-wiki.owl> ;
    heiro:1000013 heiro:5000121 ;
    heiro:1000014 heiro:5000145 ;
    heiro:1000025 heiro:4000009 ;
    heiro:2000007 "For HTA, the NICE technology appraisal and highly specialised technologies guidance manual (PMG36, last updated 31 March 2026) expects enough probabilistic simulations to minimise Monte Carlo error, asks for cost-effectiveness estimates for each relevant [subgroup](/concept/subgroup-analysis) where benefit differs by patient characteristics, warns against post hoc data dredging, and prefers individual patient data for estimating subgroup-specific parameters." ;
    heiro:2000020 "between-patient-analysis" ;
    heiro:2000021 "Concept Architecture" ;
    heiro:2000022 "last updated 31 March 2026" ;
    heiro:2000023 "2026-03-31" ;
    heiro:2000026 "The version of 2026-03-31 is superseded by the version of 2026-10-13" ;
    heiro:2000036 0 ;
    heiro:2000037 "2026-10-19" ;
    heiro:9000001 hewc:between-patient-analysis .

heiro:6001187 a owl:NamedIndividual,
        heiro:0000017 ;
