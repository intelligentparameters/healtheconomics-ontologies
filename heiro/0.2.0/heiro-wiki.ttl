    heiro:2000007 "- NICE. NICE health technology evaluations: the manual (PMG36), section 4.3. 2022, last updated 31 March 2026. https://www.nice.org.uk/process/pmg36/chapter/economic-evaluation" ;
    heiro:2000020 "assent" ;
    heiro:2000021 "Concept Architecture" ;
    heiro:2000022 "last updated 31 March 2026" ;
