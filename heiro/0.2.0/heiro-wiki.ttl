heiro:6001722 a owl:NamedIndividual,
        heiro:0000017 ;
    rdfs:label "citation of NICE PMG36 in concept decision-rule, Concept Architecture, e03f24"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro/heiro-wiki.owl> ;
    heiro:1000013 heiro:5000121 ;
    heiro:1000014 heiro:5000145 ;
    heiro:1000025 heiro:4000009 ;
    heiro:2000007 "The NICE manual for technology appraisal (PMG36, section 6.3, last updated 31 March 2026) shows how an institution can apply a threshold as a range rather than a single cut-off. NICE's committee does not use a precise maximum acceptable ICER, and below a most plausible ICER of £25,000 per QALY gained its decision is normally based on the cost-effectiveness estimate. As the ICER rises from £25,000 to £35,000 per QALY gained, the committee makes explicit reference to the factors listed in section 6.3.5, such as the degree of certainty around the ICER and uncaptured benefits, and above £35,000 it" ;
    heiro:2000020 "decision-rule" ;
    heiro:2000021 "Concept Architecture" ;
    heiro:2000022 "last updated 31 March 2026" ;
    heiro:2000023 "2026-03-31" ;
    heiro:2000024 "6.3, 6.3.5" ;
    heiro:2000026 "The version of 2026-03-31 is superseded by the version of 2026-10-13" ;
    heiro:2000036 1 ;
    heiro:2000037 "2026-10-19" ;
    heiro:9000001 hewc:decision-rule .

