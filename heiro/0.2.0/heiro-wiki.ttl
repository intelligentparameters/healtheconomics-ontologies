heiro:6002164 a owl:NamedIndividual,
        heiro:0000017 ;
    rdfs:label "citation of NICE PMG36 in concept reference-case, Concept Architecture, 696c3c"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro/heiro-wiki.owl> ;
    heiro:1000013 heiro:5000121 ;
    heiro:1000014 heiro:5000145 ;
    heiro:1000025 heiro:4000009 ;
    heiro:2000007 "In England, the NICE reference case is set out in section 4.2 of \"NICE technology appraisal and highly specialised technologies guidance: the manual\" (PMG36, published 31 January 2022, last updated 31 March 2026). Section 4.2.1 states that economic evaluations considered by NICE should include an analysis using reference-case methods, and that additional analyses using different methods must be justified and clearly distinguished from it. Section 4.2.2 summarises the key elements in table 4.1, shown below in condensed form with the manual sections that give the detail." ;
    heiro:2000020 "reference-case" ;
    heiro:2000021 "Concept Architecture" ;
    heiro:2000022 "last updated 31 March 2026" ;
    heiro:2000023 "2026-03-31" ;
    heiro:2000024 "table 4.1, 4.2, 4.2.1, 4.2.2, 4.2.10, 4.3.16, 4.5.3, 4.7.7" ;
    heiro:2000026 "The version of 2026-03-31 is superseded by the version of 2026-10-13" ;
    heiro:2000036 8 ;
    heiro:2000037 "2026-10-19" ;
    heiro:9000001 hewc:reference-case .

