heiro:6001760 a owl:NamedIndividual,
        heiro:0000017 ;
    rdfs:label "citation of NICE PMG36 in concept deterministic-model, Concept Architecture, a6259b"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro/heiro-wiki.owl> ;
    heiro:1000013 heiro:5000121 ;
    heiro:1000014 heiro:5000145 ;
    heiro:1000025 heiro:4000009 ;
    heiro:2000007 "The NICE technology appraisal manual (PMG36, updated 31 March 2026) states in section 4.7.12 that the committee's preferred cost-effectiveness estimate should be derived from a probabilistic analysis when possible unless the model is linear, and that any use of deterministic results should be clearly justified." ;
    heiro:2000020 "deterministic-model" ;
    heiro:2000021 "Concept Architecture" ;
    heiro:2000022 "updated 31 March 2026" ;
    heiro:2000023 "2026-03-31" ;
    heiro:2000024 "4.7.12" ;
    heiro:2000026 "The version of 2026-03-31 is superseded by the version of 2026-10-13" ;
    heiro:2000036 0 ;
    heiro:2000037 "2026-10-19" ;
    heiro:2000038 false ;
    heiro:9000001 hewc:deterministic-model .

