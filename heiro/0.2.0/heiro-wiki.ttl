    heiro:1000014 heiro:5000145 ;
    heiro:1000025 heiro:4000009 ;
    heiro:2000007 "- National Institute for Health and Care Excellence. *NICE technology appraisal and highly specialised technologies guidance: the manual* (PMG36). Published 2022; last updated 31 March 2026." ;
    heiro:2000020 "data-exclusivity" ;
    heiro:2000021 "Concept Architecture" ;
    heiro:2000022 "last updated 31 March 2026" ;
    heiro:2000023 "2026-03-31" ;
