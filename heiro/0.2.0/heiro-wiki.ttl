heiro:6001762 a owl:NamedIndividual,
        heiro:0000017 ;
    rdfs:label "citation of NICE PMG36 in concept deterministic-sensitivity-analysis, Concept Architecture, e52f29"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro/heiro-wiki.owl> ;
    heiro:1000013 heiro:5000121 ;
    heiro:1000014 heiro:5000145 ;
    heiro:1000025 heiro:4000009 ;
    heiro:2000007 "The NICE technology appraisal manual (PMG36, updated 31 March 2026) requires all parameter values in base-case, sensitivity, scenario and subgroup analyses to be clinically plausible and based on methods consistent with the data (section 4.6.27), and treats demonstrably implausible scenarios as useful only to show that a conclusion is robust (section 4.7.4)." ;
    heiro:2000020 "deterministic-sensitivity-analysis" ;
    heiro:2000021 "Concept Architecture" ;
    heiro:2000022 "updated 31 March 2026" ;
    heiro:2000023 "2026-03-31" ;
