heiro:6001382 a owl:NamedIndividual,
        heiro:0000017 ;
    rdfs:label "citation of NICE PMG36 in concept clinical-guideline, Concept Architecture, d414e6"@en ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro/heiro-wiki.owl> ;
    heiro:1000013 heiro:5000121 ;
    heiro:1000014 heiro:5000145 ;
    heiro:1000025 heiro:4000009 ;
    heiro:2000007 "The technology appraisal manual (PMG36) was updated in March 2026 for a change to the cost-effectiveness threshold and now uses GBP 25,000 to GBP 35,000 per QALY, so the manual and version behind a decision matter." ;
    heiro:2000020 "clinical-guideline" ;
    heiro:2000021 "Concept Architecture" ;
    heiro:2000022 "updated in March 2026" ;
    heiro:2000023 "2026-03" ;
    heiro:2000026 "The only PMG36 version of 2026-03, of 2026-03-31, is superseded by the version of 2026-10-13" ;
    heiro:2000036 0 ;
    heiro:2000037 "2026-10-19" ;
    heiro:9000001 hewc:clinical-guideline .

