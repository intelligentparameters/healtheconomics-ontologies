    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> .

heiro:4000015 a owl:NamedIndividual,
        heiro:0000023 ;
    rdfs:label "permitted"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A deontic modality stating that the rule permits the act it covers."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators' decisions, 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> .

heiro:4000016 a owl:NamedIndividual,
        heiro:0000023 ;
    rdfs:label "forbidden"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A deontic modality stating that the rule forbids the act it covers."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators' decisions, 19 October 2026" ;
