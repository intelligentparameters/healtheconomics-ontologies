obo:OBI_0001933 a owl:Class .

heao:9000001 a owl:AnnotationProperty .

heiro:0000004 a owl:Class ;
    rdfs:label "health technology assessment body"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An organization that bears a health technology assessment role, such as the National Institute for Health and Care Excellence in England."@en ;
    obo:IAO_0000116 "A defined class and a query class for the register. An organization is classified here only when HEIRO records that it bears the role, and each such record carries the text it rests on."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000118 "HTA body"@en ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026",
        "RHEO 0.4.0 (Baines and Ashley 2026)" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    rdfs:subClassOf obo:OBI_0000245 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:OBI_0000245 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000087 ;
                        owl:someValuesFrom heiro:0000002 ] ) ] .

heiro:0000005 a owl:Class ;
    rdfs:label "methods guidance body"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An organization that bears a methods guidance role, such as a health technology assessment body that issues a methods manual for the evaluations it considers."@en ;
    obo:IAO_0000116 "A defined class and a query class for the register, like health technology assessment body."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    rdfs:subClassOf obo:OBI_0000245 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:OBI_0000245 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000087 ;
                        owl:someValuesFrom heiro:0000003 ] ) ] .

heiro:0000019 a owl:Class ;
    rdfs:label "price benchmark rule"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A directive information entity stating the money value per unit of health at which a body judges the price of a health technology to give fair value, used to set a price benchmark rather than to make a funding decision, such as ICER's range of 100,000 to 150,000 US dollars per evLY and per QALY gained."@en ;
    obo:IAO_0000116 "Kept apart from RHEO's decision threshold specification, because the body that states it makes no funding decision against it."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators' decisions, 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    rdfs:subClassOf obo:IAO_0000033 .

heiro:1000001 a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "is version of guidance document"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a guidance version to the guidance document whose lineage it belongs to."@en ;
    obo:IAO_0000116 "A sub-property of PROV-O specialization of, which links a more specific entity, such as a page on one day, to a more general one. PROV-O is not imported (see build-report.md)."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Davis and Newman 2005 (Expression of Core FRBR Concepts in RDF, vocab.org/frbr/core, 10 August 2005)",
        "Lebo et al. 2013 (W3C PROV-O, W3C Recommendation 30 April 2013)" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain heiro:0000009 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    rdfs:range heiro:0000007 ;
    rdfs:subPropertyOf prov:specializationOf .

heiro:1000003 a owl:ObjectProperty ;
    rdfs:label "is superseded by guidance version"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a guidance version to the later version of the same guidance document that replaces it for new decisions."@en ;
    obo:IAO_0000116 "The inverse of supersedes guidance version, for queries. HEIRO's records assert only supersedes."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain heiro:0000009 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    rdfs:range heiro:0000009 ;
    owl:inverseOf heiro:1000002 .

heiro:1000004 a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "is provision of"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a guidance provision to the guidance version it is part of."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026",
        "IAO, Information Artifact Ontology, release of 30 March 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain heiro:0000010 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    rdfs:range heiro:0000009 ;
    rdfs:subPropertyOf obo:BFO_0000050 .

heiro:1000006 a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "reports version status"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a guidance version check record to what it found about its guidance version on its check date."@en ;
    obo:IAO_0000116 "One check record reports one status. A version's status at another date is found from the check records of that date."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators' decisions, 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain heiro:0000015 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    rdfs:range heiro:0000014 .

heiro:1000008 a owl:ObjectProperty ;
    rdfs:label "amends provision"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a guidance provision to a provision of another guidance version whose wording it replaces, deletes, inserts before or renumbers, such as appendix A of NICE PMG51 replacing the wording of section 4.3.6 of PMG36."@en ;
    obo:IAO_0000116 "The kind of each amendment is an axiom annotation, has amendment kind. The amended provision keeps its own wording, because the amended document may not yet show the change. On 19 October 2026 section 4.3.16 of PMG36 still asked for the EQ-5D-3L value set, which PMG51 replaces for new topics."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026",
        "Publications Office 2026 (ELI ontology 1.5)" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain heiro:0000010 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    rdfs:range heiro:0000010 .

heiro:1000009 a owl:ObjectProperty ;
    rdfs:label "has jurisdiction"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a body, a guidance document or a rule to the jurisdiction in which the rules or decisions apply because the body acts for its government."@en ;
    obo:IAO_0000116 "Each assertion carries, as an axiom annotation, the text of the source that names the area. Not used for independent bodies."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026",
        "Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators' decisions, 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    rdfs:range heiro:0000006 .

heiro:1000010 a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "checks guidance document"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a guidance version check record to the guidance document whose page was read."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain heiro:0000015 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    rdfs:range heiro:0000007 .

heiro:1000011 a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "found guidance version"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a guidance version check record to the guidance version it reports on."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain heiro:0000015 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    rdfs:range heiro:0000009 .

heiro:1000012 a owl:ObjectProperty ;
    rdfs:label "is perspective of body"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates an institutional perspective record to a body whose position it records. A row of the tab that names several bodies acting together relates to each of them."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026",
        "healtheconomics.wiki Institutional Perspectives tab, read from the live concept pages on 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain heiro:0000016 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    rdfs:range obo:OBI_0000245 .

heiro:1000013 a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "cites guidance document"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a guidance citation record to the guidance document it cites."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain heiro:0000017 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    rdfs:range heiro:0000007 .

heiro:1000014 a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "resolves to guidance version"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a guidance citation record to the guidance version that the version date it cites identifies, or that the other dated citation in the same record identifies, when exactly one version is identified."@en ;
    obo:IAO_0000116 "A citation that gives only a year in which several versions were issued, or gives no version date and has no dated citation beside it, resolves to none, and its verdict says why."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026",
        "Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators' decisions, 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain heiro:0000017 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    rdfs:range heiro:0000009 .

heiro:1000015 a owl:ObjectProperty ;
    rdfs:label "is issued by"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a guidance document or a rule to the organization that issued it."@en ;
    obo:IAO_0000116 "Minted by HEIRO because RHEO's issued by (RHEO_1000057) is defined for tariffs, price agreements and recommendations only. rheo-0.4-proposals-from-heiro.md asks RHEO to widen it, and HEIRO will then map to it. It is deliberately not a sub-property of RHEO's."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators' decisions, 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    rdfs:range obo:OBI_0000245 .

heiro:1000016 a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has binding force"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a guidance document to whether the decisions or guidance made under it bind those they address."@en ;
    obo:IAO_0000116 "Each assertion carries, as an axiom annotation, the text it rests on."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators' decisions, 19 October 2026" ;
