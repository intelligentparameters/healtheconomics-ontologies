heiro:4000009 a owl:NamedIndividual,
        heiro:0000022 ;
    rdfs:label "stale citation"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A staleness verdict stating that the version a citation names, by its date or its title, had been superseded on the verdict date."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators' decisions, 19 October 2026" ;
