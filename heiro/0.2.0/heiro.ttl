    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> .

heiro:4000020 a owl:NamedIndividual,
        heiro:0000024 ;
    rdfs:label "all relevant options"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A comparator selection basis stating that every relevant option is compared."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators' decisions, 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> .

heiro:4000021 a owl:NamedIndividual,
        heiro:0000025 ;
    rdfs:label "replaces the wording of"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An amendment kind stating that the amending provision gives new wording for the amended one."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators' decisions, 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> .

heiro:4000022 a owl:NamedIndividual,
        heiro:0000025 ;
    rdfs:label "deletes"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An amendment kind stating that the amending provision removes the amended one."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators' decisions, 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> .

heiro:4000023 a owl:NamedIndividual,
        heiro:0000025 ;
    rdfs:label "inserts a new provision before"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An amendment kind stating that the amending provision adds a new provision that takes the number of the amended one."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators' decisions, 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> .

heiro:4000024 a owl:NamedIndividual,
        heiro:0000025 ;
    rdfs:label "renumbers"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An amendment kind stating that the amended provision keeps its wording but takes a new number."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators' decisions, 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> .

rheo:0000116 a owl:Class .

obo:RO_0000087 a owl:ObjectProperty .

heiro:0000001 a owl:Class ;
    rdfs:label "institutional role"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A role borne by an organization that is realised in issuing, adopting or applying rules that set or limit the options other actors in a health system have, such as which technologies are funded, at what price, or by which methods they are evaluated."@en ;
    obo:IAO_0000116 "Institutions in North's sense are the rules, and organizations are the players. HEIRO keeps the two apart. A body is an organization that bears an institutional role, and the rules it issues are directive information entities. It is a role and not a kind of organization, so that one organization can hold several roles, as with RHEO's payer role. HEIRO holds formal written rules only. Norms and conventions, which are also institutions in North's sense, are out of its scope."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Baines D. Institutional layer of the healtheconomics.wiki, unpublished notes of 3 and 4 October 2026 (institutions shape the options actors have)",
        "North 1990",
        "RHEO 0.4.0 (Baines and Ashley 2026)" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    rdfs:subClassOf obo:BFO_0000023 .

heiro:9000006 a owl:AnnotationProperty ;
    rdfs:label "is identified in task step"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a HEIRO class to a HETO task step whose work finds or applies instances of it, such as identifying the methods guidance that applies to an evaluation."@en ;
    obo:IAO_0000116 "Representational, the nearest of the five kinds, because the step records the work that finds instances of the class. heao-proposals-from-heiro.md asks HEAO to consider this case."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    heao:9000001 heao:4000002 .

obo:IAO_0000027 a owl:Class .

obo:IAO_0000033 a owl:Class .

heiro:0000018 a owl:Class ;
    rdfs:label "listed amendment"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A data entity recording a change that a body lists for a guidance version without giving the version a new date, with the month, the sections it names and the body's own summary, such as NICE's change of June 2025 to the budget impact test in sections 5.10.4 to 5.10.22 of PMG36."@en ;
    obo:IAO_0000116 "Taken from the body's own list, such as the minor changes since publication in NICE's update information or the summary of changes in ICER's framework. Changes a body does not list are not recorded, but a later check record with a different SHA-256 shows that the text changed."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators' decisions, 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    rdfs:subClassOf obo:IAO_0000027 .

heiro:0000020 a owl:Class ;
    rdfs:label "binding force"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A categorical value specification stating whether the decisions or guidance made under a guidance document bind those they address, or only advise them."@en ;
    obo:IAO_0000116 "binding for NICE technology appraisal guidance, which the regulations require the NHS to fund, and advisory for an IQWiG report to the G-BA or an ICER evidence report. Recorded only with the text it rests on."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators' decisions, 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    rdfs:subClassOf obo:OBI_0001930 .

heiro:0000021 a owl:Class ;
    rdfs:label "check method"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A categorical value specification stating how the page of a guidance document was read for a check record, live or as an archived copy."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators' decisions, 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    rdfs:subClassOf obo:OBI_0001930 .

heiro:0000023 a owl:Class ;
    rdfs:label "deontic modality"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A categorical value specification stating whether a rule requires, permits or forbids the act it covers."@en ;
    obo:IAO_0000116 "Recorded for comparator rules in 0.1.0. The deontic content of rules is what a later option space layer would read."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators' decisions, 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    rdfs:subClassOf obo:OBI_0001930 .

heiro:0000025 a owl:Class ;
    rdfs:label "amendment kind"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A categorical value specification stating what one provision does to another that it amends, replacing, deleting, inserting before or renumbering it."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators' decisions, 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    rdfs:subClassOf obo:OBI_0001930 .

heiro:0000014 a owl:Class ;
    rdfs:label "guidance version status"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A categorical value specification stating what a check record found about a guidance version on its check date, that it was the current version, that a later version had superseded it, that it had been withdrawn, or that it was the latest version when an archived copy was captured."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026",
        "Bandrowski et al. 2016 (OBI)" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    rdfs:subClassOf obo:OBI_0001930 .

heiro:0000024 a owl:Class ;
    rdfs:label "comparator selection basis"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A categorical value specification stating the basis on which a comparator rule selects the options an evaluation compares a technology with."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators' decisions, 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    rdfs:subClassOf obo:OBI_0001930 .

obo:OBI_0001930 a owl:Class .

heiro:0000010 a owl:Class ;
    rdfs:label "guidance provision"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A document part of a guidance version, identified by its section, paragraph, table or figure number, that states one or more rules, such as section 4.5.1 of NICE PMG36 as last updated on 13 October 2026."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000118 "guidance section"@en ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026",
        "IAO, Information Artifact Ontology, release of 30 March 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    rdfs:subClassOf obo:IAO_0000314 .

heiro:0000016 a owl:Class ;
    rdfs:label "institutional perspective record"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A data entity recording a body's stated position on, or use of, a health economics concept, with a title, a summary and the primary source it rests on, as published on the Institutional Perspectives tab of the concept's wiki page."@en ;
    obo:IAO_0000116 "Generated by script from the live tab. Its identifier is keyed on the site's own key, concept slug and institution, so a relabelled row gets a new record and the old one is retired. HEO's concept Institutional Perspective means the analytic viewpoint of a single institution, such as a hospital, which is a different thing and is not mapped."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026",
        "healtheconomics.wiki Institutional Perspectives tab, read from the live concept pages on 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    rdfs:subClassOf obo:IAO_0000027 .

heiro:0000022 a owl:Class ;
    rdfs:label "staleness verdict"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A categorical value specification stating whether the guidance version a citation names had been superseded on the verdict date."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators' decisions, 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    rdfs:subClassOf obo:OBI_0001930 .

heiro:0000015 a owl:Class ;
    rdfs:label "guidance version check record"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A data entity recording that on a stated date the page of a guidance document was read, live or as an archived copy, and what it showed about a stated guidance version, so that a claim that a version is current or superseded can be dated and repeated."@en ;
    obo:IAO_0000116 "Each check record names the copy that was read and its SHA-256, kept in src/sources. The status it reports holds on its check date only."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026",
        "Lebo et al. 2013 (W3C PROV-O, W3C Recommendation 30 April 2013)" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    rdfs:subClassOf obo:IAO_0000027 .

heiro:0000007 a owl:Class ;
    rdfs:label "guidance document"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An information content entity that is the lineage of successive guidance versions a body issues under one title or reference number, stating rules or recommended methods that others are to follow, such as NICE's manual PMG36 across all its updates."@en ;
    obo:IAO_0000116 "The work in the FRBR sense, with its versions as the expressions, following the pattern of RHEO's classification scheme and classification scheme version. Its content is what all its versions share, its title or reference and its scope. HEO's concept Guidance Document means the written output of one appraisal, which is a different thing, so the two are related, not matched."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026",
        "Davis and Newman 2005 (Expression of Core FRBR Concepts in RDF, vocab.org/frbr/core, 10 August 2005)",
        "RHEO 0.4.0 (Baines and Ashley 2026)" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    rdfs:subClassOf obo:IAO_0000030 .

obo:OBI_0000245 a owl:Class .

heiro:0000017 a owl:Class ;
    rdfs:label "guidance citation record"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A data entity recording that a wiki concept page or a formula module record cites a guidance document, with the version date, sections and wording of the citation as written and the mentions of the document in the same record, so that citations of a superseded version can be found."@en ;
    obo:IAO_0000116 "Generated by script. One record is one reference with the mentions that go with it. Its verdict holds on its verdict date. A corrected page gets a new record and the old one is retired."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026",
        "Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators' decisions, 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    rdfs:subClassOf obo:IAO_0000027 .

heiro:0000009 a owl:Class ;
    rdfs:label "guidance version"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A document that is one issued state of a guidance document, fixed by the date the body gives as its publication or last updated date, or by its version number, such as NICE PMG36 as last updated on 13 October 2026."@en ;
    obo:IAO_0000116 "A version record is never edited once made. It holds the document, the version date, the date in force, the label and title shown, the page, the change summary and, on the newer version, the version it supersedes. Whether a version is current is not stated on the version but on dated check records, so that two releases of HEIRO can be loaded together. A change the body makes without showing a new date is a listed amendment of the version in force, not a version."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000118 "guidance edition"@en ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026",
        "Davis and Newman 2005 (Expression of Core FRBR Concepts in RDF, vocab.org/frbr/core, 10 August 2005)",
        "RHEO 0.4.0 (Baines and Ashley 2026)" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    rdfs:subClassOf obo:IAO_0000310 .

<https://healtheconomics.wiki/ontologies/heiro> a owl:Ontology ;
    dcterms:bibliographicCitation "Baines D, Ashley M. Health Economics Institutions and Rules Ontology (HEIRO), version 0.1.0. Intelligent Parameters Ltd; 2026. https://healtheconomics.wiki/ontologies/heiro/0.2.0/heiro.owl. Licence CC BY 4.0." ;
    dcterms:created "2026-10-19"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0001-9502-4678>,
        <https://orcid.org/0009-0006-0231-3731> ;
    dcterms:description "HEIRO, the Health Economics Institutions and Rules Ontology, holds the institutions of health economics and health technology assessment in Darrin Baines's sense, the rules that set the options actors have, and keeps them apart from the organizations that issue and apply them. A body is an organization that bears an institutional role, such as a health technology assessment role. Its rules are stated in guidance documents, each a lineage of dated guidance versions, and every rule HEIRO records names its provision, version and issuer, when it is in force and which appraisals it applies to. Versions are never edited. Dated check records say what each page showed on the day it was read, live or as an archived copy, so that any page, formula or rule that cites a guidance version can be found and flagged when a newer version exists. HEIRO reuses RHEO for organizations, geographic areas, decision threshold, discounting and perspective specifications, HEAO for decision modifier rules, value types and its five linking kinds, OHEO for reference case requirements and profiles, IAO for documents and their parts, and PROV-O for revision and derivation."@en ;
    dcterms:issued "2026-10-19"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:publisher "Intelligent Parameters Ltd" ;
    dcterms:title "Health Economics Institutions and Rules Ontology (HEIRO)"@en ;
    vann:preferredNamespacePrefix "heiro" ;
    vann:preferredNamespaceUri "https://healtheconomics.wiki/ontologies/heiro/HEIRO_" ;
    rdfs:comment "First release, status alpha, revised in place after three independent reviews on 19 October 2026. HEIRO imports RHEO 0.4.0 (which imports BFO 2020), HEAO 0.2.0 as published (which imports OHEO 0.3.0 and the RHEO uncertainty module, and holds the five linking kinds), and an extract of IAO for document part. Load heiro-register.owl for the bodies, guidance documents, versions and rules, and heiro-wiki.owl for the records generated from the healtheconomics.wiki. Term IRIs are https://healtheconomics.wiki/ontologies/heiro/HEIRO_ and seven digits."@en ;
    rdfs:seeAlso <https://healtheconomics.wiki/ontologies/heo> ;
    owl:imports <https://healtheconomics.wiki/ontologies/heao/0.2.0/heao.owl>,
        <https://healtheconomics.wiki/ontologies/heiro/0.2.0/imports/iao-extract.owl>,
        <https://healtheconomics.wiki/ontologies/rheo/0.4.0/rheo.owl> ;
    owl:versionIRI <https://healtheconomics.wiki/ontologies/heiro/0.2.0/heiro.owl> ;
    owl:versionInfo "0.2.0 (alpha)" ;
    foaf:homepage <https://healtheconomics.wiki/ontologies/heiro> .

