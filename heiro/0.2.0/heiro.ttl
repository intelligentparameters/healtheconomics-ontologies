    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    heao:9000001 heao:4000002 .

heiro:9000003 a owl:AnnotationProperty ;
    rdfs:label "sets out reference case profile"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a guidance version to an OHEO reference case profile whose methods it states, alone or together with another version."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026",
        "OHEO 0.3.0 (Baines and Ashley 2026)" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    heao:9000001 heao:4000002 .

heiro:9000004 a owl:AnnotationProperty ;
    rdfs:label "supplies policy input to"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a stated decision rule to a HEMO formula that takes the figures of the rule as inputs, such as a discounting rule and the present value formula."@en ;
    obo:IAO_0000116 "0.1.0 links the discounting, threshold, price benchmark and modifier rules of the documents it holds."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    heao:9000001 heao:4000003 .

heiro:9000005 a owl:AnnotationProperty ;
    rdfs:label "states value of type"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a stated decision rule to the HEAO class of the figure it states, such as a threshold rule and adopted threshold value."@en ;
    obo:IAO_0000116 "Definitional, because the HEAO class classifies the figure the rule states."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026",
        "HEAO 0.2.0 (Baines and Ashley 2026)" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    heao:9000001 heao:4000001 .

heiro:9000007 a owl:AnnotationProperty ;
    rdfs:label "has amendment kind"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates an amends provision assertion, as an axiom annotation, to the kind of amendment it is."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators' decisions, 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
