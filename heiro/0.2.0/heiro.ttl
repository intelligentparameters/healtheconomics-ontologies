    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> .

heiro:4000012 a owl:NamedIndividual,
        heiro:0000022 ;
    rdfs:label "cannot tell"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A staleness verdict stating that a citation names no version, by date or by title, and no dated citation in the same record names one."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators' decisions, 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> .

heiro:4000013 a owl:NamedIndividual,
        heiro:0000022 ;
    rdfs:label "historical on purpose"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A staleness verdict stating that a citation names an earlier version deliberately, saying that the version was replaced."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators' decisions, 19 October 2026" ;
