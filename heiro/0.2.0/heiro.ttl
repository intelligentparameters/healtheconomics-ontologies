heiro:1000021 a owl:ObjectProperty ;
    rdfs:label "carries out work commissioned by"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a body to an organization that commissions its work, such as the NICE Decision Support Unit and NICE."@en ;
    obo:IAO_0000116 "Not part of. The NICE Decision Support Unit's technical support documents are not NICE guidance."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators' decisions, 19 October 2026" ;
