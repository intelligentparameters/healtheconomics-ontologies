    rdfs:range heiro:0000021 .

heiro:1000019 a owl:ObjectProperty ;
    rdfs:label "names guidance document"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates an institutional perspective record whose Institution field names a rule, not a body, to the guidance document that holds it."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators' decisions, 19 October 2026" ;
