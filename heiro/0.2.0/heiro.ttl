        heiro:0000014 ;
    rdfs:label "current version"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A guidance version status stating that the page read on the check date showed the version as the latest version of its guidance document."@en ;
