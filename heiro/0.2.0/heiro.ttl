        owl:ObjectProperty ;
    rdfs:label "has deontic modality"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a rule to whether it requires, permits or forbids the act it covers."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
