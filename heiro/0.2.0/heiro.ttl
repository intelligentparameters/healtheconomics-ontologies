        owl:FunctionalProperty ;
    rdfs:label "has version date"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "The date that identifies a guidance version, written YYYY-MM-DD where the body gives a full date, and YYYY-MM or YYYY where the body gives only a month or a year."@en ;
