heiro:4000011 a owl:NamedIndividual,
        heiro:0000022 ;
    rdfs:label "imprecise citation, add the full date"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A staleness verdict stating that a citation gives only a year in which the guidance document had more than one version, so it should give the full date."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators' decisions, 19 October 2026" ;
