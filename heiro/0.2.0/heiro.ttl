        owl:ObjectProperty ;
    rdfs:label "has staleness verdict"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a guidance citation record to whether the version it names had been superseded on its verdict date."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
