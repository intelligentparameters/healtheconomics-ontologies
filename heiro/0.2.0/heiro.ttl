    rdfs:label "is established by"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a body to the guidance document or legal act that establishes it, such as the Member State Coordination Group on Health Technology Assessment and Regulation (EU) 2021/2282."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators' decisions, 19 October 2026" ;
