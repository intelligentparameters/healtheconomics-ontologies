[] a owl:Axiom ;
    rdfs:comment "HETO's step Identify the decision maker and any methods guidance that applies finds the methods guidance documents of HEIRO for an evaluation."@en ;
    owl:annotatedProperty heiro:9000006 ;
    owl:annotatedSource heiro:0000008 ;
    owl:annotatedTarget heto:4200301 ;
    heao:9000001 heao:4000002 .

[] a owl:Axiom ;
    rdfs:comment "HETO's step Align the evaluation methods with the methods guidance of the decision maker or assessment body applies the stated decision rules that HEIRO records for that body."@en ;
    owl:annotatedProperty heiro:9000006 ;
    owl:annotatedSource heiro:0000011 ;
    owl:annotatedTarget heto:4200203 ;
    heao:9000001 heao:4000002 .

