    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> .

heiro:4000017 a owl:NamedIndividual,
        heiro:0000024 ;
    rdfs:label "established practice"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A comparator selection basis stating that comparators are the options in established use in the health system."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators' decisions, 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> .

heiro:4000018 a owl:NamedIndividual,
        heiro:0000024 ;
    rdfs:label "most likely to be replaced"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A comparator selection basis stating that the comparator is the option the technology is most likely to replace."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators' decisions, 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> .

heiro:4000019 a owl:NamedIndividual,
        heiro:0000024 ;
    rdfs:label "designated by another body"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A comparator selection basis stating that another body names the comparator, as the G-BA names the appropriate comparator therapy for IQWiG."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators' decisions, 19 October 2026" ;
