heiro:0000002 a owl:Class ;
    rdfs:label "health technology assessment role"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An institutional role that is realised in assessing evidence on a health technology, including economic evaluations, to inform or make a decision on whether and on what terms the technology is funded."@en ;
    obo:IAO_0000116 "Realised in processes that make or inform funding decisions. RHEO's health technology assessment decision process (RHEO_0000062) covers those that decide, and a process that only informs, such as an IQWiG assessment for the G-BA, is proposed for RHEO 0.4."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000118 "HTA role"@en ;
    obo:IAO_0000119 "Drummond et al. 2015",
        "RHEO 0.4.0 (Baines and Ashley 2026)" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    rdfs:subClassOf heiro:0000001 .

heiro:0000003 a owl:Class ;
    rdfs:label "methods guidance role"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An institutional role that is realised in issuing guidance documents stating the methods by which evidence, including economic evaluations, is to be produced or assessed, such as a reference case with its discount rate, perspective and outcome measure."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026",
        "OHEO 0.3.0 (Baines and Ashley 2026)" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    rdfs:subClassOf heiro:0000001 .

heiro:0000006 a owl:Class ;
    rdfs:label "jurisdiction"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A geographic area whose boundaries are drawn by a government with power to make binding rules within it, such as a country, a nation of the United Kingdom or a federal state, so that the rules of bodies acting for that government apply there."@en ;
    obo:IAO_0000116 "Coded with RHEO's has jurisdiction code (ISO 3166). Only a body that acts for such a government, or a document it issues, has a jurisdiction. An independent body, such as ICER, has none, and its guidance has the binding force advisory. Arrangements that carry one body's guidance into another area, such as the service-level agreements that disseminate NICE technology evaluation guidance in Wales and Northern Ireland, are not modelled in 0.1.0."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026",
        "RHEO 0.4.0 (Baines and Ashley 2026)" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    rdfs:subClassOf rheo:0000116 .

heiro:0000008 a owl:Class ;
    rdfs:label "methods guidance document"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A guidance document stating the methods by which evidence, including economic evaluations, is to be produced or assessed for a body's decisions, such as a technology appraisal manual or national guidelines for economic evaluation."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000118 "methods guide"@en,
        "pharmacoeconomic guidelines"@en ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026",
        "Drummond et al. 2015" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    rdfs:subClassOf heiro:0000007 ;
    heiro:9000006 heto:4200301 .

heiro:0000011 a owl:Class ;
    rdfs:label "stated decision rule"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A directive information entity that is stated in a guidance provision."@en ;
    obo:IAO_0000116 "A defined class and a query class. The text definition matches the logical one. HEIRO adds a kind of rule only where no other ontology of the family has one. A threshold is a RHEO decision threshold specification, a discount rate a RHEO discounting specification, a perspective a RHEO perspective specification, a funding condition a RHEO funding rule, a severity or size of benefit modifier a HEAO decision modifier rule, and an outcome requirement an OHEO outcome reference case requirement. HEIRO adds the comparator rule and the price benchmark rule, and records for every rule its provision, version and issuer, when it is in force and which appraisals it applies to."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000118 "decision rule"@en ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026",
        "HEAO 0.2.0 (Baines and Ashley 2026)",
        "OHEO 0.3.0 (Baines and Ashley 2026)",
        "RHEO 0.4.0 (Baines and Ashley 2026)" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    rdfs:subClassOf obo:IAO_0000033 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:IAO_0000033 [ a owl:Restriction ;
                        owl:onProperty heiro:1000005 ;
                        owl:someValuesFrom heiro:0000010 ] ) ] ;
    heiro:9000006 heto:4200203 .

heiro:0000012 a owl:Class ;
    rdfs:label "comparator rule"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A directive information entity stating which options an evaluation or appraisal must, may or must not compare a health technology with, such as technologies that are established practice in the NHS."@en ;
    obo:IAO_0000116 "No other ontology of the family holds this kind of rule. RHEO's has comparator records the comparator an analysis used, not the rule that chose it. A comparator rule states its deontic modality and its selection basis."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Drummond et al. 2015",
        "NICE PMG36 (NICE technology appraisal and highly specialised technologies guidance, the manual, last updated 13 October 2026), read 19 October 2026" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    rdfs:subClassOf obo:IAO_0000033 .

heiro:1000002 a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:label "supersedes guidance version"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a guidance version to the earlier version of the same guidance document that it replaces for new decisions."@en ;
    obo:IAO_0000116 "Asserted on the newer version only, so no older record is edited. Holds between consecutive versions. Asymmetric, so it cannot also be transitive, and any later version is a property path in SPARQL."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026",
        "Lebo et al. 2013 (W3C PROV-O, W3C Recommendation 30 April 2013)" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:domain heiro:0000009 ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    rdfs:range heiro:0000009 ;
    rdfs:subPropertyOf prov:wasRevisionOf .

heiro:1000005 a owl:ObjectProperty ;
    rdfs:label "is stated in provision"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a rule to the guidance provision that states it, so that the source version and section of the rule can be found."@en ;
    obo:IAO_0000116 "A sub-property of PROV-O was derived from, as RHEO's taken from source is. It has no domain, because the rules are typed with the classes of RHEO, HEAO and OHEO."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026",
        "Lebo et al. 2013 (W3C PROV-O, W3C Recommendation 30 April 2013)" ;
    dcterms:contributor <https://orcid.org/0009-0006-0231-3731> ;
    rdfs:isDefinedBy <https://healtheconomics.wiki/ontologies/heiro> ;
    rdfs:range heiro:0000010 ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    heao:9000001 heao:4000002 .

