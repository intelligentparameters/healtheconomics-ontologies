    rdfs:range heiro:0000020 .

heiro:1000017 a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "is amendment of version"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "Relates a listed amendment to the guidance version in force when the body made the change."@en ;
    obo:IAO_0000117 "Michelle Ashley (drafted with Claude)" ;
    obo:IAO_0000119 "Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators' decisions, 19 October 2026" ;
