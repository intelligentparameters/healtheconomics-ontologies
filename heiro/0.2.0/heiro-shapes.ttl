@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix heiro: <https://healtheconomics.wiki/ontologies/heiro/HEIRO_> .
@prefix heirosh: <https://healtheconomics.wiki/ontologies/heiro/shapes/> .
@prefix rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_> .
@prefix heao: <https://healtheconomics.wiki/ontologies/heao/HEAO_> .

<https://healtheconomics.wiki/ontologies/heiro/shapes> a owl:Ontology ;
    dcterms:title "HEIRO record rules (SHACL)"@en ;
    dcterms:description "Record rules for HEIRO 0.2.0. Core SHACL targets and SHACL-SPARQL constraints only, so plain SHACL runs every rule. They apply only to HEIRO terms."@en ;
    dcterms:issued "2026-10-19"^^xsd:date ;
    owl:versionInfo "0.2.0 (alpha)" .

heirosh:GuidanceVersionShape a sh:NodeShape ;
    sh:targetClass heiro:0000009 ; sh:targetSubjectsOf heiro:1000001, heiro:1000002 ;
    sh:property [ sh:path heiro:1000001 ; sh:minCount 1 ; sh:class heiro:0000007 ;
        sh:message "A guidance version names exactly one guidance document."@en ] ;
    sh:property [ sh:path heiro:2000001 ; sh:minCount 1 ;
        sh:message "A guidance version has a version date, written YYYY-MM-DD, YYYY-MM or YYYY."@en ] ;
    sh:property [ sh:path heiro:2000005 ; sh:minCount 1 ;
        sh:message "A guidance version gives the address it was read at."@en ] ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:severity sh:Violation ;
        sh:message "No check record reports on this guidance version."@en ;
        sh:select """PREFIX heiro: <https://healtheconomics.wiki/ontologies/heiro/HEIRO_>
            PREFIX rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_>
            PREFIX heao: <https://healtheconomics.wiki/ontologies/heao/HEAO_>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX obo: <http://purl.obolibrary.org/obo/>
            SELECT $this ?value WHERE { FILTER NOT EXISTS { ?c heiro:1000011 $this } BIND($this AS ?value) }""" ] ;

    sh:sparql [ a sh:SPARQLConstraint ; sh:severity sh:Violation ;
        sh:message "A check record reports this version current on a date when a later version was already in force."@en ;
        sh:select """PREFIX heiro: <https://healtheconomics.wiki/ontologies/heiro/HEIRO_>
            PREFIX rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_>
            PREFIX heao: <https://healtheconomics.wiki/ontologies/heao/HEAO_>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX obo: <http://purl.obolibrary.org/obo/>
            SELECT $this ?value WHERE { ?c heiro:1000011 $this ; heiro:1000006 heiro:4000001 ; heiro:2000008 ?cd . ?value heiro:1000002 $this ; heiro:2000028 ?f . FILTER (STR(?f) <= STR(?cd)) }""" ] ;

    sh:sparql [ a sh:SPARQLConstraint ; sh:severity sh:Violation ;
        sh:message "A check record reports this version superseded, but no version supersedes it."@en ;
        sh:select """PREFIX heiro: <https://healtheconomics.wiki/ontologies/heiro/HEIRO_>
            PREFIX rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_>
            PREFIX heao: <https://healtheconomics.wiki/ontologies/heao/HEAO_>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX obo: <http://purl.obolibrary.org/obo/>
            SELECT $this ?value WHERE { ?c heiro:1000011 $this ; heiro:1000006 heiro:4000002 . FILTER NOT EXISTS { ?n heiro:1000002 $this } BIND(?c AS ?value) }""" ] ;

    sh:sparql [ a sh:SPARQLConstraint ; sh:severity sh:Violation ;
        sh:message "A guidance version supersedes a version of another guidance document."@en ;
        sh:select """PREFIX heiro: <https://healtheconomics.wiki/ontologies/heiro/HEIRO_>
            PREFIX rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_>
            PREFIX heao: <https://healtheconomics.wiki/ontologies/heao/HEAO_>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX obo: <http://purl.obolibrary.org/obo/>
            SELECT $this ?value WHERE { $this heiro:1000002 ?value ; heiro:1000001 ?d1 . ?value heiro:1000001 ?d2 . FILTER (?d1 != ?d2) }""" ] ;

    sh:sparql [ a sh:SPARQLConstraint ; sh:severity sh:Violation ;
        sh:message "A guidance version supersedes a version with a later or equal version date."@en ;
        sh:select """PREFIX heiro: <https://healtheconomics.wiki/ontologies/heiro/HEIRO_>
            PREFIX rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_>
            PREFIX heao: <https://healtheconomics.wiki/ontologies/heao/HEAO_>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX obo: <http://purl.obolibrary.org/obo/>
            SELECT $this ?value WHERE { $this heiro:1000002 ?value ; heiro:2000001 ?a . ?value heiro:2000001 ?b . FILTER (STR(?b) >= SUBSTR(STR(?a), 1, STRLEN(STR(?b)))) }""" ] ;

    sh:sparql [ a sh:SPARQLConstraint ; sh:severity sh:Violation ;
        sh:message "A guidance version is in force from a date not after an older version it supersedes, so their periods overlap."@en ;
        sh:select """PREFIX heiro: <https://healtheconomics.wiki/ontologies/heiro/HEIRO_>
            PREFIX rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_>
            PREFIX heao: <https://healtheconomics.wiki/ontologies/heao/HEAO_>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX obo: <http://purl.obolibrary.org/obo/>
            SELECT $this ?value WHERE { $this heiro:1000002 ?value ; heiro:2000028 ?a . ?value heiro:2000028 ?b . FILTER (STR(?a) <= STR(?b)) }""" ] ;

    sh:sparql [ a sh:SPARQLConstraint ; sh:severity sh:Violation ;
        sh:message "A guidance version is in force before its own version date."@en ;
        sh:select """PREFIX heiro: <https://healtheconomics.wiki/ontologies/heiro/HEIRO_>
            PREFIX rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_>
            PREFIX heao: <https://healtheconomics.wiki/ontologies/heao/HEAO_>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX obo: <http://purl.obolibrary.org/obo/>
            SELECT $this ?value WHERE { $this heiro:2000028 ?value ; heiro:2000001 ?d . FILTER (STR(?value) < SUBSTR(STR(?d), 1, STRLEN(STR(?value)))) }""" ] ;

    sh:sparql [ a sh:SPARQLConstraint ; sh:severity sh:Violation ;
        sh:message "The last updated date of a version differs from its version date."@en ;
        sh:select """PREFIX heiro: <https://healtheconomics.wiki/ontologies/heiro/HEIRO_>
            PREFIX rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_>
            PREFIX heao: <https://healtheconomics.wiki/ontologies/heao/HEAO_>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX obo: <http://purl.obolibrary.org/obo/>
            SELECT $this ?value WHERE { $this heiro:2000002 ?value ; heiro:2000001 ?d . FILTER (STR(?value) != STR(?d)) }""" ] ;

    .

heirosh:GuidanceDocumentShape a sh:NodeShape ;
    sh:targetClass heiro:0000007 ;
    sh:property [ sh:path heiro:1000015 ; sh:minCount 1 ; sh:class obo:OBI_0000245 ;
        sh:message "A guidance document names the organization that issued it."@en ] ;
    sh:property [ sh:path heiro:1000016 ; sh:in ( heiro:4000005 heiro:4000006 ) ;
        sh:message "A binding force is binding or advisory."@en ] ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:message "A guidance document has a label."@en ] ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:severity sh:Violation ;
        sh:message "No check record reports any version of this guidance document current."@en ;
        sh:select """PREFIX heiro: <https://healtheconomics.wiki/ontologies/heiro/HEIRO_>
            PREFIX rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_>
            PREFIX heao: <https://healtheconomics.wiki/ontologies/heao/HEAO_>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX obo: <http://purl.obolibrary.org/obo/>
            SELECT $this ?value WHERE { FILTER NOT EXISTS { ?v heiro:1000001 $this . ?c heiro:1000011 ?v ; heiro:1000006 heiro:4000001 } BIND($this AS ?value) }""" ] ;

    sh:sparql [ a sh:SPARQLConstraint ; sh:severity sh:Violation ;
        sh:message "Two versions of this guidance document are reported current by check records of the same date."@en ;
        sh:select """PREFIX heiro: <https://healtheconomics.wiki/ontologies/heiro/HEIRO_>
            PREFIX rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_>
            PREFIX heao: <https://healtheconomics.wiki/ontologies/heao/HEAO_>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX obo: <http://purl.obolibrary.org/obo/>
            SELECT $this ?value WHERE { ?v1 heiro:1000001 $this . ?value heiro:1000001 $this . ?c1 heiro:1000011 ?v1 ; heiro:1000006 heiro:4000001 ; heiro:2000008 ?d . ?c2 heiro:1000011 ?value ; heiro:1000006 heiro:4000001 ; heiro:2000008 ?d . FILTER (?v1 != ?value) }""" ] ;

    .

heirosh:GuidanceProvisionShape a sh:NodeShape ;
    sh:targetClass heiro:0000010 ; sh:targetSubjectsOf heiro:1000004 ;
    sh:property [ sh:path heiro:1000004 ; sh:minCount 1 ; sh:class heiro:0000009 ;
        sh:message "A guidance provision is part of exactly one guidance version."@en ] ;
    sh:property [ sh:path heiro:2000006 ; sh:minCount 1 ;
        sh:message "A guidance provision has exactly one section, paragraph, table or figure number."@en ] ;
    sh:property [ sh:path heiro:2000007 ; sh:minCount 1 ;
        sh:message "A guidance provision quotes the text it was read from."@en ] .

heirosh:StatedDecisionRuleShape a sh:NodeShape ;
    sh:targetClass heiro:0000011 ; sh:targetSubjectsOf heiro:1000005 ;
    sh:property [ sh:path heiro:1000005 ; sh:minCount 1 ; sh:class heiro:0000010 ;
        sh:message "A stated decision rule names the guidance provision, and so the version, it comes from."@en ] ;
    sh:property [ sh:path heiro:1000015 ; sh:minCount 1 ; sh:class obo:OBI_0000245 ;
        sh:message "A stated decision rule names the organization that issued it."@en ] ;
    sh:property [ sh:path heiro:2000030 ; sh:minCount 1 ;
        sh:message "A stated decision rule gives the version date of the earliest version read that states it."@en ] ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:severity sh:Violation ;
        sh:message "A stated decision rule is stated only in superseded versions, and no rule supersedes it and no date ends it."@en ;
        sh:select """PREFIX heiro: <https://healtheconomics.wiki/ontologies/heiro/HEIRO_>
            PREFIX rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_>
            PREFIX heao: <https://healtheconomics.wiki/ontologies/heao/HEAO_>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX obo: <http://purl.obolibrary.org/obo/>
            SELECT $this ?value WHERE { FILTER NOT EXISTS { $this heiro:1000005 ?p . ?p heiro:1000004 ?v . FILTER NOT EXISTS { ?w heiro:1000002 ?v } } FILTER NOT EXISTS { ?n heao:1000026 $this } FILTER NOT EXISTS { $this heiro:2000029 ?e } $this heiro:1000005 ?value }""" ] ;

    sh:sparql [ a sh:SPARQLConstraint ; sh:severity sh:Violation ;
        sh:message "A rule that another rule supersedes has no date on which it stopped being in force."@en ;
        sh:select """PREFIX heiro: <https://healtheconomics.wiki/ontologies/heiro/HEIRO_>
            PREFIX rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_>
            PREFIX heao: <https://healtheconomics.wiki/ontologies/heao/HEAO_>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX obo: <http://purl.obolibrary.org/obo/>
            SELECT $this ?value WHERE { ?value heao:1000026 $this . FILTER NOT EXISTS { $this heiro:2000029 ?e } }""" ] ;

    sh:sparql [ a sh:SPARQLConstraint ; sh:severity sh:Violation ;
        sh:message "A rule stops being in force before it starts."@en ;
        sh:select """PREFIX heiro: <https://healtheconomics.wiki/ontologies/heiro/HEIRO_>
            PREFIX rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_>
            PREFIX heao: <https://healtheconomics.wiki/ontologies/heao/HEAO_>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX obo: <http://purl.obolibrary.org/obo/>
            SELECT $this ?value WHERE { $this heiro:2000028 ?s ; heiro:2000029 ?value . FILTER (STR(?value) < STR(?s)) }""" ] ;

    sh:sparql [ a sh:SPARQLConstraint ; sh:severity sh:Violation ;
        sh:message "A rule stopped being in force before a version that states it came into force."@en ;
        sh:select """PREFIX heiro: <https://healtheconomics.wiki/ontologies/heiro/HEIRO_>
            PREFIX rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_>
            PREFIX heao: <https://healtheconomics.wiki/ontologies/heao/HEAO_>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX obo: <http://purl.obolibrary.org/obo/>
            SELECT $this ?value WHERE { $this heiro:2000029 ?u ; heiro:1000005 ?p . ?p heiro:1000004 ?value . ?value heiro:2000028 ?f . FILTER (SUBSTR(STR(?f), 1, STRLEN(STR(?u))) > STR(?u)) }""" ] ;

    sh:sparql [ a sh:SPARQLConstraint ; sh:severity sh:Violation ;
        sh:message "A rule's first-read version date is not the date of a version that states it."@en ;
        sh:select """PREFIX heiro: <https://healtheconomics.wiki/ontologies/heiro/HEIRO_>
            PREFIX rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_>
            PREFIX heao: <https://healtheconomics.wiki/ontologies/heao/HEAO_>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX obo: <http://purl.obolibrary.org/obo/>
            SELECT $this ?value WHERE { $this heiro:2000030 ?value . FILTER NOT EXISTS { $this heiro:1000005 ?p . ?p heiro:1000004 ?v . ?v heiro:2000001 ?vd . FILTER (STR(?vd) = STR(?value)) } }""" ] ;

    sh:sparql [ a sh:SPARQLConstraint ; sh:severity sh:Violation ;
        sh:message "A rule states a money value or range but no currency code."@en ;
        sh:select """PREFIX heiro: <https://healtheconomics.wiki/ontologies/heiro/HEIRO_>
            PREFIX rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_>
            PREFIX heao: <https://healtheconomics.wiki/ontologies/heao/HEAO_>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX obo: <http://purl.obolibrary.org/obo/>
            SELECT $this ?value WHERE { { $this rheo:2000001 ?value } UNION { $this heiro:2000011 ?value } UNION { $this heiro:2000012 ?value } { $this a rheo:0000117 } UNION { $this a heiro:0000019 } FILTER NOT EXISTS { $this rheo:2000003 ?c } }""" ] ;

    sh:sparql [ a sh:SPARQLConstraint ; sh:severity sh:Violation ;
        sh:message "A discount rate is not a proportion from 0 to below 1, such as 0.035."@en ;
        sh:select """PREFIX heiro: <https://healtheconomics.wiki/ontologies/heiro/HEIRO_>
            PREFIX rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_>
            PREFIX heao: <https://healtheconomics.wiki/ontologies/heao/HEAO_>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX obo: <http://purl.obolibrary.org/obo/>
            SELECT $this ?value WHERE { { $this rheo:2000030 ?value } UNION { $this rheo:2000031 ?value } FILTER (?value < 0 || ?value >= 1) }""" ] ;

    sh:sparql [ a sh:SPARQLConstraint ; sh:severity sh:Violation ;
        sh:message "The lower end of a range is above its upper end."@en ;
        sh:select """PREFIX heiro: <https://healtheconomics.wiki/ontologies/heiro/HEIRO_>
            PREFIX rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_>
            PREFIX heao: <https://healtheconomics.wiki/ontologies/heao/HEAO_>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX obo: <http://purl.obolibrary.org/obo/>
            SELECT $this ?value WHERE { $this heiro:2000011 ?value ; heiro:2000012 ?u . FILTER (?value > ?u) }""" ] ;

    sh:sparql [ a sh:SPARQLConstraint ; sh:severity sh:Violation ;
        sh:message "A rule applies to topics started after a date that is not before the date before which they must have started."@en ;
        sh:select """PREFIX heiro: <https://healtheconomics.wiki/ontologies/heiro/HEIRO_>
            PREFIX rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_>
            PREFIX heao: <https://healtheconomics.wiki/ontologies/heao/HEAO_>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX obo: <http://purl.obolibrary.org/obo/>
            SELECT $this ?value WHERE { $this heiro:2000031 ?value ; heiro:2000032 ?b . FILTER (STR(?value) >= STR(?b)) }""" ] ;

    .

heirosh:ComparatorRuleShape a sh:NodeShape ;
    sh:targetClass heiro:0000012 ; sh:targetSubjectsOf heiro:1000024 ;
    sh:property [ sh:path heiro:1000023 ; sh:minCount 1 ; sh:in ( heiro:4000014 heiro:4000015 heiro:4000016 ) ;
        sh:message "A comparator rule states whether it requires, permits or forbids."@en ] ;
    sh:property [ sh:path heiro:1000024 ; sh:minCount 1 ; sh:in ( heiro:4000017 heiro:4000018 heiro:4000019 heiro:4000020 ) ;
        sh:message "A comparator rule states its selection basis."@en ] .

heirosh:ListedAmendmentShape a sh:NodeShape ;
    sh:targetClass heiro:0000018 ; sh:targetSubjectsOf heiro:1000017 ;
    sh:property [ sh:path heiro:1000017 ; sh:minCount 1 ; sh:class heiro:0000009 ; sh:message "A listed amendment names the version in force when the change was made."@en ] ;
    sh:property [ sh:path heiro:2000034 ; sh:minCount 1 ; sh:message "A listed amendment has a month."@en ] ;
    sh:property [ sh:path heiro:2000014 ; sh:minCount 1 ; sh:message "A listed amendment keeps the body's own summary."@en ] ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:severity sh:Violation ;
        sh:message "A listed amendment is dated before the version it amends."@en ;
        sh:select """PREFIX heiro: <https://healtheconomics.wiki/ontologies/heiro/HEIRO_>
            PREFIX rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_>
            PREFIX heao: <https://healtheconomics.wiki/ontologies/heao/HEAO_>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX obo: <http://purl.obolibrary.org/obo/>
            SELECT $this ?value WHERE { $this heiro:2000034 ?value ; heiro:1000017 ?v . ?v heiro:2000001 ?d . FILTER (STR(?value) < SUBSTR(STR(?d), 1, STRLEN(STR(?value)))) }""" ] ;

    sh:sparql [ a sh:SPARQLConstraint ; sh:severity sh:Violation ;
        sh:message "A listed amendment is dated on or after the version that superseded the version it amends."@en ;
        sh:select """PREFIX heiro: <https://healtheconomics.wiki/ontologies/heiro/HEIRO_>
            PREFIX rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_>
            PREFIX heao: <https://healtheconomics.wiki/ontologies/heao/HEAO_>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX obo: <http://purl.obolibrary.org/obo/>
            SELECT $this ?value WHERE { $this heiro:2000034 ?value ; heiro:1000017 ?v . ?n heiro:1000002 ?v ; heiro:2000001 ?d . FILTER (STR(?value) >= SUBSTR(STR(?d), 1, STRLEN(STR(?value)))) }""" ] ;

    .

heirosh:CheckRecordShape a sh:NodeShape ;
    sh:targetClass heiro:0000015 ; sh:targetSubjectsOf heiro:1000011 ;
    sh:property [ sh:path heiro:1000010 ; sh:minCount 1 ; sh:class heiro:0000007 ; sh:message "A check record names the guidance document whose page was read."@en ] ;
    sh:property [ sh:path heiro:1000011 ; sh:minCount 1 ; sh:class heiro:0000009 ; sh:message "A check record names the version it reports on."@en ] ;
    sh:property [ sh:path heiro:2000008 ; sh:minCount 1 ; sh:message "A check record has a check date."@en ] ;
    sh:property [ sh:path heiro:1000018 ; sh:minCount 1 ; sh:in ( heiro:4000007 heiro:4000008 ) ; sh:message "A check record says whether the live page or an archived copy was read."@en ] ;
    sh:property [ sh:path heiro:1000006 ; sh:minCount 1 ; sh:in ( heiro:4000001 heiro:4000002 heiro:4000003 heiro:4000004 ) ; sh:message "A check record reports one version status."@en ] ;
    sh:property [ sh:path heiro:2000010 ; sh:minCount 1 ; sh:message "A check record gives the SHA-256 of the copy that was read."@en ] ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:severity sh:Violation ;
        sh:message "A check record names a version of another guidance document."@en ;
        sh:select """PREFIX heiro: <https://healtheconomics.wiki/ontologies/heiro/HEIRO_>
            PREFIX rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_>
            PREFIX heao: <https://healtheconomics.wiki/ontologies/heao/HEAO_>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX obo: <http://purl.obolibrary.org/obo/>
            SELECT $this ?value WHERE { $this heiro:1000010 ?d ; heiro:1000011 ?value . ?value heiro:1000001 ?d2 . FILTER (?d != ?d2) }""" ] ;

    sh:sparql [ a sh:SPARQLConstraint ; sh:severity sh:Violation ;
        sh:message "An archived copy can show only that a version was the latest when captured."@en ;
        sh:select """PREFIX heiro: <https://healtheconomics.wiki/ontologies/heiro/HEIRO_>
            PREFIX rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_>
            PREFIX heao: <https://healtheconomics.wiki/ontologies/heao/HEAO_>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX obo: <http://purl.obolibrary.org/obo/>
            SELECT $this ?value WHERE { $this heiro:1000018 heiro:4000008 ; heiro:1000006 ?value . FILTER (?value != heiro:4000004) }""" ] ;

    sh:sparql [ a sh:SPARQLConstraint ; sh:severity sh:Violation ;
        sh:message "An archived copy needs its capture date."@en ;
        sh:select """PREFIX heiro: <https://healtheconomics.wiki/ontologies/heiro/HEIRO_>
            PREFIX rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_>
            PREFIX heao: <https://healtheconomics.wiki/ontologies/heao/HEAO_>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX obo: <http://purl.obolibrary.org/obo/>
            SELECT $this ?value WHERE { $this heiro:1000018 heiro:4000008 . FILTER NOT EXISTS { $this heiro:2000033 ?x } BIND($this AS ?value) }""" ] ;

    sh:sparql [ a sh:SPARQLConstraint ; sh:severity sh:Violation ;
        sh:message "An archived copy was captured after the date it was read."@en ;
        sh:select """PREFIX heiro: <https://healtheconomics.wiki/ontologies/heiro/HEIRO_>
            PREFIX rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_>
            PREFIX heao: <https://healtheconomics.wiki/ontologies/heao/HEAO_>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX obo: <http://purl.obolibrary.org/obo/>
            SELECT $this ?value WHERE { $this heiro:2000033 ?value ; heiro:2000008 ?d . FILTER (STR(?value) > STR(?d)) }""" ] ;

    .

heirosh:JurisdictionShape a sh:NodeShape ;
    sh:targetClass heiro:0000006 ; sh:targetObjectsOf heiro:1000009 ;
    sh:property [ sh:path rheo:2000005 ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^([A-Z]{2}(-[A-Z0-9]{1,3})?|INT)$" ;
        sh:message "A jurisdiction has exactly one ISO 3166 code, or RHEO's INT."@en ] .

heirosh:PerspectiveRecordShape a sh:NodeShape ;
    sh:targetClass heiro:0000016 ; sh:targetSubjectsOf heiro:1000012 ;
    sh:property [ sh:path heiro:1000012 ; sh:class obo:OBI_0000245 ; sh:message "A perspective record relates to organizations."@en ] ;
    sh:property [ sh:path heiro:9000001 ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:pattern "^https://healtheconomics.wiki/concept/" ;
        sh:message "A perspective record concerns exactly one wiki concept."@en ] ;
    sh:property [ sh:path heiro:2000015 ; sh:minCount 1 ; sh:message "A perspective record keeps the Institution field as shown."@en ] ;
    sh:property [ sh:path heiro:2000016 ; sh:minCount 1 ; sh:message "A perspective record has a title."@en ] ;
    sh:property [ sh:path heiro:2000019 ; sh:minCount 1 ; sh:minInclusive 1 ; sh:message "A perspective record has one display order from 1."@en ] ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:severity sh:Violation ;
        sh:message "A perspective record names no body and no guidance document, and has no editor note saying why."@en ;
        sh:select """PREFIX heiro: <https://healtheconomics.wiki/ontologies/heiro/HEIRO_>
            PREFIX rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_>
            PREFIX heao: <https://healtheconomics.wiki/ontologies/heao/HEAO_>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX obo: <http://purl.obolibrary.org/obo/>
            SELECT $this ?value WHERE { FILTER NOT EXISTS { $this heiro:1000012 ?b } FILTER NOT EXISTS { $this heiro:1000019 ?d } FILTER NOT EXISTS { $this obo:IAO_0000116 ?n } $this heiro:2000015 ?value }""" ] ;

    .

heirosh:CitationRecordShape a sh:NodeShape ;
    sh:targetClass heiro:0000017 ; sh:targetSubjectsOf heiro:1000013 ;
    sh:property [ sh:path heiro:1000013 ; sh:minCount 1 ; sh:class heiro:0000007 ; sh:message "A citation record names exactly one guidance document."@en ] ;
    sh:property [ sh:path heiro:1000014 ; sh:class heiro:0000009 ; sh:message "A citation record resolves to a guidance version."@en ] ;
    sh:property [ sh:path heiro:1000025 ; sh:minCount 1 ; sh:in ( heiro:4000009 heiro:4000010 heiro:4000011 heiro:4000012 heiro:4000013 ) ;
        sh:message "A citation record has one staleness verdict."@en ] ;
    sh:property [ sh:path heiro:2000026 ; sh:minCount 1 ; sh:message "A citation record says why it has its verdict."@en ] ;
    sh:property [ sh:path heiro:2000037 ; sh:minCount 1 ; sh:message "A citation record gives its verdict date."@en ] ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:severity sh:Violation ;
        sh:message "A citation record is about neither a wiki concept nor a HEMO record."@en ;
        sh:select """PREFIX heiro: <https://healtheconomics.wiki/ontologies/heiro/HEIRO_>
            PREFIX rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_>
            PREFIX heao: <https://healtheconomics.wiki/ontologies/heao/HEAO_>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX obo: <http://purl.obolibrary.org/obo/>
            SELECT $this ?value WHERE { FILTER NOT EXISTS { $this heiro:9000001 ?c } FILTER NOT EXISTS { $this heiro:9000002 ?m } BIND($this AS ?value) }""" ] ;

    sh:sparql [ a sh:SPARQLConstraint ; sh:severity sh:Violation ;
        sh:message "A citation record resolves to a version superseded by its verdict date, but its verdict is current."@en ;
        sh:select """PREFIX heiro: <https://healtheconomics.wiki/ontologies/heiro/HEIRO_>
            PREFIX rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_>
            PREFIX heao: <https://healtheconomics.wiki/ontologies/heao/HEAO_>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX obo: <http://purl.obolibrary.org/obo/>
            SELECT $this ?value WHERE { $this heiro:1000014 ?value ; heiro:1000025 heiro:4000010 ; heiro:2000037 ?vd . ?n heiro:1000002 ?value ; heiro:2000028 ?f . FILTER (STR(?f) <= STR(?vd)) }""" ] ;

    sh:sparql [ a sh:SPARQLConstraint ; sh:severity sh:Violation ;
        sh:message "A citation record resolves to a version not superseded by its verdict date, but its verdict is stale."@en ;
        sh:select """PREFIX heiro: <https://healtheconomics.wiki/ontologies/heiro/HEIRO_>
            PREFIX rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_>
            PREFIX heao: <https://healtheconomics.wiki/ontologies/heao/HEAO_>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX obo: <http://purl.obolibrary.org/obo/>
            SELECT $this ?value WHERE { $this heiro:1000014 ?value ; heiro:1000025 heiro:4000009 ; heiro:2000037 ?vd . FILTER NOT EXISTS { ?n heiro:1000002 ?value ; heiro:2000028 ?f . FILTER (STR(?f) <= STR(?vd)) } }""" ] ;

    sh:sparql [ a sh:SPARQLConstraint ; sh:severity sh:Violation ;
        sh:message "A citation record resolves to a version of another guidance document."@en ;
        sh:select """PREFIX heiro: <https://healtheconomics.wiki/ontologies/heiro/HEIRO_>
            PREFIX rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_>
            PREFIX heao: <https://healtheconomics.wiki/ontologies/heao/HEAO_>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX obo: <http://purl.obolibrary.org/obo/>
            SELECT $this ?value WHERE { $this heiro:1000013 ?d ; heiro:1000014 ?value . ?value heiro:1000001 ?d2 . FILTER (?d != ?d2) }""" ] ;

    sh:sparql [ a sh:SPARQLConstraint ; sh:severity sh:Violation ;
        sh:message "A citation record cites a full version date that differs from the version it resolves to, without saying the date falls between versions."@en ;
        sh:select """PREFIX heiro: <https://healtheconomics.wiki/ontologies/heiro/HEIRO_>
            PREFIX rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_>
            PREFIX heao: <https://healtheconomics.wiki/ontologies/heao/HEAO_>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX obo: <http://purl.obolibrary.org/obo/>
            SELECT $this ?value WHERE { $this heiro:1000014 ?value ; heiro:2000023 ?c ; heiro:2000026 ?r . ?value heiro:2000001 ?vd . FILTER (STRLEN(STR(?c)) = 10 && STR(?c) != STR(?vd) && !CONTAINS(STR(?r), 'not a version date')) }""" ] ;

    .

heirosh:Value_version_date a sh:NodeShape ;
    sh:targetSubjectsOf heiro:2000001 ;
    sh:property [ sh:path heiro:2000001 ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:pattern "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$" ;
        sh:message "has version date, at most one value, written YYYY-MM-DD, YYYY-MM or YYYY."@en ] ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:severity sh:Violation ;
        sh:message "has version date is not a date in the calendar."@en ;
        sh:select """PREFIX heiro: <https://healtheconomics.wiki/ontologies/heiro/HEIRO_>
            PREFIX rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_>
            PREFIX heao: <https://healtheconomics.wiki/ontologies/heao/HEAO_>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX obo: <http://purl.obolibrary.org/obo/>
            SELECT $this ?value WHERE { $this heiro:2000001 ?value . FILTER (STRLEN(STR(?value)) = 10) BIND (xsd:integer(SUBSTR(STR(?value), 1, 4)) AS ?y) BIND (SUBSTR(STR(?value), 6, 2) AS ?m) BIND (xsd:integer(SUBSTR(STR(?value), 9, 2)) AS ?d) FILTER ((?m IN ('04', '06', '09', '11') && ?d > 30) || (?m = '02' && ?d > 29) || (?m = '02' && ?d = 29 && !((?y - 4 * FLOOR(?y / 4) = 0 && ?y - 100 * FLOOR(?y / 100) != 0) || ?y - 400 * FLOOR(?y / 400) = 0))) }""" ] ;
    .

heirosh:Value_last_updated a sh:NodeShape ;
    sh:targetSubjectsOf heiro:2000002 ;
    sh:property [ sh:path heiro:2000002 ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:pattern "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" ;
        sh:message "has last updated date, at most one value, written YYYY-MM-DD."@en ] ;
