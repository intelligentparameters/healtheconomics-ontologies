    sh:property [ sh:path heiro:2000023 ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:pattern "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$" ;
