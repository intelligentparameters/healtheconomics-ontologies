heirosh:Value_capture_date a sh:NodeShape ;
    sh:targetSubjectsOf heiro:2000033 ;
    sh:property [ sh:path heiro:2000033 ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:pattern "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" ;
        sh:message "has capture date, at most one value, written YYYY-MM-DD."@en ] ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:severity sh:Violation ;
        sh:message "has capture date is not a date in the calendar."@en ;
        sh:select """PREFIX heiro: <https://healtheconomics.wiki/ontologies/heiro/HEIRO_>
            PREFIX rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_>
            PREFIX heao: <https://healtheconomics.wiki/ontologies/heao/HEAO_>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX obo: <http://purl.obolibrary.org/obo/>
            SELECT $this ?value WHERE { $this heiro:2000033 ?value . FILTER (STRLEN(STR(?value)) = 10) BIND (xsd:integer(SUBSTR(STR(?value), 1, 4)) AS ?y) BIND (SUBSTR(STR(?value), 6, 2) AS ?m) BIND (xsd:integer(SUBSTR(STR(?value), 9, 2)) AS ?d) FILTER ((?m IN ('04', '06', '09', '11') && ?d > 30) || (?m = '02' && ?d > 29) || (?m = '02' && ?d = 29 && !((?y - 4 * FLOOR(?y / 4) = 0 && ?y - 100 * FLOOR(?y / 100) != 0) || ?y - 400 * FLOOR(?y / 400) = 0))) }""" ] ;
    .

heirosh:Value_evidence_sha a sh:NodeShape ;
    sh:targetSubjectsOf heiro:2000010 ;
    sh:property [ sh:path heiro:2000010 ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:pattern "^[0-9a-f]{64}$" ;
        sh:message "has evidence SHA-256, at most one value, written as 64 hexadecimal characters."@en ] ;
    .

