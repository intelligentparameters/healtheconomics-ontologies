heirosh:RheoValuesOnDocuments a sh:NodeShape ;
    sh:targetClass heiro:0000007 ;
    sh:property [ sh:path rheo:2000035 ; sh:maxCount 1 ; sh:pattern "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" ; sh:message "RHEO's has publication date, at most one, written YYYY-MM-DD."@en ] ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:severity sh:Violation ;
        sh:message "RHEO's has publication date is not a date in the calendar."@en ;
        sh:select """PREFIX heiro: <https://healtheconomics.wiki/ontologies/heiro/HEIRO_>
            PREFIX rheo: <https://healtheconomics.wiki/ontologies/rheo/RHEO_>
            PREFIX heao: <https://healtheconomics.wiki/ontologies/heao/HEAO_>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            PREFIX obo: <http://purl.obolibrary.org/obo/>
            SELECT $this ?value WHERE { $this rheo:2000035 ?value . FILTER (STRLEN(STR(?value)) = 10) BIND (xsd:integer(SUBSTR(STR(?value), 1, 4)) AS ?y) BIND (SUBSTR(STR(?value), 6, 2) AS ?m) BIND (xsd:integer(SUBSTR(STR(?value), 9, 2)) AS ?d) FILTER ((?m IN ('04', '06', '09', '11') && ?d > 30) || (?m = '02' && ?d > 29) || (?m = '02' && ?d = 29 && !((?y - 4 * FLOOR(?y / 4) = 0 && ?y - 100 * FLOOR(?y / 100) != 0) || ?y - 400 * FLOOR(?y / 400) = 0))) }""" ] ;
    .

heirosh:RheoValuesOnRules a sh:NodeShape ;
    sh:targetClass heiro:0000011 ; sh:targetSubjectsOf heiro:1000005 ;
    sh:property [ sh:path rheo:2000003 ; sh:maxCount 1 ; sh:pattern "^[A-Z]{3}$" ; sh:message "RHEO's has currency code, one ISO 4217 code."@en ] ;
    sh:property [ sh:path rheo:2000030 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:message "One cost discount rate, a decimal."@en ] ;
    sh:property [ sh:path rheo:2000031 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:message "One outcome discount rate, a decimal."@en ] ;
    sh:property [ sh:path rheo:2000001 ; sh:datatype xsd:decimal ; sh:message "A value as a decimal."@en ] .
