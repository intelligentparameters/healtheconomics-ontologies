        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">Relates a body to the guidance document or legal act that establishes it, such as the Member State Coordination Group on Health Technology Assessment and Regulation (EU) 2021/2282.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
