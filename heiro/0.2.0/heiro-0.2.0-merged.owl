    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_9000001 -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_9000001">
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">Relates a relationship that HEAO makes across ontologies, a property or an annotated bridge axiom, to the kind of relationship it is, one of definitional, representational, computational, causal or valuational.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEAO 0.2.0 locked decisions (best practice), 18 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">has linking kind</rdfs:label>
    </owl:AnnotationProperty>
    


