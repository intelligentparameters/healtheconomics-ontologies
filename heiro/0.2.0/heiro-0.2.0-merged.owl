    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000020 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000020">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">Relates a body to the organization it is a unit of, such as a regional office or an inspector general&apos;s office.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators&apos; decisions, 19 October 2026</ns2:IAO_0000119>
