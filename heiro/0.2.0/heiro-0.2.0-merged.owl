    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000024 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000024">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000012"/>
