    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_1000022 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_1000022">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000035"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000051"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">Relates a valuation weight to a valuation parameter it was calculated from, such as a discount factor from a discount rate.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEAO 0.2.0 locked decisions (best practice), 18 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">derived from valuation parameter</rdfs:label>
        <ns3:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000003"/>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_1000026 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_1000026">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000016"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000016"/>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000001 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000001">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#specializationOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000009"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000007"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">Relates a guidance version to the guidance document whose lineage it belongs to.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">A sub-property of PROV-O specialization of, which links a more specific entity, such as a page on one day, to a more general one. PROV-O is not imported (see build-report.md).</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Davis and Newman 2005 (Expression of Core FRBR Concepts in RDF, vocab.org/frbr/core, 10 August 2005)</ns2:IAO_0000119>
        <ns2:IAO_0000119>Lebo et al. 2013 (W3C PROV-O, W3C Recommendation 30 April 2013)</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">is version of guidance document</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000002 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000002">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasRevisionOf"/>
        <owl:inverseOf rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000003"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000009"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000009"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">Relates a guidance version to the earlier version of the same guidance document that it replaces for new decisions.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">Asserted on the newer version only, so no older record is edited. Holds between consecutive versions. Asymmetric, so it cannot also be transitive, and any later version is a property path in SPARQL.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026</ns2:IAO_0000119>
        <ns2:IAO_0000119>Lebo et al. 2013 (W3C PROV-O, W3C Recommendation 30 April 2013)</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">supersedes guidance version</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000003 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000003">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000009"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000009"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">Relates a guidance version to the later version of the same guidance document that replaces it for new decisions.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">The inverse of supersedes guidance version, for queries. HEIRO&apos;s records assert only supersedes.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">is superseded by guidance version</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000004 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000004">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000010"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000009"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">Relates a guidance provision to the guidance version it is part of.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026</ns2:IAO_0000119>
        <ns2:IAO_0000119>IAO, Information Artifact Ontology, release of 30 March 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">is provision of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000005 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000005">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000010"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">Relates a rule to the guidance provision that states it, so that the source version and section of the rule can be found.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">A sub-property of PROV-O was derived from, as RHEO&apos;s taken from source is. It has no domain, because the rules are typed with the classes of RHEO, HEAO and OHEO.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026</ns2:IAO_0000119>
        <ns2:IAO_0000119>Lebo et al. 2013 (W3C PROV-O, W3C Recommendation 30 April 2013)</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">is stated in provision</rdfs:label>
        <ns3:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000002"/>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000006 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000006">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000015"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000014"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">Relates a guidance version check record to what it found about its guidance version on its check date.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">One check record reports one status. A version&apos;s status at another date is found from the check records of that date.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators&apos; decisions, 19 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">reports version status</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000008 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000008">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000010"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000010"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">Relates a guidance provision to a provision of another guidance version whose wording it replaces, deletes, inserts before or renumbers, such as appendix A of NICE PMG51 replacing the wording of section 4.3.6 of PMG36.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">The kind of each amendment is an axiom annotation, has amendment kind. The amended provision keeps its own wording, because the amended document may not yet show the change. On 19 October 2026 section 4.3.16 of PMG36 still asked for the EQ-5D-3L value set, which PMG51 replaces for new topics.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026</ns2:IAO_0000119>
        <ns2:IAO_0000119>Publications Office 2026 (ELI ontology 1.5)</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">amends provision</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000009 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000009">
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000006"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">Relates a body, a guidance document or a rule to the jurisdiction in which the rules or decisions apply because the body acts for its government.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">Each assertion carries, as an axiom annotation, the text of the source that names the area. Not used for independent bodies.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026</ns2:IAO_0000119>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators&apos; decisions, 19 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">has jurisdiction</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000010 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000010">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000015"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000007"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">Relates a guidance version check record to the guidance document whose page was read.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">checks guidance document</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000011 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000011">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000015"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000009"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">Relates a guidance version check record to the guidance version it reports on.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">found guidance version</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000012 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000012">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000016"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">Relates an institutional perspective record to a body whose position it records. A row of the tab that names several bodies acting together relates to each of them.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026</ns2:IAO_0000119>
        <ns2:IAO_0000119>healtheconomics.wiki Institutional Perspectives tab, read from the live concept pages on 19 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">is perspective of body</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000013 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000013">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000017"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000007"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">Relates a guidance citation record to the guidance document it cites.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">cites guidance document</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000014 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000014">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000017"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000009"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">Relates a guidance citation record to the guidance version that the version date it cites identifies, or that the other dated citation in the same record identifies, when exactly one version is identified.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">A citation that gives only a year in which several versions were issued, or gives no version date and has no dated citation beside it, resolves to none, and its verdict says why.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026</ns2:IAO_0000119>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators&apos; decisions, 19 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">resolves to guidance version</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000015 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000015">
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">Relates a guidance document or a rule to the organization that issued it.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">Minted by HEIRO because RHEO&apos;s issued by (RHEO_1000057) is defined for tariffs, price agreements and recommendations only. rheo-0.4-proposals-from-heiro.md asks RHEO to widen it, and HEIRO will then map to it. It is deliberately not a sub-property of RHEO&apos;s.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators&apos; decisions, 19 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">is issued by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000016 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000016">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000007"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000020"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">Relates a guidance document to whether the decisions or guidance made under it bind those they address.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">Each assertion carries, as an axiom annotation, the text it rests on.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators&apos; decisions, 19 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">has binding force</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000017 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000017">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000018"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000009"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">Relates a listed amendment to the guidance version in force when the body made the change.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators&apos; decisions, 19 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">is amendment of version</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000018 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000018">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000015"/>
