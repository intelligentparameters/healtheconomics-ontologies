        <ns1:HEIRO_1000015 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000001"/>
        <ns1:HEIRO_2000013>Technologies funded through specialised commissioning budgets, in any of the first 3 financial years</ns1:HEIRO_2000013>
        <ns1:HEIRO_2000028>2025-06</ns1:HEIRO_2000028>
        <ns1:HEIRO_2000030>2026-03-31</ns1:HEIRO_2000030>
        <ns4:RHEO_2000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">40000000.0</ns4:RHEO_2000001>
        <ns4:RHEO_2000002>GBP net budget impact a year</ns4:RHEO_2000002>
        <ns4:RHEO_2000003>GBP</ns4:RHEO_2000003>
        <rdfs:comment xml:lang="en">Stated in PMG36, in the versions of 31 March 2026, 13 October 2026.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl"/>
        <rdfs:label xml:lang="en">NICE budget impact test of 40 million pounds a year</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000273"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_1000026"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000271"/>
        <rdfs:comment xml:lang="en">The update information lists the change in June 2025, a minor change without a new version date.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000273"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_1000026"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000271"/>
        <rdfs:comment xml:lang="en">The update information lists the change in June 2025, a minor change without a new version date.</rdfs:comment>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000274 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000274">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000010"/>
        <ns1:HEIRO_1000004 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000145"/>
        <ns1:HEIRO_2000005 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://web.archive.org/web/20260809212831id_/https://www.nice.org.uk/process/pmg36/chapter/developing-the-guidance-2</ns1:HEIRO_2000005>
        <ns1:HEIRO_2000006>5.10.4</ns1:HEIRO_2000006>
        <ns1:HEIRO_2000007>NHS England and NHS Improvement may request a longer time to implement the statutory funding requirements for technologies funded through its specialised commissioning budgets. This may happen for medicines when the potential net budget impact is expected to exceed £40 million per year in any of the first 3 financial years of its use in the NHS. NHS England and NHS Improvement will also do this on behalf of clinical commissioning groups, for locally commissioned technologies that NICE has evaluated.</ns1:HEIRO_2000007>
        <ns2:IAO_0000116 xml:lang="en">Read in an archived copy of the page, https://web.archive.org/web/20260809212831id_/https://www.nice.org.uk/process/pmg36/chapter/developing-the-guidance-2</ns2:IAO_0000116>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl"/>
        <rdfs:label xml:lang="en">PMG36 section 5.10.4, version of 31 March 2026</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000275 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000275">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000010"/>
        <ns1:HEIRO_1000004 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000148"/>
        <ns1:HEIRO_2000005 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.nice.org.uk/process/pmg36/chapter/developing-the-guidance-2#pmg36-5_10_4</ns1:HEIRO_2000005>
        <ns1:HEIRO_2000006>5.10.4</ns1:HEIRO_2000006>
        <ns1:HEIRO_2000007>NHS England may request a longer time to implement the statutory funding requirements for technologies funded through its specialised commissioning budgets. This may happen if: the potential net budget impact is expected to exceed £40 million a year in any of the first 3 financial years of its use in the NHS, or training, service infrastructure or health service resources are not in place. A national body or a body that is able to represent national interests, currently NHS England, is expected to do this on behalf of integrated care boards (ICBs), for locally commissioned technologies that NICE has evaluated.</ns1:HEIRO_2000007>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl"/>
        <rdfs:label xml:lang="en">PMG36 section 5.10.4, version of 13 October 2026</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000276 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000276">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000010"/>
        <ns1:HEIRO_1000004 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000151"/>
        <ns1:HEIRO_2000005 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.nice.org.uk/process/pmg51/chapter/process-considerations</ns1:HEIRO_2000005>
        <ns1:HEIRO_2000006>1.17</ns1:HEIRO_2000006>
        <ns1:HEIRO_2000007>The EQ-5D-5L value set must be used for all new topics starting after this interim methods statement is published. For technology appraisals and highly specialised technologies guidance, this means any topic with an invitation to participate issued after the publication of this statement.</ns1:HEIRO_2000007>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl"/>
        <rdfs:label xml:lang="en">PMG51 section 1.17, version of 27 August 2026</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000277 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000277">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000011"/>
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000328"/>
        <ns1:HEIRO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000232"/>
        <ns1:HEIRO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000278"/>
        <ns1:HEIRO_1000015 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000001"/>
        <ns1:HEIRO_2000013>Ongoing topics started before PMG51 was published, for which 5L data continue to be mapped to 3L utility values</ns1:HEIRO_2000013>
        <ns1:HEIRO_2000030>2026-10-13</ns1:HEIRO_2000030>
        <ns1:HEIRO_2000032>2026-08-27</ns1:HEIRO_2000032>
        <rdfs:comment xml:lang="en">Stated in PMG36, in the versions of 13 October 2026.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl"/>
        <rdfs:label xml:lang="en">NICE rule that EQ-5D-5L data are mapped to the EQ-5D-3L value set, for topics started before 27 August 2026</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000278 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000278">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000010"/>
        <ns1:HEIRO_1000004 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000151"/>
        <ns1:HEIRO_2000005 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.nice.org.uk/process/pmg51/chapter/process-considerations</ns1:HEIRO_2000005>
        <ns1:HEIRO_2000006>1.18</ns1:HEIRO_2000006>
        <ns1:HEIRO_2000007>This means that, for ongoing topics started before the publication of this interim methods statement, 5L data should continue to be mapped to 3L utility values.</ns1:HEIRO_2000007>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl"/>
        <rdfs:label xml:lang="en">PMG51 section 1.18, version of 27 August 2026</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000279 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000279">
