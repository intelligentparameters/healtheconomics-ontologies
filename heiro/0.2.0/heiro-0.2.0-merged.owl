        <rdfs:label xml:lang="en">is part of organization</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000021 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000021">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">Relates a body to an organization that commissions its work, such as the NICE Decision Support Unit and NICE.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">Not part of. The NICE Decision Support Unit&apos;s technical support documents are not NICE guidance.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators&apos; decisions, 19 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">carries out work commissioned by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000022 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000022">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
