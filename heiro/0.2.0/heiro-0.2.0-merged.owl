    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_2000001 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_2000001">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
