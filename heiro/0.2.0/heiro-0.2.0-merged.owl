    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000281 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000281">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000104"/>
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000011"/>
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000093"/>
        <ns1:HEIRO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000210"/>
        <ns1:HEIRO_1000015 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000003"/>
        <ns1:HEIRO_2000013>Sensitivity analyses only</ns1:HEIRO_2000013>
        <ns1:HEIRO_2000030>2025-12-19</ns1:HEIRO_2000030>
        <ns4:RHEO_2000030 rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.03</ns4:RHEO_2000030>
        <ns4:RHEO_2000031 rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.015</ns4:RHEO_2000031>
        <rdfs:comment xml:lang="en">Stated in General Methods, in the versions of 19 December 2025.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl"/>
        <rdfs:label xml:lang="en">IQWiG differential discount rates of 3% for costs and 1.5% for benefits in sensitivity analyses</rdfs:label>
        <ns1:HEIRO_9000004 rdf:resource="https://healtheconomics.wiki/ontologies/hemo/HEMO_5000189"/>
        <ns1:HEIRO_9000004 rdf:resource="https://healtheconomics.wiki/ontologies/hemo/HEMO_5000618"/>
        <ns1:HEIRO_9000005 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000052"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000281"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_9000004"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/ontologies/hemo/HEMO_5000189"/>
        <rdfs:comment xml:lang="en">The HEMO formula Present value of a single future value takes the figures of this rule as inputs, since HEMO keeps policy figures out of its formulas.</rdfs:comment>
        <ns3:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000003"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000281"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_9000004"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/ontologies/hemo/HEMO_5000618"/>
        <rdfs:comment xml:lang="en">The HEMO formula Discounted total of a level yearly amount counted at the end of each year takes the figures of this rule as inputs, since HEMO keeps policy figures out of its formulas.</rdfs:comment>
        <ns3:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000003"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000281"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_9000005"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000052"/>
        <rdfs:comment xml:lang="en">The figure this rule states is a HEAO discount rate, so a valuation that applies it can be typed by HEAO.</rdfs:comment>
        <ns3:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000001"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000282 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000282">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000011"/>
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000019"/>
        <ns1:HEIRO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000214"/>
        <ns1:HEIRO_1000015 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000015"/>
        <ns1:HEIRO_2000011 rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">100000.0</ns1:HEIRO_2000011>
        <ns1:HEIRO_2000012 rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">150000.0</ns1:HEIRO_2000012>
        <ns1:HEIRO_2000013>The range for threshold prices used to determine ICER Health Benefit Price Benchmarks</ns1:HEIRO_2000013>
        <ns1:HEIRO_2000030>2023-09-25</ns1:HEIRO_2000030>
        <ns4:RHEO_2000002>USD per evLY gained and per QALY gained</ns4:RHEO_2000002>
        <ns4:RHEO_2000003>USD</ns4:RHEO_2000003>
        <rdfs:comment xml:lang="en">Stated in Value Assessment Framework, in the versions of 25 September 2023.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl"/>
        <rdfs:label xml:lang="en">ICER health benefit price benchmark range of 100,000 to 150,000 US dollars per evLY and per QALY gained</rdfs:label>
        <ns1:HEIRO_9000004 rdf:resource="https://healtheconomics.wiki/ontologies/hemo/HEMO_5000196"/>
        <ns1:HEIRO_9000004 rdf:resource="https://healtheconomics.wiki/ontologies/hemo/HEMO_5000213"/>
        <ns1:HEIRO_9000005 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000045"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000282"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_9000004"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/ontologies/hemo/HEMO_5000196"/>
        <rdfs:comment xml:lang="en">The HEMO formula Incremental net monetary benefit takes the figures of this rule as inputs, since HEMO keeps policy figures out of its formulas.</rdfs:comment>
        <ns3:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000003"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000282"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_9000004"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/ontologies/hemo/HEMO_5000213"/>
        <rdfs:comment xml:lang="en">The HEMO formula Incremental net health benefit at threshold k takes the figures of this rule as inputs, since HEMO keeps policy figures out of its formulas.</rdfs:comment>
        <ns3:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000003"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000282"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_9000005"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000045"/>
        <rdfs:comment xml:lang="en">The figure this rule states is a HEAO monetary value of health, money per unit of health, here per evLY and per QALY. It is not an adopted threshold value, because ICER makes no funding decision against it.</rdfs:comment>
        <ns3:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000001"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000283 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000283">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000010"/>
        <ns1:HEIRO_1000004 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000148"/>
        <ns1:HEIRO_2000005 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.nice.org.uk/process/pmg36/chapter/economic-evaluation-2#pmg36-4_3_10</ns1:HEIRO_2000005>
        <ns1:HEIRO_2000006>4.3.10</ns1:HEIRO_2000006>
        <ns1:HEIRO_2000007>In some circumstances the EQ-5D may not be the most appropriate measure. To make a case that the EQ-5D is inappropriate, provide qualitative empirical evidence on the lack of content validity for the EQ-5D, showing that key dimensions of health are missing. This should be supported by evidence that shows that EQ-5D performs poorly on tests of construct validity (that is, it does not perform as would be expected) and responsiveness in a particular patient population. This evidence should be derived from a synthesis of peer-reviewed literature. In these circumstances alternative health-related quality-of-life measures may be used. These must be accompanied by a carefully detailed account of the methods used to generate the data, their validity, and how these methods affect the utility values.</ns1:HEIRO_2000007>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl"/>
        <rdfs:label xml:lang="en">PMG36 section 4.3.10, version of 13 October 2026</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000284 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000284">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000010"/>
        <ns1:HEIRO_1000004 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000148"/>
        <ns1:HEIRO_2000005 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.nice.org.uk/process/pmg36/chapter/economic-evaluation-2#pmg36-4_3_11</ns1:HEIRO_2000005>
        <ns1:HEIRO_2000006>4.3.11</ns1:HEIRO_2000006>
        <ns1:HEIRO_2000007>In circumstances when evidence generation is difficult (for example, for rare diseases), when there is insufficient data to assess whether the EQ-5D adequately reflects changes in quality of life, evidence other than psychometric measures may be presented and considered to establish whether the EQ-5D is appropriate.</ns1:HEIRO_2000007>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl"/>
        <rdfs:label xml:lang="en">PMG36 section 4.3.11, version of 13 October 2026</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000285 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000285">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000010"/>
        <ns1:HEIRO_1000004 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000148"/>
        <ns1:HEIRO_2000005 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.nice.org.uk/process/pmg36/chapter/economic-evaluation-2#pmg36-4_3_13</ns1:HEIRO_2000005>
        <ns1:HEIRO_2000006>4.3.13</ns1:HEIRO_2000006>
        <ns1:HEIRO_2000007>For evaluations in which the population includes children and young people (that is, people aged under 18) consider alternative measures of health-related quality of life for children.</ns1:HEIRO_2000007>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl"/>
        <rdfs:label xml:lang="en">PMG36 section 4.3.13, version of 13 October 2026</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000286 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000286">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000010"/>
        <ns1:HEIRO_1000004 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000148"/>
        <ns1:HEIRO_2000005 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.nice.org.uk/process/pmg36/chapter/economic-evaluation-2#pmg36-4_3_14</ns1:HEIRO_2000005>
        <ns1:HEIRO_2000006>4.3.14</ns1:HEIRO_2000006>
        <ns1:HEIRO_2000007>NICE does not recommend specific measures of health-related quality of life in children and young people. A generic measure that has been shown to have good psychometric performance in the relevant age ranges should be used. Not all paediatric health-related quality-of-life instruments have a UK value set, and there are methodological challenges when developing value sets for children and young people. Nonetheless, generic measures give valuable descriptive information about the effect of the condition and technology on children and young people&apos;s health-related quality of life. If data from a paediatric health-related quality-of-life instrument are used to generate utility values, explain how this was done. If there is evidence that generic measures are unsuitable for the condition or technology, refer to the hierarchy of preferred sources for health-related quality of life. A report by the Decision Support Unit summarises the psychometric performance of several preference-based measures.</ns1:HEIRO_2000007>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl"/>
        <rdfs:label xml:lang="en">PMG36 section 4.3.14, version of 13 October 2026</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000287 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000287">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000010"/>
        <ns1:HEIRO_1000004 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000148"/>
        <ns1:HEIRO_2000005 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.nice.org.uk/process/pmg36/chapter/economic-evaluation-2#pmg36-4_3_15</ns1:HEIRO_2000005>
        <ns1:HEIRO_2000006>4.3.15</ns1:HEIRO_2000006>
        <ns1:HEIRO_2000007>Report if measures of health-related quality of life were completed by adults with the condition, children and young people themselves, or on their behalf (for example, by parents, carers or clinicians). Report the age of the children and young people. If multiple data sources are available, report what data was used in the economic model and the rationale behind this choice.</ns1:HEIRO_2000007>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl"/>
        <rdfs:label xml:lang="en">PMG36 section 4.3.15, version of 13 October 2026</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000288 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000288">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000010"/>
        <ns1:HEIRO_1000004 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000148"/>
        <ns1:HEIRO_2000005 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.nice.org.uk/process/pmg36/chapter/economic-evaluation-2</ns1:HEIRO_2000005>
        <ns1:HEIRO_2000006>figure 4.1</ns1:HEIRO_2000006>
        <ns1:HEIRO_2000007>A hierarchy of preferred health-related quality-of-life methods is presented in figure 4.1.</ns1:HEIRO_2000007>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl"/>
        <rdfs:label xml:lang="en">PMG36 figure 4.1, version of 13 October 2026</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000386 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000386">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000385"/>
        <ns2:IAO_0000115 xml:lang="en">An instrument classification value for an instrument designed for use across conditions and populations.</ns2:IAO_0000115>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <ns2:IAO_0000119>Brazier et al. 2017</ns2:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">generic design</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000387 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000387">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000385"/>
        <ns2:IAO_0000115 xml:lang="en">An instrument classification value for an instrument designed for people with a particular condition or treatment.</ns2:IAO_0000115>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <ns2:IAO_0000119>Brazier et al. 2017</ns2:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">condition-specific design</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000388 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000388">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000385"/>
        <ns2:IAO_0000115 xml:lang="en">An instrument classification value for an instrument that reports separate scores for several aspects of health rather than one index.</ns2:IAO_0000115>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <ns2:IAO_0000119>Brazier et al. 2017</ns2:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">health profile scoring</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000390 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000390">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000327"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <ns2:IAO_0000115 xml:lang="en">A reference case profile setting the methods NICE requires for measuring, valuing and discounting health effects, as set by its 2022 manual (PMG36) and amended by the interim methods statement of 27 August 2026 (PMG51), which adopts the EQ-5D-5L value set.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">Checked against the full text of PMG51 (read on 18 October 2026). PMG51 makes the EQ-5D-5L descriptive system with the UK EQ-5D-5L value set (Rowen et al. 2026) NICE&apos;s preferred approach in adults, and that value set should derive all adult utility values in reference-case analyses (1.6, 1.7, Appendix A 4.3.6). It applies to TA, HST and HealthTech evaluations and to guidelines (PMG20).</ns2:IAO_0000116>
        <ns2:IAO_0000116 xml:lang="en">EQ-5D-3L value set utilities must not be used in sensitivity or scenario analyses (1.13). Non-UK EQ-5D-5L value sets are never preferred over mapping to the UK value set (FAQ 17). NICE recommends no specific measure for children and young people, so these value set rules do not apply to EQ-5D-Y data (1.7, FAQ 19).</ns2:IAO_0000116>
        <ns2:IAO_0000116 xml:lang="en">PMG51 applies prospectively, to topics whose invitation to participate (TA, HST), launch (HealthTech) or selection (guidelines) came after 27 August 2026. Topics started before keep the PMG36 approach (1.17, 1.18, FAQ 16). The rules therefore key on the analysis&apos;s topic start date (OHEO_2000035).</ns2:IAO_0000116>
        <ns2:IAO_0000116 xml:lang="en">The 5L value set is also used for general population utilities and the QALY shortfall behind the severity modifier, whose cut-offs are unchanged from PMG36 table 6.1 (1.12, FAQ 21). The discount rate of 3.5% and the use of QALYs are those of PMG36. Costs and NICE&apos;s cost-effectiveness threshold are RHEO matters and are not checked here.</ns2:IAO_0000116>
        <ns2:IAO_0000116 xml:lang="en">When only EQ-5D-3L data exist, they are mapped to EQ-5D-5L utilities with the NICE DSU response mapping model on the EEPRU dataset (Hernández Alava, Pudney and Wailoo 2023), with the Rowen 2026 value set applied as a separate step. Using mapped 3L data, 5L literature values or non-EQ-5D measures mapped to the 5L value set is a departure from the reference case (1.10, 1.11, Appendix A 4.3.8 to 4.3.10).</ns2:IAO_0000116>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <ns2:IAO_0000118 xml:lang="en">NICE reference case for health effects (2026)</ns2:IAO_0000118>
        <ns2:IAO_0000119>NICE 2026 (PMG51, Interim methods statement: implementing the EQ-5D-5L value set, 27 August 2026); NICE 2022 (PMG36)</ns2:IAO_0000119>
        <dcterms:issued>2026-08-27</dcterms:issued>
        <oboInOwl:hasExactSynonym xml:lang="en">NICE PMG51 reference case</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">NICE reference case</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">NICE reference case for health effects (PMG36 as amended by PMG51, 2026)</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/ontologies/oheo/reference-case-shapes#NICE_PMG51_2026"/>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000391 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000391">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000327"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <ns2:IAO_0000115 xml:lang="en">A reference case profile setting the methods NICE required for measuring, valuing and discounting health effects in its 2022 manual (PMG36), before the adoption of the EQ-5D-5L value set.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">Superseded for new topics by PMG51 (27 August 2026). Topics started before that date keep these rules, so the profile stays valid for them (PMG51 1.17, 1.18).</ns2:IAO_0000116>
        <ns2:IAO_0000116 xml:lang="en">Under PMG36, utilities came from the EQ-5D-3L UK value set (Dolan 1997); EQ-5D-5L responses were mapped to it with the NICE DSU mapping (Hernández Alava et al. 2017) using the EEPRU dataset (Hernández Alava et al. 2023), and the EQ-5D-5L value set for England (Devlin et al. 2018) was not recommended (old PMG36 4.3.16, as quoted in PMG51). The value set rules do not apply to EQ-5D-Y data.</ns2:IAO_0000116>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <ns2:IAO_0000118 xml:lang="en">NICE reference case for health effects (2022)</ns2:IAO_0000118>
        <ns2:IAO_0000119>NICE 2022 (PMG36)</ns2:IAO_0000119>
        <dcterms:issued>2022-01-31</dcterms:issued>
        <oboInOwl:hasExactSynonym xml:lang="en">NICE PMG36 reference case</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">NICE reference case for health effects (PMG36, 2022)</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/ontologies/oheo/reference-case-shapes#NICE_PMG36_2022"/>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000392 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000392">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000327"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A reference case profile setting the methods the Second Panel on Cost-Effectiveness in Health and Medicine recommends for cost-effectiveness analyses in the United States.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">Facts carried over from 0.1.0 and not re-checked for this release.</ns2:IAO_0000116>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <ns2:IAO_0000119>Sanders et al. 2016</ns2:IAO_0000119>
        <dcterms:issued>2016</dcterms:issued>
        <oboInOwl:hasExactSynonym xml:lang="en">Second Panel reference case</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">Second Panel reference case for health effects</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/ontologies/oheo/reference-case-shapes#SecondPanel_2016"/>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000393 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000393">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000327"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A reference case profile setting the methods Canada&apos;s Drug Agency (CDA-AMC, formerly CADTH) requires for measuring, valuing and discounting health effects in economic evaluations.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">Carer health effects are included where they are meaningful; spillovers beyond patients and informal carers go in non-reference-case analyses. Sensitivity analyses at 0% and 3%.</ns2:IAO_0000116>
        <ns2:IAO_0000116 xml:lang="en">Facts carried over from 0.1.0 and not re-checked for this release.</ns2:IAO_0000116>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <ns2:IAO_0000119>CADTH 2017 (Guidelines for the Economic Evaluation of Health Technologies: Canada, 4th edition)</ns2:IAO_0000119>
        <dcterms:issued>2017</dcterms:issued>
        <oboInOwl:hasRelatedSynonym xml:lang="en">CADTH reference case</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">CDA-AMC reference case for health effects</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/ontologies/oheo/reference-case-shapes#CDA_AMC_2017"/>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000394 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000394">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000327"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A reference case profile setting the methods the Pharmaceutical Benefits Advisory Committee (Australia) requires for measuring, valuing and discounting health effects in submissions.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">Facts carried over from 0.1.0 and not re-checked for this release.</ns2:IAO_0000116>
        <ns2:IAO_0000116 xml:lang="en">QALYs apply where a cost-utility analysis is presented, which PBAC prefers when life is extended or quality of life improves. Sensitivity analyses at 3.5% and 0%; PBAC consulted on its discount rate in 2022.</ns2:IAO_0000116>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <ns2:IAO_0000119>PBAC 2016 (Guidelines for preparing submissions to the PBAC, version 5.0); PBAC reviewed its base discount rate in July 2022, so the current rate needs checking</ns2:IAO_0000119>
        <dcterms:issued>2016</dcterms:issued>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">PBAC base case for health effects</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/ontologies/oheo/reference-case-shapes#PBAC_2016"/>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000395 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000395">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000327"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A reference case profile setting the methods the Institute for Quality and Efficiency in Health Care (Germany) uses for health effects in its assessments of the relation of benefits to costs.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">Facts carried over from 0.1.0 and not re-checked for this release.</ns2:IAO_0000116>
        <ns2:IAO_0000116 xml:lang="en">The base case perspective is that of the community of people insured by statutory health insurance. Sensitivity analyses at 0%, 5%, 7% and 10%.</ns2:IAO_0000116>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <ns2:IAO_0000119>IQWiG General Methods (the 0.1.0 draft cited version 6.1, 2022; version 7.0, 2023, is current and has not been checked)</ns2:IAO_0000119>
        <dcterms:issued>2022</dcterms:issued>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">IQWiG approach to health effects in economic evaluation</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/ontologies/oheo/reference-case-shapes#IQWiG_2022"/>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000396 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000396">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000327"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <ns2:IAO_0000115 xml:lang="en">A reference case profile setting the methods the Institute for Clinical and Economic Review (United States) uses for measuring, valuing and discounting health effects.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">Checked by reviewer B on 16 October 2026 against ICER&apos;s reference case document: 3% for costs and outcomes; EQ-5D-5L preferred if available, with no measure required. QALYs are reported with the equal value of life-years gained.</ns2:IAO_0000116>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <ns2:IAO_0000119>ICER&apos;s Reference Case for Economic Evaluations: Elements and Rationale (current as of 23 October 2025)</ns2:IAO_0000119>
        <dcterms:issued>2025</dcterms:issued>
        <oboInOwl:hasExactSynonym xml:lang="en">ICER reference case</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">ICER reference case for health effects</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://healtheconomics.wiki/ontologies/oheo/reference-case-shapes#ICER_2025"/>
    </owl:NamedIndividual>
    


