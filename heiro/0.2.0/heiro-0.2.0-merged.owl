    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_2000007 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_2000007">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A verbatim excerpt of the source a record rests on, kept so that the record can be checked against it. It is exempt from HEIRO&apos;s own style rules.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">has quoted text</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_2000008 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_2000008">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000015"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">The date, written YYYY-MM-DD, on which the page of a guidance document was read for a check record.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026</ns2:IAO_0000119>
