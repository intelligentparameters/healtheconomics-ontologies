    <rdf:Description rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_1000026">
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">Relates a valuation specification to an earlier valuation specification of the same body that it replaces for new valuations, such as a new discount rate replacing an old one.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEAO 0.2.0 locked decisions (best practice), 18 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">supersedes valuation specification</rdfs:label>
        <ns3:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000002"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000001">
        <ns2:IAO_0000115 xml:lang="en">The numeric value of an estimate, an assumed value or a model result.</ns2:IAO_0000115>
        <ns2:IAO_0000119>HealthEconomics.wiki editorial</ns2:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has numeric value</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000002">
        <ns2:IAO_0000115 xml:lang="en">The unit or scale in which a value is expressed, in words, such as &apos;utility (0 = dead, 1 = full health)&apos; or &apos;GBP per admission&apos;.</ns2:IAO_0000115>
        <ns2:IAO_0000119>HealthEconomics.wiki editorial</ns2:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has unit label</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000003">
        <ns2:IAO_0000115 xml:lang="en">The ISO 4217 code of the currency of a cost, a model version or a model result, such as GBP.</ns2:IAO_0000115>
        <ns2:IAO_0000119>ISO 4217</ns2:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has currency code</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000027">
        <ns2:IAO_0000115 xml:lang="en">A free-text name of the perspective of a record, such as NHS and personal social services, kept as a label for people to read.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">Rule (0.3.0): the perspective specification linked by &apos;under perspective&apos; (RHEO_1000049) is authoritative. This text is a label only: it is never used in checks or queries, a record that has it must also link a perspective specification, and where the two differ the specification governs.</ns2:IAO_0000116>
        <ns2:IAO_0000119>HealthEconomics.wiki editorial</ns2:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has perspective label</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000030">
        <ns2:IAO_0000115 xml:lang="en">The annual discount rate applied to costs, as a proportion such as 0.035.</ns2:IAO_0000115>
        <ns2:IAO_0000119>HealthEconomics.wiki editorial</ns2:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has cost discount rate</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_2000031">
        <ns2:IAO_0000115 xml:lang="en">The annual discount rate applied to health outcomes, as a proportion such as 0.035.</ns2:IAO_0000115>
        <ns2:IAO_0000119>HealthEconomics.wiki editorial</ns2:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">has outcome discount rate</rdfs:label>
    </rdf:Description>
    


