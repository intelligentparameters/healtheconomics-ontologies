    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.obolibrary.org/obo/BFO_0000001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000001">
        <ns2:IAO_0000115 xml:lang="en">An entity is anything that exists or has existed or will exist.</ns2:IAO_0000115>
        <ns2:IAO_0000119>BFO 2020 (ISO/IEC 21838-2:2021) (elucidation)</ns2:IAO_0000119>
        <ns2:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <dc:identifier>001-BFO</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <rdfs:label xml:lang="en">entity</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) An entity is anything that exists or has existed or will exist</skos:definition>
        <skos:example xml:lang="en">Julius Caesar; the Second World War; your body mass index; Verdi&apos;s Requiem</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
        <ns2:IAO_0000115 xml:lang="en">A continuant is an entity that persists, endures, or continues to exist through time while maintaining its identity.</ns2:IAO_0000115>
        <ns2:IAO_0000119>BFO 2020 (ISO/IEC 21838-2:2021) (elucidation)</ns2:IAO_0000119>
        <ns2:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <dc:identifier>008-BFO</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <rdfs:label xml:lang="en">continuant</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) A continuant is an entity that persists, endures, or continues to exist through time while maintaining its identity</skos:definition>
        <skos:example xml:lang="en">A human being; a tennis ball; a cave; a region of space; someone&apos;s temperature</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <ns2:IAO_0000115 xml:lang="en">b is an independent continuant =Def b is a continuant &amp; there is no c such that b specifically depends on c or b generically depends on c.</ns2:IAO_0000115>
        <ns2:IAO_0000119>BFO 2020 (ISO/IEC 21838-2:2021)</ns2:IAO_0000119>
        <ns2:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <dc:identifier>017-BFO</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <rdfs:label xml:lang="en">independent continuant</rdfs:label>
        <skos:definition xml:lang="en">b is an independent continuant =Def b is a continuant &amp; there is no c such that b specifically depends on c or b generically depends on c</skos:definition>
        <skos:example xml:lang="en">An atom; a molecule; an organism; a heart; a chair; the bottom right portion of a human torso; a leg; the interior of your mouth; a spatial region; an orchestra</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000017 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000017">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000020"/>
        <ns2:IAO_0000115 xml:lang="en">A realizable entity is a specifically dependent continuant that inheres in some independent continuant which is not a spatial region &amp; which is of a type some instances of which are realized in processes of a correlated type.</ns2:IAO_0000115>
        <ns2:IAO_0000119>BFO 2020 (ISO/IEC 21838-2:2021) (elucidation)</ns2:IAO_0000119>
        <ns2:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <dc:identifier>058-BFO</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <rdfs:label xml:lang="en">realizable entity</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) A realizable entity is a specifically dependent continuant that inheres in some independent continuant which is not a spatial region &amp; which is of a type some instances of which are realized in processes of a correlated type</skos:definition>
        <skos:example xml:lang="en">The role of being a doctor; the role of this boundary to delineate where Utah and Colorado meet; the function of your reproductive organs; the disposition of your blood to coagulate; the disposition of this piece of metal to conduct electricity</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000020 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <ns2:IAO_0000115 xml:lang="en">b is a specifically dependent continuant =Def b is a continuant &amp; there is some independent continuant c which is not a spatial region &amp; which is such that b specifically depends on c.</ns2:IAO_0000115>
        <ns2:IAO_0000119>BFO 2020 (ISO/IEC 21838-2:2021)</ns2:IAO_0000119>
        <ns2:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <dc:identifier>050-BFO</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <rdfs:label xml:lang="en">specifically dependent continuant</rdfs:label>
        <skos:definition xml:lang="en">b is a specifically dependent continuant =Def b is a continuant &amp; there is some independent continuant c which is not a spatial region &amp; which is such that b specifically depends on c</skos:definition>
        <skos:example xml:lang="en">(with multiple bearers) John&apos;s love for Mary; the ownership relation between John and this statue; the relation of authority between John and his subordinates</skos:example>
        <skos:example xml:lang="en">(with one bearer) The mass of this tomato; the pink colour of a medium rare piece of grilled filet mignon at its centre; the smell of this portion of mozzarella; the disposition of this fish to decay; the role of being a doctor; the function of this heart to pump blood; the shape of this hole</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000023 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000023">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
        <ns2:IAO_0000115 xml:lang="en">A role b is a realizable entity such that b exists because there is some single bearer that is in some special physical, social, or institutional set of circumstances in which this bearer does not have to be &amp; b is not such that, if it ceases to exist, then the physical make-up of the bearer is thereby changed.</ns2:IAO_0000115>
        <ns2:IAO_0000119>BFO 2020 (ISO/IEC 21838-2:2021) (elucidation)</ns2:IAO_0000119>
        <ns2:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <dc:identifier>061-BFO</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <rdfs:label xml:lang="en">role</rdfs:label>
        <skos:altLabel xml:lang="en">externally-grounded realizable entity</skos:altLabel>
        <skos:definition xml:lang="en">(Elucidation) A role b is a realizable entity such that b exists because there is some single bearer that is in some special physical, social, or institutional set of circumstances in which this bearer does not have to be &amp; b is not such that, if it ceases to exist, then the physical make-up of the bearer is thereby changed</skos:definition>
        <skos:example xml:lang="en">The priest role; the student role; the role of subject in a clinical trial; the role of a stone in marking a property boundary; the role of a boundary to demarcate two neighbouring administrative territories; the role of a building in serving as a military target</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000029 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000029">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000141"/>
        <ns2:IAO_0000115 xml:lang="en">A site is a three-dimensional immaterial entity whose boundaries either (partially or wholly) coincide with the boundaries of one or more material entities or have locations determined in relation to some material entity.</ns2:IAO_0000115>
        <ns2:IAO_0000119>BFO 2020 (ISO/IEC 21838-2:2021) (elucidation)</ns2:IAO_0000119>
        <ns2:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <dc:identifier>034-BFO</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <rdfs:label xml:lang="en">site</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) A site is a three-dimensional immaterial entity whose boundaries either (partially or wholly) coincide with the boundaries of one or more material entities or have locations determined in relation to some material entity</skos:definition>
        <skos:example xml:lang="en">A hole in a portion of cheese; a rabbit hole; the Grand Canyon; the Piazza San Marco; the kangaroo-joey-containing hole of a kangaroo pouch; your left nostril (a fiat part - the opening - of your left nasal cavity); the lumen of your gut; the hold of a ship; the interior of the trunk of your car; hole in an engineered floor joist</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000031 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000031">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <ns2:IAO_0000115 xml:lang="en">A generically dependent continuant is an entity that exists in virtue of the fact that there is at least one of what may be multiple copies which is the content or the pattern that multiple copies would share.</ns2:IAO_0000115>
        <ns2:IAO_0000119>BFO 2020 (ISO/IEC 21838-2:2021) (elucidation)</ns2:IAO_0000119>
        <ns2:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <dc:identifier>074-BFO</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <rdfs:label xml:lang="en">generically dependent continuant</rdfs:label>
        <skos:altLabel xml:lang="en">g-dependent continuant</skos:altLabel>
        <skos:definition xml:lang="en">(Elucidation) A generically dependent continuant is an entity that exists in virtue of the fact that there is at least one of what may be multiple copies which is the content or the pattern that multiple copies would share</skos:definition>
        <skos:example xml:lang="en">The pdf file on your laptop; the pdf file that is a copy thereof on my laptop; the sequence of this protein molecule; the sequence that is a copy thereof in that protein molecule; the content that is shared by a string of dots and dashes written on a page and the transmitted Morse code signal; the content of a sentence; an engineering blueprint</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000040 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000040">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/BFO_0000141"/>
        <ns2:IAO_0000115 xml:lang="en">A material entity is an independent continuant that at all times at which it exists has some portion of matter as continuant part.</ns2:IAO_0000115>
        <ns2:IAO_0000119>BFO 2020 (ISO/IEC 21838-2:2021) (elucidation)</ns2:IAO_0000119>
        <ns2:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <dc:identifier>019-BFO</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <rdfs:label xml:lang="en">material entity</rdfs:label>
        <skos:definition xml:lang="en">(Elucidation) A material entity is an independent continuant has some portion of matter as continuant part</skos:definition>
        <skos:example xml:lang="en">A human being; the undetached arm of a human being; an aggregate of human beings</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000141 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000141">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
        <ns2:IAO_0000115 xml:lang="en">b is an immaterial entity =Def b is an independent continuant which is such that there is no time t when it has a material entity as continuant part.</ns2:IAO_0000115>
        <ns2:IAO_0000119>BFO 2020 (ISO/IEC 21838-2:2021)</ns2:IAO_0000119>
        <ns2:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <dc:identifier>028-BFO</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl"/>
        <rdfs:label xml:lang="en">immaterial entity</rdfs:label>
        <skos:definition xml:lang="en">b is an immaterial entity =Def b is an independent continuant which is such that there is no time t when it has a material entity as continuant part</skos:definition>
        <skos:example xml:lang="en">As for fiat point, fiat line, fiat surface, site</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000027 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <ns2:IAO_0000115 xml:lang="en">An information content entity that is intended to be one or more truthful statement(s) about something (modulo, e.g., measurement precision or other systematic errors) and is constructed/acquired by a method which reliably tends to produce (approximately) truthful statements.</ns2:IAO_0000115>
        <ns2:IAO_0000119>IAO (http://purl.obolibrary.org/obo/iao.owl)</ns2:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/iao.owl"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">data entity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000030 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000030">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <ns2:IAO_0000115 xml:lang="en">A generically dependent continuant that is about some thing.</ns2:IAO_0000115>
        <ns2:IAO_0000119>IAO (http://purl.obolibrary.org/obo/iao.owl)</ns2:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/iao.owl"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">information content entity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000033 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000033">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <ns2:IAO_0000115 xml:lang="en">An information content entity whose concretizations indicate to their bearer how to realize them in a process.</ns2:IAO_0000115>
        <ns2:IAO_0000119>IAO (http://purl.obolibrary.org/obo/iao.owl)</ns2:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/iao.owl"/>
        <rdfs:label xml:lang="en">directive information entity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000064 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000064">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
        <ns2:IAO_0000115 xml:lang="en">A plan specification which describes the inputs and output of mathematical functions as well as workflow of execution for achieving an predefined objective. Algorithms are realized usually by means of implementation as computer programs for execution by automata.</ns2:IAO_0000115>
        <ns2:IAO_0000119>IAO (http://purl.obolibrary.org/obo/iao.owl)</ns2:IAO_0000119>
        <ns2:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/iao.owl"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/iao.owl"/>
        <rdfs:label xml:lang="en">algorithm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000104 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000104">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <ns2:IAO_0000115 xml:lang="en">A directive information entity with action specifications and objective specifications as parts, and that may be concretized as a realizable entity that, if realized, is realized in a process in which the bearer tries to achieve the objectives by taking the actions specified.</ns2:IAO_0000115>
        <ns2:IAO_0000119>IAO (http://purl.obolibrary.org/obo/iao.owl)</ns2:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/iao.owl"/>
        <rdfs:label xml:lang="en">plan specification</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000310 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000310">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <ns2:IAO_0000115 xml:lang="en">A collection of information content entities intended to be understood together as a whole</ns2:IAO_0000115>
        <ns2:IAO_0000119>IAO (http://purl.obolibrary.org/obo/iao.owl)</ns2:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/iao.owl"/>
        <rdfs:label xml:lang="en">document</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000314 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000314">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <ns2:IAO_0000115 xml:lang="en">An information content entity that is part of a document.</ns2:IAO_0000115>
        <rdfs:label xml:lang="en">document part</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0000245 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0000245">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <ns2:IAO_0000115 xml:lang="en">An entity that can bear roles, has members, and has a set of organization rules. Members of organizations are either organizations themselves or individual people.</ns2:IAO_0000115>
        <ns2:IAO_0000119>OBI (http://purl.obolibrary.org/obo/obi.owl)</ns2:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/obi.owl"/>
        <rdfs:label xml:lang="en">organization</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0001930 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0001930">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001933"/>
        <ns2:IAO_0000115 xml:lang="en">A value specification that is specifies one category out of a fixed number of nominal categories</ns2:IAO_0000115>
        <ns2:IAO_0000119>OBI (http://purl.obolibrary.org/obo/obi.owl)</ns2:IAO_0000119>
        <ns2:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/obi.owl"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/obi.owl"/>
        <rdfs:label xml:lang="en">categorical value specification</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0001933 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0001933">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <ns2:IAO_0000115 xml:lang="en">An information content entity that specifies a value within a classification scheme or on a quantitative scale.</ns2:IAO_0000115>
        <ns2:IAO_0000119>OBI (http://purl.obolibrary.org/obo/obi.owl)</ns2:IAO_0000119>
        <ns2:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/obi.owl"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/obi.owl"/>
        <rdfs:label xml:lang="en">value specification</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0500000 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0500000">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
        <ns2:IAO_0000115 xml:lang="en">A plan specification comprised of protocols (which may specify how and what kinds of data will be gathered) that are executed as part of an investigation and is realized during a study design execution.</ns2:IAO_0000115>
        <ns2:IAO_0000119>OBI (http://purl.obolibrary.org/obo/obi.owl)</ns2:IAO_0000119>
        <ns2:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/obi.owl"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/obi.owl"/>
        <rdfs:label xml:lang="en">study design</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000016 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000016">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A directive information entity stating the value judgement a valuation is to apply, such as a discount rate, equity weights for groups or conditions, a money value of health or the prices and tariffs to use, so that the judgement can be identified, attributed and contested apart from the quantities it is applied to.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">The judgement (this class) and the act (valuation) are separate classes, following the IAO and OBI pattern in which a planned process realises a plan that a directive information entity specifies. The act of judging, such as a body choosing its discount rate, is a separate planned process upstream that produces the specification. RHEO&apos;s discounting specification, decision threshold specification, tariff, price agreement and international reference pricing rule are bridged here as payer and decision-maker valuation specifications.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000118 xml:lang="en">valuation judgement</ns2:IAO_0000118>
        <ns2:IAO_0000119>Baines D. Scope of HEAO, anything turned from a unit into a value, HEAO stage 1 design, 17 October 2026; Drummond et al. 2015</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">valuation specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000017 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000017">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000090"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A decision modifier rule stating which groups, conditions or circumstances receive which equity weight, and the criteria that decide it.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Cookson et al. 2017</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">equity weighting rule</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000018 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000018">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000017"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">An equity weighting rule that sets the weight given to QALYs by bands of absolute and proportional QALY shortfall, applying whichever implies the greater severity.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">NICE&apos;s severity modifier is the case in use. Its bands and weights are held as data in the worked examples, with the section of the manual they were checked against. In the NICE manual it applies to technology appraisals, and section 6.2.20 applies no severity weighting to highly specialised technologies.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000118 xml:lang="en">severity modifier</ns2:IAO_0000118>
        <ns2:IAO_0000119>NICE 2022 (PMG36, last updated 13 October 2026), sections 6.2.13 to 6.2.18 and table 6.1, checked 18 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">severity weighting rule</rdfs:label>
        <ns3:HEAO_9000002>HEMO-HOOK-14</ns3:HEAO_9000002>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000019 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A plan specification stating how values are obtained or applied in a valuation, such as valuing resources at market prices or at their opportunity cost, valuing lost work time by the human capital or friction cost method, or discounting at a constant rate.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">A method says how. The valuation specification says which judgement, such as which rate or which weight. OHEO&apos;s preference elicitation processes are how weights are derived, and they stay in OHEO. Uses valuation method shortens the OBI chain in which a planned process realises a plan that concretizes a plan specification.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Drummond et al. 2015</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">valuation method</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000035 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000035">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">An information content entity that is a number applied in a valuation to convert a quantity into value, such as a utility, a unit cost, a discount factor, a money value of a QALY or an equity weight, stated with the value scale it converts to.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">The kinds below are kept apart by meaning. A preference-based utility weight and an equity weight are disjoint siblings, so a social judgement can never be read as a health gain. The weight is information, apart from the valuation specification that states the judgement behind it.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Baines D. Scope of HEAO, anything turned from a unit into a value, HEAO stage 1 design, 17 October 2026; Drummond et al. 2015</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">valuation weight</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000036 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000036">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000035"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A valuation weight that expresses the preference for a health state on a scale on which full health is 1 and dead is 0, with values below 0 for states worse than dead, used to weight time lived in that state.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">RHEO utility estimates are not bridged here, because not every utility estimate is applied as a weight (a trial may report a mean utility as an outcome). A utility record or estimate that a valuation applies is inferred a valuation weight from the range of applies weight.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000118 xml:lang="en">health state utility weight</ns2:IAO_0000118>
        <ns2:IAO_0000118 xml:lang="en">utility weight</ns2:IAO_0000118>
        <ns2:IAO_0000119>Torrance 1986; Drummond et al. 2015</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">preference-based utility weight</rdfs:label>
        <ns3:HEAO_9000002>HEMO-HOOK-04</ns3:HEAO_9000002>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000037 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000037">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000035"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A valuation weight that is a reduction in preference-based utility associated with an event, a treatment or a health state, applied by subtraction from a baseline utility.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">OHEO&apos;s utility decrement estimate is bridged here. The coefficients of a value set are OHEO preference weights, bridged directly under valuation weight, not utility decrements.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000118 xml:lang="en">disutility weight</ns2:IAO_0000118>
        <ns2:IAO_0000119>Brazier et al. 2017</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">utility decrement</rdfs:label>
        <ns3:HEAO_9000002>HEMO-HOOK-26</ns3:HEAO_9000002>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000038 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000038">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000035"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A valuation weight that expresses the loss of health in a health state on a scale on which 0 is full health and 1 is equivalent to death, used to weight time lived with disability in DALYs.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Murray 1994</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">disability weight</rdfs:label>
        <ns3:HEAO_9000002>HEMO-HOOK-05</ns3:HEAO_9000002>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000039 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000039">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000035"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A valuation weight that is an amount of money per unit of a resource or a care process, in a stated currency and price year, on a stated price basis such as market price, administered price or opportunity cost, and as an average or a marginal cost.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000118 xml:lang="en">price per unit</ns2:IAO_0000118>
        <ns2:IAO_0000118 xml:lang="en">unit cost</ns2:IAO_0000118>
        <ns2:IAO_0000119>Drummond et al. 2015</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">unit cost or price weight</rdfs:label>
        <ns3:HEAO_9000002>HEMO-HOOK-08</ns3:HEAO_9000002>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000040 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000040">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000035"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A valuation weight that is a ratio converting an amount of money from one price year or currency to another, such as a price index ratio, a market exchange rate or a purchasing power parity conversion factor.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Turner et al. 2019</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">monetary adjustment factor</rdfs:label>
        <ns3:HEAO_9000002>HEMO-HOOK-09</ns3:HEAO_9000002>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000044 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000044">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000035"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_1000022"/>
                <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000052"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A valuation weight equal to the present value of one unit of cost or health occurring at a stated time, derived from a discount rate and the time from the base year, such as 1/(1+r)^t under constant rate discounting.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Drummond et al. 2015; Attema et al. 2018</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">discount factor</rdfs:label>
        <ns3:HEAO_9000002>HEMO-HOOK-01</ns3:HEAO_9000002>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000045 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000045">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000035"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A valuation weight that is an amount of money per unit of health or of risk reduction, used to convert health into money or money into health.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">OHEO&apos;s value of a statistical life and value of a statistical life year estimates, which are amounts per unit of risk or of life, are bridged here. A willingness to pay for a stated benefit as a whole is the result of a monetary benefit valuation, not a rate, so OHEO&apos;s monetary valuation estimate is not bridged.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Drummond et al. 2015</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">monetary value of health</rdfs:label>
        <ns3:HEAO_9000002>HEMO-HOOK-11</ns3:HEAO_9000002>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000046 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000046">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000045"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A monetary value of health that is an amount of money per QALY, used as the exchange rate between health and money in net benefit and in comparison with an incremental cost-effectiveness ratio.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000118 xml:lang="en">lambda</ns2:IAO_0000118>
        <ns2:IAO_0000118 xml:lang="en">value of a QALY</ns2:IAO_0000118>
        <ns2:IAO_0000119>Stinnett and Mullahy 1998; Drummond et al. 2015</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">money value of a QALY</rdfs:label>
        <ns3:HEAO_9000002>HEMO-HOOK-11</ns3:HEAO_9000002>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000049 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000049">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000092"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000093"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A decision modifier QALY weight applied according to the group, condition or circumstance of the people who gain or lose, expressing a social value judgement about distribution rather than an individual&apos;s preference for a health state.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000118 xml:lang="en">distributional weight</ns2:IAO_0000118>
        <ns2:IAO_0000119>Cookson et al. 2017</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">equity weight</rdfs:label>
        <ns3:HEAO_9000002>HEMO-HOOK-13</ns3:HEAO_9000002>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000050 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000050">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000049"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">An equity weight applied to QALYs according to the severity of the condition, as measured by absolute or proportional QALY shortfall, such as the QALY weights of 1.2 and 1.7 in table 6.1 of the NICE manual.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">Replaces the OHEO 0.3.0 data property &apos;has QALY weight&apos; (OHEO_2000025), which carried severity weights as a bare number on an analysis. A severity weight is a social judgement about whose QALYs count for more, not outcome measurement, so it is a weight applied by a severity weighting under a severity weighting rule. The OHEO property is left unchanged in OHEO 0.3.0 and proposed for obsolescence in OHEO 0.2.1 (oheo-0.2.1-proposal.md).</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000118 xml:lang="en">QALY weight for severity</ns2:IAO_0000118>
        <ns2:IAO_0000118 xml:lang="en">severity modifier weight</ns2:IAO_0000118>
        <ns2:IAO_0000119>NICE 2022 (PMG36, last updated 13 October 2026), sections 6.2.13 to 6.2.18 and table 6.1, checked 18 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">severity weight</rdfs:label>
        <ns3:HEAO_9000002>HEMO-HOOK-14</ns3:HEAO_9000002>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000051 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000051">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">An information content entity that is a number stated by a valuation specification or a valuation function, which determines the weights a valuation applies without itself being applied to a quantity, such as a discount rate or an inequality aversion parameter.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Attema et al. 2018; Atkinson 1970</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">valuation parameter</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000052 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000052">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000051"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A valuation parameter that is the rate per period by which the value of a future cost or health outcome is reduced for each period it lies beyond the base time, from which discount factors are derived.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">A rate stated by a decision-making body, such as the 3.5% a year of NICE PMG36 section 4.5.1, is part of a RHEO discounting specification. Applies to stream says whether a rate is for costs or for health effects, and differential discounting is a discounting specification with two rates.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Drummond et al. 2015; Attema et al. 2018</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">discount rate</rdfs:label>
        <ns3:HEAO_9000002>HEMO-HOOK-01</ns3:HEAO_9000002>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000055 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000055">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">An information content entity that assigns a valuation weight to each member of a set of descriptions, such as a value set that assigns a utility to every health state of a classification system, so that the weight for any described case can be looked up or computed.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">OHEO&apos;s utility functions, value sets and capability or care-related index value sets are classified here through the bridge. They keep their OHEO identifiers. OHEO says how a weight function was obtained and HEAO says how it is applied.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Brazier et al. 2017</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">weight function</rdfs:label>
        <ns3:HEAO_9000002>HEMO-HOOK-03</ns3:HEAO_9000002>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000056 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000056">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">An information content entity stating how a valuation combines its valued quantity, its weights and any parameters into a value, with a stated functional form, such as the product of a quantity and a weight or a discounted sum over a time profile.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">The expression of each function belongs to HEMO, the planned mathematics ontology. HEAO records which function and form a valuation used and points to a HEMO hook (hemo-hooks.md).</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Baines D. Scope of HEAO, anything turned from a unit into a value, HEAO stage 1 design, 17 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">valuation function</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000057 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000057">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">An information content entity naming the way a valuation combines its inputs, such as multiplicative, additive, multiplicative over a time profile, division, multi-attribute, non-exponential in time, nonlinear aggregation, rule-based or the expected maximum over options.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">The named forms are individuals of this class. Statistical derivation of weights, such as marginal willingness to pay from a choice model, is not a valuation form, because it derives a weight and does not apply one.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Baines D. Scope of HEAO, anything turned from a unit into a value, HEAO stage 1 design, 17 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">valuation functional form</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000058 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000058">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">An information content entity stating the scale on which a value is expressed, with its unit and its anchors, such as QALYs with full health at 1 and dead at 0, DALYs counting health lost, or money in a stated currency at a stated price year.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Drummond et al. 2015; Murray 1994</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">value scale</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000059 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000059">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000058"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A value scale on which health is expressed in units of healthy time, gained or lost, such as QALYs, DALYs or equity-weighted QALYs.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Drummond et al. 2015; Murray 1994</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">health value scale</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000060 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000060">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000058"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A value scale on which values are expressed in money of a stated currency at the prices of a stated price year.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Drummond et al. 2015; Turner et al. 2019</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">monetary value scale</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000061 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000061">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000058"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A value scale on which valuation weights themselves are expressed, such as the utility scale anchored at full health 1 and dead 0, the disability weight scale anchored at full health 0 and death 1, or a dimensionless multiplier.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Torrance 1986; Murray 1994</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">weight scale</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000062 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000062">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A directive information entity stating whose values supply the weights a valuation applies, such as the preferences of a general population or of patients, the prices a payer pays, or the social value judgements of a decision-making body.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">There are two kinds of perspective. The valuation perspective (this class) says whose values are used. The analytic perspective of a study says whose costs and outcomes are counted, and is RHEO&apos;s perspective specification. The bridge declares the two disjoint, and HEAO links each with its own property (&apos;from valuation perspective&apos; here, RHEO &apos;under perspective&apos; there).</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Brouwer et al. 2008; Drummond et al. 2015</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">valuation perspective</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000066 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000066">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">An information content entity stating the setting for which a valuation is made, namely the jurisdiction, the decision maker, the decision problem, the currency and price year, the reference case claimed and the date, against which the appropriateness of its weights and perspective can be judged.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">A model can be conceptually right and empirically accurate yet economically inappropriate because of the valuation applied. That can only be seen if the context of each valuation is recorded with it.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Baines D. Scope of HEAO, anything turned from a unit into a value, HEAO stage 1 design, 17 October 2026; Drummond et al. 2015</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">valuation context</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000067 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000067">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A data entity recording who made or adopted a valuation, a valuation weight or a valuation specification, from which source and version, and on what date, so that coexisting valuations of the same target can be told apart and attributed.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">Aligned with PROV-O. The agent is linked by the PROV-O property was attributed to.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Lebo et al. 2013 (W3C PROV-O)</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">valuation provenance record</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000068 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000068">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">An information content entity recording whether the weights, specification, perspective and value scale of a valuation fit its valuation context, such as whether the preference source of a value set matches the jurisdiction of the decision.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Baines D. Scope of HEAO, anything turned from a unit into a value, HEAO stage 1 design, 17 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">valuation appropriateness assessment</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000069 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000069">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A data entity recording that a valuation was replaced by a later valuation of the same valued quantity with a different weight, weight function, specification, method, perspective or context, while the quantity itself was unchanged.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">A sibling of RHEO&apos;s knowledge change record and possibility change record. Those record changes of reality or of what is known. This records a change of valuation, so diagnostics can count valuation drift and reality drift separately.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Baines D. Scope of HEAO, anything turned from a unit into a value, HEAO stage 1 design, 17 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">valuation change record</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000073 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000073">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A data entity recording health or money after an equity weight has been applied, on an equity-weighted value scale, kept apart from the unweighted QALY record or cost record it was calculated from.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">Disjoint from RHEO QALY record and cost record, so equity-weighted QALYs are never added to unweighted ones by mistake. Keeping them apart is a HEAO design decision.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Cookson et al. 2017; Baines D. Scope of HEAO, anything turned from a unit into a value, HEAO stage 1 design, 17 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">equity-weighted value record</rdfs:label>
        <ns3:HEAO_9000002>HEMO-HOOK-13</ns3:HEAO_9000002>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000074 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000074">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A data entity recording the expected value of reducing decision uncertainty, calculated by a value of information analysis at a stated money value of health, in money or in health per person affected or for a population.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Claxton 1999; Ades et al. 2004</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">value of information estimate</rdfs:label>
        <ns3:HEAO_9000002>HEMO-HOOK-17</ns3:HEAO_9000002>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000082 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000082">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000035"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A valuation weight that is an amount of money per WELLBY, used to convert wellbeing into money in social cost-benefit analysis.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000118 xml:lang="en">money value of a WELLBY</ns2:IAO_0000118>
        <ns2:IAO_0000119>HM Treasury 2021 (Wellbeing guidance for appraisal, supplementary Green Book guidance, July 2021), checked 18 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">monetary value of wellbeing</rdfs:label>
        <ns3:HEAO_9000002>HEMO-HOOK-27</ns3:HEAO_9000002>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000090 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000090">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000016"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A valuation specification stating when and how a decision-making body weights health gains for reasons other than individual preferences for health states, such as severity, size of benefit or who gains.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>NICE 2022 (PMG36, last updated 13 October 2026), sections 6.2.20 to 6.2.24 and table 6.2, checked 18 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">decision modifier rule</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000091 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000091">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000090"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A decision modifier rule that sets the weight given to QALYs by the size of the incremental QALY gain per patient over a lifetime horizon, such as the weights from 1 to 3 in table 6.2 of the NICE manual for highly specialised technologies.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">NICE applies it only to highly specialised technologies, and only with compelling evidence of significant QALY gains (PMG36 section 6.2.23).</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>NICE 2022 (PMG36, last updated 13 October 2026), sections 6.2.20 to 6.2.24 and table 6.2, checked 18 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">size of benefit weighting rule</rdfs:label>
        <ns3:HEAO_9000002>HEMO-HOOK-25</ns3:HEAO_9000002>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000092 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000092">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000035"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A valuation weight that a decision-making body applies to QALYs or other health value for reasons other than individual preferences for health states, such as the severity of the condition, the size of the benefit or who gains.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">Disjoint from preference-based utility weight, so a social judgement can never be read as a health gain. OHEO&apos;s has QALY weight is proposed for obsolescence with consider this class.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>NICE 2022 (PMG36, last updated 13 October 2026), sections 6.2.20 to 6.2.24 and table 6.2, checked 18 October 2026; Cookson et al. 2017</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">decision modifier QALY weight</rdfs:label>
        <ns3:HEAO_9000002>HEMO-HOOK-13</ns3:HEAO_9000002>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000093 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000093">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000092"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A decision modifier QALY weight applied according to the size of the incremental QALY gain per patient, such as the weight of 1 at 10 QALYs or fewer, 3 at 30 QALYs or more and equal increments between, in table 6.2 of the NICE manual.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>NICE 2022 (PMG36, last updated 13 October 2026), sections 6.2.20 to 6.2.24 and table 6.2, checked 18 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">size of benefit weight</rdfs:label>
        <ns3:HEAO_9000002>HEMO-HOOK-25</ns3:HEAO_9000002>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000094 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000094">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000046"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A money value of a QALY adopted by a decision-making body in a decision threshold specification, for comparison with incremental cost-effectiveness ratios and for net benefit, whatever basis it is meant to reflect, such as the £25,000 to £35,000 per QALY that NICE adopts and intends to reflect the opportunity cost of programmes displaced.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">Not declared disjoint from estimated supply-side threshold value or consumption value of a QALY, because an adopted figure may be meant to reflect either. Empirical supply-side estimates can differ from the figure a body adopts.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000118 xml:lang="en">adopted cost-effectiveness threshold</ns2:IAO_0000118>
        <ns2:IAO_0000118 xml:lang="en">decision threshold value</ns2:IAO_0000118>
        <ns2:IAO_0000119>NICE 2022 (PMG36, last updated 13 October 2026), sections 6.3.4 to 6.3.8, checked 18 October 2026; NICE 2022 (PMG36, last updated 13 October 2026), section 6.3.1, checked 18 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">adopted threshold value</rdfs:label>
        <ns3:HEAO_9000002>HEMO-HOOK-11</ns3:HEAO_9000002>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000096 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000096">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000035"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A valuation weight expressing the relative importance a decision maker gives to one criterion of a multi-criteria decision analysis, used to combine the scores of an option on several criteria into one value.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">Disjoint from preference-based utility weight and from decision modifier QALY weight.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000118 xml:lang="en">MCDA weight</ns2:IAO_0000118>
        <ns2:IAO_0000119>Thokala et al. 2016; Marsh et al. 2016</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">MCDA criterion weight</rdfs:label>
        <ns3:HEAO_9000002>HEMO-HOOK-29</ns3:HEAO_9000002>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000104 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000104">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000093"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A discounting specification that states different annual discount rates for costs and for health effects.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">Differential discounting is a choice of two rates in one specification, not a way of deriving factors, so it is a specification and not a discounting method.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000118 xml:lang="en">differential discounting</ns2:IAO_0000118>
        <ns2:IAO_0000119>Attema et al. 2018; Claxton et al. 2011</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">differential discounting specification</rdfs:label>
        <ns3:HEAO_9000002>HEMO-HOOK-01</ns3:HEAO_9000002>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000107 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000107">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">An information content entity naming the kind of a relationship that one ontology of the healtheconomics.wiki family makes to another, one of definitional, representational, computational, causal or valuational.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">The values of has linking kind are individuals of this class.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEAO 0.2.0 locked decisions (best practice), 18 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">cross-ontology relationship kind</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000108 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000108">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001930"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A categorical value specification naming the basis on which a unit cost or price weight values a resource, market price, administered price, accounting cost or opportunity cost.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">Each value names the valuation method of the same name.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Drummond et al. 2015</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">price basis</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000109 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000109">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001930"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A categorical value specification naming whether a unit cost or price weight is an average cost or a marginal cost.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Drummond et al. 2015</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">cost increment basis</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000110 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000110">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001930"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A categorical value specification naming a component of a valuation that can change while its valued quantity stays the same, the weight, the weight function, the specification, the method, the perspective or the context.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Baines D. Scope of HEAO, anything turned from a unit into a value, HEAO stage 1 design, 17 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">valuation component</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000111 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000111">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001930"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A categorical value specification naming the verdict of a valuation appropriateness assessment, appropriate, inappropriate or not assessable.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Baines D. Scope of HEAO, anything turned from a unit into a value, HEAO stage 1 design, 17 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">appropriateness verdict</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_0000112 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_0000112">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001930"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A categorical value specification naming what a discount rate is applied to, costs or health effects.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Attema et al. 2018</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">discounted stream</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000001 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A role borne by an organization that is realised in issuing, adopting or applying rules that set or limit the options other actors in a health system have, such as which technologies are funded, at what price, or by which methods they are evaluated.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">Institutions in North&apos;s sense are the rules, and organizations are the players. HEIRO keeps the two apart. A body is an organization that bears an institutional role, and the rules it issues are directive information entities. It is a role and not a kind of organization, so that one organization can hold several roles, as with RHEO&apos;s payer role. HEIRO holds formal written rules only. Norms and conventions, which are also institutions in North&apos;s sense, are out of its scope.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Baines D. Institutional layer of the healtheconomics.wiki, unpublished notes of 3 and 4 October 2026 (institutions shape the options actors have)</ns2:IAO_0000119>
        <ns2:IAO_0000119>North 1990</ns2:IAO_0000119>
        <ns2:IAO_0000119>RHEO 0.4.0 (Baines and Ashley 2026)</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">institutional role</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000002 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000002">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000001"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">An institutional role that is realised in assessing evidence on a health technology, including economic evaluations, to inform or make a decision on whether and on what terms the technology is funded.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">Realised in processes that make or inform funding decisions. RHEO&apos;s health technology assessment decision process (RHEO_0000062) covers those that decide, and a process that only informs, such as an IQWiG assessment for the G-BA, is proposed for RHEO 0.4.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000118 xml:lang="en">HTA role</ns2:IAO_0000118>
        <ns2:IAO_0000119>Drummond et al. 2015</ns2:IAO_0000119>
        <ns2:IAO_0000119>RHEO 0.4.0 (Baines and Ashley 2026)</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">health technology assessment role</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000003 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000003">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000001"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">An institutional role that is realised in issuing guidance documents stating the methods by which evidence, including economic evaluations, is to be produced or assessed, such as a reference case with its discount rate, perspective and outcome measure.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026</ns2:IAO_0000119>
        <ns2:IAO_0000119>OHEO 0.3.0 (Baines and Ashley 2026)</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">methods guidance role</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000004 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000004">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0000245"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                        <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000002"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">An organization that bears a health technology assessment role, such as the National Institute for Health and Care Excellence in England.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">A defined class and a query class for the register. An organization is classified here only when HEIRO records that it bears the role, and each such record carries the text it rests on.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000118 xml:lang="en">HTA body</ns2:IAO_0000118>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026</ns2:IAO_0000119>
        <ns2:IAO_0000119>RHEO 0.4.0 (Baines and Ashley 2026)</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">health technology assessment body</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000005 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000005">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0000245"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                        <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000003"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">An organization that bears a methods guidance role, such as a health technology assessment body that issues a methods manual for the evaluations it considers.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">A defined class and a query class for the register, like health technology assessment body.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">methods guidance body</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000006 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000006">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000116"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A geographic area whose boundaries are drawn by a government with power to make binding rules within it, such as a country, a nation of the United Kingdom or a federal state, so that the rules of bodies acting for that government apply there.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">Coded with RHEO&apos;s has jurisdiction code (ISO 3166). Only a body that acts for such a government, or a document it issues, has a jurisdiction. An independent body, such as ICER, has none, and its guidance has the binding force advisory. Arrangements that carry one body&apos;s guidance into another area, such as the service-level agreements that disseminate NICE technology evaluation guidance in Wales and Northern Ireland, are not modelled in 0.1.0.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026</ns2:IAO_0000119>
        <ns2:IAO_0000119>RHEO 0.4.0 (Baines and Ashley 2026)</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">jurisdiction</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000007 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">An information content entity that is the lineage of successive guidance versions a body issues under one title or reference number, stating rules or recommended methods that others are to follow, such as NICE&apos;s manual PMG36 across all its updates.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">The work in the FRBR sense, with its versions as the expressions, following the pattern of RHEO&apos;s classification scheme and classification scheme version. Its content is what all its versions share, its title or reference and its scope. HEO&apos;s concept Guidance Document means the written output of one appraisal, which is a different thing, so the two are related, not matched.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026</ns2:IAO_0000119>
        <ns2:IAO_0000119>Davis and Newman 2005 (Expression of Core FRBR Concepts in RDF, vocab.org/frbr/core, 10 August 2005)</ns2:IAO_0000119>
        <ns2:IAO_0000119>RHEO 0.4.0 (Baines and Ashley 2026)</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">guidance document</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000008 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000008">
        <rdfs:subClassOf rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000007"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A guidance document stating the methods by which evidence, including economic evaluations, is to be produced or assessed for a body&apos;s decisions, such as a technology appraisal manual or national guidelines for economic evaluation.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000118 xml:lang="en">methods guide</ns2:IAO_0000118>
        <ns2:IAO_0000118 xml:lang="en">pharmacoeconomic guidelines</ns2:IAO_0000118>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026</ns2:IAO_0000119>
        <ns2:IAO_0000119>Drummond et al. 2015</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">methods guidance document</rdfs:label>
        <ns1:HEIRO_9000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4200301"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000008"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_9000006"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4200301"/>
        <rdfs:comment xml:lang="en">HETO&apos;s step Identify the decision maker and any methods guidance that applies finds the methods guidance documents of HEIRO for an evaluation.</rdfs:comment>
        <ns3:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000002"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000009 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000009">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000310"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A document that is one issued state of a guidance document, fixed by the date the body gives as its publication or last updated date, or by its version number, such as NICE PMG36 as last updated on 13 October 2026.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">A version record is never edited once made. It holds the document, the version date, the date in force, the label and title shown, the page, the change summary and, on the newer version, the version it supersedes. Whether a version is current is not stated on the version but on dated check records, so that two releases of HEIRO can be loaded together. A change the body makes without showing a new date is a listed amendment of the version in force, not a version.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000118 xml:lang="en">guidance edition</ns2:IAO_0000118>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026</ns2:IAO_0000119>
        <ns2:IAO_0000119>Davis and Newman 2005 (Expression of Core FRBR Concepts in RDF, vocab.org/frbr/core, 10 August 2005)</ns2:IAO_0000119>
        <ns2:IAO_0000119>RHEO 0.4.0 (Baines and Ashley 2026)</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">guidance version</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000010 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000010">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000314"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A document part of a guidance version, identified by its section, paragraph, table or figure number, that states one or more rules, such as section 4.5.1 of NICE PMG36 as last updated on 13 October 2026.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000118 xml:lang="en">guidance section</ns2:IAO_0000118>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026</ns2:IAO_0000119>
        <ns2:IAO_0000119>IAO, Information Artifact Ontology, release of 30 March 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">guidance provision</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000011 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000011">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000033"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000005"/>
                        <owl:someValuesFrom rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000010"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A directive information entity that is stated in a guidance provision.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">A defined class and a query class. The text definition matches the logical one. HEIRO adds a kind of rule only where no other ontology of the family has one. A threshold is a RHEO decision threshold specification, a discount rate a RHEO discounting specification, a perspective a RHEO perspective specification, a funding condition a RHEO funding rule, a severity or size of benefit modifier a HEAO decision modifier rule, and an outcome requirement an OHEO outcome reference case requirement. HEIRO adds the comparator rule and the price benchmark rule, and records for every rule its provision, version and issuer, when it is in force and which appraisals it applies to.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000118 xml:lang="en">decision rule</ns2:IAO_0000118>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026</ns2:IAO_0000119>
        <ns2:IAO_0000119>HEAO 0.2.0 (Baines and Ashley 2026)</ns2:IAO_0000119>
        <ns2:IAO_0000119>OHEO 0.3.0 (Baines and Ashley 2026)</ns2:IAO_0000119>
        <ns2:IAO_0000119>RHEO 0.4.0 (Baines and Ashley 2026)</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">stated decision rule</rdfs:label>
        <ns1:HEIRO_9000006 rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4200203"/>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000011"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_9000006"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/ontologies/heto/HETO_4200203"/>
        <rdfs:comment xml:lang="en">HETO&apos;s step Align the evaluation methods with the methods guidance of the decision maker or assessment body applies the stated decision rules that HEIRO records for that body.</rdfs:comment>
        <ns3:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000002"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000012 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000012">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A directive information entity stating which options an evaluation or appraisal must, may or must not compare a health technology with, such as technologies that are established practice in the NHS.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">No other ontology of the family holds this kind of rule. RHEO&apos;s has comparator records the comparator an analysis used, not the rule that chose it. A comparator rule states its deontic modality and its selection basis.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Drummond et al. 2015</ns2:IAO_0000119>
        <ns2:IAO_0000119>NICE PMG36 (NICE technology appraisal and highly specialised technologies guidance, the manual, last updated 13 October 2026), read 19 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">comparator rule</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000014 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000014">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001930"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A categorical value specification stating what a check record found about a guidance version on its check date, that it was the current version, that a later version had superseded it, that it had been withdrawn, or that it was the latest version when an archived copy was captured.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026</ns2:IAO_0000119>
        <ns2:IAO_0000119>Bandrowski et al. 2016 (OBI)</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">guidance version status</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000015 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000015">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A data entity recording that on a stated date the page of a guidance document was read, live or as an archived copy, and what it showed about a stated guidance version, so that a claim that a version is current or superseded can be dated and repeated.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">Each check record names the copy that was read and its SHA-256, kept in src/sources. The status it reports holds on its check date only.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026</ns2:IAO_0000119>
        <ns2:IAO_0000119>Lebo et al. 2013 (W3C PROV-O, W3C Recommendation 30 April 2013)</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">guidance version check record</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000016 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000016">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A data entity recording a body&apos;s stated position on, or use of, a health economics concept, with a title, a summary and the primary source it rests on, as published on the Institutional Perspectives tab of the concept&apos;s wiki page.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">Generated by script from the live tab. Its identifier is keyed on the site&apos;s own key, concept slug and institution, so a relabelled row gets a new record and the old one is retired. HEO&apos;s concept Institutional Perspective means the analytic viewpoint of a single institution, such as a hospital, which is a different thing and is not mapped.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026</ns2:IAO_0000119>
        <ns2:IAO_0000119>healtheconomics.wiki Institutional Perspectives tab, read from the live concept pages on 19 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">institutional perspective record</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000017 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000017">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A data entity recording that a wiki concept page or a formula module record cites a guidance document, with the version date, sections and wording of the citation as written and the mentions of the document in the same record, so that citations of a superseded version can be found.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">Generated by script. One record is one reference with the mentions that go with it. Its verdict holds on its verdict date. A corrected page gets a new record and the old one is retired.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026</ns2:IAO_0000119>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators&apos; decisions, 19 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">guidance citation record</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000018 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000018">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A data entity recording a change that a body lists for a guidance version without giving the version a new date, with the month, the sections it names and the body&apos;s own summary, such as NICE&apos;s change of June 2025 to the budget impact test in sections 5.10.4 to 5.10.22 of PMG36.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">Taken from the body&apos;s own list, such as the minor changes since publication in NICE&apos;s update information or the summary of changes in ICER&apos;s framework. Changes a body does not list are not recorded, but a later check record with a different SHA-256 shows that the text changed.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators&apos; decisions, 19 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">listed amendment</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000019 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A directive information entity stating the money value per unit of health at which a body judges the price of a health technology to give fair value, used to set a price benchmark rather than to make a funding decision, such as ICER&apos;s range of 100,000 to 150,000 US dollars per evLY and per QALY gained.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">Kept apart from RHEO&apos;s decision threshold specification, because the body that states it makes no funding decision against it.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators&apos; decisions, 19 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">price benchmark rule</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000020 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001930"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A categorical value specification stating whether the decisions or guidance made under a guidance document bind those they address, or only advise them.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">binding for NICE technology appraisal guidance, which the regulations require the NHS to fund, and advisory for an IQWiG report to the G-BA or an ICER evidence report. Recorded only with the text it rests on.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators&apos; decisions, 19 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">binding force</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000021 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000021">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001930"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A categorical value specification stating how the page of a guidance document was read for a check record, live or as an archived copy.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators&apos; decisions, 19 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">check method</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000022 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000022">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001930"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A categorical value specification stating whether the guidance version a citation names had been superseded on the verdict date.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators&apos; decisions, 19 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">staleness verdict</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000023 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000023">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001930"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A categorical value specification stating whether a rule requires, permits or forbids the act it covers.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">Recorded for comparator rules in 0.1.0. The deontic content of rules is what a later option space layer would read.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators&apos; decisions, 19 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">deontic modality</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000024 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000024">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001930"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A categorical value specification stating the basis on which a comparator rule selects the options an evaluation compares a technology with.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators&apos; decisions, 19 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">comparator selection basis</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000025 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000025">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001930"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A categorical value specification stating what one provision does to another that it amends, replacing, deleting, inserting before or renumbering it.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators&apos; decisions, 19 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">amendment kind</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <ns2:IAO_0000115 xml:lang="en">A directive information entity that specifies how to obtain a score or classification for an outcome from a patient, a clinician, an observer or a performance task, including its items, response options and scoring rules. Each named instrument in OHEO, such as the EQ-5D-5L, is a class whose instances are the instrument&apos;s versions, such as one language and format version.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">An instrument is the specification. Administering it is an outcome assessment process; one person&apos;s result is an outcome measurement datum, a RHEO state observation or a RHEO utility measurement record. OHEO identifies three things separately: the instrument (its class, such as EQ-5D-5L), the instrument version (an instance of that class, such as one language and format version) and the value set (an instance of a value set class). The record rules check that a record names each one.</ns2:IAO_0000116>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <ns2:IAO_0000119>adapted from Mokkink et al. 2010 (COSMIN)</ns2:IAO_0000119>
        <dcterms:source>Mokkink LB, Terwee CB, Patrick DL, et al. The COSMIN study reached international consensus on taxonomy, terminology, and definitions of measurement properties for health-related patient-reported outcomes. J Clin Epidemiol. 2010;63(7):737-45.</dcterms:source>
        <oboInOwl:hasDbXref>NCIT:C142378</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">COA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">clinical outcome assessment</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">questionnaire</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">outcome measure</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="en">scale</oboInOwl:hasRelatedSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">outcome measurement instrument</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000082"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">COA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000100 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000100">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <ns2:IAO_0000115 xml:lang="en">A directive information entity that states the period of time a respondent should consider when answering an instrument, such as &apos;today&apos; or &apos;the past 4 weeks&apos;.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">Most instruments record this as the &apos;has recall period&apos; value rather than as a separate entity.</ns2:IAO_0000116>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <ns2:IAO_0000119>FDA 2009</ns2:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">recall period specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000101 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000101">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000064"/>
        <ns2:IAO_0000115 xml:lang="en">An algorithm that converts responses to an outcome measurement instrument into one or more scores or classifications.</ns2:IAO_0000115>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <ns2:IAO_0000119>adapted from Mokkink et al. 2010 (COSMIN)</ns2:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">scoring function</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">scoring rule</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">scoring algorithm</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000114 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000114">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <ns2:IAO_0000115 xml:lang="en">A directive information entity that states rules for assigning a person to an outcome category, such as a tumour response category or an adverse event grade.</ns2:IAO_0000115>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <ns2:IAO_0000119>HealthEconomics.wiki editorial</ns2:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">outcome classification criteria</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000223 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000223">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0500000"/>
        <ns2:IAO_0000115 xml:lang="en">A study design for a preference elicitation study, stating the states or alternatives to be valued, the elicitation tasks, the sample and the analysis.</ns2:IAO_0000115>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <ns2:IAO_0000119>HealthEconomics.wiki editorial</ns2:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">valuation protocol</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">valuation study design</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000327 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000327">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <ns2:IAO_0000115 xml:lang="en">A directive information entity that states the methods an economic evaluation must use to meet the standard of a decision-making body or methods panel, so that results are comparable across analyses.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">The named profiles are individuals of this class (0.2.0). Their requirements are published as SHACL shapes in oheo-reference-case-shapes.ttl, one shape for each profile, and an analysis that claims conformance to a profile is checked against its shape.</ns2:IAO_0000116>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <ns2:IAO_0000119>NICE 2022 (PMG36)</ns2:IAO_0000119>
        <oboInOwl:hasExactSynonym xml:lang="en">methods reference case</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">reference case</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">reference case profile</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000328 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000328">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <ns2:IAO_0000115 xml:lang="en">A directive information entity that states one rule a reference case profile sets for how health outcomes are measured, valued, sourced or discounted.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">Specific requirements are constraints in the SHACL shapes of oheo-reference-case-shapes.ttl. The 45 requirement classes of 0.1.0 are obsolete.</ns2:IAO_0000116>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <ns2:IAO_0000119>NICE 2022 (PMG36)</ns2:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">outcome reference case requirement</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/oheo/OHEO_0000385 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000385">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001930"/>
        <ns2:IAO_0000115 xml:lang="en">A categorical value specification that places an outcome measurement instrument in one category of a classification of instruments, such as generic or condition-specific design, or health profile scoring.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">An OHEO modelling term; its definition source is editorial by design.</ns2:IAO_0000116>
        <ns2:IAO_0000116 xml:lang="en">Used with &apos;has instrument classification&apos; so that generic, condition-specific and health profile instruments are defined classes, inferred by the reasoner, rather than second asserted parents.</ns2:IAO_0000116>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <ns2:IAO_0000119>HealthEconomics.wiki editorial</ns2:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/oheo"/>
        <rdfs:label xml:lang="en">instrument classification value</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000072 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000072">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000093"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000117"/>
        <ns2:IAO_0000115 xml:lang="en">A directive information entity stating whose resources and outcomes an economic evaluation counts, such as the health and personal social services system or society as a whole, by listing the kinds of resource included.</ns2:IAO_0000115>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <ns2:IAO_0000119>Drummond et al. 2015</ns2:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">perspective specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000093 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000093">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <owl:disjointWith rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000117"/>
        <ns2:IAO_0000115 xml:lang="en">A directive information entity stating the annual discount rates for costs and for health outcomes and the base year to which future values are discounted.</ns2:IAO_0000115>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <ns2:IAO_0000119>Drummond et al. 2015</ns2:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">discounting specification</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000116 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000116">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000029"/>
        <ns2:IAO_0000115 xml:lang="en">A site whose boundaries are fiat boundaries drawn on the earth&apos;s surface by a jurisdiction or a statistical authority, such as a country, a district or a small area used for deprivation statistics.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">Deprivation is a property of an area, recorded by observations about the area; a person is related to an area by where they live.</ns2:IAO_0000116>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <ns2:IAO_0000119>HealthEconomics.wiki editorial</ns2:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">geographic area</rdfs:label>
    </owl:Class>
    


    <!-- https://healtheconomics.wiki/ontologies/rheo/RHEO_0000117 -->

    <owl:Class rdf:about="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000117">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <ns2:IAO_0000115 xml:lang="en">A directive information entity stating a value against which a decision maker compares the results of an economic evaluation, such as a cost-effectiveness threshold per QALY gained.</ns2:IAO_0000115>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0000-0001-9502-4678"/>
        <ns2:IAO_0000117 rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <ns2:IAO_0000119>Drummond et al. 2015</ns2:IAO_0000119>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/rheo"/>
        <rdfs:label xml:lang="en">decision threshold specification</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.obolibrary.org/obo/IAO_0000125 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/IAO_0000125">
        <rdfs:label xml:lang="en">pending final vetting</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_4000001 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_4000001">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000107"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A kind of cross-ontology relationship in which one term defines or classifies another, such as a subclass bridge axiom or a mapping from a HEO concept to the HEAO class it explains.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEAO 0.2.0 locked decisions (best practice), 18 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">definitional relationship</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_4000002 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_4000002">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000107"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A kind of cross-ontology relationship in which one entity records, represents or describes another, such as a valuation context recording a jurisdiction or a provenance record describing who adopted a weight.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEAO 0.2.0 locked decisions (best practice), 18 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">representational relationship</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_4000003 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_4000003">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000107"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A kind of cross-ontology relationship in which one value is calculated from another by a formula, such as a discount factor from a discount rate, to be formalised in HEMO.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEAO 0.2.0 locked decisions (best practice), 18 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">computational relationship</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_4000004 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_4000004">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000107"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A kind of cross-ontology relationship in which one thing brings about another in reality, such as spending on a constrained budget displacing health elsewhere. It holds between real processes or the things taking part in them, not between records.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEAO 0.2.0 locked decisions (best practice), 18 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">causal relationship</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_4000005 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_4000005">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000107"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A kind of cross-ontology relationship in which a value is assigned to something, such as a valuation applying a weight to a quantity.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEAO 0.2.0 locked decisions (best practice), 18 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">valuational relationship</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_4000006 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_4000006">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000057"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A valuation functional form in which the result is one valued quantity multiplied by one weight, the canonical q x w.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Baines D. Scope of HEAO, anything turned from a unit into a value, HEAO stage 1 design, 17 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">multiplicative form</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_4000007 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_4000007">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000057"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A valuation functional form in which the result is a sum, or an integral, of quantities multiplied by weights that vary over time, as in QALYs over a cohort trace or a discounted stream.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Baines D. Scope of HEAO, anything turned from a unit into a value, HEAO stage 1 design, 17 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">multiplicative form over a time profile</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_4000008 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_4000008">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000057"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A valuation functional form in which the result is one valued quantity divided by one weight, as when a cost is converted into health forgone by dividing by a money value of a QALY.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Stinnett and Mullahy 1998; Claxton et al. 2015</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">division form</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_4000009 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_4000009">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000057"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A valuation functional form in which the weight is itself a function of several attributes, combined additively or multiplicatively, as in a value set.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Brazier et al. 2017</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">multi-attribute form</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_4000010 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_4000010">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000057"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A valuation functional form in which the discount factor is not (1+r) raised to minus t for a constant r, as in hyperbolic or stepped declining rate discounting.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Attema et al. 2018; Frederick et al. 2002</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">non-exponential time form</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_4000011 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_4000011">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000057"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A valuation functional form with no single weight for each person, such as an equally distributed equivalent with an inequality aversion parameter or a social welfare function.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Atkinson 1970; Cookson et al. 2017</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">nonlinear aggregation form</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_4000012 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_4000012">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000057"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A valuation functional form in which the weight is chosen by a rule or looked up in a table, such as a tariff by case group or a severity weight by shortfall band, and then applied multiplicatively.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Baines D. Scope of HEAO, anything turned from a unit into a value, HEAO stage 1 design, 17 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">rule-based form</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_4000013 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_4000013">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000057"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A valuation functional form in which the result is the expected value of the maximum net benefit across options minus the maximum of the expected net benefits, as in the expected value of perfect information.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Claxton 1999; Briggs et al. 2006</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">expected maximum form</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_4000014 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_4000014">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000059"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A health value scale on which one year in full health counts as one QALY and being dead counts as zero.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Drummond et al. 2015</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">QALY scale</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_4000015 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_4000015">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000059"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A health value scale on which one DALY is one year of healthy life lost, from premature death or from time lived with disability, without the age weights and discounting of the first DALYs unless a valuation states them.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Murray 1994</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">DALY scale</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_4000016 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_4000016">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000059"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A health value scale on which QALYs are counted after equity weights have been applied, so that values on it are not comparable with unweighted QALYs.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Cookson et al. 2017; Baines D. Scope of HEAO, anything turned from a unit into a value, HEAO stage 1 design, 17 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">equity-weighted QALY scale</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_4000017 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_4000017">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000061"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A weight scale for preference-based utility weights, with full health at 1 and dead at 0 and values below 0 for states worse than dead.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Torrance 1986</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">utility scale</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_4000018 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_4000018">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000061"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A weight scale for disability weights, with full health at 0 and a state equivalent to death at 1.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Murray 1994</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">disability weight scale</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_4000019 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_4000019">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000061"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A weight scale for capability or care-related index values, anchored at the worst and best states of the descriptive system, such as no capability and full capability, rather than at dead and full health, so its values cannot weight time in QALYs.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Brazier et al. 2017; Flynn et al. 2015</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">capability index scale</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_4000020 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_4000020">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000061"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A weight scale for pure numbers that multiply a value, such as equity weights, discount factors and price index ratios, on which 1 leaves the value unchanged.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Baines D. Scope of HEAO, anything turned from a unit into a value, HEAO stage 1 design, 17 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">dimensionless multiplier scale</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_4000021 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_4000021">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000057"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A valuation functional form in which the result is a baseline value plus or minus a quantity multiplied by a weight, as when a utility decrement over a duration is subtracted from a baseline.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Brazier et al. 2017</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">additive form</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_4000022 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_4000022">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000058"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A value scale on which one WELLBY is a one-point change in life satisfaction on a 0 to 10 scale for one person for one year.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>HM Treasury 2021 (Wellbeing guidance for appraisal, supplementary Green Book guidance, July 2021), checked 18 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">WELLBY scale</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_4000023 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_4000023">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000108"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A price basis in which a resource is valued at the price paid for it in a market.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Drummond et al. 2015</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">market price basis</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_4000024 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_4000024">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000108"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A price basis in which a resource is valued at the amount a payer has set for it in a tariff, fee schedule or price agreement.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Drummond et al. 2015</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">administered price basis</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_4000025 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_4000025">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000108"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A price basis in which a resource is valued at its average cost from accounts, including overheads and capital.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Drummond et al. 2015</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">accounting cost basis</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_4000026 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_4000026">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000108"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A price basis in which a resource is valued at the value of its best alternative use forgone.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Drummond et al. 2015</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">opportunity cost basis</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_4000027 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_4000027">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000109"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A cost increment basis in which a unit cost is total cost divided by the number of units.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Drummond et al. 2015</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">average cost basis</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_4000028 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_4000028">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000109"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">A cost increment basis in which a unit cost is the change in total cost from one more unit.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Drummond et al. 2015</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heao"/>
        <rdfs:label xml:lang="en">marginal cost basis</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heao/HEAO_4000029 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heao/HEAO_4000029">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000110"/>
