        <ns1:HEIRO_2000012 rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">30000.0</ns1:HEIRO_2000012>
        <ns1:HEIRO_2000013>Technology appraisals</ns1:HEIRO_2000013>
        <ns1:HEIRO_2000028>2022-01-31</ns1:HEIRO_2000028>
        <ns1:HEIRO_2000029>2026-03-30</ns1:HEIRO_2000029>
        <ns1:HEIRO_2000030>2022-01-31</ns1:HEIRO_2000030>
        <ns4:RHEO_2000002>GBP per QALY gained</ns4:RHEO_2000002>
        <ns4:RHEO_2000003>GBP</ns4:RHEO_2000003>
        <rdfs:comment xml:lang="en">Stated in PMG36, in the versions of 31 January 2022, 17 December 2025.</rdfs:comment>
