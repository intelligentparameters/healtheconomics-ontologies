        <rdfs:label xml:lang="en">has page URL</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_2000006 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_2000006">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000010"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">The section, paragraph, table or figure number by which a guidance version identifies a provision, as the version writes it, such as 4.5.1 or table 6.1.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026</ns2:IAO_0000119>
