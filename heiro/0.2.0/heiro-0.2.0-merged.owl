        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">Relates a guidance version check record to how its page was read.</ns2:IAO_0000115>
