    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_2000011 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_2000011">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">The lower end of a range of values that a rule states, such as 25000 for a threshold range of 25,000 to 35,000 pounds per QALY.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
