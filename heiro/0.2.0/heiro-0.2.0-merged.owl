        <ns3:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000002"/>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_9000002 -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_9000002">
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">Relates a guidance citation record to the HEMO formula catalogue record whose module source carries the citation.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">concerns HEMO record</rdfs:label>
        <ns3:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000002"/>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_9000003 -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_9000003">
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">Relates a guidance version to an OHEO reference case profile whose methods it states, alone or together with another version.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026</ns2:IAO_0000119>
        <ns2:IAO_0000119>OHEO 0.3.0 (Baines and Ashley 2026)</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">sets out reference case profile</rdfs:label>
        <ns3:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000002"/>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_9000004 -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_9000004">
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">Relates a stated decision rule to a HEMO formula that takes the figures of the rule as inputs, such as a discounting rule and the present value formula.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">0.1.0 links the discounting, threshold, price benchmark and modifier rules of the documents it holds.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">supplies policy input to</rdfs:label>
        <ns3:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000003"/>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_9000005 -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_9000005">
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">Relates a stated decision rule to the HEAO class of the figure it states, such as a threshold rule and adopted threshold value.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">Definitional, because the HEAO class classifies the figure the rule states.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026</ns2:IAO_0000119>
        <ns2:IAO_0000119>HEAO 0.2.0 (Baines and Ashley 2026)</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">states value of type</rdfs:label>
        <ns3:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000001"/>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_9000006 -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_9000006">
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">Relates a HEIRO class to a HETO task step whose work finds or applies instances of it, such as identifying the methods guidance that applies to an evaluation.</ns2:IAO_0000115>
        <ns2:IAO_0000116 xml:lang="en">Representational, the nearest of the five kinds, because the step records the work that finds instances of the class. heao-proposals-from-heiro.md asks HEAO to consider this case.</ns2:IAO_0000116>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 design decisions (best practice), 19 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">is identified in task step</rdfs:label>
        <ns3:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000002"/>
    </owl:AnnotationProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_9000007 -->

    <owl:AnnotationProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_9000007">
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">Relates an amends provision assertion, as an axiom annotation, to the kind of amendment it is.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators&apos; decisions, 19 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">has amendment kind</rdfs:label>
    </owl:AnnotationProperty>
    


