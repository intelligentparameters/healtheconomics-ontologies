    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_2000027 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_2000027">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000009"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">The title the body&apos;s page shows for a guidance version, which may differ between versions, as NICE health technology evaluations, the manual was the title of PMG36 until its version of 17 December 2025.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators&apos; decisions, 19 October 2026</ns2:IAO_0000119>
