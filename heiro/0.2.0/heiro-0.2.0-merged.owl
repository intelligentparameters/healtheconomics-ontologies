    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000249 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000249">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000018"/>
        <ns1:HEIRO_1000017 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000133"/>
        <ns1:HEIRO_2000005 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.nice.org.uk/process/pmg36/chapter/update-information</ns1:HEIRO_2000005>
        <ns1:HEIRO_2000014>June 2025: Sections 5.10.4, 5.10.5, 5.10.6 and 5.10.22 were updated to note that the threshold for the budget impact test has now increased from £20 million to £40 million.</ns1:HEIRO_2000014>
        <ns1:HEIRO_2000034>2025-06</ns1:HEIRO_2000034>
        <ns1:HEIRO_2000035>5.10.4, 5.10.5, 5.10.6 and 5.10.22</ns1:HEIRO_2000035>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl"/>
        <rdfs:label xml:lang="en">listed amendment of PMG36 of June 2025, 5.10.4, 5.10.5, 5.10.6 and 5.10.22</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000250 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000250">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000018"/>
        <ns1:HEIRO_1000017 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000162"/>
