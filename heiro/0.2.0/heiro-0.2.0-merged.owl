    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000023 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000023">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000023"/>
