    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000193 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000193">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000010"/>
        <ns1:HEIRO_1000004 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000148"/>
        <ns1:HEIRO_2000005 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.nice.org.uk/process/pmg36/chapter/committee-recommendations-2#pmg36-6_3_2</ns1:HEIRO_2000005>
        <ns1:HEIRO_2000006>6.3.2</ns1:HEIRO_2000006>
        <ns1:HEIRO_2000007>To be transparent in decision making, when applying decision-making modifiers, net health benefits should be routinely presented to show the effect on opportunity costs of recommending a technology that meets specific decision-making modifiers. Net health benefits should be presented using values placed on a QALY gain of £25,000 and £35,000, both with and without the QALY weighting applied. Positive net health benefits mean that overall population health is increased because of the new technology. Negative net health benefits mean that the health benefits associated with the new technology are not large enough to prevent overall health loss because of healthcare not being funded elsewhere in the system. Technologies associated with negative unweighted net health benefits may still be recommended when decision-making modifiers have been applied. This is because there is an ethical and moral rationale to value the health benefits gained with these technologies more than those gained by technologies not meeting decision-making modifiers.</ns1:HEIRO_2000007>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl"/>
        <rdfs:label xml:lang="en">PMG36 section 6.3.2, version of 13 October 2026</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000194 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000194">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000018"/>
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000011"/>
        <ns1:HEIRO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000195"/>
        <ns1:HEIRO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000196"/>
        <ns1:HEIRO_1000015 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000001"/>
        <ns1:HEIRO_2000013>Technology appraisals. Section 6.2.20 applies no severity weighting to highly specialised technologies</ns1:HEIRO_2000013>
        <ns1:HEIRO_2000030>2026-10-13</ns1:HEIRO_2000030>
        <rdfs:comment xml:lang="en">Stated in PMG36, in the versions of 13 October 2026.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl"/>
        <rdfs:label xml:lang="en">NICE severity modifier, QALY weights of 1, 1.2 and 1.7 by QALY shortfall</rdfs:label>
        <ns1:HEIRO_9000004 rdf:resource="https://healtheconomics.wiki/ontologies/hemo/HEMO_5000240"/>
        <ns1:HEIRO_9000005 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000050"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000194"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_9000004"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/ontologies/hemo/HEMO_5000240"/>
        <rdfs:comment xml:lang="en">The HEMO formula Severity QALY weight from the shortfall bands takes the figures of this rule as inputs, since HEMO keeps policy figures out of its formulas.</rdfs:comment>
        <ns3:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000003"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000194"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_9000005"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000050"/>
        <rdfs:comment xml:lang="en">The figure this rule states is a HEAO severity weight, so a valuation that applies it can be typed by HEAO.</rdfs:comment>
        <ns3:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000001"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000195 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000195">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000010"/>
        <ns1:HEIRO_1000004 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000148"/>
        <ns1:HEIRO_2000005 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.nice.org.uk/process/pmg36/chapter/committee-recommendations-2#pmg36-6_2_18</ns1:HEIRO_2000005>
        <ns1:HEIRO_2000006>6.2.18</ns1:HEIRO_2000006>
        <ns1:HEIRO_2000007>The QALY weightings for severity are applied based on absolute and proportional shortfall, whichever implies the greater severity level. If either the proportional or absolute QALY shortfall calculated falls on the cut-off between severity levels, the higher severity level will apply.</ns1:HEIRO_2000007>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl"/>
        <rdfs:label xml:lang="en">PMG36 section 6.2.18, version of 13 October 2026</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000196 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000196">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000010"/>
        <ns1:HEIRO_1000004 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000148"/>
        <ns1:HEIRO_2000005 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.nice.org.uk/process/pmg36/chapter/committee-recommendations-2</ns1:HEIRO_2000005>
        <ns1:HEIRO_2000006>table 6.1</ns1:HEIRO_2000006>
        <ns1:HEIRO_2000007>Table 6.1 QALY weightings for severity QALY weight Proportional QALY shortfall Absolute QALY shortfall 1 Less than 0.85 Less than 12 x1.2 0.85 to 0.95 12 to 18 x1.7 At least 0.95 At least 18</ns1:HEIRO_2000007>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl"/>
        <rdfs:label xml:lang="en">PMG36 table 6.1, version of 13 October 2026</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000197 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000197">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000011"/>
        <ns1:HEIRO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000198"/>
        <ns1:HEIRO_1000015 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000001"/>
        <ns1:HEIRO_2000013>Highly specialised technologies</ns1:HEIRO_2000013>
        <ns1:HEIRO_2000030>2026-10-13</ns1:HEIRO_2000030>
        <rdfs:comment xml:lang="en">Stated in PMG36, in the versions of 13 October 2026.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl"/>
        <rdfs:label xml:lang="en">NICE rule that no severity weighting applies to highly specialised technologies</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000198 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000198">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000010"/>
        <ns1:HEIRO_1000004 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000148"/>
        <ns1:HEIRO_2000005 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.nice.org.uk/process/pmg36/chapter/committee-recommendations-2#pmg36-6_2_20</ns1:HEIRO_2000005>
        <ns1:HEIRO_2000006>6.2.20</ns1:HEIRO_2000006>
        <ns1:HEIRO_2000007>For highly specialised technologies, the severity of the condition is already implicitly captured in the selection of technologies for evaluations. No additional QALY weighting for the severity of disease is applied.</ns1:HEIRO_2000007>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl"/>
        <rdfs:label xml:lang="en">PMG36 section 6.2.20, version of 13 October 2026</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000199 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000199">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000091"/>
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000011"/>
        <ns1:HEIRO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000200"/>
        <ns1:HEIRO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000201"/>
        <ns1:HEIRO_1000015 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000001"/>
        <ns1:HEIRO_2000013>Highly specialised technologies, with compelling evidence of significant QALY gains</ns1:HEIRO_2000013>
        <ns1:HEIRO_2000030>2026-10-13</ns1:HEIRO_2000030>
        <rdfs:comment xml:lang="en">Stated in PMG36, in the versions of 13 October 2026.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl"/>
        <rdfs:label xml:lang="en">NICE size of benefit QALY weight of 1 to 3 for highly specialised technologies</rdfs:label>
        <ns1:HEIRO_9000004 rdf:resource="https://healtheconomics.wiki/ontologies/hemo/HEMO_5000882"/>
        <ns1:HEIRO_9000005 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000093"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000199"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_9000004"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/ontologies/hemo/HEMO_5000882"/>
        <rdfs:comment xml:lang="en">The HEMO formula NICE size of benefit QALY weight for highly specialised technologies takes the figures of this rule as inputs, since HEMO keeps policy figures out of its formulas.</rdfs:comment>
        <ns3:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000003"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000199"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_9000005"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000093"/>
        <rdfs:comment xml:lang="en">The figure this rule states is a HEAO size of benefit weight, so a valuation that applies it can be typed by HEAO.</rdfs:comment>
        <ns3:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000001"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000200 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000200">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000010"/>
        <ns1:HEIRO_1000004 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000148"/>
        <ns1:HEIRO_2000005 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.nice.org.uk/process/pmg36/chapter/committee-recommendations-2#pmg36-6_2_22</ns1:HEIRO_2000005>
        <ns1:HEIRO_2000006>6.2.22</ns1:HEIRO_2000006>
        <ns1:HEIRO_2000007>For highly specialised technologies, the committee will consider the size of the incremental QALY gain in relation to the additional weight that would need to be assigned to the QALY benefits for the cost effectiveness of the technology to fall within the highly specialised technologies £100,000 cost per QALY level.</ns1:HEIRO_2000007>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl"/>
        <rdfs:label xml:lang="en">PMG36 section 6.2.22, version of 13 October 2026</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000201 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000201">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000010"/>
        <ns1:HEIRO_1000004 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000148"/>
        <ns1:HEIRO_2000005 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.nice.org.uk/process/pmg36/chapter/committee-recommendations-2#pmg36-6_2_23</ns1:HEIRO_2000005>
        <ns1:HEIRO_2000006>6.2.23</ns1:HEIRO_2000006>
        <ns1:HEIRO_2000007>For this weight to be applied, there will need to be compelling evidence that the treatment offers significant QALY gains. Depending on the number of QALYs gained over the lifetime of patients, when comparing the new technology with its relevant comparator(s), the committee will apply a weight between 1 and 3, using equal increments, for a range between 10 and 30 QALYs gained.</ns1:HEIRO_2000007>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl"/>
        <rdfs:label xml:lang="en">PMG36 section 6.2.23, version of 13 October 2026</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000203 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000203">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000010"/>
        <ns1:HEIRO_1000004 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000142"/>
        <ns1:HEIRO_2000005 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://web.archive.org/web/20260222032810id_/https://www.nice.org.uk/process/pmg36/chapter/committee-recommendations-2</ns1:HEIRO_2000005>
        <ns1:HEIRO_2000006>6.3.4</ns1:HEIRO_2000006>
        <ns1:HEIRO_2000007>Below a most plausible ICER of £20,000 per QALY gained, or £100,000 per QALY gained for highly specialised technologies, the decision to recommend a technology is normally based on the cost-effectiveness estimate and the acceptability of a technology as an effective use of NHS resources. When the estimated ICERs are less than £20,000 per QALY gained, or £100,000 per QALY gained for highly specialised technologies, and the committee decides that the technology should not be recommended, the committee will make specific reference to its view on the plausibility of the inputs to the economic modelling, or the certainty around the estimated ICER, or both. This might be affected, for example, by sensitivity analysis or limitations to the generalisability of findings about effectiveness.</ns1:HEIRO_2000007>
        <ns2:IAO_0000116 xml:lang="en">Read in an archived copy of the page, https://web.archive.org/web/20260222032810id_/https://www.nice.org.uk/process/pmg36/chapter/committee-recommendations-2</ns2:IAO_0000116>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl"/>
        <rdfs:label xml:lang="en">PMG36 section 6.3.4, version of 17 December 2025</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000205 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000205">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000010"/>
        <ns1:HEIRO_1000004 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000142"/>
        <ns1:HEIRO_2000005 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://web.archive.org/web/20260222032810id_/https://www.nice.org.uk/process/pmg36/chapter/committee-recommendations-2</ns1:HEIRO_2000005>
        <ns1:HEIRO_2000006>6.3.7</ns1:HEIRO_2000006>
        <ns1:HEIRO_2000007>As the ICER for a technology increases in the range of £20,000 to £30,000 per QALY gained, the committee&apos;s decisions about the acceptability of the technology as an effective use of NHS resources will make explicit reference to the relevant factors listed in section 6.3.5.</ns1:HEIRO_2000007>
        <ns2:IAO_0000116 xml:lang="en">Read in an archived copy of the page, https://web.archive.org/web/20260222032810id_/https://www.nice.org.uk/process/pmg36/chapter/committee-recommendations-2</ns2:IAO_0000116>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl"/>
        <rdfs:label xml:lang="en">PMG36 section 6.3.7, version of 17 December 2025</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000206 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000206">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000010"/>
        <ns1:HEIRO_1000004 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000142"/>
        <ns1:HEIRO_2000005 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://web.archive.org/web/20260222032810id_/https://www.nice.org.uk/process/pmg36/chapter/committee-recommendations-2</ns1:HEIRO_2000005>
        <ns1:HEIRO_2000006>6.3.8</ns1:HEIRO_2000006>
        <ns1:HEIRO_2000007>Above a most plausible ICER of £30,000 per QALY gained or £100,000 per QALY gained for highly specialised technologies, the committee will need to identify an increasingly stronger case for supporting the technology as an effective use of NHS resources, considering the factors listed in sections 6.3.5 and 6.3.6.</ns1:HEIRO_2000007>
        <ns2:IAO_0000116 xml:lang="en">Read in an archived copy of the page, https://web.archive.org/web/20260222032810id_/https://www.nice.org.uk/process/pmg36/chapter/committee-recommendations-2</ns2:IAO_0000116>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl"/>
        <rdfs:label xml:lang="en">PMG36 section 6.3.8, version of 17 December 2025</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000207 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000207">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000011"/>
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/oheo/OHEO_0000328"/>
        <ns1:HEIRO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000208"/>
        <ns1:HEIRO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000276"/>
        <ns1:HEIRO_1000015 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000001"/>
        <ns1:HEIRO_2000013>Reference-case analyses in adults, for topics with an invitation to participate issued after PMG51 was published</ns1:HEIRO_2000013>
        <ns1:HEIRO_2000030>2026-08-27</ns1:HEIRO_2000030>
        <ns1:HEIRO_2000031>2026-08-27</ns1:HEIRO_2000031>
        <rdfs:comment xml:lang="en">Stated in PMG51, in the versions of 27 August 2026.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl"/>
        <rdfs:label xml:lang="en">NICE rule that the EQ-5D-5L and its UK value set are used in reference-case analyses in adults</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000208 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000208">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000010"/>
        <ns1:HEIRO_1000004 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000151"/>
        <ns1:HEIRO_2000005 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.nice.org.uk/process/pmg51/chapter/statement-on-using-the-eq-5d-5l-value-set</ns1:HEIRO_2000005>
        <ns1:HEIRO_2000006>1.7</ns1:HEIRO_2000006>
        <ns1:HEIRO_2000007>After this interim methods statement is published, the EQ-5D-5L descriptive system and the new UK value set will be NICE&apos;s preferred approaches to measure and value health-related quality of life in adults.</ns1:HEIRO_2000007>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl"/>
        <rdfs:label xml:lang="en">PMG51 section 1.7, version of 27 August 2026</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000209 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000209">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000011"/>
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000093"/>
        <ns1:HEIRO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000210"/>
        <ns1:HEIRO_1000015 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000003"/>
        <ns1:HEIRO_2000013>After the first year in the base case, for costs and benefits that last longer than 1 year. Sensitivity analyses use 0% and 5%</ns1:HEIRO_2000013>
        <ns1:HEIRO_2000030>2025-12-19</ns1:HEIRO_2000030>
        <ns4:RHEO_2000030 rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.03</ns4:RHEO_2000030>
        <ns4:RHEO_2000031 rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.03</ns4:RHEO_2000031>
        <rdfs:comment xml:lang="en">Stated in General Methods, in the versions of 19 December 2025.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl"/>
        <rdfs:label xml:lang="en">IQWiG discount rate of 3% a year for costs and benefits</rdfs:label>
        <ns1:HEIRO_9000004 rdf:resource="https://healtheconomics.wiki/ontologies/hemo/HEMO_5000189"/>
        <ns1:HEIRO_9000004 rdf:resource="https://healtheconomics.wiki/ontologies/hemo/HEMO_5000618"/>
        <ns1:HEIRO_9000005 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000052"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000209"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_9000004"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/ontologies/hemo/HEMO_5000189"/>
        <rdfs:comment xml:lang="en">The HEMO formula Present value of a single future value takes the figures of this rule as inputs, since HEMO keeps policy figures out of its formulas.</rdfs:comment>
        <ns3:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000003"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000209"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_9000004"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/ontologies/hemo/HEMO_5000618"/>
        <rdfs:comment xml:lang="en">The HEMO formula Discounted total of a level yearly amount counted at the end of each year takes the figures of this rule as inputs, since HEMO keeps policy figures out of its formulas.</rdfs:comment>
        <ns3:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000003"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000209"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_9000005"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000052"/>
        <rdfs:comment xml:lang="en">The figure this rule states is a HEAO discount rate, so a valuation that applies it can be typed by HEAO.</rdfs:comment>
        <ns3:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000001"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000210 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000210">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000010"/>
        <ns1:HEIRO_1000004 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000157"/>
        <ns1:HEIRO_2000005 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.iqwig.de/methoden/general-methods_version-8-0.pdf</ns1:HEIRO_2000005>
        <ns1:HEIRO_2000006>4.8</ns1:HEIRO_2000006>
        <ns1:HEIRO_2000007>This rate is set at 3%. Likewise, identical constant rates of 0 and 5% should be used in sensitivity analyses. The literature also discusses the use of differential discounting in certain cases</ns1:HEIRO_2000007>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl"/>
        <rdfs:label xml:lang="en">General Methods section 4.8, version of 19 December 2025</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000211 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000211">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000011"/>
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000093"/>
        <ns1:HEIRO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000212"/>
        <ns1:HEIRO_1000015 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000015"/>
        <ns1:HEIRO_2000030>2023-09-25</ns1:HEIRO_2000030>
        <ns4:RHEO_2000030 rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.03</ns4:RHEO_2000030>
        <ns4:RHEO_2000031 rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.03</ns4:RHEO_2000031>
        <rdfs:comment xml:lang="en">Stated in Value Assessment Framework, in the versions of 25 September 2023.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl"/>
        <rdfs:label xml:lang="en">ICER discount rate of 3% a year for costs and outcomes</rdfs:label>
        <ns1:HEIRO_9000004 rdf:resource="https://healtheconomics.wiki/ontologies/hemo/HEMO_5000189"/>
        <ns1:HEIRO_9000004 rdf:resource="https://healtheconomics.wiki/ontologies/hemo/HEMO_5000618"/>
        <ns1:HEIRO_9000005 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000052"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000211"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_9000004"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/ontologies/hemo/HEMO_5000189"/>
        <rdfs:comment xml:lang="en">The HEMO formula Present value of a single future value takes the figures of this rule as inputs, since HEMO keeps policy figures out of its formulas.</rdfs:comment>
        <ns3:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000003"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000211"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_9000004"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/ontologies/hemo/HEMO_5000618"/>
        <rdfs:comment xml:lang="en">The HEMO formula Discounted total of a level yearly amount counted at the end of each year takes the figures of this rule as inputs, since HEMO keeps policy figures out of its formulas.</rdfs:comment>
        <ns3:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000003"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000211"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_9000005"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000052"/>
        <rdfs:comment xml:lang="en">The figure this rule states is a HEAO discount rate, so a valuation that applies it can be typed by HEAO.</rdfs:comment>
        <ns3:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000001"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000212 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000212">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000010"/>
        <ns1:HEIRO_1000004 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000162"/>
        <ns1:HEIRO_2000005 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://icer.org/wp-content/uploads/2025/12/ICER_2023_2026_VAF_070126.pdf</ns1:HEIRO_2000005>
        <ns1:HEIRO_2000006>3.6</ns1:HEIRO_2000006>
        <ns1:HEIRO_2000007>discounting of both costs and outcomes, at the rate of 3% per year.</ns1:HEIRO_2000007>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl"/>
        <rdfs:label xml:lang="en">Value Assessment Framework section 3.6, version of 25 September 2023</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000214 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000214">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000010"/>
        <ns1:HEIRO_1000004 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000162"/>
        <ns1:HEIRO_2000005 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://icer.org/wp-content/uploads/2025/12/ICER_2023_2026_VAF_070126.pdf</ns1:HEIRO_2000005>
        <ns1:HEIRO_2000006>3.9</ns1:HEIRO_2000006>
        <ns1:HEIRO_2000007>Price Benchmarks remains $100,000-$150,000 per evLY and per QALY</ns1:HEIRO_2000007>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl"/>
        <rdfs:label xml:lang="en">Value Assessment Framework section 3.9, version of 25 September 2023</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000215 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000215">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000011"/>
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000093"/>
        <ns1:HEIRO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000216"/>
        <ns1:HEIRO_1000015 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000013"/>
        <ns1:HEIRO_2000013>The public discount rate applicable at the time of the evaluation, which was 2.5% for time horizons of less than 30 years at publication in 2020, falling gradually to a floor of 1.5% beyond that. The rates recorded are the value at publication</ns1:HEIRO_2000013>
        <ns1:HEIRO_2000030>2020-07-29</ns1:HEIRO_2000030>
        <ns4:RHEO_2000030 rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.025</ns4:RHEO_2000030>
        <ns4:RHEO_2000031 rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.025</ns4:RHEO_2000031>
        <rdfs:comment xml:lang="en">Stated in Choices in methods for economic evaluation, in the versions of 29 July 2020.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl"/>
        <rdfs:label xml:lang="en">HAS rule to discount at the public discount rate applicable at the time of the evaluation, 2.5% a year at publication</rdfs:label>
        <ns1:HEIRO_9000004 rdf:resource="https://healtheconomics.wiki/ontologies/hemo/HEMO_5000189"/>
        <ns1:HEIRO_9000004 rdf:resource="https://healtheconomics.wiki/ontologies/hemo/HEMO_5000618"/>
        <ns1:HEIRO_9000005 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000052"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000215"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_9000004"/>
