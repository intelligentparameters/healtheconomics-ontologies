        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">has title as shown</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_2000028 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_2000028">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">The first day, or the month, from which a guidance version or a rule applies to a body&apos;s decisions, as the body states it or as its dated versions show it, written YYYY-MM-DD or YYYY-MM.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators&apos; decisions, 19 October 2026</ns2:IAO_0000119>
        <ns2:IAO_0000119>Publications Office 2026 (ELI ontology 1.5)</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">is in force from</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_2000029 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_2000029">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">The last day, or the month, on which a rule applies to a body&apos;s decisions, as the body states it or as its dated versions show it, written YYYY-MM-DD or YYYY-MM.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators&apos; decisions, 19 October 2026</ns2:IAO_0000119>
        <ns2:IAO_0000119>Publications Office 2026 (ELI ontology 1.5)</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">is in force until</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_2000030 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_2000030">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">The version date of the earliest guidance version HEIRO read that states a rule, which is not the date the rule came into force.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators&apos; decisions, 19 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">has first-read version date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_2000031 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_2000031">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">The date after which an appraisal or guideline topic must have started for a rule to apply to it, written YYYY-MM-DD, such as 27 August 2026 for NICE&apos;s EQ-5D-5L rule.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators&apos; decisions, 19 October 2026</ns2:IAO_0000119>
        <ns2:IAO_0000119>NICE PMG51 (Interim methods statement, implementing the EQ-5D-5L value set, published 27 August 2026), paragraphs 1.17 and 1.18, read 19 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">applies to topics started after</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_2000032 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_2000032">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">The date before which an appraisal or guideline topic must have started for a rule to apply to it, written YYYY-MM-DD, such as 27 August 2026 for NICE&apos;s rule that ongoing topics map EQ-5D-5L data to the 3L value set.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
        <ns2:IAO_0000119>Ashley M. HEIRO 0.2.0 fix pass after reviews A, B and C and the curators&apos; decisions, 19 October 2026</ns2:IAO_0000119>
        <ns2:IAO_0000119>NICE PMG51 (Interim methods statement, implementing the EQ-5D-5L value set, published 27 August 2026), paragraphs 1.17 and 1.18, read 19 October 2026</ns2:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-0231-3731"/>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro"/>
        <rdfs:label xml:lang="en">applies to topics started before</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_2000033 -->

    <owl:DatatypeProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_2000033">
