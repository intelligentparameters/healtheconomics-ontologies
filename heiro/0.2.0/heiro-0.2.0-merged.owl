    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000019 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000019">
        <rdfs:domain rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000016"/>
