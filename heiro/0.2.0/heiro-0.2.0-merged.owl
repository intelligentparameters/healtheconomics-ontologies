        <ns2:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <ns2:IAO_0000115 xml:lang="en">The number or name a body gives a guidance version, such as Version 8.0.</ns2:IAO_0000115>
