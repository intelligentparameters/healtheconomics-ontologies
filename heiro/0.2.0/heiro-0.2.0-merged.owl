        <ns2:IAO_0000115 xml:lang="en">Whether any section a citation names was changed by a later version, true or false, absent when that cannot be told.</ns2:IAO_0000115>
        <ns2:IAO_0000117>Michelle Ashley (drafted with Claude)</ns2:IAO_0000117>
