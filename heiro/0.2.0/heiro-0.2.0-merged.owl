        <rdfs:label xml:lang="en">Choices in methods for economic evaluation Guideline 7, version of 29 July 2020</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000217 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000217">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000011"/>
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000093"/>
        <ns1:HEIRO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000218"/>
        <ns1:HEIRO_1000015 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000038"/>
        <ns1:HEIRO_2000013>Costs and outcomes that occur or extend beyond one year in the base case. Sensitivity analyses use 3.5% and 0%</ns1:HEIRO_2000013>
        <ns1:HEIRO_2000030>2016-09</ns1:HEIRO_2000030>
        <ns4:RHEO_2000030 rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.05</ns4:RHEO_2000030>
        <ns4:RHEO_2000031 rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.05</ns4:RHEO_2000031>
        <rdfs:comment xml:lang="en">Stated in PBAC Guidelines, in the versions of September 2016.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl"/>
        <rdfs:label xml:lang="en">PBAC discount rate of 5% a year for costs and health outcomes</rdfs:label>
        <ns1:HEIRO_9000004 rdf:resource="https://healtheconomics.wiki/ontologies/hemo/HEMO_5000189"/>
        <ns1:HEIRO_9000004 rdf:resource="https://healtheconomics.wiki/ontologies/hemo/HEMO_5000618"/>
        <ns1:HEIRO_9000005 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000052"/>
    </owl:NamedIndividual>
