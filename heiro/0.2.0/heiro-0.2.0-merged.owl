    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000025 -->

    <owl:ObjectProperty rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_1000025">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
