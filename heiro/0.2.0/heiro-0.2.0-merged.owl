    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000280">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000010"/>
        <ns1:HEIRO_1000004 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000148"/>
        <ns1:HEIRO_2000005 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.nice.org.uk/process/pmg36/chapter/update-information</ns1:HEIRO_2000005>
