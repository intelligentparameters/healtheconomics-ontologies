    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000271 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000271">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000011"/>
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000117"/>
        <ns1:HEIRO_1000005 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000272"/>
        <ns1:HEIRO_1000015 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000001"/>
        <ns1:HEIRO_2000013>Technologies funded through specialised commissioning budgets, in any of the first 3 financial years</ns1:HEIRO_2000013>
        <ns1:HEIRO_2000029>2025-06</ns1:HEIRO_2000029>
        <ns1:HEIRO_2000030>2023-10-31</ns1:HEIRO_2000030>
        <ns4:RHEO_2000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">20000000.0</ns4:RHEO_2000001>
        <ns4:RHEO_2000002>GBP net budget impact a year</ns4:RHEO_2000002>
        <ns4:RHEO_2000003>GBP</ns4:RHEO_2000003>
        <rdfs:comment xml:lang="en">Stated in PMG36, in the versions of 31 October 2023.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl"/>
        <rdfs:label xml:lang="en">NICE budget impact test of 20 million pounds a year</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000272 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000272">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000010"/>
        <ns1:HEIRO_1000004 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000130"/>
        <ns1:HEIRO_2000005 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://web.archive.org/web/20250311184341id_/https://www.nice.org.uk/process/pmg36/chapter/developing-the-guidance-2</ns1:HEIRO_2000005>
        <ns1:HEIRO_2000006>5.10.4</ns1:HEIRO_2000006>
        <ns1:HEIRO_2000007>NHS England and NHS Improvement may request a longer time to implement the statutory funding requirements for technologies funded through its specialised commissioning budgets. This may happen when the potential net budget impact is expected to exceed £20 million per year in any of the first 3 financial years of its use in the NHS. NHS England and NHS Improvement will also do this on behalf of clinical commissioning groups, for locally commissioned technologies that NICE has evaluated.</ns1:HEIRO_2000007>
        <ns2:IAO_0000116 xml:lang="en">Read in an archived copy of the page, https://web.archive.org/web/20250311184341id_/https://www.nice.org.uk/process/pmg36/chapter/developing-the-guidance-2</ns2:IAO_0000116>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl"/>
        <rdfs:label xml:lang="en">PMG36 section 5.10.4, version of 31 October 2023</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000273 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000273">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000011"/>
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/rheo/RHEO_0000117"/>
