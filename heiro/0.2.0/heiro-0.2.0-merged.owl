    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000174"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_9000004"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/ontologies/hemo/HEMO_5000189"/>
        <rdfs:comment xml:lang="en">The HEMO formula Present value of a single future value takes the figures of this rule as inputs, since HEMO keeps policy figures out of its formulas.</rdfs:comment>
        <ns3:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000003"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000174"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_9000004"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/ontologies/hemo/HEMO_5000618"/>
        <rdfs:comment xml:lang="en">The HEMO formula Discounted total of a level yearly amount counted at the end of each year takes the figures of this rule as inputs, since HEMO keeps policy figures out of its formulas.</rdfs:comment>
        <ns3:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000003"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000174"/>
        <owl:annotatedProperty rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_9000005"/>
        <owl:annotatedTarget rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_0000052"/>
        <rdfs:comment xml:lang="en">The figure this rule states is a HEAO discount rate, so a valuation that applies it can be typed by HEAO.</rdfs:comment>
        <ns3:HEAO_9000001 rdf:resource="https://healtheconomics.wiki/ontologies/heao/HEAO_4000001"/>
    </owl:Axiom>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000175 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000175">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000010"/>
        <ns1:HEIRO_1000004 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000148"/>
        <ns1:HEIRO_2000005 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.nice.org.uk/process/pmg36/chapter/economic-evaluation-2#pmg36-4_5_1</ns1:HEIRO_2000005>
        <ns1:HEIRO_2000006>4.5.1</ns1:HEIRO_2000006>
        <ns1:HEIRO_2000007>Cost-effectiveness results should reflect the present value of the stream of costs and benefits accruing over the time horizon of the analysis. For the reference case, costs and health effects should be discounted at the same rate of 3.5% per year.</ns1:HEIRO_2000007>
        <rdfs:isDefinedBy rdf:resource="https://healtheconomics.wiki/ontologies/heiro/heiro-register.owl"/>
        <rdfs:label xml:lang="en">PMG36 section 4.5.1, version of 13 October 2026</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000176 -->

