    <!-- https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000245 -->

    <owl:NamedIndividual rdf:about="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000245">
        <rdf:type rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_0000015"/>
        <ns1:HEIRO_1000006 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_4000002"/>
        <ns1:HEIRO_1000010 rdf:resource="https://healtheconomics.wiki/ontologies/heiro/HEIRO_5000121"/>
